// View 8 — System admin: standard operating procedures grouped by kind,
// one page per SOP with a step flowchart (wired by the sop's `from -> to`
// flow statements) above the step detail. Resolves the `let` helpers from
// wdoc/book/main.wcl.

let sop_groups = [
  { kind: :operations, name: "Operations" },
  { kind: :incident,   name: "Incident handling" },
  { kind: :change,     name: "Change management" },
  { kind: :release,    name: "Release" },
  { kind: :runbook,    name: "Automation runbooks" },
  { kind: :dev,        name: "Development" },
]
let sops_with = fn(k: SopKind) -> list<Sop> {
  filter(sops, fn(so: Sop) -> bool { so.kind == k })
}

page sysadmin_page { title = "System admin"
  h1 "System admin"
  p  "How the system is operated: standard procedures, incident and change handling, and automation runbooks."

  wdoc_repeater { each = match len(sops) { 0 => [true], _ => [] }  as = :_e
    p "_No procedures recorded._"
  }
  wdoc_repeater { each = sop_groups  as = :g
    wdoc_repeater { each = match len(sops_with(g.kind)) { 0 => [], _ => [true] }  as = :_h
      h2 $"${g.name}"
      wdoc_repeater { each = sops_with(g.kind)  as = :so
        p $"- [${so.title}](sop_${so.id}) — ${so.purpose}"
      }
    }
  }
}

// --- one page per SOP -------------------------------------------------------------
wdoc_repeater { each = sops  as = :so
  page $"sop_${so.id}" { title = $"${so.title}"
    h1 $"${so.title}"
    p  $"_${so.purpose}_"

    wdoc_repeater { each = match so.automation { none => [], au => [au] }  as = :au
      callout "Automated" { class = ["tip"]  body = $"This runbook is automated: ${au}" }
    }

    wdoc_repeater { each = match len(so.preconditions) { 0 => [], _ => [true] }  as = :_p
      h2 "Preconditions"
      wdoc_repeater { each = so.preconditions  as = :pc
        p $"- ${pc}"
      }
    }

    h2 "Flow"
    diagram {
      width = 560  height = len(so.steps) * 96 + 64
      layout = :layered  direction = :top_to_bottom  layer_gap = 28.0  node_gap = 32.0
      wdoc_repeater { each = so.steps  as = :st
        wdoc_repeater { each = match st.shape { :process => [true], _ => [] }  as = :_sh
          process $"${st.n}. ${st.title ?? ""}" { id = $"${st.id}"  width = 190.0  height = 46.0 } }
        wdoc_repeater { each = match st.shape { :decision => [true], _ => [] }  as = :_sh
          decision $"${st.title ?? ""}" { id = $"${st.id}"  width = 170.0  height = 72.0 } }
        wdoc_repeater { each = match st.shape { :terminator => [true], _ => [] }  as = :_sh
          terminator $"${st.title ?? ""}" { id = $"${st.id}"  width = 150.0  height = 46.0 } }
      }
      edges = map(so.flow, fn(e: StepFlow) -> Edge {
        { source: $"${e.source}", destination: $"${e.destination}",
          kind: :flow, label: match e.kind { :yes => "yes", :no => "no", _ => "" } }
      })
    }

    h2 "Steps"
    wdoc_repeater { each = so.steps  as = :st
      h3 $"Step ${st.n}${match st.title { none => "", ti => $": ${ti}" }}"
      project { from = st.bodies }
    }

    wdoc_repeater { each = match so.verification { none => [], v => [v] }  as = :v
      callout "Verification" { class = ["success"]  body = $"${v}" }
    }
    edit_object { kind = "sop"  target = $"${so.id}" }
  }
}
