// View 6 — Build & deploy: repositories, pipelines, and releases. The
// landing page lists all three plus the day-to-day dev runbooks; each
// repository gets a structure diagram (submodule-aware) and each pipeline a
// stage flowchart (from the stage `next` DAG) with per-stage detail.
// Resolves the `let` helpers from wdoc/book/main.wcl.

let stage_edges = fn(pl: Pipeline) -> list<Edge> {
  flatten(map(pl.stages, fn(st: PipelineStage) -> list<Edge> {
    map(st.next, fn(nx: identifier) -> Edge { { source: st.id, destination: nx } })
  }))
}
let stage_name = fn(st: PipelineStage) -> utf8 { st.name ?? $"${st.id}" }
let stage_name_of = fn(pl: Pipeline, sid: identifier) -> utf8 {
  let st = find(pl.stages, fn(x: PipelineStage) -> bool { x.id == sid });
  match st { none => $"${sid}", _ => stage_name(st) }
}
// A structure path's submodule note: ours links to its repository page,
// an external one is named as outside our control.
let repo_path_note = fn(rp: RepoPath) -> utf8 {
  match rp.repo {
    none => match rp.external_url { none => "", u2 => $" · **external submodule** — ${u2}" },
    rid  => $" · submodule → ${link_of(rid)}",
  }
}

page build_page { title = "Build & deploy"
  h1 "Build & deploy"
  p  "How the system is built, tested, shipped, and promoted between environments."

  h2 "Repositories"
  wdoc_repeater { each = match len(repositories) { 0 => [true], _ => [] }  as = :_e
    p "_No repositories recorded._"
  }
  wdoc_repeater { each = match len(repositories) { 0 => [], _ => [true] }  as = :_t
    table {
      header = ["Repository", "Language", "URL", "Summary"]
      rows = map(repositories, fn(r: Repository) -> list<utf8> {
        [$"[${r.name}](repo_${r.id})", r.primary_language ?? "—", r.url, r.summary ?? "—"]
      })
    }
  }

  h2 "Pipelines"
  wdoc_repeater { each = match len(pipelines) { 0 => [true], _ => [] }  as = :_e2
    p "_No pipelines recorded._"
  }
  wdoc_repeater { each = pipelines  as = :pl
    p $"- [${pl.name}](pipeline_${pl.id})${match pl.trigger { none => "", t2 => $" — triggered by ${t2}" }}${match pl.summary { none => "", sx => $" — ${sx}" }}"
  }

  h2 "Releases"
  wdoc_repeater { each = match len(releases) { 0 => [true], _ => [] }  as = :_e3
    p "_No releases recorded._"
  }
  wdoc_repeater { each = match len(releases) { 0 => [], _ => [true] }  as = :_rt
    p "What shipped in each version, newest first — extractor-owned (derived from git tags), never hand-maintained."
    table {
      header = ["Version", "Date", "What's in it"]
      rows = map(releases, fn(rl: Release) -> list<utf8> {
        [match rl.url { none => rl.version, u2 => $"[${rl.version}](${u2})" },
         rl.date ?? "—", join(rl.highlights, " · ")]
      })
    }
  }

  wdoc_repeater { each = match len(filter(sops, fn(so: Sop) -> bool { so.kind == :dev })) { 0 => [], _ => [true] }  as = :_ld
    h2 "Local development"
    p  "The day-to-day development runbooks (articles under this chapter carry the longer setup / branching / release detail):"
    wdoc_repeater { each = filter(sops, fn(so: Sop) -> bool { so.kind == :dev })  as = :so
      p $"- [${so.title}](sop_${so.id}) — ${so.purpose}"
    }
  }
}

// --- one page per repository ---------------------------------------------------
wdoc_repeater { each = repositories  as = :r
  page $"repo_${r.id}" { title = $"${r.name}"
    h1 $"${r.name}"
    wdoc_repeater { each = match r.summary { none => [], sx => [sx] }  as = :sx
      p $"_${sx}_"
    }
    p $"**URL:** ${r.url}${match r.primary_language { none => "", l2 => $" · **Language:** ${l2}" }}"

    wdoc_repeater { each = match len(r.structure) { 0 => [], _ => [true] }  as = :_s
      h2 "Structure"
      // The nesting picture: the repo fans out to its notable paths. A path
      // that is really another repo says so — ours link to their page,
      // external submodules draw dashed (outside our control).
      diagram { width = 960  height = 520  layout = :layered  direction = :left_to_right
        layer_gap = 110.0  node_gap = 26.0  pan_zoom = true
        desc = $"Structure of ${r.name}"
        card { id = r.id  title = r.name  width = 190.0  height = 80.0
          text $"${r.summary ?? ""}"
        }
        wdoc_repeater { each = filter(r.structure, fn(rp: RepoPath) -> bool { rp.external_url == none })  as = :rp
          card { id = rp.id  title = rp.path  width = 300.0  height = 96.0
            text $"${rp.description}${repo_path_note(rp)}"
          }
        }
        wdoc_repeater { each = filter(r.structure, fn(rp: RepoPath) -> bool { rp.external_url != none })  as = :rp
          card { id = rp.id  title = rp.path  width = 300.0  height = 96.0  class = ["wad-external"]
            text $"${rp.description}${repo_path_note(rp)}"
          }
        }
        edges = map(r.structure, fn(rp: RepoPath) -> Edge {
          { source: r.id, destination: rp.id }
        })
      }
    }

    wdoc_repeater { each = match r.body { none => [], _ => [true] }  as = :_b
      project { from = r.body }
    }
    edit_object { kind = "repository"  target = $"${r.id}" }
  }
}

// --- one page per pipeline -------------------------------------------------------
wdoc_repeater { each = pipelines  as = :pl
  page $"pipeline_${pl.id}" { title = $"${pl.name}"
    h1 $"${pl.name}"
    wdoc_repeater { each = match pl.summary { none => [], sx => [sx] }  as = :sx
      p $"_${sx}_"
    }
    p $"${match pl.repo { none => "", rid => $"**Repository:** ${link_of(rid)} · " }}**Trigger:** ${pl.trigger ?? "—"}"

    wdoc_repeater { each = match len(pl.stages) { 0 => [], _ => [true] }  as = :_d
      diagram { width = 920  height = 420  layout = :layered  direction = :left_to_right
        layer_gap = 80.0  node_gap = 36.0  pan_zoom = true
        desc = $"Stage flow for ${pl.name}"
        wdoc_repeater { each = pl.stages  as = :st
          process $"${stage_name(st)}" { id = st.id  width = 160.0  height = 56.0 }
        }
        edges = stage_edges(pl)
      }
      h2 "Stages"
      wdoc_repeater { each = pl.stages  as = :st
        h3 $"${stage_name(st)}"
        wdoc_repeater { each = match st.summary { none => [], sx => [sx] }  as = :sx
          p $"**Does:** ${sx}"
        }
        wdoc_repeater { each = match st.environment { none => [], eid => [eid] }  as = :eid
          p $"**Deploys to:** ${link_of(eid)}"
        }
        wdoc_repeater { each = match len(st.gates) { 0 => [], _ => [true] }  as = :_g
          p $"**Runs when:** ${join(st.gates, "; ")}"
        }
        wdoc_repeater { each = match len(st.next) { 0 => [], _ => [true] }  as = :_n
          p $"**Then:** ${join(map(st.next, fn(nx: identifier) -> utf8 { stage_name_of(pl, nx) }), ", ")}"
        }
      }
    }

    wdoc_repeater { each = match pl.body { none => [], _ => [true] }  as = :_b
      project { from = pl.body }
    }
    edit_object { kind = "pipeline"  target = $"${pl.id}" }
  }
}
