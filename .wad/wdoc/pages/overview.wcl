// View 1 — Overview: the landing page (wad metadata, stakeholders, RACI)
// plus the ADR sub-section (one numbered table of every decision, the
// timeline, one page per ADR). Resolves the `let` helpers from
// wdoc/book/main.wcl.

let adr_status_text = fn(s: AdrStatus) -> utf8 {
  match s { :proposed => "Proposed", :accepted => "Accepted", :rejected => "Rejected",
            :superseded => "Superseded", :deprecated => "Deprecated", _ => "Unknown" }
}
let adr_status_class = fn(s: AdrStatus) -> utf8 {
  match s { :accepted => "tip", :proposed => "note", _ => "warning" }
}
// The reference form every rendering uses: ADR-001, ADR-002, …
let adr_ref = fn(a: Adr) -> utf8 { $"ADR-${pad_start($"${a.n}", 3, "0")}" }
let adrs_sorted = sort_by(adrs, fn(a: Adr) -> utf8 { pad_start($"${a.n}", 6, "0") })

page index { title = "Overview"
  h1 $"${wad.name}"
  p  $"_${wad.summary}_"
  wdoc_repeater { each = match wad.description { none => [], d => [d] }  as = :d
    p $"${d}"
  }

  table {
    rows = [
      ["Described version", wad.version ?? "—"],
      ["Created", wad.created],
      ["Last updated", wad.updated ?? wad.created],
      ["Maintainer", wad.maintainer ?? "—"],
    ]
  }

  h2 "Stakeholders"
  wdoc_repeater { each = match len(stakeholders) { 0 => [true], _ => [] }  as = :_e
    p "_No stakeholders recorded._"
  }
  wdoc_repeater { each = match len(stakeholders) { 0 => [], _ => [true] }  as = :_s
    table {
      header = ["Name", "Role", "Organisation", "Contact"]
      rows = map(stakeholders, fn(st: Stakeholder) -> list<utf8> {
        [st.name, st.role, st.org ?? "—", st.contact ?? "—"]
      })
    }
  }

  h2 "Responsibilities (RACI)"
  wdoc_repeater { each = match len(raci) { 0 => [true], _ => [] }  as = :_e
    p "_No RACI rows recorded._"
  }
  wdoc_repeater { each = match len(raci) { 0 => [], _ => [true] }  as = :_r
    table {
      header = ["Activity", "Responsible", "Accountable", "Consulted", "Informed"]
      rows = map(raci, fn(r: RaciEntry) -> list<utf8> {
        [r.activity, stakeholder_names(r.responsible), stakeholder_names(r.accountable),
         stakeholder_names(r.consulted), stakeholder_names(r.informed)]
      })
    }
  }

  h2 "Decisions"
  p $"${len(adrs)} architecture decision record(s) — see [Decisions (ADRs)](adrs_page)."
  edit_object { kind = "wad"  target = $"${wad.id}" }
}

// --- ADR index -------------------------------------------------------------
page adrs_page { title = "Decisions (ADRs)"
  h1 "Architecture decision records"
  p  "Every decision of record for the system, in one numbered table — reference them as ADR-001, ADR-002, … Each links to its full record."

  wdoc_repeater { each = match len(adrs) { 0 => [true], _ => [] }  as = :_e
    p "_No decisions recorded._"
  }
  wdoc_repeater { each = match len(adrs) { 0 => [], _ => [true] }  as = :_t
    table {
      header = ["#", "Decision", "Status", "Date", "Deciders"]
      rows = map(adrs_sorted, fn(a: Adr) -> list<utf8> {
        [$"**${adr_ref(a)}**", $"[${a.title}](adr_${a.id})", adr_status_text(a.status),
         a.date, join(a.deciders, ", ")]
      })
    }
    diagram { width = 900  height = 240  pan_zoom = true
      timeline { width = 880.0  height = 220.0  title = "Decision timeline"
        items = map(adrs_sorted, fn(a: Adr) -> TimelineItem { { label: adr_ref(a), on: a.date } })
      }
    }
  }
}

// --- one page per ADR --------------------------------------------------------
wdoc_repeater { each = adrs  as = :a
  page $"adr_${a.id}" { title = $"${adr_ref(a)}: ${a.title}"
    h1 $"${adr_ref(a)} — ${a.title}"
    callout $"${adr_status_text(a.status)}" {
      class = [adr_status_class(a.status)]
      body  = $"Decided ${a.date}${match len(a.deciders) { 0 => "", _ => $" by ${join(a.deciders, ", ")}" }}."
    }
    wdoc_repeater { each = match a.context { none => [], c => [c] }  as = :c
      h2 "Context"
      p $"${c}"
    }
    wdoc_repeater { each = match a.decision { none => [], d => [d] }  as = :d
      h2 "Decision"
      p $"${d}"
    }
    wdoc_repeater { each = match a.consequences { none => [], c => [c] }  as = :c
      h2 "Consequences"
      p $"${c}"
    }
    wdoc_repeater { each = match a.body { none => [], _ => [true] }  as = :_b
      project { from = a.body }
    }
    wdoc_repeater { each = match a.supersedes { none => [], sid => [sid] }  as = :sid
      wdoc_repeater { each = filter(adrs, fn(x: Adr) -> bool { x.id == sid })  as = :prev
        p $"Supersedes [${adr_ref(prev)}: ${prev.title}](adr_${prev.id})."
      }
    }
    wdoc_repeater { each = filter(adrs, fn(x: Adr) -> bool { x.supersedes == a.id })  as = :nxt
      p $"Superseded by [${adr_ref(nxt)}: ${nxt.title}](adr_${nxt.id})."
    }
    edit_object { kind = "adr"  target = $"${a.id}" }
  }
}
