// WCL — architecture document (WAD) root.
//
// A WAD is a typed data model of a software system, rendered into a
// twelve-chapter book by the templates under wdoc/book/. This one documents
// WCL itself and doubles as the reference WAD the `wcl init wad` scaffold is
// derived from.
//
//   wcl check .wad/wad.wcl                                   # validate the model
//   wcl wdoc serve .wad/wdoc/book/main.wcl --comment         # review the book
//   wcl wdoc build .wad/wdoc/book/main.wcl --out .wad/_site  # render it
//   wcl wad spec --from <rev> .wad/wad.wcl                   # derive a change spec

import <wdoc.wcl>
import "./schema/base.wcl"
import "./schema/extensions.wcl"
import "./data/main.wcl"

schema_version = "0.3.0"

wad wcl {
  name    = "WCL"
  summary = "The WCL typed configuration language, its CLI, and the wdoc documentation generator."
  version = "0.27.0-alpha"
  description = <<END
WCL is a strongly-typed configuration and schema language with a document
model, plus the tooling around it: the `wcl` CLI (parse / check / eval /
format / diff / scaffold / LSP), the **wdoc** static-site and skill
generator, and editor integrations. This WAD tracks the whole estate — the
`wcl` binary, the editor integrations, and the documentation it publishes —
as one reviewed architecture model.
END
  tags       = ["wcl", "language", "tooling", "documentation"]
  created    = "2026-07-02"
}
