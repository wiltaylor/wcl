// The one system in the estate — WCL — and its C4 containers: the four
// crates that compose into the binary plus the two editor integrations,
// which ship separately but belong to the same system. The docs site is
// NOT a system — documentation is an output and lives in the
// documentation view (data/documentation/).
namespace wcl.wad

system wcl {
  name    = "WCL"
  summary = "The WCL language and its tooling: the `wcl` binary, the wdoc generator, the language server, and the editor integrations."
  owner   = wil_taylor
  repos   = [wcl_monorepo]
  body {
    p "One Rust workspace builds everything a user installs: the `wcl` binary (parse / check / eval / format / diff / scaffold / wdoc / LSP) plus the separately-shipped editor integrations. The documentation the system renders about itself is catalogued in the documentation view."
  }
}

// --- containers of wcl ------------------------------------------------------

container wcl_cli {
  system     = wcl
  name       = "WCL binary"
  summary    = "The `wcl` binary — every user-facing command, the scaffolder, and the wdoc dev server."
  kind       = :cli
  technology = "Rust (clap, axum)"
  repo       = wcl_monorepo
  body {
    p "The full command reference — every command with its usage and flags — lives in the [CLI component](component_cli_commands)."
  }
}

container wcl_lang {
  system     = wcl
  name       = "wcl_lang"
  summary    = "The language library: lexer, parser, AST, document view, lazy evaluator, schema validator, host bindings."
  kind       = :library
  technology = "Rust"
  repo       = wcl_monorepo
}

container wcl_wdoc {
  system     = wcl
  name       = "wcl_wdoc"
  summary    = "The static-site / skill generator: WCL stdlib, HTML/Markdown/PDF/skill backends, diagram layout."
  kind       = :library
  technology = "Rust"
  repo       = wcl_monorepo
}

container wcl_wskill {
  system     = wcl
  name       = "wcl_wskill"
  summary    = "The wskill model: a wskill folder's unit graph — units, nested index trees, related and pin edges, per-unit block lists — as typed Rust, loadable at a git revision."
  kind       = :library
  technology = "Rust"
  repo       = wcl_monorepo
  body {
    p "Sits between wcl_wdoc (which renders a wskill's projections) and the CLI, because the model has several consumers that must not need a running editor: `wcl wskill graph`, the curator agent, and the browser editor's graph view."
  }
}

container wcl_lsp {
  system     = wcl
  name       = "wcl_lsp"
  summary    = "The language server behind `wcl lsp`: diagnostics, completion, formatting, cross-file navigation."
  kind       = :service
  technology = "Rust (tower-lsp, ropey)"
  repo       = wcl_monorepo
}

container vscode_extension {
  system     = wcl
  name       = "VS Code extension"
  summary    = "Editor client that spawns `wcl lsp` and wires WCL files to it. Ships separately as a `.vsix`."
  kind       = :editor_plugin
  technology = "TypeScript"
  repo       = wcl_monorepo
}

container tree_sitter_wcl {
  system     = wcl
  name       = "tree-sitter-wcl"
  summary    = "Tree-sitter grammar for editors that highlight via tree-sitter. Ships separately from the binary."
  kind       = :library
  technology = "Tree-sitter (C)"
  repo       = wcl_monorepo
}
