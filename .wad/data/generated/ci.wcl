// GENERATED by scripts/extract_ci.py — do not hand-edit; re-run `just wad-extract`.
// Source: .github/workflows/*.yml
namespace wcl.wad

pipeline ci {
  name    = "CI"
  repo    = wcl_monorepo
  trigger = "push to ** / pull_request to main"
  summary = "Extracted from .github/workflows/ci.yml"
  pipeline_stage st_ci_check {
    name = "fmt + lint + test"
    next = [st_ci_build_cli, st_ci_package_vscode]
  }
  pipeline_stage st_ci_fuzz {
    name = "fuzz smoke (all targets)"
  }
  pipeline_stage st_ci_version {
    name = "Calculate version"
    gates = ["github.event_name == 'push' && github.ref == 'refs/heads/main'"]
    next = [st_ci_build_cli, st_ci_package_vscode, st_ci_release]
  }
  pipeline_stage st_ci_build_cli {
    name = "Build CLI (${{ matrix.target }})"
    summary = "Stamp version → Build → Stage asset"
    gates = ["needs.version.outputs.do_release == 'true'", "matrix build"]
    next = [st_ci_release]
  }
  pipeline_stage st_ci_package_vscode {
    name = "Package VS Code (.vsix)"
    summary = "Stamp vsix version"
    gates = ["needs.version.outputs.do_release == 'true'"]
    next = [st_ci_release]
  }
  pipeline_stage st_ci_release {
    name = "Create GitHub pre-release"
    summary = "Tag"
    gates = ["needs.version.outputs.do_release == 'true'"]
  }
}

pipeline deploy_site {
  name    = "Deploy Site"
  repo    = wcl_monorepo
  trigger = "push to main touching docs/**, install.sh, install.ps1, .github/workflows/deploy-site.yml / workflow_dispatch"
  summary = "Extracted from .github/workflows/deploy-site.yml"
  pipeline_stage st_deploy_site_deploy {
    name = "deploy"
    summary = "Install Rust toolchain → Build wcl → Build the landing page → Build the reference book → Stage install scripts → Deploy to Cloudflare Pages"
  }
}
