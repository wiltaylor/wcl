// SCRIPT-OWNED zone — extractor scripts overwrite files here wholesale.
// Never hand-edit anything under generated/; fix the extractor and re-run
// (`just wad-extract`). Hand-authored data may REFERENCE generated ids,
// but never lives here. Commit these files: `wcl diff` against an old git
// revision materialises that revision's tree, so uncommitted generated
// data would silently vanish from the old side of every diff.
namespace wcl.wad

import "./cargo.wcl"    // owned by scripts/extract_cargo.py
import "./ci.wcl"       // owned by scripts/extract_ci.py
import "./http_api.wcl" // owned by scripts/extract_http_api.py
import "./justfile.wcl" // owned by scripts/extract_justfile.py
import "./modules.wcl"  // owned by scripts/extract_modules.py
import "./releases.wcl" // owned by scripts/extract_releases.py

