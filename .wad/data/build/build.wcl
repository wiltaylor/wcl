// View 6 data — the repository. The pipelines are NOT authored here —
// scripts/extract_ci.py owns them (data/generated/ci.wcl), parsed from the
// real workflow files.
namespace wcl.wad

repository wcl_monorepo {
  name             = "wcl"
  url              = "https://github.com/wiltaylor/wcl"
  summary          = "The whole estate in one workspace: language, CLI, LSP, wdoc, editors, docs."
  primary_language = "Rust"
  repo_path rp_crates   { path = "crates/"   description = "Rust workspace: wcl_lang, wcl (CLI), wcl_lsp, wcl_wdoc, wcl_wskill (+ fuzz targets)." }
  repo_path rp_docs     { path = "docs/"     description = "The wcl.dev site, authored in WCL; wskills under docs/wskills/." }
  repo_path rp_editors  { path = "editors/"  description = "VS Code extension and tree-sitter grammar." }
  repo_path rp_examples { path = "examples/" description = "Fixture files used by tests (imports/, errors/)." }
  repo_path rp_wad      { path = ".wad/"     description = "This architecture document." }
  body {
    p "Local development is `cargo` + `just`: `just workspace-test`, `just workspace-lint`, and `cargo fmt --all -- --check` are the merge gates (see the verification-gates standard). The justfile is the catalogue of every dev entry point."
  }
}
