// Release trigger rules — the commit-trailer semantics of shipping
// (release_trigger is a WAD extension block, see schema/extensions.wcl;
// the trailer-gated releases ADR records why).
namespace wcl.wad

release_trigger rt_pre_release {
  trailer = "pre-release: true"
  effect  = "CI's version job computes the next `-alpha` version, builds the artifact matrix (Linux/Windows CLI binaries, the VS Code `.vsix`), and publishes a GitHub pre-release tagged `vX.Y.Z-alpha`."
  notes   = "The routine shipping path — see the cut-a-pre-release SOP."
}

release_trigger rt_release_blocked {
  trailer = "release: true"
  effect  = "Fails the build on purpose."
  notes   = "Stable releases are disabled while WCL is pre-1.0 — nobody ships one by accident."
}

release_trigger rt_no_trailer {
  trailer = "(none)"
  effect  = "Tests only; nothing ships."
}
