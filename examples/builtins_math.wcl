// Math / geometry builtins. Every function works in f64 and accepts
// any numeric argument (integers are widened), returning f64.

// Trigonometry (radians). `pi()` / `tau()` / `e()` are nullary constants.
@schemaless half_turn = sin(pi() / 2.0)        // 1.0
@schemaless full_turn = cos(tau())             // 1.0
@schemaless deg90     = sin(radians(90.0))     // 1.0

// Powers, roots, exponentials, logarithms.
@schemaless root      = sqrt(144)              // 12.0
@schemaless power     = pow(2, 10)             // 1024.0
@schemaless diagonal  = hypot(3, 4)            // 5.0
@schemaless log_ten   = log10(1000.0)          // 3.0

// Rounding.
@schemaless down      = floor(3.9)             // 3.0
@schemaless up        = ceil(3.1)              // 4.0
@schemaless nearest   = round(2.5)             // 3.0

// Sign / magnitude / comparison.
@schemaless magnitude = abs(-7.5)              // 7.5
@schemaless smaller   = min(3, 7.5)            // 3.0
@schemaless larger    = max(3, 7.5)            // 7.5
@schemaless bounded   = clamp(12.0, 0.0, 10.0) // 10.0

// Composes with map/range to lay points around a circle.
@schemaless circle_x = map(
  range(0, 4),
  fn(i: i64) -> f64 cos(tau() * i / 4.0),
)
