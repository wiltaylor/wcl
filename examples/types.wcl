# Exercises every typed literal supported by WCL today.

# Defaults
port  = 8080
ratio_default = 0.5

# Signed integers
small = -120i8
mid16 = -1_000i16
mid32 = 100_000i32
big64 = 9_000_000_000_000i64
huge  = 170_141_183_460_469_231_731_687_303_715_884_105_727i128
psize = 16isize

# Unsigned integers
byte  = 200u8
u16v  = 60_000u16
u32v  = 4_000_000_000u32
u64v  = 18_000_000_000_000_000_000u64
u128v = 340_282_366_920_938_463_463_374_607_431_768_211_455u128
usz   = 16usize

# Bases (no suffix defaults to i64)
mask  = 0xFFu32
flags = 0b1010_1100u8
mode  = 0o755u16

# Floats
ratio = 1.5f32
fmath = 2.0e-3

# Strings
greet   = "hello"
banner  = utf8"hi"
name    = ascii"alpha"
hello16 = utf16"hello"
hello32 = utf32"hello"
