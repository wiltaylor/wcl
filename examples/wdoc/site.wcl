// Fundamental-block demo with classes + layout. Higher-level blocks
// land in a follow-up and lower to these.

class accent {
  color = "#003a8c"
  bold  = true
}

class boxed {
  border  = "1px solid #999"
  padding = "0.5rem"
}

class badge {
  font_family = "sans-serif"
  color       = "#444"
}

page index {
  h1 "Pipeline overview" {}

  text {
    span "Welcome to wdoc " {}
    span "— now with classes." {
      class = ["accent"]
    }
  }

  // Inline patterns: `**bold**`, `_italic_`, backtick-code and
  // `[label](url)` are recognised inside any span's text and
  // rendered as styled inline elements. Nesting works recursively.
  // The link pattern also recognises bare page names — `[About](about)`
  // resolves to the `about` page's HTML file.
  text {
    span "Try **bold**, _italic_, `code`, [external](https://example.com), [About](about), and [Connections](connections)." {}
  }

  column {
    widths = [50.0, 50.0]
    class  = ["boxed"]
    text { span "Left column." {} }
    text { span "Right column." {} }
  }

  diagram {
    width  = 280
    height = 130

    rect {
      x = 10.0
      y = 10.0
      width  = 60.0
      height = 60.0
      fill   = "#cce"
    }
    circle {
      cx = 120.0
      cy = 40.0
      r  = 24.0
      stroke = "black"
    }
    line {
      x1 = 0.0
      y1 = 40.0
      x2 = 280.0
      y2 = 40.0
      stroke = "#888"
    }
    label "halfway" {
      x = 110.0
      y = 76.0
    }
    polygon {
      points = "180,10 230,40 180,70"
      fill   = "#fc8"
    }

    // Grid-laid container: 3 cells, each rect stretches to fill its
    // cell via anchors at all four sides.
    container {
      class         = ["badge"]
      anchor_left   = 10.0
      anchor_top    = 90.0
      width         = 260.0
      height        = 30.0
      layout        = :grid
      columns       = 3
      cell_width    = 80.0
      cell_height   = 30.0
      gap           = 5.0
      rect {
        anchor_left   = 0.0
        anchor_right  = 0.0
        anchor_top    = 0.0
        anchor_bottom = 0.0
        fill   = "#eef"
        stroke = "#99c"
      }
      rect {
        anchor_left   = 0.0
        anchor_right  = 0.0
        anchor_top    = 0.0
        anchor_bottom = 0.0
        fill   = "#fee"
        stroke = "#c99"
      }
      rect {
        anchor_left   = 0.0
        anchor_right  = 0.0
        anchor_top    = 0.0
        anchor_bottom = 0.0
        fill   = "#efe"
        stroke = "#9c9"
      }
    }
  }

  h2 "Flowchart" {}

  // Layered auto-layout: shapes don't declare x/y. The renderer
  // topologically ranks them from the connection graph and stacks
  // each rank top-to-bottom (default direction). Elbow routing
  // then connects them with right-angled paths.
  diagram {
    width     = 320
    height    = 220
    layout    = :layered
    layer_gap = 20.0

    process "Validate" {
      id     = validate
      width  = 100.0
      height = 40.0
      fill   = "#eef"
      stroke = "#446"
    }
    decision "Match?" {
      id     = check
      width  = 100.0
      height = 60.0
      fill   = "#fee"
      stroke = "#a44"
    }
    terminator "End" {
      id     = done
      width  = 100.0
      height = 40.0
      fill   = "#efe"
      stroke = "#494"
    }

    validate -> check :flow
    check    -> done  :flow
  }
}

page about {
  h1 "About" {}

  text {
    span "This is the about page. Back to [the index](index)." {}
  }
}

page connections {
  h1 "Connections" {}

  text {
    span "Shapes connect via `lhs -> rhs :kind` statements. The renderer ranks shapes via the layered solver, routes elbow paths around other shapes via A*, and nudges parallel segments apart so dense graphs stay readable. The diagrams below stress each piece." {}
  }

  h2 "Branching flow" {}

  // Wide DAG: one entry fans out into two parallel branches that
  // each visit a couple of stops before reconverging on a single
  // merge decision and final terminator.
  diagram {
    width     = 520
    height    = 360
    layout    = :layered
    layer_gap = 30.0

    process    "Start"      { id = start    width = 100.0 height = 40.0 fill = "#eef" stroke = "#446" }
    decision   "Route?"     { id = branch   width = 100.0 height = 60.0 fill = "#fee" stroke = "#a44" }
    process    "Path A.1"   { id = path_a1  width = 100.0 height = 40.0 fill = "#cce" stroke = "#447" }
    process    "Path A.2"   { id = path_a2  width = 100.0 height = 40.0 fill = "#cce" stroke = "#447" }
    process    "Path B.1"   { id = path_b1  width = 100.0 height = 40.0 fill = "#ecc" stroke = "#744" }
    process    "Path B.2"   { id = path_b2  width = 100.0 height = 40.0 fill = "#ecc" stroke = "#744" }
    decision   "Merge OK?"  { id = merge    width = 100.0 height = 60.0 fill = "#fee" stroke = "#a44" }
    terminator "Done"       { id = done     width = 100.0 height = 40.0 fill = "#efe" stroke = "#494" }

    start  -> branch  :flow
    branch -> path_a1 :flow
    branch -> path_b1 :flow
    path_a1 -> path_a2 :flow
    path_b1 -> path_b2 :flow
    path_a2 -> merge  :flow
    path_b2 -> merge  :flow
    merge   -> done   :flow
  }

  h2 "Sub-graphs in containers" {}

  text {
    span "Each container runs its own layered solver via its `@connections(Edge) edges` field. The diagram-level `norm -> validate` cross-container edge bridges them." {}
  }

  diagram {
    width     = 600
    height    = 280
    layout    = :layered
    direction = :left_to_right
    layer_gap = 60.0

    container {
      id        = ingest
      width     = 240.0
      height    = 240.0
      layout    = :layered
      layer_gap = 20.0

      process "Fetch"     { id = fetch width = 120.0 height = 40.0 fill = "#cce" stroke = "#447" }
      process "Parse"     { id = parse width = 120.0 height = 40.0 fill = "#cce" stroke = "#447" }
      process "Normalize" { id = norm  width = 120.0 height = 40.0 fill = "#cce" stroke = "#447" }

      fetch -> parse :flow
      parse -> norm  :flow
    }

    container {
      id        = pipeline
      width     = 240.0
      height    = 240.0
      layout    = :layered
      layer_gap = 20.0

      decision   "Validate?" { id = validate width = 120.0 height = 60.0 fill = "#fee" stroke = "#a44" }
      process    "Index"     { id = index    width = 120.0 height = 40.0 fill = "#ecc" stroke = "#744" }
      terminator "Persist"   { id = persist  width = 120.0 height = 40.0 fill = "#efe" stroke = "#494" }

      validate -> index   :flow
      index    -> persist :flow
    }

    // Cross-container bridge. The recursive id resolver finds
    // `norm` inside `ingest` and `validate` inside `pipeline`.
    norm -> validate :data
  }

  h2 "Hub topology" {}

  text {
    span "One central node receives from three sources and feeds three sinks. The edge-separation pass keeps the six surrounding corridors visible." {}
  }

  diagram {
    width     = 520
    height    = 280
    layout    = :layered
    layer_gap = 30.0

    process "Source 1" { id = src1  width = 100.0 height = 40.0 fill = "#cce" stroke = "#447" }
    process "Source 2" { id = src2  width = 100.0 height = 40.0 fill = "#cce" stroke = "#447" }
    process "Source 3" { id = src3  width = 100.0 height = 40.0 fill = "#cce" stroke = "#447" }
    process "Hub"      { id = hub   width = 120.0 height = 50.0 fill = "#fee" stroke = "#a44" }
    process "Sink 1"   { id = sink1 width = 100.0 height = 40.0 fill = "#ecc" stroke = "#744" }
    process "Sink 2"   { id = sink2 width = 100.0 height = 40.0 fill = "#ecc" stroke = "#744" }
    process "Sink 3"   { id = sink3 width = 100.0 height = 40.0 fill = "#ecc" stroke = "#744" }

    src1 -> hub :flow
    src2 -> hub :flow
    src3 -> hub :flow
    hub  -> sink1 :flow
    hub  -> sink2 :flow
    hub  -> sink3 :flow
  }

  h2 "Restricted anchors" {}

  text {
    span "`connect_points` narrows where an edge may attach. The middle node only accepts arrivals on its `:south` side, so the second arrow has to bend down then over." {}
  }

  diagram {
    width     = 360
    height    = 160
    layout    = :layered
    direction = :left_to_right
    layer_gap = 40.0

    rect {
      id = sender
      width = 80.0  height = 40.0
      fill = "#cce"  stroke = "#447"
      connect_points = [:east]
    }
    rect {
      id = waystation
      width = 80.0  height = 40.0
      fill = "#fee"  stroke = "#a44"
      connect_points = [:south]
    }
    rect {
      id = receiver
      width = 80.0  height = 40.0
      fill = "#cec"  stroke = "#494"
      connect_points = [:west]
    }

    sender     -> waystation :data
    waystation -> receiver   :data
  }

  text {
    span "Back to [the index](index) or read [About](about)." {}
  }
}
