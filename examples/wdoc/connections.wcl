// Connections in wdoc diagrams.
//
// Shapes are identified by their `id` field. Connection statements
// reference those ids — they may sit anywhere within the diagram
// (including deep inside a container) and the renderer draws an
// arrow between the resolved shapes.
//
// The bundled `Edge` schema (declared in wdoc.wcl) accepts any pair
// of SvgBlocks. Users can declare their own connection schemas with
// custom kinds and consume them via `@connections(MyEdge)` on a
// custom block type.
//
// Every diagram on this page is `:layered` — shapes carry only
// their `width` / `height` (and id), and the layout system ranks
// them via the connection graph.

page index {
  h1 "Flat connections" {}

  diagram {
    width     = 360
    height    = 140
    layout    = :layered
    direction = :left_to_right
    layer_gap = 30.0

    process    "Validate" { id = step_a width = 80.0 height = 40.0 fill = "#eef" stroke = "#446" }
    decision   "Match?"   { id = step_b width = 80.0 height = 60.0 fill = "#fee" stroke = "#a44" }
    terminator "Done"     { id = step_c width = 70.0 height = 40.0 fill = "#efe" stroke = "#494" }

    step_a -> step_b
    step_b -> step_c :flow
  }

  h1 "Cross-container connections" {}

  // Each container runs its own internal layered layout via its
  // `@connections(Edge) edges` slot. The outer diagram is `:layered
  // :left_to_right` and places the two containers side by side —
  // driven by the diagram-level `inner_a -> inner_b` edge.
  diagram {
    width     = 360
    height    = 200
    layout    = :layered
    layer_gap = 30.0
    node_gap  = 40.0

    container {
      id        = group_left
      width     = 140.0
      height    = 60.0
      layout    = :layered

      rect { id = inner_a width = 100.0 height = 40.0 fill = "#cce" stroke = "#446" }
    }
    container {
      id        = group_right
      width     = 140.0
      height    = 60.0
      layout    = :layered

      rect { id = inner_b width = 100.0 height = 40.0 fill = "#ecc" stroke = "#a44" }
    }

    inner_a -> inner_b :data
  }

  h1 "Obstacle routing" {}

  // Three rects laid out left-to-right by the layered solver. The
  // middle node is part of the chain so the A* router still has to
  // bend the path around it when src and dst share a y.
  diagram {
    width     = 360
    height    = 120
    layout    = :layered
    direction = :left_to_right
    layer_gap = 30.0

    rect { id = src_a   width = 60.0 height = 40.0 fill = "#cce" stroke = "#446" }
    rect { id = blocker width = 60.0 height = 80.0 fill = "#ddd" stroke = "#888" }
    rect { id = dst_a   width = 60.0 height = 40.0 fill = "#cec" stroke = "#494" }

    src_a   -> blocker :flow
    blocker -> dst_a   :flow
  }
}
