// WDoc presentation template example.
//
// Build:
//   wcl wdoc build examples/wdoc/presentation.wcl --output /tmp/wdoc-presentation

import <wdoc.wcl>

use wdoc::{doc, page, section, style, layout, h1, h2, p, paragraph, callout, bold}

doc presentation_demo {
    title = "WDoc Presentation Demo"
    template = "presentation"

    section overview "Overview" {
        section intro "Intro" {}
        section building_blocks "Building Blocks" {}
        section full_slide "Full Slide" {}
    }

    section details "Details" {
        section navigation "Navigation" {}
        section sections "Sections" {}
    }
}

style default {
    paragraph {
        line_height = "1.45"
    }
}

page intro {
    section = "presentation_demo.overview.intro"
    title = "Presentation Template"

    layout {
        h1 "Presentation Template"
        paragraph {
            content = "A WDoc document can now choose " + bold("presentation") + " as its template and render each page as a slide."
        }
    }
}

page building_blocks {
    section = "presentation_demo.overview.building_blocks"
    title = "Built From WDoc Blocks"

    layout {
        h2 "Built From WDoc Blocks"
        p "Slides still use the same headings, paragraphs, code blocks, callouts, equations, diagrams, and layout groups as book pages."
        callout blocks {
            header = "Same content model"
            color = "#2563eb"
            p "The template changes the page shell and layout chrome, not the content blocks."
        }
    }
}

page full_slide {
    section = "presentation_demo.overview.full_slide"
    title = "Full Slide"

    layout {
        h1 "Full Slide"
        p "Presentation pages use the whole viewport for slide content. The arrow-key navigation stays hidden until you use it."
    }
}

page navigation {
    section = "presentation_demo.details.navigation"
    title = "Directional Navigation"

    layout {
        h1 "Directional Navigation"
        p "Use left and right to move within a section. Use up and down to move between section rows."
        callout keys {
            header = "Keyboard"
            color = "#16a34a"
            p "Arrow keys move in the matching direction. Space and PageDown also move right."
        }
    }
}

page sections {
    section = "presentation_demo.details.sections"
    title = "Section Rows"

    layout {
        h2 "Section Rows"
        p "Top-level WDoc sections become presentation rows. Vertical movement keeps the nearest matching slide position in the next or previous row."
    }
}
