// Entry point for the wdoc example. It declares THREE sites in one
// document — a feature `showcase`, a `docs` book, and a `blog`:
//
//   wcl wdoc serve examples/wdoc/main.wcl          # / = chooser, all sites
//   wcl wdoc serve examples/wdoc/main.wcl --site showcase   # just one
//   wcl wdoc build --out _site examples/wdoc/main.wcl
//     → _site/index.html  chooser linking to each site
//       _site/showcase/…  _site/docs/…  _site/blog/…
//
// A page joins a site via its `sites` array (e.g. `sites = [:showcase]`);
// a page with no `sites` is shared by every site. Shared styles and
// iconsets below are global, so all three sites can use them.

class accent {
  color = "#003a8c"
  bold  = true
}

class boxed {
  border  = "1px solid #999"
  padding = "0.5rem"
}

class badge {
  font_family = "sans-serif"
  color       = "#444"
}

// Recolour icons through the class system. Icons paint with
// `currentColor`, so a `color` here themes any icon carrying the class
// (in a diagram directly, or inline via an iconset / icon_def `class`).
class "icon-accent" {
  color = "#5e81ac"
  dark  { color = "#88c0d0" }
}

// Icon sets map a reference name to one of the bundled packs and set
// default styling. `ui` draws from Lucide (stroke-based), `bs` from
// Bootstrap Icons (fill-based); both honour currentColor.
iconset ui {
  pack  = "lucide"
  size  = "1.15em"
  color = "#003a8c"
  icon_def "heart" { color = "#bf616a" }
}
iconset bs {
  pack = "bootstrap"
}

// The feature showcase: the `webpage` template (title header + top nav
// built from this site's pages). Its pages are tagged `sites = [:showcase]`.
site showcase {
  default_template = :webpage
  title            = "wdoc showcase"
}

// A docs book: the `book` template (fixed sidebar from the `toc` below).
// It's Nord-themed (dark by default) with a light/dark toggle — the
// theme classes below are scoped to this site, so the showcase and blog
// keep their default light look.
site docs {
  default_template = :book
  title            = "Project Docs"
  theme_toggle     = true
  toc {
    chapter "Introduction" { page = index }
    chapter "Guide" {
      chapter "Getting started" { page = getting_started }
      chapter "Configuration"   { page = config }
    }
  }
}

// Nord theme for the `docs` site only (`sites = [:docs]`). Dark is the
// default; `light {}` is the system-light alternative; the sidebar
// toggle overrides either (it sets `:root[data-theme=…]`). `wdoc-body`
// is the page background hook.
class "wdoc-body" { sites = [:docs]
  color = "#d8dee9"  background = "#2e3440"
  light { color = "#2e3440"  background = "#eceff4" }
}

// Page headings (h1–h6) cycle through the Nord frost + aurora hues over
// the bundled heading sizing. Each carries a darker Nord shade under
// light mode so it stays legible on the light background.
class "heading-1" { sites = [:docs]  color = "#88c0d0"  light { color = "#5e81ac" } }
class "heading-2" { sites = [:docs]  color = "#81a1c1"  light { color = "#5e81ac" } }
class "heading-3" { sites = [:docs]  color = "#8fbcbb"  light { color = "#4c566a" } }
class "heading-4" { sites = [:docs]  color = "#a3be8c"  light { color = "#4c566a" } }
class "heading-5" { sites = [:docs]  color = "#ebcb8b"  light { color = "#d08770" } }
class "heading-6" { sites = [:docs]  color = "#b48ead"  light { color = "#b48ead" } }

// Links + the sidebar (menu) headings: the book title, the section
// grouping labels, and the current chapter, all in Nord frost.
class "link"         { sites = [:docs]  color = "#88c0d0"  light { color = "#5e81ac" } }
class "book-title"   { sites = [:docs]  color = "#88c0d0"  light { color = "#5e81ac" } }
class "book-section" { sites = [:docs]  color = "#8fbcbb"  light { color = "#5e81ac" } }
class "current"      { sites = [:docs]  color = "#88c0d0"  light { color = "#5e81ac" } }

// A blog: the `webpage` template again, with its own posts.
site blog {
  default_template = :webpage
  title            = "Project Blog"
}

// Per-page sources. Each imported file declares one `page <name> { ... }`
// block; page names are unique per site (the showcase, docs, and blog
// each have their own `index`).
import "./pages/overview.wcl"
import "./pages/about.wcl"
import "./pages/connections.wcl"
import "./pages/code.wcl"
import "./pages/charts.wcl"
import "./pages/terminal.wcl"
import "./pages/icons.wcl"
import "./pages/tilemap.wcl"
import "./pages/wireframe.wcl"
import "./pages/docs.wcl"
import "./pages/blog.wcl"

// The showcase landing page: a table of contents linking to every other
// showcase page. `sites = [:showcase]` keeps it (and its links) inside
// the showcase site.
page index { sites = [:showcase]
  h1 "wdoc showcase" {}

  text {
    span "This site exercises the wdoc feature set. Each section below links to a focused demo page." {}
  }

  h2 "Pages" {}
  text { span "• [Overview](overview) — text, classes, columns, a diagram, and a flowchart." {} }
  text { span "• [Connections](connections) — flat edges, cross-container edges, obstacle routing, hubs, restricted anchors." {} }
  text { span "• [Charts](charts) — bar, line, and pie charts with scales, axis labels, multiple series, and class theming." {} }
  text { span "• [Code blocks](code) — syntax-highlighted listings for Rust, Python, JSON, WCL, and an unknown language." {} }
  text { span "• [Terminals](terminal) — character-grid terminals with Nerd Font glyphs, full ANSI styling, and asciinema replay." {} }
  text { span "• [Icons](icons) — inline `:name:` glyphs and scalable diagram icons from the bundled Lucide / Bootstrap packs, themed via classes." {} }
  text { span "• [Tilemaps](tilemap) — index-based tile grids cut from a spritesheet `tileset`, authored numerically or with a symbol legend, overlaid with other diagram shapes." {} }
  text { span "• [Wireframes](wireframe) — UI mockups from nesting widgets (windows, buttons, inputs, dropdowns, checkboxes, radios, toggles) arranged with layout blocks and themed via classes." {} }
  text { span "• [About](about) — what this example demonstrates." {} }
}
