// Entry point for the wdoc example. It declares THREE sites in one
// document — a feature `showcase`, a `docs` book, and a `blog`:
//
//   wcl wdoc serve examples/wdoc/main.wcl          # / = chooser, all sites
//   wcl wdoc serve examples/wdoc/main.wcl --site showcase   # just one
//   wcl wdoc build --out _site examples/wdoc/main.wcl
//     → _site/index.html  chooser linking to each site
//       _site/showcase/…  _site/docs/…  _site/blog/…
//
// A page joins a site via its `sites` array (e.g. `sites = [:showcase]`);
// a page with no `sites` is shared by every site. Shared styles and
// iconsets below are global, so all three sites can use them.
//
// The `import <wdoc.wcl>` below pulls in the embedded wdoc standard
// library — every stdlib block is then in scope here and in the pages
// this file imports.
import <wdoc.wcl>

// Keyword/emphasis accent used across the showcase prose. Uses the
// theme's accent hue (`var(--wdoc-accent)`) rather than a fixed colour,
// so it stays bright and readable on every site's theme (a hardcoded
// dark blue turned to mud on the dark themes).
class accent {
  color = "var(--wdoc-accent)"
  bold  = true
}

class boxed {
  border  = "1px solid #999"
  padding = "0.5rem"
}

class badge {
  font_family = "sans-serif"
  color       = "#444"
}

// Recolour icons through the class system. Icons paint with
// `currentColor`, so a `color` here themes any icon carrying the class
// (in a diagram directly, or inline via an iconset / icon_def `class`).
class "icon-accent" {
  color = "#5e81ac"
  dark  { color = "#88c0d0" }
}

// The `lucide` and `bootstrap` packs are built in (declared in the wdoc
// stdlib), so they need no `iconset` here — see `:bootstrap.github:` on
// the icons page. Declaring an `iconset` is only for renaming a pack or
// setting default styling: `ui` is a customized Lucide set (size/colour
// plus a per-icon `icon_def`), which also drives bare `:name:` lookups.
iconset ui {
  pack  = "lucide"
  size  = "1.15em"
  color = "#003a8c"
  icon_def "heart" { color = "#bf616a" }
}

// The feature showcase: the `webpage` template (title header + top nav
// built from this site's pages). Its pages are tagged `sites = [:showcase]`.
// `root = true` makes it the site served at `/` (so its index is the
// landing demo); the docs and blog sites render into subdirectories.
site showcase {
  default_template = :webpage
  title            = "wdoc showcase"
  root             = true
  // A built-in colour theme. One line recolours the whole site — page
  // background / text, links, headings, code, charts, callouts, tables.
  theme            = :tokyonight
  // Curated navbar: top-level links plus two click-to-open dropdowns and
  // an external link. An `item` with nested `item`s is a dropdown parent;
  // `page` links to a page (validated), `href` to an external URL.
  menu {
    item "Overview" { page = overview }
    item "Diagrams" {
      item "Connections" { page = connections }
      item "Charts"      { page = charts }
      item "Timelines"   { page = timeline }
      item "Maps"        { page = map }
      item "Tilemaps"    { page = tilemap }
      item "Dopesheets"  { page = dopesheet }
    }
    item "Content" {
      item "Code"      { page = code }
      item "Math"      { page = math }
      item "Terminal"  { page = terminal }
      item "Icons"     { page = icons }
      item "Wireframe" { page = wireframe }
    }
    item "About"  { page = about }
    item "Source" { href = "https://github.com/wiltaylor/wcl" }
  }
}

// A docs book: the `book` template (fixed sidebar from the `toc` below),
// with the built-in Nord theme and a light/dark toggle. The `theme` does
// all the colour work the showcase used to spell out as `class` blocks —
// dark by default, a light variant under `prefers-color-scheme: light`,
// and the toggle (`:root[data-theme=…]`) overriding either. `accent`
// picks the hue for links and the current chapter.
site docs {
  default_template = :book
  title            = "Project Docs"
  theme_toggle     = true
  theme            = :nord
  accent           = :cyan
  toc {
    chapter "Introduction" { page = index }
    chapter "Guide" {
      chapter "Getting started" { page = getting_started }
      chapter "Configuration"   { page = config }
    }
  }
}

// A `class` block still overrides the theme per-element by cascade: here
// the docs book title takes the accent hue (the theme leaves it at the
// body colour). Demonstrates that themes set the baseline and classes
// fine-tune on top.
class "book-title" { sites = [:docs]  color = "#88c0d0"  light { color = "#5e81ac" } }

// A blog: the `webpage` template again, with its own posts and the
// Gruvbox theme — so all three sites in this document look distinct.
site blog {
  default_template = :webpage
  title            = "Project Blog"
  theme            = :gruvbox
}

// Per-page sources. Each imported file declares one `page <name> { ... }`
// block; page names are unique per site (the showcase, docs, and blog
// each have their own `index`).
import "./pages/overview.wcl"
import "./pages/about.wcl"
import "./pages/connections.wcl"
import "./pages/code.wcl"
import "./pages/math.wcl"
import "./pages/charts.wcl"
import "./pages/timeline.wcl"
import "./pages/terminal.wcl"
import "./pages/icons.wcl"
import "./pages/tilemap.wcl"
import "./pages/dopesheet.wcl"
import "./pages/map.wcl"
import "./pages/wireframe.wcl"
import "./pages/docs.wcl"
import "./pages/blog.wcl"

// The showcase has no dedicated landing page: the `overview` page sets
// `start = true`, so it's served at `/` (see pages/overview.wcl).
