// WDoc site-builder template example.
//
// Build:
//   wcl wdoc build examples/wdoc/site_builder.wcl --output /tmp/wdoc-site-builder

import <wdoc.wcl>

use wdoc::{doc, page, section, style, layout, p, paragraph, site_header, site_footer, site_hero, site_section, site_card_grid, site_card, bold, link}

doc site_builder_demo {
    title = "WDoc Site Builder"
    template = "site"

    site_header {
        title = "WDoc Site Builder"
        paragraph {
            content = link("Home", "index.html") + " " + link("Guide", "guide/getting-started.html")
        }
    }

    site_footer {
        text = "Built with WDoc site templates."
    }

    section home "Home" {}
    section guide "Guide" {
        section getting_started "Getting Started" {}
        section layouts "Layouts" {}
    }
}

style default {
    paragraph {
        line_height = "1.65"
    }
}

page home {
    section = "site_builder_demo.home"
    title = "Home"
    path = "index.html"
    summary = "A Hugo-style WDoc site home page."
    tags = ["site", "templates"]
    categories = ["examples"]

    layout {
        site_hero {
            title = "Build Websites With WDoc"
            subtitle = "A general page-builder template using WDoc blocks, generated lists, and taxonomies."
            image = "images/hero-banner.png"
        }

        site_section {
            title = "Page Parts"
            paragraph {
                content = "Reusable site parts are authored as normal " + bold("WDoc blocks") + " and rendered through the same template pipeline as document content."
            }

            site_card_grid {
                site_card {
                    title = "Generated Sections"
                    href = "sections/site-builder-demo-guide.html"
                    summary = "Section pages are generated from the WDoc outline."
                }
                site_card {
                    title = "Tags"
                    href = "tags/site.html"
                    summary = "Taxonomy pages are generated from page metadata."
                }
            }
        }
    }
}

page getting_started {
    section = "site_builder_demo.guide.getting_started"
    title = "Getting Started"
    path = "guide/getting-started.html"
    date = "2026-05-17"
    weight = 1
    summary = "The first guide page in the generated site."
    tags = ["site", "guide"]
    categories = ["examples"]

    layout {
        site_section {
            title = "Getting Started"
            p "Set `template = \"site\"` on the document and use WDoc blocks to compose each page."
        }
    }
}

page layouts {
    section = "site_builder_demo.guide.layouts"
    title = "Layouts"
    path = "guide/layouts.html"
    weight = 2
    summary = "Use WDoc layout and site blocks together."
    tags = ["layout", "site"]
    categories = ["examples"]

    layout {
        site_section {
            title = "Layouts"
            p "Site pages can still use the existing layout, diagram, equation, callout, and content blocks."
        }
    }
}
