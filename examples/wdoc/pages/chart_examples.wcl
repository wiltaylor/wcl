import "./shared.wcl"

page chart_examples {
    section = "my_docs.diagrams.chart_examples"
    title = "Chart Widgets"

    layout {
        vsplit main {
            split content {
                size = 100

                heading h1 {
                    level = 1
                    content = "Chart Widgets"
                }

                paragraph intro {
                    content = "Pie, bar, and line charts are available as WDoc drawing widgets. Each chart reads child <code>chart_point</code> blocks, and Cartesian charts expose explicit axis scale attributes."
                }

                diagram chart_gallery {
                    width = 860
                    height = 560

                    bar_chart revenue {
                        x = 24
                        y = 24
                        width = 390
                        height = 240
                        title = "Quarterly revenue"
                        y_min = 0
                        y_max = 120
                        tick_count = 5
                        surface_fill = "#f8fafc"
                        border_stroke = "#cbd5e1"
                        grid_stroke = "#e2e8f0"
                        axis_stroke = "#64748b"
                        label_fill = "#0f172a"

                        chart_point q1 { label = "Q1" value = 38 color = "#2563eb" }
                        chart_point q2 { label = "Q2" value = 72 color = "#16a34a" }
                        chart_point q3 { label = "Q3" value = 91 color = "#f97316" }
                        chart_point q4 { label = "Q4" value = 108 color = "#7c3aed" }
                    }

                    line_chart activation {
                        x = 444
                        y = 24
                        width = 390
                        height = 240
                        title = "Activation rate"
                        x_min = 0
                        x_max = 5
                        y_min = 0
                        y_max = 100
                        tick_count = 5
                        line_stroke = "#0891b2"
                        surface_fill = "#f8fafc"
                        border_stroke = "#cbd5e1"
                        grid_stroke = "#e2e8f0"
                        axis_stroke = "#64748b"
                        label_fill = "#0f172a"

                        chart_point wk1 { label = "W1" x = 0 value = 18 }
                        chart_point wk2 { label = "W2" x = 1 value = 34 }
                        chart_point wk3 { label = "W3" x = 2 value = 48 }
                        chart_point wk4 { label = "W4" x = 3 value = 63 }
                        chart_point wk5 { label = "W5" x = 4 value = 74 }
                        chart_point wk6 { label = "W6" x = 5 value = 86 }
                    }

                    pie_chart channels {
                        x = 24
                        y = 296
                        width = 390
                        height = 220
                        title = "Acquisition mix"
                        surface_fill = "#f8fafc"
                        border_stroke = "#cbd5e1"
                        label_fill = "#0f172a"

                        chart_point search { label = "Search" value = 44 color = "#2563eb" }
                        chart_point social { label = "Social" value = 26 color = "#f97316" }
                        chart_point direct { label = "Direct" value = 18 color = "#16a34a" }
                        chart_point ads { label = "Ads" value = 12 color = "#dc2626" }
                    }

                    line_chart scaled {
                        x = 444
                        y = 296
                        width = 390
                        height = 220
                        title = "Custom y-axis scale"
                        y_min = 50
                        y_max = 80
                        tick_count = 4
                        show_points = true
                        line_stroke = "#7c3aed"
                        surface_fill = "#f8fafc"
                        border_stroke = "#cbd5e1"
                        grid_stroke = "#e2e8f0"
                        axis_stroke = "#64748b"
                        label_fill = "#0f172a"

                        chart_point mon { label = "Mon" value = 54 }
                        chart_point tue { label = "Tue" value = 58 }
                        chart_point wed { label = "Wed" value = 63 }
                        chart_point thu { label = "Thu" value = 71 }
                        chart_point fri { label = "Fri" value = 76 }
                    }
                }

                code source {
                    language = "wcl"
                    content = "bar_chart revenue {\n    y_min = 0\n    y_max = 120\n\n    chart_point q1 { label = \"Q1\" value = 38 }\n    chart_point q2 { label = \"Q2\" value = 72 }\n    chart_point q3 { label = \"Q3\" value = 91 }\n}\n\nline_chart activation {\n    x_min = 0\n    x_max = 5\n    y_min = 0\n    y_max = 100\n\n    chart_point wk1 { label = \"W1\" x = 0 value = 18 }\n    chart_point wk2 { label = \"W2\" x = 1 value = 34 }\n}\n\npie_chart channels {\n    chart_point search { label = \"Search\" value = 44 }\n    chart_point social { label = \"Social\" value = 26 }\n}"
                }
            }
        }
    }
}
