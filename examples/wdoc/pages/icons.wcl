// Icon demo: the inline `:name:` handler and scalable diagram icons,
// drawn from the bundled Lucide / Bootstrap packs and themed through the
// class system. The `lucide` / `bootstrap` packs are built in (declared
// in the wdoc stdlib), so `:bootstrap.github:` needs no setup; the custom
// `ui` iconset + the `icon-accent` class live in main.wcl.

page icons { sites = [:showcase]
  h1 "Icons" {}

  // A bare `:name:` resolves against the declared iconsets (here the `ui`
  // set, sized `1.15em` and coloured), while `:pack.name:` reaches a
  // built-in pack directly. Icons follow `currentColor`.
  text {
    span "Inline Lucide glyphs :star: :git-branch: :database: :server: and built-in Bootstrap glyphs :bootstrap.github: :bootstrap.gear: :bootstrap.cloud: sit right in the text." {}
  }

  // A per-icon `icon_def` override recolours just one icon; an unknown
  // name is left as plain text, and a stray colon pair like 12:00 is
  // untouched.
  text {
    span "The :heart: gets its own colour from an `icon_def`, while `:not-a-real-icon:` and the time 12:00 stay literal." {}
  }

  h2 "In diagrams" {}

  // Icons are placeable, scalable diagram shapes: give them an id, let
  // `:layered` rank them from the edge graph, size them with width /
  // height, recolour with a `class`, or sit one on a tinted background.
  diagram {
    width     = 360
    height    = 90
    layout    = :layered
    direction = :left_to_right
    layer_gap = 70.0

    // From the built-in `bootstrap` pack (no iconset declared), recoloured
    // purely through the `icon-accent` class — and its dark-mode override —
    // which drives currentColor.
    icon "bootstrap.server" {
      id     = src
      width  = 44.0
      height = 44.0
      class  = ["icon-accent"]
    }
    icon "bootstrap.arrow-left-right" {
      id     = mid
      width  = 40.0
      height = 40.0
    }
    // Coloured by the `ui` iconset default and sat on a tinted background.
    icon "database" {
      id         = dst
      set        = ui
      width      = 44.0
      height     = 44.0
      background = "#eceff4"
    }

    src -> mid :data
    mid -> dst :data
  }

  h2 "Icons on shapes" {}

  // Any box-like shape takes an `icon` property — the renderer draws it
  // as a badge over the shape's box (default top-left; override with
  // `icon_pos` / `icon_size` / `icon_class`). The shape keeps its own
  // label and fill.
  diagram {
    width     = 360
    height    = 240
    layout    = :layered
    layer_gap = 26.0

    process "Configure" {
      id     = cfg
      width  = 150.0
      height = 46.0
      fill   = "#eef"
      stroke = "#446"
      icon   = "settings"
    }
    decision "Healthy?" {
      id       = ok
      width    = 150.0
      height   = 70.0
      fill     = "#fee"
      stroke   = "#a44"
      icon     = "heart"
      icon_pos = :top_right
    }
    // `bootstrap.database` (built-in pack, no default colour), so the
    // `icon-accent` class (and its dark-mode override) drives its colour.
    terminator "Store" {
      id     = store
      width  = 150.0
      height = 46.0
      fill   = "#efe"
      stroke = "#494"
      icon   = "bootstrap.database"
      icon_class = ["icon-accent"]
    }

    cfg -> ok    :flow
    ok  -> store :flow
  }
}
