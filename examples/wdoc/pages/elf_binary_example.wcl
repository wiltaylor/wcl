import "./shared.wcl"

page elf_binary_example {
    section = "my_docs.guide.elf_binary_example"
    title = "ELF Binary Example"
    let bash_path = "/bin/bash"
    let bash_available = file_exists(bash_path, { allow_absolute = true })
    let bash_rows = bash_available ? import_codec(bash_path, "elf", { allow_absolute = true chunk_size = 64 }) : []
    let bash_elf = bash_available ? bash_rows[0] : null
    let bash_sections = bash_available ? bash_elf.sections : []
    let bash_summary_rows = bash_available ? [
        { field = "Format", value = bash_elf.format },
        { field = "Endian", value = bash_elf.endian },
        { field = "Type", value = bash_elf.type_name },
        { field = "Machine", value = bash_elf.machine_name },
        { field = "Entry", value = bash_elf.entry },
        { field = "Sections", value = bash_elf.header.shnum }
    ] : [
        { field = "Status", value = "/bin/bash not available" }
    ]
    let bash_section_rows = map(bash_sections, section => {
        index = section.index
        name = section.name == "" ? "(null)" : section.name
        type = section.type_name
        offset = section.offset
        size = section.size
        address = section.address
    })

    layout {
        vsplit intro {
            split main {
                size = 100

                heading h1 {
                    level = 1
                    content = "ELF Binary Example"
                }

                paragraph p1 {
                    content = "The standard <code>codec::elf</code> decoder reads ELF header metadata and exposes sections as stream-backed binary ranges. This page inspects the local <code>/bin/bash</code> binary at build time."
                }

                code c1 {
                    language = "wcl"
                    content = "let rows = import_codec(\"/bin/bash\", \"elf\", {\n    allow_absolute = true\n    chunk_size = 64\n})\n\nlet elf = rows[0]\nlet sections = elf.sections"
                }
            }
        }

        vsplit summary {
            split left {
                size = 40

                heading h2 {
                    level = 2
                    content = "Header"
                }

                data_table header_table {
                    caption = "/bin/bash ELF header"
                    rows = bash_summary_rows
                }
            }

            split right {
                size = 60

                heading h3 {
                    level = 2
                    content = "Section Streams"
                }

                paragraph p2 {
                    content = bash_available ?
                        "Each section row includes a <code>data</code> stream. Consumers can read chunks with <code>section.data.next()</code> or materialize only the sections they need." :
                        "This example reads <code>/bin/bash</code> live during the WDoc build. The file was not present on this system, so the ELF table was skipped."
                }

                code c2 {
                    language = "wcl"
                    content = "let text = filter(sections, s => s.name == \".text\")[0]\nlet first_chunk = text.data.next()"
                }
            }
        }

        vsplit sections {
            split table_split {
                size = 100

                heading h4 {
                    level = 2
                    content = "Sections"
                }

                data_table section_table {
                    caption = "/bin/bash sections"
                    rows = bash_section_rows
                }
            }
        }
    }
}
