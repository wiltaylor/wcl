import "./shared.wcl"

page tooltip_examples {
    section = "my_docs.diagrams.tooltip_examples"
    title = "Interactive Tooltips"

    layout {
        vsplit intro {
            split content {
                size = 100

                heading title {
                    level = 1
                    content = "Interactive Tooltips"
                }

                paragraph overview {
                    content = "Hover a target in the diagram, or tab to it with the keyboard, to see its tooltip appear after a short delay. Tooltips follow the pointer and hide when the target loses hover or focus."
                }

                callout try_it {
                    icon = "mouse-pointer-2"
                    header = "Try it"
                    color = color_link
                    paragraph copy {
                        content = "Move your pointer over the API card, Deploy button, or Worker node below. The tooltip content is part of the diagram, so it can use normal drawing shapes and WDoc text blocks."
                    }
                }

                diagram tooltip_interactions {
                    width = 760
                    height = 320

                    rect api_card {
                        x = 42
                        y = 86
                        width = 190
                        height = 96
                        rx = 10
                        fill = color_nav_bg
                        stroke = color_link
                        stroke_width = 2

                        text api_title {
                            x = 18
                            y = 18
                            width = 154
                            height = 24
                            content = "API Gateway"
                            anchor = "start"
                            font_size = 15
                            font_weight = "700"
                            fill = color_text
                        }

                        text api_hint {
                            x = 18
                            y = 50
                            width = 154
                            height = 24
                            content = "Hover me"
                            anchor = "start"
                            font_size = 12
                            fill = "#94a3b8"
                        }

                        tooltip api_tip {
                            width = 270
                            height = 116
                            delay_ms = 300
                            offset_x = 18
                            offset_y = 16
                            surface_fill = color_bg
                            border_stroke = color_link

                            text_block body {
                                x = 12
                                y = 10
                                width = 246
                                height = 92
                                paragraph summary {
                                    content = "Routes **signed** requests, checks quotas, and emits `AuditEvent` records."
                                }
                            }
                        }
                    }

                    button deploy_button {
                        x = 310
                        y = 110
                        width = 150
                        height = 44
                        label = "Deploy"
                        variant = "primary"

                        tooltip deploy_tip {
                            width = 236
                            height = 94
                            delay_ms = 250
                            offset_x = 18
                            offset_y = 14
                            surface_fill = color_bg
                            border_stroke = color_success

                            circle status {
                                x = 12
                                y = 16
                                r = 5
                                fill = color_success
                            }

                            text_block body {
                                x = 28
                                y = 10
                                width = 196
                                height = 74
                                paragraph p {
                                    content = "Starts a **staged** rollout after checks pass."
                                }
                            }
                        }
                    }

                    graph_node worker {
                        x = 548
                        y = 70
                        width = 170
                        title = "Worker"
                        subtitle = "Tab focus works"
                        graph_row queue {
                            label = "Queue"
                            left_port = "in"
                        }
                        graph_row events {
                            label = "Events"
                            right_port = "out"
                        }

                        tooltip worker_tip {
                            width = 250
                            height = 120
                            delay_ms = 300
                            offset_x = -250
                            offset_y = 18
                            surface_fill = color_bg
                            border_stroke = color_nav_border

                            text_block docs {
                                x = 12
                                y = 10
                                width = 226
                                height = 98
                                paragraph p {
                                    content = "Consumes queued jobs and sends status updates downstream."
                                }
                                code sample {
                                    language = "wcl"
                                    content = "connection q { from = \"api\" to = \"worker.in\" }"
                                }
                            }
                        }
                    }
                }

                heading syntax_heading {
                    level = 2
                    content = "Authoring Pattern"
                }

                paragraph syntax_copy {
                    content = "Attach a nested <code>tooltip</code> block to any drawing shape with an ID. Use <code>delay_ms</code> and offsets to tune when and where the overlay appears."
                }

                code syntax {
                    language = "wcl"
                    content = "rect api {\n    x = 40\n    y = 40\n    width = 160\n    height = 70\n    text label { content = \"API\" }\n\n    tooltip api_tip {\n        width = 220\n        height = 90\n        delay_ms = 300\n        offset_x = 16\n        offset_y = 16\n\n        text_block body {\n            paragraph p {\n                content = \"Tooltip content can use WDoc text.\"\n            }\n        }\n    }\n}"
                }
            }
        }
    }
}
