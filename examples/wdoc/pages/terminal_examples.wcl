import "./shared.wcl"

class term_popup_menu {
    opacity = 0
    visible = false
    pointer_events = "none"
    transition = "opacity 120ms ease"
    z_index = 20

    state shown {
        opacity = 1
        visible = true
        pointer_events = "all"
        z_index = 40
    }
}

class term_menubar_menu {
    opacity = 0
    visible = false
    pointer_events = "none"
    transition = "opacity 120ms ease"
    z_index = 15

    state shown {
        opacity = 1
        visible = true
        pointer_events = "all"
        z_index = 35
    }
}

class term_control_theme {
    background_fill = "#111827"
    foreground_fill = "#e5e7eb"
    label_fill = "#e5e7eb"
    placeholder_fill = "#94a3b8"
    muted_fill = "#64748b"
    accent_fill = "#22c55e"
    hover_background_fill = "#1f2937"
    hover_foreground_fill = "#06121f"
}

class term_grid_slide {
    background_fill = "#22c55e"
    label_fill = "#06121f"
    hover_background_fill = "#86efac"

    animation nudge_right {
        duration_ms = 650
        timing_function = "ease-in-out"
        iteration_count = "infinite"
        direction = "alternate"
        fill_mode = "both"

        keyframe start {
            offset = 0
            x = 356
            y = 268
            width = 120
            height = 16
        }

        keyframe end {
            offset = 100
            x = 372
            y = 268
            width = 120
            height = 16
        }
    }

    state hovered {
        animation = "nudge_right"
    }
}

class term_ocean_theme {
    background_fill = "#0e7490"
    foreground_fill = "#ecfeff"
    label_fill = "#ecfeff"
    accent_fill = "#67e8f9"
    hover_background_fill = "#22d3ee"
    hover_foreground_fill = "#083344"
}

class term_warning_theme {
    background_fill = "#451a03"
    foreground_fill = "#ffedd5"
    label_fill = "#ffedd5"
    accent_fill = "#f59e0b"
    hover_background_fill = "#f59e0b"
    hover_foreground_fill = "#1c1917"
}

class term_example_popup {
    background_fill = "#1e1b4b"
    foreground_fill = "#ddd6fe"
    hover_background_fill = "#a78bfa"
    hover_foreground_fill = "#111827"
    opacity = 0
    visible = false
    pointer_events = "none"
    transition = "opacity 120ms ease"
    z_index = 20

    state shown {
        opacity = 1
        visible = true
        pointer_events = "all"
        z_index = 40
    }
}

class term_example_slide {
    background_fill = "#22c55e"
    label_fill = "#052e16"
    hover_background_fill = "#86efac"

    animation slide_by_cells {
        duration_ms = 800
        timing_function = "ease-in-out"
        iteration_count = "infinite"
        direction = "alternate"
        fill_mode = "both"

        keyframe start {
            offset = 0
            x = 52
            y = 156
            width = 120
            height = 18
        }

        keyframe end {
            offset = 100
            x = 92
            y = 156
            width = 120
            height = 18
        }
    }

    state hovered {
        animation = "slide_by_cells"
    }
}

page terminal_examples {
    section = "my_docs.diagrams.terminal_examples"
    title = "Terminal Diagrams"

    layout {
        vsplit intro {
            split main {
                size = 100

                heading h1 {
                    level = 1
                    content = "Terminal Diagrams"
                }

                paragraph p1 {
                    content = "Terminal blocks render fixed row and column grids with a bundled JetBrainsMono Nerd Font. They support ANSI SGR formatting for terminal captures and can host row/column TUI widgets."
                }
            }
        }

        vsplit basic {
            split main {
                size = 100

                heading h2_basic {
                    level = 2
                    content = "ANSI output and TUI widgets"
                }

                paragraph p_basic_animation {
                    content = "The compact controls below are themed with diagram classes. Hover the Deploy button to run a class animation that moves it exactly two terminal columns."
                }

                diagram terminal_capture {
                    width = 780
                    height = 380

                    terminal shell {
                        x = 20
                        y = 18
                        rows = 18
                        cols = 86
                        font_size = 13
                        cell_width = 8
                        cell_height = 16
                        background_fill = "#08111f"
                        foreground_fill = "#d7e0ff"
                        rx = 10
                        content = "$ cargo test -p wcl_wdoc\n\u001b[32mPASS\u001b[0m terminal::ansi_parser_supports_sgr_colors_and_styles\n\u001b[32mPASS\u001b[0m terminal::terminal_svg_renders_ansi_and_tui_children\n\u001b[33mWARN\u001b[0m docs examples include generated terminal assets"

                        terminal_menubar app_menu {
                            row = 5
                            col = 2
                            cols = 42
                            close_targets = "file_menu,run_menu,view_menu,help_menu,build_menu,test_menu"
                            foreground_fill = "#d7e0ff"
                            background_fill = "#111827"
                            hover_background_fill = "#38bdf8"
                            hover_foreground_fill = "#06121f"

                            menu_item file_item { label = "File" target = "file_menu" }
                            menu_item run_item { label = "Run" target = "run_menu" }
                            menu_item view_item { label = "View" target = "view_menu" }
                            menu_item help_item { label = "Help" disabled = "true" }
                        }

                        terminal_menu file_menu {
                            row = 6
                            col = 2
                            rows = 4
                            cols = 18
                            leave_close_targets = "file_menu"
                            class = "term_menubar_menu"
                            foreground_fill = "#d7e0ff"
                            background_fill = "#111827"
                            hover_background_fill = "#38bdf8"
                            hover_foreground_fill = "#06121f"

                            menu_item new_item { label = "New" }
                            menu_item open_item { label = "Open" }
                            menu_item save_item { label = "Save" }
                            menu_item quit_item { label = "Quit" }

                        }

                        terminal_menu run_menu {
                            row = 6
                            col = 9
                            rows = 4
                            cols = 18
                            close_targets = "build_menu,test_menu"
                            leave_close_targets = "run_menu,build_menu,test_menu"
                            leave_guard_targets = "run_menu,build_menu,test_menu"
                            class = "term_menubar_menu"
                            foreground_fill = "#d7e0ff"
                            background_fill = "#111827"
                            hover_background_fill = "#38bdf8"
                            hover_foreground_fill = "#06121f"

                            menu_item build_item { label = "Build" target = "build_menu" }
                            menu_item test_item { label = "Test" target = "test_menu" }
                            menu_item format_item { label = "Format" }
                            menu_item deploy_item { label = "Deploy" disabled = "true" }

                        }

                        terminal_menu build_menu {
                            row = 6
                            col = 27
                            rows = 3
                            cols = 18
                            leave_close_targets = "run_menu,build_menu,test_menu"
                            leave_guard_targets = "run_menu,build_menu,test_menu"
                            class = "term_menubar_menu"
                            foreground_fill = "#d7e0ff"
                            background_fill = "#111827"
                            hover_background_fill = "#38bdf8"
                            hover_foreground_fill = "#06121f"

                            menu_item debug_item { label = "Debug" }
                            menu_item release_item { label = "Release" }
                            menu_item docs_item { label = "Docs" }

                        }

                        terminal_menu test_menu {
                            row = 7
                            col = 27
                            rows = 3
                            cols = 18
                            leave_close_targets = "run_menu,build_menu,test_menu"
                            leave_guard_targets = "run_menu,build_menu,test_menu"
                            class = "term_menubar_menu"
                            foreground_fill = "#d7e0ff"
                            background_fill = "#111827"
                            hover_background_fill = "#38bdf8"
                            hover_foreground_fill = "#06121f"

                            menu_item unit_item { label = "Unit" }
                            menu_item integration_item { label = "Integration" }
                            menu_item snapshot_item { label = "Snapshot" }

                        }

                        terminal_menu view_menu {
                            row = 6
                            col = 14
                            rows = 3
                            cols = 18
                            leave_close_targets = "view_menu"
                            class = "term_menubar_menu"
                            foreground_fill = "#d7e0ff"
                            background_fill = "#111827"
                            hover_background_fill = "#38bdf8"
                            hover_foreground_fill = "#06121f"

                            menu_item problems_item { label = "Problems" }
                            menu_item output_item { label = "Output" }
                            menu_item terminal_item { label = "Terminal" }

                        }

                        terminal_box task_panel {
                            row = 10
                            col = 2
                            rows = 6
                            cols = 38
                            title = "Task runner"
                            foreground_fill = "#93c5fd"
                            background_fill = "#0f172a"
                        }

                        terminal_menu tasks {
                            row = 12
                            col = 4
                            rows = 3
                            cols = 30
                            foreground_fill = "#d7e0ff"
                            background_fill = "#111827"
                            hover_background_fill = "#38bdf8"
                            hover_foreground_fill = "#06121f"

                            menu_item build_docs_item { label = "Build docs" }
                            menu_item run_tests_item { label = "Run tests" }
                            menu_item deploy_preview_item { label = "Deploy preview" }
                        }

                        terminal_text form_title {
                            row = 10
                            col = 43
                            content = "\u001b[36mCompact controls\u001b[0m"
                        }

                        terminal_textbox filter_input {
                            row = 11
                            col = 43
                            rows = 2
                            cols = 34
                            class = "term_control_theme"
                            value = "deploy --env prod"
                            cursor_col = 17
                            background_fill = "#111827"
                            foreground_fill = "#e5e7eb"
                            accent_fill = "#38bdf8"
                        }

                        terminal_checkbox dry_run {
                            row = 14
                            col = 43
                            cols = 18
                            class = "term_control_theme"
                            label = "Dry run"
                            checked = "true"
                            accent_fill = "#22c55e"
                        }

                        terminal_radio target_prod {
                            row = 15
                            col = 43
                            cols = 18
                            class = "term_control_theme"
                            label = "Production"
                            selected = "true"
                            accent_fill = "#38bdf8"
                        }

                        terminal_dropdown deploy_env {
                            row = 14
                            col = 62
                            cols = 15
                            class = "term_control_theme"
                            value = "prod"
                            z_index = 30
                            background_fill = "#111827"
                            foreground_fill = "#e5e7eb"
                            hover_background_fill = "#38bdf8"
                            hover_foreground_fill = "#06121f"

                            menu_item dev_item { label = "dev" }
                            menu_item stage_item { label = "stage" }
                            menu_item prod_item { label = "prod" }
                        }

                        terminal_button deploy_button {
                            row = 16
                            col = 43
                            cols = 15
                            class = "term_grid_slide"
                            label = "Deploy"
                            accent_fill = "#22c55e"
                        }

                        terminal_button cancel_button {
                            row = 16
                            col = 60
                            cols = 12
                            class = "term_control_theme"
                            label = "Cancel"
                            variant = "secondary"
                        }

                        terminal_text hint {
                            row = 17
                            col = 2
                            content = "\u001b[2mEnter runs the selected task. Right click the output for actions.\u001b[0m"
                        }

                        terminal_cursor cursor {
                            row = 5
                            col = 0
                            mode = "bar"
                            fill = "#f8fafc"
                        }
                    }
                }

                code basic_code {
                    language = "wcl"
                    content = "diagram terminal_capture {\n    width = 780\n    height = 380\n\n    terminal shell {\n        x = 20\n        y = 18\n        rows = 18\n        cols = 86\n        font_size = 13\n        background_fill = \"#08111f\"\n        foreground_fill = \"#d7e0ff\"\n\n        terminal_textbox filter_input {\n            row = 11\n            col = 43\n            rows = 2\n            cols = 34\n            value = \"deploy --env prod\"\n            cursor_col = 17\n            accent_fill = \"#38bdf8\"\n        }\n\n        terminal_checkbox dry_run {\n            row = 14\n            col = 43\n            label = \"Dry run\"\n            checked = \"true\"\n            accent_fill = \"#22c55e\"\n        }\n\n        terminal_radio target_prod {\n            row = 15\n            col = 43\n            label = \"Production\"\n            selected = \"true\"\n        }\n\n        terminal_dropdown deploy_env {\n            row = 14\n            col = 62\n            cols = 15\n            value = \"prod\"\n            menu_item dev_item { label = \"dev\" }\n            menu_item stage_item { label = \"stage\" }\n            menu_item prod_item { label = \"prod\" }\n        }\n\n        terminal_button deploy_button {\n            row = 16\n            col = 43\n            cols = 15\n            label = \"Deploy\"\n            accent_fill = \"#22c55e\"\n        }\n    }\n}"
                }
            }
        }

        vsplit themes {
            split main {
                size = 100

                heading h2_themes {
                    level = 2
                    content = "Theming and grid animation"
                }

                paragraph p_themes {
                    content = "Terminal widgets can be themed with diagram classes. Animation keyframes use SVG pixels, so this example sets explicit cell metrics and moves the animated button in whole-column steps."
                }

                diagram terminal_theme_animation {
                    width = 620
                    height = 310

                    terminal themed_shell {
                        x = 20
                        y = 18
                        rows = 14
                        cols = 58
                        font_size = 13
                        cell_width = 10
                        cell_height = 18
                        background_fill = "#08111f"
                        foreground_fill = "#d7e0ff"
                        content = "$ wdoc theme demo\n\u001b[36mINFO\u001b[0m class colours drive terminal widgets"

                        terminal_textbox themed_search {
                            row = 4
                            col = 4
                            rows = 2
                            cols = 28
                            class = "term_ocean_theme"
                            placeholder = "search docs"
                            cursor_col = 6
                        }

                        terminal_checkbox themed_check {
                            row = 7
                            col = 4
                            cols = 24
                            class = "term_warning_theme"
                            label = "Require review"
                            checked = "true"
                        }

                        terminal_dropdown themed_env {
                            row = 7
                            col = 34
                            cols = 16
                            class = "term_ocean_theme"
                            value = "stage"
                            z_index = 30

                            menu_item dev_item { label = "dev" }
                            menu_item stage_item { label = "stage" }
                            menu_item prod_item { label = "prod" }
                        }

                        terminal_button animated_ship {
                            row = 8
                            col = 4
                            cols = 12
                            class = "term_example_slide"
                            label = "Ship"
                        }

                        terminal_menu themed_popup {
                            row = 4
                            col = 36
                            rows = 3
                            cols = 16
                            class = "term_example_popup"

                            menu_item logs_item { label = "Logs" }
                            menu_item trace_item { label = "Trace" }
                            menu_item metrics_item { label = "Metrics" }
                        }

                        terminal_button popup_toggle {
                            row = 10
                            col = 4
                            cols = 16
                            class = "term_ocean_theme"
                            label = "Show menu"

                            event show_popup {
                                trigger = "hover"
                                target = "themed_popup"
                                state = "shown"
                                mode = "while"
                            }
                        }
                    }
                }

                code terminal_theme_animation_code {
                    language = "wcl"
                    content = "class term_ocean_theme {\n    background_fill = \"#0e7490\"\n    label_fill = \"#ecfeff\"\n    accent_fill = \"#67e8f9\"\n    hover_background_fill = \"#22d3ee\"\n    hover_foreground_fill = \"#083344\"\n}\n\nclass term_example_slide {\n    background_fill = \"#22c55e\"\n    label_fill = \"#052e16\"\n    hover_background_fill = \"#86efac\"\n\n    animation slide_by_cells {\n        duration_ms = 800\n        timing_function = \"ease-in-out\"\n        iteration_count = \"infinite\"\n        direction = \"alternate\"\n        fill_mode = \"both\"\n\n        keyframe start { offset = 0\n                         x = 52\n                         y = 156\n                         width = 120\n                         height = 18 }\n        keyframe end { offset = 100\n                       x = 92\n                       y = 156\n                       width = 120\n                       height = 18 }\n    }\n\n    state hovered { animation = \"slide_by_cells\" }\n}\n\ndiagram terminal_theme_animation {\n    terminal themed_shell {\n        rows = 14\n        cols = 58\n        cell_width = 10\n        cell_height = 18\n\n        terminal_textbox themed_search {\n            row = 4\n            col = 4\n            cols = 28\n            class = \"term_ocean_theme\"\n            placeholder = \"search docs\"\n        }\n\n        terminal_button animated_ship {\n            row = 8\n            col = 4\n            cols = 12\n            class = \"term_example_slide\"\n            label = \"Ship\"\n        }\n    }\n}"
                }
            }
        }

        vsplit interactive {
            split main {
                size = 100

                heading h2_interactive {
                    level = 2
                    content = "Interactive context menu"
                }

                paragraph p2 {
                    content = "Terminal widgets use the same diagram event and class system as wireframes. Right-click the terminal surface below to toggle the menu."
                }

                diagram terminal_context {
                    width = 680
                    height = 250

                    terminal session {
                        x = 20
                        y = 20
                        rows = 11
                        cols = 74
                        font_size = 13
                        background_fill = "#0b1020"
                        foreground_fill = "#e5e7eb"
                        content = "$ wcl wdoc serve examples/wdoc/site.wcl examples/wdoc/pages.wcl\n\u001b[36mINFO\u001b[0m serving docs at http://localhost:3000\n\u001b[90mTRACE\u001b[0m rebuilt 18 pages in 84ms"

                        event open_context {
                            trigger = "right_click"
                            target = "menu"
                            state = "shown"
                            mode = "toggle"
                        }

                        terminal_context_menu menu {
                            row = 4
                            col = 42
                            rows = 4
                            cols = 22
                            leave_close_targets = "menu"
                            class = "term_popup_menu"
                            foreground_fill = "#e5e7eb"
                            background_fill = "#111827"
                            hover_background_fill = "#60a5fa"
                            hover_foreground_fill = "#07111f"

                            menu_item copy_line_item { label = "Copy line" }
                            menu_item copy_command_item { label = "Copy command" }
                            menu_item inspect_item { label = "Inspect" }
                            menu_item clear_item { label = "Clear" }

                        }
                    }
                }
            }
        }
    }
}
