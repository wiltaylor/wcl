page wireframe { sites = [:showcase]
  h1 "Wireframe widgets"

  text {
    span "Wireframe widgets mock up a UI from composable blocks. Windows and panels hold other widgets, and layout blocks (`wf_row` / `wf_column` / `wf_grid`) arrange them. Back to [the overview](overview)."
  }

  h2 "A sign-in window"

  // A `wf_window` is a container: its child widgets render in its body
  // (stacked vertically by default). Drop a `wf_row` / `wf_grid` to
  // arrange controls differently, and a `wf_panel` to group them.
  wf_window "Sign in" {
    width = "24rem"

    wf_label "Email"
    wf_input "you@example.com"

    wf_label "Account type"
    wf_dropdown "Personal"

    wf_panel {
      title = "Billing plan"
      wf_row {
        wf_radio "Monthly" { selected = true }
        wf_radio "Annual"
      }
    }

    wf_checkbox "Remember me" { checked = true }
    wf_toggle "Email notifications" { on = true }

    // A two-column grid of footer buttons.
    wf_grid {
      columns = 2
      wf_button "Cancel"
      wf_button "Sign in" { icon = "lucide.check" }
    }
  }

  h2 "A separate UI theme"

  text {
    span "Wireframes mock up an application, so they follow a UI theme that's separate from the document's. Set it per site (`site { ui_theme = :gruvbox  ui_mode = :light }`), or override it on any widget with its own `theme` / `accent` / `mode` — this window is forced to Gruvbox light regardless of the page theme."
  }

  wf_window "Gruvbox light" {
    theme = :gruvbox
    mode  = :light
    wf_label "A self-contained app theme"
    wf_row {
      wf_checkbox "Enabled" { checked = true }
      wf_toggle "Sync" { on = true }
    }
    wf_button "Save"
  }

  h2 "Per-widget class overrides"

  text {
    span "A widget's `class` background / color / border are read and baked onto its box and label — add one to a single instance (the primary button carries `class = [\"primary\"]`)."
  }

  wf_row {
    wf_button "Default"
    wf_button "Primary" { class = ["primary"] }
    wf_button "Disabled" { disabled = true }
  }
}

// Recolour the primary button through the class system. Because this
// rule is emitted after the bundled wireframe stylesheet, it wins by
// cascade; the `dark` / `light` blocks adapt it to the reader's theme.
class primary {
  background = "#1f6feb"
  color      = "#ffffff"
  border     = "1px solid #1f6feb"
  dark  { background = "#388bfd"  border = "1px solid #388bfd" }
  light { background = "#0969da"  border = "1px solid #0969da" }
}
