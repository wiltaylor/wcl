import "./shared.wcl"

// ── Diagram Interactions page ──

class ex_interaction_card {
    cursor = "pointer"

    state hovered {
        z_index = 10
    }

    state selected {
        z_index = 20
    }
}

class ex_interaction_face {
    fill = color_code_bg
    stroke = color_code_border
    stroke_width = 1
    cursor = "pointer"
    transition = "fill 160ms ease, stroke 160ms ease, opacity 140ms ease"

    state hovered {
        fill = color_nav_active
        stroke = color_link
    }

    state selected {
        stroke = color_success
        stroke_width = 3
    }
}

class ex_detail_panel {
    fill = color_nav_bg
    stroke = color_link
    stroke_width = 2
    opacity = 0
    visible = false
    pointer_events = "none"
    transition = "opacity 140ms ease"

    state shown {
        opacity = 1
        visible = true
        pointer_events = "all"
    }
}

class ex_stack_card {
    cursor = "pointer"

    state front {
        z_index = 30
    }
}

class ex_stack_face {
    fill = color_code_bg
    stroke = color_code_border
    stroke_width = 1
    cursor = "pointer"
    transition = "fill 120ms ease, stroke 120ms ease"

    state front {
        fill = color_nav_active
        stroke = color_link
    }
}

class ex_moving_token {
    fill = color_link
    stroke = color_code_border
    stroke_width = 1
    cursor = "pointer"

    animation slide {
        duration_ms = 900
        timing_function = "ease-in-out"
        iteration_count = 1
        fill_mode = "forwards"

        keyframe k0 {
            offset = 0
            x = 54
            y = 54
            width = 70
            height = 44
        }

        keyframe k100 {
            offset = 100
            x = 290
            y = 92
            width = 96
            height = 54
        }
    }

    state active {
        animation = "slide"
    }
}

page interactions {
    section = ref("my_docs.diagrams.interactions")
    title = "Diagram Interactions"

    layout {
        vsplit v_int1 {
            split s_int1 {
                size = 100

                heading h1 {
                    level = 1
                    content = wdoc::icon("mouse-pointer") + " Diagram Interactions"
                }
                paragraph p1 { content = "Document-level diagram classes define reusable visual states. Shape-level events apply those states at runtime for hover, click, visibility, and sibling z-order changes." }

                heading h2 {
                    level = 2
                    content = "States and targeted visibility"
                }
                paragraph p2 { content = "Hover the first task to reveal the details panel. Click either task to toggle a selected state." }

                diagram state_demo {
                    width = 760
                    height = 270

                    group task_review {
                        x = 30
                        y = 44
                        width = 200
                        height = 92
                        class = "ex_interaction_card"

                        event hover_card {
                            trigger = "hover"
                            state = "hovered"
                            mode = "while"
                        }

                        event hover_card_face {
                            trigger = "hover"
                            target = "task_review_bg"
                            state = "hovered"
                            mode = "while"
                        }

                        event select_card {
                            trigger = "click"
                            state = "selected"
                            mode = "toggle"
                        }

                        event select_card_face {
                            trigger = "click"
                            target = "task_review_bg"
                            state = "selected"
                            mode = "toggle"
                        }

                        event reveal_details {
                            trigger = "hover"
                            target = "details"
                            state = "shown"
                            mode = "while"
                        }

                        rect task_review_bg { x = 0
                            y = 0
                            width = 200
                            height = 92
                            class = "ex_interaction_face"
                            rx = 8 }
                        text title { x = 16
                            y = 16
                            width = 168
                            height = 24
                            content = "Review request"
                            fill = color_text
                            anchor = "start"
                            font_weight = "700" }
                        text meta { x = 16
                            y = 50
                            width = 168
                            height = 22
                            content = "Hover for details"
                            fill = color_text
                            anchor = "start"
                            font_size = 12 }
                    }

                    group task_ship {
                        x = 270
                        y = 44
                        width = 200
                        height = 92
                        class = "ex_interaction_card"

                        event hover_card {
                            trigger = "hover"
                            state = "hovered"
                            mode = "while"
                        }

                        event hover_card_face {
                            trigger = "hover"
                            target = "task_ship_bg"
                            state = "hovered"
                            mode = "while"
                        }

                        event select_card {
                            trigger = "click"
                            state = "selected"
                            mode = "toggle"
                        }

                        event select_card_face {
                            trigger = "click"
                            target = "task_ship_bg"
                            state = "selected"
                            mode = "toggle"
                        }

                        rect task_ship_bg { x = 0
                            y = 0
                            width = 200
                            height = 92
                            class = "ex_interaction_face"
                            rx = 8 }
                        text title { x = 16
                            y = 16
                            width = 168
                            height = 24
                            content = "Ship preview"
                            fill = color_text
                            anchor = "start"
                            font_weight = "700" }
                        text meta { x = 16
                            y = 50
                            width = 168
                            height = 22
                            content = "Click to select"
                            fill = color_text
                            anchor = "start"
                            font_size = 12 }
                    }

                    group details {
                        x = 520
                        y = 34
                        width = 210
                        height = 116
                        class = "ex_detail_panel"

                        rect details_bg { x = 0
                            y = 0
                            width = 210
                            height = 116
                            fill = color_nav_bg
                            stroke = color_link
                            stroke_width = 2
                            rx = 8 }
                        text title { x = 16
                            y = 18
                            width = 178
                            height = 24
                            content = "Targeted state"
                            fill = color_text
                            anchor = "start"
                            font_weight = "700" }
                        text body { x = 16
                            y = 50
                            width = 178
                            height = 44
                            content = "This panel is hidden after layout, then shown by an event on another shape."
                            fill = color_text
                            anchor = "start"
                            font_size = 12 }
                    }
                }

                heading h3 {
                    level = 2
                    content = "Runtime z-order"
                }
                paragraph p3 { content = "Hover each overlapping card. The <code>front</code> state raises that card within its current sibling group, then restores the original order on mouse leave." }

                diagram z_order_demo {
                    width = 460
                    height = 190

                    group alpha {
                        x = 46
                            y = 48
                            width = 160
                            height = 88
                        class = "ex_stack_card"
                        event front { trigger = "hover"
                            state = "front"
                            mode = "while" }
                        event front_face { trigger = "hover"
                            target = "alpha_bg"
                            state = "front"
                            mode = "while" }
                        rect alpha_bg { x = 0
                            y = 0
                            width = 160
                            height = 88
                            class = "ex_stack_face"
                            rx = 8 }
                        text label { x = 0
                            y = 0
                            width = 160
                            height = 88
                            fill = color_text
                            content = "Alpha" }
                    }

                    group beta {
                        x = 128
                            y = 34
                            width = 160
                            height = 88
                        class = "ex_stack_card"
                        event front { trigger = "hover"
                            state = "front"
                            mode = "while" }
                        event front_face { trigger = "hover"
                            target = "beta_bg"
                            state = "front"
                            mode = "while" }
                        rect beta_bg { x = 0
                            y = 0
                            width = 160
                            height = 88
                            class = "ex_stack_face"
                            rx = 8 }
                        text label { x = 0
                            y = 0
                            width = 160
                            height = 88
                            fill = color_text
                            content = "Beta" }
                    }

                    group gamma {
                        x = 210
                            y = 58
                            width = 160
                            height = 88
                        class = "ex_stack_card"
                        event front { trigger = "hover"
                            state = "front"
                            mode = "while" }
                        event front_face { trigger = "hover"
                            target = "gamma_bg"
                            state = "front"
                            mode = "while" }
                        rect gamma_bg { x = 0
                            y = 0
                            width = 160
                            height = 88
                            class = "ex_stack_face"
                            rx = 8 }
                        text label { x = 0
                            y = 0
                            width = 160
                            height = 88
                            fill = color_text
                            content = "Gamma" }
                    }
                }

                heading h5 {
                    level = 2
                    content = "Keyframe animation"
                }
                paragraph p4 { content = "Click the moving shape to start a one-off keyframe animation. The connector endpoint follows the animated bounds." }

                diagram animation_demo {
                    width = 500
                    height = 210

                    rect anchor {
                        x = 400
                        y = 76
                        width = 64
                        height = 64
                        rx = 8
                        fill = color_code_bg
                        stroke = color_code_border
                    }

                    rect moving {
                        x = 54
                        y = 54
                        width = 70
                        height = 44
                        rx = 8
                        class = "ex_moving_token"

                        event start_slide {
                            trigger = "click"
                            state = "active"
                            mode = "pulse"
                            duration_ms = 1000
                        }
                    }

                    connection edge {
                        from = "moving"
                        to = "anchor"
                        direction = "to"
                        stroke = color_link
                        stroke_width = 2
                    }
                }

                heading h4 {
                    level = 2
                    content = "Source"
                }
                code src {
                    language = "wcl"
                    content = <<-'WCL'
use wdoc::draw::{diagram, group, rect, text}

class ex_interaction_card {
    fill = color_code_bg
    stroke = color_code_border
    stroke_width = 1

    state hovered {
        fill = color_nav_active
        stroke = color_link
        z_index = 10
    }

    state selected {
        stroke = color_success
        stroke_width = 3
        z_index = 20
    }
}

class ex_detail_panel {
    opacity = 0
    visible = false
    pointer_events = "none"

    state shown {
        opacity = 1
        visible = true
        pointer_events = "all"
    }
}

diagram state_demo {
    group task_review {
        class = "ex_interaction_card"
        event hover_card { trigger = "hover"
                            state = "hovered"
                            mode = "while" }
        event select_card { trigger = "click"
                            state = "selected"
                            mode = "toggle" }
        event reveal_details {
            trigger = "hover"
            target = "details"
            state = "shown"
            mode = "while"
        }
    }
}

class moving_token {
    animation slide {
        duration_ms = 900
        timing_function = "ease-in-out"
        fill_mode = "forwards"

        keyframe k0 { offset = 0
                     x = 54
                     y = 54
                     width = 70
                     height = 44 }
        keyframe k100 { offset = 100
                       x = 290
                       y = 92
                       width = 96
                       height = 54 }
    }

    state active { animation = "slide" }
}

diagram animation_demo {
    rect moving {
        class = "moving_token"
        event start_slide { trigger = "click"
                            state = "active"
                            mode = "pulse"
                            duration_ms = 1000 }
    }
}
WCL
                }
            }
        }
    }
}
