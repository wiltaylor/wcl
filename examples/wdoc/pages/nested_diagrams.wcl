import "./shared.wcl"

// ── Nested Diagrams page ──

page nested_diagrams {
    section = "my_docs.diagrams.nested_diagrams"
    title = "Nested Diagrams"

    layout {
        vsplit v_nd1 {
            split s_nd1 {
                size = 100

                heading hnd1 {
                    level = 1
                    content = "Nested Diagrams"
                }
                paragraph pnd1 {
                    content = "Shapes can contain other shapes, forming nested flowcharts. Connections can reference shapes at any nesting level using dot-separated paths (e.g. " + bold("\"parent.child\"") + ")."
                }
            }
        }

        // --- Example: System architecture with nested subsystems ---
        vsplit v_nd2 {
            split s_nd2 {
                size = 100

                heading hnd2 {
                    level = 2
                    content = "System Architecture with Nested Subsystems"
                }
                paragraph pnd2 { content = "Each subsystem box contains its own internal flowchart. Connections span across nesting levels:" }

                diagram nested_arch {
                    width = 800
                    height = 550

                    // === Frontend Subsystem ===
                    rect frontend {
                        x = 20
                        y = 20
                        width = 350
                        height = 220
                        rx = 12
                        fill = color_nav_bg
                        stroke = color_link
                        stroke_width = 2

                        text fe_title {
                            x = 10
                            y = 5
                            width = 330
                            height = 25
                            content = "Frontend"
                            font_size = 16
                        }

                        rect fe_router {
                            x = 20
                            y = 40
                            width = 100
                            height = 45
                            rx = 4
                            fill = color_code_bg
                            stroke = color_code_border
                            stroke_width = 1
                            text t { content = "Router" }
                        }

                        rect fe_auth_ui {
                            x = 20
                            y = 110
                            width = 100
                            height = 45
                            rx = 4
                            fill = color_code_bg
                            stroke = color_code_border
                            stroke_width = 1
                            text t { content = "Auth UI" }
                        }

                        rect fe_dashboard {
                            x = 140
                            y = 110
                            width = 100
                            height = 45
                            rx = 4
                            fill = color_code_bg
                            stroke = color_code_border
                            stroke_width = 1
                            text t { content = "Dashboard" }
                        }

                        rect fe_api_client {
                            x = 230
                            y = 40
                            width = 100
                            height = 45
                            rx = 4
                            fill = color_code_bg
                            stroke = color_link
                            stroke_width = 2
                            text t { content = "API Client" }
                        }

                        // Internal frontend connections
                        connection fec1 {
                            from = "fe_router"
                            to = "fe_auth_ui"
                            direction = "to"
                            stroke = color_text
                        }
                        connection fec2 {
                            from = "fe_router"
                            to = "fe_dashboard"
                            direction = "to"
                            stroke = color_text
                        }
                        connection fec3 {
                            from = "fe_dashboard"
                            to = "fe_api_client"
                            direction = "to"
                            stroke = color_text
                        }
                        connection fec4 {
                            from = "fe_auth_ui"
                            to = "fe_api_client"
                            direction = "to"
                            stroke = color_text
                        }
                    }

                    // === Backend Subsystem ===
                    rect backend {
                        x = 420
                        y = 20
                        width = 350
                        height = 220
                        rx = 12
                        fill = color_nav_bg
                        stroke = color_link
                        stroke_width = 2

                        text be_title {
                            x = 10
                            y = 5
                            width = 330
                            height = 25
                            content = "Backend"
                            font_size = 16
                        }

                        rect be_gateway {
                            x = 15
                            y = 40
                            width = 100
                            height = 45
                            rx = 4
                            fill = color_code_bg
                            stroke = color_link
                            stroke_width = 2
                            text t { content = "Gateway" }
                        }

                        rect be_auth_svc {
                            x = 15
                            y = 110
                            width = 100
                            height = 45
                            rx = 4
                            fill = color_code_bg
                            stroke = color_code_border
                            stroke_width = 1
                            text t { content = "Auth Svc" }
                        }

                        rect be_user_svc {
                            x = 130
                            y = 110
                            width = 100
                            height = 45
                            rx = 4
                            fill = color_code_bg
                            stroke = color_code_border
                            stroke_width = 1
                            text t { content = "User Svc" }
                        }

                        rect be_data_svc {
                            x = 240
                            y = 110
                            width = 100
                            height = 45
                            rx = 4
                            fill = color_code_bg
                            stroke = color_code_border
                            stroke_width = 1
                            text t { content = "Data Svc" }
                        }

                        rect be_queue {
                            x = 240
                            y = 40
                            width = 100
                            height = 45
                            rx = 4
                            fill = color_code_bg
                            stroke = color_code_border
                            stroke_width = 1
                            text t { content = "Queue" }
                        }

                        // Internal backend connections
                        connection bec1 {
                            from = "be_gateway"
                            to = "be_auth_svc"
                            direction = "to"
                            stroke = color_text
                        }
                        connection bec2 {
                            from = "be_gateway"
                            to = "be_user_svc"
                            direction = "to"
                            stroke = color_text
                        }
                        connection bec3 {
                            from = "be_gateway"
                            to = "be_data_svc"
                            direction = "to"
                            stroke = color_text
                        }
                        connection bec4 {
                            from = "be_data_svc"
                            to = "be_queue"
                            direction = "to"
                            stroke = color_text
                        }
                    }

                    // === Data Layer ===
                    rect data_layer {
                        x = 150
                        y = 300
                        width = 500
                        height = 220
                        rx = 12
                        fill = color_nav_bg
                        stroke = color_nav_border
                        stroke_width = 2

                        text dl_title {
                            x = 10
                            y = 5
                            width = 480
                            height = 25
                            content = "Data Layer"
                            font_size = 16
                        }

                        rect dl_postgres {
                            x = 20
                            y = 50
                            width = 110
                            height = 50
                            rx = 4
                            fill = color_code_bg
                            stroke = color_code_border
                            stroke_width = 1
                            text t { content = "PostgreSQL" }
                        }

                        rect dl_redis {
                            x = 150
                            y = 50
                            width = 110
                            height = 50
                            rx = 4
                            fill = color_code_bg
                            stroke = color_code_border
                            stroke_width = 1
                            text t { content = "Redis" }
                        }

                        rect dl_s3 {
                            x = 280
                            y = 50
                            width = 110
                            height = 50
                            rx = 4
                            fill = color_code_bg
                            stroke = color_code_border
                            stroke_width = 1
                            text t { content = "S3 Storage" }
                        }

                        rect dl_elastic {
                            x = 80
                            y = 130
                            width = 110
                            height = 50
                            rx = 4
                            fill = color_code_bg
                            stroke = color_code_border
                            stroke_width = 1
                            text t { content = "Elastic" }
                        }

                        rect dl_kafka {
                            x = 220
                            y = 130
                            width = 110
                            height = 50
                            rx = 4
                            fill = color_code_bg
                            stroke = color_code_border
                            stroke_width = 1
                            text t { content = "Kafka" }
                        }

                        // Internal data connections
                        connection dlc1 {
                            from = "dl_redis"
                            to = "dl_postgres"
                            direction = "both"
                            stroke = color_text
                            stroke_dasharray = "4,3"
                            label = "cache"
                        }
                        connection dlc2 {
                            from = "dl_kafka"
                            to = "dl_elastic"
                            direction = "to"
                            stroke = color_text
                            label = "index"
                        }
                    }

                    // === Cross-hierarchy connections ===

                    // Frontend API Client → Backend Gateway
                    connection xc1 {
                        from = "frontend.fe_api_client"
                        to = "backend.be_gateway"
                        direction = "to"
                        stroke = color_link
                        stroke_width = 3
                        label = "REST API"
                    }

                    // Backend Auth → Data Postgres
                    connection xc2 {
                        from = "backend.be_auth_svc"
                        to = "data_layer.dl_postgres"
                        direction = "both"
                        stroke = color_text
                        stroke_width = 2
                        label = "auth data"
                    }

                    // Backend User → Data Postgres
                    connection xc3 {
                        from = "backend.be_user_svc"
                        to = "data_layer.dl_postgres"
                        direction = "both"
                        stroke = color_text
                        stroke_width = 2
                    }

                    // Backend User → Data Redis (cache)
                    connection xc4 {
                        from = "backend.be_user_svc"
                        to = "data_layer.dl_redis"
                        direction = "both"
                        stroke = color_text
                        stroke_dasharray = "5,3"
                        label = "cache"
                    }

                    // Backend Data → Data S3
                    connection xc5 {
                        from = "backend.be_data_svc"
                        to = "data_layer.dl_s3"
                        direction = "both"
                        stroke = color_text
                        stroke_width = 2
                        label = "files"
                    }

                    // Backend Queue → Data Kafka
                    connection xc6 {
                        from = "backend.be_queue"
                        to = "data_layer.dl_kafka"
                        direction = "to"
                        stroke = color_text
                        stroke_width = 2
                        label = "events"
                    }

                    // Backend Data → Data Elastic (search)
                    connection xc7 {
                        from = "backend.be_data_svc"
                        to = "data_layer.dl_elastic"
                        direction = "to"
                        stroke = color_text
                        stroke_dasharray = "5,3"
                        label = "search"
                    }
                }
            }
        }

        // --- Example: Nested deployment flow ---
        vsplit v_nd3 {
            split s_nd3 {
                size = 100

                heading hnd3 {
                    level = 2
                    content = "Nested Deployment Pipeline"
                }
                paragraph pnd3 { content = "Each environment contains its own service topology. Connections show the promotion path between environments:" }

                diagram deploy_flow {
                    width = 800
                    height = 400

                    // === Dev Environment ===
                    rect env_dev {
                        x = 20
                        y = 30
                        width = 230
                        height = 340
                        rx = 10
                        fill = color_code_bg
                        stroke = color_nav_border
                        stroke_width = 2

                        text dev_label {
                            x = 10
                            y = 5
                            width = 210
                            height = 25
                            content = "Development"
                            font_size = 15
                        }

                        rect dev_api {
                            x = 20
                            y = 40
                            width = 85
                            height = 40
                            rx = 4
                            fill = color_nav_bg
                            stroke = color_nav_border
                            text t { content = "API" }
                        }
                        rect dev_web {
                            x = 120
                            y = 40
                            width = 85
                            height = 40
                            rx = 4
                            fill = color_nav_bg
                            stroke = color_nav_border
                            text t { content = "Web" }
                        }
                        rect dev_worker {
                            x = 20
                            y = 100
                            width = 85
                            height = 40
                            rx = 4
                            fill = color_nav_bg
                            stroke = color_nav_border
                            text t { content = "Worker" }
                        }
                        rect dev_db {
                            x = 120
                            y = 100
                            width = 85
                            height = 40
                            rx = 4
                            fill = color_nav_bg
                            stroke = color_nav_border
                            text t { content = "DB" }
                        }

                        connection dc1 {
                            from = "dev_web"
                            to = "dev_api"
                            direction = "to"
                            stroke = color_text
                        }
                        connection dc2 {
                            from = "dev_api"
                            to = "dev_db"
                            direction = "both"
                            stroke = color_text
                        }
                        connection dc3 {
                            from = "dev_api"
                            to = "dev_worker"
                            direction = "to"
                            stroke = color_text
                        }
                    }

                    // === Staging Environment ===
                    rect env_staging {
                        x = 290
                        y = 30
                        width = 230
                        height = 340
                        rx = 10
                        fill = color_code_bg
                        stroke = color_link
                        stroke_width = 2

                        text stg_label {
                            x = 10
                            y = 5
                            width = 210
                            height = 25
                            content = "Staging"
                            font_size = 15
                        }

                        rect stg_api {
                            x = 20
                            y = 40
                            width = 85
                            height = 40
                            rx = 4
                            fill = color_nav_bg
                            stroke = color_nav_border
                            text t { content = "API" }
                        }
                        rect stg_web {
                            x = 120
                            y = 40
                            width = 85
                            height = 40
                            rx = 4
                            fill = color_nav_bg
                            stroke = color_nav_border
                            text t { content = "Web" }
                        }
                        rect stg_worker {
                            x = 20
                            y = 100
                            width = 85
                            height = 40
                            rx = 4
                            fill = color_nav_bg
                            stroke = color_nav_border
                            text t { content = "Worker" }
                        }
                        rect stg_db {
                            x = 120
                            y = 100
                            width = 85
                            height = 40
                            rx = 4
                            fill = color_nav_bg
                            stroke = color_nav_border
                            text t { content = "DB" }
                        }

                        connection sc1 {
                            from = "stg_web"
                            to = "stg_api"
                            direction = "to"
                            stroke = color_text
                        }
                        connection sc2 {
                            from = "stg_api"
                            to = "stg_db"
                            direction = "both"
                            stroke = color_text
                        }
                        connection sc3 {
                            from = "stg_api"
                            to = "stg_worker"
                            direction = "to"
                            stroke = color_text
                        }
                    }

                    // === Production Environment ===
                    rect env_prod {
                        x = 560
                        y = 30
                        width = 230
                        height = 340
                        rx = 10
                        fill = color_code_bg
                        stroke = color_link
                        stroke_width = 3

                        text prod_label {
                            x = 10
                            y = 5
                            width = 210
                            height = 25
                            content = "Production"
                            font_size = 15
                        }

                        rect prod_api {
                            x = 20
                            y = 40
                            width = 85
                            height = 40
                            rx = 4
                            fill = color_nav_bg
                            stroke = color_nav_border
                            text t { content = "API x3" }
                        }
                        rect prod_web {
                            x = 120
                            y = 40
                            width = 85
                            height = 40
                            rx = 4
                            fill = color_nav_bg
                            stroke = color_nav_border
                            text t { content = "Web x3" }
                        }
                        rect prod_worker {
                            x = 20
                            y = 100
                            width = 85
                            height = 40
                            rx = 4
                            fill = color_nav_bg
                            stroke = color_nav_border
                            text t { content = "Worker x5" }
                        }
                        rect prod_db {
                            x = 120
                            y = 100
                            width = 85
                            height = 40
                            rx = 4
                            fill = color_nav_bg
                            stroke = color_nav_border
                            text t { content = "DB HA" }
                        }

                        connection pc1 {
                            from = "prod_web"
                            to = "prod_api"
                            direction = "to"
                            stroke = color_text
                        }
                        connection pc2 {
                            from = "prod_api"
                            to = "prod_db"
                            direction = "both"
                            stroke = color_text
                        }
                        connection pc3 {
                            from = "prod_api"
                            to = "prod_worker"
                            direction = "to"
                            stroke = color_text
                        }
                    }

                    // === Cross-environment promotion connections ===
                    connection promote_dev_stg {
                        from = "env_dev"
                        to = "env_staging"
                        direction = "to"
                        from_anchor = "right"
                        to_anchor = "left"
                        stroke = color_link
                        stroke_width = 3
                        label = "promote"
                    }

                    connection promote_stg_prod {
                        from = "env_staging"
                        to = "env_prod"
                        direction = "to"
                        from_anchor = "right"
                        to_anchor = "left"
                        stroke = color_link
                        stroke_width = 3
                        label = "deploy"
                    }

                    // Cross-env data connections
                    connection data_sync_1 {
                        from = "env_dev.dev_db"
                        to = "env_staging.stg_db"
                        direction = "to"
                        curve = "bezier"
                        from_anchor = "bottom"
                        to_anchor = "bottom"
                        stroke = color_text
                        stroke_dasharray = "5,3"
                        label = "schema sync"
                    }

                    connection data_sync_2 {
                        from = "env_staging.stg_db"
                        to = "env_prod.prod_db"
                        direction = "to"
                        curve = "bezier"
                        from_anchor = "bottom"
                        to_anchor = "bottom"
                        stroke = color_text
                        stroke_dasharray = "5,3"
                        label = "migrate"
                    }
                }
            }
        }
    }
}
