import "./shared.wcl"

// Nested Diagrams page

class nested_flow_container {
    surface_fill = "#172033"
    border_stroke = "#7dd3fc"
    label_fill = "#ffffff"
    border_width = 2
}

class nested_flow_container_muted {
    surface_fill = "#131a2b"
    border_stroke = "#94a3b8"
    label_fill = "#f8fafc"
    border_width = 2
}

class nested_flow_node {
    surface_fill = "#0b1220"
    border_stroke = "#94a3b8"
    label_fill = "#ffffff"
    color = "#7dd3fc"
}

class nested_flow_node_accent {
    surface_fill = "#075985"
    border_stroke = "#38bdf8"
    label_fill = "#ffffff"
    color = "#38bdf8"
}

class nested_flow_success {
    background_fill = "#15803d"
    surface_fill = "#14532d"
    border_stroke = "#4ade80"
    label_fill = "#ffffff"
    color = "#22c55e"
}

page nested_diagrams {
    section = "my_docs.diagrams.nested_diagrams"
    title = "Nested Diagrams"

    layout {
        vsplit v_nd1 {
            split s_nd1 {
                size = 100

                heading hnd1 {
                    level = 1
                    content = "Nested Diagrams"
                }
                paragraph pnd1 {
                    content = "The " + bold("flowchart") + " widget makes nested flowcharts first-class. Use regular flowchart nodes inside it, then connect across levels with dotted paths such as " + bold("\"auth.validate\"") + "."
                }
            }
        }

        vsplit v_nd2 {
            split s_nd2 {
                size = 100

                heading hnd2 {
                    level = 2
                    content = "System flow with nested subsystems"
                }
                paragraph pnd2 {
                    content = "Each subsystem is a nested flowchart. The outer flow connects directly to important inner steps without manual boxes or grid positioning."
                }

                diagram nested_arch {
                    width = 1040
                    height = 680
                    align = "layered"
                    direction = "horizontal"
                    gap = 48

                    flow_terminal entry {
                        label = "Request"
                        class = "nested_flow_node_accent"
                    }

                    flowchart frontend {
                        label = "Frontend"
                        class = "nested_flow_container"
                        gap = 44

                        flow_terminal fe_route {
                            label = "Route"
                            class = "nested_flow_node_accent"
                        }

                        flow_decision fe_auth_check {
                            label = "Signed in?"
                            class = "nested_flow_node"
                        }

                        flow_process fe_dashboard {
                            label = "Dashboard"
                            class = "nested_flow_node"
                        }

                        flow_process fe_api_client {
                            label = "API client"
                            class = "nested_flow_node_accent"
                        }

                        connection fe1 {
                            from = "fe_route"
                            to = "fe_auth_check"
                            direction = "to"
                            stroke = color_text
                        }
                        connection fe2 {
                            from = "fe_auth_check"
                            to = "fe_dashboard"
                            direction = "to"
                            stroke = color_success
                            label = "yes"
                        }
                        connection fe3 {
                            from = "fe_dashboard"
                            to = "fe_api_client"
                            direction = "to"
                            stroke = color_text
                        }
                    }

                    flowchart backend {
                        label = "Backend"
                        class = "nested_flow_container"
                        gap = 44

                        flow_terminal be_gateway {
                            label = "Gateway"
                            class = "nested_flow_node_accent"
                        }

                        flow_decision be_authorize {
                            label = "Allowed?"
                            class = "nested_flow_node"
                        }

                        flow_process be_user_svc {
                            label = "User svc"
                            class = "nested_flow_node"
                        }

                        flow_process be_data_svc {
                            label = "Data svc"
                            class = "nested_flow_node"
                        }

                        flow_io be_event {
                            label = "Publish event"
                            class = "nested_flow_node"
                        }

                        connection be1 {
                            from = "be_gateway"
                            to = "be_authorize"
                            direction = "to"
                            stroke = color_text
                        }
                        connection be2 {
                            from = "be_authorize"
                            to = "be_user_svc"
                            direction = "to"
                            stroke = color_success
                            label = "yes"
                        }
                        connection be3 {
                            from = "be_user_svc"
                            to = "be_data_svc"
                            direction = "to"
                            stroke = color_text
                        }
                        connection be4 {
                            from = "be_data_svc"
                            to = "be_event"
                            direction = "to"
                            stroke = color_text
                        }
                    }

                    flowchart data_layer {
                        label = "Data layer"
                        class = "nested_flow_container_muted"
                        direction = "horizontal"
                        gap = 44

                        flow_io dl_cache {
                            label = "Redis"
                            class = "nested_flow_node"
                        }

                        flow_process dl_postgres {
                            label = "PostgreSQL"
                            class = "nested_flow_node_accent"
                        }

                        flow_io dl_search {
                            label = "Search"
                            class = "nested_flow_node"
                        }

                        flow_io dl_stream {
                            label = "Kafka"
                            class = "nested_flow_node"
                        }

                        connection dl1 {
                            from = "dl_cache"
                            to = "dl_postgres"
                            direction = "both"
                            stroke = color_text
                            stroke_dasharray = "5,3"
                            label = "cache"
                        }
                        connection dl2 {
                            from = "dl_stream"
                            to = "dl_search"
                            direction = "to"
                            stroke = color_text
                            label = "index"
                        }
                    }

                    flow_terminal response {
                        label = "Response"
                        class = "nested_flow_success"
                    }

                    connection req_to_frontend {
                        from = "entry"
                        to = "frontend.fe_route"
                        direction = "to"
                        stroke = color_link
                        stroke_width = 2
                    }
                    connection frontend_to_backend {
                        from = "frontend.fe_api_client"
                        to = "backend.be_gateway"
                        direction = "to"
                        from_anchor = "bottom"
                        to_anchor = "top"
                        stroke = color_link
                        stroke_width = 3
                        label = "REST"
                    }
                    connection backend_to_data {
                        from = "backend.be_data_svc"
                        to = "data_layer.dl_postgres"
                        direction = "both"
                        from_anchor = "bottom"
                        to_anchor = "top"
                        stroke = color_text
                        stroke_width = 2
                        label = "read/write"
                    }
                    connection backend_to_stream {
                        from = "backend.be_event"
                        to = "data_layer.dl_stream"
                        direction = "to"
                        from_anchor = "bottom"
                        to_anchor = "top"
                        stroke = color_text
                        stroke_dasharray = "5,3"
                        label = "events"
                    }
                    connection backend_to_response {
                        from = "backend.be_user_svc"
                        to = "response"
                        direction = "to"
                        from_anchor = "bottom"
                        to_anchor = "top"
                        stroke = color_success
                        stroke_width = 2
                    }
                }
            }
        }

        vsplit v_nd3 {
            split s_nd3 {
                size = 100

                heading hnd3 {
                    level = 2
                    content = "Nested deployment pipeline"
                }
                paragraph pnd3 {
                    content = "The environments below are nested flowcharts too. Each environment owns its service flow, while the outer diagram shows promotion and data movement."
                }

                diagram deploy_flow {
                    width = 820
                    height = 520
                    align = "layered"
                    direction = "horizontal"
                    gap = 46

                    flowchart env_dev {
                        label = "Development"
                        class = "nested_flow_container_muted"
                        gap = 44

                        flow_terminal dev_web {
                            label = "Web"
                            class = "nested_flow_node_accent"
                        }

                        flow_process dev_api {
                            label = "API"
                            class = "nested_flow_node"
                        }

                        flow_process dev_worker {
                            label = "Worker"
                            class = "nested_flow_node"
                        }

                        flow_io dev_db {
                            label = "DB"
                            class = "nested_flow_node"
                        }

                        connection dev1 {
                            from = "dev_web"
                            to = "dev_api"
                            direction = "to"
                            stroke = color_text
                        }
                        connection dev2 {
                            from = "dev_api"
                            to = "dev_worker"
                            direction = "to"
                            stroke = color_text
                        }
                        connection dev3 {
                            from = "dev_api"
                            to = "dev_db"
                            direction = "both"
                            stroke = color_text
                        }
                    }

                    flowchart env_staging {
                        label = "Staging"
                        class = "nested_flow_container"
                        gap = 44

                        flow_terminal stg_web {
                            label = "Web"
                            class = "nested_flow_node_accent"
                        }

                        flow_process stg_api {
                            label = "API"
                            class = "nested_flow_node"
                        }

                        flow_process stg_worker {
                            label = "Worker"
                            class = "nested_flow_node"
                        }

                        flow_io stg_db {
                            label = "DB"
                            class = "nested_flow_node"
                        }

                        connection stg1 {
                            from = "stg_web"
                            to = "stg_api"
                            direction = "to"
                            stroke = color_text
                        }
                        connection stg2 {
                            from = "stg_api"
                            to = "stg_worker"
                            direction = "to"
                            stroke = color_text
                        }
                        connection stg3 {
                            from = "stg_api"
                            to = "stg_db"
                            direction = "both"
                            stroke = color_text
                        }
                    }

                    flowchart env_prod {
                        label = "Production"
                        class = "nested_flow_container"
                        border_width = 2.5
                        gap = 44

                        flow_terminal prod_web {
                            label = "Web x3"
                            class = "nested_flow_node_accent"
                        }

                        flow_process prod_api {
                            label = "API x3"
                            class = "nested_flow_node"
                        }

                        flow_process prod_worker {
                            label = "Worker x5"
                            class = "nested_flow_node"
                        }

                        flow_io prod_db {
                            label = "DB HA"
                            class = "nested_flow_success"
                        }

                        connection prod1 {
                            from = "prod_web"
                            to = "prod_api"
                            direction = "to"
                            stroke = color_text
                        }
                        connection prod2 {
                            from = "prod_api"
                            to = "prod_worker"
                            direction = "to"
                            stroke = color_text
                        }
                        connection prod3 {
                            from = "prod_api"
                            to = "prod_db"
                            direction = "both"
                            stroke = color_text
                        }
                    }

                    connection promote_dev_stg {
                        from = "env_dev.dev_api"
                        to = "env_staging.stg_web"
                        direction = "to"
                        stroke = color_link
                        stroke_width = 3
                        label = "promote"
                    }

                    connection promote_stg_prod {
                        from = "env_staging.stg_api"
                        to = "env_prod.prod_web"
                        direction = "to"
                        stroke = color_link
                        stroke_width = 3
                        label = "deploy"
                    }

                    connection data_sync_1 {
                        from = "env_dev.dev_db"
                        to = "env_staging.stg_db"
                        direction = "to"
                        curve = "bezier"
                        from_anchor = "bottom"
                        to_anchor = "bottom"
                        stroke = color_text
                        stroke_dasharray = "5,3"
                        label = "schema sync"
                    }

                    connection data_sync_2 {
                        from = "env_staging.stg_db"
                        to = "env_prod.prod_db"
                        direction = "to"
                        curve = "bezier"
                        from_anchor = "bottom"
                        to_anchor = "bottom"
                        stroke = color_text
                        stroke_dasharray = "5,3"
                        label = "migrate"
                    }
                }
            }
        }
    }
}
