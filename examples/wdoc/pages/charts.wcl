// Data-chart demo: bar / line / pie charts as custom SVG shapes.
//
// Charts are placed inside a `diagram { }` like any other shape and
// take `x` / `y` / `width` / `height`. Data is a list of records:
// `{ name, values }` for bar / line series, `{ label, value }` for pie
// slices. The variant is inferred from the record's shape, so a bare
// `{ … }` is enough (write the explicit `ChartSeries::Of { … }` only
// when you want to disambiguate). Bars, lines, and slices are
// auto-assigned palette classes (`wdoc-series-1`..`wdoc-series-8`), so
// they theme through the class system exactly like everything else —
// see the `wdoc-series-1` override at the bottom of this file.

page charts { sites = [:showcase]
  h1 "Charts"

  text {
    span "Bar, line, and pie charts are custom shapes that lower to SVG fundamentals through pure-WCL geometry. Set the scale with "
    span "`y_min`"
    span " / "
    span "`y_max`"
    span ", label the axes, and pass any number of series."
  }

  h2 "Grouped bar chart"

  // Two series, an explicit 0–100 scale, and axis labels.
  diagram {
    width  = 380
    height = 240

    bar_chart {
      width   = 380
      height  = 240
      title   = "Quarterly revenue ($k)"
      x_label = "Quarter"
      y_label = "$k"
      categories = ["Q1", "Q2", "Q3", "Q4"]
      y_min = 0.0
      y_max = 100.0
      series = [
        { name: "North", values: [42.0, 55.0, 61.0, 78.0] },
        { name: "South", values: [30.0, 48.0, 52.0, 66.0] },
      ]
    }
  }

  h2 "Multi-series line chart"

  // Three series; the y-axis scale is auto-fit to the data when
  // `y_max` is omitted.
  diagram {
    width  = 420
    height = 240

    line_chart {
      width   = 420
      height  = 240
      title   = "Weekly latency (ms)"
      x_label = "Day"
      categories = ["Mon", "Tue", "Wed", "Thu", "Fri"]
      series = [
        { name: "p50", values: [12.0, 14.0, 11.0, 18.0, 13.0] },
        { name: "p90", values: [26.0, 31.0, 28.0, 40.0, 33.0] },
        { name: "p99", values: [44.0, 58.0, 51.0, 72.0, 60.0] },
      ]
    }
  }

  h2 "Labelled points"

  text {
    span "Set "
    span "`point_labels = true`"
    span " to print every point's value, and pass "
    span "`points`"
    span " — a list of "
    span "`{ label, category, value }`"
    span " records — to pin a labelled marker to a specific point (category is a 0-based index along the x axis). Annotations pick up the site accent."
  }

  // A single series with auto value labels plus two pinned annotations.
  diagram {
    width  = 420
    height = 240

    line_chart {
      width   = 420
      height  = 240
      title   = "Daily signups"
      x_label = "Day"
      categories = ["Mon", "Tue", "Wed", "Thu", "Fri"]
      point_labels = true
      series = [
        { name: "signups", values: [12.0, 18.0, 11.0, 30.0, 22.0] },
      ]
      points = [
        { label: "launch",  category: 1, value: 18.0 },
        { label: "outage",  category: 2, value: 11.0 },
      ]
    }
  }

  h2 "Pie chart"

  diagram {
    width  = 260
    height = 260

    pie_chart {
      width  = 260
      height = 260
      title  = "Language mix"
      slices = [
        { label: "Rust",   value: 55.0 },
        { label: "TS",     value: 25.0 },
        { label: "Python", value: 12.0 },
        { label: "Other",  value: 8.0 },
      ]
    }
  }

  text {
    span "Every series carries a palette class. Recolour one by redeclaring that class — it follows the light/dark theme like any other."
  }
}

// Theme the first series. Redeclaring the palette class overrides the
// bundled default (which comes first in the stylesheet), and the
// `dark {}` / `light {}` blocks switch with the reader's colour scheme.
// The name is quoted because it contains hyphens (an identifier
// label can't), matching how the bundled palette class is named.
class "wdoc-series-1" {
  fill   = "#7b2d8e"
  stroke = "#7b2d8e"
  dark  { fill = "#c792ea"  stroke = "#c792ea" }
  light { fill = "#7b2d8e"  stroke = "#7b2d8e" }
}
