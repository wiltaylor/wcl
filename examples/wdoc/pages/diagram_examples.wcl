import "./shared.wcl"

// ── Diagram Examples page ──

class example_status_ready {
    fill = color_success_bg
    stroke = color_success
    stroke_width = 2
    rx = 8
}

class example_status_waiting {
    fill = color_code_bg
    stroke = color_link
    stroke_width = 2
    rx = 8
}

class example_status_blocked {
    fill = color_danger_bg
    stroke = color_danger
    stroke_width = 2
    rx = 8
    stroke_dasharray = "6,3"
}

page diagram_examples {
    section = "my_docs.diagrams.diagram_examples"
    title = "Diagram Examples"

    layout {
        vsplit v_diag1 {
            split s_diag1 {
                size = 100

                heading hd1 {
                    level = 1
                    content = "Diagram Examples"
                }
                paragraph pd1 { content = "WCL supports inline vector diagrams with shapes, connections, text labels, and theme-aware styling. Diagrams render as inline SVG." }
            }
        }

        // --- Example 1: Simple shapes ---
        vsplit v_diag2 {
            split s_diag2 {
                size = 100

                heading hd2 {
                    level = 2
                    content = "Basic Shapes"
                }
                paragraph pd2 { content = "Rectangles, circles, ellipses, and lines with theme-aware colors:" }

                diagram basic_shapes {
                    width = 700
                    height = 200

                    rect r1 {
                        x = 20
                        y = 30
                        width = 120
                        height = 80
                        rx = 8
                        fill = color_nav_bg
                        stroke = color_link
                        stroke_width = 2
                        text t1 { content = "Rectangle" }
                    }

                    circle c1 {
                        x = 180
                        y = 30
                        r = 40
                        fill = color_code_bg
                        stroke = color_link
                        stroke_width = 2
                        text t2 { content = "Circle" }
                    }

                    ellipse e1 {
                        x = 300
                        y = 30
                        rx = 70
                        ry = 40
                        fill = color_nav_bg
                        stroke = color_nav_border
                        stroke_width = 2
                        text t3 { content = "Ellipse" }
                    }

                    line l1 {
                        x1 = 480
                        y1 = 40
                        x2 = 650
                        y2 = 40
                        stroke = color_text
                        stroke_width = 2
                    }

                    line l2 {
                        x1 = 480
                        y1 = 80
                        x2 = 650
                        y2 = 80
                        stroke = color_link
                        stroke_width = 2
                        stroke_dasharray = "8,4"
                    }

                    line l3 {
                        x1 = 480
                        y1 = 120
                        x2 = 650
                        y2 = 120
                        stroke = color_nav_border
                        stroke_width = 3
                    }

                    text lines_label {
                        x = 480
                        y = 150
                        width = 170
                        height = 30
                        content = "Lines (solid, dashed, thick)"
                        font_size = 12
                        fill = color_text
                    }
                }
            }
        }

        // --- Example 2: Diagram classes ---
        vsplit v_diag_classes {
            split s_diag_classes {
                size = 100

                heading hd_classes {
                    level = 2
                    content = "Diagram Classes"
                }
                paragraph pd_classes {
                    content = "Define reusable shape classes once, then apply them with the " + bold("class") + " attribute. Classes can set fill, stroke, corner radius, opacity, typography, and other renderer-neutral SVG properties."
                }

                diagram class_demo {
                    width = 700
                    height = 220

                    rect queued {
                        x = 40
                        y = 40
                        width = 150
                        height = 70
                        class = "example_status_waiting"
                        text label {
                            content = "Queued"
                            font_weight = "700"
                        }
                    }

                    rect running {
                        x = 275
                        y = 40
                        width = 150
                        height = 70
                        class = "example_status_ready"
                        text label {
                            content = "Running"
                            font_weight = "700"
                        }
                    }

                    rect blocked {
                        x = 510
                        y = 40
                        width = 150
                        height = 70
                        class = "example_status_blocked"
                        text label {
                            content = "Blocked"
                            font_weight = "700"
                        }
                    }

                    connection q_r {
                        from = "queued"
                        to = "running"
                        direction = "to"
                    }
                    connection r_b {
                        from = "running"
                        to = "blocked"
                        direction = "to"
                    }
                }

                code class_demo_src {
                    language = "wcl"
                    content = "class status_ready {\n    fill = color_success_bg\n    stroke = color_success\n    stroke_width = 2\n    rx = 8\n}\n\nclass status_waiting {\n    fill = color_code_bg\n    stroke = color_link\n    stroke_width = 2\n    rx = 8\n}\n\nclass status_blocked {\n    fill = color_danger_bg\n    stroke = color_danger\n    stroke_width = 2\n    rx = 8\n    stroke_dasharray = \"6,3\"\n}\n\ndiagram class_demo {\n    width = 700\n    height = 220\n\n    rect queued { x = 40, y = 40, width = 150, height = 70, class = \"status_waiting\" }\n    rect running { x = 275, y = 40, width = 150, height = 70, class = \"status_ready\" }\n    rect blocked { x = 510, y = 40, width = 150, height = 70, class = \"status_blocked\" }\n\n    connection q_r { from = \"queued\", to = \"running\", direction = \"to\" }\n    connection r_b { from = \"running\", to = \"blocked\", direction = \"to\" }\n}"
                }
            }
        }

        // --- Example 3: Connections with arrows ---
        vsplit v_diag3 {
            split s_diag3 {
                size = 100

                heading hd3 {
                    level = 2
                    content = "Connections and Arrows"
                }
                paragraph pd3 { content = "Connect shapes with straight or bezier lines. Arrows indicate direction:" }

                diagram conn_demo {
                    width = 700
                    height = 220

                    rect a {
                        x = 30
                        y = 30
                        width = 120
                        height = 60
                        rx = 6
                        fill = color_code_bg
                        stroke = color_link
                        stroke_width = 2
                        text ta { content = "Source" }
                    }

                    rect b {
                        x = 280
                        y = 30
                        width = 120
                        height = 60
                        rx = 6
                        fill = color_code_bg
                        stroke = color_link
                        stroke_width = 2
                        text tb { content = "Target" }
                    }

                    rect c {
                        x = 530
                        y = 30
                        width = 120
                        height = 60
                        rx = 6
                        fill = color_code_bg
                        stroke = color_link
                        stroke_width = 2
                        text tc { content = "Both" }
                    }

                    rect d {
                        x = 30
                        y = 140
                        width = 120
                        height = 60
                        rx = 6
                        fill = color_nav_bg
                        stroke = color_nav_border
                        stroke_width = 2
                        text td { content = "Bezier" }
                    }

                    rect e {
                        x = 530
                        y = 140
                        width = 120
                        height = 60
                        rx = 6
                        fill = color_nav_bg
                        stroke = color_nav_border
                        stroke_width = 2
                        text te { content = "Curve" }
                    }

                    connection ab {
                        from = "a"
                        to = "b"
                        direction = "to"
                        label = "one-way"
                        stroke = color_text
                        stroke_width = 2
                    }

                    connection bc {
                        from = "b"
                        to = "c"
                        direction = "both"
                        label = "bidirectional"
                        stroke = color_text
                        stroke_width = 2
                    }

                    connection de {
                        from = "d"
                        to = "e"
                        direction = "to"
                        curve = "bezier"
                        label = "bezier curve"
                        stroke = color_link
                        stroke_width = 2
                    }
                }
            }
        }

        // --- Example 3: Anchored layout ---
        vsplit v_diag4 {
            split s_diag4 {
                size = 100

                heading hd4 {
                    level = 2
                    content = "Anchored Positioning"
                }
                paragraph pd4 { content = "Shapes can be anchored to parent edges. They stretch to fill the space between anchors:" }

                diagram anchored {
                    width = 700
                    height = 250

                    rect outer {
                        left = 10
                        right = 10
                        top = 10
                        bottom = 10
                        rx = 4
                        fill = "none"
                        stroke = color_nav_border
                        stroke_width = 1
                        stroke_dasharray = "4,4"

                        rect header {
                            left = 0
                            right = 0
                            top = 0
                            height = 40
                            fill = color_nav_bg
                            stroke = color_nav_border
                            stroke_width = 1
                            text ht { content = "Header (anchored top, full width)" }
                        }

                        rect sidebar {
                            left = 0
                            top = 50
                            bottom = 50
                            width = 150
                            fill = color_code_bg
                            stroke = color_code_border
                            stroke_width = 1
                            text st { content = "Sidebar" }
                        }

                        rect content_area {
                            left = 160
                            top = 50
                            right = 0
                            bottom = 50
                            fill = color_nav_bg
                            stroke = color_nav_border
                            stroke_width = 1
                            text ct {
                                content = "Content (fills remaining space)"
                            }
                        }

                        rect footer {
                            left = 0
                            right = 0
                            bottom = 0
                            height = 40
                            fill = color_nav_bg
                            stroke = color_nav_border
                            stroke_width = 1
                            text ft { content = "Footer (anchored bottom, full width)" }
                        }
                    }
                }
            }
        }

        // --- Example 4: Stack layout ---
        vsplit v_diag5 {
            split s_diag5 {
                size = 100

                heading hd5 {
                    level = 2
                    content = "Stack Layout"
                }
                paragraph pd5 { content = "Use " + bold("align = \"stack\"") + " to automatically stack children vertically with spacing:" }

                diagram stack_demo {
                    width = 400
                    height = 220

                    rect container {
                        x = 20
                        y = 10
                        width = 360
                        height = 200
                        rx = 8
                        fill = "none"
                        stroke = color_nav_border
                        stroke_width = 1
                        align = "stack"
                        gap = 10
                        padding = 15

                        rect item1 {
                            height = 40
                            rx = 4
                            fill = color_link
                            text t1 {
                                content = "Item 1"
                                fill = color_on_accent
                            }
                        }

                        rect item2 {
                            height = 40
                            rx = 4
                            fill = color_nav_active
                            text t2 { content = "Item 2" }
                        }

                        rect item3 {
                            height = 40
                            rx = 4
                            fill = color_code_bg
                            stroke = color_code_border
                            stroke_width = 1
                            text t3 { content = "Item 3" }
                        }
                    }
                }

                heading hd6 {
                    level = 2
                    content = "WCL Source"
                }
                paragraph pd6 { content = "Here is the WCL code for the stack layout diagram above:" }
                code cd1 {
                    language = "wcl"
                    content = "wdoc_diagram stack_demo {\n    width = 400\n    height = 220\n\n    shape_rect container {\n        x = 20\n        y = 10\n        width = 360\n        height = 200\n        align = \"stack\"\n        gap = 10\n        padding = 15\n\n        shape_rect item1 {\n            height = 40\n            fill = color_link\n            shape_text t1 { content = \"Item 1\" }\n        }\n        shape_rect item2 {\n            height = 40\n            fill = color_nav_active\n            shape_text t2 { content = \"Item 2\" }\n        }\n    }\n}"
                }
            }
        }

        // --- Example 5: Layered (Sugiyama) layout ---
        vsplit v_diag6 {
            split s_diag6 {
                size = 100

                heading hd7 {
                    level = 2
                    content = "Layered Layout (Flowchart)"
                }
                paragraph pd7 { content = "Use " + bold("align = \"layered\"") + " for directed graphs. Nodes are arranged in layers based on edge direction:" }

                diagram layered_demo {
                    width = 600
                    height = 350
                    align = "layered"
                    gap = 40

                    rect input {
                        width = 120
                        height = 50
                        rx = 6
                        fill = color_code_bg
                        stroke = color_link
                        stroke_width = 2
                        text t { content = "Input" }
                    }

                    rect validate {
                        width = 120
                        height = 50
                        rx = 6
                        fill = color_code_bg
                        stroke = color_link
                        stroke_width = 2
                        text t { content = "Validate" }
                    }

                    rect xform {
                        width = 120
                        height = 50
                        rx = 6
                        fill = color_code_bg
                        stroke = color_link
                        stroke_width = 2
                        text t { content = "Transform" }
                    }

                    rect cache {
                        width = 120
                        height = 50
                        rx = 6
                        fill = color_nav_bg
                        stroke = color_nav_border
                        stroke_width = 2
                        text t { content = "Cache" }
                    }

                    rect output {
                        width = 120
                        height = 50
                        rx = 6
                        fill = color_code_bg
                        stroke = color_link
                        stroke_width = 2
                        text t { content = "Output" }
                    }

                    connection c1 {
                        from = "input"
                        to = "validate"
                        direction = "to"
                        stroke = color_text
                        stroke_width = 2
                    }
                    connection c2 {
                        from = "validate"
                        to = "xform"
                        direction = "to"
                        stroke = color_text
                        stroke_width = 2
                    }
                    connection c3 {
                        from = "xform"
                        to = "cache"
                        direction = "to"
                        stroke = color_text
                        stroke_width = 2
                    }
                    connection c4 {
                        from = "xform"
                        to = "output"
                        direction = "to"
                        stroke = color_text
                        stroke_width = 2
                    }
                }
            }
        }

        // --- Example 6: Custom shapes as graph nodes ---
        vsplit v_diag_custom1 {
            split s_diag_custom1 {
                size = 100

                heading hd_custom1 {
                    level = 2
                    content = "Custom Shapes in Layered Layout"
                }
                paragraph pd_custom1 {
                    content = "Custom shapes declared with " + bold("@template(\"shape\", ...)") + " can be linked and laid out exactly like built-in shapes. The connections reference the custom shape block IDs."
                }

                diagram custom_shape_nodes {
                    width = 700
                    height = 260
                    align = "layered"
                    gap = 55

                    task_node draft {
                        width = 130
                        height = 46
                        label = "Draft"
                    }
                    task_node review {
                        width = 130
                        height = 46
                        label = "Review"
                    }
                    task_node approve {
                        width = 130
                        height = 46
                        label = "Approve"
                    }
                    task_node publish {
                        width = 130
                        height = 46
                        label = "Publish"
                        fill = color_success_bg
                    }

                    connection custom_c1 {
                        from = "draft"
                        to = "review"
                        direction = "to"
                    }
                    connection custom_c2 {
                        from = "review"
                        to = "approve"
                        direction = "to"
                    }
                    connection custom_c3 {
                        from = "approve"
                        to = "publish"
                        direction = "to"
                    }
                }

                code custom_shape_nodes_src {
                    language = "wcl"
                    content = "namespace custom_shapes {\n    @template(\"shape\", \"custom_shapes::task_node_template\")\n    @open\n    schema \"task_node\" { }\n\n    export let task_node_template = (b) => [\n        { kind = \"rect\", x = 0, y = 0, width = attr_or(b, \"width\", 130), height = attr_or(b, \"height\", 46), rx = 7,\n          fill = attr_or(b, \"fill\", color_code_bg), stroke = color_link, stroke_width = 1.5 },\n        { kind = \"text\", x = 0, y = 0, width = attr_or(b, \"width\", 130), height = attr_or(b, \"height\", 46),\n          content = attr_or(b, \"label\", \"Task\"), font_size = 13 }\n    ]\n}\n\ndiagram custom_shape_nodes {\n    width = 700\n    height = 260\n    align = \"layered\"\n    gap = 55\n\n    task_node draft { width = 130, height = 46, label = \"Draft\" }\n    task_node review { width = 130, height = 46, label = \"Review\" }\n    task_node approve { width = 130, height = 46, label = \"Approve\" }\n    task_node publish { width = 130, height = 46, label = \"Publish\" }\n\n    connection custom_c1 { from = \"draft\", to = \"review\", direction = \"to\" }\n    connection custom_c2 { from = \"review\", to = \"approve\", direction = \"to\" }\n    connection custom_c3 { from = \"approve\", to = \"publish\", direction = \"to\" }\n}"
                }
            }
        }

        // --- Example 7: Nested local connections ---
        vsplit v_diag_custom2 {
            split s_diag_custom2 {
                size = 100

                heading hd_custom2 {
                    level = 2
                    content = "Nested Layered Layout with Local Links"
                }
                paragraph pd_custom2 {
                    content = "Connections inside a container are scoped to that container. Local endpoints like " + bold("from = \"intake\"") + " resolve under the parent shape, so nested layered layouts can be written without dotted IDs."
                }

                diagram nested_custom_links {
                    width = 700
                    height = 310

                    rect lane {
                        x = 70
                        y = 30
                        width = 560
                        height = 230
                        rx = 10
                        fill = "none"
                        stroke = color_nav_border
                        stroke_width = 1.5
                        align = "layered"
                        gap = 45
                        padding = 18

                        task_node intake {
                            width = 120
                            height = 42
                            label = "Intake"
                        }
                        task_node triage {
                            width = 120
                            height = 42
                            label = "Triage"
                        }
                        task_node resolve {
                            width = 120
                            height = 42
                            label = "Resolve"
                            fill = color_success_bg
                        }

                        connection local1 {
                            from = "intake"
                            to = "triage"
                            direction = "to"
                        }
                        connection local2 {
                            from = "triage"
                            to = "resolve"
                            direction = "to"
                        }
                    }
                }

                code nested_custom_links_src {
                    language = "wcl"
                    content = "rect lane {\n    x = 70, y = 30, width = 560, height = 230\n    rx = 10\n    fill = \"none\"\n    stroke = color_nav_border\n    align = \"layered\"\n    gap = 45\n    padding = 18\n\n    task_node intake { width = 120, height = 42, label = \"Intake\" }\n    task_node triage { width = 120, height = 42, label = \"Triage\" }\n    task_node resolve { width = 120, height = 42, label = \"Resolve\" }\n\n    connection local1 { from = \"intake\", to = \"triage\", direction = \"to\" }\n    connection local2 { from = \"triage\", to = \"resolve\", direction = \"to\" }\n}"
                }
            }
        }

        // --- Example 8: Template-generated links ---
        vsplit v_diag_custom3 {
            split s_diag_custom3 {
                size = 100

                heading hd_custom3 {
                    level = 2
                    content = "Template-Generated Links"
                }
                paragraph pd_custom3 {
                    content = "Templates can return " + bold("connection") + " descriptors for internal flow. Generated nodes opt into parent layout with " + bold("layout_role = \"node\"") + "; generated decoration stays out of layout by default."
                }

                diagram generated_custom_links {
                    width = 700
                    height = 280

                    mini_flow flow_a {
                        x = 90
                        y = 30
                        width = 210
                        height = 200
                        align = "layered"
                        gap = 34
                    }

                    mini_flow flow_b {
                        x = 400
                        y = 30
                        width = 210
                        height = 200
                        align = "layered"
                        gap = 34
                    }
                }

                code generated_custom_links_src {
                    language = "wcl"
                    content = "export let mini_flow_template = (b) => [\n    { kind = \"rect\", id = \"start\", width = 96, height = 34,\n      layout_role = \"node\", children = [{ kind = \"text\", content = \"Start\" }] },\n    { kind = \"rect\", id = \"review\", width = 96, height = 34,\n      layout_role = \"node\", children = [{ kind = \"text\", content = \"Review\" }] },\n    { kind = \"rect\", id = \"done\", width = 96, height = 34,\n      layout_role = \"node\", children = [{ kind = \"text\", content = \"Done\" }] },\n    { kind = \"connection\", from = \"start\", to = \"review\", direction = \"to\" },\n    { kind = \"connection\", from = \"review\", to = \"done\", direction = \"to\" }\n]\n\nmini_flow flow_a {\n    x = 90, y = 30, width = 210, height = 200\n    align = \"layered\"\n    gap = 34\n}"
                }
            }
        }

        // --- Example 9: Force-directed layout ---
        vsplit v_diag7 {
            split s_diag7 {
                size = 100

                heading hd8 {
                    level = 2
                    content = "Force-Directed Layout (Network)"
                }
                paragraph pd8 { content = "Use " + bold("align = \"force\"") + " for network diagrams. Connected nodes attract, all nodes repel:" }

                diagram network {
                    width = 500
                    height = 350
                    align = "force"

                    circle web {
                        r = 28
                        fill = color_link
                        text t { content = "Web"
                            fill = "#fff" }
                    }
                    circle api {
                        r = 28
                        fill = color_link
                        text t { content = "API"
                            fill = "#fff" }
                    }
                    circle auth {
                        r = 28
                        fill = color_nav_bg
                        stroke = color_nav_border
                        stroke_width = 2
                        text t { content = "Auth" }
                    }
                    circle db {
                        r = 28
                        fill = color_nav_bg
                        stroke = color_nav_border
                        stroke_width = 2
                        text t { content = "DB" }
                    }
                    circle cache_node {
                        r = 28
                        fill = color_nav_bg
                        stroke = color_nav_border
                        stroke_width = 2
                        text t { content = "Cache" }
                    }
                    circle queue {
                        r = 28
                        fill = color_code_bg
                        stroke = color_code_border
                        stroke_width = 2
                        text t { content = "Queue" }
                    }

                    connection e1 {
                        from = "web"
                        to = "api"
                        direction = "to"
                        stroke = color_text
                    }
                    connection e2 {
                        from = "api"
                        to = "auth"
                        direction = "both"
                        stroke = color_text
                    }
                    connection e3 {
                        from = "api"
                        to = "db"
                        direction = "both"
                        stroke = color_text
                    }
                    connection e4 {
                        from = "api"
                        to = "cache_node"
                        direction = "both"
                        stroke = color_text
                    }
                    connection e5 {
                        from = "api"
                        to = "queue"
                        direction = "to"
                        stroke = color_text
                    }
                    connection e6 {
                        from = "queue"
                        to = "db"
                        direction = "to"
                        stroke = color_text
                    }
                }
            }
        }

        // --- Example 10: Radial layout ---
        vsplit v_diag8 {
            split s_diag8 {
                size = 100

                heading hd9 {
                    level = 2
                    content = "Radial Layout (Hierarchy)"
                }
                paragraph pd9 { content = "Use " + bold("align = \"radial\"") + " with a " + bold("root") + " node for tree hierarchies:" }

                diagram org {
                    width = 500
                    height = 400
                    align = "radial"
                    root = "ceo"

                    circle ceo {
                        r = 30
                        fill = color_link
                        text t { content = "CEO"
                            fill = "#fff" }
                    }
                    circle cto {
                        r = 24
                        fill = color_code_bg
                        stroke = color_link
                        stroke_width = 2
                        text t { content = "CTO" }
                    }
                    circle cfo {
                        r = 24
                        fill = color_code_bg
                        stroke = color_link
                        stroke_width = 2
                        text t { content = "CFO" }
                    }
                    circle vpe {
                        r = 24
                        fill = color_code_bg
                        stroke = color_link
                        stroke_width = 2
                        text t { content = "VP Eng" }
                    }
                    circle eng1 {
                        r = 18
                        fill = color_nav_bg
                        stroke = color_nav_border
                        stroke_width = 1
                        text t { content = "Eng1" }
                    }
                    circle eng2 {
                        r = 18
                        fill = color_nav_bg
                        stroke = color_nav_border
                        stroke_width = 1
                        text t { content = "Eng2" }
                    }
                    circle fin1 {
                        r = 18
                        fill = color_nav_bg
                        stroke = color_nav_border
                        stroke_width = 1
                        text t { content = "Fin" }
                    }

                    connection r1 {
                        from = "ceo"
                        to = "cto"
                        stroke = color_text
                    }
                    connection r2 {
                        from = "ceo"
                        to = "cfo"
                        stroke = color_text
                    }
                    connection r3 {
                        from = "ceo"
                        to = "vpe"
                        stroke = color_text
                    }
                    connection r4 {
                        from = "vpe"
                        to = "eng1"
                        stroke = color_text
                    }
                    connection r5 {
                        from = "vpe"
                        to = "eng2"
                        stroke = color_text
                    }
                    connection r6 {
                        from = "cfo"
                        to = "fin1"
                        stroke = color_text
                    }
                }
            }
        }

        // --- Example 11: Grid layout ---
        vsplit v_diag9 {
            split s_diag9 {
                size = 100

                heading hd10 {
                    level = 2
                    content = "Grid Layout"
                }
                paragraph pd10 { content = "Use " + bold("align = \"grid\"") + " with optional " + bold("columns") + " for regular arrangements:" }

                diagram dashboard {
                    width = 500
                    height = 300
                    align = "grid"
                    columns = 3
                    gap = 20

                    rect s1 {
                        width = 100
                        height = 60
                        rx = 6
                        fill = color_code_bg
                        stroke = color_code_border
                        stroke_width = 1
                        text t { content = "Widget 1" }
                    }
                    rect s2 {
