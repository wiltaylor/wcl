import "./shared.wcl"

// ── Swim Lane Diagrams page ──

page swimlane_diagrams {
    section = ref("my_docs.diagrams.swimlane_diagrams")
    title = "Swim Lane Diagrams"

    layout {
        vsplit v_sw1 {
            split s_sw1 {
                size = 100

                heading hsw1 {
                    level = 1
                    content = "Swim Lane Diagrams"
                }
                paragraph psw1 {
                    content = "Swim lane diagrams use anchored rectangles as lanes with shapes inside each lane. Connections cross lane boundaries to show handoffs between actors."
                }
            }
        }

        // --- Example 1: Order Processing ---
        vsplit v_sw2 {
            split s_sw2 {
                size = 100

                heading hsw2 {
                    level = 2
                    content = "Order Processing Flow"
                }
                paragraph psw2 { content = "Three swim lanes showing the handoffs between Customer, System, and Warehouse:" }

                diagram order_flow {
                    width = 800
                    height = 500

                    // Lane backgrounds (anchored full-height strips)
                    rect lane_customer {
                        left = 0
                        top = 40
                        bottom = 0
                        width = 250
                        fill = color_code_bg
                        stroke = color_code_border
                        stroke_width = 1
                    }
                    rect lane_system {
                        left = 260
                        top = 40
                        bottom = 0
                        width = 260
                        fill = color_nav_bg
                        stroke = color_nav_border
                        stroke_width = 1
                    }
                    rect lane_warehouse {
                        left = 530
                        top = 40
                        bottom = 0
                        width = 270
                        fill = color_code_bg
                        stroke = color_code_border
                        stroke_width = 1
                    }

                    // Lane headers
                    rect hdr_customer {
                        x = 0
                        y = 0
                        width = 250
                        height = 40
                        fill = color_link
                        text t { content = "Customer"
                            fill = "#fff"
                            font_size = 15 }
                    }
                    rect hdr_system {
                        x = 260
                        y = 0
                        width = 260
                        height = 40
                        fill = color_link
                        text t { content = "System"
                            fill = "#fff"
                            font_size = 15 }
                    }
                    rect hdr_warehouse {
                        x = 530
                        y = 0
                        width = 270
                        height = 40
                        fill = color_link
                        text t { content = "Warehouse"
                            fill = "#fff"
                            font_size = 15 }
                    }

                    // Customer lane steps
                    rect c_browse {
                        x = 50
                        y = 70
                        width = 150
                        height = 45
                        rx = 20
                        fill = color_bg
                        stroke = color_link
                        stroke_width = 2
                        text t { content = "Browse Items" }
                    }
                    rect c_order {
                        x = 50
                        y = 150
                        width = 150
                        height = 45
                        rx = 6
                        fill = color_bg
                        stroke = color_link
                        stroke_width = 2
                        text t { content = "Place Order" }
                    }
                    rect c_pay {
                        x = 50
                        y = 240
                        width = 150
                        height = 45
                        rx = 6
                        fill = color_bg
                        stroke = color_link
                        stroke_width = 2
                        text t { content = "Pay" }
                    }
                    rect c_receive {
                        x = 50
                        y = 420
                        width = 150
                        height = 45
                        rx = 20
                        fill = color_bg
                        stroke = color_link
                        stroke_width = 2
                        text t { content = "Receive Package" }
                    }

                    // System lane steps
                    rect s_validate {
                        x = 310
                        y = 150
                        width = 160
                        height = 45
                        rx = 6
                        fill = color_bg
                        stroke = color_nav_border
                        stroke_width = 2
                        text t { content = "Validate Order" }
                    }
                    rect s_payment {
                        x = 310
                        y = 240
                        width = 160
                        height = 45
                        rx = 6
                        fill = color_bg
                        stroke = color_nav_border
                        stroke_width = 2
                        text t { content = "Process Payment" }
                    }
                    rect s_notify {
                        x = 310
                        y = 330
                        width = 160
                        height = 45
                        rx = 6
                        fill = color_bg
                        stroke = color_nav_border
                        stroke_width = 2
                        text t { content = "Send Notification" }
                    }
                    rect s_tracking {
                        x = 310
                        y = 420
                        width = 160
                        height = 45
                        rx = 6
                        fill = color_bg
                        stroke = color_nav_border
                        stroke_width = 2
                        text t { content = "Update Tracking" }
                    }

                    // Warehouse lane steps
                    rect w_check {
                        x = 580
                        y = 240
                        width = 160
                        height = 45
                        rx = 6
                        fill = color_bg
                        stroke = color_code_border
                        stroke_width = 2
                        text t { content = "Check Stock" }
                    }
                    rect w_pick {
                        x = 580
                        y = 330
                        width = 160
                        height = 45
                        rx = 6
                        fill = color_bg
                        stroke = color_code_border
                        stroke_width = 2
                        text t { content = "Pick & Pack" }
                    }
                    rect w_ship {
                        x = 580
                        y = 420
                        width = 160
                        height = 45
                        rx = 6
                        fill = color_bg
                        stroke = color_code_border
                        stroke_width = 2
                        text t { content = "Ship" }
                    }

                    // In-lane connections
                    connection oc1 {
                        from = "c_browse"
                        to = "c_order"
                        direction = "to"
                        stroke = color_text
                        stroke_width = 2
                    }
                    connection oc7 {
                        from = "w_check"
                        to = "w_pick"
                        direction = "to"
                        stroke = color_text
                        stroke_width = 2
                    }
                    connection oc8 {
                        from = "w_pick"
                        to = "w_ship"
                        direction = "to"
                        stroke = color_text
                        stroke_width = 2
                    }

                    // Cross-lane connections (handoffs)
                    connection oc2 {
                        from = "c_order"
                        to = "s_validate"
                        direction = "to"
                        from_anchor = "right"
                        to_anchor = "left"
                        stroke = color_link
                        stroke_width = 2
                        label = "submit"
                    }
                    connection oc3 {
                        from = "c_pay"
                        to = "s_payment"
                        direction = "to"
                        from_anchor = "right"
                        to_anchor = "left"
                        stroke = color_link
                        stroke_width = 2
                    }
                    connection oc4 {
                        from = "s_validate"
                        to = "s_payment"
                        direction = "to"
                        stroke = color_text
                        stroke_width = 2
                    }
                    connection oc5 {
                        from = "s_payment"
                        to = "w_check"
                        direction = "to"
                        from_anchor = "right"
                        to_anchor = "left"
                        stroke = color_link
                        stroke_width = 2
                        label = "fulfill"
                    }
                    connection oc9 {
                        from = "w_ship"
                        to = "s_tracking"
                        direction = "to"
                        from_anchor = "left"
                        to_anchor = "right"
                        stroke = color_link
                        stroke_width = 2
                        label = "shipped"
                    }
                    connection oc10 {
                        from = "s_notify"
                        to = "c_receive"
                        direction = "to"
                        from_anchor = "left"
                        to_anchor = "right"
                        stroke = color_link
                        stroke_width = 2
                    }
                    connection oc11 {
                        from = "s_tracking"
                        to = "s_notify"
                        direction = "to"
                        stroke = color_text
                        stroke_width = 2
                    }
                }
            }
        }

        // --- Example 2: Horizontal swim lanes (user registration) ---
        vsplit v_sw3 {
            split s_sw3 {
                size = 100

                heading hsw3 {
                    level = 2
                    content = "User Registration (Horizontal Lanes)"
                }
                paragraph psw3 { content = "Horizontal swim lanes with the flow going left-to-right:" }

                diagram reg_flow {
                    width = 800
                    height = 420

                    // Horizontal lane backgrounds
                    rect lane_user {
                        left = 80
                        top = 0
                        right = 0
                        height = 130
                        fill = color_code_bg
                        stroke = color_code_border
                        stroke_width = 1
                    }
                    rect lane_api {
                        left = 80
                        top = 140
                        right = 0
                        height = 130
                        fill = color_nav_bg
                        stroke = color_nav_border
                        stroke_width = 1
                    }
                    rect lane_email {
                        left = 80
                        top = 280
                        right = 0
                        height = 130
                        fill = color_code_bg
                        stroke = color_code_border
                        stroke_width = 1
                    }

                    // Lane labels (rotated via vertical text positioning)
                    rect lbl_user {
                        x = 0
                        y = 0
                        width = 75
                        height = 130
                        fill = color_link
                        text t { content = "User"
                            fill = "#fff"
                            font_size = 14 }
                    }
                    rect lbl_api {
                        x = 0
                        y = 140
                        width = 75
                        height = 130
                        fill = color_link
                        text t { content = "API"
                            fill = "#fff"
                            font_size = 14 }
                    }
                    rect lbl_email {
                        x = 0
                        y = 280
                        width = 75
                        height = 130
                        fill = color_link
                        text t { content = "Email"
                            fill = "#fff"
                            font_size = 14 }
                    }

                    // User lane steps
                    rect u_signup {
                        x = 110
                        y = 35
                        width = 120
                        height = 45
                        rx = 20
                        fill = color_bg
                        stroke = color_link
                        stroke_width = 2
                        text t { content = "Sign Up" }
                    }
                    rect u_fill {
                        x = 290
                        y = 35
                        width = 120
                        height = 45
                        rx = 6
                        fill = color_bg
                        stroke = color_link
                        stroke_width = 2
                        text t { content = "Fill Form" }
                    }
                    rect u_verify {
                        x = 570
                        y = 35
                        width = 120
                        height = 45
                        rx = 6
                        fill = color_bg
                        stroke = color_link
                        stroke_width = 2
                        text t { content = "Click Link" }
                    }

                    // API lane steps
                    rect a_validate {
                        x = 290
                        y = 180
                        width = 120
                        height = 45
                        rx = 6
                        fill = color_bg
                        stroke = color_nav_border
                        stroke_width = 2
                        text t { content = "Validate" }
                    }
                    rect a_create {
                        x = 460
                        y = 180
                        width = 120
                        height = 45
                        rx = 6
                        fill = color_bg
                        stroke = color_nav_border
                        stroke_width = 2
                        text t { content = "Create User" }
                    }
                    rect a_activate {
                        x = 630
                        y = 180
                        width = 120
                        height = 45
                        rx = 6
                        fill = color_bg
                        stroke = color_nav_border
                        stroke_width = 2
                        text t { content = "Activate" }
                    }

                    // Email lane steps
                    rect e_send {
                        x = 460
                        y = 320
                        width = 130
                        height = 45
                        rx = 6
                        fill = color_bg
                        stroke = color_code_border
                        stroke_width = 2
                        text t { content = "Send Verify" }
                    }
                    rect e_welcome {
                        x = 630
                        y = 320
                        width = 130
                        height = 45
                        rx = 20
                        fill = color_bg
                        stroke = color_code_border
                        stroke_width = 2
                        text t { content = "Welcome Mail" }
                    }

                    // In-lane flow
                    connection rc1 {
                        from = "u_signup"
                        to = "u_fill"
                        direction = "to"
                        stroke = color_text
                        stroke_width = 2
                    }
                    connection rc5 {
                        from = "a_validate"
                        to = "a_create"
                        direction = "to"
                        stroke = color_text
                        stroke_width = 2
                    }

                    // Cross-lane handoffs
                    connection rc2 {
                        from = "u_fill"
                        to = "a_validate"
                        direction = "to"
                        from_anchor = "bottom"
                        to_anchor = "top"
                        stroke = color_link
                        stroke_width = 2
                        label = "POST"
                    }
                    connection rc3 {
                        from = "a_create"
                        to = "e_send"
                        direction = "to"
                        from_anchor = "bottom"
                        to_anchor = "top"
                        stroke = color_link
                        stroke_width = 2
                        label = "trigger"
                    }
                    connection rc4 {
                        from = "e_send"
                        to = "u_verify"
                        direction = "to"
                        from_anchor = "top"
                        to_anchor = "bottom"
                        curve = "bezier"
                        stroke = color_link
                        stroke_width = 2
                        label = "email link"
                    }
                    connection rc6 {
                        from = "u_verify"
                        to = "a_activate"
                        direction = "to"
                        from_anchor = "bottom"
                        to_anchor = "top"
                        stroke = color_link
                        stroke_width = 2
                        label = "GET"
                    }
                    connection rc7 {
                        from = "a_activate"
                        to = "e_welcome"
                        direction = "to"
                        from_anchor = "bottom"
                        to_anchor = "top"
                        stroke = color_link
                        stroke_width = 2
                    }
                }
            }
        }
    }
}
