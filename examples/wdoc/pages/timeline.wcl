// Timeline demo: the `timeline` shape — a real-time axis.
//
// A timeline is a diagram shape that tracks calendar time. Pick a `unit`
// (`:minutes`..`:years`) and it shows tick points at real calendar
// boundaries; `items` (a marker + lead line + text) and event `card`s are
// pinned to explicit dates via `on`, and `phases` mark named date spans.
// `start`/`end` bound the axis (auto-fit from the events when omitted),
// and `every` overrides the auto tick interval. Items zig-zag sides by
// default; force one with `TimelineItem::OnSided { … side = :near|:far }`.

page timeline { sites = [:showcase]
  h1 "Timelines" {}

  text {
    span "A " {}
    span "timeline" { class = ["accent"] }
    span " tracks calendar time along an axis — horizontal or vertical. Each " {}
    span "item" { class = ["accent"] }
    span " is pinned to a date with " {}
    span "on" { class = ["accent"] }
    span "; " {}
    span "phases" { class = ["accent"] }
    span " mark named date spans; and " {}
    span "unit" { class = ["accent"] }
    span " (minutes…years) sets the tick granularity." {}
  }

  h2 "Horizontal roadmap" {}

  // A monthly axis across 2026 with three phases and dated items that
  // auto-alternate above / below the axis (one is pinned `:far`).
  diagram {
    width  = 560
    height = 220

    timeline {
      width  = 560
      height = 220
      title  = "2026 roadmap"
      unit   = :months
      start  = "2026-01-01"
      end    = "2026-12-31"
      phases = [
        TimelinePhase::Of { label: "Discovery", from: "2026-01-01", to: "2026-04-01" },
        TimelinePhase::Of { label: "Build",     from: "2026-04-01", to: "2026-10-01" },
        TimelinePhase::Of { label: "Launch",    from: "2026-10-01", to: "2026-12-31" },
      ]
      items = [
        TimelineItem::On      { label: "Kickoff",       on: "2026-01-12" },
        TimelineItem::On      { label: "Design freeze",  on: "2026-04-01" },
        TimelineItem::On      { label: "Beta",          on: "2026-07-15" },
        TimelineItem::OnSided { label: "Code freeze",    on: "2026-10-01", side: :far },
        TimelineItem::On      { label: "GA",            on: "2026-12-15" },
      ]
    }
  }

  h2 "Vertical, auto-scaled" {}

  // No `start`/`end`: the scale fits the event dates. Vertical timelines
  // read top-to-bottom with items to the left and right of the axis.
  diagram {
    width  = 300
    height = 320

    timeline {
      width     = 300
      height    = 320
      direction = :vertical
      title     = "Release history"
      unit      = :months
      phases = [
        TimelinePhase::Of { label: "1.x", from: "2025-09-01", to: "2026-02-01" },
        TimelinePhase::Of { label: "2.x", from: "2026-02-01", to: "2026-08-01" },
      ]
      items = [
        TimelineItem::On { label: "1.0 alpha", on: "2025-09-15" },
        TimelineItem::On { label: "1.0",       on: "2026-02-01" },
        TimelineItem::On { label: "2.0 beta",  on: "2026-05-01" },
        TimelineItem::On { label: "2.0",       on: "2026-08-01" },
      ]
    }
  }

  text {
    span "Phase dividers and headings carry a cycled palette class, and markers / connectors paint with " {}
    span "currentColor" { class = ["accent"] }
    span " — so a site theme or a `class` override recolours a timeline like anything else." {}
  }

  h2 "Event cards" {}

  text {
    span "An event " {}
    span "card" { class = ["accent"] }
    span " is a child of the timeline pinned to a date with " {}
    span "on" { class = ["accent"] }
    span ", filled with formatted wdoc content. It renders in place on the axis." {}
  }

  // `card` children carry rich, inline-formatted bodies, pinned to a date.
  diagram {
    width  = 720
    height = 320

    timeline {
      width  = 720
      height = 320
      title  = "Release timeline"
      unit   = :months
      start  = "2026-01-01"
      end    = "2026-12-31"
      card { on = "2026-02-01"  title = "1.0"  width = 210.0  height = 104.0
        text { span "First " {} span "stable" { class = ["accent"] } span " release. APIs frozen." {} }
      }
      card { on = "2026-05-15"  side = :far  title = "1.4"  width = 210.0  height = 104.0
        text { span "Plugin system + the " {} span "wdoc" { class = ["accent"] } span " generator." {} }
      }
      card { on = "2026-10-01"  title = "2.0"  width = 210.0  height = 104.0
        text { span "Rewrite: lazy eval, schema check, LSP." {} }
      }
    }
  }

  h2 "Cards in any diagram" {}

  text {
    span "Because a " {}
    span "card" { class = ["accent"] }
    span " is an ordinary diagram shape, you can drop one into any " {}
    span "diagram" { class = ["accent"] }
    span " — positioned with x/y or anchors, and connectable by edges." {}
  }

  diagram {
    width  = 320
    height = 170
    card {
      x = 20.0  y = 20.0  width = 280.0  height = 130.0
      title = "Standalone card"
      text { span "The " {} span "same" { class = ["accent"] } span " wdoc content as a timeline event — text, code, callouts." {} }
    }
  }
}

// Recolour the timeline connectors. The bundled `wdoc-timeline-connector`
// default comes first in the stylesheet, so this override wins by
// cascade; `dark {}` / `light {}` track the reader's colour scheme. The
// name is quoted because it contains hyphens.
class "wdoc-timeline-connector" {
  stroke  = "#7b2d8e"
  opacity = "0.7"
  dark  { stroke = "#c792ea" }
  light { stroke = "#7b2d8e" }
}
