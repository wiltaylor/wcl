import "./shared.wcl"

page graph_node_examples {
    section = ref("my_docs.diagrams.graph_node_examples")
    title = "Graph Node Diagrams"

    layout {
        vsplit v_graph_nodes {
            split s_graph_nodes {
                size = 100

                heading h1 {
                    level = 1
                    content = "Graph Node Diagrams"
                }

                paragraph intro {
                    content = "Graph nodes are card-like diagram widgets with row-level ports. Connections can target any named port with scoped IDs such as <code>gateway.rest</code>, <code>users.in</code>, or <code>database.query</code>."
                }

                heading h2_basic {
                    level = 2
                    content = "Port-to-port routing"
                }

                diagram graph_node_service_map {
                    width = 880
                    height = 360

                    graph_node gateway {
                        x = 40
                        y = 34
                        width = 240
                        title = "Gateway"
                        subtitle = "public edge"

                        graph_row ingress {
                            label = "Ingress"
                            left_port = "request"
                            right_port = "rest"
                        }

                        graph_divider edge_boundary { }

                        graph_row auth {
                            label = "Auth policy"
                            right_port = "token"
                        }

                        graph_row event_bus {
                            label = "Event bus"
                            right_port = "events"
                            detail = "publish"
                        }
                    }

                    graph_node user_service {
                        x = 430
                        y = 34
                        width = 240
                        title = "User service"
                        subtitle = "domain API"

                        graph_row rest {
                            label = "REST API"
                            left_port = "in"
                            right_port = "query"
                        }

                        graph_divider clients_boundary {
                            stroke = color_link
                            opacity = 0.55
                        }

                        graph_row cache {
                            label = "Cache client"
                            left_port = "cache_in"
                            right_port = "cache_out"
                        }

                        graph_row audit {
                            label = "Audit events"
                            left_port = "audit"
                        }
                    }

                    rect browser {
                        x = 55
                        y = 280
                        width = 130
                        height = 42
                        rx = 8
                        fill = color_code_bg
                        stroke = color_link
                        text t { content = "Browser" }
                    }

                    database postgres {
                        x = 720
                        y = 30
                        width = 122
                        height = 104
                        label = "Postgres"
                    }

                    connection request {
                        from = "browser"
                        to = "gateway.request"
                        direction = "to"
                    }

                    connection rest {
                        from = "gateway.rest"
                        to = "user_service.in"
                        direction = "to"
                        stroke = color_link
                    }

                    connection token {
                        from = "gateway.token"
                        to = "user_service.cache_in"
                        direction = "to"
                        stroke = color_success
                    }

                    connection audit {
                        from = "gateway.events"
                        to = "user_service.audit"
                        direction = "to"
                        stroke_dasharray = "5,3"
                    }

                    connection query {
                        from = "user_service.query"
                        to = "postgres"
                        direction = "both"
                    }
                }

                heading h2_text_blocks {
                    level = 2
                    content = "Styled text blocks inside graph nodes"
                }

                diagram graph_node_text_blocks {
                    width = 880
                    height = 330

                    graph_node api_details {
                        x = 48
                        y = 34
                        width = 330
                        title = "API contract"
                        subtitle = "embedded docs"

                        text_block body {
                            left = 16
                            top = 50
                            right = 16
                            padding = 0
                            gap = 10
                            font_size = 12
                            line_height = 1.35

                            paragraph summary {
                                content = "Routes **authenticated** requests to _domain_ services and emits `AuditEvent` records for downstream consumers."
                            }

                            code route {
                                language = "wcl"
                                content = "connection audit {\n    from = \"gateway.events\"\n    to = \"user_service.audit\"\n    direction = \"to\"\n}"
                            }
                        }
                    }

                    graph_node worker_details {
                        x = 510
                        y = 74
                        width = 300
                        title = "Worker"
                        subtitle = "consumer"

                        graph_row input {
                            label = "Input"
                            left_port = "audit"
                        }

                        graph_divider docs_boundary { }

                        text_block body {
                            left = 16
                            top = 78
                            right = 16
                            gap = 8

                            p note "Handles [audit events](#) with **idempotent** writes and reports `_status` updates."
                        }
                    }

                    connection docs_audit {
                        from = "api_details"
                        to = "worker_details.audit"
                        direction = "to"
                        stroke = color_success
                    }
                }

                heading h2_dense {
                    level = 2
                    content = "Dense node with many rows"
                }

                diagram graph_node_dense {
                    width = 820
                    height = 430
                    mode = "pan_zoom"

                    graph_node orchestrator {
                        x = 50
                        y = 40
                        width = 260
                        title = "Orchestrator"
                        subtitle = "workflow runtime"

                        for i in range(0, 10) {
                            graph_row step-${i} {
                                label = "Step ${i}"
                                left_port = "in_${i}"
                                right_port = "out_${i}"
                                detail = i % 2 == 0 ? "sync" : "async"
                            }
                        }
                    }

                    graph_node workers {
                        x = 520
                        y = 58
                        width = 230
                        title = "Worker pool"

                        graph_row queue {
                            label = "Queue"
                            left_ports = "job_0,job_1,job_2"
                        }

                        graph_row result {
                            label = "Results"
                            right_ports = "ok,failed"
                        }
                    }

                    connection job0 {
                        from = "orchestrator.out_0"
                        to = "workers.job_0"
                        direction = "to"
                    }

                    connection job1 {
                        from = "orchestrator.out_4"
                        to = "workers.job_1"
                        direction = "to"
                        stroke = color_link
                    }

                    connection job2 {
                        from = "orchestrator.out_8"
                        to = "workers.job_2"
                        direction = "to"
                        stroke = color_success
                    }
                }

                heading h2_schema {
                    level = 2
                    content = "Database schema joins"
                }

                paragraph schema_intro {
                    content = "Graph nodes can model database tables by using rows for columns and row ports for primary-key and foreign-key joins."
                }

                diagram graph_node_database_schema {
                    width = 980
                    height = 580
                    mode = "pan_zoom"

                    graph_node users {
                        x = 40
                        y = 36
                        width = 230
                        title = "users"
                        subtitle = "customer accounts"
                        header_fill = "#1d4ed8"
                        port_fill = color_success

                        graph_row id {
                            label = "id"
                            detail = "uuid pk"
                            right_ports = "orders,addresses"
                        }

                        graph_row email {
                            label = "email"
                            detail = "text unique"
                        }

                        graph_row created_at {
                            label = "created_at"
                            detail = "timestamp"
                        }
                    }

                    graph_node orders {
                        x = 370
                        y = 28
                        width = 240
                        title = "orders"
                        subtitle = "checkout header"
                        header_fill = "#7c3aed"
                        port_fill = color_success

                        graph_row id {
                            label = "id"
                            detail = "uuid pk"
                            right_ports = "items,payments"
                        }

                        graph_row user_id {
                            label = "user_id"
                            detail = "uuid fk"
                            left_port = "user_id"
                        }

                        graph_row status {
                            label = "status"
                            detail = "enum"
                        }

                        graph_row total_cents {
                            label = "total_cents"
                            detail = "integer"
                        }
                    }

                    graph_node products {
                        x = 710
                        y = 34
                        width = 230
                        title = "products"
                        subtitle = "catalog"
                        header_fill = "#047857"
                        port_fill = color_success

                        graph_row id {
                            label = "id"
                            detail = "uuid pk"
                            left_port = "id"
                        }

                        graph_row sku {
                            label = "sku"
                            detail = "text unique"
                        }

                        graph_row name {
                            label = "name"
                            detail = "text"
                        }

                        graph_row active {
                            label = "active"
                            detail = "bool"
                        }
                    }

                    graph_node addresses {
                        x = 40
                        y = 340
                        width = 230
                        title = "addresses"
                        subtitle = "shipping profiles"
                        header_fill = "#0f766e"
                        port_fill = color_success

                        graph_row id {
                            label = "id"
                            detail = "uuid pk"
                        }

                        graph_row user_id {
                            label = "user_id"
                            detail = "uuid fk"
                            left_port = "user_id"
                        }

                        graph_row city {
                            label = "city"
                            detail = "text"
                        }

                        graph_row country {
                            label = "country"
                            detail = "text"
                        }
                    }

                    graph_node order_items {
                        x = 370
                        y = 315
                        width = 240
                        title = "order_items"
                        subtitle = "line items"
                        header_fill = "#b45309"
                        port_fill = color_success

                        graph_row id {
                            label = "id"
                            detail = "uuid pk"
                        }

                        graph_row order_id {
                            label = "order_id"
                            detail = "uuid fk"
                            left_port = "order_id"
                        }

                        graph_row product_id {
                            label = "product_id"
                            detail = "uuid fk"
                            right_port = "product_id"
                        }

                        graph_row quantity {
                            label = "quantity"
                            detail = "integer"
                        }
                    }

                    graph_node payments {
                        x = 710
                        y = 340
                        width = 230
                        title = "payments"
                        subtitle = "settlement"
                        header_fill = "#be123c"
                        port_fill = color_success

                        graph_row id {
                            label = "id"
                            detail = "uuid pk"
                        }

                        graph_row order_id {
                            label = "order_id"
                            detail = "uuid fk"
                            left_port = "order_id"
                        }

                        graph_row provider_ref {
                            label = "provider_ref"
                            detail = "text"
                        }

                        graph_row state {
                            label = "state"
                            detail = "enum"
                        }
                    }

                    connection user_orders {
                        from = "users.orders"
                        to = "orders.user_id"
                        direction = "to"
                        stroke = color_success
                        stroke_width = 2
                        label = "1:N"
                    }

                    connection user_addresses {
                        from = "users.addresses"
                        to = "addresses.user_id"
                        direction = "to"
                        stroke = color_success
                        stroke_width = 2
                        stroke_dasharray = "5,3"
                        label = "1:N"
                    }

                    connection order_items_join {
                        from = "orders.items"
                        to = "order_items.order_id"
                        direction = "to"
                        stroke = "#f59e0b"
                        stroke_width = 2
                        label = "1:N"
                    }

                    connection order_payments_join {
                        from = "orders.payments"
                        to = "payments.order_id"
                        direction = "to"
                        stroke = "#f43f5e"
                        stroke_width = 2
                        label = "1:N"
                    }

                    connection product_items_join {
                        from = "order_items.product_id"
                        to = "products.id"
                        direction = "to"
                        stroke = color_link
                        stroke_width = 2
                        label = "N:1"
                    }
                }

                code sample {
                    language = "wcl"
                    content = "graph_node gateway {\n    title = \"Gateway\"\n\n    graph_row ingress {\n        label = \"Ingress\"\n        left_port = \"request\"\n        right_port = \"rest\"\n    }\n\n    graph_divider public_private { }\n\n    graph_row auth {\n        label = \"Auth policy\"\n        right_port = \"token\"\n    }\n}\n\nconnection rest {\n    from = \"gateway.rest\"\n    to = \"user_service.in\"\n    direction = \"to\"\n}"
                }
            }
        }
    }
}
