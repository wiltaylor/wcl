import "./shared.wcl"

// ── UI Wireframes page ──

class wf_popup_menu {
    opacity = 0
    visible = false
    pointer_events = "none"
    transition = "opacity 120ms ease"
    z_index = 20

    state shown {
        opacity = 1
        visible = true
        pointer_events = "all"
        z_index = 30
    }
}

page wireframes {
    section = "my_docs.diagrams.wireframes"
    title = "UI Wireframes"

    layout {
        vsplit v_wf1 {
            split s_wf1 {
                size = 100

                heading hwf1 {
                    level = 1
                    content = "UI Wireframes"
                }
                paragraph pwf1 { content = "Reusable UI widget shapes built from diagram primitives. Each widget is a schema with a template that returns shape primitives — no SVG hardcoding." }
            }
        }

        // --- Widget showcase: device and application frames ---
        vsplit v_wf2 {
            split s_wf2 {
                size = 100

                heading hwf2 {
                    level = 2
                    content = "Device and Application Frames"
                }
                paragraph pwf2 { content = "Use frame widgets such as <code>phone</code>, <code>tablet</code>, <code>window</code>, and <code>browser</code> for wireframes. They accept " + bold("title") + " and color attributes; browser frames also accept " + bold("url") + "." }

                diagram device_frames {
                    width = 750
                    height = 340

                    phone phone1 {
                        x = 20
                        y = 10
                        width = 160
                        height = 300
                        title = "My App"
                    }

                    tablet tablet1 {
                        x = 200
                        y = 10
                        width = 250
                        height = 180
                        title = "Planner"
                        header_fill = color_nav_bg
                    }

                    window window1 {
                        x = 480
                        y = 10
                        width = 250
                        height = 140
                        title = "Preferences"
                    }

                    browser browser1 {
                        x = 200
                        y = 210
                        width = 250
                        height = 120
                        title = "Dashboard"
                        url = "https://app.example.com"
                    }

                    browser browser2 {
                        x = 480
                        y = 170
                        width = 250
                        height = 160
                        title = "Docs"
                        url = "https://docs.example.com"
                    }
                }
            }
        }

        // --- Buttons and inputs ---
        vsplit v_wf3 {
            split s_wf3 {
                size = 100

                heading hwf3 {
                    level = 2
                    content = "Buttons, Inputs, and Controls"
                }

                diagram controls {
                    width = 700
                    height = 220

                    // Button variants
                    button btn1 {
                        x = 20
                        y = 20
                        width = 120
                        height = 38
                        label = "Primary"
                        variant = "primary"
                    }
                    button btn2 {
                        x = 150
                        y = 20
                        width = 120
                        height = 38
                        label = "Secondary"
                        variant = "secondary"
                    }
                    button btn3 {
                        x = 280
                        y = 20
                        width = 120
                        height = 38
                        label = "Outline"
                        variant = "outline"
                    }

                    // Input fields
                    input inp1 {
                        x = 20
                        y = 80
                        width = 200
                        height = 55
                        label = "Email"
                        placeholder = "you@example.com"
                    }
                    input inp2 {
                        x = 240
                        y = 80
                        width = 200
                        height = 55
                        label = "Password"
                        placeholder = "********"
                    }

                    // Toggles
                    toggle tog1 {
                        x = 20
                        y = 160
                        width = 44
                        height = 24
                        on = "true"
                    }
                    toggle tog2 {
                        x = 80
                        y = 160
                        width = 44
                        height = 24
                        on = "false"
                    }

                    // Badges
                    badge badge1 {
                        x = 150
                        y = 160
                        width = 70
                        height = 24
                        label = "Active"
                        color = color_link
                    }
                    badge badge2 {
                        x = 230
                        y = 160
                        width = 80
                        height = 24
                        label = "Warning"
                        color = "#e6a700"
                    }
                    badge badge3 {
                        x = 320
                        y = 160
                        width = 60
                        height = 24
                        label = "Error"
                        color = "#d32f2f"
                    }

                    // Avatars
                    avatar av1 {
                        x = 460
                        y = 20
                        width = 50
                        height = 50
                        initials = "AT"
                        color = color_link
                    }
                    avatar av2 {
                        x = 520
                        y = 20
                        width = 50
                        height = 50
                        initials = "BK"
                        color = "#8b5cf6"
                    }
                    avatar av3 {
                        x = 580
                        y = 20
                        width = 50
                        height = 50
                        initials = "CD"
                        color = "#059669"
                    }
                    avatar av4 {
                        x = 640
                        y = 20
                        width = 50
                        height = 50
                        initials = "EF"
                        color = "#dc2626"
                    }

                    // Navbar
                    navbar nav1 {
                        x = 460
                        y = 90
                        width = 230
                        height = 40
                        items = "Home,Projects,Settings"
                        active_index = 0
                    }
                    navbar nav2 {
                        x = 460
                        y = 140
                        width = 230
                        height = 40
                        items = "Feed,Search,Profile,More"
                        active_index = 2
                    }
                }
            }
        }

        // --- Form controls and menus ---
        vsplit v_wf_controls {
            split s_wf_controls {
                size = 100

                heading hwf_controls {
                    level = 2
                    content = "Form Controls and Menus"
                }
                paragraph pwf_controls { content = "Wireframe controls share the same widget theme attributes as buttons and inputs. Menus use normal diagram events: click a menubar, or right-click another control, to toggle a targeted menu state." }

                diagram form_controls {
                    width = 760
                    height = 380

                    card settings_panel {
                        x = 24
                        y = 24
                        width = 300
                        height = 320
                        title = "Preferences"

                        checkbox email_updates {
                            x = 22
                            y = 54
                            width = 180
                            height = 24
                            label = "Email updates"
                            checked = "true"
                        }

                        checkbox beta_access {
                            x = 22
                            y = 86
                            width = 180
                            height = 24
                            label = "Beta access"
                            checked = "false"
                        }

                        radio plan_free {
                            x = 22
                            y = 126
                            width = 120
                            height = 24
                            label = "Free"
                        }

                        radio plan_pro {
                            x = 148
                            y = 126
                            width = 120
                            height = 24
                            label = "Pro"
                            selected = "true"
                        }

                        button_group billing_period {
                            x = 22
                            y = 168
                            width = 250
                            height = 34
                            items = "Monthly,Annual"
                            active_index = 1
                        }

                        dropdown timezone {
                            x = 22
                            y = 222
                            width = 250
                            height = 56
                            label = "Timezone"
                            value = "Australia/Brisbane"
                            items = "Australia/Brisbane,UTC,America/New_York"
                        }
                    }

                    textbox notes {
                        x = 360
                        y = 78
                        width = 180
                        height = 112
                        label = "Notes"
                        placeholder = "Add internal notes..."
                        rows = 4
                    }

                    inline_image preview {
                        x = 568
                        y = 78
                        width = 150
                        height = 112
                        caption = "Image placeholder"
                    }

                    menubar top_menu {
                        x = 360
                        y = 24
                        width = 358
                        height = 34
                        menu_targets = "file_menu,edit_menu,view_menu"
                        active_index = 0

                        menu_item file_item { label = "File" target = "file_menu" }
                        menu_item edit_item { label = "Edit" target = "edit_menu" }
                        menu_item view_item { label = "View" target = "view_menu" }
                        menu_item help_item { label = "Help" disabled = "true" }
                    }

                    button target_button {
                        x = 360
                        y = 226
                        width = 180
                        height = 38
                        label = "Right click me"
                        variant = "secondary"

                        event open_context_menu {
                            trigger = "right_click"
                            target = "row_menu"
                            state = "shown"
                            mode = "toggle"
                        }
                    }

                    context_menu file_menu {
                        x = 360
                        y = 62
                        width = 150
                        close_targets = "export_menu"
                        class = "wf_popup_menu"

                        menu_item new_item { label = "New" }
                        menu_item open_item { label = "Open" }
                        menu_item save_item { label = "Save" disabled = "true" }
                        menu_item export_item {
                            label = "Export"
                            target = "export_menu"
                            close_targets = "export_menu"
                        }
                    }

                    context_menu edit_menu {
                        x = 450
                        y = 62
                        width = 150
                        items = "Undo,Redo,Cut,Copy"
                        disabled_items = "Redo"
                        class = "wf_popup_menu"
                    }

                    context_menu view_menu {
                        x = 540
                        y = 62
                        width = 150
                        items = "Zoom in,Zoom out,Reset"
                        class = "wf_popup_menu"
                    }

                    context_menu export_menu {
                        x = 512
                        y = 146
                        width = 150
                        items = "PDF,PNG,HTML"
                        class = "wf_popup_menu"
                    }

                    context_menu row_menu {
                        x = 560
                        y = 214
                        width = 160
                        items = "Open details,Duplicate,Delete"
                        class = "wf_popup_menu"
                    }
                }
            }
        }

        // --- Data table widget ---
        vsplit v_wf_datatable {
            split s_wf_datatable {
                size = 100

                heading hwf_datatable {
                    level = 2
                    content = "Data Tables"
                }
                paragraph pwf_datatable { content = "The <code>datatable</code> widget can render compact WCL row data or rich row blocks whose cells contain WDoc text and other wireframe controls." }

                diagram datatable_demo {
                    width = 760
                    height = 320

                    datatable team_table {
                        x = 24
                        y = 24
                        width = 520

                        datatable_column name_col {
                            key = "name"
                            label = "Name"
                            width = 180
                        }
                        datatable_column status_col {
                            key = "status"
                            label = "Status"
                            width = 130
                        }
                        datatable_column action_col {
                            key = "action"
                            label = ""
                            width = 110
                        }

                        datatable_row ada {
                            datatable_cell name {
                                content = "**Ada Lovelace**"
                            }
                            datatable_cell status {
                                badge active {
                                    label = "Active"
                                    color = "green"
                                }
                            }
                            datatable_cell action {
                                button edit {
                                    width = 78
                                    height = 26
                                    label = "Edit"
                                    variant = "secondary"
                                }
                            }
                        }

                        datatable_row lin {
                            datatable_cell name {
                                content = "Lin Chen"
                            }
                            datatable_cell status {
                                badge pending {
                                    label = "Pending"
                                    color = "amber"
                                }
                            }
                            datatable_cell action {
                                button review {
                                    width = 78
                                    height = 26
                                    label = "Review"
                                }
                            }
                        }
                    }

                    datatable compact_table {
                        x = 24
                        y = 176
                        width = 520
                        row_height = 34
                        columns = "Route,Method,State"
                        rows = [
                            { Route = "/api/users", Method = "GET", State = "cached" },
                            { Route = "/api/invite", Method = "POST", State = "queued" }
                        ]
                    }
                }
            }
        }

        // --- Cards with content ---
        vsplit v_wf4 {
            split s_wf4 {
                size = 100

                heading hwf4 {
                    level = 2
                    content = "Cards and Composition"
                }
                paragraph pwf4 { content = "Widgets can contain additional shapes. The widget template provides the structure, user shapes are added on top:" }

                diagram card_demo {
                    width = 700
                    height = 250

                    profile_card card1 {
                        x = 20
                        y = 10
                        width = 200
                        height = 220
                        title = "User Profile"
                        name = "Jane Doe"
                        role = "Engineering Lead"
                        initials = "JD"
                        avatar_color = color_link
                        status_label = "Available"
                        status_color = "#059669"
                    }

                    stat_card card2 {
                        x = 240
                        y = 10
                        width = 200
                        height = 220
                        title = "Statistics"
                        value = "$284K"
                        caption = "12.8K active users"
                        badge_label = "+12.5%"
                        badge_color = "#059669"
                    }

                    action_panel card3 {
                        x = 460
                        y = 10
                        width = 220
                        height = 220
                        title = "Quick Actions"
                        primary_label = "New Project"
                        primary_variant = "primary"
                        secondary_label = "Invite Member"
                        secondary_variant = "secondary"
                        tertiary_label = "View Reports"
                        tertiary_variant = "outline"
                    }
                }
            }
        }

        // --- Collapsible panels ---
        vsplit v_wf_collapsible {
            split s_wf_collapsible {
                size = 100

                heading hwf_collapsible {
                    level = 2
                    content = "Collapsible Panels"
                }
                paragraph pwf_collapsible { content = "Click a panel header to collapse or expand its controls. Panels with the same <code>collapse_group</code> behave like an accordion, so opening one collapses the others in the group." }

                diagram collapsible_panels {
                    width = 760
                    height = 270

                    collapsible_panel filters {
                        x = 20
                        y = 20
                        width = 220
                        height = 220
                        title = "Filters"
                        collapse_group = "search"
                        align = "stack"
                        gap = 10
                        padding = 14

                        input query {
                            height = 52
                            label = "Query"
                            placeholder = "Search"
                        }
                        checkbox active_only {
                            height = 28
                            label = "Active only"
                            checked = "true"
                        }
                        dropdown status {
                            height = 38
                            placeholder = "Status"
                            value = "Open"
                            items = "Open,Closed,Paused"
                        }
                        button apply_filters {
                            height = 34
                            label = "Apply"
                            variant = "primary"
                        }
                    }

                    collapsible_panel details {
                        x = 270
                        y = 20
                        width = 220
                        height = 220
                        title = "Details"
                        collapse_group = "search"
                        collapsed = true
                        align = "stack"
                        gap = 10
                        padding = 14

                        input owner {
                            height = 52
                            label = "Owner"
                            placeholder = "Team"
                        }
                        checkbox archived {
                            height = 28
                            label = "Include archived"
                        }
                        button export_details {
                            height = 34
                            label = "Export"
                            variant = "outline"
                        }
                    }

                    collapsible_panel standalone {
                        x = 520
                        y = 20
                        width = 220
                        height = 150
                        title = "Standalone"
                        align = "stack"
                        gap = 10
                        padding = 14

                        textbox note {
                            height = 70
                            placeholder = "Panel notes"
                            rows = 3
                        }
                    }
                }
            }
        }

        // --- Login form using widgets ---
        vsplit v_wf5 {
            split s_wf5 {
                size = 100

                heading hwf5 {
                    level = 2
                    content = "Login Form (composed from widgets)"
                }

                diagram login {
                    width = 400
                    height = 380

                    card form {
                        x = 20
                        y = 10
                        width = 360
                        height = 360

                        avatar logo {
                            x = 145
                            y = 15
                            width = 50
                            height = 50
                            initials = "W"
                            color = color_link
                        }

                        text title {
                            x = 30
                            y = 75
                            width = 300
                            height = 25
                            content = "Welcome back"
                            font_size = 20
                        }

                        input email {
                            x = 30
                            y = 115
                            width = 300
                            height = 55
                            label = "Email"
                            placeholder = "you@example.com"
                        }

                        input password {
                            x = 30
                            y = 185
                            width = 300
                            height = 55
                            label = "Password"
                            placeholder = "********"
                        }

                        button signin {
                            x = 30
                            y = 260
                            width = 300
                            height = 40
                            label = "Sign In"
                            variant = "primary"
                        }

                        button github {
                            x = 30
                            y = 315
                            width = 142
                            height = 35
                            label = "GitHub"
                            variant = "outline"
                        }
                        button google {
                            x = 188
                            y = 315
                            width = 142
                            height = 35
                            label = "Google"
                            variant = "outline"
                        }
                    }
                }
            }
        }

        // --- Layout-aware UI mocks ---
        vsplit v_wf_layout_intro {
            split s_wf_layout_intro {
                size = 100

                heading hwf_layout_intro {
                    level = 2
                    content = "Layout-aware UI mockups"
                }
                paragraph pwf_layout_intro { content = "Container widgets can now use " + bold("stack") + ", " + bold("grid") + ", " + bold("flow") + ", and edge anchors for child controls. Omit <code>x</code>/<code>y</code> when a child should be placed by layout; add absolute coordinates or anchors when a control needs to be pinned." }
            }
        }

        // --- Stack layout inside a card and phone ---
        vsplit v_wf_stack {
            split s_wf_stack {
                size = 100

                heading hwf_stack {
                    level = 3
                    content = "Stack layout: forms and settings"
                }

                diagram stack_ui {
                    width = 760
                    height = 390

                    card account_form {
                        x = 20
                        y = 20
                        width = 330
                        height = 340
                        title = "Account"
                        align = "stack"
                        gap = 12
                        padding = 18

                        input name {
                            height = 55
                            label = "Name"
                            placeholder = "Jane Doe"
                        }
                        input email {
                            height = 55
                            label = "Email"
                            placeholder = "jane@example.com"
                        }
                        input team {
                            height = 55
                            label = "Team"
                            placeholder = "Platform"
                        }
                        group actions {
                            left = 18
                            right = 18
                            bottom = 18
                            height = 40
                            align = "grid"
                            columns = 2
                            gap = 24

                            button cancel {
                                width = 120
                                height = 40
                                label = "Cancel"
                                variant = "outline"
                            }
                            button save {
                                width = 120
                                height = 40
                                label = "Save"
                                variant = "primary"
                            }
                        }
                    }

                    phone settings_screen {
                        x = 390
                        y = 20
                        width = 240
                        height = 340
                        title = "Settings"
                        align = "stack"
                        gap = 12
                        padding = 16

                        group notification_row {
                            width = 208
                            height = 48
                            list_item notification_text {
                                x = 0
                                y = 0
                                width = 152
                                height = 48
                                label = "Notifications"
                                description = "Push and email alerts"
                            }
                            toggle notifications {
                                x = 164
                                y = 12
                                width = 44
                                height = 24
                                on = "true"
                            }
                        }
                        button profile {
                            height = 34
                            label = "Profile"
                            variant = "secondary"
                        }
                        button billing {
                            height = 34
                            label = "Billing"
                            variant = "secondary"
                        }
                        button logout {
                            height = 34
                            label = "Log out"
                            variant = "outline"
                        }
                    }
                }
            }
        }

        // --- Grid layout for dashboard tiles ---
        vsplit v_wf_grid {
            split s_wf_grid {
                size = 100

                heading hwf_grid {
                    level = 3
                    content = "Grid layout: dashboard tiles"
                }
                paragraph pwf_grid { content = "Grid places only unpositioned children. The help button in the dashboard below is anchored to the card edge and is not moved by the grid." }

                diagram dashboard_grid {
                    width = 760
                    height = 360

                    browser dashboard {
                        x = 20
                        y = 20
                        width = 700
                        height = 310
                        title = "Dashboard"
                        url = "https://app.example.com"
                        align = "grid"
                        columns = 3
                        gap = 16
                        padding = 18

                        stat_card stat_revenue {
                            width = 170
                            height = 90
                            title = "Revenue"
                            value = "$284K"
                            caption = "This month"
                        }
                        stat_card stat_users {
                            width = 170
                            height = 90
                            title = "Users"
                            value = "12,847"
                            caption = "Active"
                        }
                        stat_card stat_uptime {
                            width = 170
                            height = 90
                            title = "Uptime"
                            value = "99.9%"
                            caption = "30 days"
                        }
                        stat_card stat_tasks {
                            width = 170
                            height = 90
                            title = "Tasks"
                            value = "42"
                            caption = "Open"
                        }
                        stat_card stat_errors {
                            width = 170
                            height = 90
                            title = "Errors"
                            value = "3"
                            caption = "Needs review"
                        }
                        button help {
                            right = 18
                            bottom = 18
                            width = 92
                            height = 34
                            label = "Help"
                            variant = "outline"
                        }
                    }
                }
            }
        }

        // --- Flow layout for tags and actions ---
        vsplit v_wf_flow {
            split s_wf_flow {
                size = 100

                heading hwf_flow {
                    level = 3
                    content = "Flow layout: chips and action rows"
                }

                diagram flow_ui {
                    width = 760
                    height = 260

                    card filters {
                        x = 20
                        y = 20
                        width = 700
                        height = 200
                        title = "Filters"
                        align = "flow"
                        gap = 10
                        padding = 18

                        badge all {
                            width = 64
                            height = 26
                            label = "All"
                            color = color_link
                        }
                        badge active {
                            width = 86
                            height = 26
                            label = "Active"
                            color = color_success
                        }
                        badge blocked {
                            width = 92
                            height = 26
                            label = "Blocked"
                            color = color_danger
                        }
                        badge pending {
                            width = 94
                            height = 26
                            label = "Pending"
                            color = "#e6a700"
                        }
                        button export_btn {
                            width = 104
                            height = 34
                            label = "Export"
                            variant = "secondary"
                        }
                        button invite {
                            width = 116
                            height = 34
                            label = "Invite"
                            variant = "primary"
                        }
                    }
                }
            }
        }

        // --- Anchored and mixed placement ---
        vsplit v_wf_anchor {
            split s_wf_anchor {
                size = 100

                heading hwf_anchor {
                    level = 3
                    content = "Anchored and mixed placement"
                }
                paragraph pwf_anchor { content = "Anchors are useful for sticky bars and floating controls. The cards are stacked automatically, while the footer actions and notification badge are pinned." }

                diagram anchored_ui {
                    width = 760
                    height = 360

                    card panel {
                        x = 20
                        y = 20
                        width = 330
                        height = 300
                        title = "Project"
                        align = "stack"
                        gap = 12
                        padding = 18

                        badge status {
                            right = 18
                            top = 42
                            width = 86
                            height = 24
                            label = "Live"
                            color = color_success
                        }
                        input project_title {
                            width = 180
                            height = 55
                            label = "Title"
                            placeholder = "Launch plan"
                        }
                        input owner {
                            height = 55
                            label = "Owner"
                            placeholder = "Alex"
                        }
                        group actions {
                            left = 18
                            right = 18
                            bottom = 18
                            height = 38
                            align = "grid"
                            columns = 2
                            gap = 24

                            button cancel {
                                width = 120
                                height = 38
                                label = "Cancel"
                                variant = "outline"
                            }
                            button save {
                                width = 120
                                height = 38
                                label = "Save"
                                variant = "primary"
                            }
                        }
                    }

                    browser report {
                        x = 390
                        y = 20
                        width = 330
                        height = 300
                        title = "Report"
                        url = "app.example.com/report"
                        align = "stack"
                        gap = 10
                        padding = 16

                        list_item summary {
                            height = 54
                            label = "Summary"
                            description = "Current report snapshot"
                            trailing = "Open"
                        }
                        list_item activity {
                            height = 54
                            label = "Activity"
                            description = "Latest report events"
                            trailing = "12"
                        }
                        navbar footer {
                            left = 16
                            right = 16
                            bottom = 16
                            height = 40
                            items = "Home,Reports,Settings"
                            active_index = 1
                        }
                    }
                }
            }
        }

        // --- Clickable interactive diagram ---
        vsplit v_wf6 {
            split s_wf6 {
                size = 100

                heading hwf6 {
                    level = 2
                    content = "Interactive Clickable Diagram"
                }
                paragraph pwf6 { content = "Shapes with an " + bold("href") + " attribute become clickable links. Click the screens below to navigate:" }

                diagram clickable_screens {
                    width = 750
                    height = 380

                    phone screen_overview {
                        x = 20
                        y = 30
                        width = 200
                        height = 300
                        title = "Overview"
                        href = "overview.html"
                    }

                    phone screen_install {
                        x = 240
                        y = 30
                        width = 200
                        height = 300
                        title = "Install"
                        href = "install.html"
                    }

                    browser screen_basics {
                        x = 470
                        y = 30
                        width = 260
                        height = 160
                        title = "Basics"
                        url = "Language Basics"
                        href = "basics.html"
                    }

                    browser screen_advanced {
                        x = 470
                        y = 210
                        width = 260
                        height = 120
                        title = "Advanced"
                        url = "Advanced Features"
                        href = "advanced.html"
                    }

                    connection nav1 {
                        from = "screen_overview"
                        to = "screen_install"
                        direction = "to"
                        from_anchor = "right"
                        to_anchor = "left"
                        stroke = color_link
                        stroke_width = 2
                        label = "next"
                    }

                    connection nav2 {
                        from = "screen_install"
                        to = "screen_basics"
                        direction = "to"
                        from_anchor = "right"
                        to_anchor = "left"
                        stroke = color_link
                        stroke_width = 2
                        label = "next"
                    }
                }

                paragraph pwf6b { content = "Internal page links also work in text: " + link("Go to Overview", "overview.html") + " | " + link("Installation", "install.html#installation") + " | " + link("Schemas section", "basics.html#schemas-and-validation") }
            }
        }
    }
}
