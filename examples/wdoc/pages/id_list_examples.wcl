import "./shared.wcl"
use wdoc::{bold}

person ada-lovelace {
    name = "Ada Lovelace"
    role = "Systems Designer"
    accent = "#58a6ff"
}

person grace-hopper {
    name = "Grace Hopper"
    role = "Compiler Engineer"
    accent = "#3fb950"
}

person alan-turing {
    name = "Alan Turing"
    role = "Protocol Analyst"
    accent = "#d29922"
}

team runtime {
    name = "Runtime Team"
    member_ids = [ada-lovelace, grace-hopper]
}

page id_list_examples {
    section = ref("my_docs.guide.id_list_examples")
    title = "ID List References"
    let runtime_members = filter(
        (..person),
        person => some(runtime.member_ids, id => person.id == id)
    )

    layout {
        vsplit intro {
            split body {
                size = 100

                heading h1 {
                    level = 1
                    content = "ID List References"
                }

                paragraph p1 {
                    content = "Blocks can carry lists of identifiers that point at other blocks. The referenced blocks can then be selected by comparing each block's " + bold("id") + " with the identifiers in the list."
                }

                code source {
                    language = "wcl"
                    content = "person ada-lovelace {\n    name = \"Ada Lovelace\"\n    role = \"Systems Designer\"\n}\n\nperson grace-hopper {\n    name = \"Grace Hopper\"\n    role = \"Compiler Engineer\"\n}\n\nperson alan-turing {\n    name = \"Alan Turing\"\n    role = \"Protocol Analyst\"\n}\n\nteam runtime {\n    name = \"Runtime Team\"\n    member_ids = [ada-lovelace, grace-hopper]\n}\n\nlet runtime_members = filter(\n    (..person),\n    person => some(runtime.member_ids, id => person.id == id)\n)"
                }
            }
        }

        vsplit rendered {
            split summary {
                size = 42

                heading h2 {
                    level = 2
                    content = runtime.name
                }

                paragraph p2 {
                    content = "The team block references " + bold(join(", ", map(runtime.member_ids, id => to_string(id)))) + ". The list is made of identifier values, not strings, and each value is compared directly against a person block ID."
                }
            }

            split members {
                size = 58

                diagram selected_members {
                    width = 620
                    height = 210

                    rect panel {
                        x = 20
                        y = 20
                        width = 580
                        height = 170
                        rx = 8
                        fill = color_nav_bg
                        stroke = color_nav_border
                        stroke_width = 1.5
                    }

                    for member, idx in runtime_members {
                        rect card-${member.id} {
                            x = 42 + idx * 270
                            y = 52
                            width = 235
                            height = 106
                            rx = 7
                            fill = color_code_bg
                            stroke = member.accent
                            stroke_width = 2
                        }

                        circle avatar-${member.id} {
                            x = 66 + idx * 270
                            y = 74
                            r = 21
                            fill = member.accent
                            stroke = "none"
                        }

                        text initials-${member.id} {
                            x = 45 + idx * 270
                            y = 62
                            width = 42
                            height = 42
                            content = upper(substr(member.name, 0, 1))
                            font_size = 18
                            font_weight = "700"
                            fill = color_on_accent
                        }

                        text name-${member.id} {
                            x = 105 + idx * 270
                            y = 62
                            width = 145
                            height = 24
                            content = member.name
                            font_size = 14
                            font_weight = "700"
                            fill = color_text
                        }

                        text role-${member.id} {
                            x = 105 + idx * 270
                            y = 90
                            width = 145
                            height = 24
                            content = member.role
                            font_size = 12
                            fill = "#8b949e"
                        }
                    }
                }
            }
        }
    }
}
