import "./shared.wcl"

// ── Flowchart Shapes page ──

page flowchart_examples {
    section = "my_docs.diagrams.flowchart_examples"
    title = "Flowchart Shapes"

    layout {
        vsplit v_fc1 {
            split s_fc1 {
                size = 100

                heading hfc1 {
                    level = 1
                    content = "Flowchart Shapes"
                }
                paragraph pfc1 { content = "Flowchart nodes auto-size from their labels when width and height are omitted. Long labels wrap on spaces before the layered layout runs:" }

                diagram flowchart_demo {
                    width = 700
                    height = 500
                    align = "layered"
                    gap = 40

                    flow_terminal start {
                        label = "Start"
                    }

                    flow_io input_data {
                        label = "Read Input"
                    }

                    flow_process validate {
                        label = "Validate incoming customer data"
                        max_width = 165
                    }

                    flow_decision is_valid {
                        label = "Valid payload?"
                    }

                    flow_subprocess process_data {
                        label = "Process accepted data"
                        max_width = 170
                    }

                    flow_process log_error {
                        label = "Log Error"
                        color = "#d32f2f"
                    }

                    flow_io write_output {
                        label = "Write Output"
                    }

                    flow_terminal done {
                        label = "End"
                        color = "#28a745"
                    }

                    connection fc1 { from = "start"
                        to = "input_data"
                        direction = "to"
                        stroke = color_text
                        stroke_width = 2 }
                    connection fc2 { from = "input_data"
                        to = "validate"
                        direction = "to"
                        stroke = color_text
                        stroke_width = 2 }
                    connection fc3 { from = "validate"
                        to = "is_valid"
                        direction = "to"
                        stroke = color_text
                        stroke_width = 2 }
                    connection fc4 { from = "is_valid"
                        to = "process_data"
                        direction = "to"
                        stroke = color_text
                        stroke_width = 2
                        label = "Yes" }
                    connection fc5 { from = "is_valid"
                        to = "log_error"
                        direction = "to"
                        stroke = "#d32f2f"
                        stroke_width = 2
                        label = "No" }
                    connection fc6 { from = "process_data"
                        to = "write_output"
                        direction = "to"
                        stroke = color_text
                        stroke_width = 2 }
                    connection fc7 { from = "write_output"
                        to = "done"
                        direction = "to"
                        stroke = color_text
                        stroke_width = 2 }
                    connection fc8 { from = "log_error"
                        to = "done"
                        direction = "to"
                        stroke = "#d32f2f"
                        stroke_width = 1
                        stroke_dasharray = "5,3" }
                }
            }
        }

        vsplit v_fc_nested {
            split s_fc_nested {
                size = 100

                heading hfc_nested {
                    level = 2
                    content = "Nested flowcharts"
                }
                paragraph pfc_nested {
                    content = "Use " + bold("flowchart") + " as a lightweight container when a flowchart step needs its own internal flow. It defaults to layered layout and supports dotted connection targets."
                }

                diagram nested_flowchart_demo {
                    width = 760
                    height = 360
                    align = "layered"
                    gap = 52

                    flow_terminal request {
                        width = 130
                        height = 40
                        label = "Request"
                    }

                    flowchart auth_flow {
                        width = 320
                        height = 240
                        label = "Auth flow"
                        border_stroke = color_link

                        flow_terminal auth_start {
                            width = 120
                            height = 38
                            label = "Token"
                        }

                        flow_process validate_token {
                            width = 150
                            height = 48
                            label = "Validate"
                        }

                        flow_decision accepted {
                            width = 105
                            height = 76
                            label = "OK?"
                        }

                        flow_terminal auth_done {
                            width = 120
                            height = 38
                            label = "Allow"
                            color = color_success
                        }

                        connection auth1 {
                            from = "auth_start"
                            to = "validate_token"
                            direction = "to"
                            stroke = color_text
                        }
                        connection auth2 {
                            from = "validate_token"
                            to = "accepted"
                            direction = "to"
                            stroke = color_text
                        }
                        connection auth3 {
                            from = "accepted"
                            to = "auth_done"
                            direction = "to"
                            stroke = color_success
                            label = "yes"
                        }
                    }

                    flow_process route {
                        width = 150
                        height = 50
                        label = "Route"
                    }

                    flow_terminal response {
                        width = 130
                        height = 40
                        label = "Response"
                        color = color_success
                    }

                    connection request_to_auth {
                        from = "request"
                        to = "auth_flow.auth_start"
                        direction = "to"
                        stroke = color_text
                        stroke_width = 2
                    }
                    connection auth_to_route {
                        from = "auth_flow.auth_done"
                        to = "route"
                        direction = "to"
                        stroke = color_text
                        stroke_width = 2
                    }
                    connection route_to_response {
                        from = "route"
                        to = "response"
                        direction = "to"
                        stroke = color_text
                        stroke_width = 2
                    }
                }
            }
        }
    }
}
