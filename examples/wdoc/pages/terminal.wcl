// Terminal demo page for the wdoc example site. Shows the three ways
// to drive a `terminal` (authored primitives, inline text, asciinema
// replay) and how the WCL `class` system themes terminal colours.
// Glyphs below come from the bundled JetBrains Mono Nerd Font.

// A terminal colour theme: `background` is the window colour and
// `color` is the default text colour. dark/light modes ride along with
// the rest of the class system.
class "term-mocha" {
  background = "#1e1e2e"
  color      = "#cdd6f4"
  light { background = "#eff1f5"  color = "#4c4f69" }
}

// A custom TUI control, built by extending the `TermPrimitive` base — a
// keycap pill that lowers to styled text: a coloured background run
// (spaces) with the key label on top, both via the shared `term_run` /
// `term_repeat` helpers. Any `@block … extends TermPrimitive` whose `lower`
// returns `list<TermFundamental>` plugs into the renderer like the
// built-in controls.
@block("kbd")
type Kbd extends TermPrimitive {
  @inline(0) key: utf8
  accent: utf8?
  row: i64  col: i64
  lower = fn(k: Kbd) -> list<TermFundamental> {
    let acc = if k.accent == none { "magenta" } else { k.accent };
    let w = len(k.key) + 2;
    [
      term_run(term_repeat(" ", w), 1, 1, none, acc, none),
      term_run(k.key, 1, 2, "bright_white", acc, true),
    ]
  }
}

page terminal { sites = [:showcase]
  h1 "Terminals"

  text {
    span "wdoc renders terminals as a true character grid in inline SVG, drawn with an embedded Nerd Font. Colours come from the WCL "
    span "`class`"
    span " system; build them from primitives, inline text, or an asciinema replay."
  }

  h2 "Authored with primitives"
  text { span "Boxes, text, glyphs, and fills placed at 1-based (row, col), with the full range of terminal colours and styles. This terminal is themed by the `term-mocha` class." {} }

  terminal {
    class = ["term-mocha"]
    cols = 58 rows = 13 title = "primitives"
    term_text "Colours" { row = 1 col = 2 bold = true underline = true }
    term_text "red" { row = 2 col = 2 fg = "red" }
    term_text "green" { row = 2 col = 8 fg = "green" }
    term_text "yellow" { row = 2 col = 16 fg = "yellow" }
    term_text "blue" { row = 2 col = 25 fg = "blue" }
    term_text "256:208" { row = 2 col = 32 fg = "208" }
    term_text "#ff5fd2" { row = 2 col = 42 fg = "#ff5fd2" }

    term_text "Styles" { row = 4 col = 2 bold = true underline = true }
    term_text "bold" { row = 5 col = 2 bold = true }
    term_text "italic" { row = 5 col = 8 italic = true }
    term_text "underline" { row = 5 col = 16 underline = true }
    term_text "strike" { row = 5 col = 27 strike = true }
    term_text "inverse" { row = 5 col = 35 inverse = true }
    term_text "dim" { row = 5 col = 44 dim = true }

    term_text "Nerd Font glyphs" { row = 7 col = 2 bold = true underline = true }
    term_glyph "" { row = 8 col = 2 fg = "blue" }
    term_text "src" { row = 8 col = 4 fg = "bright_blue" bold = true }
    term_glyph "" { row = 8 col = 10 fg = "yellow" }
    term_text "main.rs" { row = 8 col = 12 }
    term_glyph "" { row = 8 col = 21 fg = "green" }
    term_glyph "" { row = 8 col = 24 fg = "bright_yellow" }
    term_glyph "" { row = 8 col = 27 fg = "magenta" }

    term_box { row = 10 col = 2 width = 44 height = 3 border = :rounded fg = "cyan" title = "progress" }
    term_fill "█" { row = 11 col = 4 width = 28 height = 1 fg = "green" }
    term_fill "░" { row = 11 col = 32 width = 12 height = 1 fg = "bright_black" }
    term_text "71%" { row = 11 col = 46 bold = true }
  }

  h2 "TUI widgets"
  text { span "Single-line, colour-forward controls — progress bars, buttons, spinners, inputs, dropdowns, checkboxes, radios — that lower to the same primitives. Colour carries the meaning; accents follow the `term-mocha` theme." {} }

  terminal {
    class = ["term-mocha"]
    cols = 56 rows = 16 title = "controls"
    term_text "Progress" { row = 1 col = 2 bold = true underline = true }
    tui_progress "Upload" { row = 2 col = 2 value = 78 }
    tui_progress "Sync"   { row = 3 col = 2 value = 40 accent = "cyan" }

    term_text "Buttons" { row = 5 col = 2 bold = true underline = true }
    tui_button "Save"    { row = 6 col = 2 accent = "green" }
    tui_button "Discard" { row = 6 col = 11 accent = "red" }
    tui_button "Help"    { row = 6 col = 23 }

    term_text "Fields" { row = 8 col = 2 bold = true underline = true }
    tui_spinner "Building…" { row = 9 col = 2 frame = 4 }
    tui_input "Search projects" { row = 10 col = 2 focused = true }
    tui_input "Name" { row = 11 col = 2 value = "Ada Lovelace" }
    tui_dropdown "Release build" { row = 12 col = 2 }

    term_text "Choices" { row = 14 col = 2 bold = true underline = true }
    tui_checkbox "Telemetry" { row = 15 col = 2 checked = true }
    tui_radio "Dark"   { row = 15 col = 18 selected = true }
    tui_radio "Light"  { row = 15 col = 28 }
    kbd "Ctrl" { row = 15 col = 40 }
    kbd "K"    { row = 15 col = 47 accent = "blue" }
  }

  h3 "Containers"
  text { span "A `tui_panel` (or borderless `tui_group`) nests other controls; children carry positions relative to the container, and a `tui_group` inside a `tui_panel` shows the offset compounding." {} }

  terminal {
    class = ["term-mocha"]
    cols = 40 rows = 11 title = "settings"
    tui_panel "Preferences" { row = 1 col = 2 width = 34 height = 9 border = :rounded
      tui_checkbox "Wi-Fi"     { row = 1 col = 1 checked = true }
      tui_checkbox "Bluetooth" { row = 2 col = 1 }
      tui_group "Theme" { row = 3 col = 1
        tui_radio "Dark"  { row = 1 col = 1 selected = true }
        tui_radio "Light" { row = 1 col = 11 }
      }
      tui_progress "Cache" { row = 6 col = 1 value = 55 width = 18 accent = "cyan" }
      tui_button "Apply" { row = 7 col = 1 accent = "green" }
    }
  }

  h2 "Inline content"
  text { span "An inline text field is laid out by a virtual terminal. This one overrides the colours directly with the `bg`/`fg` fields instead of a class." {} }

  terminal {
    cols = 40 rows = 4 chrome = true title = "notes.txt"
    bg = "#fbf1c7" fg = "#3c3836"
    text = "  WCL terminals\n  ===============\n  * true character grid\n  * themed by class or fields"
  }

  h2 "Asciinema replay"
  text { span "Point source at a .cast recording, then click the big play button to run it. Play / pause / replay also live in the title bar." {} }

  terminal {
    class = ["term-mocha"]
    source = "./casts/demo.cast"
    title = "cargo test session"
  }
}
