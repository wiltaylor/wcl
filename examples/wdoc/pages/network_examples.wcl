import "./shared.wcl"

// ── Network Diagrams page ──

page network_examples {
    section = "my_docs.diagrams.network_examples"
    title = "Network Diagrams"

    layout {
        vsplit v_net1 {
            split s_net1 {
                size = 100

                heading hnet1 {
                    level = 1
                    content = "Network Diagrams"
                }
                paragraph pnet1 { content = "Infrastructure shapes for servers, databases, cloud services, and users:" }

                diagram network_arch {
                    width = 750
                    height = 450

                    user users {
                        x = 20
                        y = 150
                        width = 80
                        height = 100
                        label = "Users"
                    }

                    cloud cdn {
                        x = 150
                        y = 30
                        width = 140
                        height = 100
                        label = "CDN"
                    }

                    server lb {
                        x = 160
                        y = 170
                        width = 90
                        height = 110
                        label = "Load Balancer"
                    }

                    server web1 {
                        x = 320
                        y = 50
                        width = 90
                        height = 110
                        label = "Web 1"
                    }

                    server web2 {
                        x = 320
                        y = 200
                        width = 90
                        height = 110
                        label = "Web 2"
                    }

                    server api_srv {
                        x = 320
                        y = 340
                        width = 90
                        height = 110
                        label = "API"
                    }

                    database primary_db {
                        x = 500
                        y = 50
                        width = 100
                        height = 120
                        label = "Primary DB"
                    }

                    database replica_db {
                        x = 500
                        y = 210
                        width = 100
                        height = 120
                        label = "Replica DB"
                    }

                    server cache_srv {
                        x = 500
                        y = 360
                        width = 90
                        height = 90
                        label = "Redis"
                    }

                    cloud storage {
                        x = 640
                        y = 100
                        width = 100
                        height = 80
                        label = "S3"
                    }

                    cloud monitoring {
                        x = 640
                        y = 240
                        width = 100
                        height = 80
                        label = "Monitoring"
                    }

                    // User connections
                    connection nc1 { from = "users"
                        to = "cdn"
                        direction = "to"
                        stroke = color_text
                        label = "static" }
                    connection nc2 { from = "users"
                        to = "lb"
                        direction = "to"
                        stroke = color_text
                        stroke_width = 2
                        label = "HTTPS" }

                    // LB → servers
                    connection nc3 { from = "lb"
                        to = "web1"
                        direction = "to"
                        stroke = color_text }
                    connection nc4 { from = "lb"
                        to = "web2"
                        direction = "to"
                        stroke = color_text }
                    connection nc5 { from = "lb"
                        to = "api_srv"
                        direction = "to"
                        stroke = color_text }

                    // Servers → data
                    connection nc6 { from = "web1"
                        to = "primary_db"
                        direction = "both"
                        stroke = color_text }
                    connection nc7 { from = "web2"
                        to = "replica_db"
                        direction = "to"
                        stroke = color_text
                        stroke_dasharray = "4,3" }
                    connection nc8 { from = "api_srv"
                        to = "cache_srv"
                        direction = "both"
                        stroke = color_text }
                    connection nc9 { from = "api_srv"
                        to = "primary_db"
                        direction = "both"
                        stroke = color_text }

                    // DB replication
                    connection nc10 { from = "primary_db"
                        to = "replica_db"
                        direction = "to"
                        stroke = color_text
                        stroke_dasharray = "5,3"
                        label = "replicate" }

                    // Cloud services
                    connection nc11 { from = "web1"
                        to = "storage"
                        direction = "to"
                        stroke = color_text
                        stroke_dasharray = "4,3" }
                    connection nc12 { from = "web2"
                        to = "monitoring"
                        direction = "to"
                        stroke = color_text
                        stroke_dasharray = "4,3" }
                }
            }
        }
    }
}
