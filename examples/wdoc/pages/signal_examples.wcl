import "./shared.wcl"

// ── Signal Examples page ──

page signal_examples {
    section = "my_docs.diagrams.signal_examples"
    title = "Signals and Bindings"

    signal progress {
        initial = 140
    }

    signal notes {
        initial = "Edit this note"
    }

    signal title_text {
        initial = "Signal title"
    }

    signal enabled {
        initial = true
    }

    signal plan {
        initial = "Team"
    }

    signal environment {
        initial = "Stage"
    }

    signal camp_marker {
        initial = { x = 483 y = 341 }
    }

    signal objective_marker {
        initial = { x = 629 y = 438 }
    }

    binding progress_text {
        signal = "progress"
        target = "progress_readout"
        property = "text"
        format = "Slider value: {value}"
    }

    binding progress_meter_width {
        signal = "progress"
        target = "progress_meter"
        property = "width"
    }

    binding progress_meter_label {
        signal = "progress"
        target = "meter_label"
        property = "text"
        format = "{value}px"
    }

    binding notes_text {
        signal = "notes"
        target = "notes_readout"
        property = "text"
        format = "Notes signal: {value}"
    }

    binding title_text_readout {
        signal = "title_text"
        target = "title_readout"
        property = "text"
        format = "Single-line signal: {value}"
    }

    binding enabled_text_readout {
        signal = "enabled"
        target = "enabled_readout"
        property = "text"
        format = "Checkbox signal: {value}"
    }

    binding plan_text_readout {
        signal = "plan"
        target = "plan_readout"
        property = "text"
        format = "Radio signal: {value}"
    }

    binding environment_text_readout {
        signal = "environment"
        target = "environment_readout"
        property = "text"
        format = "Dropdown signal: {value}"
    }

    binding camp_marker_readout {
        signal = "camp_marker"
        target = "camp_readout"
        property = "text"
        format = "Camp marker coordinates {value}"
    }

    binding camp_icon_x {
        signal = "camp_marker"
        path = "x"
        target = "camp_drag_icon"
        property = "map_anchor_x"
    }

    binding camp_icon_y {
        signal = "camp_marker"
        path = "y"
        target = "camp_drag_icon"
        property = "map_anchor_y"
    }

    binding objective_marker_readout {
        signal = "objective_marker"
        target = "objective_readout"
        property = "text"
        format = "Objective marker coordinates {value}"
    }

    binding objective_icon_x {
        signal = "objective_marker"
        path = "x"
        target = "objective_drag_icon"
        property = "map_anchor_x"
    }

    binding objective_icon_y {
        signal = "objective_marker"
        path = "y"
        target = "objective_drag_icon"
        property = "map_anchor_y"
    }

    layout {
        vsplit signal_layout {
            split main {
                size = 100

                heading h1 {
                    level = 1
                    content = wdoc::icon("mouse-pointer") + " Signals and Bindings"
                }

                paragraph intro {
                    content = "This page declares page-scoped signals and binds them to both normal content and diagram shape properties. Change the controls to update the readouts."
                }

                paragraph progress_readout {
                    content = "Slider value: 140"
                }

                paragraph title_readout {
                    content = "Single-line signal: Signal title"
                }

                paragraph notes_readout {
                    content = "Notes signal: Edit this note"
                }

                paragraph enabled_readout {
                    content = "Checkbox signal: true"
                }

                paragraph plan_readout {
                    content = "Radio signal: Team"
                }

                paragraph environment_readout {
                    content = "Dropdown signal: Stage"
                }

                paragraph map_drag_intro {
                    content = "Drag the map icons. The icon positions are stored in signals as map coordinates, so they stay attached to the map while pan and zoom changes."
                }

                paragraph camp_readout {
                    content = "Camp marker coordinates 483, 341"
                }

                paragraph objective_readout {
                    content = "Objective marker coordinates 629, 438"
                }

                diagram map_drag_demo {
                    width = 760
                    height = 420

                    map route_map {
                        x = 30
                        y = 30
                        width = 700
                        height = 340
                        src = "images/inkscape-rpg-map.png"
                        content_width = 927
                        content_height = 704
                        view_x = 150
                        view_y = 120
                        view_width = 520
                        view_height = 252
                        min_zoom = 0.5
                        max_zoom = 6
                        background_fill = "#0f172a"
                        alt = "Draggable signal map"

                        icon camp_drag_icon {
                            x = 470
                            y = 315
                            width = 26
                            height = 26
                            name = "tent"
                            fill = "#f59e0b"
                            stroke = "#f59e0b"
                            map_fixed = true
                            map_anchor_x = 483
                            map_anchor_y = 341
                            draggable = true
                            drag_signal = "camp_marker"
                            drag_x_path = "x"
                            drag_y_path = "y"
                            cursor = "grab"
                            pointer_events = "all"
                        }

                        icon objective_drag_icon {
                            x = 615
                            y = 410
                            width = 28
                            height = 28
                            name = "flag"
                            fill = "#22c55e"
                            stroke = "#22c55e"
                            map_fixed = true
                            map_anchor_x = 629
                            map_anchor_y = 438
                            draggable = true
                            drag_signal = "objective_marker"
                            drag_x_path = "x"
                            drag_y_path = "y"
                            cursor = "grab"
                            pointer_events = "all"
                        }
                    }
                }

                diagram signal_demo {
                    width = 760
                    height = 560

                    rect meter_back {
                        x = 70
                        y = 60
                        width = 320
                        height = 34
                        rx = 8
                        fill = color_code_bg
                        stroke = color_code_border
                        stroke_width = 1
                    }

                    rect progress_meter {
                        x = 70
                        y = 60
                        width = 140
                        height = 34
                        rx = 8
                        fill = color_link
                        opacity = 0.82
                    }

                    text meter_label {
                        x = 410
                        y = 58
                        width = 110
                        height = 38
                        content = "140px"
                        font_size = 16
                        anchor = "start"
                        fill = color_text
                    }

                    slider progress_control {
                        x = 70
                        y = 145
                        width = 320
                        height = 32
                        signal = "progress"
                        min = 40
                        max = 320
                        step = 10
                        value = 140
                        fill = color_success
                        track_fill = color_nav_border
                        thumb_stroke = color_success
                    }

                    text slider_caption {
                        x = 70
                        y = 184
                        width = 320
                        height = 24
                        content = "Drag the slider"
                        font_size = 13
                        anchor = "middle"
                        fill = color_text
                        opacity = 0.72
                    }

                    textbox title_editor {
                        x = 70
                        y = 235
                        width = 360
                        height = 56
                        label = "Single-line textbox"
                        value = "Signal title"
                        placeholder = "Type a title"
                        signal = "title_text"
                        debounce_ms = 300
                        multiline = "false"
                        field_fill = color_code_bg
                        border_stroke = color_nav_border
                        label_fill = color_text
                        value_fill = color_text
                        placeholder_fill = color_text
                    }

                    textbox notes_editor {
                        x = 70
                        y = 310
                        width = 360
                        height = 94
                        label = "Multiline textbox"
                        value = "Edit this note"
                        placeholder = "Type a note"
                        signal = "notes"
                        debounce_ms = 300
                        multiline = "true"
                        field_fill = color_code_bg
                        border_stroke = color_nav_border
                        label_fill = color_text
                        value_fill = color_text
                        placeholder_fill = color_text
                    }

                    checkbox enabled_toggle {
                        x = 470
                        y = 235
                        width = 190
                        height = 28
                        label = "Enabled"
                        signal = "enabled"
                        checked = "true"
                        field_fill = color_code_bg
                        border_stroke = color_nav_border
                        active_fill = color_success
                        label_fill = color_text
                    }

                    radio plan_free {
                        x = 470
                        y = 292
                        width = 190
                        height = 28
                        label = "Free"
                        value = "Free"
                        signal = "plan"
                        field_fill = color_code_bg
                        border_stroke = color_nav_border
                        active_fill = color_link
                        label_fill = color_text
                    }

                    radio plan_team {
                        x = 470
                        y = 326
                        width = 190
                        height = 28
                        label = "Team"
                        value = "Team"
                        signal = "plan"
                        selected = "true"
                        field_fill = color_code_bg
                        border_stroke = color_nav_border
                        active_fill = color_link
                        label_fill = color_text
                    }

                    radio plan_enterprise {
                        x = 470
                        y = 360
                        width = 190
                        height = 28
                        label = "Enterprise"
                        value = "Enterprise"
                        signal = "plan"
                        field_fill = color_code_bg
                        border_stroke = color_nav_border
                        active_fill = color_link
                        label_fill = color_text
                    }

                    dropdown environment_picker {
                        x = 470
                        y = 430
                        width = 210
                        height = 56
                        label = "Environment"
                        value = "Stage"
                        items = "Dev,Stage,Prod"
                        signal = "environment"
                        field_fill = color_code_bg
                        border_stroke = color_nav_border
                        menu_fill = color_bg
                        label_fill = color_text
                        value_fill = color_text
                        placeholder_fill = color_text
                    }
                }

                code source {
                    language = "wcl"
                    content = "signal camp_marker {\n    initial = { x = 483 y = 341 }\n}\n\nbinding camp_icon_x {\n    signal = \"camp_marker\"\n    path = \"x\"\n    target = \"camp_drag_icon\"\n    property = \"map_anchor_x\"\n}\n\nbinding camp_icon_y {\n    signal = \"camp_marker\"\n    path = \"y\"\n    target = \"camp_drag_icon\"\n    property = \"map_anchor_y\"\n}\n\ndiagram map_drag_demo {\n    map route_map {\n        src = \"images/inkscape-rpg-map.png\"\n        content_width = 927\n        content_height = 704\n\n        icon camp_drag_icon {\n            name = \"tent\"\n            map_fixed = true\n            map_anchor_x = 483\n            map_anchor_y = 341\n            draggable = true\n            drag_signal = \"camp_marker\"\n            drag_x_path = \"x\"\n            drag_y_path = \"y\"\n        }\n    }\n}"
                }
            }
        }
    }
}
