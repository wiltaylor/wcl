import "./shared.wcl"

page frame_widget_examples {
    section = ref("my_docs.diagrams.frame_widget_examples")
    title = "Window and Device Widgets"

    layout {
        vsplit intro {
            split copy {
                size = 100

                heading h1 {
                    level = 1
                    content = "Window and Device Widgets"
                }

                paragraph p1 {
                    content = "Use " + bold("window") + " for regular application wireframes, and use " + bold("phone") + ", " + bold("phone_landscape") + ", " + bold("tablet") + ", and " + bold("tablet_landscape") + " for device mockups. These are container widgets, so child controls can be auto-placed inside their content areas."
                }
            }
        }

        vsplit examples {
            split body {
                size = 100

                diagram app_frames {
                    width = 760
                    height = 430

                    window desktop_app {
                        x = 20
                        y = 20
                        width = 360
                        height = 270
                        title = "Project Settings"
                        align = "stack"
                        gap = 12
                        padding = 18

                        input project_name {
                            height = 56
                            label = "Project name"
                            placeholder = "Roadmap"
                        }

                        dropdown visibility {
                            height = 56
                            label = "Visibility"
                            value = "Team"
                        }

                        button save {
                            width = 120
                            height = 38
                            label = "Save"
                            variant = "primary"
                        }
                    }

                    tablet tablet_app {
                        x = 420
                        y = 20
                        width = 300
                        height = 390
                        title = "Field Notes"
                        align = "stack"
                        gap = 12
                        padding = 16
                        header_fill = color_nav_bg

                        navbar tabs {
                            width = 232
                            height = 38
                            items = "Today,Map,Photos"
                            active_index = 0
                        }

                        card note {
                            width = 232
                            height = 112
                            title = "Inspection"
                        }

                        textbox details {
                            width = 232
                            height = 116
                            label = "Notes"
                            placeholder = "Record observations"
                            rows = 3
                        }

                        button complete {
                            width = 132
                            height = 38
                            label = "Complete"
                            variant = "primary"
                        }
                    }
                }

                code app_frames_source {
                    language = "wcl"
                    content = "diagram app_frames {\n    window desktop_app {\n        width = 360\n        height = 270\n        title = \"Project Settings\"\n        align = \"stack\"\n        gap = 12\n        padding = 18\n\n        input project_name { height = 56, label = \"Project name\" }\n        dropdown visibility { height = 56, label = \"Visibility\", value = \"Team\" }\n        button save { width = 120, height = 38, label = \"Save\", variant = \"primary\" }\n    }\n\n    tablet tablet_app {\n        width = 300\n        height = 390\n        title = \"Field Notes\"\n        align = \"stack\"\n        gap = 12\n        padding = 16\n\n        navbar tabs { width = 232, height = 38, items = \"Today,Map,Photos\", active_index = 0 }\n        card note { width = 232, height = 112, title = \"Inspection\" }\n        textbox details { width = 232, height = 116, label = \"Notes\", rows = 3 }\n        button complete { width = 132, height = 38, label = \"Complete\", variant = \"primary\" }\n    }\n}"
                }
            }
        }

        vsplit orientations {
            split orientation_body {
                size = 100

                heading h2_orientations {
                    level = 2
                    content = "Device Orientations"
                }

                diagram device_orientations {
                    width = 760
                    height = 620

                    phone mobile_portrait {
                        x = 20
                        y = 20
                        width = 150
                        height = 300
                        title = "Tasks"
                        align = "stack"
                        gap = 10
                        padding = 14

                        input search {
                            width = 122
                            height = 52
                            label = "Search"
                            placeholder = "Today"
                        }

                        button add {
                            width = 96
                            height = 34
                            label = "Add"
                            variant = "primary"
                        }
                    }

                    phone_landscape mobile_landscape {
                        x = 210
                        y = 20
                        width = 330
                        height = 180
                        title = "Tasks"
                        align = "stack"
                        gap = 10
                        padding = 12

                        navbar mobile_tabs {
                            width = 260
                            height = 34
                            items = "List,Board,Done"
                            active_index = 1
                        }

                        button quick_add {
                            width = 108
                            height = 34
                            label = "Quick Add"
                            variant = "primary"
                        }
                    }

                    tablet tablet_portrait {
                        x = 20
                        y = 350
                        width = 220
                        height = 260
                        title = "Notes"
                    }

                    tablet_landscape tablet_wide {
                        x = 280
                        y = 350
                        width = 420
                        height = 240
                        title = "Review Board"
                        align = "grid"
                        columns = 3
                        gap = 14
                        padding = 16
                        header_fill = color_nav_bg

                        card queue {
                            width = 88
                            height = 148
                            title = "Queue"
                        }

                        card active {
                            width = 88
                            height = 148
                            title = "Active"
                        }

                        card done {
                            width = 88
                            height = 148
                            title = "Done"
                        }
                    }
                }

                code device_orientation_source {
                    language = "wcl"
                    content = "diagram device_orientations {\n    width = 760\n    height = 620\n\n    phone mobile_portrait {\n        x = 20\n        y = 20\n        width = 150\n        height = 300\n        title = \"Tasks\"\n        align = \"stack\"\n        gap = 10\n        padding = 14\n    }\n\n    phone_landscape mobile_landscape {\n        x = 210\n        y = 20\n        width = 330\n        height = 180\n        title = \"Tasks\"\n        align = \"stack\"\n        gap = 10\n        padding = 12\n    }\n\n    tablet tablet_portrait {\n        x = 20\n        y = 350\n        width = 220\n        height = 260\n        title = \"Notes\"\n    }\n\n    tablet_landscape tablet_wide {\n        x = 280\n        y = 350\n        width = 420\n        height = 240\n        title = \"Review Board\"\n        align = \"grid\"\n        columns = 3\n        gap = 14\n        padding = 16\n\n        card queue { width = 88, height = 148, title = \"Queue\" }\n        card active { width = 88, height = 148, title = \"Active\" }\n        card done { width = 88, height = 148, title = \"Done\" }\n    }\n}"
                }
            }
        }
    }
}
