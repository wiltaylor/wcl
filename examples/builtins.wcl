// Built-in functions are Rust callables registered with the host's
// Environment before opening the document. The integration test for this
// file registers:
//
//   upper :: utf8 -> utf8
//   len   :: utf8 -> i64
//   add   :: (i64, i64) -> i64
//
// Running this through the bare `wcl` CLI will report "unknown built-in"
// errors — the CLI doesn't ship a stdlib. Real hosts register what they
// need.
//
// This fixture exercises expression eval; it doesn't model a real
// configuration, so each top-level field is `@schemaless` to opt out
// of strict-validation.

@schemaless name      = "alpha"
@schemaless greeting  = upper("hello")            // literal arg
@schemaless shouted   = upper(name)               // identifier arg -> field lookup
@schemaless total     = add(len("hi"), 1)         // nested call

// Operators inside arguments.
@schemaless ranking   = add(2 + 3 * 4, -1)
@schemaless is_big    = 100 > 99 && len("ab") == 2

// Block expression with let-bindings.
@schemaless combined  = { let a = upper("x"); let b = upper("y"); add(len(a), len(b)) }

// Function literals are first-class values: bind one to a field and
// invoke it by name.
@schemaless double    = fn(x: i32) -> i32 x * 2
@schemaless doubled4  = double(4)
