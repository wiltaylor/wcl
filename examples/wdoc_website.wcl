// wdoc `website` template — a Hugo-style site where you own the HTML/CSS
// design and slot wdoc-rendered content into it.
//
//   wcl wdoc build --out _site examples/wdoc_website.wcl
//
// The page authors named slots (hero / sidebar / footer) plus default
// content; the custom `landing` layout places typed slot handles and adds
// `<head>` content with the
// `wdoc_head_*` helpers. (A real site would link an external stylesheet via
// the site's `stylesheets` field; here the design CSS is inlined so the
// example is a single self-contained file.)
import <wdoc.wcl>

site web {
  default_template = :landing
  title            = "Nimbus"
  root             = true
  fonts            = ["https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap"]
}

// The design's CSS, inlined as a body <style> for a single-file example.
style "landing_css" {
  base "body" { css = "font-family: Inter, system-ui, sans-serif;" }
  class "nav" { css = "display: flex; align-items: center; justify-content: space-between; padding: 1rem 2rem; border-bottom: 1px solid var(--wdoc-border); position: sticky; top: 0; background: var(--wdoc-bg);" }
  class "nav" {
    nest ".brand" { css = "font-weight: 700; font-size: 1.2rem;" }
  }
  class "hero" { css = "text-align: center; padding: 5rem 2rem; background: color-mix(in srgb, var(--wdoc-accent) 12%, var(--wdoc-bg));" }
  class "hero" {
    nest "h1" { css = "font-size: 3rem; margin: 0 0 .5rem;" }
  }
  class "wrap" { css = "display: grid; grid-template-columns: minmax(0,1fr) 15rem; gap: 2.5rem; max-width: 64rem; margin: 0 auto; padding: 3rem 2rem;" }
  class "foot" { css = "text-align: center; padding: 2rem; opacity: .7; border-top: 1px solid var(--wdoc-border);" }
}

// The custom layout: paste your design and mark the slots. Head content
// comes from the `wdoc_head_*` helpers (top-level `Head` fundamentals)
// plus the site's `fonts` field.
template landing {
  slot content: content
  slot hero: content?
  slot sidebar: content?
  slot footer: content?
  render = fn(c: TemplateCtx) -> list<Html>
    flatten([
      wdoc_head_meta("viewport", "width=device-width, initial-scale=1"),
      wdoc_head_meta("description", "Nimbus — ship faster."),
      [
        css_style(:landing_css),
        el("header", ["nav"], [
          el("span", ["brand"], [raw(c.title)]),
          el("nav", [], [raw("<a href=\"index.html\">Home</a>")]),
        ]),
        el("section", ["hero"], slot(c, :hero)),
        el("div", ["wrap"], [
          el("main", [], slot(c, :content)),
          el("aside", [], slot(c, :sidebar)),
        ]),
        el("footer", ["foot"], slot(c, :footer)),
      ],
    ])
}

page index { sites = [:web]  start = true
  hero {
    h1 "Ship faster with Nimbus"
    p "The deployment platform that gets out of your way."
  }

  sidebar {
    h3 "On this page"
    list {
      li "Why Nimbus"
      li "How it works"
    }
  }

  footer {
    p "© 2026 Nimbus. Built with WCL + wdoc."
  }

  h2 "Why Nimbus"
  p "Everything outside a named fill renders into the default content slot — write it in wdoc and it picks up the site theme."

  h2 "How it works"
  p "Author your design once, drop content into slots, and rebuild."
  code bash { source = "wcl wdoc build site/main.wcl --out site/_site" }
}
