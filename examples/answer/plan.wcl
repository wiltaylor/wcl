// Fixture for guided answer mode (`wcl answer`, `wcl wdoc serve --answer`).
// A wplan-style interview document: `question` blocks opt into answer mode
// via `@answerable`, mapping the roles onto this schema's own field names.
import <answer.wcl>

@document
type Plan {
  @children("question") questions: list<PlanQuestion>
}

@answerable(prompt = "question", response = "answer", status = "status",
            pending = :open, resolved = :answered, skipped = :dropped)
@block("question")
type PlanQuestion {
  @inline(0) id: identifier
  question: utf8
  @default(:open) status: symbol
  answer: utf8?
  kind: symbol?    // :single_select | :multi_select | :free_text
  @children("option") options: list<AnswerOption>
}

question q_platforms {
  question = "What platforms must be supported?"
  kind = :single_select
  option linux { label = "Linux x86_64" }
  option mac { label = "macOS (Apple Silicon)" }
  option win { label = "Windows" }
}

question q_features {
  question = "Which optional features should ship in v1?"
  kind = :multi_select
  option lsp {}
  option fmt { label = "Formatter" }
}

question q_name {
  question = "What should the project be called?"
}

question q_done {
  question = "Is anything already decided?"
  status = :answered
  answer = "Yes — the CLI stays dependency-light."
}
