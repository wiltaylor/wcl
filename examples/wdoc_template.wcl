// wdoc page templates — a Hugo-style site shell.
//
//   wcl wdoc build --out _site examples/wdoc_template.wcl
//
// A `site` block sets the default template; pages may override it with
// their own `template` field. Templates are WCL functions returning
// `Html`s; they lay out the page body and embed the
// framework-provided `content` part (the page's own blocks) plus
// anything they build themselves from the document context.
//
// `import <wdoc.wcl>` pulls in the embedded wdoc standard library.
import <wdoc.wcl>

site {
  default_template = :webpage   // the stdlib template (header + nav + main)
  title            = "wdoc demo"
}

// A "part" is just a function returning fundamentals. Templates call
// it and embed the result — there's no special part syntax.
let footer = fn(c: TemplateCtx) -> list<Html> [
  el("footer", ["site-footer"], [raw(c.title)])
]

// A custom template: the stdlib nav + content, plus the footer part.
template guide {
  slot content: content
  render = fn(c: TemplateCtx) -> list<Html>
    flatten([
      [
        el("nav", ["site-nav"], map(c.pages, fn(p: PageRef) -> Html
            ela("a", [], [["href", p.href]], [raw(p.name)]))),
        el("main", ["site-main"], wdoc_blocks(c.content)),
      ],
      footer(c),
    ])
}

page index {
  h1 "Home"
  text { span "Welcome — this page uses the default **webpage** template." {} }
}

page guide {
  template = :guide
  h1 "Guide"
  text { span "This page overrides the default and uses the `guide` template (with a footer part)." {} }
}
