// Binary format example: sensor log with header + streaming records.

struct "FileHeader" {
    magic   : u32
    version : u16
    count   : u32
}

struct "SensorReading" {
    sensor_id : u16
    temp      : f32
    humidity  : f32
}

codec sensor_log {
    mode = :bytes
    decoder = source => {
        let header = source.read_struct("FileHeader", { endian = :le })
        object("SensorLog", {
            header = header
            readings = stream {
                let raw = state.get("i")
                let i = raw == null ? 0 : raw
                i >= header.count ? null : {
                    let _ = state.set("i", i + 1)
                    source.read_struct("SensorReading", { endian = :le })
                }
            }
        })
    }
}

transform sensor-to-json {
    input  = "codec::sensor_log"
    output = "codec::json"

    run = file => map(file.readings.to_list(), reading => {
        sensor   = reading.sensor_id
        temp_c   = reading.temp
        humidity = reading.humidity
    })
}
