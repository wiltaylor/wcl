// A book built with wdoc's stdlib `book` template (mdbook-style).
//
//   wcl wdoc serve examples/wdoc-book/main.wcl
//   wcl wdoc build --out _book examples/wdoc-book/main.wcl
//
// The `site` block selects `:book` as the default template and its
// `toc` defines the book structure: an ordered, nested table of
// contents. Each `chapter` shows its inline title in the sidebar;
// `page = name` links it to a page, and nested `chapter`s become
// sub-entries (any depth). A `chapter` with no `page` is a grouping
// heading. The current chapter is highlighted.
//
// The book is themed with the Nord palette via `class` blocks (below):
// dark by default, light under a light system theme, switchable with
// the ◐ toggle that `theme_toggle = true` adds to the sidebar.

site {
  default_template = :book
  title            = "WCL Handbook"
  theme_toggle     = true

  toc {
    chapter "Home" { page = index }
    chapter "Introduction" { page = introduction }
    chapter "Guide" {                              // heading (no page)
      chapter "Installation" { page = installation }
      chapter "Language" {                         // heading, nested
        chapter "Syntax" { page = syntax }         // level 3
        chapter "Builtins" { page = builtins }     // level 3
      }
    }
    chapter "Reference" { page = reference }
  }
}

// ── Nord theme (Polar Night = dark/default, Snow Storm = light) ──────
//
// Each region class carries a `dark {}` (default) and a `light {}` mode
// block; wdoc compiles them into the default rule, a
// `@media (prefers-color-scheme: light)` rule, and `:root[data-theme=…]`
// overrides the toggle flips. Built-in class names are quoted because
// they contain hyphens.

class "wdoc-body" {
  dark  { background = "#2e3440"  color = "#d8dee9" }   // nord0 / nord4
  light { background = "#eceff4"  color = "#2e3440" }   // nord6 / nord0
}
class "book-sidebar" {
  dark  { background = "#3b4252"  border = "1px solid #434c5e" }   // nord1 / nord2
  light { background = "#e5e9f0"  border = "1px solid #d8dee9" }   // nord5 / nord4
}
// Sidebar: bright Frost title, softer Frost chapter links, and a warm
// Aurora highlight on the current chapter so the reading position pops.
class "book-title" {
  dark  { color = "#88c0d0" }   // nord8
  light { color = "#5e81ac" }   // nord10
}
class "book-chapter" {
  dark  { color = "#81a1c1" }   // nord9
  light { color = "#5e81ac" }   // nord10
}
class "current" {
  dark  { color = "#ebcb8b" }   // nord13 (Aurora yellow)
  light { color = "#bf616a" }   // nord11 (Aurora red)
}
class "book-section" {
  dark  { color = "#8fbcbb" }   // nord7
  light { color = "#4c566a" }   // nord3
}

// Content headings descend through the Frost blues so each level reads
// distinctly (the renderer already sizes them; this colours them).
class "heading-1" {
  dark  { color = "#88c0d0" }   // nord8
  light { color = "#5e81ac" }   // nord10
}
class "heading-2" {
  dark  { color = "#8fbcbb" }   // nord7
  light { color = "#5e81ac" }   // nord10
}
class "heading-3" {
  dark  { color = "#81a1c1" }   // nord9
  light { color = "#4c566a" }   // nord3
}

// Links use Frost; inline code gets an Aurora-green chip.
class "link" {
  dark  { color = "#88c0d0" }   // nord8
  light { color = "#5e81ac" }   // nord10
}
class "code" {
  padding = "0.05rem 0.3rem"
  dark  { color = "#a3be8c"  background = "#3b4252" }   // nord14 on nord1
  light { color = "#4c6b2f"  background = "#e5e9f0" }   // green on nord5
}

// Code blocks stay a light Snow Storm card in both modes so the bundled
// syntax-token colours remain legible.
class "code-block" {
  background = "#e5e9f0"
  border     = "1px solid #d8dee9"
}

// Landing page. The dev server serves `/` from the page named
// `index`, so a book needs one — it's the cover / table of contents
// and the first entry in the sidebar.
page index {
  h1 "WCL Handbook" {}
  text {
    span "A short guide to the WCL configuration language. Pick a chapter from the sidebar, or start with the [Introduction](introduction)." {}
  }
}

page introduction {
  h1 "Introduction" {}
  text {
    span "WCL is a configuration language with a lazy evaluator, a schema system, and a document view layer. This handbook walks through it chapter by chapter." {}
  }
  text {
    span "Use the sidebar to jump between chapters. The chapter you're reading is **highlighted**." {}
  }
}

page installation {
  h1 "Installation" {}
  text { span "Install the CLI from the workspace:" {} }
  code bash {
    source = "cargo install --path crates/wcl"
  }
  text { span "Then check a file with `wcl check` or render docs with `wcl wdoc build`." {} }
}

page syntax {
  h1 "Syntax" {}
  text { span "WCL source is a tree of **fields** and **blocks**. This chapter shows each level — note how `h1`, `h2`, and `h3` headings take progressively cooler Frost tones." {} }

  h2 "Fields" {}
  text { span "A field binds a name to an expression with `=`. Inline `code` and [links](introduction) pick up their own theme colours." {} }
  code wcl {
    source = "name = \"wcl\"\nport = 8080\nenabled = true"
  }

  h2 "Blocks" {}
  text { span "Blocks group nested items and can carry labels." {} }
  code wcl {
    source = "server \"web\" {\n  host = \"0.0.0.0\"\n  addr = port\n}"
  }

  h3 "Let bindings" {}
  text { span "`let` declares composition helpers that never appear in the queried document — handy for sharing values across fields." {} }
  code wcl {
    source = "let port = 8080\nserver { addr = port }"
  }
}

page builtins {
  h1 "Builtins" {}
  text { span "Collections: `map`, `filter`, `fold`, `len`, `flatten`. Strings: `split`, `join`, `format`. Lists: `sort`, `unique`, `index_of`, `at`." {} }
  code wcl {
    source = "doubled = map([1, 2, 3], fn(n: i64) -> i64 n * 2)"
  }
}

page reference {
  h1 "Reference" {}
  text { span "The standard library ships collection, string, list, tensor, and control-flow builtins." {} }
  text { span "See the [Syntax](syntax) chapter for the language basics, or jump back to the [Introduction](introduction)." {} }
}
