// Heredoc multiline string literals.
//
// `<<TAG` opens; `TAG` alone on its own line closes. The body is
// escape-interpreted (same rules as `"..."`) and the smallest leading
// whitespace prefix across non-blank body lines is stripped — so you
// can indent the body in source without that indent leaking into the
// value.
//
// Typed prefixes (`ascii<<TAG`, `utf16<<TAG`, `utf32<<TAG`) compose
// with heredocs the same way they compose with `"..."` strings.
//
// A *raw* heredoc quotes the tag (`<<'TAG'`): its body is taken
// verbatim — no escape processing, no `${...}` interpolation — so
// backslash-heavy text (LaTeX, regexes, Windows paths) needs no
// doubling. Indentation stripping still applies.

@document
type Demo {
  message: utf8
  plain:   ascii
  raw:     utf8
  @child("note") note: Note
}

@block("note")
type Note {
  @inline(0) id: utf8
  body: utf8
}

message = <<END
  Hello, world.

  Goodbye, world.
  END

plain = ascii<<EOF
  plain ASCII only
  spans two lines
  EOF

// Raw: backslashes and `${...}` survive untouched.
raw = <<'TEX'
  \frac{-b \pm \sqrt{b^2 - 4ac}}{2a}  % no ${interpolation} here
  TEX

note "release" {
  body = <<NOTES
    line one
    line two
    NOTES
}
