// wdoc `:ai_skill` target — build an agent / Claude skill folder.
//
//   wcl wdoc skill --out _skill examples/wdoc_skill.wcl
//
// A `site` with `default_template = :ai_skill` and a `skill { }` block
// becomes a skill folder: the `start` page is written as `SKILL.md` (its
// YAML front matter built from `skill { }`), every other page goes under
// `references/`, and `file` blocks ship arbitrary files into their `dir`
// (`scripts/`, `assets/`, …). Build it with `wcl wdoc skill`.
import <wdoc.wcl>

site demo_skill {
  default_template = :ai_skill
  skill {
    name        = "demo-skill"
    description = "A demonstration skill showing SKILL.md, references, scripts and assets."
    license     = "MIT"
  }
}

// The start page → SKILL.md.
page overview {
  start = true
  // Extra front-matter keys merge with the generated name/description.
  @schemaless frontmatter {
    version = "1.0.0"
  }
  h1 "Demo Skill"
  p "This skill demonstrates the wdoc skill target. See the [usage guide](usage) for details."

  h2 "Files"
  p "Run the setup script to get started."
  file "skill_files/setup.sh" {
    dir = "scripts"
    as  = "setup.sh"
  }
  // A silently-shipped asset (no `as`): referenced by its stable path.
  file "skill_files/logo.svg" {
    dir = "assets"
  }
}

// A reference page → references/usage.md.
page usage {
  h1 "Usage"
  p "Detailed usage instructions. Back to the [overview](overview)."
}
