// Fixture for the lazy data-access (DataRef) tests.

@document
type Cfg {
  port: i64
  name: utf8
  @child("service") service: Service
}

@block("service")
type Service {
  @inline(0) id: identifier
  port:   i64
  region: utf8
  @child("metadata") metadata: Metadata
}

@block("metadata")
type Metadata {
  owner: utf8
  tier:  symbol
}

port = 8080
name = "alpha"

service "web" {
  port = 9090
  region = "us-east-1"

  metadata {
    owner = "platform-team"
    tier  = :gold
  }
}

@logged
type User {
  name: utf8
  age: u32?
}
