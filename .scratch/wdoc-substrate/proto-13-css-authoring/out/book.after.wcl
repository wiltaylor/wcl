// GENERATED BY THE TICKET-13 PROTOTYPE — throwaway, not for commit.
// The real migration hand-finishes selector lists and the :root accent line.

// ── from templates.wcl ───────────────────────────────────────────

class "book-sidebar" {
  css = "position: fixed; top: 0; left: 0; width: 16rem; height: 100vh; overflow-y: auto;
         box-sizing: border-box; padding: 1rem; border-right: 1px solid var(--wdoc-border);
         background: var(--wdoc-bg-alt); display: flex; flex-direction: column;
         font-family: var(--wdoc-font-head); scrollbar-width: thin;
         scrollbar-color: var(--wdoc-border-strong) transparent;"
  nest "&::-webkit-scrollbar" { css = "width: 9px;" }
  nest "&::-webkit-scrollbar-thumb" { css = "background: var(--wdoc-border-strong); border-radius: 999px;
    border: 2px solid var(--wdoc-bg-alt);" }
  nest "ul.book-toc" { css = "list-style: none; margin: 0; padding-left: 0;" }
  nest "ul.book-toc ul.book-toc" { css = "padding-left: 0.85rem;" }
  nest "a.book-chapter" { css = "display: block; padding: 0.25rem 0 0.25rem 0.6rem; border-left: 2px solid transparent;
    color: var(--wdoc-fg-muted); text-decoration: none;" }
  nest "a.book-chapter:hover" { css = "color: var(--wdoc-fg);" }
  nest "a.book-chapter.current" { css = "color: var(--wdoc-accent); border-left-color: var(--wdoc-accent); font-weight: 600;" }
  nest ".book-section" { css = "display: block; padding: 0.5rem 0 0.15rem; font-weight: 600; font-size: 0.72rem;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--wdoc-fg-subtle);" }
  nest ".book-toc-row" { css = "display: flex; align-items: baseline;" }
  nest ".book-toc-row > a.book-chapter, .book-toc-row > .book-section" { css = "flex: 1 1 auto;" }
  nest ".book-toc-toggle" { css = "flex: 0 0 1rem; cursor: pointer; user-select: none; text-align: center; opacity: 0.55;" }
  nest ".book-toc-toggle:hover" { css = "opacity: 1;" }
  nest "li.book-branch > .book-toc-row" { css = "cursor: pointer; user-select: none;" }
  nest "li.book-branch > .book-toc-row:hover > .book-toc-toggle" { css = "opacity: 1;" }
  nest "li.book-branch > .book-toc-row > .book-toc-toggle::before" { css = "content: \"▸\"; display: inline-block; transition: transform 0.12s ease;" }
  nest "li.book-branch.open > .book-toc-row > .book-toc-toggle::before" { css = "transform: rotate(90deg);" }
  nest "li.book-branch > ul.book-toc" { css = "display: none;" }
  nest "li.book-branch.open > ul.book-toc" { css = "display: block;" }
}

class "book-title" {
  css = "font-weight: 600; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase;
         color: var(--wdoc-fg-muted); margin-bottom: 0.9rem;"
}

class "book-home" {
  opacity = "0.8"
  css = "display: block; margin-bottom: 0.6rem; text-decoration: none; color: inherit;"
  nest "&:hover" { css = "opacity: 1; text-decoration: underline;" }
}

class "book-content" {
  css = "margin-left: 16rem; margin-right: 15rem; min-height: 100vh; box-sizing: border-box;"
  nest ".book-measure" { css = "max-width: 60rem; margin: 0 auto; padding: 2.5rem 3.5rem 6rem;
    background: var(--wdoc-book-bg); min-height: 100vh; box-sizing: border-box;
    font-family: var(--wdoc-font-body);" }
}

class "theme-toggle" {
  css = "display: block; margin: 0 0 0.75rem; padding: 0.25rem 0.7rem; cursor: pointer;
         background: var(--wdoc-bg-alt); border: 1px solid var(--wdoc-border-strong);
         border-radius: 999px; color: inherit; font: inherit; font-family: var(--wdoc-font-head);
         font-size: 0.8rem;"
}

class "book-pagenav" {
  css = "display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 3.5rem;"
  nest ".book-nav" { css = "display: block; padding: 0.9rem 1.1rem; border: 1px solid var(--wdoc-border);
    border-radius: 8px; background: var(--wdoc-book-bg); text-decoration: none;
    color: var(--wdoc-heading); font-family: var(--wdoc-font-head); font-weight: 600;" }
  nest ".book-nav:hover" { css = "border-color: var(--wdoc-accent);" }
  nest ".book-nav-next" { css = "grid-column: 2; text-align: right;" }
}

class "book-sidebar-footer" {
  css = "position: sticky; bottom: 0; margin: auto -1rem -1rem; padding: 0.6rem 1rem;
         background: var(--wdoc-bg-alt); border-top: 1px solid var(--wdoc-border); display: flex;
         flex-direction: column; gap: 0.4rem;"
}

class "book-footer-btn" {
  opacity = "0.85"
  css = "display: flex; align-items: center; justify-content: center; padding: 0.45rem 0.6rem;
         text-decoration: none; color: inherit; border: 1px solid var(--wdoc-border);
         border-radius: 6px;"
  nest "&:hover" { css = "opacity: 1; border-color: var(--wdoc-accent);" }
  nest "&.current" { css = "color: var(--wdoc-accent); border-color: var(--wdoc-accent); opacity: 1;" }
  nest ".wdoc-icon" { css = "width: 1.4em; height: 1.4em; flex: 0 0 auto;" }
}

class "book-rail" {
  css = "position: fixed; top: 0; right: 0; width: 15rem; height: 100vh; overflow-y: auto;
         box-sizing: border-box; padding: 2.5rem 1.4rem; font-family: var(--wdoc-font-head);
         scrollbar-width: thin; scrollbar-color: var(--wdoc-border-strong) transparent;"
}

class "book-rail-title" {
  css = "font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
         margin-bottom: 0.9rem;"
}

class "book-onpage" {
  css = "display: flex; flex-direction: column;"
}

class "book-onpage-link" {
  css = "display: block; padding: 0.2rem 0 0.2rem 0.7rem; font-size: 0.82rem; line-height: 1.35;
         text-decoration: none;"
  nest "&.level-3" { css = "padding-left: 1.5rem; font-size: 0.78rem;" }
}

class "heading-marker" {
  css = "display: block; font-size: 0.78rem; margin-bottom: 0.2rem;"
}

media "(max-width: 82rem)" {
  class "book-rail" { css = "display: none;" }
  class "book-content" { css = "margin-right: 0;" }
}
