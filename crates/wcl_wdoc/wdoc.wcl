// Fundamental block schema for `wdoc`. These are the IR layer that
// the HTML renderer (and future targets) speak; higher-level blocks
// will land later and lower to these via a transform pipeline.
//
// The wdoc binary prepends this to the user's source in memory before
// parsing.

@document
type Site {
  @children("class")          classes:   list<Class>
  @children("page")           pages:     list<Page>
  @children("inline_pattern") patterns:  list<InlinePattern>
  @children("template")       templates: list<Template>
  @children("iconset")        iconsets:  list<IconSet>
  @child("site")              site:      SiteConfig?
}

// Renderable-block interfaces. `WdocBlock` is the page-level domain
// (renders to HTML today; could target other formats later).
// `SvgBlock` is the diagram-level domain. User-authored block types
// opt in with `extends WdocBlock` / `extends SvgBlock` to become
// legal children of the corresponding `@children(...)` slot.
//
// Each interface requires a `lower` field — a function the renderer
// calls to turn the block into a list of fundamental variants. The
// interface signature uses `&Interface` as the parameter; concrete
// types are free to narrow the parameter to their own type
// (function-typed interface fields match on return type only).
// Implementations supply the function via `@default(fn(...) -> ...)`
// so per-instance overrides are possible but never required.
interface WdocBlock {
  id:    identifier?
  lower: fn(&WdocBlock) -> list<HtmlFundamental>
}
interface SvgBlock {
  id:    identifier?
  lower: fn(&SvgBlock) -> list<SvgFundamental>
}

// Default connection schema for diagrams. Any pair of SvgBlocks may
// be connected; renderers draw an arrow from source to destination
// using the resolved bounding boxes of the named shapes. User code
// may declare its own `connection ... : ... : ...` and consume it
// via `@connections(MyEdge)` for custom rendering.
symbol_set EdgeKind { default flow data }
connection Edge: &SvgBlock -> &SvgBlock : EdgeKind

// Edge-anchor sides for connection rendering. Each renderable SVG
// shape declares zero or more sides via `connect_points`; the
// renderer maps each side to the mid-point of the corresponding
// bounding-box edge and picks the closest source/destination pair
// when drawing an arrow. Default (field omitted) = all four sides.
symbol_set AnchorSide { north east south west }

// Connection routing strategy for a diagram's edges.
//   :elbow    (default) — orthogonal multi-bend polyline that
//                         routes around other shapes via A*.
//   :straight           — single line directly between anchors.
symbol_set EdgeRouting { elbow straight }

// Auto-layout direction. Only used when `layout = :layered`.
//   :top_to_bottom (default) — ranks stack downward.
//   :left_to_right           — ranks stack rightward.
symbol_set LayoutDirection { top_to_bottom left_to_right }

// Placement of an `icon` badge inside a shape's box (see the shared
// icon fields below). Default `:top_left`.
symbol_set IconPos { center top_left top_right bottom_left bottom_right left right }

// Shared "icon badge" fields. Any box-like shape (rect / circle /
// container / process / decision / terminator below — and any custom
// `extends SvgBlock` shape that declares the same fields) may carry an
// `icon`; the renderer resolves it against the declared `iconset`s and
// draws a `<use>` of the shared sprite over the shape's bounding box.
//   icon       — icon name, optionally `set.name`
//   icon_size  — badge size in diagram units (default min(w,h) * 0.4)
//   icon_pos   — placement (default :top_left)
//   icon_class — classes on the icon (theming via the class system)

@block("page")
type Page {
  @inline(0) name: identifier
  id: identifier?
  // Template to wrap this page's content in. Overrides the document's
  // `default_template` (set on the `site` block). When neither is set
  // the page renders bare (its blocks straight into <body>).
  template: symbol?
  @children(WdocBlock) children: list<WdocBlock>
}

// Style bundle. Referenced from any IR block's `class: list<utf8>?`
// field; each entry names a class by its inline identifier. Classes
// are document-global and emitted as `.name { ... }` rules in the
// page <style> block.
@block("class")
type Class {
  @inline(0) name: identifier

  // Text styling
  color:       utf8?
  background:  utf8?
  bold:        bool?
  italic:      bool?
  underline:   bool?

  // Sizing / alignment
  font_size:   utf8?
  font_family: utf8?
  text_align:  utf8?

  // Layout
  padding:     utf8?
  margin:      utf8?
  border:      utf8?

  // SVG painting (diagram shapes + chart series carry `class`es, so
  // these theme bars / lines / slices the same way `color` themes text).
  fill:         utf8?
  stroke:       utf8?
  stroke_width: utf8?
  opacity:      utf8?

  // Optional per-mode overrides. `dark` is the default mode; `light`
  // applies under a system `prefers-color-scheme: light` (and either
  // wins when the reader explicitly toggles). Same fields as the class.
  @child("dark")  dark:  ClassMode?
  @child("light") light: ClassModeLight?
}

// Per-mode styling for a `class`'s `dark {}` / `light {}` block — the
// same styling fields as `Class` (minus the name).
@block("dark")
type ClassMode {
  color:        utf8?
  background:   utf8?
  bold:         bool?
  italic:       bool?
  underline:    bool?
  font_size:    utf8?
  font_family:  utf8?
  text_align:   utf8?
  padding:      utf8?
  margin:       utf8?
  border:       utf8?
  fill:         utf8?
  stroke:       utf8?
  stroke_width: utf8?
  opacity:      utf8?
}

// `light {}` block — structurally identical to `dark {}`.
@block("light")
type ClassModeLight {
  color:        utf8?
  background:   utf8?
  bold:         bool?
  italic:       bool?
  underline:    bool?
  font_size:    utf8?
  font_family:  utf8?
  text_align:   utf8?
  padding:      utf8?
  margin:       utf8?
  border:       utf8?
  fill:         utf8?
  stroke:       utf8?
  stroke_width: utf8?
  opacity:      utf8?
}

// Paragraph — children are spans rendered in source order.
@block("text")
type Text extends WdocBlock {
  id:    identifier?
  class: list<utf8>?
  @children("span") spans: list<Span>
  // `text` is itself a fundamental HTML block — the renderer never
  // invokes its `lower`. Declared only to satisfy the interface.
  lower = fn(t: Text) -> list<HtmlFundamental> []
}

// Inline run inside a `text`. Style fields beyond `class` are
// intentionally absent — style flows through @block("class") rules.
@block("span")
type Span {
  @inline(0) text: utf8
  id:    identifier?
  class: list<utf8>?
}

// Grid container. `widths` are CSS percentages, one per child slot;
// children flow in source order across the slots.
@block("column")
type Column extends WdocBlock {
  widths: list<f64>
  id:     identifier?
  class:  list<utf8>?
  @children(WdocBlock) children: list<WdocBlock>
  lower = fn(c: Column) -> list<HtmlFundamental> []
}

// Admonition: an icon + a coloured heading over a body. The built-in
// types — `note` / `info` / `tip` / `warning` / `error` / `success` —
// are selected by putting the name in `class`; each supplies an accent
// colour (CALLOUT_CSS) and a default icon (from the bundled Lucide pack,
// so it works with no `iconset` declared). `icon` overrides the default.
// It is NOT a fundamental: it lowers (below) to plain `<div>`s plus an
// `Icon` fundamental, composing the existing HTML fundamentals.
@block("callout")
type Callout extends WdocBlock {
  @inline(0) heading: utf8
  body:  utf8
  id:    identifier?
  class: list<utf8>?
  icon:  utf8?

  lower = fn(c: Callout) -> list<HtmlFundamental> {
    let cls = if c.class == none { [] } else { c.class };
    // Default icon by built-in type (overridden by an explicit `icon`).
    let kind_icon =
      if list_contains(cls, "warning") { "lucide.triangle-alert" }
      else if list_contains(cls, "error") { "lucide.circle-x" }
      else if list_contains(cls, "success") { "lucide.circle-check" }
      else if list_contains(cls, "tip") { "lucide.lightbulb" }
      else if list_contains(cls, "info") { "lucide.info" }
      else if list_contains(cls, "note") { "lucide.info" }
      else { "" };
    let icon_name = if c.icon == none { kind_icon } else { c.icon };
    let title = HtmlFundamental::Paragraph {
      id: none, class: ["callout-title"], spans: [c.heading],
    };
    let head_children =
      if icon_name == "" { [title] }
      else {
        [
          HtmlFundamental::Icon { name: icon_name, class: ["callout-icon"] },
          title,
        ]
      };
    [
      HtmlFundamental::Element {
        tag: "div", id: c.id, class: flatten([["callout"], cls]), attrs: none,
        children: [
          HtmlFundamental::Element {
            tag: "div", id: none, class: ["callout-heading"], attrs: none,
            children: head_children,
          },
          HtmlFundamental::Element {
            tag: "div", id: none, class: ["callout-body"], attrs: none,
            children: [
              HtmlFundamental::Paragraph { id: none, class: none, spans: [c.body] },
            ],
          },
        ],
      },
    ]
  }
}

// Tabular grid. Rows are authored with WCL's native pipe-table
// syntax under a `rows:` header; the first row is the table header.
//
//   table {
//     rows:
//       | "Name"  | "Role" | "Age" |   // -> <thead>/<th>
//       | "Alice" | "Dev"  | 30     |   // -> <tbody>/<td>
//   }
//
// Cells may hold any literal: utf8 cells are run through the inline
// pattern engine (so **bold**, _italic_, `code`, [links](page) work),
// other types (numbers, bools, symbols) are stringified. The block
// deliberately declares no `rows` field — the pipe rows arrive as a
// syntactic `Item::Table` the renderer reads via `Block::tables()`,
// so tables can be any width with no per-table type. `table` is a
// fundamental HTML block (rendered directly), so its `lower` is never
// invoked — declared only to satisfy the WdocBlock interface.
// Named `TableBlock` (not `Table`) because `Table` is the reserved
// type name for the `@table` decorator. The block kind is still
// "table".
@block("table")
type TableBlock extends WdocBlock {
  id:    identifier?
  class: list<utf8>?
  lower = fn(t: TableBlock) -> list<HtmlFundamental> []
}

// SVG canvas. Width/height define the viewBox and rendered size,
// and the parent box for diagram-level anchored shapes.
@block("diagram")
type Diagram extends WdocBlock {
  width:  i64
  height: i64
  id:     identifier?
  class:  list<utf8>?

  // Layout: :none (default) honors per-shape x/y; :grid uses the
  // grid-cell knobs (cell_width/cell_height/columns/gap), same as
  // Container; :layered topologically ranks shapes via the
  // diagram's @connections(Edge) graph and assigns x/y.
  layout:      symbol?
  direction:   symbol?      // :top_to_bottom (default) | :left_to_right
  layer_gap:   f64?         // gap between ranks
  node_gap:    f64?         // gap between nodes within a rank
  cell_width:  f64?
  cell_height: f64?
  columns:     i64?
  gap:         f64?

  // Edge rendering.
  routing:         symbol?  // :elbow (default) | :straight
  edge_separation: f64?     // nudge step for parallel edges (default 4)

  @children(SvgBlock) children: list<SvgBlock>
  @connections(Edge) edges: list<Edge>
  lower = fn(d: Diagram) -> list<HtmlFundamental> []
}

// SVG <g> group with optional layout. Layout modes:
//   :none    (default) — children render at their own resolved boxes.
//   :grid              — children are placed into a `columns × rows`
//                        grid; each cell is `cell_width × cell_height`
//                        separated by `gap`. Per-cell child receives
//                        `(cell_width, cell_height)` as its parent
//                        size, so anchored children stretch to the
//                        cell.
//   :layered           — topological rank from the container's
//                        @connections(Edge) graph; each rank is
//                        spaced by `layer_gap`, nodes within a
//                        rank by `node_gap`. Flow direction is
//                        controlled by `direction` (default
//                        :top_to_bottom). Per-shape width/height
//                        are honored.
// Anchors on the container itself resolve against the parent box and
// can resize the container; that new size flows to its own children.
@block("container")
type Container extends SvgBlock {
  id:    identifier?
  class: list<utf8>?

  // Optional chrome. When either is set the renderer emits a
  // background <rect> the full size of the container's box,
  // making the grouping visible. The chrome is purely visual —
  // it does NOT participate in obstacle routing, so cross-
  // container edges still pass through cleanly.
  stroke: utf8?
  fill:   utf8?

  // Inset applied to children. Grows the container's outer box
  // by 2*padding on each axis and shifts the children inward
  // by `padding`, so chrome doesn't touch the shapes inside.
  padding: f64?

  // Declared interior size (used when no layout/anchor is sizing
  // this container — e.g. a top-level container in a diagram).
  width:  f64?
  height: f64?

  // Layout
  layout:      symbol?
  columns:     i64?
  cell_width:  f64?
  cell_height: f64?
  gap:         f64?
  direction:   symbol?    // :top_to_bottom (default) | :left_to_right
  layer_gap:   f64?
  node_gap:    f64?

  // Anchors (resolve against the parent's box).
  anchor_left:   f64?
  anchor_right:  f64?
  anchor_top:    f64?
  anchor_bottom: f64?

  connect_points: list<AnchorSide>?

  icon: utf8?  icon_size: f64?  icon_pos: IconPos?  icon_class: list<utf8>?

  @children(SvgBlock) children: list<SvgBlock>
  @connections(Edge) edges: list<Edge>
  // `container` is itself rendered directly as <g>; the renderer
  // never invokes its `lower`. Declared only to satisfy the interface.
  lower = fn(c: Container) -> list<SvgFundamental> []
}

@block("rect")
type Rect extends SvgBlock {
  x:      f64?
  y:      f64?
  width:  f64?
  height: f64?
  fill:   utf8?
  stroke: utf8?
  id:     identifier?
  class:  list<utf8>?

  anchor_left:   f64?
  anchor_right:  f64?
  anchor_top:    f64?
  anchor_bottom: f64?

  connect_points: list<AnchorSide>?

  icon: utf8?  icon_size: f64?  icon_pos: IconPos?  icon_class: list<utf8>?

  lower = fn(r: Rect) -> list<SvgFundamental> []
}

@block("circle")
type Circle extends SvgBlock {
  cx:     f64?
  cy:     f64?
  r:      f64?
  fill:   utf8?
  stroke: utf8?
  id:     identifier?
  class:  list<utf8>?

  anchor_left:   f64?
  anchor_right:  f64?
  anchor_top:    f64?
  anchor_bottom: f64?

  connect_points: list<AnchorSide>?

  icon: utf8?  icon_size: f64?  icon_pos: IconPos?  icon_class: list<utf8>?

  lower = fn(c: Circle) -> list<SvgFundamental> []
}

@block("line")
type Line extends SvgBlock {
  x1:     f64?
  y1:     f64?
  x2:     f64?
  y2:     f64?
  stroke: utf8?
  id:     identifier?
  class:  list<utf8>?

  anchor_left:   f64?
  anchor_right:  f64?
  anchor_top:    f64?
  anchor_bottom: f64?

  connect_points: list<AnchorSide>?

  lower = fn(l: Line) -> list<SvgFundamental> []
}

// SVG <text> shape. Renamed from `text` to avoid colliding with the
// paragraph block kind.
@block("label")
type Label extends SvgBlock {
  @inline(0) content: utf8
  x:     f64?
  y:     f64?
  // Optional font-size override. When unset, the renderer picks a
  // size that fits `content` inside `fit_width` × `fit_height`
  // (capped at the renderer's default), or its default for a
  // stand-alone label with no fit region.
  font_size:  f64?
  fit_width:  f64?
  fit_height: f64?
  fill:  utf8?
  id:    identifier?
  class: list<utf8>?

  anchor_left:   f64?
  anchor_right:  f64?
  anchor_top:    f64?
  anchor_bottom: f64?

  connect_points: list<AnchorSide>?

  lower = fn(l: Label) -> list<SvgFundamental> []
}

@block("polygon")
type Polygon extends SvgBlock {
  points: utf8
  fill:   utf8?
  stroke: utf8?
  id:     identifier?
  class:  list<utf8>?

  anchor_left:   f64?
  anchor_right:  f64?
  anchor_top:    f64?
  anchor_bottom: f64?

  connect_points: list<AnchorSide>?

  lower = fn(p: Polygon) -> list<SvgFundamental> []
}

// ── Lowering layer ─────────────────────────────────────────────────
//
// Custom shapes ship as a `@block` declaration + a top-level
// `<kind>_lower` function returning `list<SvgFundamental>` (SVG
// diagram shapes) or `list<HtmlFundamental>` (page-level blocks).
// The renderer recursively lowers each returned variant until only
// fundamentals remain. Users add their own shapes by declaring the
// same pair in user source.

union SvgFundamental {
  Rect    { x: f64? y: f64? width: f64? height: f64? fill: utf8? stroke: utf8? id: identifier? class: list<utf8>? }
  Circle  { cx: f64? cy: f64? r: f64? fill: utf8? stroke: utf8? id: identifier? class: list<utf8>? }
  Line    { x1: f64? y1: f64? x2: f64? y2: f64? stroke: utf8? id: identifier? class: list<utf8>? }
  Label   { content: utf8 x: f64? y: f64? font_size: f64? fit_width: f64? fit_height: f64? fill: utf8? id: identifier? class: list<utf8>? }
  Polygon { points: utf8 fill: utf8? stroke: utf8? id: identifier? class: list<utf8>? }
}

union HtmlFundamental {
  Paragraph { id: identifier? class: list<utf8>? spans: list<utf8> }
  // Table — `header` is the heading row (rendered as <th> inside
  // <thead>; omit or leave empty for a header-less table); `rows` are
  // the body rows (<td> inside <tbody>). On this lowering path cells
  // are plain escaped text, mirroring `Paragraph`'s escaped spans.
  // The user-facing `table` block authors rows with WCL's pipe-table
  // syntax and additionally runs utf8 cells through inline patterns.
  Table { id: identifier? class: list<utf8>? header: list<utf8>? rows: list<list<utf8>> }
  // Generic structural element: `<tag id class attrs…>children</tag>`.
  // Recursive — `children` are themselves fundamentals — so templates
  // can build arbitrary layout (header / nav / main / footer / a / …).
  // `attrs` is a list of `[name, value]` pairs (values escaped), e.g.
  // `[["href", p.href]]`.
  Element { tag: utf8 id: identifier? class: list<utf8>? attrs: list<list<utf8>>? children: list<HtmlFundamental> }
  // Verbatim, pre-rendered HTML — NOT escaped. Used to embed already-
  // rendered content (e.g. a page's `content` part) inside a template.
  Raw { html: utf8 }
  // An icon, resolved against the declared `iconset`s (and, for a
  // `pack.name`, the compiled-in packs). The renderer records it for
  // the shared sprite and emits `<svg class="wdoc-icon …"><use …/></svg>`
  // (currentColor, so it inherits its container's colour). Used by the
  // stdlib `callout` lowering; available to any HTML lowering.
  Icon { name: utf8 class: list<utf8>? }
}

// ── Page templates ─────────────────────────────────────────────────
//
// A template wraps a page's rendered content in a surrounding layout.
// Templates are WCL functions returning fundamentals; the renderer
// calls a template's `render` with a `TemplateCtx` and the resulting
// fundamentals become the page <body>. The `<head>` + stylesheet are
// still emitted by the renderer.
//
// "Parts" are just functions returning `list<HtmlFundamental>`: a
// template composes them and embeds the framework-provided `content`
// part (the page's own blocks) via `Raw`. There is no built-in menu —
// a template builds navigation itself from `ctx.pages`.

// Reference to a page, for building navigation. `href` is the page's
// output file (`<name>.html`).
type PageRef { name: utf8  href: utf8 }

// A node in the resolved table of contents handed to templates. Built
// by the renderer from the `site`'s `toc` block. `href` is empty for a
// grouping heading (a `chapter` with no `page`); `current` is true for
// the entry linking to the page being rendered; `children` are nested
// entries (any depth).
type TocEntry {
  title:    utf8
  href:     utf8
  current:  bool
  children: list<TocEntry>
}

// Context handed to a template's (and any part function's) `render`.
type TemplateCtx {
  content:      utf8            // the page's rendered body HTML (embed via Raw)
  title:        utf8            // site title, or the page name if unset
  page_name:    utf8            // the current page's name
  pages:        list<PageRef>   // every page in the document, in source order
  toc:          list<TocEntry>  // the book TOC tree; flat (one per page) if no `toc`
  theme_toggle: bool            // whether to render a light/dark toggle (site flag)
}

// One table-of-contents entry. The inline label is the display title;
// `page` (optional) links it to a page; nested `chapter`s are
// sub-entries (3+ levels). A `chapter` with no `page` is a heading.
@block("chapter")
type Chapter {
  @inline(0) title: utf8
  page: identifier?
  @children("chapter") children: list<Chapter>
}

// The book's table of contents — an ordered, nestable tree of
// `chapter` entries. Declared inside the `site` block.
@block("toc")
type Toc {
  @children("chapter") chapters: list<Chapter>
}

// Document descriptor. One per document; sets the default template and
// site-level data templates can read. Selected per-page via the
// page's `template` field, else `default_template` here.
@block("site")
type SiteConfig {
  default_template: symbol?
  title:            utf8?
  // Render a light/dark toggle (the `book` template shows it). Pair
  // with `class` blocks that declare `dark {}` / `light {}` modes.
  theme_toggle:     bool?
  @child("toc") toc: Toc?
}

// A named template. `render` lays out a page body from the context.
@block("template")
type Template {
  @inline(0) name: identifier
  render: fn(TemplateCtx) -> list<HtmlFundamental>
}

// Stdlib `webpage` template: a Hugo-style site shell — a title header,
// a nav built from every page, and the page content in <main>. Users
// can declare their own `template <name> { render = ... }` blocks and
// select them with `default_template` / a page's `template` field.
template webpage {
  render = fn(c: TemplateCtx) -> list<HtmlFundamental> [
    HtmlFundamental::Element {
      tag: "header", id: none, class: ["site-header"], attrs: none,
      children: [ HtmlFundamental::Raw { html: c.title } ],
    },
    HtmlFundamental::Element {
      tag: "nav", id: none, class: ["site-nav"], attrs: none,
      children: map(c.pages, fn(p: PageRef) -> HtmlFundamental
        HtmlFundamental::Element {
          tag: "a", id: none, class: none,
          attrs: [["href", p.href]],
          children: [ HtmlFundamental::Raw { html: p.name } ],
        }),
    },
    HtmlFundamental::Element {
      tag: "main", id: none, class: ["site-main"], attrs: none,
      children: [ HtmlFundamental::Raw { html: c.content } ],
    },
  ]
}

// One sidebar entry: a `<span>` heading when the entry has no page
// (empty href), otherwise an `<a>` link (with `current` highlighting).
let book_toc_link = fn(e: TocEntry) -> HtmlFundamental
  if e.href == "" {
    HtmlFundamental::Element {
      tag: "span", id: none, class: ["book-section"], attrs: none,
      children: [ HtmlFundamental::Raw { html: e.title } ],
    }
  } else {
    HtmlFundamental::Element {
      tag: "a", id: none,
      class: if e.current { ["book-chapter", "current"] } else { ["book-chapter"] },
      attrs: [["href", e.href]],
      children: [ HtmlFundamental::Raw { html: e.title } ],
    }
  }

// Render a list of TOC entries as a nested `<ul>` — recursive, so the
// tree nests to any depth. An empty list renders nothing (no stray
// `<ul>`), which also terminates the recursion at the leaves.
let book_toc = fn(entries: list<TocEntry>) -> list<HtmlFundamental>
  if len(entries) == 0 { [] }
  else {
    [ HtmlFundamental::Element {
        tag: "ul", id: none, class: ["book-toc"], attrs: none,
        children: map(entries, fn(e: TocEntry) -> HtmlFundamental
          HtmlFundamental::Element {
            tag: "li", id: none, class: none, attrs: none,
            children: flatten([ [book_toc_link(e)], book_toc(e.children) ]),
          }),
      } ]
  }

// Stdlib `book` template: an mdbook-style layout — a fixed left
// sidebar holding the book title and the table of contents (nested,
// current chapter highlighted), and the page content in a reading
// column. The TOC comes from the `site` block's `toc`; with no `toc`
// declared the renderer falls back to a flat list of every page.
template book {
  render = fn(c: TemplateCtx) -> list<HtmlFundamental> [
    HtmlFundamental::Element {
      tag: "nav", id: none, class: ["book-sidebar"], attrs: none,
      children: flatten([
        [ HtmlFundamental::Element {
            tag: "div", id: none, class: ["book-title"], attrs: none,
            children: [ HtmlFundamental::Raw { html: c.title } ],
          } ],
        if c.theme_toggle { book_theme_toggle } else { [] },
        book_toc(c.toc),
      ]),
    },
    HtmlFundamental::Element {
      tag: "main", id: none, class: ["book-content"], attrs: none,
      children: [ HtmlFundamental::Raw { html: c.content } ],
    },
  ]
}

// Light/dark toggle: a button plus a one-time script. The script
// applies a persisted choice on load and defines `wdocToggleTheme`,
// which flips `<html data-theme>` between dark/light (seeded from the
// system preference) and persists to localStorage. With no
// `data-theme` set, the `class` `@media (prefers-color-scheme: light)`
// rules follow the system; the attribute (toggle) overrides them.
let book_theme_toggle = [
  HtmlFundamental::Element {
    tag: "button", id: none, class: ["theme-toggle"],
    attrs: [["onclick", "wdocToggleTheme()"]],
    children: [ HtmlFundamental::Raw { html: "◐ Theme" } ],
  },
  HtmlFundamental::Raw {
    html: "<script>(function(){var r=document.documentElement;try{var s=localStorage.getItem('wdoc-theme');if(s){r.setAttribute('data-theme',s);}}catch(e){}window.wdocToggleTheme=function(){var lt=window.matchMedia&&window.matchMedia('(prefers-color-scheme: light)').matches;var cur=r.getAttribute('data-theme')||(lt?'light':'dark');var n=(cur==='dark')?'light':'dark';r.setAttribute('data-theme',n);try{localStorage.setItem('wdoc-theme',n);}catch(e){}};})();</script>",
  },
]

// Inline parsed-text variants produced by `inline_pattern` blocks.
// The renderer dispatches Plain to `<span class="...">…</span>` and
// Link to `<a href="…" class="…">…</a>`. The `text` field of each
// variant is re-tokenized through the pattern engine (with a depth
// cap) so a Bold match can contain an Italic span inside.
union InlineSpan {
  Plain { text: utf8 class: list<utf8>? }
  Link  { text: utf8 href: utf8 class: list<utf8>? }
  // An icon, produced by the built-in `:name:` pattern. `name` is the
  // icon (optionally `set.name`); the renderer resolves it against the
  // declared `iconset`s and emits a `<use>` of the shared sprite. An
  // unresolved name renders as the literal `:name:` text.
  Icon  { name: utf8 class: list<utf8>? }
}

// Regex-driven inline parser. The `pattern` field holds a regex;
// when the renderer tokenizes a span's text, every match is handed
// to `to_span` (with the regex's captured groups as `list<utf8>`,
// group 0 = whole match, group 1+ = subgroups in order) which
// returns a list of InlineSpan variants. Built-in patterns ship in
// this schema; users add their own by declaring more
// `inline_pattern <name> { ... }` blocks in user `.wcl`.
@block("inline_pattern")
type InlinePattern {
  @inline(0) name: identifier
  pattern: utf8
  to_span: fn(list<utf8>) -> list<InlineSpan>
}

// ── Icons ──────────────────────────────────────────────────────────
//
// An `iconset` names a reference to one of the bundled SVG packs (today
// `lucide` and `bootstrap`, compiled into the binary) and sets the
// default styling for icons drawn from it. Icons are referenced three
// ways: the inline `:name:` (or `:set.name:`) handler in `span` text, an
// `icon` block inside a `diagram`, and they all draw from a shared
// `_wdoc/icons.svg` sprite the build emits with only the icons used.
//
// Styling rides the `class` system. Every icon paints with
// `currentColor`, so a `color` (on the iconset, an icon, or a referenced
// `class`) is the universal foreground knob — it recolours both
// stroke-based (Lucide) and fill-based (Bootstrap) packs. `size` scales
// inline icons (defaults to the surrounding font size, `1em`); `fill`
// and `background` are optional overrides.
@block("iconset")
type IconSet {
  @inline(0) name: identifier        // reference name, e.g. `ui`
  pack: utf8?                         // bundled pack; defaults to `name`
  size:        utf8?                  // default inline size, e.g. "1em", "20px"
  color:       utf8?                  // default foreground (drives currentColor)
  fill:        utf8?                  // optional explicit fill
  background:  utf8?                  // optional background
  class:       list<utf8>?            // classes added to every icon from this set
  @children("icon_def") icons: list<IconDef>
}

// Per-icon style override inside an `iconset`. Any field set here wins
// over the set default for that one icon.
@block("icon_def")
type IconDef {
  @inline(0) name: identifier         // icon name (file stem in the pack)
  size:        utf8?
  color:       utf8?
  fill:        utf8?
  background:  utf8?
  class:       list<utf8>?
}

// A placeable, scalable icon inside a `diagram` / `container`. `width` /
// `height` size it in diagram units (scaled further by `scale`); the
// anchors position it like any other shape. The `lower` is a stub — the
// icon is special-cased in the renderer (it resolves a bundled pack and
// emits a `<use>` of the shared sprite, which WCL can't express).
@block("icon")
type Icon extends SvgBlock {
  @inline(0) name: identifier         // icon name (optionally `set.name`)
  set: identifier?                    // which iconset (when more than one)
  size:        utf8?
  color:       utf8?
  fill:        utf8?
  background:  utf8?
  class: list<utf8>?
  id: identifier?
  // Defaults mirror the stdlib shapes so a bare icon lays out in
  // `:grid` / `:layered` diagrams and gets a bounding box for edges.
  x = 0.0  y = 0.0  width = 24.0  height = 24.0
  scale: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?

  lower = fn(i: Icon) -> list<SvgFundamental> []
}

// ── Stdlib flowchart shapes ────────────────────────────────────────
//
// Each custom shape supplies its lowering via `@default` on the
// `lower` field. The renderer calls `block.field("lower")` (or the
// schema default if the instance didn't override) and recursively
// renders the variants it returns. Per-instance overrides work
// transparently — set `lower = fn(...) -> ...` on a particular block
// and that supersedes the default for just that instance.

@block("process")
type Process extends SvgBlock {
  @inline(0) text: utf8
  // Defaults let `:layered` layout position these shapes via a
  // wrapper transform: the child renders at (0,0) of its assigned
  // cell rather than failing the lowering when x/y are omitted.
  x = 0.0  y = 0.0  width = 80.0  height = 40.0
  fill: utf8?  stroke: utf8?  id: identifier?  class: list<utf8>?
  connect_points: list<AnchorSide>?
  icon: utf8?  icon_size: f64?  icon_pos: IconPos?  icon_class: list<utf8>?

  lower = fn(p: Process) -> list<SvgFundamental> [
    SvgFundamental::Rect {
      x: p.x, y: p.y, width: p.width, height: p.height,
      fill: p.fill, stroke: p.stroke, id: p.id, class: p.class,
    },
    SvgFundamental::Label {
      content: p.text,
      x: p.x + p.width / 2.0,
      y: p.y + p.height / 2.0,
      font_size: none,
      fit_width: p.width,  fit_height: p.height,
      fill: none, id: none, class: p.class,
    },
  ]
}

@block("decision")
type Decision extends SvgBlock {
  @inline(0) text: utf8
  x = 0.0  y = 0.0  width = 80.0  height = 40.0
  fill: utf8?  stroke: utf8?  id: identifier?  class: list<utf8>?
  connect_points: list<AnchorSide>?
  icon: utf8?  icon_size: f64?  icon_pos: IconPos?  icon_class: list<utf8>?

  lower = fn(d: Decision) -> list<SvgFundamental> [
    SvgFundamental::Polygon {
      points: format(
        "{},{} {},{} {},{} {},{}",
        d.x + d.width / 2.0, d.y,
        d.x + d.width,       d.y + d.height / 2.0,
        d.x + d.width / 2.0, d.y + d.height,
        d.x,                 d.y + d.height / 2.0,
      ),
      fill: d.fill, stroke: d.stroke, id: d.id, class: d.class,
    },
    SvgFundamental::Label {
      content: d.text,
      x: d.x + d.width / 2.0,
      y: d.y + d.height / 2.0,
      font_size: none,
      // Diamond's text region is smaller than its bbox — the
      // inscribed rect at the middle is roughly half the width
      // and full height; halve fit_width so long labels shrink
      // before they hit the diamond's sloped edges.
      fit_width: d.width / 2.0,  fit_height: d.height,
      fill: none, id: none, class: d.class,
    },
  ]
}

// Terminator: rounded-corner rect is a single Rect for now — true
// rounded corners come when SvgFundamental::Rect grows an `rx` field.
@block("terminator")
type Terminator extends SvgBlock {
  @inline(0) text: utf8
  x = 0.0  y = 0.0  width = 80.0  height = 40.0
  fill: utf8?  stroke: utf8?  id: identifier?  class: list<utf8>?
  connect_points: list<AnchorSide>?
  icon: utf8?  icon_size: f64?  icon_pos: IconPos?  icon_class: list<utf8>?

  lower = fn(t: Terminator) -> list<SvgFundamental> [
    SvgFundamental::Rect {
      x: t.x, y: t.y, width: t.width, height: t.height,
      fill: t.fill, stroke: t.stroke, id: t.id, class: t.class,
    },
    SvgFundamental::Label {
      content: t.text,
      x: t.x + t.width / 2.0,
      y: t.y + t.height / 2.0,
      font_size: none,
      fit_width: t.width,  fit_height: t.height,
      fill: none, id: none, class: t.class,
    },
  ]
}

// ── Stdlib charts ──────────────────────────────────────────────────
//
// `bar_chart`, `line_chart`, and `pie_chart` are custom SvgBlocks that
// lower to fundamentals through pure-WCL geometry (the math builtins —
// `sin`/`cos`/`max`/`min`/… — do the work). They are placed inside a
// `diagram { }` like any other shape and positioned with `x`/`y`.
//
// Data is supplied as a list of `ChartSeries::Of` (bar / line) or
// `ChartSlice::Of` (pie) variants. Every bar / line / slice is tagged
// with a palette class (`wdoc-series-1`..`wdoc-series-8`, cycled by
// index) and emits no inline fill, so colours come entirely from CSS:
// redeclare `class "wdoc-series-N" { fill = … dark {…} light {…} }` to
// recolour a series the same way you theme anything else. Axes, grid,
// labels, title, and legend paint with `currentColor` (see CHART_CSS).

union ChartSeries { Of { name: utf8  values: list<f64> } }
union ChartSlice  { Of { label: utf8  value: f64 } }

// Palette of series classes; cycled by index so the Nth series / slice
// always lands on a stable class an author can override.
let chart_palette = [
  "wdoc-series-1", "wdoc-series-2", "wdoc-series-3", "wdoc-series-4",
  "wdoc-series-5", "wdoc-series-6", "wdoc-series-7", "wdoc-series-8",
]
let chart_series_class = fn(i: i64) -> utf8 at(chart_palette, i % len(chart_palette))

// Largest value across every series — the auto upper bound for the
// scale when `y_max` is omitted.
let chart_all_values = fn(series: list<ChartSeries>) -> list<f64>
  flatten(map(series, fn(s: ChartSeries) -> list<f64> s.values))
let chart_data_max = fn(series: list<ChartSeries>) -> f64
  fold(chart_all_values(series), 0.0, fn(acc: f64, v: f64) -> f64 max(acc, v))
let chart_ncat = fn(series: list<ChartSeries>) -> i64 {
  let s0 = at(series, 0);
  len(s0.values)
}

// Format a scale tick: round to two decimals so auto bounds don't emit
// long floating-point tails.
let chart_fmt = fn(v: f64) -> utf8 format("{}", round(v * 100.0) / 100.0)

// Plot-area axes: the x baseline and the y spine.
let chart_axes = fn(px: f64, py: f64, pw: f64, ph: f64) -> list<SvgFundamental> [
  SvgFundamental::Line {
    x1: px, y1: py + ph, x2: px + pw, y2: py + ph,
    stroke: none, id: none, class: ["wdoc-axis"],
  },
  SvgFundamental::Line {
    x1: px, y1: py, x2: px, y2: py + ph,
    stroke: none, id: none, class: ["wdoc-axis"],
  },
]

// Horizontal gridlines + y-axis value labels for `nticks` divisions.
let chart_y_ticks = fn(px: f64, py: f64, pw: f64, ph: f64, ymin: f64, ymax: f64, nticks: i64) -> list<SvgFundamental>
  flatten(map(range(0, nticks + 1), fn(k: i64) -> list<SvgFundamental> {
    let yy = py + ph - ph * k / nticks;
    let val = ymin + (ymax - ymin) * k / nticks;
    [
      SvgFundamental::Line {
        x1: px, y1: yy, x2: px + pw, y2: yy,
        stroke: none, id: none, class: ["wdoc-grid"],
      },
      SvgFundamental::Label {
        content: chart_fmt(val),
        x: px - 6.0, y: yy, font_size: 10.0,
        fit_width: 32.0, fit_height: 12.0,
        fill: none, id: none, class: ["wdoc-axis-label"],
      },
    ]
  }))

// One category label centred under each group / point slot.
let chart_cat_labels = fn(px: f64, py: f64, pw: f64, ph: f64, cats: list<utf8>) -> list<SvgFundamental> {
  let ncat = len(cats);
  map(range(0, ncat), fn(i: i64) -> SvgFundamental {
    let gw = pw / ncat;
    SvgFundamental::Label {
      content: at(cats, i),
      x: px + gw * i + gw / 2.0, y: py + ph + 12.0, font_size: 10.0,
      fit_width: gw, fit_height: 12.0,
      fill: none, id: none, class: ["wdoc-axis-label"],
    }
  })
}

// Optional x-axis title (below the category labels) and y-axis title
// (above the spine). Empty strings render nothing.
let chart_axis_titles = fn(px: f64, py: f64, pw: f64, ph: f64, xlab: utf8, ylab: utf8) -> list<SvgFundamental>
  flatten([
    if xlab == "" { [] } else {
      [ SvgFundamental::Label {
          content: xlab, x: px + pw / 2.0, y: py + ph + 26.0, font_size: 11.0,
          fit_width: pw, fit_height: 13.0,
          fill: none, id: none, class: ["wdoc-axis-label"],
        } ]
    },
    if ylab == "" { [] } else {
      [ SvgFundamental::Label {
          content: ylab, x: px, y: py - 7.0, font_size: 11.0,
          fit_width: 90.0, fit_height: 13.0,
          fill: none, id: none, class: ["wdoc-axis-label"],
        } ]
    },
  ])

// Centred chart title at the top of the box. Empty string ⇒ nothing.
let chart_title = fn(cx: f64, cy: f64, cw: f64, text: utf8) -> list<SvgFundamental>
  if text == "" { [] } else {
    [ SvgFundamental::Label {
        content: text, x: cx, y: cy + 11.0, font_size: 13.0,
        fit_width: cw, fit_height: 16.0,
        fill: none, id: none, class: ["wdoc-chart-title"],
      } ]
  }

// Legend row: a coloured swatch + series name per series.
let chart_legend = fn(px: f64, ly: f64, pw: f64, series: list<ChartSeries>) -> list<SvgFundamental> {
  let n = len(series);
  flatten(map(range(0, n), fn(j: i64) -> list<SvgFundamental> {
    let slot = pw / n;
    let ix = px + slot * j;
    let sj = at(series, j);
    [
      SvgFundamental::Rect {
        x: ix, y: ly - 9.0, width: 10.0, height: 10.0,
        fill: none, stroke: none, id: none, class: [chart_series_class(j)],
      },
      SvgFundamental::Label {
        content: sj.name,
        x: ix + 15.0 + (slot - 19.0) / 2.0, y: ly - 4.0, font_size: 10.0,
        fit_width: slot - 19.0, fit_height: 12.0,
        fill: none, id: none, class: ["wdoc-legend"],
      },
    ]
  }))
}

// Grouped bars: category i × series j, scaled to the [ymin, ymax] range.
let chart_bars = fn(series: list<ChartSeries>, px: f64, py: f64, pw: f64, ph: f64, ymin: f64, ymax: f64, ncat: i64) -> list<SvgFundamental>
  flatten(map(range(0, ncat), fn(i: i64) -> list<SvgFundamental>
    map(range(0, len(series)), fn(j: i64) -> SvgFundamental {
      let gw = pw / ncat;
      let bw = gw * 0.8 / len(series);
      let sj = at(series, j);
      let v = at(sj.values, i);
      let bh = ph * (v - ymin) / (ymax - ymin);
      SvgFundamental::Rect {
        x: px + gw * i + gw * 0.1 + bw * j, y: py + ph - bh,
        width: bw, height: bh,
        fill: none, stroke: none, id: none, class: [chart_series_class(j)],
      }
    })))

// X position of point `i` of `ncat` along the plot width.
let chart_line_x = fn(px: f64, pw: f64, i: i64, ncat: i64) -> f64
  if ncat <= 1 { px + pw / 2.0 } else { px + pw * i / (ncat - 1) }

// Polyline (as connected segments) + markers per series.
let chart_lines = fn(series: list<ChartSeries>, px: f64, py: f64, pw: f64, ph: f64, ymin: f64, ymax: f64, ncat: i64) -> list<SvgFundamental>
  flatten(map(range(0, len(series)), fn(j: i64) -> list<SvgFundamental> {
    let sj = at(series, j);
    let cls = chart_series_class(j);
    let segs = map(range(0, ncat - 1), fn(i: i64) -> SvgFundamental {
      let v1 = at(sj.values, i);
      let v2 = at(sj.values, i + 1);
      SvgFundamental::Line {
        x1: chart_line_x(px, pw, i, ncat),
        y1: py + ph - ph * (v1 - ymin) / (ymax - ymin),
        x2: chart_line_x(px, pw, i + 1, ncat),
        y2: py + ph - ph * (v2 - ymin) / (ymax - ymin),
        stroke: none, id: none, class: [cls, "wdoc-line"],
      }
    });
    let marks = map(range(0, ncat), fn(i: i64) -> SvgFundamental {
      let v = at(sj.values, i);
      SvgFundamental::Circle {
        cx: chart_line_x(px, pw, i, ncat),
        cy: py + ph - ph * (v - ymin) / (ymax - ymin),
        r: 2.6, fill: none, stroke: none, id: none, class: [cls],
      }
    });
    flatten([segs, marks])
  }))

// Build an axis frame (title, legend, grid, axes, category + axis
// titles) shared by the bar and line charts. `cats` is already
// resolved to concrete strings and `title`/`xlab`/`ylab` use "" for
// absent.
let chart_frame = fn(
  cx: f64, cy: f64, cw: f64,
  px: f64, py: f64, pw: f64, ph: f64,
  ymin: f64, ymax: f64, ly: f64,
  cats: list<utf8>, title: utf8, xlab: utf8, ylab: utf8,
  series: list<ChartSeries>, has_legend: bool,
) -> list<SvgFundamental>
  flatten([
    chart_title(cx + cw / 2.0, cy, cw, title),
    if has_legend { chart_legend(px, ly, pw, series) } else { [] },
    chart_y_ticks(px, py, pw, ph, ymin, ymax, 4),
    chart_axes(px, py, pw, ph),
    chart_cat_labels(px, py, pw, ph, cats),
    chart_axis_titles(px, py, pw, ph, xlab, ylab),
  ])

// Resolve the shared per-chart inputs (scale, labels, geometry) used by
// both bar and line charts, then dispatch to the data layer `draw`.
let chart_xy = fn(
  cx: f64, cy: f64, cw: f64, ch: f64,
  series: list<ChartSeries>,
  categories: list<utf8>, title: utf8, xlab: utf8, ylab: utf8,
  ymin: f64, ymax: f64,
  draw: fn(list<ChartSeries>, f64, f64, f64, f64, f64, f64, i64) -> list<SvgFundamental>,
) -> list<SvgFundamental> {
  let nser = len(series);
  let ncat = if len(categories) == 0 { chart_ncat(series) } else { len(categories) };
  let cats = if len(categories) == 0 { map(range(0, ncat), fn(i: i64) -> utf8 format("{}", i + 1)) } else { categories };
  let has_legend = nser > 1;
  let title_h = if title == "" { 4.0 } else { 20.0 };
  let legend_h = if has_legend { 16.0 } else { 0.0 };
  let bottom = if xlab == "" { 26.0 } else { 40.0 };
  let px = cx + 40.0;
  let py = cy + title_h + legend_h + 4.0;
  let pw = cw - 52.0;
  let ph = ch - title_h - legend_h - 4.0 - bottom;
  let ly = cy + title_h + 11.0;
  flatten([
    chart_frame(cx, cy, cw, px, py, pw, ph, ymin, ymax, ly, cats, title, xlab, ylab, series, has_legend),
    draw(series, px, py, pw, ph, ymin, ymax, ncat),
  ])
}

@block("bar_chart")
type BarChart extends SvgBlock {
  // Defaults match the `process` convention so `:layered` / `:grid`
  // layout can position the chart via a wrapper transform.
  x = 0.0  y = 0.0  width = 360.0  height = 220.0
  id: identifier?  class: list<utf8>?
  title:      utf8?
  x_label:    utf8?
  y_label:    utf8?
  categories: list<utf8>?
  y_min:      f64?
  y_max:      f64?
  series:     list<ChartSeries>
  connect_points: list<AnchorSide>?

  lower = fn(c: BarChart) -> list<SvgFundamental> {
    let ymin = if c.y_min == none { 0.0 } else { c.y_min };
    let ymax0 = if c.y_max == none { chart_data_max(c.series) } else { c.y_max };
    let ymax = max(ymax0, ymin + 0.000001);
    chart_xy(
      c.x, c.y, c.width, c.height, c.series,
      if c.categories == none { [] } else { c.categories },
      if c.title == none { "" } else { c.title },
      if c.x_label == none { "" } else { c.x_label },
      if c.y_label == none { "" } else { c.y_label },
      ymin, ymax, chart_bars,
    )
  }
}

@block("line_chart")
type LineChart extends SvgBlock {
  x = 0.0  y = 0.0  width = 360.0  height = 220.0
  id: identifier?  class: list<utf8>?
  title:      utf8?
  x_label:    utf8?
  y_label:    utf8?
  categories: list<utf8>?
  y_min:      f64?
  y_max:      f64?
  series:     list<ChartSeries>
  connect_points: list<AnchorSide>?

  lower = fn(c: LineChart) -> list<SvgFundamental> {
    let ymin = if c.y_min == none { 0.0 } else { c.y_min };
    let ymax0 = if c.y_max == none { chart_data_max(c.series) } else { c.y_max };
    let ymax = max(ymax0, ymin + 0.000001);
    chart_xy(
      c.x, c.y, c.width, c.height, c.series,
      if c.categories == none { [] } else { c.categories },
      if c.title == none { "" } else { c.title },
      if c.x_label == none { "" } else { c.x_label },
      if c.y_label == none { "" } else { c.y_label },
      ymin, ymax, chart_lines,
    )
  }
}

// Cumulative-offset / sweep angles per slice, drawn as polygon
// approximations of arcs (centre point + sampled points along the
// edge). Angles are measured clockwise from twelve o'clock.
let chart_slice_values = fn(slices: list<ChartSlice>) -> list<f64>
  map(slices, fn(s: ChartSlice) -> f64 s.value)
let chart_arc = fn(cx: f64, cy: f64, r: f64, a0: f64, sweep: f64, steps: i64) -> utf8
  join(map(range(0, steps + 1), fn(k: i64) -> utf8 {
    let th = a0 + sweep * k / steps;
    format("{},{}", cx + r * sin(th), cy - r * cos(th))
  }), " ")

@block("pie_chart")
type PieChart extends SvgBlock {
  x = 0.0  y = 0.0  width = 240.0  height = 240.0
  id: identifier?  class: list<utf8>?
  title:  utf8?
  slices: list<ChartSlice>
  connect_points: list<AnchorSide>?

  lower = fn(c: PieChart) -> list<SvgFundamental> {
    let title = if c.title == none { "" } else { c.title };
    let title_h = if title == "" { 4.0 } else { 22.0 };
    let vals = chart_slice_values(c.slices);
    let total = max(sum(vals), 0.000001);
    let avail_h = c.height - title_h;
    let cx = c.x + c.width / 2.0;
    let cy = c.y + title_h + avail_h / 2.0;
    let r = min(c.width, avail_h) / 2.0 * 0.86;
    flatten([
      chart_title(c.x + c.width / 2.0, c.y, c.width, title),
      flatten(map(range(0, len(c.slices)), fn(i: i64) -> list<SvgFundamental> {
        let si = at(c.slices, i);
        let prefix = take(vals, i);
        let cum = if len(prefix) == 0 { 0.0 } else { sum(prefix) };
        let a0 = cum / total * tau();
        let sweep = si.value / total * tau();
        let mid = a0 + sweep / 2.0;
        [
          SvgFundamental::Polygon {
            points: format("{},{} {}", cx, cy, chart_arc(cx, cy, r, a0, sweep, 48)),
            fill: none, stroke: none, id: none, class: [chart_series_class(i)],
          },
          SvgFundamental::Label {
            content: si.label,
            x: cx + r * 0.62 * sin(mid),
            y: cy - r * 0.62 * cos(mid),
            font_size: 10.0, fit_width: 64.0, fit_height: 12.0,
            fill: none, id: none, class: ["wdoc-legend"],
          },
        ]
      })),
    ])
  }
}

// ── Stdlib headings ────────────────────────────────────────────────

@block("h1")
type H1 extends WdocBlock {
  @inline(0) text: utf8
  id: identifier?
  lower = fn(h: H1) -> list<HtmlFundamental> [
    HtmlFundamental::Paragraph { id: h.id, class: ["heading-1"], spans: [h.text] }
  ]
}

@block("h2")
type H2 extends WdocBlock {
  @inline(0) text: utf8
  id: identifier?
  lower = fn(h: H2) -> list<HtmlFundamental> [
    HtmlFundamental::Paragraph { id: h.id, class: ["heading-2"], spans: [h.text] }
  ]
}

