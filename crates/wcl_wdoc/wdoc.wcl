// Fundamental block schema for `wdoc`. These are the IR layer that
// the HTML renderer (and future targets) speak; higher-level blocks
// will land later and lower to these via a transform pipeline.
//
// The wdoc binary prepends this to the user's source in memory before
// parsing.

@document
type Site {
  @children("class")          classes:  list<Class>
  @children("page")           pages:    list<Page>
  @children("inline_pattern") patterns: list<InlinePattern>
}

// Renderable-block interfaces. `WdocBlock` is the page-level domain
// (renders to HTML today; could target other formats later).
// `SvgBlock` is the diagram-level domain. User-authored block types
// opt in with `extends WdocBlock` / `extends SvgBlock` to become
// legal children of the corresponding `@children(...)` slot.
//
// Each interface requires a `lower` field — a function the renderer
// calls to turn the block into a list of fundamental variants. The
// interface signature uses `&Interface` as the parameter; concrete
// types are free to narrow the parameter to their own type
// (function-typed interface fields match on return type only).
// Implementations supply the function via `@default(fn(...) -> ...)`
// so per-instance overrides are possible but never required.
interface WdocBlock {
  id:    identifier?
  lower: fn(&WdocBlock) -> list<HtmlFundamental>
}
interface SvgBlock {
  id:    identifier?
  lower: fn(&SvgBlock) -> list<SvgFundamental>
}

// Default connection schema for diagrams. Any pair of SvgBlocks may
// be connected; renderers draw an arrow from source to destination
// using the resolved bounding boxes of the named shapes. User code
// may declare its own `connection ... : ... : ...` and consume it
// via `@connections(MyEdge)` for custom rendering.
symbol_set EdgeKind { default flow data }
connection Edge: &SvgBlock -> &SvgBlock : EdgeKind

// Edge-anchor sides for connection rendering. Each renderable SVG
// shape declares zero or more sides via `connect_points`; the
// renderer maps each side to the mid-point of the corresponding
// bounding-box edge and picks the closest source/destination pair
// when drawing an arrow. Default (field omitted) = all four sides.
symbol_set AnchorSide { north east south west }

// Connection routing strategy for a diagram's edges.
//   :elbow    (default) — orthogonal multi-bend polyline that
//                         routes around other shapes via A*.
//   :straight           — single line directly between anchors.
symbol_set EdgeRouting { elbow straight }

// Auto-layout direction. Only used when `layout = :layered`.
//   :top_to_bottom (default) — ranks stack downward.
//   :left_to_right           — ranks stack rightward.
symbol_set LayoutDirection { top_to_bottom left_to_right }

@block("page")
type Page {
  @inline(0) name: identifier
  id: identifier?
  @children(WdocBlock) children: list<WdocBlock>
}

// Style bundle. Referenced from any IR block's `class: list<utf8>?`
// field; each entry names a class by its inline identifier. Classes
// are document-global and emitted as `.name { ... }` rules in the
// page <style> block.
@block("class")
type Class {
  @inline(0) name: identifier

  // Text styling
  color:       utf8?
  background:  utf8?
  bold:        bool?
  italic:      bool?
  underline:   bool?

  // Sizing / alignment
  font_size:   utf8?
  font_family: utf8?
  text_align:  utf8?

  // Layout
  padding:     utf8?
  margin:      utf8?
  border:      utf8?
}

// Paragraph — children are spans rendered in source order.
@block("text")
type Text extends WdocBlock {
  id:    identifier?
  class: list<utf8>?
  @children("span") spans: list<Span>
  // `text` is itself a fundamental HTML block — the renderer never
  // invokes its `lower`. Declared only to satisfy the interface.
  lower = fn(t: Text) -> list<HtmlFundamental> []
}

// Inline run inside a `text`. Style fields beyond `class` are
// intentionally absent — style flows through @block("class") rules.
@block("span")
type Span {
  @inline(0) text: utf8
  id:    identifier?
  class: list<utf8>?
}

// Grid container. `widths` are CSS percentages, one per child slot;
// children flow in source order across the slots.
@block("column")
type Column extends WdocBlock {
  widths: list<f64>
  id:     identifier?
  class:  list<utf8>?
  @children(WdocBlock) children: list<WdocBlock>
  lower = fn(c: Column) -> list<HtmlFundamental> []
}

// SVG canvas. Width/height define the viewBox and rendered size,
// and the parent box for diagram-level anchored shapes.
@block("diagram")
type Diagram extends WdocBlock {
  width:  i64
  height: i64
  id:     identifier?
  class:  list<utf8>?

  // Layout: :none (default) honors per-shape x/y; :grid uses the
  // grid-cell knobs (cell_width/cell_height/columns/gap), same as
  // Container; :layered topologically ranks shapes via the
  // diagram's @connections(Edge) graph and assigns x/y.
  layout:      symbol?
  direction:   symbol?      // :top_to_bottom (default) | :left_to_right
  layer_gap:   f64?         // gap between ranks
  node_gap:    f64?         // gap between nodes within a rank
  cell_width:  f64?
  cell_height: f64?
  columns:     i64?
  gap:         f64?

  // Edge rendering.
  routing:         symbol?  // :elbow (default) | :straight
  edge_separation: f64?     // nudge step for parallel edges (default 4)

  @children(SvgBlock) children: list<SvgBlock>
  @connections(Edge) edges: list<Edge>
  lower = fn(d: Diagram) -> list<HtmlFundamental> []
}

// SVG <g> group with optional layout. Layout modes:
//   :none    (default) — children render at their own resolved boxes.
//   :grid              — children are placed into a `columns × rows`
//                        grid; each cell is `cell_width × cell_height`
//                        separated by `gap`. Per-cell child receives
//                        `(cell_width, cell_height)` as its parent
//                        size, so anchored children stretch to the
//                        cell.
//   :layered           — topological rank from the container's
//                        @connections(Edge) graph; each rank is
//                        spaced by `layer_gap`, nodes within a
//                        rank by `node_gap`. Flow direction is
//                        controlled by `direction` (default
//                        :top_to_bottom). Per-shape width/height
//                        are honored.
// Anchors on the container itself resolve against the parent box and
// can resize the container; that new size flows to its own children.
@block("container")
type Container extends SvgBlock {
  id:    identifier?
  class: list<utf8>?

  // Optional chrome. When either is set the renderer emits a
  // background <rect> the full size of the container's box,
  // making the grouping visible. The chrome is purely visual —
  // it does NOT participate in obstacle routing, so cross-
  // container edges still pass through cleanly.
  stroke: utf8?
  fill:   utf8?

  // Inset applied to children. Grows the container's outer box
  // by 2*padding on each axis and shifts the children inward
  // by `padding`, so chrome doesn't touch the shapes inside.
  padding: f64?

  // Declared interior size (used when no layout/anchor is sizing
  // this container — e.g. a top-level container in a diagram).
  width:  f64?
  height: f64?

  // Layout
  layout:      symbol?
  columns:     i64?
  cell_width:  f64?
  cell_height: f64?
  gap:         f64?
  direction:   symbol?    // :top_to_bottom (default) | :left_to_right
  layer_gap:   f64?
  node_gap:    f64?

  // Anchors (resolve against the parent's box).
  anchor_left:   f64?
  anchor_right:  f64?
  anchor_top:    f64?
  anchor_bottom: f64?

  connect_points: list<AnchorSide>?

  @children(SvgBlock) children: list<SvgBlock>
  @connections(Edge) edges: list<Edge>
  // `container` is itself rendered directly as <g>; the renderer
  // never invokes its `lower`. Declared only to satisfy the interface.
  lower = fn(c: Container) -> list<SvgFundamental> []
}

@block("rect")
type Rect extends SvgBlock {
  x:      f64?
  y:      f64?
  width:  f64?
  height: f64?
  fill:   utf8?
  stroke: utf8?
  id:     identifier?
  class:  list<utf8>?

  anchor_left:   f64?
  anchor_right:  f64?
  anchor_top:    f64?
  anchor_bottom: f64?

  connect_points: list<AnchorSide>?

  lower = fn(r: Rect) -> list<SvgFundamental> []
}

@block("circle")
type Circle extends SvgBlock {
  cx:     f64?
  cy:     f64?
  r:      f64?
  fill:   utf8?
  stroke: utf8?
  id:     identifier?
  class:  list<utf8>?

  anchor_left:   f64?
  anchor_right:  f64?
  anchor_top:    f64?
  anchor_bottom: f64?

  connect_points: list<AnchorSide>?

  lower = fn(c: Circle) -> list<SvgFundamental> []
}

@block("line")
type Line extends SvgBlock {
  x1:     f64?
  y1:     f64?
  x2:     f64?
  y2:     f64?
  stroke: utf8?
  id:     identifier?
  class:  list<utf8>?

  anchor_left:   f64?
  anchor_right:  f64?
  anchor_top:    f64?
  anchor_bottom: f64?

  connect_points: list<AnchorSide>?

  lower = fn(l: Line) -> list<SvgFundamental> []
}

// SVG <text> shape. Renamed from `text` to avoid colliding with the
// paragraph block kind.
@block("label")
type Label extends SvgBlock {
  @inline(0) content: utf8
  x:     f64?
  y:     f64?
  // Optional font-size override. When unset, the renderer picks a
  // size that fits `content` inside `fit_width` × `fit_height`
  // (capped at the renderer's default), or its default for a
  // stand-alone label with no fit region.
  font_size:  f64?
  fit_width:  f64?
  fit_height: f64?
  fill:  utf8?
  id:    identifier?
  class: list<utf8>?

  anchor_left:   f64?
  anchor_right:  f64?
  anchor_top:    f64?
  anchor_bottom: f64?

  connect_points: list<AnchorSide>?

  lower = fn(l: Label) -> list<SvgFundamental> []
}

@block("polygon")
type Polygon extends SvgBlock {
  points: utf8
  fill:   utf8?
  stroke: utf8?
  id:     identifier?
  class:  list<utf8>?

  anchor_left:   f64?
  anchor_right:  f64?
  anchor_top:    f64?
  anchor_bottom: f64?

  connect_points: list<AnchorSide>?

  lower = fn(p: Polygon) -> list<SvgFundamental> []
}

// ── Lowering layer ─────────────────────────────────────────────────
//
// Custom shapes ship as a `@block` declaration + a top-level
// `<kind>_lower` function returning `list<SvgFundamental>` (SVG
// diagram shapes) or `list<HtmlFundamental>` (page-level blocks).
// The renderer recursively lowers each returned variant until only
// fundamentals remain. Users add their own shapes by declaring the
// same pair in user source.

union SvgFundamental {
  Rect    { x: f64? y: f64? width: f64? height: f64? fill: utf8? stroke: utf8? id: identifier? class: list<utf8>? }
  Circle  { cx: f64? cy: f64? r: f64? fill: utf8? stroke: utf8? id: identifier? class: list<utf8>? }
  Line    { x1: f64? y1: f64? x2: f64? y2: f64? stroke: utf8? id: identifier? class: list<utf8>? }
  Label   { content: utf8 x: f64? y: f64? font_size: f64? fit_width: f64? fit_height: f64? fill: utf8? id: identifier? class: list<utf8>? }
  Polygon { points: utf8 fill: utf8? stroke: utf8? id: identifier? class: list<utf8>? }
}

union HtmlFundamental {
  Paragraph { id: identifier? class: list<utf8>? spans: list<utf8> }
}

// Inline parsed-text variants produced by `inline_pattern` blocks.
// The renderer dispatches Plain to `<span class="...">…</span>` and
// Link to `<a href="…" class="…">…</a>`. The `text` field of each
// variant is re-tokenized through the pattern engine (with a depth
// cap) so a Bold match can contain an Italic span inside.
union InlineSpan {
  Plain { text: utf8 class: list<utf8>? }
  Link  { text: utf8 href: utf8 class: list<utf8>? }
}

// Regex-driven inline parser. The `pattern` field holds a regex;
// when the renderer tokenizes a span's text, every match is handed
// to `to_span` (with the regex's captured groups as `list<utf8>`,
// group 0 = whole match, group 1+ = subgroups in order) which
// returns a list of InlineSpan variants. Built-in patterns ship in
// this schema; users add their own by declaring more
// `inline_pattern <name> { ... }` blocks in user `.wcl`.
@block("inline_pattern")
type InlinePattern {
  @inline(0) name: identifier
  pattern: utf8
  to_span: fn(list<utf8>) -> list<InlineSpan>
}

// ── Stdlib flowchart shapes ────────────────────────────────────────
//
// Each custom shape supplies its lowering via `@default` on the
// `lower` field. The renderer calls `block.field("lower")` (or the
// schema default if the instance didn't override) and recursively
// renders the variants it returns. Per-instance overrides work
// transparently — set `lower = fn(...) -> ...` on a particular block
// and that supersedes the default for just that instance.

@block("process")
type Process extends SvgBlock {
  @inline(0) text: utf8
  // Defaults let `:layered` layout position these shapes via a
  // wrapper transform: the child renders at (0,0) of its assigned
  // cell rather than failing the lowering when x/y are omitted.
  x = 0.0  y = 0.0  width = 80.0  height = 40.0
  fill: utf8?  stroke: utf8?  id: identifier?  class: list<utf8>?
  connect_points: list<AnchorSide>?

  lower = fn(p: Process) -> list<SvgFundamental> [
    SvgFundamental::Rect {
      x: p.x, y: p.y, width: p.width, height: p.height,
      fill: p.fill, stroke: p.stroke, id: p.id, class: p.class,
    },
    SvgFundamental::Label {
      content: p.text,
      x: p.x + p.width / 2.0,
      y: p.y + p.height / 2.0,
      font_size: none,
      fit_width: p.width,  fit_height: p.height,
      fill: none, id: none, class: p.class,
    },
  ]
}

@block("decision")
type Decision extends SvgBlock {
  @inline(0) text: utf8
  x = 0.0  y = 0.0  width = 80.0  height = 40.0
  fill: utf8?  stroke: utf8?  id: identifier?  class: list<utf8>?
  connect_points: list<AnchorSide>?

  lower = fn(d: Decision) -> list<SvgFundamental> [
    SvgFundamental::Polygon {
      points: format(
        "{},{} {},{} {},{} {},{}",
        d.x + d.width / 2.0, d.y,
        d.x + d.width,       d.y + d.height / 2.0,
        d.x + d.width / 2.0, d.y + d.height,
        d.x,                 d.y + d.height / 2.0,
      ),
      fill: d.fill, stroke: d.stroke, id: d.id, class: d.class,
    },
    SvgFundamental::Label {
      content: d.text,
      x: d.x + d.width / 2.0,
      y: d.y + d.height / 2.0,
      font_size: none,
      // Diamond's text region is smaller than its bbox — the
      // inscribed rect at the middle is roughly half the width
      // and full height; halve fit_width so long labels shrink
      // before they hit the diamond's sloped edges.
      fit_width: d.width / 2.0,  fit_height: d.height,
      fill: none, id: none, class: d.class,
    },
  ]
}

// Terminator: rounded-corner rect is a single Rect for now — true
// rounded corners come when SvgFundamental::Rect grows an `rx` field.
@block("terminator")
type Terminator extends SvgBlock {
  @inline(0) text: utf8
  x = 0.0  y = 0.0  width = 80.0  height = 40.0
  fill: utf8?  stroke: utf8?  id: identifier?  class: list<utf8>?
  connect_points: list<AnchorSide>?

  lower = fn(t: Terminator) -> list<SvgFundamental> [
    SvgFundamental::Rect {
      x: t.x, y: t.y, width: t.width, height: t.height,
      fill: t.fill, stroke: t.stroke, id: t.id, class: t.class,
    },
    SvgFundamental::Label {
      content: t.text,
      x: t.x + t.width / 2.0,
      y: t.y + t.height / 2.0,
      font_size: none,
      fit_width: t.width,  fit_height: t.height,
      fill: none, id: none, class: t.class,
    },
  ]
}

// ── Stdlib headings ────────────────────────────────────────────────

@block("h1")
type H1 extends WdocBlock {
  @inline(0) text: utf8
  id: identifier?
  lower = fn(h: H1) -> list<HtmlFundamental> [
    HtmlFundamental::Paragraph { id: h.id, class: ["heading-1"], spans: [h.text] }
  ]
}

@block("h2")
type H2 extends WdocBlock {
  @inline(0) text: utf8
  id: identifier?
  lower = fn(h: H2) -> list<HtmlFundamental> [
    HtmlFundamental::Paragraph { id: h.id, class: ["heading-2"], spans: [h.text] }
  ]
}

@block("h3")
type H3 extends WdocBlock {
  @inline(0) text: utf8
  id: identifier?
  lower = fn(h: H3) -> list<HtmlFundamental> [
    HtmlFundamental::Paragraph { id: h.id, class: ["heading-3"], spans: [h.text] }
  ]
}

@block("h4")
type H4 extends WdocBlock {
  @inline(0) text: utf8
  id: identifier?
  lower = fn(h: H4) -> list<HtmlFundamental> [
    HtmlFundamental::Paragraph { id: h.id, class: ["heading-4"], spans: [h.text] }
  ]
}

@block("h5")
type H5 extends WdocBlock {
  @inline(0) text: utf8
  id: identifier?
  lower = fn(h: H5) -> list<HtmlFundamental> [
    HtmlFundamental::Paragraph { id: h.id, class: ["heading-5"], spans: [h.text] }
  ]
}

@block("h6")
type H6 extends WdocBlock {
  @inline(0) text: utf8
  id: identifier?
  lower = fn(h: H6) -> list<HtmlFundamental> [
    HtmlFundamental::Paragraph { id: h.id, class: ["heading-6"], spans: [h.text] }
  ]
}

// ── Stdlib code block ──────────────────────────────────────────────
//
// Syntax-highlighted source listing. Unlike the heading shapes
// above, `code` has no `lower` field: the renderer special-cases
// it because the per-token colouring is produced in Rust by
// syntect rather than expressible in WCL. The `language` tag picks
// the grammar (`rust`, `python`, `wcl`, …); an unknown tag falls
// back to plain-text rendering.

@block("code")
type Code extends WdocBlock {
  @inline(0) language: identifier
  source: utf8
  id:     identifier?
  class:  list<utf8>?
  // Declared only to satisfy the WdocBlock interface — the
  // renderer never calls this; highlighting happens in Rust.
  lower = fn(c: Code) -> list<HtmlFundamental> []
}

// ── Built-in inline patterns ───────────────────────────────────────
//
// Each pattern's `to_span` receives the captured groups as a list,
// with index 0 = the whole matched string and 1+ = the regex's
// explicit capture groups. The `at(list, i)` builtin reads a
// specific index. The renderer applies these to every `span`
// block's text and re-tokenizes the result with a depth cap so
// patterns can nest.

inline_pattern bold {
  pattern = "\\*\\*([^*\n]+)\\*\\*"
  to_span = fn(g: list<utf8>) -> list<InlineSpan>
    [InlineSpan::Plain { text: at(g, 1), class: ["bold"] }]
}

inline_pattern italic {
  pattern = "_([^_\n]+)_"
  to_span = fn(g: list<utf8>) -> list<InlineSpan>
    [InlineSpan::Plain { text: at(g, 1), class: ["italic"] }]
}

inline_pattern code {
  pattern = "`([^`\n]+)`"
  to_span = fn(g: list<utf8>) -> list<InlineSpan>
    [InlineSpan::Plain { text: at(g, 1), class: ["code"] }]
}

inline_pattern link {
  pattern = "\\[([^\\]]+)\\]\\(([^)]+)\\)"
  to_span = fn(g: list<utf8>) -> list<InlineSpan>
    [InlineSpan::Link { text: at(g, 1), href: at(g, 2), class: none }]
}
