// Fundamental block schema for `wdoc`. These are the IR layer that
// the HTML renderer (and future targets) speak; higher-level blocks
// will land later and lower to these via a transform pipeline.
//
// The wdoc binary prepends this to the user's source in memory before
// parsing.

@document
type Site {
  @children("class") classes: list<Class>
  @children("page")  pages:   list<Page>
}

// Renderable-block interfaces. `WdocBlock` is the page-level domain
// (renders to HTML today; could target other formats later).
// `SvgBlock` is the diagram-level domain. User-authored block types
// opt in with `extends WdocBlock` / `extends SvgBlock` to become
// legal children of the corresponding `@children(...)` slot.
//
// Each interface requires a `lower` field — a function the renderer
// calls to turn the block into a list of fundamental variants. The
// interface signature uses `&Interface` as the parameter; concrete
// types are free to narrow the parameter to their own type
// (function-typed interface fields match on return type only).
// Implementations supply the function via `@default(fn(...) -> ...)`
// so per-instance overrides are possible but never required.
interface WdocBlock {
  id:    identifier?
  lower: fn(&WdocBlock) -> list<HtmlFundamental>
}
interface SvgBlock {
  id:    identifier?
  lower: fn(&SvgBlock) -> list<SvgFundamental>
}

// Default connection schema for diagrams. Any pair of SvgBlocks may
// be connected; renderers draw an arrow from source to destination
// using the resolved bounding boxes of the named shapes. User code
// may declare its own `connection ... : ... : ...` and consume it
// via `@connections(MyEdge)` for custom rendering.
symbol_set EdgeKind { default flow data }
connection Edge: &SvgBlock -> &SvgBlock : EdgeKind

@block("page")
type Page {
  @inline(0) name: identifier
  id: identifier?
  @children(WdocBlock) children: list<WdocBlock>
}

// Style bundle. Referenced from any IR block's `class: list<utf8>?`
// field; each entry names a class by its inline identifier. Classes
// are document-global and emitted as `.name { ... }` rules in the
// page <style> block.
@block("class")
type Class {
  @inline(0) name: identifier

  // Text styling
  color:       utf8?
  background:  utf8?
  bold:        bool?
  italic:      bool?
  underline:   bool?

  // Sizing / alignment
  font_size:   utf8?
  font_family: utf8?
  text_align:  utf8?

  // Layout
  padding:     utf8?
  margin:      utf8?
  border:      utf8?
}

// Paragraph — children are spans rendered in source order.
@block("text")
type Text extends WdocBlock {
  id:    identifier?
  class: list<utf8>?
  @children("span") spans: list<Span>
  // `text` is itself a fundamental HTML block — the renderer never
  // invokes its `lower`. Declared only to satisfy the interface.
  lower = fn(t: Text) -> list<HtmlFundamental> []
}

// Inline run inside a `text`. Style fields beyond `class` are
// intentionally absent — style flows through @block("class") rules.
@block("span")
type Span {
  @inline(0) text: utf8
  id:    identifier?
  class: list<utf8>?
}

// Grid container. `widths` are CSS percentages, one per child slot;
// children flow in source order across the slots.
@block("column")
type Column extends WdocBlock {
  widths: list<f64>
  id:     identifier?
  class:  list<utf8>?
  @children(WdocBlock) children: list<WdocBlock>
  lower = fn(c: Column) -> list<HtmlFundamental> []
}

// SVG canvas. Width/height define the viewBox and rendered size,
// and the parent box for diagram-level anchored shapes.
@block("diagram")
type Diagram extends WdocBlock {
  width:  i64
  height: i64
  id:     identifier?
  class:  list<utf8>?
  @children(SvgBlock) children: list<SvgBlock>
  @connections(Edge) edges: list<Edge>
  lower = fn(d: Diagram) -> list<HtmlFundamental> []
}

// SVG <g> group with optional layout. Layout modes:
//   :none  (default) — children render at their own resolved boxes.
//   :grid            — children are placed into a `columns × rows`
//                      grid; each cell is `cell_width × cell_height`
//                      separated by `gap`. Per-cell child receives
//                      `(cell_width, cell_height)` as its parent
//                      size, so anchored children stretch to the
//                      cell.
// Anchors on the container itself resolve against the parent box and
// can resize the container; that new size flows to its own children.
@block("container")
type Container extends SvgBlock {
  id:    identifier?
  class: list<utf8>?

  // Declared interior size (used when no layout/anchor is sizing
  // this container — e.g. a top-level container in a diagram).
  width:  f64?
  height: f64?

  // Layout
  layout:      symbol?
  columns:     i64?
  cell_width:  f64?
  cell_height: f64?
  gap:         f64?

  // Anchors (resolve against the parent's box).
  anchor_left:   f64?
  anchor_right:  f64?
  anchor_top:    f64?
  anchor_bottom: f64?

  @children(SvgBlock) children: list<SvgBlock>
  // `container` is itself rendered directly as <g>; the renderer
  // never invokes its `lower`. Declared only to satisfy the interface.
  lower = fn(c: Container) -> list<SvgFundamental> []
}

@block("rect")
type Rect extends SvgBlock {
  x:      f64?
  y:      f64?
  width:  f64?
  height: f64?
  fill:   utf8?
  stroke: utf8?
  id:     identifier?
  class:  list<utf8>?

  anchor_left:   f64?
  anchor_right:  f64?
  anchor_top:    f64?
  anchor_bottom: f64?

  lower = fn(r: Rect) -> list<SvgFundamental> []
}

@block("circle")
type Circle extends SvgBlock {
  cx:     f64?
  cy:     f64?
  r:      f64?
  fill:   utf8?
  stroke: utf8?
  id:     identifier?
  class:  list<utf8>?

  anchor_left:   f64?
  anchor_right:  f64?
  anchor_top:    f64?
  anchor_bottom: f64?

  lower = fn(c: Circle) -> list<SvgFundamental> []
}

@block("line")
type Line extends SvgBlock {
  x1:     f64?
  y1:     f64?
  x2:     f64?
  y2:     f64?
  stroke: utf8?
  id:     identifier?
  class:  list<utf8>?

  anchor_left:   f64?
  anchor_right:  f64?
  anchor_top:    f64?
  anchor_bottom: f64?

  lower = fn(l: Line) -> list<SvgFundamental> []
}

// SVG <text> shape. Renamed from `text` to avoid colliding with the
// paragraph block kind.
@block("label")
type Label extends SvgBlock {
  @inline(0) content: utf8
  x:     f64?
  y:     f64?
  fill:  utf8?
  id:    identifier?
  class: list<utf8>?

  anchor_left:   f64?
  anchor_right:  f64?
  anchor_top:    f64?
  anchor_bottom: f64?

  lower = fn(l: Label) -> list<SvgFundamental> []
}

@block("polygon")
type Polygon extends SvgBlock {
  points: utf8
  fill:   utf8?
  stroke: utf8?
  id:     identifier?
  class:  list<utf8>?

  anchor_left:   f64?
  anchor_right:  f64?
  anchor_top:    f64?
  anchor_bottom: f64?

  lower = fn(p: Polygon) -> list<SvgFundamental> []
}

// ── Lowering layer ─────────────────────────────────────────────────
//
// Custom shapes ship as a `@block` declaration + a top-level
// `<kind>_lower` function returning `list<SvgFundamental>` (SVG
// diagram shapes) or `list<HtmlFundamental>` (page-level blocks).
// The renderer recursively lowers each returned variant until only
// fundamentals remain. Users add their own shapes by declaring the
// same pair in user source.

union SvgFundamental {
  Rect    { x: f64? y: f64? width: f64? height: f64? fill: utf8? stroke: utf8? id: identifier? class: list<utf8>? }
  Circle  { cx: f64? cy: f64? r: f64? fill: utf8? stroke: utf8? id: identifier? class: list<utf8>? }
  Line    { x1: f64? y1: f64? x2: f64? y2: f64? stroke: utf8? id: identifier? class: list<utf8>? }
  Label   { content: utf8 x: f64? y: f64? fill: utf8? id: identifier? class: list<utf8>? }
  Polygon { points: utf8 fill: utf8? stroke: utf8? id: identifier? class: list<utf8>? }
}

union HtmlFundamental {
  Paragraph { id: identifier? class: list<utf8>? spans: list<utf8> }
}

// ── Stdlib flowchart shapes ────────────────────────────────────────
//
// Each custom shape supplies its lowering via `@default` on the
// `lower` field. The renderer calls `block.field("lower")` (or the
// schema default if the instance didn't override) and recursively
// renders the variants it returns. Per-instance overrides work
// transparently — set `lower = fn(...) -> ...` on a particular block
// and that supersedes the default for just that instance.

@block("process")
type Process extends SvgBlock {
  @inline(0) text: utf8
  x: f64?  y: f64?  width: f64?  height: f64?
  fill: utf8?  stroke: utf8?  id: identifier?  class: list<utf8>?

  lower = fn(p: Process) -> list<SvgFundamental> [
    SvgFundamental::Rect {
      x: p.x, y: p.y, width: p.width, height: p.height,
      fill: p.fill, stroke: p.stroke, id: p.id, class: p.class,
    },
    SvgFundamental::Label {
      content: p.text,
      x: p.x + p.width / 2.0,
      y: p.y + p.height / 2.0,
      fill: none, id: none, class: p.class,
    },
  ]
}

@block("decision")
type Decision extends SvgBlock {
  @inline(0) text: utf8
  x: f64?  y: f64?  width: f64?  height: f64?
  fill: utf8?  stroke: utf8?  id: identifier?  class: list<utf8>?

  lower = fn(d: Decision) -> list<SvgFundamental> [
    SvgFundamental::Polygon {
      points: format(
        "{},{} {},{} {},{} {},{}",
        d.x + d.width / 2.0, d.y,
        d.x + d.width,       d.y + d.height / 2.0,
        d.x + d.width / 2.0, d.y + d.height,
        d.x,                 d.y + d.height / 2.0,
      ),
      fill: d.fill, stroke: d.stroke, id: d.id, class: d.class,
    },
    SvgFundamental::Label {
      content: d.text,
      x: d.x + d.width / 2.0,
      y: d.y + d.height / 2.0,
      fill: none, id: none, class: d.class,
    },
  ]
}

// Terminator: rounded-corner rect is a single Rect for now — true
// rounded corners come when SvgFundamental::Rect grows an `rx` field.
@block("terminator")
type Terminator extends SvgBlock {
  @inline(0) text: utf8
  x: f64?  y: f64?  width: f64?  height: f64?
  fill: utf8?  stroke: utf8?  id: identifier?  class: list<utf8>?

  lower = fn(t: Terminator) -> list<SvgFundamental> [
    SvgFundamental::Rect {
      x: t.x, y: t.y, width: t.width, height: t.height,
      fill: t.fill, stroke: t.stroke, id: t.id, class: t.class,
    },
    SvgFundamental::Label {
      content: t.text,
      x: t.x + t.width / 2.0,
      y: t.y + t.height / 2.0,
      fill: none, id: none, class: t.class,
    },
  ]
}

// ── Stdlib headings ────────────────────────────────────────────────

@block("h1")
type H1 extends WdocBlock {
  @inline(0) text: utf8
  id: identifier?
  lower = fn(h: H1) -> list<HtmlFundamental> [
    HtmlFundamental::Paragraph { id: h.id, class: ["heading-1"], spans: [h.text] }
  ]
}

@block("h2")
type H2 extends WdocBlock {
  @inline(0) text: utf8
  id: identifier?
  lower = fn(h: H2) -> list<HtmlFundamental> [
    HtmlFundamental::Paragraph { id: h.id, class: ["heading-2"], spans: [h.text] }
  ]
}

@block("h3")
type H3 extends WdocBlock {
  @inline(0) text: utf8
  id: identifier?
  lower = fn(h: H3) -> list<HtmlFundamental> [
    HtmlFundamental::Paragraph { id: h.id, class: ["heading-3"], spans: [h.text] }
  ]
}

@block("h4")
type H4 extends WdocBlock {
  @inline(0) text: utf8
  id: identifier?
  lower = fn(h: H4) -> list<HtmlFundamental> [
    HtmlFundamental::Paragraph { id: h.id, class: ["heading-4"], spans: [h.text] }
  ]
}

@block("h5")
type H5 extends WdocBlock {
  @inline(0) text: utf8
  id: identifier?
  lower = fn(h: H5) -> list<HtmlFundamental> [
    HtmlFundamental::Paragraph { id: h.id, class: ["heading-5"], spans: [h.text] }
  ]
}

@block("h6")
type H6 extends WdocBlock {
  @inline(0) text: utf8
  id: identifier?
  lower = fn(h: H6) -> list<HtmlFundamental> [
    HtmlFundamental::Paragraph { id: h.id, class: ["heading-6"], spans: [h.text] }
  ]
}
