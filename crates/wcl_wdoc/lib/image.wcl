// ── Image ───────────────────────────────────────────────────────────
//
// A raster image, usable two ways from one block:
//   - on a page (`extends WdocBlock`)   → an `<img>`
//   - inside a `diagram` / `container`  → a placeable SVG `<image>`
// `source` is a path relative to the doc (copied into `_wdoc/` and
// referenced by URL, so it resolves when *served*, not when opened
// directly from disk) or an external URL / `data:` URI (passed through
// unchanged). Like
// `icon` / `tilemap` it's special-cased in the renderer — the asset copy,
// path rewrite, and natural-size reading aren't expressible in WCL — so
// the `lower` is a never-called stub.
@block("image")
type Image extends WdocBlock, SvgBlock {
  @doc("Image source (the inline label): a doc-relative path, a URL, or a `data:` URI.")
  @inline(0) source: utf8
  @doc("Alt text for the `<img>` (page form).")
  alt:    utf8?
  @doc("Display width; the natural size is used when omitted.")
  width:  f64?
  @doc("Display height; the natural size is used when omitted.")
  height: f64?
  @doc("Optional explicit HTML id.")
  id:     identifier?
  @doc("Optional style classes.")
  class:  list<utf8>?

  // Diagram placement (ignored on a page), mirroring `icon` / `tilemap`.
  @doc("Placement x when used inside a diagram (ignored on a page).")
  x = 0.0
  @doc("Placement y when used inside a diagram (ignored on a page).")
  y = 0.0
  @doc("Extra size multiplier (diagram form).")
  scale: f64?
  @doc("Diagram anchor insets (left/right/top/bottom), like any shape.")
  anchor_left: f64?
  @hidden anchor_right: f64?
  @hidden anchor_top: f64?
  @hidden anchor_bottom: f64?
  @doc("Diagram edge-attach sides, like any shape.")
  connect_points: list<AnchorSide>?

  lower = fn(i: Image) -> list<HtmlFundamental> []
}

// Responsive default for page images. `img.wdoc-image` is an
// element+class selector (not a bare class), so it's a `stylesheet` rather
// than a `class`; a user `class` on the image still cascades over it.
stylesheet "wdoc-image" {
  css = <<CSS
    img.wdoc-image { max-width: 100%; height: auto; }
    CSS
}
