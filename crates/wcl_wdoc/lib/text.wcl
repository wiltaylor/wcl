// Paragraph — an optional inline label plus spans rendered in source
// order. Lowers to a `Content::Paragraph`, the semantic content IR's
// body-prose node, so every backend renders it from one declaration; the
// prose runs through the inline-pattern engine there, exactly as it did
// through the `Inline` fundamental before. The label slot matters beyond
// convenience: inside HTML bodies rendered by Rust hosts (card bodies,
// node_table rows), `text "…"` is the natural authoring form — without
// the slot the label silently vanished.
//
// **A span's `id` / `class` do not reach the IR.** The content IR carries
// prose as a string, not a list of styled runs, so the label and the
// spans concatenate into one paragraph. Outside HTML this changes
// nothing — the Markdown and PDF walkers already flattened a `text` to
// its concatenated child text and dropped the `<span>` wrappers — but in
// the book a `span "…" { class = ["accent"] }` no longer paints. The
// inline-run concept the IR needs to carry it back is its own piece of
// work; the fields stay declared so existing documents keep validating.
namespace wdoc

@block("text")
type Text extends WdocBlock {
  @doc("Optional single-run text (the inline label slot); inline patterns are applied. Use `span` children for styled runs.")
  @inline(0) text: utf8?
  @doc("Optional explicit HTML id.")
  id:    identifier?
  @doc("Optional class list applied to the paragraph.")
  class: list<utf8>?
  @doc("The segments, concatenated into the paragraph's prose in source order.")
  @children("span") spans: list<Span>
  lower = fn(t: Text) -> list<Content> [
    Content::Paragraph {
      text: join(flatten([
        match t.text { none => [], tx => [tx] },
        map(t.spans, fn(s: Span) -> utf8 s.text),
      ]), ""),
      id: t.id,
      class: t.class,
    },
  ]
}

// Inline run inside a `text`. Style fields beyond `class` are
// intentionally absent — style flows through @block("class") rules.
// `id` / `class` are carried but not yet rendered: see the note at the
// top of this file.
@block("span")
type Span {
  @doc("The span text (the inline label slot); inline patterns are applied.")
  @inline(0) text: utf8
  @doc("Optional explicit HTML id. Not currently rendered — see `text`.")
  id:    identifier?
  @doc("Optional style classes for this span. Not currently rendered — see `text`.")
  class: list<utf8>?
}

// Grid container. `widths` are CSS percentages, one per child slot;
// children flow in source order across the slots. `@native` on every
// target: only HTML draws the grid, and the static backends render the
// children stacked in source order — the layout is lost, the content is
// not (the same degradation `region` / `fragment` take).
@block("column")
@native
type Column extends WdocBlock {
  @doc("One CSS percentage per child slot (e.g. `[50.0, 50.0]`).")
  widths: list<f64>
  @doc("Optional explicit HTML id.")
  id:     identifier?
  @doc("Optional class list applied to the whole column group.")
  class:  list<utf8>?
  @doc("Any wdoc blocks — each consecutive block fills the next column slot.")
  @children(WdocBlock) children: list<WdocBlock>
}

