// Paragraph — children are spans rendered in source order. Lowers to a
// `<p>` whose children are `<span>`s; each span's text runs through the
// inline-pattern engine via the `Inline` fundamental (the regex engine is
// Rust, but the `<p>` / `<span>` structure is authored here).
@block("text")
type Text extends WdocBlock {
  id:    identifier?
  class: list<utf8>?
  @children("span") spans: list<Span>
  lower = fn(t: Text) -> list<HtmlFundamental> [
    HtmlFundamental::Element {
      tag: "p", id: t.id, class: t.class, attrs: none,
      children: map(t.spans, fn(s: Span) -> HtmlFundamental
        HtmlFundamental::Element {
          tag: "span", id: s.id, class: s.class, attrs: none,
          children: [ HtmlFundamental::Inline { text: s.text } ],
        }),
    },
  ]
}

// Inline run inside a `text`. Style fields beyond `class` are
// intentionally absent — style flows through @block("class") rules.
@block("span")
type Span {
  @inline(0) text: utf8
  id:    identifier?
  class: list<utf8>?
}

// Grid container. `widths` are CSS percentages, one per child slot;
// children flow in source order across the slots.
@block("column")
type Column extends WdocBlock {
  widths: list<f64>
  id:     identifier?
  class:  list<utf8>?
  @children(WdocBlock) children: list<WdocBlock>
  lower = fn(c: Column) -> list<HtmlFundamental> []
}

