// ── Page templates ─────────────────────────────────────────────────
//
// A template wraps a page's rendered content in a surrounding layout.
// Templates are WCL functions returning fundamentals; the renderer
// calls a template's `render` with a `TemplateCtx` and the resulting
// fundamentals become the page <body>. The `<head>` + stylesheet are
// still emitted by the renderer.
//
// "Parts" are just functions returning `list<HtmlFundamental>`: a
// template composes them and embeds the framework-provided `content`
// part (the page's own blocks) via `Raw`. There is no built-in menu —
// a template builds navigation itself from `ctx.pages`.

// Reference to a page, for building navigation. `href` is the page's
// output file (`<name>.html`).
namespace wdoc

type PageRef { name: utf8  href: utf8 }

// A named content region of the page being rendered, handed to a
// template. `content` is the region's already-rendered HTML (its wdoc
// blocks lowered). Built by the renderer from the page's `region "name"
// { … }` blocks; pull one out by name with `wdoc_region(c, "name")`.
type Region { name: utf8  content: utf8 }

// A node in the resolved table of contents handed to templates. Built
// by the renderer from the `site`'s `toc` block. `href` is empty for a
// grouping heading (a `chapter` with no `page`); `current` is true for
// the entry linking to the page being rendered; `children` are nested
// entries (any depth).
type TocEntry {
  title:    utf8
  href:     utf8
  current:  bool
  children: list<TocEntry>
}

// A node in the resolved navbar menu handed to templates. Built by the
// renderer from the `site`'s `menu` block. `href` is the link target
// (`<page>.html` for an internal `page`, the raw URL for an external
// `href`, empty for a parent/grouping item with neither); `current` is
// true for the entry linking to the page being rendered; `children` are
// nested sub-menu entries (any depth).
type MenuEntry {
  label:    utf8
  href:     utf8
  current:  bool
  children: list<MenuEntry>
}

// A resolved sidebar-footer button handed to templates. Built by the
// renderer from the `site`'s `sidebar_footer` block. `href` is the link
// target (`<page>.html` for an internal `page`, the raw URL for an external
// `href`, empty for neither); `current` is true when it links to the page
// being rendered; `icon` is the button's icon already rendered to SVG markup
// (embed it with `Raw`), empty when the button declares none.
type FooterButton {
  label:   utf8
  href:    utf8
  current: bool
  icon:    utf8
}

// One in-page heading for the book's "on this page" rail. Built by the
// renderer from the current page's `h2` / `h3` headings: `level` is 2 or 3,
// `id` the (synthesised) anchor target, `title` the heading text, `number`
// the `§` section number (e.g. `"4.1"`).
type OnPageHeading {
  level:  i64
  id:     utf8
  title:  utf8
  number: utf8
}

// Context handed to a template's (and any part function's) `render`.
type TemplateCtx {
  @doc("The page's rendered body HTML — embed it with `Raw`.")
  content:      utf8
  @doc("Site title, or the page name when the site sets no `title`.")
  title:        utf8
  @doc("The current page's name.")
  page_name:    utf8
  @doc("The page's named content regions (its `region \"name\" { … }` blocks), each already rendered to HTML. Pull one out by name with `wdoc_region(c, \"name\")`. Empty on pages with no regions.")
  regions:      list<Region>
  @doc("Every page in the current site, in source order (for building navigation).")
  pages:        list<PageRef>
  @doc("The book TOC tree; flat (one entry per page) when the site declares no `toc`.")
  toc:          list<TocEntry>
  @doc("The current page's `h2`/`h3` headings, for the book's 'on this page' rail. Empty when the page has none.")
  on_this_page: list<OnPageHeading>
  @doc("The site's curated navbar menu; empty when the site declares no `menu`.")
  menu:         list<MenuEntry>
  @doc("Pinned sidebar-footer buttons (the site's `sidebar_footer`); empty when none declared. Each carries its icon already rendered to SVG markup.")
  footer:       list<FooterButton>
  @doc("The resolved presentation deck; empty unless the `presentation` template renders the whole site at once.")
  deck:         list<DeckSection>
  @doc("Whether to render a light/dark toggle (the site's `theme_toggle` flag).")
  theme_toggle: bool
  @doc("Whether to render the site search box (the site's `search` flag).")
  search:       bool
  @doc("Relative href back to the root site; empty when this IS the root (or a single-site build).")
  home_href:    utf8
  @doc("The root site's title, for the back-link text.")
  home_title:   utf8
}

// One table-of-contents entry. The inline label is the display title;
// `page` (optional) links it to a page; nested `chapter`s are
// sub-entries (3+ levels). A `chapter` with no `page` is a heading.
// A nested `wdoc_repeater` (body = `chapter` blocks) emits one sub-entry
// per element — data-driven navigation that tracks a collection.
@block("chapter")
type Chapter {
  @inline(0) title: utf8
  page: identifier?
  @children("chapter") children: list<Chapter>
  @children("wdoc_repeater") generators: list<WdocRepeater>
}

// The book's table of contents — an ordered, nestable tree of
// `chapter` entries. Declared inside the `site` block. A `wdoc_repeater`
// here (body = `chapter` blocks) emits one entry per element of `each`.
@block("toc")
type Toc {
  @children("chapter") chapters: list<Chapter>
  @children("wdoc_repeater") generators: list<WdocRepeater>
}

// One navbar menu item. The inline label is the display text; `page`
// (optional) links it to a page (validated; rendered as `<page>.html`),
// `href` (optional) links it to a raw/external URL; nested `item`s are
// sub-menu entries (any depth). An item with children renders as a
// click-to-open dropdown parent; an item with neither `page` nor `href`
// nor children is a plain, non-link label. `page` wins over `href`.
@block("item")
type MenuItem {
  @inline(0) label: utf8
  page: identifier?
  href: utf8?
  @children("item") children: list<MenuItem>
  // A nested `wdoc_repeater` (body = `item` blocks) emits one sub-entry
  // per element — e.g. one dropdown entry per `included_sites(...)` record.
  @children("wdoc_repeater") generators: list<WdocRepeater>
}

// The site's navbar menu — an ordered, nestable tree of `item`s.
// Declared inside the `site` block; rendered by the `webpage` template.
// A `wdoc_repeater` here (body = `item` blocks) emits one entry per
// element, so a menu can be data-driven (e.g. one entry per sub-site
// discovered by `included_sites(...)`).
@block("menu")
type Menu {
  @children("item") items: list<MenuItem>
  @children("wdoc_repeater") generators: list<WdocRepeater>
}

// One pinned button at the bottom of the `book` sidebar. `page` (optional)
// links it to a page (validated; rendered as `<page>.html`), `href` (optional)
// links it to a raw/external URL (`page` wins over `href`); `icon` (optional)
// is an icon name (`set.name`, e.g. `"lucide.chart-network"`) — the built-in
// `book` template renders the button icon-only, using the inline label as the
// hover tooltip / accessible name (and as the visible text when no `icon` is
// given).
@block("button")
type SidebarButton {
  @inline(0) label: utf8
  page: identifier?
  href: utf8?
  icon: utf8?
}

// Pinned buttons at the bottom of the `book` template's sidebar — an
// ordered list of `button`s, declared inside the `site` block. Use it to
// surface a launcher (e.g. a reference index) without crowding the TOC.
@block("sidebar_footer")
type SidebarFooter {
  @children("button") buttons: list<SidebarButton>
}

// Document descriptor. One per document; sets the default template and
// site-level data templates can read. Selected per-page via the
// page's `template` field, else `default_template` here.
@block("site")
type SiteConfig {
  // Optional site name. Required when a document declares more than one
  // site (it names the output subdirectory and is what `Page.sites`
  // references); omittable for a single-site document.
  @doc("Optional site name (the label slot). Required with more than one site; names the output subdirectory referenced by `Page.sites`.")
  @inline(0) name: identifier?
  // Render this site at the output root (its `index` becomes `/`) instead
  // of in a `<name>/` subdirectory, and skip the generated chooser. At
  // most one site may set it; more than one is a build error.
  @doc("When `true`, this site renders at `/` (others go under `/<site>/`).")
  root:             bool?
  @doc("`:webpage` (header + top nav), `:book` (sidebar + TOC), `:presentation` (slide deck), or `:ai_skill` (skill folder, Markdown-only — build with `wcl wdoc skill`).")
  default_template: symbol?
  @doc("Site title shown in the header / sidebar.")
  title:            utf8?
  // A one-line description of the site. Not rendered by the built-in
  // templates; it's metadata a parent collection surfaces through the
  // `included_sites(...)` builtin (see `include.wcl`) for landing-page links.
  @doc("One-line site description. Surfaced by `included_sites(...)` (not rendered by the built-in templates).")
  summary:          utf8?
  // Path to a favicon image, resolved relative to the document and copied
  // into `_wdoc/` (external `http(s)://` / `data:` URLs pass through).
  // Absent ⇒ a default WCL icon ships instead.
  @doc("Path to a favicon image (svg/png/ico), resolved relative to the document and copied into `_wdoc/`. Absent ⇒ a default WCL icon is used.")
  icon:             utf8?
  // Extra `<head>` assets for a custom (e.g. `website`) layout. Each href
  // is emitted verbatim, so it may be a URL, a path under a copied `assets`
  // folder, or a `file` shipped into the output. `stylesheets` / `fonts`
  // become `<link rel="stylesheet">`; `scripts` become deferred `<script>`.
  @doc("External stylesheet hrefs added to every page `<head>` as `<link rel=\"stylesheet\">` (verbatim — URL, copied asset, or shipped `file`).")
  stylesheets:      list<utf8>?
  @doc("Script srcs added to every page `<head>` as deferred `<script src=… defer>` (verbatim hrefs).")
  scripts:          list<utf8>?
  @doc("Web-font stylesheet hrefs added to every page `<head>` as `<link rel=\"stylesheet\">` (e.g. a Google Fonts URL).")
  fonts:            list<utf8>?
  // Folders copied verbatim into the site output directory (recursively),
  // for assets built by an external tool (a Vite/webpack `dist/`, etc.).
  // Each entry is resolved relative to the document; reference the copied
  // files from `stylesheets` / `scripts` or your layout by their output path.
  @doc("Folders copied verbatim (recursively) into the site output — e.g. a Vite `dist/`. Resolved relative to the document; reference copied files by their output path.")
  assets:           list<utf8>?
  // Render a light/dark toggle (the `book` template shows it). Pair
  // with `class` blocks that declare `dark {}` / `light {}` modes.
  @doc("When `true`, adds a light/dark toggle button.")
  theme_toggle:     bool?
  // Client-side full-text search. The build writes a per-page text
  // index (`_wdoc/search-index.json`) and the stdlib templates render
  // a search box (book sidebar / webpage nav) backed by the bundled
  // widget script. Works when the site is served, not opened directly
  // from disk (the widget fetches the index).
  @doc("When `true`, adds a client-side full-text search box (book and webpage templates).")
  search:           bool?
  // Colour theme for this site — a symbol naming a `theme` block: a
  // built-in (`:nord` / `:gruvbox` / `:solarized` / `:catppuccin` /
  // `:tokyonight` / `:kanagawa` / `:everforest`) or one you declare
  // yourself. Unset ⇒ the renderer applies `:nord`. See `theme.wcl`.
  @doc("Symbol naming a colour `theme` block (`:nord` …) — see Styling.")
  theme:  symbol?
  // Which hue drives links / highlights (`--wdoc-accent`): one of
  // red orange yellow green cyan blue purple pink. Unset ⇒ blue.
  @doc("Symbol naming the accent hue (`:red`..`:pink`); default `:blue`.")
  accent: symbol?
  // UI/application theme for `wf_*` wireframe elements — the theme the
  // mocked-up application follows, separate from the document's `theme`.
  // `ui_theme` names a `theme` block (same vocabulary as `theme`),
  // `ui_accent` a hue, and `ui_mode` is `:dark` (default) or `:light` so a
  // light app can be mocked on a dark docs page. Each unset field falls
  // back to the document `theme` / `accent` / dark. A wireframe element may
  // override these per-instance with its own `theme` / `accent` / `mode`.
  @doc("UI theme for `wf_*` wireframe elements (the mocked app's theme), separate from the document `theme`. Falls back to `theme`.")
  ui_theme:  symbol?
  @doc("Accent hue for `wf_*` wireframe elements; falls back to `accent`.")
  ui_accent: symbol?
  @doc("Mode for `wf_*` wireframe elements — `:dark` (default) or `:light`.")
  ui_mode:   symbol?
  @doc("Chapter tree for the `book` template.")
  @child("toc") toc: Toc?
  // Curated navbar menu (the `webpage` template renders it). Items may
  // link to a page or external URL and nest into dropdowns. With no
  // `menu`, `webpage` falls back to a flat list of every page.
  @doc("Top navbar entries for the `webpage` template.")
  @child("menu") menu: Menu?
  // Pinned launcher buttons at the bottom of the `book` template's
  // sidebar (each may link to a page or URL and carry an icon). Surfaced
  // to templates as `TemplateCtx.footer`. Ignored by other templates.
  @doc("Pinned buttons at the bottom of the `book` sidebar.")
  @child("sidebar_footer") sidebar_footer: SidebarFooter?
  // Presentation deck: groups this site's pages into the slide grid the
  // `presentation` template renders (sections = columns, slides = rows).
  // See `presentation.wcl`.
  @doc("Slide grid for the `presentation` template.")
  @child("deck") deck: Deck?
  // Skill metadata for the `:ai_skill` target (`wcl wdoc skill`). Supplies
  // the required `name` / `description` (and optional `license`) that the
  // backend writes as SKILL.md's YAML front matter. Ignored by every other
  // target. See `SkillConfig`.
  @doc("Skill metadata for the `:ai_skill` target — populates SKILL.md's front matter.")
  @child("skill") skill: SkillConfig?
}

// Skill metadata for the `:ai_skill` target (`wcl wdoc skill`). The
// backend builds SKILL.md's `---`-fenced YAML front matter from these
// fields. The site's `start` page becomes SKILL.md; every other page is
// written under `references/`. Arbitrary extra front-matter keys can
// still be authored via a `@schemaless frontmatter` block on the start
// page — they are merged with these. Hyphenated skill-spec keys (e.g.
// `allowed-tools`, `disable-model-invocation`) are written as
// string-literal keys: `@schemaless frontmatter { "allowed-tools" = [...] }`.
@block("skill")
type SkillConfig {
  @doc("Skill name (SKILL.md front-matter `name`). A short lowercase slug.")
  name: utf8
  @doc("Skill description (SKILL.md front-matter `description`).")
  description: utf8
  @doc("Optional license string for the front matter.")
  license: utf8?
}

// A named template. `render` lays out a page body from the context.
@block("template")
type Template {
  @inline(0) name: identifier
  render: fn(TemplateCtx) -> list<HtmlFundamental>
}

// The `webpage` template's own CSS, embedded as a `<style>` in the page
// body (browsers honour it). It styles only this template's regions, so
// it lives with the template rather than as a global rule — uses flex /
// gap / descendant selectors a bare `class` can't express. `.site-header`
// colour/weight is the bundled `class "site-header"`.
//
// The header and content share one centred, max-width reading column
// (`margin-inline: auto` + horizontal padding) so pages read like a
// normal website rather than hugging the left edge on wide screens.
//
// The nav is a full-width sticky bar: it breaks out of the column
// (`max-width: none; margin: 0`) so its background + bottom border span
// the viewport, stays pinned on scroll (`position: sticky; top: 0`), and
// re-aligns its links to the header/content column with auto side gutters
// (`max(1.25rem, calc((100% - 48rem) / 2 + 1.25rem))`, floored on narrow
// screens). The `+ 1.25rem` matches the header's own inner padding, so the
// first nav link lines up exactly with the heading text above it.
// `var(--wdoc-bg)` keeps content from bleeding through; `scroll-padding-top`
// keeps in-page anchor jumps from landing under the bar.
//
// The content sits in a distinct card while the page keeps the theme's
// normal background. The card fill is a *small* `color-mix` off the page
// `bg` toward the text colour (a slight lift — lighter on dark themes,
// darker on light ones), so it stays close to the page background yet
// keeps a visible offset on every theme, even low-contrast ones (a plain
// `bg`→`bg-alt` step reads as no box on some). A `--wdoc-border` outline +
// a real shadow finish the box (`var(--wdoc-bg-alt)` is the no-`color-mix`
// fallback for old browsers). `.site-home` uses `color: inherit` so the
// back-link follows the page theme instead of the UA's default link blue.
//
// IMPORTANT: this heredoc is emitted verbatim into the page <style>, so it
// must be pure CSS — never a `//` line. CSS has no `//` comment; a stray
// one (especially with an unmatched `(`, as in prose) is parsed as a
// selector and silently swallows every rule after it. Keep prose in WCL
// `//` comments out here, not inside the `<<CSS … CSS` body.
let webpage_css = <<CSS
  .site-header, .site-main { max-width: 48rem; margin-left: auto; margin-right: auto; padding-left: 1.25rem; padding-right: 1.25rem; box-sizing: border-box; }
  .site-header { padding-top: 1rem; }
  .site-nav { position: sticky; top: 0; z-index: 10; display: flex; gap: 1rem; background: var(--wdoc-bg, #fff); border-bottom: 1px solid var(--wdoc-border, #ccc); padding: 0.6rem max(1.25rem, calc((100% - 48rem) / 2 + 1.25rem)); margin-bottom: 1.5rem; box-sizing: border-box; }
  .site-nav a { text-decoration: none; }
  .site-home { font-weight: 600; color: inherit; }
  .site-nav ul.menu { list-style: none; margin: 0; padding: 0; display: flex; gap: 1rem; align-items: center; }
  .site-nav ul.menu li { position: relative; }
  .site-nav .menu-toggle, .site-nav .menu-link, .site-nav .menu-label { display: inline-block; padding: 0.1rem 0; font: inherit; color: inherit; background: none; border: none; cursor: pointer; text-decoration: none; white-space: nowrap; }
  .site-nav .menu-label { cursor: default; }
  .site-nav .menu-toggle::after { content: " ▾"; opacity: 0.7; }
  .site-nav a.menu-link.current { font-weight: 600; color: var(--wdoc-accent, inherit); }
  .site-nav ul.menu ul.menu { display: none; position: absolute; top: 100%; left: 0; flex-direction: column; align-items: stretch; gap: 0.15rem; min-width: 10rem; padding: 0.4rem; background: var(--wdoc-bg, #fff); border: 1px solid var(--wdoc-border, #ccc); border-radius: 6px; box-shadow: 0 6px 20px rgba(0,0,0,0.18); z-index: 30; }
  .site-nav li.open > ul.menu { display: flex; }
  .site-nav ul.menu ul.menu ul.menu { top: 0; left: 100%; }
  .site-main { display: block; background: var(--wdoc-bg-alt, #ffffff); background: color-mix(in srgb, var(--wdoc-bg) 90%, var(--wdoc-fg) 10%); border: 1px solid var(--wdoc-border, rgba(127,127,127,0.35)); border-radius: 12px; padding: 1.75rem 2rem 2.25rem; margin-bottom: 2.5rem; box-shadow: 0 1px 2px rgba(0,0,0,0.12), 0 12px 30px rgba(0,0,0,0.18); }
  html { scroll-padding-top: 4rem; }
  CSS

// Back-link to the root site, shown by the templates when the current
// page is on a sub-site (`ctx.home_href` non-empty). Empty otherwise.
let home_link = fn(c: TemplateCtx, cls: utf8) -> list<HtmlFundamental>
  if c.home_href == "" { [] }
  else {
    [ HtmlFundamental::Element {
        tag: "a", id: none, class: [cls],
        attrs: [["href", c.home_href]],
        children: [ HtmlFundamental::Raw { html: format("← {}", c.home_title) } ],
    } ]
  }

// One navbar menu entry: a click-toggle `<button>` when it has children
// (a dropdown parent), an `<a>` when it links somewhere, or a plain
// `<span>` label otherwise. The current page's link carries `current`.
let menu_entry = fn(m: MenuEntry) -> HtmlFundamental
  if len(m.children) > 0 {
    HtmlFundamental::Element {
      tag: "button", id: none, class: ["menu-toggle"],
      attrs: [["type", "button"]],
      children: [ HtmlFundamental::Raw { html: m.label } ],
    }
  } else if m.href == "" {
    HtmlFundamental::Element {
      tag: "span", id: none, class: ["menu-label"], attrs: none,
      children: [ HtmlFundamental::Raw { html: m.label } ],
    }
  } else {
    HtmlFundamental::Element {
      tag: "a", id: none,
      class: if m.current { ["menu-link", "current"] } else { ["menu-link"] },
      attrs: [["href", m.href]],
      children: [ HtmlFundamental::Raw { html: m.label } ],
    }
  }

// Render menu entries as a nested `<ul class="menu">` — recursive, so
// the tree nests to any depth. An empty list renders nothing (no stray
// `<ul>`), which also terminates the recursion at the leaves.
let site_menu = fn(entries: list<MenuEntry>) -> list<HtmlFundamental>
  if len(entries) == 0 { [] }
  else {
    [ HtmlFundamental::Element {
        tag: "ul", id: none, class: ["menu"], attrs: none,
        children: map(entries, fn(e: MenuEntry) -> HtmlFundamental
          HtmlFundamental::Element {
            tag: "li", id: none,
            class: if len(e.children) > 0 { ["has-submenu"] } else { none },
            attrs: none,
            children: flatten([ [menu_entry(e)], site_menu(e.children) ]),
          }),
      } ]
  }

// One-time click-toggle script for the navbar dropdowns: a single
// delegated document listener flips `open` on the clicked toggle's
// `<li>` (closing any open item that isn't an ancestor, so nested
// dropdowns work), and a click anywhere else closes all open menus.
let menu_script = HtmlFundamental::Raw {
  html: "<script>(function(){function closeAll(keep){var o=document.querySelectorAll('.site-nav li.open');for(var i=0;i<o.length;i++){if(!keep||!o[i].contains(keep)){o[i].classList.remove('open');}}}document.addEventListener('click',function(e){var t=e.target.closest&&e.target.closest('.site-nav .menu-toggle');if(t){e.preventDefault();var li=t.parentNode;var willOpen=!li.classList.contains('open');closeAll(li);if(willOpen){li.classList.add('open');}else{li.classList.remove('open');}}else{closeAll(null);}});})();</script>",
}

// Stdlib `webpage` template: a Hugo-style site shell — a title header,
// a nav, and the page content in <main>. The nav comes from the site's
// `menu` (a curated, nestable dropdown structure); with no `menu` it
// falls back to a flat link per page. Users can declare their own
// `template <name> { render = ... }` blocks and select them with
// `default_template` / a page's `template` field.
// The site search box: an input plus a results dropdown, wired up by
// the bundled `wdoc-search.js` (injected by the build when the site
// sets `search = true`). The `<style>` ships with the box so the CSS
// loads only when search is enabled.
let wdoc_search_css = <<CSS
  .wdoc-search { position: relative; margin: 0 0 0.75rem; }
  .wdoc-search-input { width: 100%; box-sizing: border-box; padding: 0.3rem 0.5rem; font: inherit; color: inherit; background: var(--wdoc-bg, transparent); border: 1px solid var(--wdoc-border, rgba(127,127,127,0.4)); border-radius: 4px; }
  .wdoc-search-results { display: none; position: absolute; z-index: 10; left: 0; right: 0; max-height: 60vh; overflow-y: auto; background: var(--wdoc-bg-alt, #fff); border: 1px solid var(--wdoc-border, rgba(127,127,127,0.4)); border-radius: 4px; box-shadow: 0 4px 16px rgba(0,0,0,0.25); }
  .wdoc-search-results.open { display: block; }
  .wdoc-search-hit { display: block; padding: 0.45rem 0.6rem; text-decoration: none; color: inherit; border-bottom: 1px solid var(--wdoc-border, rgba(127,127,127,0.2)); }
  .wdoc-search-hit:last-child { border-bottom: none; }
  .wdoc-search-hit:hover { background: rgba(127,127,127,0.12); }
  .wdoc-search-hit-title { display: block; font-weight: 600; }
  .wdoc-search-hit-snippet { display: block; font-size: 0.85em; opacity: 0.75; margin-top: 0.15rem; }
  .wdoc-search-empty { padding: 0.45rem 0.6rem; opacity: 0.7; }
  .site-nav .wdoc-search { display: inline-block; margin: 0 0 0 1rem; min-width: 14rem; vertical-align: middle; }
  CSS

let wdoc_search_box = fn(enabled: bool) -> list<HtmlFundamental>
  if enabled {
    [
      HtmlFundamental::Element {
        tag: "style", id: none, class: none, attrs: none,
        children: [ HtmlFundamental::Raw { html: wdoc_search_css } ],
      },
      HtmlFundamental::Element {
        tag: "div", id: none, class: ["wdoc-search"], attrs: none,
        children: [
          HtmlFundamental::Element {
            tag: "input", id: none, class: ["wdoc-search-input"],
            attrs: [["type", "search"], ["placeholder", "Search…"], ["aria-label", "Search this site"]],
            children: [],
          },
          HtmlFundamental::Element {
            tag: "div", id: none, class: ["wdoc-search-results"], attrs: none,
            children: [],
          },
        ],
      },
    ]
  } else { [] }

// ── Public template parts ───────────────────────────────────────────
//
// Stable, composable building blocks for authoring your own `template`.
// Each returns `list<HtmlFundamental>`; compose them with `flatten([…])`.
// They resolve by BARE NAME across `import <wdoc.wcl>`, so don't shadow a
// `wdoc_part_*` / `wdoc_*_layout` name with your own `let`. The built-in
// templates below are themselves just compositions of these — call a
// `wdoc_*_layout` wholesale, append to it, or copy its body and swap a part
// to retheme a page (a blog, an app home page, …).

// Shared parts ───────────────────────────────────────────────────────

// The site search box (input + results dropdown) plus its `<style>` when
// `enabled`; empty otherwise. Gate it on `c.search`.
let wdoc_part_search_box = fn(enabled: bool) -> list<HtmlFundamental>
  wdoc_search_box(enabled)

// The light/dark theme toggle button + its one-time script when `enabled`;
// empty otherwise. Gate it on `c.theme_toggle`.
let wdoc_part_theme_toggle = fn(enabled: bool) -> list<HtmlFundamental>
  if enabled { book_theme_toggle } else { [] }

// The back-to-root link shown on sub-sites (empty on the root / single site).
// `cls` is the CSS class to tag it with (e.g. "site-home" / "book-home").
let wdoc_part_home_link = fn(c: TemplateCtx, cls: utf8) -> list<HtmlFundamental>
  home_link(c, cls)

// Webpage parts ──────────────────────────────────────────────────────

// The `webpage` template's `<style>` block — include it to inherit the
// stdlib header / nav / content-card styling, or omit it and supply your own.
let wdoc_part_webpage_css = fn() -> list<HtmlFundamental> [
  HtmlFundamental::Element {
    tag: "style", id: none, class: none, attrs: none,
    children: [ HtmlFundamental::Raw { html: webpage_css } ],
  },
]

// The site title header (`<header class="site-header">`).
let wdoc_part_header = fn(c: TemplateCtx) -> list<HtmlFundamental> [
  HtmlFundamental::Element {
    tag: "header", id: none, class: ["site-header"], attrs: none,
    children: [ HtmlFundamental::Raw { html: c.title } ],
  },
]

// The top navigation bar (`<nav class="site-nav">`): the back-to-root link,
// the search box (when enabled), and the menu — the curated `menu` tree, or
// a flat link per page when no `menu` is declared.
let wdoc_part_navbar = fn(c: TemplateCtx) -> list<HtmlFundamental> [
  HtmlFundamental::Element {
    tag: "nav", id: none, class: ["site-nav"], attrs: none,
    children: flatten([
      home_link(c, "site-home"),
      wdoc_search_box(c.search),
      if len(c.menu) == 0 {
        map(c.pages, fn(p: PageRef) -> HtmlFundamental
          HtmlFundamental::Element {
            tag: "a", id: none, class: none,
            attrs: [["href", p.href]],
            children: [ HtmlFundamental::Raw { html: p.name } ],
          })
      } else {
        site_menu(c.menu)
      },
    ]),
  },
]

// The page content wrapped in the reading card (`<main class="site-main">`).
let wdoc_part_content = fn(c: TemplateCtx) -> list<HtmlFundamental> [
  HtmlFundamental::Element {
    tag: "main", id: none, class: ["site-main"], attrs: none,
    children: [ HtmlFundamental::Raw { html: c.content } ],
  },
]

// The one-time dropdown-toggle script — emit it once when the navbar uses a
// curated `menu` (empty otherwise, matching the built-in webpage template).
let wdoc_part_menu_script = fn(menu: list<MenuEntry>) -> list<HtmlFundamental>
  if len(menu) > 0 { [menu_script] } else { [] }

// The bare nested menu list (`<ul class="menu">`) — the navbar's menu without
// the surrounding `<nav>`, for placing a dropdown menu anywhere you like.
let wdoc_part_menu_tree = fn(entries: list<MenuEntry>) -> list<HtmlFundamental>
  site_menu(entries)

// The full default `webpage` layout: style, header, navbar, content, and the
// menu script. The `webpage` template is exactly this.
let wdoc_webpage_layout = fn(c: TemplateCtx) -> list<HtmlFundamental>
  flatten([
    wdoc_part_webpage_css(),
    wdoc_part_header(c),
    wdoc_part_navbar(c),
    wdoc_part_content(c),
    wdoc_part_menu_script(c.menu),
  ])

template webpage {
  render = fn(c: TemplateCtx) -> list<HtmlFundamental>
    wdoc_webpage_layout(c)
}

// One sidebar entry: a `<span>` heading when the entry has no page
// (empty href), otherwise an `<a>` link (with `current` highlighting).
let book_toc_link = fn(e: TocEntry) -> HtmlFundamental
  if e.href == "" {
    HtmlFundamental::Element {
      tag: "span", id: none, class: ["book-section"], attrs: none,
      children: [ HtmlFundamental::Raw { html: e.title } ],
    }
  } else {
    HtmlFundamental::Element {
      tag: "a", id: none,
      class: if e.current { ["book-chapter", "current"] } else { ["book-chapter"] },
      attrs: [["href", e.href]],
      children: [ HtmlFundamental::Raw { html: e.title } ],
    }
  }

// True when this entry is the current page, or an ancestor of it — i.e. the
// current page lives somewhere in its subtree. Drives mdbook-style sidebar
// expansion: the active path is rendered open, every other branch collapsed.
let toc_active = fn(e: TocEntry) -> bool
  e.current || fold(e.children, false, fn(acc: bool, c: TocEntry) -> bool
    acc || toc_active(c))

// The expand/collapse affordance at the head of a TOC row. Always emitted
// (so leaf and branch rows stay aligned); the chevron is drawn by CSS only
// for branch `<li>`s, and the click handler ignores leaf rows.
let book_toc_toggle = HtmlFundamental::Element {
  tag: "span", id: none, class: ["book-toc-toggle"], attrs: none, children: [],
}

// Render a list of TOC entries as a nested `<ul>` — recursive, so the tree
// nests to any depth. An empty list renders nothing (no stray `<ul>`), which
// also terminates the recursion at the leaves. A branch `<li>` carries
// `book-branch` (plus `open` when it's on the active path), so its child
// `<ul>` collapses by default and only the current page's ancestry expands.
let book_toc = fn(entries: list<TocEntry>) -> list<HtmlFundamental>
  if len(entries) == 0 { [] }
  else {
    [ HtmlFundamental::Element {
        tag: "ul", id: none, class: ["book-toc"], attrs: none,
        children: map(entries, fn(e: TocEntry) -> HtmlFundamental {
          let has_children = len(e.children) > 0;
          HtmlFundamental::Element {
            tag: "li", id: none,
            class: if has_children {
                if toc_active(e) { ["book-branch", "open"] } else { ["book-branch"] }
              } else { none },
            attrs: none,
            children: flatten([
              [ HtmlFundamental::Element {
                  tag: "div", id: none, class: ["book-toc-row"], attrs: none,
                  children: [ book_toc_toggle, book_toc_link(e) ],
              } ],
              book_toc(e.children),
            ]),
          }
        }),
      } ]
  }

// Flatten the TOC tree into book reading order, keeping only entries
// that link to a page — a grouping `chapter` with no `page` has an empty
// `href` and is skipped (its children are still kept). Recursive, mirroring
// `book_toc`. Drives the bottom-of-page previous/next links.
let book_pageflow = fn(entries: list<TocEntry>) -> list<TocEntry>
  flatten(map(entries, fn(e: TocEntry) -> list<TocEntry>
    flatten([
      if e.href == "" { [] } else { [e] },
      book_pageflow(e.children),
    ])))

// Bottom-of-page previous/next pagination, derived from the book reading
// order (the flattened TOC). The current page is the entry flagged
// `current`; its neighbours become the links. Empty when the page isn't
// in the TOC; at the ends only the one existing neighbour is shown.
let book_pagenav = fn(toc: list<TocEntry>) -> list<HtmlFundamental> {
  let flow = book_pageflow(toc);
  let n = len(flow);
  let idx = fold(range(0, n), 0 - 1, fn(acc: i64, i: i64) -> i64 {
    let e = at(flow, i);
    if e.current { i } else { acc }
  });
  if idx < 0 { [] } else {
    let prev = if idx > 0 {
      let p = at(flow, idx - 1);
      [ HtmlFundamental::Element {
          tag: "a", id: none, class: ["book-nav", "book-nav-prev"],
          attrs: [["href", p.href]],
          children: [ HtmlFundamental::Raw { html: format("← {}", p.title) } ],
      } ]
    } else { [] };
    let next = if idx < n - 1 {
      let nx = at(flow, idx + 1);
      [ HtmlFundamental::Element {
          tag: "a", id: none, class: ["book-nav", "book-nav-next"],
          attrs: [["href", nx.href]],
          children: [ HtmlFundamental::Raw { html: format("{} →", nx.title) } ],
      } ]
    } else { [] };
    if len(prev) == 0 && len(next) == 0 { [] } else {
      [ HtmlFundamental::Element {
          tag: "nav", id: none, class: ["book-pagenav"], attrs: none,
          children: flatten([prev, next]),
      } ]
    }
  }
}

// The `book` template's own CSS — the fixed left sidebar, the nested TOC
// list, the reading column, and the theme toggle. Embedded as a `<style>`
// in the body so it loads only on book-templated pages. Uses position /
// descendant / compound / `:hover` selectors a bare `class` can't express;
// the chapter / section colours are the bundled `class "book-chapter" /
// "book-section" / "current"`.
let book_css = <<CSS
  .book-sidebar { position: fixed; top: 0; left: 0; width: 16rem; height: 100vh; overflow-y: auto; box-sizing: border-box; padding: 1rem; border-right: 1px solid var(--wdoc-border); background: var(--wdoc-bg-alt); display: flex; flex-direction: column; font-family: var(--wdoc-font-head); scrollbar-width: thin; scrollbar-color: var(--wdoc-border-strong) transparent; }
  .book-sidebar::-webkit-scrollbar { width: 9px; }
  .book-sidebar::-webkit-scrollbar-thumb { background: var(--wdoc-border-strong); border-radius: 999px; border: 2px solid var(--wdoc-bg-alt); }
  .book-title { font-weight: 600; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--wdoc-fg-muted); margin-bottom: 0.9rem; }
  .book-home { display: block; margin-bottom: 0.6rem; opacity: 0.8; text-decoration: none; color: inherit; }
  .book-home:hover { opacity: 1; text-decoration: underline; }
  .book-sidebar ul.book-toc { list-style: none; margin: 0; padding-left: 0; }
  .book-sidebar ul.book-toc ul.book-toc { padding-left: 0.85rem; }
  .book-sidebar a.book-chapter { display: block; padding: 0.25rem 0 0.25rem 0.6rem; border-left: 2px solid transparent; color: var(--wdoc-fg-muted); text-decoration: none; }
  .book-sidebar a.book-chapter:hover { color: var(--wdoc-fg); }
  .book-sidebar a.book-chapter.current { color: var(--wdoc-accent); border-left-color: var(--wdoc-accent); font-weight: 600; }
  .book-sidebar .book-section { display: block; padding: 0.5rem 0 0.15rem; font-weight: 600; font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--wdoc-fg-subtle); }
  .book-sidebar .book-toc-row { display: flex; align-items: baseline; }
  .book-sidebar .book-toc-row > a.book-chapter, .book-sidebar .book-toc-row > .book-section { flex: 1 1 auto; }
  .book-sidebar .book-toc-toggle { flex: 0 0 1rem; cursor: pointer; user-select: none; text-align: center; opacity: 0.55; }
  .book-sidebar .book-toc-toggle:hover { opacity: 1; }
  .book-sidebar li.book-branch > .book-toc-row { cursor: pointer; user-select: none; }
  .book-sidebar li.book-branch > .book-toc-row:hover > .book-toc-toggle { opacity: 1; }
  .book-sidebar li.book-branch > .book-toc-row > .book-toc-toggle::before { content: "▸"; display: inline-block; transition: transform 0.12s ease; }
  .book-sidebar li.book-branch.open > .book-toc-row > .book-toc-toggle::before { transform: rotate(90deg); }
  .book-sidebar li.book-branch > ul.book-toc { display: none; }
  .book-sidebar li.book-branch.open > ul.book-toc { display: block; }
  .book-content { margin-left: 16rem; margin-right: 15rem; min-height: 100vh; box-sizing: border-box; }
  .book-content .book-measure { max-width: 60rem; margin: 0 auto; padding: 2.5rem 3.5rem 6rem; background: var(--wdoc-book-bg); min-height: 100vh; box-sizing: border-box; font-family: var(--wdoc-font-body); }
  .theme-toggle { display: block; margin: 0 0 0.75rem; padding: 0.25rem 0.7rem; cursor: pointer; background: var(--wdoc-bg-alt); border: 1px solid var(--wdoc-border-strong); border-radius: 999px; color: inherit; font: inherit; font-family: var(--wdoc-font-head); font-size: 0.8rem; }
  .book-pagenav { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 3.5rem; }
  .book-pagenav .book-nav { display: block; padding: 0.9rem 1.1rem; border: 1px solid var(--wdoc-border); border-radius: 8px; background: var(--wdoc-book-bg); text-decoration: none; color: var(--wdoc-heading); font-family: var(--wdoc-font-head); font-weight: 600; }
  .book-pagenav .book-nav:hover { border-color: var(--wdoc-accent); }
  .book-pagenav .book-nav-next { grid-column: 2; text-align: right; }
  .book-sidebar-footer { position: sticky; bottom: 0; margin: auto -1rem -1rem; padding: 0.6rem 1rem; background: var(--wdoc-bg-alt); border-top: 1px solid var(--wdoc-border); display: flex; flex-direction: column; gap: 0.4rem; }
  .book-footer-btn { display: flex; align-items: center; justify-content: center; padding: 0.45rem 0.6rem; text-decoration: none; color: inherit; border: 1px solid var(--wdoc-border); border-radius: 6px; opacity: 0.85; }
  .book-footer-btn:hover { opacity: 1; border-color: var(--wdoc-accent); }
  .book-footer-btn.current { color: var(--wdoc-accent); border-color: var(--wdoc-accent); opacity: 1; }
  .book-footer-btn .wdoc-icon { width: 1.4em; height: 1.4em; flex: 0 0 auto; }
  .book-rail { position: fixed; top: 0; right: 0; width: 15rem; height: 100vh; overflow-y: auto; box-sizing: border-box; padding: 2.5rem 1.4rem; font-family: var(--wdoc-font-head); scrollbar-width: thin; scrollbar-color: var(--wdoc-border-strong) transparent; }
  .book-rail-title { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.9rem; }
  .book-onpage { display: flex; flex-direction: column; }
  .book-onpage-link { display: block; padding: 0.2rem 0 0.2rem 0.7rem; font-size: 0.82rem; line-height: 1.35; text-decoration: none; }
  .book-onpage-link.level-3 { padding-left: 1.5rem; font-size: 0.78rem; }
  .book-palette { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 1.6rem; }
  .book-palette span { width: 22px; height: 22px; border-radius: 6px; border: 1px solid color-mix(in srgb, var(--wdoc-fg) 14%, transparent); }
  .heading-marker { display: block; font-size: 0.78rem; margin-bottom: 0.2rem; }
  @media (max-width: 82rem) { .book-rail { display: none; } .book-content { margin-right: 0; } }
  CSS

// Stdlib `book` template: an mdbook-style layout — a fixed left
// sidebar holding the book title and the table of contents (nested,
// current chapter highlighted), and the page content in a reading
// column. The TOC comes from the `site` block's `toc`; with no `toc`
// declared the renderer falls back to a flat list of every page.
// Book parts ─────────────────────────────────────────────────────────

// The `book` template's `<style>` block — the fixed sidebar, nested TOC,
// reading column, and theme toggle. Include it for stdlib book styling.
let wdoc_part_book_css = fn() -> list<HtmlFundamental> [
  HtmlFundamental::Element {
    tag: "style", id: none, class: none, attrs: none,
    children: [ HtmlFundamental::Raw { html: book_css } ],
  },
]

// One pinned sidebar-footer button: an icon-only `<a class="book-footer-btn">`
// linking to `b.href`, carrying the current page's highlight and the button's
// icon (already rendered to SVG markup by the renderer, embedded via `Raw`).
// The label drives the `title` / `aria-label` (a hover tooltip + accessible
// name) rather than visible text; a button with no icon falls back to its
// label as text so it is never empty.
let book_footer_button = fn(b: FooterButton) -> HtmlFundamental
  HtmlFundamental::Element {
    tag: "a", id: none,
    class: if b.current { ["book-footer-btn", "current"] } else { ["book-footer-btn"] },
    attrs: [["href", b.href], ["title", b.label], ["aria-label", b.label]],
    children: if b.icon == "" {
        [ HtmlFundamental::Raw { html: b.label } ]
      } else {
        [ HtmlFundamental::Raw { html: b.icon } ]
      },
  }

// The pinned sidebar footer (`<div class="book-sidebar-footer">`): one button
// per `c.footer` entry. Empty (renders nothing) when the site declares no
// `sidebar_footer`. Pinned to the bottom of the sidebar by `book_css`.
let wdoc_part_sidebar_footer = fn(c: TemplateCtx) -> list<HtmlFundamental>
  if len(c.footer) == 0 { [] }
  else {
    [ HtmlFundamental::Element {
        tag: "div", id: none, class: ["book-sidebar-footer"], attrs: none,
        children: map(c.footer, book_footer_button),
      } ]
  }

// The fixed left sidebar (`<nav class="book-sidebar">`): the book title, the
// back-to-root link, the search box, the theme toggle, the TOC tree, the
// pinned footer buttons, and the scroll-to-current script — in the built-in
// book order. The scroll script runs after the TOC is in the DOM (an inline
// script executes at parse time, so it sees its sibling chapter `<a>`s) and
// centres the current chapter.
let wdoc_part_sidebar = fn(c: TemplateCtx) -> list<HtmlFundamental> [
  HtmlFundamental::Element {
    tag: "nav", id: none, class: ["book-sidebar"], attrs: none,
    children: flatten([
      [ HtmlFundamental::Element {
          tag: "div", id: none, class: ["book-title"], attrs: none,
          children: [ HtmlFundamental::Raw { html: c.title } ],
        } ],
      home_link(c, "book-home"),
      wdoc_search_box(c.search),
      if c.theme_toggle { book_theme_toggle } else { [] },
      book_toc(c.toc),
      wdoc_part_sidebar_footer(c),
      [book_sidebar_scroll, book_sidebar_toggle],
    ]),
  },
]

// The page content in the book reading column (`<main class="book-content">`),
// followed by the previous/next pagination derived from the TOC order. The
// inner `book-measure` caps the reading width and centres the column between
// the fixed sidebar and rail.
let wdoc_part_book_content = fn(c: TemplateCtx) -> list<HtmlFundamental> [
  HtmlFundamental::Element {
    tag: "main", id: none, class: ["book-content"], attrs: none,
    children: [
      HtmlFundamental::Element {
        tag: "div", id: none, class: ["book-measure"], attrs: none,
        children: flatten([
          [ HtmlFundamental::Raw { html: c.content } ],
          book_pagenav(c.toc),
        ]),
      },
    ],
  },
]

// One "on this page" rail link (`<a class="book-onpage-link level-N">`),
// anchoring to the heading's synthesised id; `level-2` / `level-3` drive the
// indent. The title is pre-escaped HTML, embedded via `Raw`.
let book_onpage_link = fn(h: OnPageHeading) -> HtmlFundamental
  HtmlFundamental::Element {
    tag: "a", id: none,
    class: ["book-onpage-link", format("level-{}", h.level)],
    attrs: [["href", format("#{}", h.id)]],
    children: [ HtmlFundamental::Raw { html: h.title } ],
  }

// A small theme-palette strip shown at the foot of the rail.
let book_rail_palette = HtmlFundamental::Raw {
  html: "<div class=\"book-palette\"><span style=\"background:var(--wdoc-accent)\"></span><span style=\"background:var(--wdoc-accent2)\"></span><span style=\"background:var(--wdoc-green)\"></span><span style=\"background:var(--wdoc-yellow)\"></span><span style=\"background:var(--wdoc-red)\"></span><span style=\"background:var(--wdoc-blue)\"></span></div>",
}

// Highlights the rail link whose section is currently in view, via an
// IntersectionObserver over the heading anchors.
let book_rail_script = HtmlFundamental::Raw {
  html: "<script>(function(){var ls=[].slice.call(document.querySelectorAll('.book-onpage-link'));if(!ls.length||!window.IntersectionObserver)return;var m={};ls.forEach(function(a){m[a.getAttribute('href').slice(1)]=a;});var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){ls.forEach(function(a){a.classList.remove('active');});var a=m[e.target.id];if(a)a.classList.add('active');}});},{rootMargin:'0px 0px -75% 0px'});ls.forEach(function(a){var el=document.getElementById(a.getAttribute('href').slice(1));if(el)io.observe(el);});})();</script>",
}

// The right-hand "on this page" rail (`<aside class="book-rail">`): the
// current page's h2/h3 headings as anchor links, a palette strip, and the
// scroll-spy script. Empty (renders nothing) on a page with no such headings.
let wdoc_part_book_rail = fn(c: TemplateCtx) -> list<HtmlFundamental>
  if len(c.on_this_page) == 0 { [] }
  else {
    [ HtmlFundamental::Element {
        tag: "aside", id: none, class: ["book-rail"], attrs: none,
        children: flatten([
          [ HtmlFundamental::Element {
              tag: "div", id: none, class: ["book-rail-title"], attrs: none,
              children: [ HtmlFundamental::Raw { html: "On this page" } ],
          } ],
          [ HtmlFundamental::Element {
              tag: "nav", id: none, class: ["book-onpage"], attrs: none,
              children: map(c.on_this_page, book_onpage_link),
          } ],
          [ book_rail_palette, book_rail_script ],
        ]),
    } ]
  }

// The nested TOC list (`<ul class="book-toc">`) on its own — the sidebar's
// chapter tree without the surrounding `<nav>`.
let wdoc_part_toc_tree = fn(entries: list<TocEntry>) -> list<HtmlFundamental>
  book_toc(entries)

// The bottom-of-page previous/next pagination, derived from the TOC reading
// order (empty when the current page isn't in the TOC).
let wdoc_part_pagenav = fn(toc: list<TocEntry>) -> list<HtmlFundamental>
  book_pagenav(toc)

// The full default `book` layout: style, sidebar, content-with-pagination.
// The `book` template is exactly this.
let wdoc_book_layout = fn(c: TemplateCtx) -> list<HtmlFundamental>
  flatten([
    wdoc_part_book_css(),
    wdoc_part_sidebar(c),
    wdoc_part_book_content(c),
    wdoc_part_book_rail(c),
  ])

template book {
  render = fn(c: TemplateCtx) -> list<HtmlFundamental>
    wdoc_book_layout(c)
}

// Light/dark toggle: a button plus a one-time script. The script
// applies a persisted choice on load and defines `wdocToggleTheme`,
// which flips `<html data-theme>` between dark/light (seeded from the
// system preference) and persists to localStorage. With no
// `data-theme` set, the `class` `@media (prefers-color-scheme: light)`
// rules follow the system; the attribute (toggle) overrides them.
let book_theme_toggle = [
  HtmlFundamental::Element {
    tag: "button", id: none, class: ["theme-toggle"],
    attrs: [["onclick", "wdocToggleTheme()"]],
    children: [ HtmlFundamental::Raw { html: "◐ Theme" } ],
  },
  HtmlFundamental::Raw {
    html: "<script>(function(){var r=document.documentElement;try{var s=localStorage.getItem('wdoc-theme');if(s){r.setAttribute('data-theme',s);}}catch(e){}window.wdocToggleTheme=function(){var lt=window.matchMedia&&window.matchMedia('(prefers-color-scheme: light)').matches;var cur=r.getAttribute('data-theme')||(lt?'light':'dark');var n=(cur==='dark')?'light':'dark';r.setAttribute('data-theme',n);try{localStorage.setItem('wdoc-theme',n);}catch(e){}};})();</script>",
  },
]

// Centre the current chapter in the sidebar's scroll viewport on page load.
// The sidebar is `position: fixed`, so it IS the chapter <a>'s offsetParent
// — `c.offsetTop` reads from the sidebar's top directly. Subtract half the
// visible height to centre; the browser clamps out-of-range scrollTop values
// to [0, scrollHeight - clientHeight], so chapters near the top or bottom
// need no special-case.
let book_sidebar_scroll = HtmlFundamental::Raw {
  html: "<script>(function(){var c=document.querySelector('.book-chapter.current');if(!c)return;var n=document.querySelector('.book-sidebar');if(n)n.scrollTop=c.offsetTop-n.clientHeight/2;})();</script>",
}

// Manual expand/collapse: a delegated click handler on the sidebar toggles a
// branch's `open` class. Clicking anywhere on a branch's row — the toggle arrow
// or its section label — flips it, so an index container expands without having
// to hit the little arrow. Clicks on a real chapter `<a>` are left to navigate
// (a branch that also links to a page still opens that page from its label), and
// a leaf row (no branch) is ignored. Server-side rendering already opens the
// active path; this just lets the reader override it.
let book_sidebar_toggle = HtmlFundamental::Raw {
  html: "<script>(function(){var s=document.querySelector('.book-sidebar');if(!s)return;s.addEventListener('click',function(e){if(!e.target.closest)return;if(e.target.closest('a'))return;var row=e.target.closest('.book-toc-row');if(!row)return;var li=row.parentNode;if(li&&li.classList&&li.classList.contains('book-branch')){e.preventDefault();li.classList.toggle('open');}});})();</script>",
}

