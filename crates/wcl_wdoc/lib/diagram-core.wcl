// SVG canvas. Width/height define the viewBox and rendered size,
// and the parent box for diagram-level anchored shapes.
namespace wdoc

@block("diagram")
@native
type Diagram extends ContentBlock {
  @doc("Diagram canvas width in pixels.")
  width:  i64
  @doc("Diagram canvas height in pixels.")
  height: i64
  @doc("Optional explicit HTML id.")
  id:     identifier?
  @doc("Optional style classes.")
  class:  list<utf8>?

  // Layout: :none (default) honors per-shape x/y; :grid uses the
  // grid-cell knobs (cell_width/cell_height/columns/gap), same as
  // Container; :layered topologically ranks shapes via the
  // diagram's @connections(Edge) graph and assigns x/y; :force
  // runs a force-directed simulation (shapes repel each other,
  // @connections(Edge) edges attract) and assigns x/y — best for
  // cyclic / undirected graphs that have no natural rank order.
  @doc("Layout mode: `:free` (default, manual x/y) / `:grid` / `:layered` / `:force` / `:radial`.")
  layout:      symbol?
  @doc("Flow direction for `:layered`: `:top_to_bottom` (default) / `:left_to_right`.")
  direction:   symbol?      // :top_to_bottom (default) | :left_to_right
  @doc("Spacing between ranks (layers) in `:layered` layout.")
  layer_gap:   f64?         // gap between ranks
  @doc("Spacing between nodes within a rank in `:layered` layout.")
  node_gap:    f64?         // gap between nodes within a rank
  @doc("Grid cell width for `:grid` layout.")
  cell_width:  f64?
  @doc("Grid cell height for `:grid` layout.")
  cell_height: f64?
  @doc("Number of columns for `:grid` layout.")
  columns:     i64?
  @doc("Gap between cells in `:grid` layout.")
  gap:         f64?

  // Force-directed (:force) knobs. All optional with sensible
  // defaults; the layout is deterministic for a given `seed`.
  @doc("`:force` relaxation steps (default 300).")
  iterations:    i64?       // relaxation steps (default 300)
  @doc("`:force` node repulsion strength (default 9000).")
  repulsion:     f64?       // node repulsion strength (default 9000)
  @doc("`:force` ideal edge-to-edge length (default 60).")
  link_distance: f64?       // ideal edge-to-edge length (default 60)
  @doc("`:force` centering pull (default 0.05).")
  gravity:       f64?       // centering pull (default 0.05)
  @doc("`:force` random seed for reproducible layouts (default 1).")
  seed:          i64?       // re-arrange reproducibly (default 1)

  // Radial (:radial) hub-and-spoke knobs. The hub sits at the centre and
  // every other shape is placed on a ring around it, ranked by graph
  // distance. All optional; `node_gap` (above) doubles as the minimum
  // edge-to-edge gap between shapes on a ring.
  @doc("`:radial` hub shape id (defaults to the highest-degree shape).")
  hub:           identifier?
  @doc("`:radial` radius of the first ring (default: auto-fit to shape sizes).")
  radius:        f64?
  @doc("`:radial` added radius per successive ring (default 120).")
  ring_gap:      f64?
  @doc("`:radial` angle (radians) of the first shape on each ring (default -PI/2, i.e. top).")
  start_angle:   f64?

  // Edge rendering.
  @doc("Edge routing: `:elbow` (default) / `:straight`.")
  routing:         symbol?  // :elbow (default) | :straight
  @doc("Nudge step that separates parallel edges (default 4).")
  edge_separation: f64?     // nudge step for parallel edges (default 4)

  // Interactive pan + zoom (client-side). pan_zoom wraps the diagram in
  // a viewport with wheel-zoom, drag-pan, and +/-/reset buttons. When
  // zoomed in you can overscroll half a viewport past each content edge;
  // pan_margin adds extra slack on top.
  @doc("When `true`, wrap in an interactive viewport with wheel-zoom, drag-pan, and `+`/`−`/`⟲` controls.")
  pan_zoom:   bool?         // enable interactive pan + zoom
  @doc("Minimum zoom scale; `1.0` = fitted view (default 1.0).")
  zoom_min:   f64?          // min zoom scale, 1.0 = fitted view (default 1.0)
  @doc("Maximum zoom scale (default 4.0).")
  zoom_max:   f64?          // max zoom scale (default 4.0)
  @doc("Extra overscroll past the content bounds, in px (default 0).")
  pan_margin: f64?          // extra overscroll past the content, px (default 0)

  @doc("Accessible description: becomes the SVG's `<title>` and `aria-label`, so screen readers can announce the diagram.")
  desc: utf8?               // accessible name (SVG <title> + aria-label)

  @doc("The shapes drawn in the diagram.")
  @children(SvgBlock) children: list<SvgBlock>
  @doc("Edges connecting shapes (`a -> b`).")
  @connections(Edge) edges: list<Edge>
}

// SVG <g> group with optional layout. Layout modes:
//   :none    (default) — children render at their own resolved boxes.
//   :grid              — children are placed into a `columns × rows`
//                        grid; each cell is `cell_width × cell_height`
//                        separated by `gap`. Per-cell child receives
//                        `(cell_width, cell_height)` as its parent
//                        size, so anchored children stretch to the
//                        cell.
//   :layered           — topological rank from the container's
//                        @connections(Edge) graph; each rank is
//                        spaced by `layer_gap`, nodes within a
//                        rank by `node_gap`. Flow direction is
//                        controlled by `direction` (default
//                        :top_to_bottom). Per-shape width/height
//                        are honored.
//   :force             — force-directed: children repel one
//                        another and @connections(Edge) edges pull
//                        connected children together, relaxed over
//                        `iterations` steps. Tunable via
//                        `repulsion` / `link_distance` / `gravity`
//                        and deterministic per `seed`. Suits
//                        cyclic / undirected graphs.
//   :radial            — hub-and-spoke: the `hub` shape (or the
//                        highest-degree one) sits at the centre and
//                        every other shape is placed on a ring around
//                        it, ranked by graph distance from the hub.
//                        Tunable via `radius` / `ring_gap` /
//                        `start_angle` / `node_gap`. Suits a focus
//                        entity wired to many neighbours.
// Anchors on the container itself resolve against the parent box and
// can resize the container; that new size flows to its own children.
@block("container")
@native
type Container extends SvgBlock {
  @doc("Name used to connect the shape (`a -> b`) and to anchor others to it.")
  id:    identifier?
  @doc("Style classes — text and SVG paint via the `class` system.")
  class: list<utf8>?
  @doc("Link the shape to an in-site page (bare page name, or `site:page`). Wraps it in a clickable `<a>`; an unknown page fails the build like a bad prose link.")
  link: utf8?

  // Optional chrome. When either is set the renderer emits a
  // background <rect> the full size of the container's box,
  // making the grouping visible. The chrome is purely visual —
  // it does NOT participate in obstacle routing, so cross-
  // container edges still pass through cleanly.
  @doc("Optional chrome — outline colour of the background rect that makes the group visible.")
  stroke: utf8?
  @doc("Optional chrome — fill colour of the background rect that makes the group visible.")
  fill:   utf8?

  // Inset applied to children. Grows the container's outer box
  // by 2*padding on each axis and shifts the children inward
  // by `padding`, so chrome doesn't touch the shapes inside.
  @doc("Inset between the chrome and the child shapes.")
  padding: f64?

  // Declared interior size (used when no layout/anchor is sizing
  // this container — e.g. a top-level container in a diagram).
  @doc("Declared interior width (when no layout/anchor sizes it).")
  width:  f64?
  @doc("Declared interior height (when no layout/anchor sizes it).")
  height: f64?

  // Layout
  @doc("Layout mode: `:free` (default, manual) / `:grid` / `:layered` / `:force` / `:radial`.")
  layout:      symbol?
  @doc("Number of columns for `:grid` layout.")
  columns:     i64?
  @doc("Grid cell width for `:grid` layout.")
  cell_width:  f64?
  @doc("Grid cell height for `:grid` layout.")
  cell_height: f64?
  @doc("Gap between cells in `:grid` layout.")
  gap:         f64?
  @doc("Flow direction for `:layered`: `:top_to_bottom` (default) / `:left_to_right`.")
  direction:   symbol?    // :top_to_bottom (default) | :left_to_right
  @doc("Spacing between ranks (layers) in `:layered` layout.")
  layer_gap:   f64?
  @doc("Spacing between nodes within a rank in `:layered` layout.")
  node_gap:    f64?

  // Force-directed (:force) knobs. Optional; deterministic per `seed`.
  @doc("`:force` relaxation steps (default 300).")
  iterations:    i64?     // relaxation steps (default 300)
  @doc("`:force` node repulsion strength (default 9000).")
  repulsion:     f64?     // node repulsion strength (default 9000)
  @doc("`:force` ideal edge-to-edge length (default 60).")
  link_distance: f64?     // ideal edge-to-edge length (default 60)
  @doc("`:force` centering pull (default 0.05).")
  gravity:       f64?     // centering pull (default 0.05)
  @doc("`:force` random seed for reproducible layouts (default 1).")
  seed:          i64?     // re-arrange reproducibly (default 1)

  // Radial (:radial) hub-and-spoke knobs. Hub at the centre, every other
  // shape on a ring around it ranked by graph distance. `node_gap` (above)
  // is the minimum edge-to-edge gap between shapes on a ring.
  @doc("`:radial` hub shape id (defaults to the highest-degree shape).")
  hub:           identifier?
  @doc("`:radial` radius of the first ring (default: auto-fit to shape sizes).")
  radius:        f64?
  @doc("`:radial` added radius per successive ring (default 120).")
  ring_gap:      f64?
  @doc("`:radial` angle (radians) of the first shape on each ring (default -PI/2, i.e. top).")
  start_angle:   f64?

  // Anchors (resolve against the parent's box).
  @doc("Fractional anchor (0–1) pinning the left edge to the parent box.")
  anchor_left:   f64?
  @doc("Fractional anchor (0–1) pinning the right edge to the parent box.")
  anchor_right:  f64?
  @doc("Fractional anchor (0–1) pinning the top edge to the parent box.")
  anchor_top:    f64?
  @doc("Fractional anchor (0–1) pinning the bottom edge to the parent box.")
  anchor_bottom: f64?

  @doc("Which sides (`:left`/`:right`/`:top`/`:bottom`) edges attach to.")
  connect_points: list<AnchorSide>?

  @doc("Icon-badge icon (a `pack.name`).")
  icon: utf8?
  @doc("Icon-badge size.")
  icon_size: f64?
  @doc("Icon-badge position (`:center` / `:top_left` / …).")
  icon_pos: IconPos?
  @doc("Icon-badge style classes.")
  icon_class: list<utf8>?

  @doc("The child shapes laid out by the container.")
  @children(SvgBlock) children: list<SvgBlock>
  @doc("Edges connecting child shapes (`a -> b`).")
  @connections(Edge) edges: list<Edge>
  // `container` is itself rendered directly as a <g> in Rust.
}

// A labelled box drawn *behind* a set of member shapes, sized to their
// post-layout bounding box (plus `padding`). Unlike `container`, a
// boundary owns no layout: it never moves its members and never
// participates in the diagram's solver — it's a pure visual overlay
// keyed by member id, so it works with every layout (`:radial` /
// `:force` / `:layered` / `:grid` / `:none`). This is the C4
// "boundary" (enterprise / system / team): on a `:radial` System
// Context you can box the systems you own wherever the solver placed
// them. Like `container` chrome the rect is synthesised by the
// renderer and is NOT an obstacle, so edges cross it cleanly.
@block("boundary")
@native
type Boundary extends SvgBlock {
  @doc("Title drawn on/above the box (inline label).")
  @inline(0) label: utf8?
  @doc("Ids of the shapes to enclose — resolved anywhere in the diagram, like edge endpoints.")
  members: list<identifier>
  @doc("Outline colour (default: themed border via the `wdoc-boundary` class).")
  stroke:  utf8?
  @doc("Optional translucent fill (default: themed via the `wdoc-boundary` class).")
  fill:    utf8?
  @doc("Inset between the box and the member bounding box (default 12).")
  padding: f64?
  @doc("Label placement: `:top_left` (default) / `:top` / `:top_right` / `:bottom_left` / `:bottom` / `:bottom_right`.")
  label_pos: symbol?
  @doc("Style classes — text and SVG paint via the `class` system.")
  class:   list<utf8>?
  @doc("Optional id (a boundary is not itself a connection endpoint).")
  id:      identifier?
  // A boundary is drawn in Rust: its geometry comes from post-layout
  // member bboxes, which isn't expressible in WCL.
}

@block("rect")
@native
type Rect extends SvgBlock {
  @doc("Top-left x corner, in canvas pixels.")
  x:      f64?
  @doc("Top-left y corner, in canvas pixels.")
  y:      f64?
  @doc("Box width.")
  width:  f64?
  @doc("Box height.")
  height: f64?
  @doc("Fill colour.")
  fill:   utf8?
  @doc("Outline colour.")
  stroke: utf8?
  @doc("Name used to connect the shape (`a -> b`) and to anchor others to it.")
  id:     identifier?
  @doc("Style classes — text and SVG paint via the `class` system.")
  class:  list<utf8>?

  @doc("Fractional anchor (0–1) pinning the left edge to the parent box.")
  anchor_left:   f64?
  @doc("Fractional anchor (0–1) pinning the right edge to the parent box.")
  anchor_right:  f64?
  @doc("Fractional anchor (0–1) pinning the top edge to the parent box.")
  anchor_top:    f64?
  @doc("Fractional anchor (0–1) pinning the bottom edge to the parent box.")
  anchor_bottom: f64?

  @doc("Which sides (`:left`/`:right`/`:top`/`:bottom`) edges attach to.")
  connect_points: list<AnchorSide>?

  @doc("Icon-badge icon (a `pack.name`).")
  icon: utf8?
  @doc("Icon-badge size.")
  icon_size: f64?
  @doc("Icon-badge position (`:center` / `:top_left` / …).")
  icon_pos: IconPos?
  @doc("Icon-badge style classes.")
  icon_class: list<utf8>?
  @doc("Link the shape to an in-site page (bare page name, or `site:page`). Wraps it in a clickable `<a>`; an unknown page fails the build like a bad prose link.")
  link: utf8?
}

@block("circle")
@native
type Circle extends SvgBlock {
  @doc("Centre x point.")
  cx:     f64?
  @doc("Centre y point.")
  cy:     f64?
  @doc("Radius.")
  r:      f64?
  @doc("Fill colour.")
  fill:   utf8?
  @doc("Outline colour.")
  stroke: utf8?
  @doc("Name used to connect the shape (`a -> b`) and to anchor others to it.")
  id:     identifier?
  @doc("Style classes — text and SVG paint via the `class` system.")
  class:  list<utf8>?

  @doc("Fractional anchor (0–1) pinning the left edge to the parent box.")
  anchor_left:   f64?
  @doc("Fractional anchor (0–1) pinning the right edge to the parent box.")
  anchor_right:  f64?
  @doc("Fractional anchor (0–1) pinning the top edge to the parent box.")
  anchor_top:    f64?
  @doc("Fractional anchor (0–1) pinning the bottom edge to the parent box.")
  anchor_bottom: f64?

  @doc("Which sides (`:left`/`:right`/`:top`/`:bottom`) edges attach to.")
  connect_points: list<AnchorSide>?

  @doc("Icon-badge icon (a `pack.name`).")
  icon: utf8?
  @doc("Icon-badge size.")
  icon_size: f64?
  @doc("Icon-badge position (`:center` / `:top_left` / …).")
  icon_pos: IconPos?
  @doc("Icon-badge style classes.")
  icon_class: list<utf8>?
  @doc("Link the shape to an in-site page (bare page name, or `site:page`). Wraps it in a clickable `<a>`; an unknown page fails the build like a bad prose link.")
  link: utf8?
}

@block("line")
@native
type Line extends SvgBlock {
  @doc("Start-point x.")
  x1:     f64?
  @doc("Start-point y.")
  y1:     f64?
  @doc("End-point x.")
  x2:     f64?
  @doc("End-point y.")
  y2:     f64?
  @doc("Line colour.")
  stroke: utf8?
  @doc("Name used to connect the shape (`a -> b`) and to anchor others to it.")
  id:     identifier?
  @doc("Style classes — text and SVG paint via the `class` system.")
  class:  list<utf8>?

  @doc("Fractional anchor (0–1) pinning the left edge to the parent box.")
  anchor_left:   f64?
  @doc("Fractional anchor (0–1) pinning the right edge to the parent box.")
  anchor_right:  f64?
  @doc("Fractional anchor (0–1) pinning the top edge to the parent box.")
  anchor_top:    f64?
  @doc("Fractional anchor (0–1) pinning the bottom edge to the parent box.")
  anchor_bottom: f64?

  @doc("Which sides (`:left`/`:right`/`:top`/`:bottom`) edges attach to.")
  connect_points: list<AnchorSide>?
  @doc("Link the shape to an in-site page (bare page name, or `site:page`). Wraps it in a clickable `<a>`; an unknown page fails the build like a bad prose link.")
  link: utf8?
}

// SVG <text> shape. Renamed from `text` to avoid colliding with the
// paragraph block kind.
@block("label")
@native
type Label extends SvgBlock {
  @doc("The text, given as the inline label: `label \"halfway\" { … }`.")
  @inline(0) content: utf8
  @doc("Anchor x position.")
  x:     f64?
  @doc("Anchor y position.")
  y:     f64?
  // Optional font-size override. When unset, the renderer picks a
  // size that fits `content` inside `fit_width` × `fit_height`
  // (capped at the renderer's default), or its default for a
  // stand-alone label with no fit region.
  @doc("Explicit font size; when omitted the text auto-fits its region.")
  font_size:  f64?
  @doc("Width of the region the text is auto-sized to fit (when `font_size` is unset).")
  fit_width:  f64?
  @doc("Height of the region the text is auto-sized to fit (when `font_size` is unset).")
  fit_height: f64?
  @doc("Text colour.")
  fill:  utf8?
  @doc("Name used to connect the shape (`a -> b`) and to anchor others to it.")
  id:    identifier?
  @doc("Style classes — text and SVG paint via the `class` system.")
  class: list<utf8>?

  @doc("Fractional anchor (0–1) pinning the left edge to the parent box.")
  anchor_left:   f64?
  @doc("Fractional anchor (0–1) pinning the right edge to the parent box.")
  anchor_right:  f64?
  @doc("Fractional anchor (0–1) pinning the top edge to the parent box.")
  anchor_top:    f64?
  @doc("Fractional anchor (0–1) pinning the bottom edge to the parent box.")
  anchor_bottom: f64?

  @doc("Which sides (`:left`/`:right`/`:top`/`:bottom`) edges attach to.")
  connect_points: list<AnchorSide>?
  @doc("Link the shape to an in-site page (bare page name, or `site:page`). Wraps it in a clickable `<a>`; an unknown page fails the build like a bad prose link.")
  link: utf8?
}

@block("polygon")
@native
type Polygon extends SvgBlock {
  @doc("Space-separated `x,y` pairs, e.g. `\"180,10 230,40 180,70\"`.")
  points: utf8
  @doc("Fill colour.")
  fill:   utf8?
  @doc("Outline colour.")
  stroke: utf8?
  @doc("Name used to connect the shape (`a -> b`) and to anchor others to it.")
  id:     identifier?
  @doc("Style classes — text and SVG paint via the `class` system.")
  class:  list<utf8>?

  @doc("Fractional anchor (0–1) pinning the left edge to the parent box.")
  anchor_left:   f64?
  @doc("Fractional anchor (0–1) pinning the right edge to the parent box.")
  anchor_right:  f64?
  @doc("Fractional anchor (0–1) pinning the top edge to the parent box.")
  anchor_top:    f64?
  @doc("Fractional anchor (0–1) pinning the bottom edge to the parent box.")
  anchor_bottom: f64?

  @doc("Which sides (`:left`/`:right`/`:top`/`:bottom`) edges attach to.")
  connect_points: list<AnchorSide>?
  @doc("Link the shape to an in-site page (bare page name, or `site:page`). Wraps it in a clickable `<a>`; an unknown page fails the build like a bad prose link.")
  link: utf8?
}

// ── Lowering layer ─────────────────────────────────────────────────
//
// Custom shapes ship as a `@block` declaration + a top-level
// `<kind>_lower` function returning `list<Svg>` (SVG
// diagram shapes) or `list<Html>` (page-level blocks).
// The renderer recursively lowers each returned variant until only
// fundamentals remain. Users add their own shapes by declaring the
// same pair in user source.

// ── Constructing a fundamental ─────────────────────────────────────
//
// Applies to BOTH unions below. An optional (`field?`) member defaults
// to `none` when omitted, so writing `stroke: none` is dead weight, not
// opting out — only required fields have to be supplied. A `class` list
// additionally DROPS its `none` entries, which is what makes an
// else-less `if` legal inline (`class: ["axis", if hi { "hot" }]`); a
// list whose every entry is `none` emits no `class` attribute at all,
// not an empty one. `Element.attrs` drops a `none` pair the same way.

// `Rect.rx` rounds the corners (statechart state boxes). `Line.dash` /
// `Polyline.dash` is an inline `stroke-dasharray` value (e.g. `"4 4"`)
// — inline rather than a theme class so dashes survive the PDF
// backend's SVG embedding. `Polyline` is an *open* multi-segment path
// (self-message loops, open arrowheads, stick figures); it never
// fills. `Link` wraps child fundamentals in a clickable in-site link
// (same `link` semantics as diagram shapes: bare page name or
// `site:page`).
union Svg {
  Rect    { x: f64? y: f64? width: f64? height: f64? rx: f64? fill: utf8? stroke: utf8? id: identifier? class: list<utf8>? }
  Circle  { cx: f64? cy: f64? r: f64? fill: utf8? stroke: utf8? id: identifier? class: list<utf8>? }
  Line    { x1: f64? y1: f64? x2: f64? y2: f64? stroke: utf8? dash: utf8? id: identifier? class: list<utf8>? }
  Label   { content: utf8 x: f64? y: f64? font_size: f64? fit_width: f64? fit_height: f64? fill: utf8? id: identifier? class: list<utf8>? }
  Polygon { points: utf8 fill: utf8? stroke: utf8? id: identifier? class: list<utf8>? }
  Polyline { points: utf8 stroke: utf8? dash: utf8? id: identifier? class: list<utf8>? }
  Link    { href: utf8 children: list<Svg> }
}

union Html {
  // Typed authored-block placement. The renderer resolves these handles
  // only after template evaluation has returned the complete element tree.
  Blocks { blocks: list<BlockHandle> slot: symbol? owner: utf8? fallback: list<Html>? }
  Paragraph { id: identifier? class: list<utf8>? spans: list<utf8> }
  // Table — `header` is the heading row (rendered as <th> inside
  // <thead>; omit or leave empty for a header-less table); `rows` are
  // the body rows (<td> inside <tbody>). On this lowering path cells
  // are plain escaped text, mirroring `Paragraph`'s escaped spans.
  // The user-facing `table` block authors rows with WCL's pipe-table
  // syntax and additionally runs utf8 cells through inline patterns.
  Table { id: identifier? class: list<utf8>? header: list<utf8>? rows: list<list<utf8>> }
  // Generic structural element: `<tag id class attrs…>children</tag>`.
  // Recursive — `children` are themselves fundamentals — so templates
  // can build arbitrary layout (header / nav / main / footer / a / …).
  // `attrs` is a list of `[name, value]` pairs (values escaped), e.g.
  // `[["href", p.href]]`.
  Element { tag: utf8 id: identifier? class: list<utf8>? attrs: list<list<utf8>>? children: list<Html> }
  // Verbatim, pre-rendered HTML — NOT escaped. Used to embed already-
  // rendered content (e.g. a page's `content` part) inside a template.
  Raw { html: utf8 }
  // Head content. When a template (or a part it calls) returns a `Head`
  // at the TOP LEVEL of its fundamentals list, the renderer hoists its
  // `children` into the page `<head>` instead of the `<body>` — the seam
  // a custom (e.g. `website`) layout uses to add `<link>` / `<script>` /
  // `<meta>` / fonts. A `Head` nested inside the body renders to nothing.
  Head { children: list<Html> }
  // An icon, resolved against the declared `iconset`s (and, for a
  // `pack.name`, the compiled-in packs). The renderer records it for
  // the shared sprite and emits `<svg class="wdoc-icon …"><use …/></svg>`
  // (currentColor, so it inherits its container's colour). Used by the
  // stdlib `callout` lowering; available to any HTML lowering.
  Icon { name: utf8 class: list<utf8>? }
  // An inline prose run: `text` is fed through the inline-pattern engine
  // (bold / italic / link / icon) and emitted as HTML. The regex engine
  // is Rust (a leaf); the `<p>` / `<span>` wrappers come from WCL (the
  // `text` lower). Authors usually use the `text` block, not this directly.
  Inline { text: utf8 }
  // A syntax-highlighted code body: `source` is tokenised by `language`
  // and emitted as `<span class="tok-…">` runs (no wrapper). syntect is
  // Rust (a leaf); the `<pre><code>` wrapper comes from the `code` lower.
  Highlighted { source: utf8 language: utf8 }
  // A LaTeX equation rendered to a self-contained SVG (RaTeX). `display`
  // selects display vs text style. The pipeline is Rust (a leaf, like
  // `Highlighted`); the centring `<div>` wrapper comes from the `math`
  // lower. Equations paint with `currentColor`, so they follow the
  // surrounding text colour.
  Math { latex: utf8 display: bool? class: list<utf8>? }
}

// Styling for interactive (pan + zoom) diagrams. Only a `pan_zoom`
// diagram gets the `.wdoc-diagram-viewport` wrapper, so plain diagrams
// are untouched; the controls paint with `currentColor` so they adopt the
// page theme. The bundled `diagram-pan-zoom.js` drives the SVG `viewBox`.
// Uses descendant + compound + `:hover` selectors, so it can't be a bare
// `class`.
stylesheet "wdoc-diagram" {
  css = <<CSS
    .wdoc-diagram-viewport { position: relative; display: inline-block; max-width: 100%; }
    .wdoc-diagram-viewport svg { display: block; max-width: 100%; height: auto; touch-action: none; cursor: grab; }
    .wdoc-diagram-viewport.panning svg { cursor: grabbing; }
    .wdoc-diagram-controls { position: absolute; top: 6px; right: 6px; display: flex; flex-direction: column; gap: 4px; }
    .wdoc-diagram-controls button { width: 1.6rem; height: 1.6rem; padding: 0; display: flex; align-items: center; justify-content: center; font: inherit; font-size: 1rem; line-height: 1; cursor: pointer; color: inherit; background: rgba(127,127,127,0.12); border: 1px solid currentColor; border-radius: 4px; opacity: 0.6; }
    .wdoc-diagram-controls button:hover { opacity: 1; }
    CSS
}
