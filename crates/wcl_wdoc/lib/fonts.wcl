// ── Book typography ────────────────────────────────────────────────
//
// The three families the book template reads through `--wdoc-font-head`
// (IBM Plex Sans), `--wdoc-font-body` (Source Serif 4) and
// `--wdoc-font-mono` (JetBrains Mono). The faces are embedded in the
// binary and written to `_wdoc/` with the other shared assets (see
// `build.rs::write_book_font_assets`), so the `@font-face` rules below
// resolve when served / hosted — they are not opened directly from disk.
//
// Only the `@font-face` rules live here (no `--wdoc-*`, so a site-less doc
// stays bare). The `--wdoc-font-head/-body/-mono` defaults are emitted by
// `render/theme.rs::site_theme_css` for themed sites, where a theme's
// `font_head` / `font_body` / `font_mono` fields (e.g. `paper`'s serif
// headings) override them.
//
// NB: this is the plain `'JetBrains Mono'` family for prose code, a
// different face from the terminal grid's `'JetBrainsMono Nerd Font'`.
namespace wdoc

stylesheet "wdoc-fonts" {
  css = <<CSS
    @font-face { font-family: 'Source Serif 4'; font-weight: 400; font-style: normal; font-display: swap; src: url('_wdoc/SourceSerif4-Regular.woff2') format('woff2'); }
    @font-face { font-family: 'Source Serif 4'; font-weight: 500; font-style: normal; font-display: swap; src: url('_wdoc/SourceSerif4-Medium.woff2') format('woff2'); }
    @font-face { font-family: 'Source Serif 4'; font-weight: 600; font-style: normal; font-display: swap; src: url('_wdoc/SourceSerif4-SemiBold.woff2') format('woff2'); }
    @font-face { font-family: 'Source Serif 4'; font-weight: 700; font-style: normal; font-display: swap; src: url('_wdoc/SourceSerif4-Bold.woff2') format('woff2'); }
    @font-face { font-family: 'Source Serif 4'; font-weight: 400; font-style: italic; font-display: swap; src: url('_wdoc/SourceSerif4-Italic.woff2') format('woff2'); }
    @font-face { font-family: 'Source Serif 4'; font-weight: 500; font-style: italic; font-display: swap; src: url('_wdoc/SourceSerif4-MediumItalic.woff2') format('woff2'); }
    @font-face { font-family: 'IBM Plex Sans'; font-weight: 400; font-style: normal; font-display: swap; src: url('_wdoc/IBMPlexSans-Regular.woff2') format('woff2'); }
    @font-face { font-family: 'IBM Plex Sans'; font-weight: 500; font-style: normal; font-display: swap; src: url('_wdoc/IBMPlexSans-Medium.woff2') format('woff2'); }
    @font-face { font-family: 'IBM Plex Sans'; font-weight: 600; font-style: normal; font-display: swap; src: url('_wdoc/IBMPlexSans-SemiBold.woff2') format('woff2'); }
    @font-face { font-family: 'IBM Plex Sans'; font-weight: 700; font-style: normal; font-display: swap; src: url('_wdoc/IBMPlexSans-Bold.woff2') format('woff2'); }
    @font-face { font-family: 'JetBrains Mono'; font-weight: 400; font-style: normal; font-display: swap; src: url('_wdoc/JetBrainsMono-Regular.woff2') format('woff2'); }
    @font-face { font-family: 'JetBrains Mono'; font-weight: 500; font-style: normal; font-display: swap; src: url('_wdoc/JetBrainsMono-Medium.woff2') format('woff2'); }
    @font-face { font-family: 'JetBrains Mono'; font-weight: 600; font-style: normal; font-display: swap; src: url('_wdoc/JetBrainsMono-SemiBold.woff2') format('woff2'); }
  CSS
}
