// ── Book typography ────────────────────────────────────────────────
//
// The three families the book template reads through `--wdoc-font-head`
// (IBM Plex Sans), `--wdoc-font-body` (Source Serif 4) and
// `--wdoc-font-mono` (JetBrains Mono). The faces are embedded in the
// binary and written to `_wdoc/` with the other shared assets (see
// `build.rs::write_book_font_assets`), so the `@font-face` rules below
// resolve when served / hosted — they are not opened directly from disk.
//
// Only the `@font-face` rules live here (no `--wdoc-*`, so a site-less doc
// stays bare). The `--wdoc-font-head/-body/-mono` defaults are emitted by
// `render/theme.rs::site_theme_css` for themed sites, where a theme's
// `font_head` / `font_body` / `font_mono` fields (e.g. `paper`'s serif
// headings) override them.
//
// NB: this is the plain `'JetBrains Mono'` family for prose code, a
// different face from the terminal grid's `'JetBrainsMono Nerd Font'`.
namespace wdoc

font_face "'Source Serif 4'" { src = "url('_wdoc/SourceSerif4-Regular.woff2') format('woff2')"  weight = "400"  style = "normal"  display = "swap" }
font_face "'Source Serif 4'" { src = "url('_wdoc/SourceSerif4-Medium.woff2') format('woff2')"  weight = "500"  style = "normal"  display = "swap" }
font_face "'Source Serif 4'" { src = "url('_wdoc/SourceSerif4-SemiBold.woff2') format('woff2')"  weight = "600"  style = "normal"  display = "swap" }
font_face "'Source Serif 4'" { src = "url('_wdoc/SourceSerif4-Bold.woff2') format('woff2')"  weight = "700"  style = "normal"  display = "swap" }
font_face "'Source Serif 4'" { src = "url('_wdoc/SourceSerif4-Italic.woff2') format('woff2')"  weight = "400"  style = "italic"  display = "swap" }
font_face "'Source Serif 4'" { src = "url('_wdoc/SourceSerif4-MediumItalic.woff2') format('woff2')"  weight = "500"  style = "italic"  display = "swap" }
font_face "'IBM Plex Sans'" { src = "url('_wdoc/IBMPlexSans-Regular.woff2') format('woff2')"  weight = "400"  style = "normal"  display = "swap" }
font_face "'IBM Plex Sans'" { src = "url('_wdoc/IBMPlexSans-Medium.woff2') format('woff2')"  weight = "500"  style = "normal"  display = "swap" }
font_face "'IBM Plex Sans'" { src = "url('_wdoc/IBMPlexSans-SemiBold.woff2') format('woff2')"  weight = "600"  style = "normal"  display = "swap" }
font_face "'IBM Plex Sans'" { src = "url('_wdoc/IBMPlexSans-Bold.woff2') format('woff2')"  weight = "700"  style = "normal"  display = "swap" }
font_face "'JetBrains Mono'" { src = "url('_wdoc/JetBrainsMono-Regular.woff2') format('woff2')"  weight = "400"  style = "normal"  display = "swap" }
font_face "'JetBrains Mono'" { src = "url('_wdoc/JetBrainsMono-Medium.woff2') format('woff2')"  weight = "500"  style = "normal"  display = "swap" }
font_face "'JetBrains Mono'" { src = "url('_wdoc/JetBrainsMono-SemiBold.woff2') format('woff2')"  weight = "600"  style = "normal"  display = "swap" }
