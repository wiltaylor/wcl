// ── Stdlib paragraph ───────────────────────────────────────────────
//
// Shorthand for a single-span text block. Lowers to a
// `Content::Paragraph` — the semantic content IR's body-prose node — so
// every backend renders it from one declaration rather than from a `<p>`
// each had to recognise. The text runs through the inline-pattern engine
// (on every backend, since the IR carries prose rather than markup), so
// `**bold**`, `_italic_`, `` `code` ``, `[links](page)`, `:icons:` and
// `$math$` all work inside `p "..." {}`. Use the long form
// `text { span … {} … }` when you want several spans in one paragraph.

namespace wdoc

@block("p")
type P extends WdocBlock {
  @doc("The paragraph text (the inline label slot); inline patterns are applied.")
  @inline(0) text: utf8
  @doc("Optional explicit HTML id.")
  id:    identifier?
  @doc("Optional style classes.")
  class: list<utf8>?
  lower = fn(p: P) -> list<Content> [
    Content::Paragraph { text: p.text, id: p.id, class: p.class }
  ]
}
