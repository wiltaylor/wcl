// Core wdoc schema: the document root (`Site`), the renderable-block
// interfaces, and the page/class blocks. These are the IR layer that
// the HTML renderer (and future targets) speak; higher-level blocks
// lower to these via the per-block `lower` functions.
//
// This is one part of the wdoc standard library — `wdoc/prelude.wcl`
// pulls every part together, and the wdoc binary makes the schema
// available by prepending a single `import <wdoc/prelude.wcl>` line to
// the user's source before parsing.

namespace wdoc

@document
type Site {
  @children("class")          classes:     list<Class>
  @children("stylesheet")     stylesheets: list<Stylesheet>
  @children("page")           pages:       list<Page>
  @children("inline_pattern") patterns:    list<InlinePattern>
  @children("template")       templates:   list<Template>
  @children("iconset")        iconsets:    list<IconSet>
  @children("tileset")        tilesets:    list<Tileset>
  @children("theme")          themes:      list<ThemeBlock>
  // User-defined reusable templates (declarative markup + slots),
  // instantiated by their own name as bare blocks inside pages.
  @children("wdoc_component") components:  list<WdocComponent>
  // Document-level `wdoc_repeater`s whose body is `page` blocks: each emits
  // one rendered page per element of `each` (the page's interpolated label
  // becomes the route). See `components.wcl`.
  @children("wdoc_repeater")  generators:  list<WdocRepeater>
  // Tagged content deposits gathered by a matching `collect`. Legal at the
  // document root so partials can be scattered across imported files; also
  // legal inside any page (via `ContentBlock`).
  @children("partial")        partials:    list<WdocPartial>
  // Standalone addressable content fragments at the document root (and in
  // eagerly-imported files). Rendered by reference via `project`; a body
  // attached to a data record needs no root slot. See `project.wcl`.
  @children("body")           bodies:      list<WdocAddressableBody>
  // A document may declare several named `site` blocks; each renders to
  // its own subdirectory (a single site renders flat at the output
  // root). Absent ⇒ pages render bare. See `Page.sites` for membership.
  @children("site")           sites:       list<SiteConfig>
  // Claude Code agent definitions — document-level peers of `site`,
  // written by the `:ai_skill` target to `agents/<name>.md` at the output
  // root (beside the skill folder(s)); ignored by every other target. See
  // `AgentConfig` in templates.wcl.
  @children("agent")          agents:      list<AgentConfig>
  // Other wdoc documents found under a folder, each built independently
  // and shipped into a subdirectory of this output (not merged into this
  // document — see `include.wcl`). HTML build / dev server only.
  @children("include")        includes:    list<IncludeSites>
}

// Raw stylesheet. Carries CSS that the bare-class `class` system can't
// express (descendant / compound / pseudo selectors, `@font-face`,
// `@keyframes`, `var()`, …). The build collects every `stylesheet` block
// — bundled ones (from this stdlib, co-located with the block they style)
// before user ones — and injects their `css` verbatim into each page's
// `<head>` ahead of the `class` rules, so user `class`/`stylesheet` rules
// still win by cascade. A user may declare their own for advanced CSS.
@block("stylesheet")
type Stylesheet {
  @inline(0) name: identifier
  css: utf8
  // Limit this stylesheet to specific sites (`sites = [:book]`). Absent
  // or empty ⇒ every site (like `Class.sites`; unlike `Page.sites`, which
  // a multi-site document requires).
  sites: list<symbol>?
}

// Base page styling. Resets the body margin and makes it fill the
// viewport so a themed `class "wdoc-body" { … }` background reaches every
// edge (no white gutter / short-page gap). `<body class="wdoc-body">` is
// emitted by the renderer's page shell.
stylesheet "wdoc-base" {
  css = <<CSS
    .wdoc-body { margin: 0; min-height: 100vh; }
    CSS
}

// Renderable-block interfaces describe OUTPUT, not placement:
// `ContentBlock` lowers to the target-neutral page-content IR and
// `SvgBlock` lowers to the SVG IR (`TermPrimitive`, beside the terminal
// IR declaration, is the third). Page-level vs diagram-child vs terminal-
// child placement is expressed only by the accepts-type on the slot's
// `@children(...)` field.
//
// A block is rendered one of exactly two ways, and it says which:
//
//   `lower`   — a function the renderer calls to turn the block into a
//               list of fundamental variants. The interface signature
//               uses `&Interface` as the parameter; concrete types are
//               free to narrow the parameter to their own type
//               (function-typed interface fields are structurally
//               compatible). Implementations supply the function as a field
//               default so per-instance overrides are possible but never
//               required.
//   `@native` — the renderer implements the block in Rust and never calls
//               a `lower`. See the decorator below.
//
// `lower` is therefore declared OPTIONAL here: the interface does not
// demand a function a native block would only have to fake. Which of the
// two is present is checked by the build instead (`crates/wcl_wdoc/src/
// native.rs`), which refuses a block declaring both or neither — the
// stub `lower` returning `[]` is exactly what that check exists to
// prevent coming back.
interface ContentBlock {
  id:    identifier?
  lower: fn(&ContentBlock) -> list<Content>?
}

// Read-only authored content handed to a page template. `block` is the
// concrete authored value (an H1 stays an H1, a Callout stays a Callout),
// `children` exposes the same shape recursively, and `handle` is opaque
// renderer identity. Templates query and reorder these values, then place
// them with `Html::Blocks`; they never render or mutate them.
type BlockHandle {
  kind:     utf8
  block:    ContentBlock
  children: list<BlockHandle>
  handle:   u64
}

interface SvgBlock {
  id:    identifier?
  lower: fn(&SvgBlock) -> list<Svg>?
}

// This block is implemented in Rust, not by a WCL `lower`. Only wdoc's
// own renderer can supply a native implementation, so `@native` on a
// user-authored block is a build error: the kind must be one the Rust
// dispatch registry knows.
//
//   `backends` — the output targets whose Rust dispatch handles this
//                kind (`:html` / `:pdf` / `:markdown` / `:skill`).
//                Omitted ⇒ every target. The declaration is cross-checked
//                against the registry in both directions, so a target
//                claimed but not implemented — or implemented but not
//                claimed — fails the build rather than silently rendering
//                nothing.
//
// Using a block on a target its `backends` exclude is a build error too,
// waived per instance with the visibility system's backend axis
// (`@except(backends = [:pdf])`): capability says *can't*, author intent
// says *don't want to*, and the build refuses until they agree.
//
//   @block("terminal") @native         type Terminal extends ContentBlock { … }
//   @block("file") @native(backends = [:html, :markdown, :skill])
//                                      type FileObj  extends ContentBlock { … }
@decorator("native")
type NativeBlock {
  backends: list<symbol>?
}

// Default connection schema for diagrams. Any pair of SvgBlocks may
// be connected; renderers draw an arrow from source to destination
// using the resolved bounding boxes of the named shapes. User code
// may declare its own `connection ... : ... : ...` and consume it
// via `@connections(MyEdge)` for custom rendering.
//
// `@dynamic`: a diagram's `a -> b` endpoints may name ids GENERATED by
// a `wdoc_repeater` / `wdoc_component` (not just literal blocks), so an
// operand that doesn't resolve to a literal block is matched against the
// rendered shape ids rather than dropped. An endpoint that matches no
// shape is dropped with a build warning instead of a hard error.
// `:yes` / `:no` label their edge with that word — the `a -> b` statement
// grammar carries no label of its own, so a decision branch names its answer
// through the kind (the same trick a procedure's StepFlowKind uses).
symbol_set EdgeKind { default flow data yes no }
@dynamic
connection Edge: &SvgBlock -> &SvgBlock : EdgeKind

// Edge-anchor sides for connection rendering. Each renderable SVG
// shape declares zero or more sides via `connect_points`; the
// renderer maps each side to the mid-point of the corresponding
// bounding-box edge and picks the closest source/destination pair
// when drawing an arrow. Default (field omitted) = all four sides.
symbol_set AnchorSide { north east south west }

// Connection routing strategy for a diagram's edges.
//   :elbow    (default) — orthogonal multi-bend polyline that
//                         routes around other shapes via A*.
//   :straight           — single line directly between anchors.
symbol_set EdgeRouting { elbow straight }

// Auto-layout direction. Only used when `layout = :layered`.
//   :top_to_bottom (default) — ranks stack downward.
//   :left_to_right           — ranks stack rightward.
symbol_set LayoutDirection { top_to_bottom left_to_right }

// Placement of an `icon` badge inside a shape's box (see the shared
// icon fields below). Default `:left` (a leading badge beside the
// centred label).
symbol_set IconPos { center top_left top_right bottom_left bottom_right left right }

// Shared "icon badge" fields. Any box-like shape (rect / circle /
// container / process / decision / terminator below — and any custom
// `extends SvgBlock` shape that declares the same fields) may carry an
// `icon`; the renderer resolves it against the declared `iconset`s and
// draws a `<use>` of the shared sprite over the shape's bounding box.
//   icon       — icon name, optionally `set.name`
//   icon_size  — badge size in diagram units (default min(w,h) * 0.4)
//   icon_pos   — placement (default :left)
//   icon_class — classes on the icon (theming via the class system)

@block("page")
type Page {
  @doc("The page name (the inline label); becomes the output filename (`<name>.html` / `.md`).")
  @inline(0) name: identifier
  @doc("Optional explicit HTML id.")
  id: identifier?
  // Human-readable page title. Drives the browser tab title (`<title>`),
  // shown as `<page title> — <site title>` when the site sets a title.
  // Falls back to the page name when unset.
  @doc("Human-readable page title; sets the browser tab title (`<title>`). Falls back to the page name.")
  title: utf8?
  // Template to wrap this page's content in. Overrides the document's
  // `default_template` (set on the `site` block). When neither is set
  // the page renders bare (its blocks straight into <body>).
  @doc("Template to wrap the page in; overrides the site's `default_template`.")
  template: symbol?
  // Which named `site`s this page belongs to (`sites = [:docs, :blog]`).
  // Required once the document declares more than one site — the site
  // chooses the page's template, so an untagged page belonging to all of
  // them would be re-templated by a site added later without the page
  // changing. A single-site document needs no `sites` anywhere. A name
  // with no matching `site` block is a build error.
  @doc("Named sites this page belongs to; required in a multi-site document.")
  sites: list<symbol>?
  // Mark this page as the site's start page: it's served when no page is
  // specified (`/`, or `/<site>/` for a sub-site), instead of requiring a
  // page literally named `index`. At most one `start` page per site. With
  // none, a page named `index` is used, else the first page.
  @doc("Mark this page as the site's start page (served at `/`).")
  start: bool?
  // Optional YAML front matter for the Markdown target (`wcl wdoc
  // markdown`). The `frontmatter` block takes arbitrary `key = value`
  // entries, serialized to a `---`-fenced YAML header on the page's
  // `.md`. Ignored by the HTML and PDF targets. See `Frontmatter`.
  @doc("Optional YAML front matter for the Markdown target (Markdown only).")
  @child("frontmatter") frontmatter: Frontmatter?
  @doc("The page's content blocks.")
  @children(ContentBlock) children: list<ContentBlock>
}

// Page front matter for the Markdown target. The type is `@schemaless`
// (an open, dynamic kind, like `wdoc_instance`): authors write any
// `key = value` pairs they like and the Markdown backend reads them back
// (`Block::fields`) and emits a YAML header. This slot exists to register
// `frontmatter` as a legal page child — it is not a `ContentBlock`, so it
// never renders as page content and the HTML / PDF targets pass over it.
//
//   page intro {
//     frontmatter {
//       title    = "Intro"
//       tags     = ["overview", "api"]
//       audience = "llm"
//     }
//     h1 "Intro"
//   }
@block("frontmatter") @schemaless
type Frontmatter { }

// Style bundle. Referenced from any IR block's `class: list<utf8>?`
// field; each entry names a class by its inline identifier. Classes
// are document-global and emitted as `.name { ... }` rules in the
// page <style> block.
@block("class")
type Class {
  @inline(0) name: identifier

  // Limit this class's CSS to specific sites (`sites = [:book]`), so a
  // multi-site document can theme one site without affecting the others.
  // Absent or empty ⇒ every site (unlike `Page.sites`, which a multi-site
  // document requires).
  sites: list<symbol>?

  // Text styling
  color:       utf8?
  background:  utf8?
  bold:        bool?
  italic:      bool?
  underline:   bool?
  font_weight: utf8?

  // Callout accent colour — emits the `--callout-accent` custom property,
  // so a `callout` carrying this class is themed (heading / border / icon)
  // without authoring CSS. The six built-in callout types set it too.
  accent:      utf8?

  // Sizing / alignment
  font_size:      utf8?
  line_height:    utf8?
  font_family:    utf8?
  text_align:     utf8?
  text_transform: utf8?
  letter_spacing: utf8?

  // Layout
  padding:     utf8?
  margin:      utf8?
  border:      utf8?

  // SVG painting (diagram shapes + chart series carry `class`es, so
  // these theme bars / lines / slices the same way `color` themes text).
  fill:         utf8?
  stroke:       utf8?
  stroke_width: utf8?
  stroke_linejoin: utf8?
  stroke_linecap:  utf8?
  opacity:      utf8?

  // Optional per-mode overrides. `dark` is the default mode; `light`
  // applies under a system `prefers-color-scheme: light` (and either
  // wins when the reader explicitly toggles). Same fields as the class.
  @child("dark")  dark:  ClassMode?
  @child("light") light: ClassModeLight?
}

// Per-mode styling for a `class`'s `dark {}` / `light {}` block — the
// same styling fields as `Class` (minus the name).
@block("dark")
type ClassMode {
  color:          utf8?
  background:     utf8?
  bold:           bool?
  italic:         bool?
  underline:      bool?
  font_weight:    utf8?
  accent:         utf8?
  font_size:      utf8?
  line_height:    utf8?
  font_family:    utf8?
  text_align:     utf8?
  text_transform: utf8?
  letter_spacing: utf8?
  padding:      utf8?
  margin:       utf8?
  border:       utf8?
  fill:         utf8?
  stroke:       utf8?
  stroke_width: utf8?
  stroke_linejoin: utf8?
  stroke_linecap:  utf8?
  opacity:      utf8?
}

// `light {}` block — structurally identical to `dark {}`.
@block("light")
type ClassModeLight {
  color:          utf8?
  background:     utf8?
  bold:           bool?
  italic:         bool?
  underline:      bool?
  font_weight:    utf8?
  accent:         utf8?
  font_size:      utf8?
  line_height:    utf8?
  font_family:    utf8?
  text_align:     utf8?
  text_transform: utf8?
  letter_spacing: utf8?
  padding:      utf8?
  margin:       utf8?
  border:       utf8?
  fill:         utf8?
  stroke:       utf8?
  stroke_width: utf8?
  stroke_linejoin: utf8?
  stroke_linecap:  utf8?
  opacity:      utf8?
}
