// ── Stdlib math block ──────────────────────────────────────────────
//
// A display-style LaTeX equation. The equation is laid out and rendered
// to a self-contained inline SVG in Rust by the RaTeX pipeline (the
// `Math` fundamental) — not expressible in WCL — while this block owns
// the centring wrapper via the `lower`. The source goes in the inline
// label, so both a one-liner and a heredoc read naturally:
//
//   math "E = mc^2"
//
//   math <<TEX
//     \frac{-b \pm \sqrt{b^2 - 4ac}}{2a}
//     TEX
//
// The heredoc form needs no backslash escaping. For inline equations in
// prose use `$…$` (text style) or `$$…$$` (display style); see
// `inline-patterns.wcl`. Equations paint with `currentColor`, so they
// follow the surrounding text colour (theme / class / light-dark toggle).
//
// The block lowers to the semantic content IR's `Math` node. LaTeX is a
// fixed payload: Rust still does the target-specific typesetting, but every
// backend receives that payload through the same exhaustive `Content`
// match instead of through the HTML vocabulary's `Math` leaf.

namespace wdoc

@block("math")
type Math extends WdocBlock {
  @doc("The LaTeX source — the inline label slot. `math \"E=mc^2\"` or a raw heredoc `math <<'TEX' … TEX`.")
  @inline(0) source: utf8
  @doc("Optional explicit HTML id.")
  id:    identifier?
  @doc("Optional class list (e.g. to recolour or resize the equation).")
  class: list<utf8>?
  lower = fn(m: Math) -> list<Content> [
    Content::Math {
      latex: m.source,
      display: true,
      id: m.id,
      class: m.class,
    },
  ]
}

// Centring + scroll-on-overflow for block equations, and the inline
// error marker. No blanket `path { fill }` rule — the Rust renderer
// rewrites only the *default* black to `currentColor`, so an explicit
// `\textcolor{…}` keeps its colour; a CSS override would clobber it.
stylesheet "wdoc-math" {
  css = <<CSS
    .wdoc-math { display: block; text-align: center; margin: 1em 0; overflow-x: auto; overflow-y: hidden; }
    .wdoc-math svg { max-width: 100%; }
    .wdoc-math-error { font-family: monospace; color: #bf616a; }
    CSS
}
