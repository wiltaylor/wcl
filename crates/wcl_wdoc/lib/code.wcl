// ── Stdlib code block ──────────────────────────────────────────────
//
// Syntax-highlighted source listing. Lowers to a `Content::Code` — the
// semantic content IR's listing node, carrying the source, the language
// tag and the optional `filename` as fields — and each backend draws its
// own chrome from that: HTML the book code-card (a `<figure
// class="code-card">` over a header bar and the highlighted `<pre>`),
// Markdown a fenced block under the filename, PDF a caption line over
// natively-drawn coloured runs. Before, the card was built here out of
// `Raw` markup and a `Highlighted` fundamental, so the filename header
// existed only in HTML and the Markdown backend had to reach past the
// lowering and re-read the block's fields to emit a fence at all.
//
// The `language` tag picks the grammar (`rust`, `python`, `wcl`, …); an
// unknown tag falls back to plain text.

namespace wdoc

@block("code")
type Code extends ContentBlock {
  @doc("Language tag (the inline label slot). Picks the highlight grammar; an unknown tag falls back to plain text.")
  @inline(0) language: identifier
  @doc("The code text — usually a raw heredoc (`<<'TAG'`).")
  source: utf8
  @doc("Optional filename shown in the code-card header bar.")
  filename: utf8?
  @doc("Optional explicit HTML id.")
  id:     identifier?
  @doc("Optional class list (in addition to `code-block`).")
  class:  list<utf8>?
  lower = fn(c: Code) -> list<Content> [
    Content::Code {
      source: c.source,
      language: c.language,
      filename: c.filename,
      id: c.id,
      class: c.class,
    },
  ]
}

// Code-card chrome + line-number gutter. Element+descendant selectors a
// bare `class` can't express; colours come from the theme apply rules.
class "code-card" { css = "margin: 1.2rem 0; border-radius: 8px; overflow: hidden;" }
class "code-filename" { css = "display: flex; align-items: center; gap: 0.55rem; padding: 0.45rem 0.85rem; font-size: 0.78rem;" }
class "code-dots" { css = "display: inline-flex; gap: 4px;" }
class "code-dots" {
  nest "span" { css = "width: 9px; height: 9px; border-radius: 999px;" }
}
class "code-lang" { css = "margin-left: auto; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.68rem;" }
// The filename text inside the card header. Deliberately unstyled — it
// inherits the header bar — and declared so it reads as a hook.
class "code-name" {}
class "code-card" {
  nest "pre.code-block" { css = "margin: 0; border: none; border-radius: 0; padding-left: 3.3rem; counter-reset: code-line;" }
}
class "code-card" {
  nest ".code-line" { css = "display: block; position: relative; counter-increment: code-line;" }
}
class "code-card" {
  nest ".code-line::before" { css = "content: counter(code-line); position: absolute; left: -2.7rem; width: 2.2rem; text-align: right; color: #999; opacity: 0.75; user-select: none;" }
}

