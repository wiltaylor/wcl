// ── Stdlib code block ──────────────────────────────────────────────
//
// Syntax-highlighted source listing. Lowers to `<pre class="code-block …">
// <code class="language-X">…</code></pre>`; the per-token colouring is
// produced in Rust by syntect (the `Highlighted` fundamental) since it
// isn't expressible in WCL, but the `<pre>`/`<code>` structure + classes
// are authored here. The `language` tag picks the grammar (`rust`,
// `python`, `wcl`, …); an unknown tag falls back to plain-text rendering.

namespace wdoc

@block("code")
type Code extends WdocBlock {
  @doc("Language tag (the inline label slot). Picks the highlight grammar; an unknown tag falls back to plain text.")
  @inline(0) language: identifier
  @doc("The code text — usually a raw heredoc (`<<'TAG'`).")
  source: utf8
  @doc("Optional explicit HTML id.")
  id:     identifier?
  @doc("Optional class list (in addition to `code-block`).")
  class:  list<utf8>?
  lower = fn(c: Code) -> list<HtmlFundamental> [
    HtmlFundamental::Element {
      tag: "pre", id: c.id,
      class: flatten([["code-block"], if c.class == none { [] } else { c.class }]),
      attrs: none,
      children: [
        HtmlFundamental::Element {
          tag: "code", id: none,
          class: [format("language-{}", c.language)], attrs: none,
          children: [
            HtmlFundamental::Highlighted {
              source: c.source, language: format("{}", c.language),
            },
          ],
        },
      ],
    },
  ]
}

