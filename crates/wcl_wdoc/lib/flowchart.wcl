// ── Stdlib flowchart shapes ────────────────────────────────────────
//
// Each custom shape supplies its lowering via `@default` on the
// `lower` field. The renderer calls `block.field("lower")` (or the
// schema default if the instance didn't override) and recursively
// renders the variants it returns. Per-instance overrides work
// transparently — set `lower = fn(...) -> ...` on a particular block
// and that supersedes the default for just that instance.

// Every flowchart shape centres the same `Label` over its body — only
// the fit region varies (a diamond's text box is narrower, a node's is
// inset). Share the construction so the shapes differ only in geometry.
// `cls` is the shape's optional `class` list (declared non-optional per
// the WCL param-annotation rule; a `none` value flows through unchanged).
let centered_label = fn(text: utf8, cx: f64, cy: f64, fit_w: f64, fit_h: f64, cls: list<utf8>) -> SvgFundamental
  SvgFundamental::Label {
    content: text, x: cx, y: cy, font_size: none,
    fit_width: fit_w, fit_height: fit_h, fill: none, id: none, class: cls,
  }

// An oval (ellipse) outline as polygon points — there is no Ellipse
// fundamental, so a `terminator` is approximated with a 40-point fan
// around its bounding box (the same trick the pie chart uses for arcs).
let oval_points = fn(cx: f64, cy: f64, rx: f64, ry: f64) -> utf8
  join(map(range(0, 40), fn(i: i64) -> utf8 {
    let th = tau() * i / 40;
    format("{},{}", cx + rx * cos(th), cy + ry * sin(th))
  }), " ")

@block("process")
type Process extends SvgBlock {
  @doc("The shape's label (centred plain text).")
  @inline(0) text: utf8
  // Defaults let `:layered` layout position these shapes via a
  // wrapper transform: the child renders at (0,0) of its assigned
  // cell rather than failing the lowering when x/y are omitted.
  @doc("Top-left x placement. Omit under `layout = :layered` — the layout decides.")
  x = 0.0
  @doc("Top-left y placement. Omit under `layout = :layered` — the layout decides.")
  y = 0.0
  @doc("Box width.")
  width = 80.0
  @doc("Box height.")
  height = 40.0
  @doc("Fill colour (defaults to a theme class if unset).")
  fill: utf8?
  @doc("Outline colour.")
  stroke: utf8?
  @doc("Name used to connect the shape (`a -> b`).")
  id: identifier?
  @doc("Style classes — SVG paint via the `class` system.")
  class: list<utf8>?
  @doc("Which sides (`:left`/`:right`/`:top`/`:bottom`) edges attach to.")
  connect_points: list<AnchorSide>?
  @doc("Icon-badge icon (a `pack.name`).")
  icon: utf8?
  @doc("Icon-badge size.")
  icon_size: f64?
  @doc("Icon-badge position (`:center` / `:top_left` / …).")
  icon_pos: IconPos?
  @doc("Icon-badge style classes.")
  icon_class: list<utf8>?

  // An unstyled shape (no fill / stroke / class) gets a default theme class
  // so it isn't bare-SVG black; the box and its label carry separate classes
  // so the label stays legible against the themed fill. Any author styling
  // wins (and a CSS class would otherwise override a `fill="…"` attribute).
  lower = fn(p: Process) -> list<SvgFundamental> {
    let auto = p.fill == none && p.stroke == none && p.class == none;
    let box_class = if auto { ["wdoc-process"] } else { p.class };
    let text_class = if auto { ["wdoc-shape-text"] } else { p.class };
    [
      SvgFundamental::Rect {
        x: p.x, y: p.y, width: p.width, height: p.height,
        fill: p.fill, stroke: p.stroke, id: p.id, class: box_class,
      },
      centered_label(
        p.text, p.x + p.width / 2.0, p.y + p.height / 2.0,
        p.width, p.height, text_class,
      ),
    ]
  }
}

@block("decision")
type Decision extends SvgBlock {
  @doc("The shape's label (centred plain text).")
  @inline(0) text: utf8
  @doc("Top-left x placement. Omit under `layout = :layered` — the layout decides.")
  x = 0.0
  @doc("Top-left y placement. Omit under `layout = :layered` — the layout decides.")
  y = 0.0
  @doc("Box width.")
  width = 80.0
  @doc("Box height.")
  height = 40.0
  @doc("Fill colour (defaults to a theme class if unset).")
  fill: utf8?
  @doc("Outline colour.")
  stroke: utf8?
  @doc("Name used to connect the shape (`a -> b`).")
  id: identifier?
  @doc("Style classes — SVG paint via the `class` system.")
  class: list<utf8>?
  @doc("Which sides (`:left`/`:right`/`:top`/`:bottom`) edges attach to.")
  connect_points: list<AnchorSide>?
  @doc("Icon-badge icon (a `pack.name`).")
  icon: utf8?
  @doc("Icon-badge size.")
  icon_size: f64?
  @doc("Icon-badge position (`:center` / `:top_left` / …).")
  icon_pos: IconPos?
  @doc("Icon-badge style classes.")
  icon_class: list<utf8>?

  lower = fn(d: Decision) -> list<SvgFundamental> {
    let auto = d.fill == none && d.stroke == none && d.class == none;
    let box_class = if auto { ["wdoc-decision"] } else { d.class };
    let text_class = if auto { ["wdoc-shape-text"] } else { d.class };
    [
      SvgFundamental::Polygon {
        points: format(
          "{},{} {},{} {},{} {},{}",
          d.x + d.width / 2.0, d.y,
          d.x + d.width,       d.y + d.height / 2.0,
          d.x + d.width / 2.0, d.y + d.height,
          d.x,                 d.y + d.height / 2.0,
        ),
        fill: d.fill, stroke: d.stroke, id: d.id, class: box_class,
      },
      // Diamond's text region is smaller than its bbox — the inscribed
      // rect at the middle is roughly half the width and full height;
      // halve fit_width so long labels shrink before they hit the
      // diamond's sloped edges.
      centered_label(
        d.text, d.x + d.width / 2.0, d.y + d.height / 2.0,
        d.width / 2.0, d.height, text_class,
      ),
    ]
  }
}

// Circular graph node: a labelled circle for network / relationship /
// force-directed diagrams. Sized by its box (width/height) so layout
// solvers allocate a square cell; the circle is inscribed in that box
// and the label is centred inside it. Mirrors `process` but lowers to
// a Circle instead of a Rect.
@block("node")
type GraphNode extends SvgBlock {
  @doc("The node's label (centred plain text).")
  @inline(0) text: utf8
  @doc("Top-left x placement. Omit under an auto-layout — the layout decides.")
  x = 0.0
  @doc("Top-left y placement. Omit under an auto-layout — the layout decides.")
  y = 0.0
  @doc("Box width (the circle is inscribed in this box).")
  width = 56.0
  @doc("Box height (the circle is inscribed in this box).")
  height = 56.0
  @doc("Fill colour (defaults to a theme class if unset).")
  fill: utf8?
  @doc("Outline colour.")
  stroke: utf8?
  @doc("Name used to connect the node (`a -> b`).")
  id: identifier?
  @doc("Style classes — SVG paint via the `class` system.")
  class: list<utf8>?
  @doc("Which sides (`:left`/`:right`/`:top`/`:bottom`) edges attach to.")
  connect_points: list<AnchorSide>?
  @doc("Icon-badge icon (a `pack.name`).")
  icon: utf8?
  @doc("Icon-badge size.")
  icon_size: f64?
  @doc("Icon-badge position (`:center` / `:top_left` / …).")
  icon_pos: IconPos?
  @doc("Icon-badge style classes.")
  icon_class: list<utf8>?

  lower = fn(n: GraphNode) -> list<SvgFundamental> {
    let auto = n.fill == none && n.stroke == none && n.class == none;
    let box_class = if auto { ["wdoc-node"] } else { n.class };
    let text_class = if auto { ["wdoc-shape-text"] } else { n.class };
    [
      SvgFundamental::Circle {
        cx: n.x + n.width / 2.0,
        cy: n.y + n.height / 2.0,
        r:  min(n.width, n.height) / 2.0,
        fill: n.fill, stroke: n.stroke, id: n.id, class: box_class,
      },
      // Inset the fit region so the label stays within the circle's
      // curve instead of touching its left/right edges.
      centered_label(
        n.text, n.x + n.width / 2.0, n.y + n.height / 2.0,
        n.width * 0.82, n.height * 0.82, text_class,
      ),
    ]
  }
}

// Terminator: an oval (the start/end node), drawn as an ellipse
// inscribed in the shape's box via `oval_points`.
@block("terminator")
type Terminator extends SvgBlock {
  @doc("The shape's label (centred plain text).")
  @inline(0) text: utf8
  @doc("Top-left x placement. Omit under `layout = :layered` — the layout decides.")
  x = 0.0
  @doc("Top-left y placement. Omit under `layout = :layered` — the layout decides.")
  y = 0.0
  @doc("Box width.")
  width = 80.0
  @doc("Box height.")
  height = 40.0
  @doc("Fill colour (defaults to a theme class if unset).")
  fill: utf8?
  @doc("Outline colour.")
  stroke: utf8?
  @doc("Name used to connect the shape (`a -> b`).")
  id: identifier?
  @doc("Style classes — SVG paint via the `class` system.")
  class: list<utf8>?
  @doc("Which sides (`:left`/`:right`/`:top`/`:bottom`) edges attach to.")
  connect_points: list<AnchorSide>?
  @doc("Icon-badge icon (a `pack.name`).")
  icon: utf8?
  @doc("Icon-badge size.")
  icon_size: f64?
  @doc("Icon-badge position (`:center` / `:top_left` / …).")
  icon_pos: IconPos?
  @doc("Icon-badge style classes.")
  icon_class: list<utf8>?

  lower = fn(t: Terminator) -> list<SvgFundamental> {
    let auto = t.fill == none && t.stroke == none && t.class == none;
    let box_class = if auto { ["wdoc-terminator"] } else { t.class };
    let text_class = if auto { ["wdoc-shape-text"] } else { t.class };
    [
      SvgFundamental::Polygon {
        points: oval_points(
          t.x + t.width / 2.0, t.y + t.height / 2.0,
          t.width / 2.0, t.height / 2.0,
        ),
        fill: t.fill, stroke: t.stroke, id: t.id, class: box_class,
      },
      // Inset the text region so the label stays inside the oval's curve.
      centered_label(
        t.text, t.x + t.width / 2.0, t.y + t.height / 2.0,
        t.width * 0.8, t.height * 0.72, text_class,
      ),
    ]
  }
}

