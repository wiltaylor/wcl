// Wireframe UI widgets — windows, buttons, inputs, and controls for
// mocking up interfaces. Each widget is a **diagram shape**: `Widget
// extends SvgBlock`, so a `wf_*` block is a legal child of any `diagram`
// / `container`, positioned with `x`/`y` (or anchors) and connectable by
// edges via `connect_points` — exactly like `rect` / `circle` / `card`.
//
// The whole family is special-cased in Rust (`src/wireframe.rs`, like
// `card` / `map`): one renderer measures the widget tree bottom-up and
// emits a single positioned SVG `<g>`, dispatched from `render_shape`.
// The Rust renderer walks the raw blocks directly, so the `lower`
// functions below are inert stubs (they satisfy the `SvgBlock` interface
// but are never called) and the container `@children(Widget)`
// declarations exist purely for schema validation. A widget's size comes
// from its measured content; `x`/`y`/anchors only position it.
//
// Theming follows the terminal pattern (read in Rust): default text and
// icons paint with the resolved UI-theme palette baked to concrete hex,
// and a widget's `class` list is read for `background` / `color` /
// `border` overrides baked onto its box — so a custom class (e.g. the
// example's `primary`) still recolours.

// A wireframe widget. Extends SvgBlock so a widget is a legal diagram /
// container child AND a legal child of any container widget. The extra
// fields are the diagram placement geometry shared by every widget plus
// the per-element theming hints.
namespace wdoc

interface Widget extends SvgBlock {
  @doc("Optional HTML id (also the edge-connection / anchor name).")
  id:       identifier?
  @doc("Extra CSS classes threaded onto the rendered element (and read for `background` / `color` / `border` overrides).")
  class:    list<utf8>?
  @doc("When `true`, dims the control (renders at reduced opacity).")
  disabled: bool?
  // Diagram placement — the widget is sized by its measured content, so
  // `x`/`y` (or anchors) only position the box; `width`/`height` are
  // advisory.
  @doc("Top-left x placement in the diagram (or use anchors).")
  x = 0.0
  @doc("Top-left y placement in the diagram (or use anchors).")
  y = 0.0
  @doc("Advisory box width (the widget is normally content-measured).")
  width:  f64?
  @doc("Advisory box height (the widget is normally content-measured).")
  height: f64?
  @doc("Fractional anchor (0–1) pinning the left edge to the parent box.")
  anchor_left:   f64?
  @doc("Fractional anchor (0–1) pinning the right edge to the parent box.")
  anchor_right:  f64?
  @doc("Fractional anchor (0–1) pinning the top edge to the parent box.")
  anchor_top:    f64?
  @doc("Fractional anchor (0–1) pinning the bottom edge to the parent box.")
  anchor_bottom: f64?
  @doc("Which sides (`:left`/`:right`/`:top`/`:bottom`) edges attach to.")
  connect_points: list<AnchorSide>?
  // Per-element UI-theme override (read on the root widget): `theme` names a
  // `theme` block, `accent` a hue, `mode` is `:dark` / `:light`. Each unset
  // field falls back to the site's `ui_*` theme (then the document theme).
  @doc("Per-element UI-theme override naming a `theme` block (falls back to the site's `ui_*` theme, then the document theme).")
  theme:    symbol?
  @doc("Per-element accent hue override (falls back to the site / document theme).")
  accent:   symbol?
  @doc("Per-element mode override: `:dark` or `:light` (falls back to the site / document theme).")
  mode:     symbol?
  lower:    fn(&Widget) -> list<SvgFundamental>
}

// Shared geometry + theming fields, repeated per type (the schema lists a
// type's own fields). Every `wf_*` type carries this block verbatim:
//   id: identifier?  class: list<utf8>?  disabled: bool?
//   x = 0.0  y = 0.0  width: f64?  height: f64?
//   anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
//   connect_points: list<AnchorSide>?
//   theme: symbol?  accent: symbol?  mode: symbol?

// ── Leaf widgets ──────────────────────────────────────────────────────

@block("wf_label")
type WfLabel extends Widget {
  @doc("The label text (the inline label).")
  @inline(0) text: utf8
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
  lower = fn(l: WfLabel) -> list<SvgFundamental> []
}

@block("wf_button")
type WfButton extends Widget {
  @doc("Button caption (the inline label).")
  @inline(0) text: utf8
  @doc("Optional leading glyph as `pack.name`, e.g. `\"lucide.check\"`.")
  icon: utf8?                  // optional leading glyph, e.g. "lucide.check"
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
  lower = fn(b: WfButton) -> list<SvgFundamental> []
}

@block("wf_input")
type WfInput extends Widget {
  @doc("Greyed prompt shown when empty (the inline label).")
  @inline(0) placeholder: utf8   // greyed placeholder text
  @doc("Filled value (renders solid, replacing the placeholder).")
  value: utf8?                   // filled value (renders solid, no placeholder)
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
  lower = fn(i: WfInput) -> list<SvgFundamental> []
}

@block("wf_dropdown")
type WfDropdown extends Widget {
  @doc("The selected option label (the inline label).")
  @inline(0) text: utf8          // currently-selected option label
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
  lower = fn(d: WfDropdown) -> list<SvgFundamental> []
}

@block("wf_checkbox")
type WfCheckbox extends Widget {
  @doc("Checkbox caption (the inline label).")
  @inline(0) label: utf8
  @doc("On/off state; `true` fills the box with a tick.")
  checked: bool?
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
  lower = fn(c: WfCheckbox) -> list<SvgFundamental> []
}

@block("wf_radio")
type WfRadio extends Widget {
  @doc("Radio caption (the inline label).")
  @inline(0) label: utf8
  @doc("Whether this option is chosen.")
  selected: bool?
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
  lower = fn(r: WfRadio) -> list<SvgFundamental> []
}

@block("wf_toggle")
type WfToggle extends Widget {
  @doc("Optional trailing caption (the inline label).")
  @inline(0) label: utf8?        // optional trailing caption
  @doc("Switch state; `true` slides the knob across.")
  on: bool?
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
  lower = fn(t: WfToggle) -> list<SvgFundamental> []
}

// ── Container widgets ─────────────────────────────────────────────────
// Each declares `@children(Widget)`; the Rust renderer measures and lays
// the children out internally (their `x`/`y` are ignored — only the root
// widget's placement geometry positions the whole group in the diagram).

@block("wf_window")
type WfWindow extends Widget {
  @doc("Titlebar caption (the inline label).")
  @inline(0) title: utf8
  @doc("Show the titlebar dots + close glyph (default `true`).")
  controls: bool?                // titlebar dots + close glyph (default true)
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
  @doc("Any `Widget`s, stacked vertically.")
  @children(Widget) children: list<Widget>
  lower = fn(w: WfWindow) -> list<SvgFundamental> []
}

@block("wf_panel")
type WfPanel extends Widget {
  @doc("Optional group caption.")
  title: utf8?                   // optional group caption
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
  @doc("Any `Widget`s, stacked vertically.")
  @children(Widget) children: list<Widget>
  lower = fn(p: WfPanel) -> list<SvgFundamental> []
}

// Layout containers: thin wrappers that arrange their children. Drop one
// inside a window/panel to change how controls flow.

@block("wf_column")
type WfColumn extends Widget {
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
  @doc("Any `Widget`s, stacked top-to-bottom.")
  @children(Widget) children: list<Widget>
  lower = fn(c: WfColumn) -> list<SvgFundamental> []
}

@block("wf_row")
type WfRow extends Widget {
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
  @doc("Any `Widget`s, laid out left-to-right.")
  @children(Widget) children: list<Widget>
  lower = fn(r: WfRow) -> list<SvgFundamental> []
}

@block("wf_grid")
type WfGrid extends Widget {
  @doc("Number of equal-width columns; children flow across the rows.")
  columns: i64                   // number of equal-width columns
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
  @doc("Any `Widget`s, flowed across the grid.")
  @children(Widget) children: list<Widget>
  lower = fn(g: WfGrid) -> list<SvgFundamental> []
}
