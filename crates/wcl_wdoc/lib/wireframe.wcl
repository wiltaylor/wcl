// Wireframe UI widgets — windows, device frames (browser / phone /
// tablet), buttons, inputs, and controls for mocking up interfaces. Each
// widget is a **diagram shape**: `Widget
// extends SvgBlock`, so a `wf_*` block is a legal child of any `diagram`
// / `container`, positioned with `x`/`y` (or anchors) and connectable by
// edges via `connect_points` — exactly like `rect` / `circle` / `card`.
//
// The whole family is special-cased in Rust (`src/wireframe.rs`, like
// `card` / `map`): one renderer measures the widget tree bottom-up and
// emits a single positioned SVG `<g>`, dispatched from `render_shape`.
// The Rust renderer walks the raw blocks directly, so every widget below
// is `@native` and the container `@children(Widget)`
// declarations exist purely for schema validation. A widget's size comes
// from its measured content; `x`/`y`/anchors only position it.
//
// Theming follows the terminal pattern (read in Rust): default text and
// icons paint with the resolved UI-theme palette baked to concrete hex,
// and a widget's `class` list is read for SVG `fill` / `stroke`
// overrides baked onto its box — so a custom class (e.g. the
// example's `primary`) still recolours.

// A wireframe widget. Extends SvgBlock so a widget is a legal diagram /
// container child AND a legal child of any container widget. The extra
// fields are the diagram placement geometry shared by every widget plus
// the per-element theming hints.
namespace wdoc

interface Widget extends SvgBlock {
  @doc("Optional HTML id (also the edge-connection / anchor name).")
  id:       identifier?
  @doc("Extra CSS classes read for SVG `fill` / `stroke` box overrides.")
  class:    list<utf8>?
  @doc("When `true`, dims the control (renders at reduced opacity).")
  disabled: bool?
  // Diagram placement — the widget is sized by its measured content, so
  // `x`/`y` (or anchors) only position the box; `width`/`height` are
  // advisory.
  @doc("Top-left x placement in the diagram (or use anchors).")
  x = 0.0
  @doc("Top-left y placement in the diagram (or use anchors).")
  y = 0.0
  @doc("Advisory box width (the widget is normally content-measured).")
  width:  f64?
  @doc("Advisory box height (the widget is normally content-measured).")
  height: f64?
  @doc("Anchor inset in canvas units pinning the left edge to the parent box.")
  anchor_left:   f64?
  @doc("Anchor inset in canvas units pinning the right edge to the parent box.")
  anchor_right:  f64?
  @doc("Anchor inset in canvas units pinning the top edge to the parent box.")
  anchor_top:    f64?
  @doc("Anchor inset in canvas units pinning the bottom edge to the parent box.")
  anchor_bottom: f64?
  @doc("Which sides (`:left`/`:right`/`:top`/`:bottom`) edges attach to.")
  connect_points: list<AnchorSide>?
  // Per-element UI-theme override (read on the root widget): `theme` names a
  // `theme` block, `accent` a hue, `mode` is `:dark` / `:light`. Each unset
  // field falls back to the site's `ui_*` theme (then the document theme).
  @doc("Per-element UI-theme override naming a `theme` block (falls back to the site's `ui_*` theme, then the document theme).")
  theme:    symbol?
  @doc("Per-element accent hue override (falls back to the site / document theme).")
  accent:   symbol?
  @doc("Per-element mode override: `:dark` or `:light` (falls back to the site / document theme).")
  mode:     symbol?
}

// Shared geometry + theming fields, repeated per type (the schema lists a
// type's own fields). Every `wf_*` type carries this block verbatim:
//   id: identifier?  class: list<utf8>?  disabled: bool?
//   x = 0.0  y = 0.0  width: f64?  height: f64?
//   anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
//   connect_points: list<AnchorSide>?
//   theme: symbol?  accent: symbol?  mode: symbol?

// ── Leaf widgets ──────────────────────────────────────────────────────

@block("wf_label")
@native
type WfLabel extends Widget {
  @doc("The label text (the inline label).")
  @inline(0) text: utf8
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
}

@block("wf_button")
@native
type WfButton extends Widget {
  @doc("Button caption (the inline label).")
  @inline(0) text: utf8
  @doc("Optional leading glyph as `pack.name`, e.g. `\"lucide.check\"`.")
  icon: utf8?                  // optional leading glyph, e.g. "lucide.check"
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
}

@block("wf_input")
@native
type WfInput extends Widget {
  @doc("Greyed prompt shown when empty (the inline label).")
  @inline(0) placeholder: utf8   // greyed placeholder text
  @doc("Filled value (renders solid, replacing the placeholder).")
  value: utf8?                   // filled value (renders solid, no placeholder)
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
}

@block("wf_dropdown")
@native
type WfDropdown extends Widget {
  @doc("The selected option label (the inline label).")
  @inline(0) text: utf8          // currently-selected option label
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
}

@block("wf_checkbox")
@native
type WfCheckbox extends Widget {
  @doc("Checkbox caption (the inline label).")
  @inline(0) label: utf8
  @doc("On/off state; `true` fills the box with a tick.")
  checked: bool?
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
}

@block("wf_radio")
@native
type WfRadio extends Widget {
  @doc("Radio caption (the inline label).")
  @inline(0) label: utf8
  @doc("Whether this option is chosen.")
  selected: bool?
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
}

@block("wf_toggle")
@native
type WfToggle extends Widget {
  @doc("Optional trailing caption (the inline label).")
  @inline(0) label: utf8?        // optional trailing caption
  @doc("Switch state; `true` slides the knob across.")
  on: bool?
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
}

// ── Container widgets ─────────────────────────────────────────────────
// Each declares `@children(Widget)`; the Rust renderer measures and lays
// the children out internally (their `x`/`y` are ignored — only the root
// widget's placement geometry positions the whole group in the diagram).

@block("wf_window")
@native
type WfWindow extends Widget {
  @doc("Titlebar caption (the inline label).")
  @inline(0) title: utf8
  @doc("Show the titlebar dots + close glyph (default `true`).")
  controls: bool?                // titlebar dots + close glyph (default true)
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
  @doc("Any `Widget`s, stacked vertically.")
  @children(Widget) children: list<Widget>
}

// Device frames: a web browser and phone / tablet shells. Unlike every
// other widget, these have a realistic *fixed* default frame size so their
// content sizes inside them properly — and uniquely, an explicit
// `width` / `height` pins that axis (the unset axis keeps the device
// default, and height still grows if the content would overflow).

@block("wf_browser")
@native
type WfBrowser extends Widget {
  @doc("Address-bar URL (the inline label).")
  @inline(0) url: utf8
  id: identifier?  class: list<utf8>?  disabled: bool?
  // `width` / `height` pin the browser frame size (default 640 × 440).
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
  @doc("Any `Widget`s, stacked vertically in the content area.")
  @children(Widget) children: list<Widget>
}

@block("wf_phone")
@native
type WfPhone extends Widget {
  @doc("Optional status-bar caption (the inline label).")
  @inline(0) title: utf8?
  @doc("Frame orientation: `:portrait` (default) or `:landscape`.")
  orientation: symbol?
  id: identifier?  class: list<utf8>?  disabled: bool?
  // `width` / `height` pin the phone frame size (default 280 × 580 portrait).
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
  @doc("Any `Widget`s, stacked vertically on the screen.")
  @children(Widget) children: list<Widget>
}

@block("wf_tablet")
@native
type WfTablet extends Widget {
  @doc("Optional status-bar caption (the inline label).")
  @inline(0) title: utf8?
  @doc("Frame orientation: `:portrait` (default) or `:landscape`.")
  orientation: symbol?
  id: identifier?  class: list<utf8>?  disabled: bool?
  // `width` / `height` pin the tablet frame size (default 480 × 640 portrait).
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
  @doc("Any `Widget`s, stacked vertically on the screen.")
  @children(Widget) children: list<Widget>
}

@block("wf_panel")
@native
type WfPanel extends Widget {
  @doc("Optional group caption.")
  title: utf8?                   // optional group caption
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
  @doc("Any `Widget`s, stacked vertically.")
  @children(Widget) children: list<Widget>
}

// Layout containers: thin wrappers that arrange their children. Drop one
// inside a window/panel to change how controls flow.

@block("wf_column")
@native
type WfColumn extends Widget {
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
  @doc("Any `Widget`s, stacked top-to-bottom.")
  @children(Widget) children: list<Widget>
}

@block("wf_row")
@native
type WfRow extends Widget {
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
  @doc("Any `Widget`s, laid out left-to-right.")
  @children(Widget) children: list<Widget>
}

@block("wf_grid")
@native
type WfGrid extends Widget {
  @doc("Number of equal-width columns (default 2); children flow across the rows.")
  columns = 2                    // number of equal-width columns
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
  @doc("Any `Widget`s, flowed across the grid.")
  @children(Widget) children: list<Widget>
}

// ── Node graph ────────────────────────────────────────────────────────
// A `wf_node_graph` mocks up a node editor (shader / blueprint / dataflow
// graph): boxes with labeled input/output ports, wired together by links.
// It is one wireframe widget (a diagram shape), rendered self-contained in
// Rust (src/wireframe.rs). Nodes auto-lay-out left-to-right from the link
// graph (reusing the layered solver); a node with an explicit `x`/`y` pins
// itself. Links route between ports with the shared orthogonal edge router.
// `wf_node` / `wf_link` are internal children (not standalone shapes), so —
// like an `li` under a `list` — they extend no block interface at all: they
// declare neither a `lower` nor `@native`, and the graph renderer reads them
// directly. (A `node_row` looks similar but *is* an `SvgBlock`, so it has to
// say which of the two it is, and says `@native`.)

@block("wf_node")
type WfNode {
  @doc("Node caption (the inline label).")
  @inline(0) title: utf8
  @doc("Node id — the link-endpoint name (`from = \"tex.RGB\"`).")
  id: identifier?
  @doc("Input port labels, listed down the left edge.")
  inputs: list<utf8>?
  @doc("Output port labels, listed down the right edge.")
  outputs: list<utf8>?
  @doc("Optional explicit x placement (pins the node; otherwise auto-laid-out).")
  x: f64?
  @doc("Optional explicit y placement (pins the node; otherwise auto-laid-out).")
  y: f64?
  @doc("Extra CSS classes read for SVG `fill` / `stroke` box overrides.")
  class: list<utf8>?
}

@block("wf_link")
type WfLink {
  @doc("Source endpoint: `\"node\"` or `\"node.port\"` (an output port).")
  @inline(0) from: utf8
  @doc("Destination endpoint: `\"node\"` or `\"node.port\"` (an input port).")
  to: utf8
  @doc("Optional caption drawn at the link's midpoint.")
  label: utf8?
}

@block("wf_node_graph")
@native
type WfNodeGraph extends Widget {
  @doc("Layout flow: `:left_to_right` (default) or `:top_to_bottom`.")
  direction: symbol?
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width: f64?  height: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
  @doc("The graph nodes (boxes with ports).")
  @children("wf_node") nodes: list<WfNode>
  @doc("The links wiring node ports together.")
  @children("wf_link") links: list<WfLink>
}
