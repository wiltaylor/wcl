// Wireframe UI widgets — windows, buttons, inputs, and controls for
// mocking up interfaces. Unlike diagram shapes (which lower to flat
// `SvgFundamental` leaves and can't nest), widgets render through the
// HTML path: each lowers to `HtmlFundamental::Element` trees, and the
// container widgets nest other widgets via the `Children` slot (the
// renderer splices their child blocks where the slot appears).
//
// Theming rides the `class` system: every widget paints from bare
// single-class selectors (`.wf-button`, …) seeded by the bundled
// `stylesheet "wdoc-wireframe"`, and every widget threads its `class`
// field onto the root element — so a user `class "wf-button" { … }`
// (or a custom class on an instance) overrides the look, dark/light
// included. The clean grey-box palette is a set of `--wf-*` custom
// properties (dark default + light override + theme-toggle override).

// A wireframe widget. Extends WdocBlock so a widget is a legal `page`
// child AND a legal child of any container widget. The extra fields are
// layout hints shared by every widget.
interface Widget extends WdocBlock {
  id:       identifier?
  class:    list<utf8>?
  width:    utf8?           // explicit CSS width, e.g. "12rem" / "100%"
  disabled: bool?
  lower:    fn(&Widget) -> list<HtmlFundamental>
}

// Root class list for a widget: its base class, the author's classes,
// and a `wf-disabled` marker when disabled. (`cls` / `disabled` are
// optional fields at the call sites; WCL function params can't carry a
// `?`, so the `== none` / `== true` guards handle an absent value.)
let wf_cls = fn(base: utf8, cls: list<utf8>, disabled: bool) -> list<utf8> {
  let user = if cls == none { [] } else { cls };
  let dis  = if disabled == true { ["wf-disabled"] } else { [] };
  flatten([[base], user, dis])
}

// Build the optional inline `style` attr from extra css + an optional
// width. An empty result emits no attr at all.
let wf_style_attr = fn(extra: utf8, width: utf8) -> list<list<utf8>> {
  let w = if width == none { "" } else { format("width:{};", width) };
  let s = format("{}{}", extra, w);
  if s == "" { [] } else { [["style", s]] }
}

// ── Leaf widgets ──────────────────────────────────────────────────────

@block("wf_label")
type WfLabel extends Widget {
  @inline(0) text: utf8
  id: identifier?  class: list<utf8>?  width: utf8?  disabled: bool?
  lower = fn(l: WfLabel) -> list<HtmlFundamental> [
    HtmlFundamental::Element {
      tag: "span", id: l.id, class: wf_cls("wf-label", l.class, l.disabled),
      attrs: wf_style_attr("", l.width),
      children: [ HtmlFundamental::Inline { text: l.text } ],
    },
  ]
}

@block("wf_button")
type WfButton extends Widget {
  @inline(0) text: utf8
  icon: utf8?                  // optional leading glyph, e.g. "lucide.check"
  id: identifier?  class: list<utf8>?  width: utf8?  disabled: bool?
  lower = fn(b: WfButton) -> list<HtmlFundamental> {
    let label = HtmlFundamental::Inline { text: b.text };
    let kids = if b.icon == none { [label] }
      else { [ HtmlFundamental::Icon { name: b.icon, class: ["wf-icon"] }, label ] };
    [ HtmlFundamental::Element {
        tag: "div", id: b.id, class: wf_cls("wf-button", b.class, b.disabled),
        attrs: wf_style_attr("", b.width), children: kids } ]
  }
}

@block("wf_input")
type WfInput extends Widget {
  @inline(0) placeholder: utf8   // greyed placeholder text
  value: utf8?                   // filled value (renders solid, no placeholder)
  id: identifier?  class: list<utf8>?  width: utf8?  disabled: bool?
  lower = fn(i: WfInput) -> list<HtmlFundamental> {
    let shown  = if i.value == none { i.placeholder } else { i.value };
    let txtcls = if i.value == none { ["wf-input-text", "wf-placeholder"] }
                 else { ["wf-input-text"] };
    [ HtmlFundamental::Element {
        tag: "div", id: i.id, class: wf_cls("wf-input", i.class, i.disabled),
        attrs: wf_style_attr("", i.width),
        children: [ HtmlFundamental::Element {
          tag: "span", id: none, class: txtcls, attrs: none,
          children: [ HtmlFundamental::Inline { text: shown } ],
        } ] } ]
  }
}

@block("wf_dropdown")
type WfDropdown extends Widget {
  @inline(0) text: utf8          // currently-selected option label
  id: identifier?  class: list<utf8>?  width: utf8?  disabled: bool?
  lower = fn(d: WfDropdown) -> list<HtmlFundamental> [
    HtmlFundamental::Element {
      tag: "div", id: d.id, class: wf_cls("wf-dropdown", d.class, d.disabled),
      attrs: wf_style_attr("", d.width),
      children: [
        HtmlFundamental::Element {
          tag: "span", id: none, class: ["wf-dropdown-text"], attrs: none,
          children: [ HtmlFundamental::Inline { text: d.text } ],
        },
        HtmlFundamental::Icon { name: "lucide.chevron-down", class: ["wf-dropdown-chevron"] },
      ],
    },
  ]
}

@block("wf_checkbox")
type WfCheckbox extends Widget {
  @inline(0) label: utf8
  checked: bool?
  id: identifier?  class: list<utf8>?  width: utf8?  disabled: bool?
  lower = fn(c: WfCheckbox) -> list<HtmlFundamental> {
    let on = c.checked == true;
    let boxcls  = if on { ["wf-box", "wf-checked"] } else { ["wf-box"] };
    let boxkids = if on { [ HtmlFundamental::Icon { name: "lucide.check", class: ["wf-tick"] } ] }
                  else { [] };
    [ HtmlFundamental::Element {
        tag: "div", id: c.id, class: wf_cls("wf-checkbox", c.class, c.disabled),
        attrs: wf_style_attr("", c.width),
        children: [
          HtmlFundamental::Element { tag: "span", id: none, class: boxcls, attrs: none, children: boxkids },
          HtmlFundamental::Element { tag: "span", id: none, class: ["wf-control-label"], attrs: none,
            children: [ HtmlFundamental::Inline { text: c.label } ] },
        ] } ]
  }
}

@block("wf_radio")
type WfRadio extends Widget {
  @inline(0) label: utf8
  selected: bool?
  id: identifier?  class: list<utf8>?  width: utf8?  disabled: bool?
  lower = fn(r: WfRadio) -> list<HtmlFundamental> {
    let on = r.selected == true;
    let dotcls = if on { ["wf-dot", "wf-checked"] } else { ["wf-dot"] };
    [ HtmlFundamental::Element {
        tag: "div", id: r.id, class: wf_cls("wf-radio", r.class, r.disabled),
        attrs: wf_style_attr("", r.width),
        children: [
          HtmlFundamental::Element { tag: "span", id: none, class: dotcls, attrs: none, children: [] },
          HtmlFundamental::Element { tag: "span", id: none, class: ["wf-control-label"], attrs: none,
            children: [ HtmlFundamental::Inline { text: r.label } ] },
        ] } ]
  }
}

@block("wf_toggle")
type WfToggle extends Widget {
  @inline(0) label: utf8?        // optional trailing caption
  on: bool?
  id: identifier?  class: list<utf8>?  width: utf8?  disabled: bool?
  lower = fn(t: WfToggle) -> list<HtmlFundamental> {
    let track_cls = if t.on == true { ["wf-track", "wf-on"] } else { ["wf-track"] };
    let track = HtmlFundamental::Element {
      tag: "span", id: none, class: track_cls, attrs: none,
      children: [ HtmlFundamental::Element { tag: "span", id: none, class: ["wf-knob"], attrs: none, children: [] } ],
    };
    let kids = if t.label == none { [track] }
      else { [ track, HtmlFundamental::Element {
        tag: "span", id: none, class: ["wf-control-label"], attrs: none,
        children: [ HtmlFundamental::Inline { text: t.label } ] } ] };
    [ HtmlFundamental::Element {
        tag: "div", id: t.id, class: wf_cls("wf-toggle", t.class, t.disabled),
        attrs: wf_style_attr("", t.width), children: kids } ]
  }
}

// ── Container widgets ─────────────────────────────────────────────────
// Each declares `@children(Widget)` and marks the child position with an
// `HtmlFundamental::Children {}` slot the renderer fills.

@block("wf_window")
type WfWindow extends Widget {
  @inline(0) title: utf8
  controls: bool?                // titlebar dots + close glyph (default true)
  id: identifier?  class: list<utf8>?  width: utf8?  disabled: bool?
  @children(Widget) children: list<Widget>
  lower = fn(w: WfWindow) -> list<HtmlFundamental> {
    let ctrls = if w.controls == false { [] }
      else { [
        HtmlFundamental::Element { tag: "span", id: none, class: ["wf-dot-btn"], attrs: none, children: [] },
        HtmlFundamental::Element { tag: "span", id: none, class: ["wf-dot-btn"], attrs: none, children: [] },
        HtmlFundamental::Icon { name: "lucide.x", class: ["wf-close"] },
      ] };
    let titlebar = HtmlFundamental::Element {
      tag: "div", id: none, class: ["wf-titlebar"], attrs: none,
      children: flatten([
        [ HtmlFundamental::Element { tag: "span", id: none, class: ["wf-title"], attrs: none,
            children: [ HtmlFundamental::Inline { text: w.title } ] } ],
        ctrls,
      ]),
    };
    [ HtmlFundamental::Element {
        tag: "div", id: w.id, class: wf_cls("wf-window", w.class, w.disabled),
        attrs: wf_style_attr("", w.width),
        children: [
          titlebar,
          HtmlFundamental::Element { tag: "div", id: none, class: ["wf-window-body"], attrs: none,
            children: [ HtmlFundamental::Children {} ] },
        ] } ]
  }
}

@block("wf_panel")
type WfPanel extends Widget {
  title: utf8?                   // optional group caption
  id: identifier?  class: list<utf8>?  width: utf8?  disabled: bool?
  @children(Widget) children: list<Widget>
  lower = fn(p: WfPanel) -> list<HtmlFundamental> {
    let head = if p.title == none { [] }
      else { [ HtmlFundamental::Element { tag: "div", id: none, class: ["wf-panel-title"], attrs: none,
        children: [ HtmlFundamental::Inline { text: p.title } ] } ] };
    [ HtmlFundamental::Element {
        tag: "div", id: p.id, class: wf_cls("wf-panel", p.class, p.disabled),
        attrs: wf_style_attr("", p.width),
        children: flatten([
          head,
          [ HtmlFundamental::Element { tag: "div", id: none, class: ["wf-panel-body"], attrs: none,
              children: [ HtmlFundamental::Children {} ] } ],
        ]) } ]
  }
}

// Layout containers: thin wrappers that arrange their children. Drop one
// inside a window/panel to change how controls flow.

@block("wf_column")
type WfColumn extends Widget {
  id: identifier?  class: list<utf8>?  width: utf8?  disabled: bool?
  @children(Widget) children: list<Widget>
  lower = fn(c: WfColumn) -> list<HtmlFundamental> [
    HtmlFundamental::Element {
      tag: "div", id: c.id, class: wf_cls("wf-col", c.class, c.disabled),
      attrs: wf_style_attr("", c.width),
      children: [ HtmlFundamental::Children {} ],
    },
  ]
}

@block("wf_row")
type WfRow extends Widget {
  id: identifier?  class: list<utf8>?  width: utf8?  disabled: bool?
  @children(Widget) children: list<Widget>
  lower = fn(r: WfRow) -> list<HtmlFundamental> [
    HtmlFundamental::Element {
      tag: "div", id: r.id, class: wf_cls("wf-row", r.class, r.disabled),
      attrs: wf_style_attr("", r.width),
      children: [ HtmlFundamental::Children {} ],
    },
  ]
}

@block("wf_grid")
type WfGrid extends Widget {
  columns: i64                   // number of equal-width columns
  id: identifier?  class: list<utf8>?  width: utf8?  disabled: bool?
  @children(Widget) children: list<Widget>
  lower = fn(g: WfGrid) -> list<HtmlFundamental> [
    HtmlFundamental::Element {
      tag: "div", id: g.id, class: wf_cls("wf-grid", g.class, g.disabled),
      attrs: wf_style_attr(format("grid-template-columns:repeat({},1fr);", g.columns), g.width),
      children: [ HtmlFundamental::Children {} ],
    },
  ]
}

// Clean grey-box theme. Like the callout stylesheet, the defaults are
// theme-neutral — translucent greys + `currentColor` + `color: inherit`
// — so widgets read on both light and dark pages with no media query,
// and follow the book template's theme toggle automatically. The
// themeable surface properties sit on bare single-class selectors, so a
// user `class "wf-button" { … dark {…} light {…} }` overrides by
// cascade (the class rules are emitted after this sheet). Structural
// rules (flex direction, the radio dot, the toggle knob, compound
// `.wf-track.wf-on`) live here because the bare-class `class` system
// can't express them.
stylesheet "wdoc-wireframe" {
  css = <<CSS
    .wf-window { display: inline-block; min-width: 16rem; color: inherit;
      background: rgba(127,127,127,0.05); border: 1px solid rgba(127,127,127,0.45);
      border-radius: 6px; font-family: system-ui, sans-serif; font-size: 0.9rem;
      box-shadow: 0 1px 4px rgba(0,0,0,0.18); margin: 1rem 0; overflow: hidden; }
    .wf-titlebar { display: flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.6rem;
      background: rgba(127,127,127,0.14); border-bottom: 1px solid rgba(127,127,127,0.35); }
    .wf-title { font-weight: 600; flex: 1; }
    .wf-dot-btn { width: 0.7rem; height: 0.7rem; border-radius: 50%;
      border: 1px solid rgba(127,127,127,0.6); display: inline-block; }
    .wf-close svg.wdoc-icon { width: 1em; height: 1em; opacity: 0.7; }
    .wf-window-body { display: flex; flex-direction: column; gap: 0.6rem; padding: 0.8rem; }

    .wf-panel { color: inherit; border: 1px solid rgba(127,127,127,0.45); border-radius: 5px;
      font-family: system-ui, sans-serif; font-size: 0.9rem; }
    .wf-panel-title { padding: 0.3rem 0.6rem; font-weight: 600; opacity: 0.7; }
    .wf-panel-body { display: flex; flex-direction: column; gap: 0.6rem; padding: 0.6rem; }

    .wf-col { display: flex; flex-direction: column; gap: 0.6rem; }
    .wf-row { display: flex; flex-direction: row; align-items: center; gap: 0.8rem; flex-wrap: wrap; }
    .wf-grid { display: grid; gap: 0.6rem; }

    .wf-label { color: inherit; font-family: system-ui, sans-serif; font-size: 0.9rem; }
    .wf-control-label { color: inherit; }

    .wf-button { display: inline-flex; align-items: center; justify-content: center; gap: 0.35rem;
      padding: 0.35rem 0.85rem; border: 1px solid rgba(127,127,127,0.45); border-radius: 4px;
      background: rgba(127,127,127,0.16); color: inherit;
      font-family: system-ui, sans-serif; font-size: 0.9rem; cursor: default; user-select: none; }
    .wf-icon svg.wdoc-icon { width: 1em; height: 1em; }

    .wf-input { display: flex; align-items: center; min-width: 8rem; padding: 0.35rem 0.6rem;
      border: 1px solid rgba(127,127,127,0.45); border-radius: 4px; background: rgba(127,127,127,0.04);
      color: inherit; font-family: system-ui, sans-serif; font-size: 0.9rem; }
    .wf-input-text { color: inherit; }
    .wf-placeholder { opacity: 0.55; font-style: italic; }

    .wf-dropdown { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
      min-width: 8rem; padding: 0.35rem 0.6rem; border: 1px solid rgba(127,127,127,0.45);
      border-radius: 4px; background: rgba(127,127,127,0.04); color: inherit;
      font-family: system-ui, sans-serif; font-size: 0.9rem; }
    .wf-dropdown-chevron svg.wdoc-icon { width: 1em; height: 1em; opacity: 0.7; }

    .wf-checkbox, .wf-radio, .wf-toggle { display: inline-flex; align-items: center; gap: 0.45rem;
      color: inherit; font-family: system-ui, sans-serif; font-size: 0.9rem; }
    .wf-box { width: 1rem; height: 1rem; border: 1px solid rgba(127,127,127,0.6); border-radius: 3px;
      background: rgba(127,127,127,0.04); display: inline-flex; align-items: center; justify-content: center; }
    .wf-box.wf-checked { background: rgba(127,127,127,0.55); border-color: rgba(127,127,127,0.7); }
    .wf-tick svg.wdoc-icon { width: 0.8em; height: 0.8em; }

    .wf-dot { width: 1rem; height: 1rem; border: 1px solid rgba(127,127,127,0.6); border-radius: 50%;
      background: rgba(127,127,127,0.04); position: relative; display: inline-block; }
    .wf-dot.wf-checked::after { content: ""; position: absolute; inset: 3px; border-radius: 50%;
      background: currentColor; }

    .wf-track { width: 2.2rem; height: 1.2rem; border-radius: 0.6rem; border: 1px solid rgba(127,127,127,0.6);
      background: rgba(127,127,127,0.18); position: relative; display: inline-block; }
    .wf-knob { position: absolute; top: 1px; left: 1px; width: 1rem; height: 1rem; border-radius: 50%;
      background: currentColor; opacity: 0.55; }
    .wf-track.wf-on { background: rgba(127,127,127,0.5); }
    .wf-track.wf-on .wf-knob { left: auto; right: 1px; opacity: 0.95; }

    .wf-disabled { opacity: 0.45; }
    CSS
}
