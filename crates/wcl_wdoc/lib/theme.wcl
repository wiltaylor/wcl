    cyan = "#04a5e5"  blue = "#1e66f5"  purple = "#8839ef"  pink = "#1e66f5"
  }
}

// Rosé Pine — muted rose (Main = dark, Dawn = light).
theme rose {
  palette dark {
    bg = "#191724"  book_bg = "#1f1d2e"  bg_alt = "#26233a"  bg_inset = "#26233a"  overlay = "#2a273f"
    border = "#26233a"  border_strong = "#403d52"
    heading = "#e0def4"  fg = "#c9c7e0"  fg_muted = "#908caa"  fg_subtle = "#6e6a86"  selection = "#c4a7e7"
    accent = "#c4a7e7"  accent_2 = "#ebbcba"  link = "#9ccfd8"  on_accent = "#1f1d2e"
    syn_kw = "#c4a7e7"  syn_str = "#f6c177"  syn_num = "#ebbcba"  syn_fn = "#ebbcba"
    syn_type = "#9ccfd8"  syn_comment = "#6e6a86"  syn_punct = "#908caa"
    red = "#eb6f92"  orange = "#ebbcba"  yellow = "#f6c177"  green = "#9ccfd8"
    cyan = "#31748f"  blue = "#31748f"  purple = "#c4a7e7"  pink = "#ebbcba"
