// ── Colour themes ──────────────────────────────────────────────────
//
// A `theme` is a named, reusable palette pair — a `dark` and a `light`
// `palette` sub-block — that a `site` selects to recolour everything the
// renderer emits: page background / text, links, headings, code-block
// syntax highlighting, chart series, callouts, tables, and the template
// chrome. Selection lives on the `site` block, by name:
//
//   site "docs" {
//     default_template = :book
//     theme  = :catppuccin   // names a `theme` block (built-in or your own)
//     accent = :blue         // red orange yellow green cyan blue purple pink
//   }
//
// A `site` with no `theme` defaults to `:nord`. A document with no `site`
// block renders bare (unthemed).
//
// HOW IT WORKS: the renderer finds the named `theme` block and emits CSS
// custom properties (`--wdoc-bg`, `--wdoc-fg`, `--wdoc-blue`, …) on
// `:root` — once for its `dark` palette (the default), once under
// `@media (prefers-color-scheme: light)` for the `light` palette, and once
// per explicit `:root[data-theme=…]` (the book template's toggle).
// Everything else — the stylesheets, the `class` system, the templates —
// paints with `var(--wdoc-*)`, so adding a new template needs no theme
// work: just reference the vars. The accent picks one hue, exposed as
// `--wdoc-accent`.
//
// DEFINE YOUR OWN: a `theme` is just a block, so author one and select it
// the same way:
//
//   theme midnight {
//     palette dark  { bg = "#0b0b14"  fg = "#e6e6f0"  blue = "#8be9fd"  … }
//     palette light { bg = "#fafafe"  fg = "#1b1b28"  … }
//   }
//   site "docs" { theme = :midnight }

// A full set of colour roles for one mode, labelled `dark` or `light`.
// Generic on purpose — these roles cover page chrome, text hierarchy, a
// dedicated accent/link vocabulary, syntax-token colours, and an 8-hue
// ring that doubles as the chart cycle — so templates and blocks added
// later have everything they need. Every role is optional: an omitted
// role simply emits no var (so a partial custom palette inherits the
// rest from the cascade).
//   bg            outer page background (the gutter around the reading column)
//   book_bg       reading-column / card surface
//   bg_alt        raised surface (sidebar, code card, table header, inline code)
//   bg_inset      sunken surface (legacy code-block fill; usually = bg_alt)
//   overlay       subtle fill / divider background
//   border        hairline borders
//   border_strong stronger borders / kbd outlines / rules
//   fg            body text
//   fg_muted      secondary text (nav, captions, punctuation)
//   fg_subtle     faint text (comments, metadata)
//   heading       heading + strong text
//   selection     text-selection background
//   accent        primary accent (active nav, markers, focus)
//   accent_2      secondary accent
//   link          hyperlink colour
//   on_accent     text/icon drawn on an accent fill
//   syn_kw syn_str syn_num syn_fn syn_type syn_comment syn_punct
//                 syntax-highlighting token colours
//   red orange yellow green cyan blue purple pink
//                 the hue ring — chart series 1-8 + callout accents
namespace wdoc

@block("palette")
type PaletteBlock {
  @inline(0) mode: identifier        // `dark` or `light`
  bg: utf8?  book_bg: utf8?  bg_alt: utf8?  bg_inset: utf8?  overlay: utf8?
  border: utf8?  border_strong: utf8?
  fg: utf8?  fg_muted: utf8?  fg_subtle: utf8?  heading: utf8?  selection: utf8?
  accent: utf8?  accent_2: utf8?  link: utf8?  on_accent: utf8?
  syn_kw: utf8?  syn_str: utf8?  syn_num: utf8?  syn_fn: utf8?
  syn_type: utf8?  syn_comment: utf8?  syn_punct: utf8?
  red: utf8?  orange: utf8?  yellow: utf8?  green: utf8?
  cyan: utf8?  blue: utf8?  purple: utf8?  pink: utf8?
}

// A named theme: a `dark` palette (the default mode) and a `light` one
// (system `prefers-color-scheme: light`, or the explicit toggle), plus
// the three font stacks the book reads through `--wdoc-font-head/-body/
// -mono` (omitted ⇒ the `wdoc-fonts` defaults: IBM Plex Sans / Source
// Serif 4 / JetBrains Mono).
@block("theme")
type ThemeBlock {
  @inline(0) name: identifier
  font_head: utf8?  font_body: utf8?  font_mono: utf8?
  @children("palette") palettes: list<PaletteBlock>
}

// ── Built-in themes ────────────────────────────────────────────────
// The six book themes, each with a co-ordinated `dark` + `light` palette.
// Roles map onto the design's full vocabulary (bg / book-bg / surfaces /
// borders / ink hierarchy / accent set / syntax tokens). The 8-hue ring
// is derived from each theme's semantic + syntax colours so the
// hue-driven systems (chart series, callout accents, diagram shapes)
// stay co-ordinated: red=danger, orange=syn-num, yellow=warn, green=tip,
// cyan=info, blue=note, purple=syn-kw, pink=accent-2. Fonts default to
// the `wdoc-fonts` stacks; only `paper` overrides (serif headings).

// Nord — cool blue-grey (the default).
theme nord {
  palette dark {
    bg = "#242933"  book_bg = "#2e3440"  bg_alt = "#3b4252"  bg_inset = "#3b4252"  overlay = "#434c5e"
    border = "#3b4252"  border_strong = "#4c566a"
    heading = "#eceff4"  fg = "#d8dee9"  fg_muted = "#a0aabe"  fg_subtle = "#7a8699"  selection = "#88c0d0"
    accent = "#88c0d0"  accent_2 = "#81a1c1"  link = "#8fbcbb"  on_accent = "#2e3440"
    syn_kw = "#81a1c1"  syn_str = "#a3be8c"  syn_num = "#b48ead"  syn_fn = "#88c0d0"
    syn_type = "#8fbcbb"  syn_comment = "#616e88"  syn_punct = "#eceff4"
    red = "#bf616a"  orange = "#b48ead"  yellow = "#ebcb8b"  green = "#a3be8c"
    cyan = "#81a1c1"  blue = "#81a1c1"  purple = "#81a1c1"  pink = "#81a1c1"
  }
  palette light {
    bg = "#d8dee9"  book_bg = "#eceff4"  bg_alt = "#e5e9f0"  bg_inset = "#e5e9f0"  overlay = "#d8dee9"
    border = "#d8dee9"  border_strong = "#c0c8d6"
    heading = "#2e3440"  fg = "#3b4252"  fg_muted = "#566173"  fg_subtle = "#707d92"  selection = "#5e81ac"
    accent = "#5e81ac"  accent_2 = "#81a1c1"  link = "#5e81ac"  on_accent = "#eceff4"
    syn_kw = "#5e81ac"  syn_str = "#4f7a3e"  syn_num = "#94618c"  syn_fn = "#2f7a86"
    syn_type = "#3d7a86"  syn_comment = "#8a95a8"  syn_punct = "#3b4252"
    red = "#a84b54"  orange = "#94618c"  yellow = "#9a7411"  green = "#4f7a3e"
    cyan = "#5e81ac"  blue = "#5e81ac"  purple = "#5e81ac"  pink = "#81a1c1"
  }
}

// Tokyo Night — vivid night palette.
theme tokyonight {
  palette dark {
    bg = "#16161e"  book_bg = "#1a1b26"  bg_alt = "#1f2335"  bg_inset = "#1f2335"  overlay = "#24283b"
    border = "#2a2e42"  border_strong = "#3b4261"
    heading = "#c0caf5"  fg = "#a9b1d6"  fg_muted = "#7982b3"  fg_subtle = "#565f89"  selection = "#7aa2f7"
    accent = "#7aa2f7"  accent_2 = "#bb9af7"  link = "#7dcfff"  on_accent = "#16161e"
    syn_kw = "#bb9af7"  syn_str = "#9ece6a"  syn_num = "#ff9e64"  syn_fn = "#7aa2f7"
    syn_type = "#2ac3de"  syn_comment = "#565f89"  syn_punct = "#89ddff"
    red = "#f7768e"  orange = "#ff9e64"  yellow = "#e0af68"  green = "#9ece6a"
    cyan = "#7dcfff"  blue = "#7aa2f7"  purple = "#bb9af7"  pink = "#bb9af7"
  }
  palette light {
    bg = "#d5d6db"  book_bg = "#e1e2e7"  bg_alt = "#dcdee3"  bg_inset = "#dcdee3"  overlay = "#cdcfdb"
    border = "#c4c8da"  border_strong = "#a8aecb"
    heading = "#343b58"  fg = "#4c505e"  fg_muted = "#5a6296"  fg_subtle = "#8990b3"  selection = "#2e7de9"
    accent = "#2e7de9"  accent_2 = "#9854f1"  link = "#2e7de9"  on_accent = "#e1e2e7"
    syn_kw = "#9854f1"  syn_str = "#587539"  syn_num = "#b15c00"  syn_fn = "#2e7de9"
    syn_type = "#007197"  syn_comment = "#9699a8"  syn_punct = "#006c86"
    red = "#f52a65"  orange = "#b15c00"  yellow = "#8c6c3e"  green = "#587539"
    cyan = "#07879d"  blue = "#2e7de9"  purple = "#9854f1"  pink = "#9854f1"
  }
}

// Gruvbox — warm retro.
theme gruvbox {
