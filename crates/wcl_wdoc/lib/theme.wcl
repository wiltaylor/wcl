    cyan = "#286983"  blue = "#286983"  purple = "#907aa9"  pink = "#d7827e"
  }
}

// Paper — warm print look with serif headings.
theme paper {
  font_head = "'Source Serif 4', Georgia, serif"
  palette dark {
    bg = "#171513"  book_bg = "#211e1b"  bg_alt = "#2a2622"  bg_inset = "#2a2622"  overlay = "#322d28"
    border = "#322d28"  border_strong = "#443d35"
    heading = "#ece4d6"  fg = "#d2c8b6"  fg_muted = "#9a8f7d"  fg_subtle = "#756c5d"  selection = "#d98b8b"
    accent = "#d98b8b"  accent_2 = "#8fb0cf"  link = "#d98b8b"  on_accent = "#211e1b"
    syn_kw = "#d98b8b"  syn_str = "#9bbd86"  syn_num = "#c7a0d9"  syn_fn = "#8fb0cf"
    syn_type = "#d9b779"  syn_comment = "#756c5d"  syn_punct = "#d2c8b6"
    red = "#d98b8b"  orange = "#c7a0d9"  yellow = "#d9b779"  green = "#9bbd86"
    cyan = "#8fb0cf"  blue = "#8fb0cf"  purple = "#d98b8b"  pink = "#8fb0cf"
  }
  palette light {
    bg = "#e7e3da"  book_bg = "#fcfbf7"  bg_alt = "#f4f1ea"  bg_inset = "#f4f1ea"  overlay = "#ebe7dd"
    border = "#ddd8cc"  border_strong = "#c4bdab"
    heading = "#1a1714"  fg = "#3a352e"  fg_muted = "#6b6358"  fg_subtle = "#8a8174"  selection = "#8a1c1c"
    accent = "#8a1c1c"  accent_2 = "#2c4a6e"  link = "#8a1c1c"  on_accent = "#fcfbf7"
    syn_kw = "#8a1c1c"  syn_str = "#3a5f2e"  syn_num = "#6a4a8a"  syn_fn = "#2c4a6e"
    syn_type = "#8a5a12"  syn_comment = "#9a9082"  syn_punct = "#3a352e"
    red = "#8a1c1c"  orange = "#6a4a8a"  yellow = "#8a5a12"  green = "#3a5f2e"
    cyan = "#2c4a6e"  blue = "#2c4a6e"  purple = "#8a1c1c"  pink = "#2c4a6e"
  }
}
