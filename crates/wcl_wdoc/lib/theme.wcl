// ── Colour themes ──────────────────────────────────────────────────
//
// A `ColourTheme` is a named, reusable palette pair — a `dark` and a
// `light` `Palette` — that a `site` selects to recolour everything the
// renderer emits: page background / text, links, headings, code-block
// syntax highlighting, chart series, callouts, tables, and the template
// chrome. Selection lives on the `site` block:
//
//   site "docs" {
//     default_template = :book
//     theme  = catppuccin   // any ColourTheme value (built-in or your own)
//     accent = :blue        // red orange yellow green cyan blue purple pink
//   }
//
// A `site` with no `theme` defaults to `nord`. A document with no `site`
// block renders bare (unthemed).
//
// HOW IT WORKS: the renderer reads the selected theme's record and emits
// CSS custom properties (`--wdoc-bg`, `--wdoc-fg`, `--wdoc-blue`, …) on
// `:root` — once for dark (the default), once under
// `@media (prefers-color-scheme: light)`, and once per explicit
// `:root[data-theme=…]` (the book template's toggle). Everything else —
// the stylesheets, the `class` system, the templates — paints with
// `var(--wdoc-*)`, so adding a new template needs no theme work: just
// reference the vars. The accent picks one hue, exposed as `--wdoc-accent`.
//
// DEFINE YOUR OWN: a `ColourTheme` is an ordinary value, so a user can
// declare one and select it the same way:
//
//   let midnight = ColourTheme::Of {
//     name: "Midnight",
//     dark:  Palette::Of { bg: "#0b0b14", … pink: "#ff79c6" },
//     light: Palette::Of { bg: "#fafafe", … pink: "#d6298f" },
//   }
//   site "docs" { theme = midnight }

// A full set of colour roles for one mode. Generic on purpose — these
// 18 roles cover page chrome, text hierarchy, and an 8-hue palette that
// doubles as the chart cycle and the accent vocabulary — so templates
// and blocks added later have everything they need.
//   bg          page background
//   bg_alt      raised surface (sidebar, card, table header)
//   bg_inset    sunken surface (code block)
//   overlay     subtle fill / divider background
//   border      hairline borders
//   fg          body text
//   fg_muted    secondary text (nav, captions)
//   fg_subtle   faint text (code comments)
//   heading     heading text
//   selection   text-selection background
//   red orange yellow green cyan blue purple pink
//               the hue ring — chart series 1-8 and the accent options
union Palette {
  Of {
    bg: utf8  bg_alt: utf8  bg_inset: utf8  overlay: utf8  border: utf8
    fg: utf8  fg_muted: utf8  fg_subtle: utf8  heading: utf8  selection: utf8
    red: utf8  orange: utf8  yellow: utf8  green: utf8
    cyan: utf8  blue: utf8  purple: utf8  pink: utf8
  }
}

// A named theme: a `dark` palette (the default mode) and a `light` one
// (system `prefers-color-scheme: light`, or the explicit toggle).
union ColourTheme {
  Of { name: utf8  dark: Palette  light: Palette }
}

// ── Built-in themes ────────────────────────────────────────────────
// Palettes sourced from each project's official reference. A handful of
// roles a palette doesn't define (e.g. a distinct `pink`, or a `bg_inset`
// step) reuse the nearest hue / shade.

// Nord — nordtheme.com. Light mode is built from the Snow Storm tints.
let nord = ColourTheme::Of {
  name: "Nord",
  dark: Palette::Of {
    bg: "#2e3440", bg_alt: "#3b4252", bg_inset: "#272c36", overlay: "#434c5e", border: "#4c566a",
    fg: "#d8dee9", fg_muted: "#9aa5b8", fg_subtle: "#4c566a", heading: "#eceff4", selection: "#434c5e",
    red: "#bf616a", orange: "#d08770", yellow: "#ebcb8b", green: "#a3be8c",
    cyan: "#88c0d0", blue: "#81a1c1", purple: "#b48ead", pink: "#8fbcbb",
  },
  light: Palette::Of {
    bg: "#eceff4", bg_alt: "#e5e9f0", bg_inset: "#d8dee9", overlay: "#d8dee9", border: "#d8dee9",
    fg: "#2e3440", fg_muted: "#4c566a", fg_subtle: "#7b8794", heading: "#2e3440", selection: "#d8dee9",
    red: "#bf616a", orange: "#d08770", yellow: "#b9952f", green: "#7e9a5c",
    cyan: "#5e81ac", blue: "#5e81ac", purple: "#9d7495", pink: "#8fbcbb",
  },
}

