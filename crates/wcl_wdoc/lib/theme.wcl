// Catppuccin — soft pastel (Mocha = dark, Latte = light).
theme catppuccin {
  palette dark {
    bg = "#181825"  book_bg = "#1e1e2e"  bg_alt = "#313244"  bg_inset = "#313244"  overlay = "#45475a"
    border = "#313244"  border_strong = "#45475a"
    heading = "#cdd6f4"  fg = "#bac2de"  fg_muted = "#a6adc8"  fg_subtle = "#7f849c"  selection = "#cba6f7"
    accent = "#cba6f7"  accent_2 = "#89b4fa"  link = "#89b4fa"  on_accent = "#1e1e2e"
    syn_kw = "#cba6f7"  syn_str = "#a6e3a1"  syn_num = "#fab387"  syn_fn = "#89b4fa"
    syn_type = "#f9e2af"  syn_comment = "#6c7086"  syn_punct = "#94e2d5"
    red = "#f38ba8"  orange = "#fab387"  yellow = "#f9e2af"  green = "#a6e3a1"
    cyan = "#89dceb"  blue = "#89b4fa"  purple = "#cba6f7"  pink = "#89b4fa"
  }
  palette light {
    bg = "#dce0e8"  book_bg = "#eff1f5"  bg_alt = "#e6e9ef"  bg_inset = "#e6e9ef"  overlay = "#ccd0da"
    border = "#ccd0da"  border_strong = "#acb0be"
    heading = "#4c4f69"  fg = "#5c5f77"  fg_muted = "#6c6f85"  fg_subtle = "#8c8fa1"  selection = "#8839ef"
    accent = "#8839ef"  accent_2 = "#1e66f5"  link = "#1e66f5"  on_accent = "#eff1f5"
    syn_kw = "#8839ef"  syn_str = "#40a02b"  syn_num = "#fe640b"  syn_fn = "#1e66f5"
    syn_type = "#df8e1d"  syn_comment = "#9ca0b0"  syn_punct = "#179299"
