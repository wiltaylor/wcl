  palette light {
    bg = "#f4ede8"  book_bg = "#fffaf3"  bg_alt = "#f2e9e1"  bg_inset = "#f2e9e1"  overlay = "#fdf0e9"
    border = "#f2e9e1"  border_strong = "#dfdad9"
    heading = "#575279"  fg = "#6e6a86"  fg_muted = "#797593"  fg_subtle = "#9893a5"  selection = "#907aa9"
