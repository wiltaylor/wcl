// ── File ────────────────────────────────────────────────────────────
//
// A generic "ship this file into the output" block. `source` is a path
// relative to the document; the file is copied verbatim into the build
// output under `dir` (keeping its basename, so the emitted path is stable
// and hand-linkable — `scripts/build.sh`, not a hashed name). An external
// `source` (`http(s)://`, `data:`, or a leading `/`) passes through
// unchanged and is never copied.
//
// Two roles from one block:
//   - silent ship (no `as`)  → the file is copied; reference it yourself
//                              by its `<dir>/<basename>` path.
//   - inline reference (`as`) → renders a link to the copied file.
//
// The copy, path rewrite, and `dir` routing aren't expressible in WCL, so
// like `image` it is `@native`. The skill target routes files to the
// skill's `scripts/` / `assets/` folders (by `dir`); the HTML and Markdown
// targets default `dir` to the `_wdoc/` asset folder.
//
// **Not covered by the PDF target.** A PDF is one self-contained document:
// there is no output folder beside it to copy the file into, so a rendered
// link would point at something that was never shipped — worse than no
// link. The `backends` list says so, and a `file` on a page being built to
// PDF is refused until the author states the intent per instance
// (`@except(backends = [:pdf])`). Shipping sidecar assets beside a PDF is a
// deliberate non-goal, not a gap waiting to be filled.
namespace wdoc

@block("file")
@native(backends = [:html, :markdown, :skill])
type FileObj extends WdocBlock {
  @doc("File source (the inline label): a doc-relative path, a URL, or a `data:` URI.")
  @inline(0) source: utf8
  @doc("Output subdirectory. Skill target: e.g. \"scripts\" / \"assets\". HTML/Markdown: defaults to the `_wdoc/` asset folder.")
  dir: utf8?
  @doc("Link text. When set, the block renders a link to the copied file; absent ⇒ the file is shipped silently.")
  as: utf8?
  @doc("Optional explicit HTML id.")
  id: identifier?
  @doc("Optional style classes (HTML target, when `as` renders a link).")
  class: list<utf8>?
}
