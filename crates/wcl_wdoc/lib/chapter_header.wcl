// ── Stdlib chapter header ──────────────────────────────────────────
//
// A rich page header: an optional kicker (chapter / section eyebrow), the
// page's `h1`, and an optional meta line (reading time / updated date /
// version). Lowers to a `Content::ChapterHeader` — one node of the
// semantic content IR carrying each of those as a field — so every
// backend renders it from one declaration.
//
// Before, the header was built here out of `Element` / `Raw` markup, and
// the kicker, reading time, updated date and version existed **only in
// HTML**: the Markdown and PDF backends descended the `<header>` and
// emitted whatever prose fell out, with the meta line's structure gone.
// They read the fields now, and each decides how to print them (the
// separator between the meta parts is one shared fact — `chapter_meta_line`
// in `crates/wcl_wdoc/src/content.rs`).

namespace wdoc

@block("chapter_header")
type ChapterHeader extends ContentBlock {
  @doc("The page title (the inline label slot) — rendered as the page `h1`.")
  @inline(0) title: utf8
  @doc("Small eyebrow above the title (e.g. a chapter number + section name).")
  kicker: utf8?
  @doc("Estimated reading time (e.g. `\"9 min read\"`).")
  reading_time: utf8?
  @doc("Last-updated label (e.g. a date).")
  updated: utf8?
  @doc("Version label (e.g. `\"wdoc 0.24.1-alpha\"`).")
  version: utf8?
  @doc("Optional explicit HTML id for the header.")
  id: identifier?
  lower = fn(c: ChapterHeader) -> list<Content> [
    Content::ChapterHeader {
      title: c.title,
      kicker: c.kicker,
      reading_time: c.reading_time,
      updated: c.updated,
      version: c.version,
      id: c.id,
    },
  ]
}

// Chapter-header layout; colours come from the theme apply rules. The
// class names are the ones the content IR's HTML reading emits
// (`render/content_html.rs`), not names authored here — a
// `Content::ChapterHeader` renders the same however it was produced.
stylesheet "wdoc-chapter-header" {
  css = <<CSS
    .chapter-header { margin: 0 0 2.5rem; }
    .chapter-kicker { font-size: 0.8rem; letter-spacing: 0.04em; margin: 0 0 0.6rem; }
    .chapter-header h1 { margin-top: 0; }
    .chapter-subtitle { font-size: 1.05rem; margin: 0.4rem 0 0; }
    .chapter-meta { display: flex; flex-wrap: wrap; gap: 0.5rem 1.1rem; margin: 1rem 0 0; padding-top: 0.9rem; font-size: 0.82rem; white-space: pre-wrap; }
    CSS
}
