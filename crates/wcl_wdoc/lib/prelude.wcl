// wdoc standard library — prelude.
//
// The public entry point is `wdoc.wcl`, which a user opts into with
// `import <wdoc.wcl>`; that imports this file, which pulls in every part
// of the schema. The parts are embedded in the binary and resolved
// through the registry (see `crates/wcl_wdoc/src/build.rs`); the
// angle-bracket paths are importer-relative, so `import <core.wcl>` here
// resolves to `wdoc/core.wcl`.
//
// Ordering does not matter — names resolve across every imported file —
// so the parts are listed bottom-up by dependency for readability.

namespace wdoc

import <core.wcl>             // @document Site, block interfaces, Page, Class
import <theme.wcl>            // ColourTheme / Palette + built-in colour themes
import <fonts.wcl>            // @font-face faces + --wdoc-font-* defaults
import <css-classes.wcl>      // bundled default `class` instances
import <diagram-core.wcl>     // diagram, container, SVG shapes, fundamentals
import <text.wcl>             // text / span / column
import <callout.wcl>          // admonition
import <wireframe.wcl>        // wireframe UI widgets (window/button/…)
import <table.wcl>            // pipe-table block
import <list.wcl>             // bullet / numbered lists (list + li)
import <components.wcl>       // wdoc_component / wdoc_slot / wdoc_body / wdoc_repeater
import <project.wcl>          // body (addressable content) + project (render by reference)
import <templates.wcl>        // page templates (webpage / book) + parts
import <presentation.wcl>     // presentation deck (slides + sections + template)
import <website.wcl>          // website template (named regions + head assets)
import <inline.wcl>           // inline-span union + pattern type
import <inline-patterns.wcl>  // built-in inline patterns (bold/italic/…)
import <icons.wcl>            // iconset / icon_def / icon
import <image.wcl>            // image (page <img> + diagram <image>)
import <file.wcl>             // file (ship + reference an arbitrary file)
import <include.wcl>          // include (build other wdoc docs into a subdir)
import <video.wcl>            // video (page <video> / embed, click-to-play)
import <tilemap.wcl>          // tileset / tile / tilemap
import <dopesheet.wcl>        // animated sprite-sheet playback
import <map.wcl>              // zoomable map + pins + cards
import <flowchart.wcl>        // process / decision / terminator
import <charts.wcl>           // bar / line / pie charts + geometry
import <timeline.wcl>         // horizontal / vertical timeline
import <card.wcl>             // rich-text card shape (foreignObject)
import <node_table.wcl>       // row-table shape (DB / class diagrams) + per-row ports
import <tree.wcl>             // indented file-tree shape (nested nodes + guides)
import <headings.wcl>         // h1..h6
import <chapter_header.wcl>   // rich page header (kicker + h1 + meta)
import <footnotes.wcl>        // footnote definitions + [^id] references
import <p.wcl>                // single-span paragraph shorthand
import <code.wcl>             // syntax-highlighted code block
import <markdown_source.wcl>  // preview a (skill) page's generated Markdown
import <terminal.wcl>         // terminal grid + primitives
import <tui.wcl>              // single-line TUI widgets (progress/button/…)
import <math.wcl>             // LaTeX equations → SVG (RaTeX)
import <typedoc.wcl>          // type_table: schema-reflected property tables
import <demo.wcl>             // demo: example source + live light/dark preview
import <sequence.wcl>         // sequence diagrams (participants / messages / notes)
import <statechart.wcl>       // state diagrams (states / transitions, auto-ranked)
import <visibility.wcl>       // @only / @except block visibility filters
import <comment.wcl>          // @comment review notes (wcl wdoc serve --comment)
import <file_placement.wcl>   // @wdoc::file object placement (wcl wdoc serve --edit)
import <edit_object.wcl>      // edit_object button (wcl wdoc serve --edit)
