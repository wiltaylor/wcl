// ── Built-in inline patterns ───────────────────────────────────────
//
// Each pattern's `to_span` receives the captured groups as a list,
// with index 0 = the whole matched string and 1+ = the regex's
// explicit capture groups. The `at(list, i)` builtin reads a
// specific index. The renderer applies these to every `span`
// block's text and re-tokenizes the result with a depth cap so
// patterns can nest.

inline_pattern bold {
  pattern = "\\*\\*([^*\n]+)\\*\\*"
  to_span = fn(g: list<utf8>) -> list<InlineSpan>
    [InlineSpan::Plain { text: at(g, 1), class: ["bold"] }]
}

inline_pattern italic {
  pattern = "_([^_\n]+)_"
  to_span = fn(g: list<utf8>) -> list<InlineSpan>
    [InlineSpan::Plain { text: at(g, 1), class: ["italic"] }]
}

inline_pattern code {
  pattern = "`([^`\n]+)`"
  to_span = fn(g: list<utf8>) -> list<InlineSpan>
    [InlineSpan::Plain { text: at(g, 1), class: ["code"] }]
}

inline_pattern link {
  pattern = "\\[([^\\]]+)\\]\\(([^)]+)\\)"
  // Links carry a `link` class so they can be themed with a `class`
  // block (e.g. for light/dark colours), like any other region.
  to_span = fn(g: list<utf8>) -> list<InlineSpan>
    [InlineSpan::Link { text: at(g, 1), href: at(g, 2), class: ["link"] }]
}

// `:name:` / `:set.name:` → an icon. The renderer resolves the name
// against the declared `iconset`s; an unknown name (or no iconsets)
// falls back to the literal matched text, so prose like `time: 10:30`
// is left untouched.
inline_pattern icon {
  pattern = ":([a-z0-9][a-z0-9._-]*):"
  to_span = fn(g: list<utf8>) -> list<InlineSpan>
    [InlineSpan::Icon { name: at(g, 1), class: none }]
}
