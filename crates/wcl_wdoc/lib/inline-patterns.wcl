// ── Built-in inline patterns ───────────────────────────────────────
//
// Each pattern's `to_span` receives the captured groups as a list,
// with index 0 = the whole matched string and 1+ = the regex's
// explicit capture groups. The `at(list, i)` builtin reads a
// specific index. The renderer applies these to every `span`
// block's text and re-tokenizes the result with a depth cap so
// patterns can nest.

namespace wdoc

inline_pattern bold {
  pattern = "\\*\\*([^*\n]+)\\*\\*"
  to_span = fn(g: list<utf8>) -> list<InlineSpan>
    [InlineSpan::Plain { text: at(g, 1), class: ["bold"] }]
}

inline_pattern italic {
  pattern = "_([^_\n]+)_"
  // Word-boundary gated: snake_case identifiers are everywhere in this
  // domain, so intraword underscores must stay literal (CommonMark rule).
  boundary = true
  to_span = fn(g: list<utf8>) -> list<InlineSpan>
    [InlineSpan::Plain { text: at(g, 1), class: ["italic"] }]
}

inline_pattern code {
  pattern = "`([^`\n]+)`"
  to_span = fn(g: list<utf8>) -> list<InlineSpan>
    [InlineSpan::Plain { text: at(g, 1), class: ["code"] }]
}

inline_pattern link {
  pattern = "\\[([^\\]]+)\\]\\(([^)]+)\\)"
  // Links carry a `link` class so they can be themed with a `class`
  // block (e.g. for light/dark colours), like any other region.
  to_span = fn(g: list<utf8>) -> list<InlineSpan>
    [InlineSpan::Link { text: at(g, 1), href: at(g, 2), class: ["link"] }]
}

// A bare absolute URL becomes a link without markdown syntax. Declared
// after `link`, whose earlier `[` start wins for `[text](https://…)`.
// The URL may not end in punctuation (a sentence-final `.` stays prose)
// and stops at whitespace, quotes, or brackets. The display text drops
// the scheme — which also keeps the nested re-tokenize pass (link text
// runs back through the patterns) from matching it a second time.
inline_pattern autolink {
  pattern = "(https?://)([^\\s<>\"'()\\[\\]]*[^\\s<>\"'()\\[\\].,:;!?])"
  to_span = fn(g: list<utf8>) -> list<InlineSpan>
    [InlineSpan::Link { text: at(g, 2), href: $"${at(g, 1)}${at(g, 2)}", class: ["link"] }]
}

// `:name:` / `:set.name:` → an icon. The renderer resolves the name
// against the declared `iconset`s; an unknown name (or no iconsets)
// falls back to the literal matched text, so prose like `time: 10:30`
// is left untouched.
inline_pattern icon {
  pattern = ":([a-z0-9][a-z0-9._-]*):"
  to_span = fn(g: list<utf8>) -> list<InlineSpan>
    [InlineSpan::Icon { name: at(g, 1), class: none }]
}

// `$$…$$` → a display-style inline equation. Declared before the
// text-style `$…$` so it wins at a `$$` opener. (In a plain string `$`
// is a literal byte — interpolation needs an interpolated-prefixed
// string — and `\\$` decodes to the two chars `\$` the regex needs to
// match a literal dollar.) Lazy body so adjacent equations don't merge.
inline_pattern math_display {
  pattern = "\\$\\$([^\n]+?)\\$\\$"
  to_span = fn(g: list<utf8>) -> list<InlineSpan>
    [InlineSpan::Math { latex: at(g, 1), display: true, class: none }]
}

// `$…$` → a text-style inline equation. The body may not touch the
// delimiters with whitespace (`[^\s$]` at each end), which keeps prose
// like `it cost $10 or $20` from matching (the `regex` engine has no
// look-around, so this no-adjacent-space rule is the guard). A
// malformed equation renders as an inline error marker, not a failure.
inline_pattern math {
  pattern = "\\$([^\\s$](?:[^$\n]*[^\\s$])?)\\$"
  to_span = fn(g: list<utf8>) -> list<InlineSpan>
    [InlineSpan::Math { latex: at(g, 1), display: false, class: none }]
}
