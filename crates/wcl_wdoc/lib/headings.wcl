// ── Stdlib headings ────────────────────────────────────────────────

namespace wdoc

@block("h1")
type H1 extends WdocBlock {
  @doc("The heading text (the inline label slot); inline patterns are applied.")
  @inline(0) text: utf8
  @doc("Optional explicit HTML id (the link target for cross-page anchors).")
  id: identifier?
  lower = fn(h: H1) -> list<HtmlFundamental> [
    HtmlFundamental::Paragraph { id: h.id, class: ["heading-1"], spans: [h.text] }
  ]
}

