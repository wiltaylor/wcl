// ── Stdlib headings ────────────────────────────────────────────────
//
// `h1`..`h6` lower to a `Content::Heading` — one node of the semantic
// content IR carrying the level as a **number**. Before, they lowered to
// an `Html::Paragraph` whose level rode in a CSS class
// (`class: ["heading-2"]`), which every non-HTML backend then had to
// parse back out of the class list; that reverse-engineering is what the
// IR exists to end. The `heading-N` class survives as a *style hook*
// (`css-classes.wcl` sizes each level through it), but it is now derived
// from the number by the backend — never read back into one.

namespace wdoc

@block("h1")
type H1 extends ContentBlock {
  @doc("The heading text (the inline label slot); inline patterns are applied.")
  @inline(0) text: utf8
  @doc("Optional explicit HTML id (the link target for cross-page anchors).")
  id: identifier?
  lower = fn(h: H1) -> list<Content> [
    Content::Heading { level: 1, text: h.text, id: h.id }
  ]
}

