// ── Stdlib TUI widgets ─────────────────────────────────────────────
//
// Single-line, colour-forward terminal controls — progress bars,
// buttons, spinners, inputs, dropdowns, checkboxes, radios, and
// containers — for mocking up text-user-interfaces inside a `terminal`.
//
// THE ONE BUILDING BLOCK IS STYLED TEXT. The terminal renderer draws a
// single primitive directly — `term_text` (a run of text at a cell, with
// colours + styles) — and `TermFundamental::Text` is its mirror. Every
// other element here (the boxes/fills/glyphs and every `tui_*` control)
// is a higher-level `@block` whose `lower` decomposes it into `Text`
// runs, which the renderer recursively draws into the grid
// (`crates/wcl_wdoc/src/terminal.rs`). Box-drawing, fills, and glyphs are
// just text — see the `term_*_runs` helpers below.
//
// COORDINATES ARE LOCAL. A widget's `lower` lays its text out from the
// widget's own top-left `(row 1, col 1)`; the renderer offsets it by the
// widget's placement (its `row`/`col` within the terminal, plus any
// enclosing container's content origin). So a widget never reads its own
// `row`/`col` — the renderer owns placement, which is what lets
// containers nest controls (a `Children` fundamental marks the content
// origin, and the renderer recurses the child blocks there).
//
// THEMING rides the terminal's `class` system. Accent parts use ANSI
// colour names (`green`/`blue`/`cyan`/`bright_black`/…) that resolve
// through the terminal palette, so they follow a site `theme` / `class`
// and are overridable per-instance (`accent = "#ff5fd2"`, etc.). Label
// text is left default-coloured, so it follows the terminal's
// `currentColor` (its `class` `color`, dark/light included).

// The terminal building blocks a widget lowers into: styled text, plus a
// `Children` content-origin slot for containers. Coordinates are 1-based
// and LOCAL to the emitting widget. Every REQUIRED field must be supplied
// at construction; an optional (`field?`) one defaults to `none` when
// omitted, so writing `fg: none` says nothing the omission doesn't.
// `term_run` below is the ergonomic constructor.
namespace wdoc

union TermFundamental {
  // A run of text (may contain `\n`) at (row, col), in fg/bg + bold.
  Text { content: utf8  row: i64  col: i64  fg: utf8?  bg: utf8?  bold: bool? }
  // Content-origin slot: a container's child blocks are drawn here, at
  // (row, col) local to the container. The renderer recurses each child
  // (primitive or widget) with this origin as its base.
  Children { row: i64  col: i64 }
}

// Extend `TermPrimitive` to author a control. Its `lower` returns the
// `TermFundamental` styled-text runs it draws; the terminal/container slot
// is what makes the instance placeable, not a second widget interface.

// ── Text helpers ──────────────────────────────────────────────────────
// Shared composition fns. Every higher-level element builds its output
// from these, so styled text is the only thing the renderer draws.

// A `Text` run constructor (the ergonomic form — the renderer-only flags
// stay `none`). Pass `none` for fg/bg to follow the terminal's theme.
let term_run = fn(content: utf8, row: i64, col: i64, fg: utf8, bg: utf8, bold: bool) -> TermFundamental
  TermFundamental::Text { content: content, row: row, col: col, fg: fg, bg: bg, bold: bold }

// `ch` repeated `n` times (`n < 1` ⇒ empty, so callers needn't guard).
let term_repeat = fn(ch: utf8, n: i64) -> utf8
  if n < 1 { "" } else { join(map(range(0, n), fn(i: i64) -> utf8 ch), "") }

// Box-drawing glyphs for a border style, as [tl, tr, bl, br, horiz, vert].
// Unknown / unset ⇒ `:single`.
let term_border = fn(style: symbol) -> list<utf8>
  if style == :double { ["╔", "╗", "╚", "╝", "═", "║"] }
  else { if style == :rounded { ["╭", "╮", "╰", "╯", "─", "│"] }
  else { if style == :heavy { ["┏", "┓", "┗", "┛", "━", "┃"] }
  else { if style == :ascii { ["+", "+", "+", "+", "-", "|"] }
  else { ["┌", "┐", "└", "┘", "─", "│"] } } } }

// A w×h rectangle of a repeated char, as `h` text rows from (row, col).
let term_fill_runs = fn(ch: utf8, row: i64, col: i64, w: i64, h: i64, fg: utf8, bg: utf8, bold: bool) -> list<TermFundamental> {
  let line = term_repeat(ch, w);
  if h < 1 { [] }
  else { map(range(0, h), fn(r: i64) -> TermFundamental term_run(line, row + r, col, fg, bg, bold)) }
}

// A w×h border box (+ optional title on the top edge) as text runs from
// (row, col): a top and bottom edge, and a vertical on each side of every
// interior row. Sizes below 2 collapse gracefully (no negative repeats).
let term_box_runs = fn(row: i64, col: i64, w: i64, h: i64, border: symbol, title: utf8, fg: utf8, bg: utf8, bold: bool) -> list<TermFundamental> {
  let g  = term_border(border);
  let tl = at(g, 0);  let tr = at(g, 1);  let bl = at(g, 2);  let br = at(g, 3);
  let hz = at(g, 4);  let vt = at(g, 5);
  let mid = term_repeat(hz, w - 2);
  let top = term_run(format("{}{}{}", tl, mid, tr), row, col, fg, bg, bold);
  let bot = term_run(format("{}{}{}", bl, mid, br), row + h - 1, col, fg, bg, bold);
  let sides = if h > 2 {
    flatten(map(range(1, h - 1), fn(r: i64) -> list<TermFundamental> [
      term_run(vt, row + r, col, fg, bg, bold),
      term_run(vt, row + r, col + w - 1, fg, bg, bold),
    ]))
  } else { [] };
  let title_part = if title == none { [] } else { [ term_run(title, row, col + 2, fg, bg, bold) ] };
  flatten([ [top], [bot], sides, title_part ])
}

// ── Box / fill / glyph elements ───────────────────────────────────────
// The former hardcoded primitives, now authored elements that decompose
// to styled text. Same names + fields as before; the renderer no longer
// special-cases them.

// A bordered box: :single (default) :double :rounded :heavy :ascii.
@block("term_box")
type TermBox extends TermPrimitive {
  row: i64  col: i64
  @doc("Box width in cells.")
  width: i64
  @doc("Box height in cells.")
  height: i64
  @doc("Border style: `:single` (default) / `:double` / `:rounded` / `:heavy` / `:ascii`.")
  border: symbol?
  @doc("Optional title drawn into the top border.")
  title: utf8?
  @doc("Foreground colour.")
  fg: utf8?
  @doc("Background colour.")
  bg: utf8?
  @doc("Bold style.")
  bold: bool?
  lower = fn(b: TermBox) -> list<TermFundamental>
    term_box_runs(1, 1, b.width, b.height, b.border, b.title, b.fg, b.bg, b.bold)
}

// A run of text (may contain `\n`) at (row, col) — convenience alias for
// a single styled-text fundamental.
@block("term_glyph")
type TermGlyph extends TermPrimitive {
  @doc("The text run (may contain `\\n`), `@inline(0)`.")
  @inline(0) glyph: utf8
  row: i64  col: i64
  @doc("Foreground colour.")
  fg: utf8?
  @doc("Background colour.")
  bg: utf8?
  @doc("Bold style.")
  bold: bool?
  lower = fn(g: TermGlyph) -> list<TermFundamental>
    [ term_run(g.glyph, 1, 1, g.fg, g.bg, g.bold) ]
}

// Fill a rectangular region with a repeated char (label's first run).
@block("term_fill")
type TermFill extends TermPrimitive {
  @doc("The fill character (`@inline(0)`).")
  @inline(0) ch: utf8
  row: i64  col: i64
  @doc("Region width in cells.")
  width: i64
  @doc("Region height in cells.")
  height: i64
  @doc("Foreground colour.")
  fg: utf8?
  @doc("Background colour.")
  bg: utf8?
  @doc("Bold style.")
  bold: bool?
  lower = fn(f: TermFill) -> list<TermFundamental>
    term_fill_runs(f.ch, 1, 1, f.width, f.height, f.fg, f.bg, f.bold)
}

// ── Leaf widgets ──────────────────────────────────────────────────────

// A progress bar: filled cells in `accent`, the remainder in `muted`,
// with an optional leading label and a trailing `NN%`. `value` is a
// percentage of `max` (default 100); `width` is the bar length in cells.
@block("tui_progress")
type TuiProgress extends TermPrimitive {
  @doc("Optional `@inline` caption to the left of the bar.")
  @inline(0) label: utf8?
  @doc("Filled amount (clamped to `0`..`max`).")
  value:      i64
  @doc("Scale maximum (default `100`).")
  max:        i64?
  @doc("Bar width in cells (default `24`).")
  width:      i64?
  @doc("Append a `NN%` readout (default `true`).")
  show_value: bool?
  @doc("Fill colour.")
  accent:     utf8?
  @doc("Track colour.")
  muted:      utf8?
  row: i64  col: i64
  lower = fn(p: TuiProgress) -> list<TermFundamental> {
    let mx  = if p.max == none { 100 } else { if p.max < 1 { 1 } else { p.max } };
    let w   = if p.width == none { 24 } else { if p.width < 1 { 1 } else { p.width } };
    let acc = if p.accent == none { "green" } else { p.accent };
    let trk = if p.muted == none { "bright_black" } else { p.muted };
    let v   = if p.value < 0 { 0 } else { if p.value > mx { mx } else { p.value } };
    let filled = v * w / mx;
    let empty  = w - filled;
    let bar_col = if p.label == none { 1 } else { len(p.label) + 2 };
    let label_part = if p.label == none { [] }
      else { [ term_run(p.label, 1, 1, none, none, none) ] };
    let fill_part = if filled > 0 { [ term_run(term_repeat("█", filled), 1, bar_col, acc, none, none) ] } else { [] };
    let track_part = if empty > 0 { [ term_run(term_repeat("░", empty), 1, bar_col + filled, trk, none, none) ] } else { [] };
    let value_part = if p.show_value == false { [] }
      else { [ term_run(format("{}%", v * 100 / mx), 1, bar_col + w + 1, none, none, true) ] };
    flatten([ label_part, fill_part, track_part, value_part ])
  }
}

// A button: the label centred on a solid `accent`-coloured cell run, in
// the contrasting `fg`. Colour defines the button — no border glyphs.
@block("tui_button")
type TuiButton extends TermPrimitive {
  @doc("Button text (`@inline`).")
  @inline(0) label: utf8
  @doc("Total width (default = label + padding).")
  width:  i64?
  @doc("Fill colour (default `blue`).")
  accent: utf8?
  @doc("Label colour (default `bright_white`).")
  fg:     utf8?
  row: i64  col: i64
  lower = fn(b: TuiButton) -> list<TermFundamental> {
    let acc = if b.accent == none { "blue" } else { b.accent };
    let txt = if b.fg == none { "bright_white" } else { b.fg };
    let ll  = len(b.label);
    let w   = if b.width == none { ll + 4 } else { b.width };
    let pad = (w - ll) / 2;
    let lcol = if pad < 1 { 2 } else { pad + 1 };
    [
      term_run(term_repeat(" ", w), 1, 1, none, acc, none),
      term_run(b.label, 1, lcol, txt, acc, true),
    ]
  }
}

// A spinner. A document is static, so this draws one frame (pick it with
// `frame`); the `kind` picks the glyph set. `:dots` (braille, default),
// `:circle`, or `:line`.
@block("tui_spinner")
type TuiSpinner extends TermPrimitive {
  @doc("Optional `@inline` caption after the frame.")
  @inline(0) label: utf8?
  @doc("Which frame index to show (default `0`).")
  frame:  i64?
  @doc("Glyph set: `:dots`/`:braille` (default) / `:circle` / `:line`.")
  kind:   symbol?
  @doc("Frame colour.")
  accent: utf8?
  row: i64  col: i64
  lower = fn(s: TuiSpinner) -> list<TermFundamental> {
    let acc = if s.accent == none { "cyan" } else { s.accent };
    let f   = if s.frame == none { 0 } else { if s.frame < 0 { 0 } else { s.frame } };
    let frames = if s.kind == :circle { ["◐", "◓", "◑", "◒"] }
      else { if s.kind == :line { ["|", "/", "—", "\\"] }
      else { ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"] } };
    let g = at(frames, f % len(frames));
    let glyph_part = [ term_run(g, 1, 1, acc, none, true) ];
    let label_part = if s.label == none { [] }
      else { [ term_run(s.label, 1, 3, none, none, none) ] };
    flatten([ glyph_part, label_part ])
  }
}

// A single-line input. An `accent` left bar, then the `value` (solid) or
// the `placeholder` (muted) — plus a cursor when `focused`.
@block("tui_input")
type TuiInput extends TermPrimitive {
  @doc("Muted prompt shown when empty (`@inline`).")
  @inline(0) placeholder: utf8
  @doc("Current text (overrides the placeholder).")
  value:   utf8?
  @doc("Draw a trailing cursor.")
  focused: bool?
  @doc("Bar / cursor colour.")
  accent:  utf8?
  row: i64  col: i64
  lower = fn(i: TuiInput) -> list<TermFundamental> {
    let acc   = if i.accent == none { "blue" } else { i.accent };
    let shown = if i.value == none { i.placeholder } else { i.value };
    let txtfg = if i.value == none { "bright_black" } else { none };
    let bar  = [ term_run("▏", 1, 1, acc, none, true) ];
    let text = [ term_run(shown, 1, 3, txtfg, none, none) ];
    let cur = if i.focused == true { [ term_run("▏", 1, 3 + len(shown), acc, none, true) ] } else { [] };
    flatten([ bar, text, cur ])
  }
}

// A dropdown: the selected `text` with a coloured chevron to its right
// (`▴` when `open`, else `▾`). When `open` and `items` are supplied, the
// option list drops down below the field — one colour-filled row per
// item, the `selected` one in the accent colour (defaulting to the item
// equal to `text`).
@block("tui_dropdown")
type TuiDropdown extends TermPrimitive {
  @doc("Selected / shown label (`@inline`).")
  @inline(0) text: utf8
  @doc("Option list shown below the field when `open`.")
  items:    list<utf8>?
  @doc("Highlighted item index (default: the item equal to `text`).")
  selected: i64?
  @doc("Field width (default: fits the label and longest item).")
  width:    i64?
  @doc("Drop the list down (and flip the caret).")
  open:     bool?
  @doc("Caret + selected-row colour.")
  accent:   utf8?
  row: i64  col: i64
  lower = fn(d: TuiDropdown) -> list<TermFundamental> {
    let acc   = if d.accent == none { "blue" } else { d.accent };
    let items = if d.items == none { [] } else { d.items };
    // Width fits the label and the longest item (+3 for padding + caret),
    // unless an explicit `width` is given. (`max` returns f64, so fold a
    // plain i64 comparison instead.)
    let longest = fold(items, len(d.text),
      fn(a: i64, it: utf8) -> i64 if len(it) > a { len(it) } else { a });
    let w    = if d.width == none { longest + 3 } else { d.width };
    let chev = if d.open == true { "▴" } else { "▾" };
    let field = [
      term_run(d.text, 1, 1, none, none, none),
      term_run(chev, 1, w, acc, none, true),
    ];
    // `selected` defaults to the item equal to the field's `text`
    // (`index_of` → -1 when absent, i.e. nothing highlighted).
    let sel = if d.selected == none { index_of(items, d.text) } else { d.selected };
    let list_part = if d.open == true {
      flatten(map(range(0, len(items)), fn(i: i64) -> list<TermFundamental> {
        let is_sel = i == sel;
        let bg = if is_sel { acc } else { "bright_black" };
        let fg = if is_sel { "bright_white" } else { none };
        flatten([
          term_fill_runs(" ", 2 + i, 1, w, 1, none, bg, none),
          [ term_run(at(items, i), 2 + i, 2, fg, bg, is_sel) ],
        ])
      }))
    } else { [] };
    flatten([ field, list_part ])
  }
}

// A checkbox: a filled `■` (accent) when `checked`, else an empty `□`
// (muted), followed by the label.
@block("tui_checkbox")
type TuiCheckbox extends TermPrimitive {
  @doc("Checkbox caption (`@inline`).")
  @inline(0) label: utf8
  @doc("On/off state.")
  checked: bool?
  @doc("Checked colour.")
  accent:  utf8?
  @doc("Unchecked colour.")
  muted:   utf8?
  row: i64  col: i64
  lower = fn(c: TuiCheckbox) -> list<TermFundamental> {
    let on  = c.checked == true;
    let acc = if c.accent == none { "green" } else { c.accent };
    let mut = if c.muted == none { "bright_black" } else { c.muted };
    let mark = if on { "■" } else { "□" };
    let mfg  = if on { acc } else { mut };
    [
      term_run(mark, 1, 1, mfg, none, true),
      term_run(c.label, 1, 3, none, none, none),
    ]
  }
}

// A radio selector: a filled `◉` (accent) when `selected`, else an empty
// `○` (muted), followed by the label.
@block("tui_radio")
type TuiRadio extends TermPrimitive {
  @doc("Radio caption (`@inline`).")
  @inline(0) label: utf8
  @doc("Whether this option is chosen.")
  selected: bool?
  @doc("Selected colour.")
  accent:   utf8?
  @doc("Unselected colour.")
  muted:    utf8?
  row: i64  col: i64
  lower = fn(r: TuiRadio) -> list<TermFundamental> {
    let on  = r.selected == true;
    let acc = if r.accent == none { "green" } else { r.accent };
    let mut = if r.muted == none { "bright_black" } else { r.muted };
    let dot = if on { "◉" } else { "○" };
    let dfg = if on { acc } else { mut };
    [
      term_run(dot, 1, 1, dfg, none, true),
      term_run(r.label, 1, 3, none, none, none),
    ]
  }
}

// ── Container widgets ─────────────────────────────────────────────────
// Each holds `@children(TermPrimitive)` (primitives OR other widgets) and
// emits a `Children` slot marking where they're drawn. Children carry
// their own (relative) `row`/`col` within the container's content area.

// A bordered panel with an optional title. Children sit inside the
// border (content origin at local row 2, col 2).
@block("tui_panel")
type TuiPanel extends TermPrimitive {
  @doc("Optional heading drawn into the top border.")
  title:  utf8?
  @doc("Box width in cells.")
  width:  i64
  @doc("Box height in cells.")
  height: i64
  @doc("Border style: `:rounded` (default) / `:single` / `:double` / `:heavy` / `:ascii`.")
  border: symbol?
  @doc("Border colour.")
  accent: utf8?
  row: i64  col: i64
  @doc("`TermPrimitive` children, positioned relative to the panel.")
  @children(TermPrimitive) children: list<TermPrimitive>
  lower = fn(p: TuiPanel) -> list<TermFundamental> {
    let bdr = if p.border == none { :rounded } else { p.border };
    let acc = if p.accent == none { "bright_black" } else { p.accent };
    flatten([
      term_box_runs(1, 1, p.width, p.height, bdr, p.title, acc, none, none),
      [ TermFundamental::Children { row: 2, col: 2 } ],
    ])
  }
}

// A borderless group with an optional heading. Children sit below the
// heading (or at the origin when there is none).
@block("tui_group")
type TuiGroup extends TermPrimitive {
  @doc("Optional heading above the children.")
  title: utf8?
  row: i64  col: i64
  @doc("`TermPrimitive` children, positioned relative to the group.")
  @children(TermPrimitive) children: list<TermPrimitive>
  lower = fn(g: TuiGroup) -> list<TermFundamental> {
    let title_part = if g.title == none { [] }
      else { [ term_run(g.title, 1, 1, none, none, true) ] };
    let body_row = if g.title == none { 1 } else { 2 };
    flatten([ title_part, [ TermFundamental::Children { row: body_row, col: 1 } ] ])
  }
}
