// ── Stdlib footnotes ───────────────────────────────────────────────
//
// A page collects its footnote definitions in a `footnotes` block (near
// the end of the page); each `footnote` carries an `id` and `text`. In
// prose, a `[^id]` reference links to the matching definition — the
// renderer numbers references by definition order and rewrites each into a
// superscript `<sup class="footnote-ref">` linking down to the note, with a
// `↩` back-link up to the reference. Only references whose `id` has a
// definition are rewritten, so a literal `[^…]` in a code sample (a regex
// character class) is left untouched.

namespace wdoc

@block("footnote")
type Footnote extends WdocBlock {
  @doc("The footnote id (its inline label slot) — the `[^id]` reference target.")
  @inline(0) id: identifier
  @doc("The footnote text; inline patterns (`**bold**`, `[links](…)`) apply.")
  text: utf8
  // Rendered by the parent `footnotes` block.
  lower = fn(f: Footnote) -> list<HtmlFundamental> []
}

@block("footnotes")
type Footnotes extends WdocBlock {
  @doc("The footnote definitions, in number order.")
  @children("footnote") items: list<Footnote>
  lower = fn(f: Footnotes) -> list<HtmlFundamental> [
    HtmlFundamental::Element {
      tag: "section", id: none, class: ["footnotes"], attrs: none,
      children: [
        HtmlFundamental::Element {
          tag: "div", id: none, class: ["footnotes-title"], attrs: none,
          children: [ HtmlFundamental::Raw { html: "Footnotes" } ],
        },
        HtmlFundamental::Element {
          tag: "ol", id: none, class: ["footnote-list"], attrs: none,
          children: map(f.items, footnote_item),
        },
      ],
    },
  ]
}

// One footnote `<li id="fn-ID">`: the note body (inline patterns apply) and
// a `↩` back-link to its reference. The id rides `attrs` (a computed utf8),
// not the `identifier?` id slot.
let footnote_item = fn(f: Footnote) -> HtmlFundamental
  HtmlFundamental::Element {
    tag: "li", id: none, class: ["footnote-item"],
    attrs: [["id", format("fn-{}", f.id)]],
    children: [
      HtmlFundamental::Inline { text: f.text },
      HtmlFundamental::Raw {
        html: format(" <a class=\"footnote-back\" href=\"#fnref-{}\">↩</a>", f.id),
      },
    ],
  }

// Footnotes styling; colours come from the theme apply rules.
stylesheet "wdoc-footnotes" {
  css = <<CSS
    .footnotes { margin-top: 3rem; padding-top: 1.2rem; font-size: 0.9rem; }
    .footnotes-title { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.6rem; }
    .footnote-list { margin: 0; padding-left: 1.4rem; }
    .footnote-item { margin-bottom: 0.4rem; }
    .footnote-back { text-decoration: none; border: none; margin-left: 0.3rem; }
    .footnote-ref { font-size: 0.75em; line-height: 0; }
    .footnote-ref a { border: none; padding: 0 0.1em; }
    CSS
}
