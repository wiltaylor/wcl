// ── Stdlib footnotes ───────────────────────────────────────────────
//
// A page collects its footnote definitions in a `footnotes` block (near
// the end of the page); each `footnote` carries an `id` and `text`. In
// prose, a `[^id]` reference links to the matching definition — the
// renderer numbers references by definition order and rewrites each into a
// superscript `<sup class="footnote-ref">` linking down to the note, with a
// `↩` back-link up to the reference. Only references whose `id` has a
// definition are rewritten, so a literal `[^…]` in a code sample (a regex
// character class) is left untouched.
//
// The block lowers to a `Content::Footnotes` — the semantic content IR's
// apparatus node, carrying the section title and the resolved notes. Each
// note's `marker` is its `id`, which is the key the link is anchored on:
// the HTML backend anchors the item at `fn-<marker>`, which is exactly
// what the `[^id]` rewrite looks for, and the Markdown backend emits
// `[^marker]: …`, a real GFM footnote label. (A `[^id]` *reference* in
// prose still escapes on the Markdown target: the inline engine can't
// tell one from a regex character class without the page's definitions
// — the same fact that makes the HTML rewrite conditional.) Before this,
// the section was `Element` / `Raw` markup: the "Footnotes" title and the
// `<ol>` numbering were HTML chrome, and outside the book the notes fell
// out as bare paragraphs.

namespace wdoc

// A single definition. Not a `ContentBlock`: it never renders on its own —
// the parent `footnotes` block's `lower` maps it into one entry of the
// content node — so it has neither a lowering of its own nor a native
// implementation, exactly like an `li` under a `list`.
@block("footnote")
type Footnote {
  @doc("The footnote id (its inline label slot) — the `[^id]` reference target.")
  @inline(0) id: identifier
  @doc("The footnote text; inline patterns (`**bold**`, `[links](…)`) apply.")
  text: utf8
}

@block("footnotes")
type Footnotes extends ContentBlock {
  @doc("The footnote definitions, in number order.")
  @children("footnote") items: list<Footnote>
  lower = fn(f: Footnotes) -> list<Content> [
    Content::Footnotes {
      title: "Footnotes",
      notes: map(f.items, resolve_footnote),
    },
  ]
}

// A definition, resolved into the IR's note. The `marker` is the
// definition's `id` — the key both ends of the link are anchored on, and a
// real GFM footnote label in the Markdown output.
// (Parenthesised: a `{` straight after the return type opens a block
// expression, so the record literal needs the parens to be read as one.)
let resolve_footnote = fn(n: Footnote) -> ContentFootnote
  ({ marker: format("{}", n.id), text: n.text })

// Footnotes styling; colours come from the theme apply rules. The class
// names are the ones the content IR's HTML reading emits
// (`render/content_html.rs`), not names authored here.
class "wdoc-footnotes" { css = "margin-top: 3rem; padding-top: 1.2rem; font-size: 0.9rem;" }
class "wdoc-footnotes-title" { css = "font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.6rem;" }
class "wdoc-footnote-list" { css = "margin: 0; padding-left: 1.4rem;" }
class "wdoc-footnote-item" { css = "margin-bottom: 0.4rem;" }
class "wdoc-footnote-back" { css = "text-decoration: none; border: none; margin-left: 0.3rem;" }
class "footnote-ref" { css = "font-size: 0.75em; line-height: 0;" }
class "footnote-ref" {
  nest "a" { css = "border: none; padding: 0 0.1em;" }
}
