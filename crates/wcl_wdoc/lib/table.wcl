// Tabular grid. Rows are authored with WCL's native pipe-table
// syntax under a `rows:` header; the first row is the table header.
//
//   table {
//     rows:
//       | "Name"  | "Role" | "Age" |   // -> <thead>/<th>
//       | "Alice" | "Dev"  | 30     |   // -> <tbody>/<td>
//   }
//
// Cells may hold any literal: utf8 cells are run through the inline
// pattern engine (so **bold**, _italic_, `code`, [links](page) work),
// other types (numbers, bools, symbols) are stringified. The block
// deliberately declares no `rows` field — the pipe rows arrive as a
// syntactic `Item::Table` the renderer reads via `Block::tables()`,
// so tables can be any width with no per-table type. `table` is a
// fundamental HTML block (rendered directly), so its `lower` is never
// invoked — declared only to satisfy the WdocBlock interface.
// Named `TableBlock` (not `Table`) because `Table` is the reserved
// type name for the `@table` decorator. The block kind is still
// "table".
@block("table")
type TableBlock extends WdocBlock {
  id:    identifier?
  class: list<utf8>?
  lower = fn(t: TableBlock) -> list<HtmlFundamental> []
}

// Default table styling, injected into every page's <head> (before user
// `class` rules, so those still override it). Keeps tables legible out of
// the box without forcing every author to declare a border class. Uses
// element+class (`table.wdoc-table`) and descendant (`.wdoc-table th`)
// selectors, so it can't be a bare `class`.
stylesheet "wdoc-table" {
  css = <<CSS
    table.wdoc-table { border-collapse: collapse; }
    .wdoc-table th, .wdoc-table td { border: 1px solid #ccc; padding: 0.3rem 0.6rem; text-align: left; }
    .wdoc-table th { background: #f4f4f4; }
    CSS
}

