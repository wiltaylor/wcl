// Tabular grid, authored one of two ways.
//
// 1. **Pipe-table syntax** under a `rows:` header — the first row is the
//    table header:
//
//   table {
//     rows:
//       | "Name"  | "Role" | "Age" |   // -> <thead>/<th>
//       | "Alice" | "Dev"  | 30     |   // -> <tbody>/<td>
//   }
//
// 2. **Computed rows** — for a data-driven table, set the `rows` field to
//    a list of cell-lists (e.g. `map`ped from a data structure) and an
//    optional `header` row. This composes with components: a `wdoc_slot`
//    can feed `rows`.
//
//   table {
//     header = ["Name", "Role"]
//     rows = map(people, fn(p: Person) -> list<utf8> { [p.name, p.role] })
//   }
//
// The two forms don't mix — when a `rows` field is present the computed
// path wins and any pipe rows are ignored. Cells may hold any scalar:
// utf8 cells run through the inline pattern engine (so **bold**,
// _italic_, `code`, [links](page), `:icons:` work), other types
// (numbers, bools, symbols) are stringified. `table` is a fundamental
// HTML block: `@native`, rendered directly. Named `TableBlock`
// (not `Table`) because `Table` is the reserved type name for the
// `@table` decorator. The block kind is still "table".
namespace wdoc

@block("table")
@native
type TableBlock extends WdocBlock {
  @doc("Optional explicit HTML id.")
  id:     identifier?
  @doc("Optional class list applied to the `<table>` (e.g. to override `wdoc-table`).")
  class:  list<utf8>?
  // Computed-table form (alternative to pipe rows). `header` is the
  // heading row (omit for a header-less table); `rows` are the body
  // rows, each a list of cells.
  @doc("Optional header row for the computed-table form (omit for a header-less table).")
  header: list<utf8>?
  @doc("The pipe-row data (or computed rows) — with pipe syntax the first row is the header, the rest are body rows.")
  // `@schemaless`: computed cells may hold any scalar (stringified at
  // render time), so the value-vs-type check stays out of the way.
  @schemaless rows: list<list<utf8>>?
}

// Default table styling, injected into every page's <head> (before user
// `class` rules, so those still override it). Keeps tables legible out of
// the box without forcing every author to declare a border class. Uses
// element+class (`table.wdoc-table`) and descendant (`.wdoc-table th`)
// selectors, so it can't be a bare `class`.
stylesheet "wdoc-table" {
  css = <<CSS
    table.wdoc-table { border-collapse: separate; border-spacing: 0; border: 1px solid #ccc; border-radius: 8px; overflow: hidden; }
    .wdoc-table th, .wdoc-table td { border-bottom: 1px solid #ccc; padding: 0.45rem 0.7rem; text-align: left; }
    .wdoc-table tr:last-child td { border-bottom: none; }
    .wdoc-table th { background: #f4f4f4; font-size: 0.8em; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
    .wdoc-badge { display: inline-block; padding: 0.1em 0.6em; border-radius: 999px; font-size: 0.8em; font-weight: 600; }
    CSS
}

