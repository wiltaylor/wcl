// ── Maps (zoomable, pinned game-guide maps) ────────────────────────
//
// A `map` is a placeable shape inside a `diagram`: a (usually single)
// image you can pan + zoom, with `pin` markers dropped at coordinates.
// Each pin is an icon in a chosen colour; clicking it opens a floating
// card of arbitrary wdoc content anchored to the pin. Large maps may
// supply several tiled images at different zoom levels (`layer`s) — the
// renderer shows the sharpest layer that suits the current zoom.
//
// Like `tilemap` / `image`, the `map` is `@native`: the tile crops, the
// icon `<use>`s, and the
// HTML cards overlaid on the SVG can't be expressed in WCL. A diagram
// containing a map is automatically interactive (pan + zoom) and loads
// the bundled `wdoc-map.js`. Tile / image assets are copied into
// `_wdoc/` and referenced by URL, so a map resolves when *served*, not
// when opened directly from disk (same limitation as `image` / `tilemap`).
//
// Theming rides the `class` system: a pin's `class` themes its marker
// (`fill` / `stroke` / `color`, with `dark` / `light`), its `card_class`
// themes the popup (`background` / `color` / `border`), and the map's
// `class` themes the group. The built-in look ships as bare-class
// defaults in the structured rules below (so user `class`es override) that
// read `var(--wdoc-*)`, so a themed site styles maps for free.
namespace wdoc

@block("map")
@native
type Map extends SvgBlock {
  @doc("Optional reference name (the inline label).")
  @inline(0) name: identifier?       // optional reference name
  @doc("Single whole-map image (the common, layer-less case).")
  source:    utf8?                   // single whole-map image (common case)
  @doc("Map coordinate-space width — also the pin coordinate space.")
  width:     f64                     // map coordinate space (also the pin coords)
  @doc("Map coordinate-space height — also the pin coordinate space.")
  height:    f64                     // "
  @doc("Tile pixel size for tiled layers (default `256`).")
  tile_size: i64?                    // tile pixel size for tiled layers (default 256)
  @doc("`image-rendering: smooth` (default) vs `pixelated` when `false`.")
  smooth:    bool?                   // image-rendering: smooth (default) vs pixelated
  @doc("Themes the map group.")
  class:     list<utf8>?             // themes the map group
  @doc("Optional explicit HTML id.")
  id: identifier?

  // Placement in the parent diagram (fixed-size, like image / tilemap).
  @doc("Placement x within the enclosing `diagram` / `container`.")
  x = 0.0
  @doc("Placement y within the enclosing `diagram` / `container`.")
  y = 0.0
  @doc("Diagram anchor insets (left/right/top/bottom), like any `SvgBlock`.")
  anchor_left: f64?
  @hidden anchor_right: f64?
  @hidden anchor_top: f64?
  @hidden anchor_bottom: f64?
  @doc("Diagram edge-attach sides, like any `SvgBlock`.")
  connect_points: list<AnchorSide>?

  @doc("Level-of-detail image layers (omit for a single `source`).")
  @children("layer") layers: list<MapLayer>?
  @doc("Clickable markers with cards.")
  @children("pin")   pins:   list<MapPin>?
}

// One level-of-detail layer. Omit `layer`s entirely for the common
// single-image case (the map's `source` becomes the only layer). A
// layer is a single image when `cols` / `rows` are 1 (the default), or
// a grid of tiles otherwise: `source` is then a folder and each tile's
// filename comes from `pattern` (default `{x}_{y}.png`, 0-based). The
// renderer auto-selects the sharpest layer for the current zoom.
@block("layer")
type MapLayer {
  @doc("Image file, or the tile folder when tiled.")
  source:    utf8                    // image file, or tile folder when tiled
  @doc("Tiles across (default `1` = a single image).")
  cols:      i64?                    // tiles across (default 1 = single image)
  @doc("Tiles down (default `1`).")
  rows:      i64?                    // tiles down  (default 1)
  @doc("Tile filename pattern (default `{x}_{y}.png`, 0-based).")
  pattern:   utf8?                   // tile filename pattern (default "{x}_{y}.png")
  @doc("Override the map's `tile_size` for this layer.")
  tile_size: i64?                    // override the map's tile_size
}

// A clickable marker on the map. Positioned at `x` / `y` in the map's
// coordinate space. The `id` links the pin to its card and must be
// unique on the page. `icon` is an icon name (optionally `set.name`,
// default `lucide.map-pin`); style it with `class` (recommended, themable)
// or the one-off `color` sugar. The card body is the pin's child blocks.
@block("pin")
type MapPin {
  @doc("Pin id (the inline label) — links the pin to its card; page-unique.")
  @inline(0) id: identifier          // pin id (links pin <-> card; page-unique)
  @doc("Marker x position, in the map's coordinate space.")
  x: f64
  @doc("Marker y position, in the map's coordinate space.")
  y: f64                             // position in map coordinates
  @doc("Icon name (default `lucide.map-pin`); `set.name` or pair with `set`.")
  icon:  utf8?                       // icon name (default "lucide.map-pin")
  @doc("Iconset name for a bare `icon`.")
  set:   identifier?                 // which iconset (for a bare name)
  @doc("Marker size in map units (default `24`).")
  size:  f64?                        // marker size in map units (default 24)
  @doc("Themes the marker (`fill` / `stroke` / `color`, with `dark` / `light`).")
  class:      list<utf8>?            // themes the marker (fill/stroke/color)
  @doc("Themes the card popup (`background` / `color` / `border`).")
  card_class: list<utf8>?            // themes the card popup (background/color/border)
  @doc("One-off inline marker colour (sugar for a class).")
  color:      utf8?                  // one-off inline marker colour
  @doc("Optional card heading.")
  title: utf8?                       // optional card heading
  @doc("The card body — any wdoc blocks.")
  @children(ContentBlock) card: list<ContentBlock>
}

// Default map styling. Bare-class selectors so user `class`es win, with
// neutral defaults and no `var(--wdoc-*)` (so a `site`-less doc stays
// unthemed); a themed site recolours `.wdoc-map-card` via the theme apply
// rules in render/theme.rs. Holds only what a bare `class` can't express
// (position / shadow / cursor / the [hidden] toggle / the close button /
// image-rendering).
class "wdoc-map" {
  nest "image" { css = "pointer-events: none; user-select: none; -webkit-user-drag: none;" }
}
class "wdoc-map" {
  nest "&.pixelated image" { css = "image-rendering: pixelated;" }
}
class "wdoc-map-pin" { css = "cursor: pointer;" }
class "wdoc-map-card" { css = "position: absolute; box-sizing: border-box; max-width: 17rem; z-index: 5;\n  padding: 0.55rem 0.7rem; border-radius: 6px; font-size: 0.9rem; line-height: 1.4;\n  border: 1px solid #444; background: #262b33; color: #e6e6e6;\n  box-shadow: 0 4px 18px rgba(0,0,0,0.35);" }
class "wdoc-map-card" {
  nest "&[hidden]" { css = "display: none;" }
}
class "wdoc-map-card" {
  nest "> :first-child" { css = "margin-top: 0;" }
}
class "wdoc-map-card" {
  nest "> :last-child" { css = "margin-bottom: 0;" }
}
class "wdoc-map-card-title" { css = "font-weight: 600; margin: 0 1.2rem 0.3rem 0;" }
class "wdoc-map-card-close" { css = "position: absolute; top: 2px; right: 4px; padding: 0; line-height: 1;\n  font: inherit; font-size: 0.95rem; color: inherit; cursor: pointer;\n  background: none; border: none; opacity: 0.55;" }
class "wdoc-map-card-close" {
  nest "&:hover" { css = "opacity: 1;" }
}
