// wdoc standard library — guided answer mode (`import <answer.wcl>`).
//
// Answer mode is a *respondent* experience over documents that track
// interview-style questions as blocks: walk the pending questions, take
// answers, flip statuses — never show the respondent raw WCL. It is generic
// and schema-driven: any `@block` type opts in by tagging itself
// `@answerable(...)`, mapping the answer-mode roles onto its own field names:
//
//   @answerable(prompt = "question", response = "answer",
//               status = "status", pending = :open, resolved = :answered,
//               skipped = :dropped)
//   @block("question")
//   type PlanQuestion {
//     @inline(0) id: identifier
//     question: utf8
//     @default(:open) status: symbol
//     answer: utf8?
//     kind: symbol?    // :single_select | :multi_select | :free_text
//     @children("option") options: list<answer::AnswerOption>
//   }
//
// A question whose status field equals `pending` is *open*. Answering writes
// the composed answer into the `response` field and sets the status to
// `resolved`; skipping (only offered when `skipped` is declared) sets the
// status to `skipped` and leaves the response untouched.
//
// Choices: a question may carry option child blocks (kind named by the
// `options` argument, default "option") and a selection kind (field named by
// the `kind` argument, default "kind"): :single_select, :multi_select or
// :free_text. When the kind field is omitted, a question with options is
// :single_select and one without is :free_text. Every choice question always
// also offers a free-text "other" input — options accelerate the common case,
// they never constrain the answer. Selections land in the single response
// field as prose (picked labels joined with ", ", typed text appended), so
// downstream consumers only ever read one utf8 field.
//
// Consumed by `wcl answer <file>` (terminal walk-through), which writes
// through the validating edit pipeline one question at a time, so an
// interrupted session loses nothing. Read by `crates/wcl/src/answer.rs`.

namespace answer

@decorator("answerable")
type Answerable {
  prompt: utf8      // field holding the question text
  response: utf8    // field the composed answer is written into
  status: utf8      // field holding the status symbol
  pending: symbol   // status meaning "needs an answer"
  resolved: symbol  // status written after an answer lands
  skipped: symbol?  // status written on skip; omit to disable skipping
  kind: utf8?       // field naming the selection kind (default "kind")
  options: utf8?    // child-block kind holding the choices (default "option")
}

// A ready-made option child block for choice questions. A schema can use it
// directly (`@children("option") options: list<answer::AnswerOption>`) or
// declare its own — answer mode only needs the child kind plus a `label`
// field (falling back to the option's id).
@block("option")
type AnswerOption {
  @inline(0) id: identifier
  label: utf8?    // display label; defaults to the id
  note: utf8?     // optional respondent-facing hint
}
