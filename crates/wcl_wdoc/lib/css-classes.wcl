// Bundled default `class` instances. These migrate styling that used to
// live as Rust string constants in `render.rs` into the class system, so
// the renderer themes them the same way it themes user classes. Because
// this schema is prepended to the user's source, these emit BEFORE any
// user `class` block — a user `class "wdoc-series-1" { fill = … }` still
// wins by cascade. Only rules expressible as a single bare `.name`
// selector with allowlisted properties live here; selector-, at-rule-,
// or custom-property-dependent CSS stays in `render.rs` (see the comment
// above the remaining constants there).
//
// Chart series palette + axes / gridlines / labels / title / legend /
// line. Axes etc. paint with `currentColor` so they follow the page
// theme; the eight-hue palette carries explicit `fill` + `stroke`.
namespace wdoc

class "wdoc-axis"        { stroke = "currentColor"  opacity = "0.45" }
class "wdoc-grid"        { stroke = "currentColor"  opacity = "0.12" }
class "wdoc-axis-label"  { fill = "currentColor"  opacity = "0.75" }
class "wdoc-chart-title" { fill = "currentColor"  bold = true }
class "wdoc-legend"      { fill = "currentColor"  opacity = "0.85" }
class "wdoc-line"        { fill = "none"  stroke_width = "2"  stroke_linejoin = "round"  stroke_linecap = "round" }
class "wdoc-series-1"    { fill = "#5e81ac"  stroke = "#5e81ac" }
class "wdoc-series-2"    { fill = "#a3be8c"  stroke = "#a3be8c" }
class "wdoc-series-3"    { fill = "#ebcb8b"  stroke = "#ebcb8b" }
class "wdoc-series-4"    { fill = "#bf616a"  stroke = "#bf616a" }
class "wdoc-series-5"    { fill = "#b48ead"  stroke = "#b48ead" }
class "wdoc-series-6"    { fill = "#88c0d0"  stroke = "#88c0d0" }
class "wdoc-series-7"    { fill = "#d08770"  stroke = "#d08770" }
class "wdoc-series-8"    { fill = "#8fbcbb"  stroke = "#8fbcbb" }

// Line-chart point decorations. `wdoc-point-label` is the auto value
// label (`point_labels = true`); `wdoc-annotation` styles author-pinned
// `ChartPoint` markers + labels. Both paint with `currentColor` so an
// unthemed doc renders; a themed site recolours them via render/theme.rs.
class "wdoc-point-label" { fill = "currentColor"  opacity = "0.7" }
class "wdoc-annotation"  { fill = "currentColor"  bold = true }

// Default styling for flowchart shapes (`process` / `decision` / `terminator`
// / `node`) authored with no `fill` / `stroke` / `class` — otherwise they'd be
// bare-SVG black. A subtle surface fill + a per-type hue border, with `fg`-ish
// label text via `wdoc-shape-text`. These are the *light* palette values
// (readable on white): they are what the always-light PDF uses, and what an
// unthemed doc renders. A themed web site recolours them per dark/light mode
// via render/theme.rs's APPLY (which references `var(--wdoc-*)`).
class "wdoc-process"    { fill = "#eceff4"  stroke = "#5e81ac" }
class "wdoc-decision"   { fill = "#eceff4"  stroke = "#d08770" }
class "wdoc-terminator" { fill = "#eceff4"  stroke = "#a3be8c" }
class "wdoc-node"       { fill = "#eceff4"  stroke = "#4c566a" }
class "wdoc-shape-text" { fill = "#2e3440" }

// Diagram `boundary` overlay: a muted, fill-free box behind its members
// with a bold muted label. The web theme (render/theme.rs APPLY) recolours
// these per mode and adds a dashed border; this is the static / PDF default.
class "wdoc-boundary"       { fill = "none"  stroke = "#4c566a" }
class "wdoc-boundary-label" { fill = "#4c566a"  bold = true }

// Edge labels (a computed edge record's `label` field, and statechart
// transition triggers): muted text at the edge's midpoint.
class "wdoc-edge-label" { fill = "#4c566a" }

// Sequence-diagram defaults (heads / lifelines / message arrows /
// margin notes). Static light values; render/theme.rs APPLY recolours
// per mode. An author's `class` on a participant replaces the head's
// theme classes like any flowchart shape. Stroke-only classes carry no
// `fill` — a CSS fill would override the open shapes' inline
// `fill="none"` and fill stick figures / chevrons / loops.
class "wdoc-participant"      { fill = "#eceff4"  stroke = "#5e81ac" }
class "wdoc-participant-line" { stroke = "#5e81ac" }
class "wdoc-lifeline"         { stroke = "#4c566a"  opacity = "0.6" }
class "wdoc-seq-message"      { stroke = "#2e3440" }
class "wdoc-seq-arrow"        { fill = "#2e3440" }
class "wdoc-seq-text"         { fill = "#2e3440" }
class "wdoc-note"             { fill = "#fdf6e3"  stroke = "#b58900" }
class "wdoc-note-text"        { fill = "#2e3440" }

// State-diagram defaults: rounded state boxes + the filled entry dot.
// Transitions reuse `wdoc-seq-message` / `wdoc-seq-arrow` strokes and
// the shared `wdoc-edge-label` text.
class "wdoc-state"         { fill = "#eceff4"  stroke = "#5e81ac" }
class "wdoc-state-initial" { fill = "#2e3440" }

// Timeline shape defaults. Markers / connectors / labels paint with
// `currentColor` so they follow the page theme; phase dividers + their
// headings also carry a cycled `wdoc-series-N` class, which sets their
// hue (these rules just set width / weight / opacity, leaving colour to
// the palette class). Override any of them like a chart series class.
class "wdoc-timeline-divider"     { stroke = "currentColor"  opacity = "0.5"  stroke_width = "2" }
class "wdoc-timeline-marker"      { fill = "currentColor" }
class "wdoc-timeline-connector"   { stroke = "currentColor"  opacity = "0.5" }
class "wdoc-timeline-label"       { fill = "currentColor" }
class "wdoc-timeline-phase-label" { fill = "currentColor"  bold = true }

// Bare-class colour rules lifted out of the `webpage` / `book` template
// CSS. Their surrounding layout (flex, fixed sidebar, descendant +
// `:hover` selectors) is not expressible as a class and stays in Rust.
class "site-header"  { bold = true  font_size = "1.4rem"  padding = "0.5rem 0" }
// TOC links inherit the (themed) body colour rather than a fixed grey,
// so the sidebar is readable on both light and dark books — an `<a>`
// would otherwise fall back to the browser's link blue. Emphasis/muting
// comes from `book_css` (weight + opacity), not the colour.
class "book-chapter" { color = "inherit" }
class "book-section" { color = "inherit" }
class "current"      { bold = true }

// Heading hierarchy. `h1`..`h6` lower to `<p class="heading-N">`; these
// give each level its weight and descending scale. Now bare single-class
// rules (the class system carries `font_weight` / `line_height` /
// `text_transform` / `letter_spacing`), so a user `class "heading-1"`
// overrides them by cascade — same as every other bundled class.
class "heading-1" { font_size = "2.6rem"   font_weight = "700"  line_height = "1.1"   letter_spacing = "-0.02em"   margin = "1.6rem 0 0.7rem" }
class "heading-2" { font_size = "1.85rem"  font_weight = "600"  line_height = "1.2"   letter_spacing = "-0.015em"  margin = "1.5rem 0 0.6rem" }
class "heading-3" { font_size = "1.35rem"  font_weight = "600"  line_height = "1.3"   letter_spacing = "-0.01em"   margin = "1.2rem 0 0.4rem" }
class "heading-4" { font_size = "1.12rem"  font_weight = "600"  margin = "1rem 0 0.3rem" }
class "heading-5" { font_size = "1rem"     font_weight = "600"  margin = "0.9rem 0 0.3rem" }
class "heading-6" { font_size = "0.85rem"  font_weight = "700"  text_transform = "uppercase"  letter_spacing = "0.06em"  margin = "0.9rem 0 0.3rem" }

// Built-in inline emphasis. The `**bold**` / `_italic_` / `` `code` ``
// patterns lower to `<span class="bold|italic|code">`; these are their
// bundled defaults. They carry only the *structural* part (weight /
// slant / monospace) with no `--wdoc-*`, so an unthemed doc still renders
// emphasis correctly. The *colour* is added per selected theme by the
// theme apply rules in render/theme.rs (`.bold` takes a hue, `.code` a
// themed chip), so emphasis looks right — and differs — across themes. A
// user `class "bold" { … }` (optionally `sites = […]`) overrides either.
class "bold"   { bold = true }
class "italic" { italic = true }
class "code"   { font_family = "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"  font_size = "0.92em" }

