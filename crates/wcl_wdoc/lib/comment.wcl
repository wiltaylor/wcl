// wdoc standard library — review comments.
//
// Review comments are NOT stored in the document source. The `wcl editor`
// preview pane lets you click a rendered block (or the page) and leave a
// note, persisting each one into a `comments.wcl` sidecar — one beside each
// owning document root (the host names the file that marks one), or beside
// the served root document for a page not inside one. Watchers ignore
// `comments.wcl`, so a note shows
// client-side with no document rebuild.
// `wcl wdoc comments` reads them back so an AI agent can act on the notes and
// `wcl wdoc comments resolve <id>` to delete them. See
// `crates/wcl_wdoc/src/comments.rs`.
//
// A sidecar is a list of `comment` blocks. A comment names a page, an object
// (`object_kind` + `object_id`), or both; at least one complete address is
// required. A page may additionally carry a positional block locator (absent
// locator = the whole page):
//
//   comment {
//     id = "c12ab3"
//     page = "concept_records"
//     loc = "0/2/1"                 // omit for a whole-page comment
//     target = "card — \"3rd card\""
//     body = "tighten this"
//   }
//
// This `@block` type documents that shape; the sidecar is read leniently (it
// needs no `import`), but importing it gives an authored/generated sidecar
// schema validation and LSP.

namespace wdoc

@block("comment")
type Comment {
  id: utf8            // stable handle; survives edits so `resolve` can find it
  page: utf8?         // the page name the comment is on (optional for object findings)
  page_file: utf8?    // the page's source file (disambiguates same-named pages
                      // across different sites / sub-documents)
  object_kind: utf8?  // object address kind; present together with object_id
  object_id: utf8?    // object address id; present together with object_kind
  loc: utf8?          // slot-qualified path of block indexes within the page
  target: utf8?       // human description of the referenced block
  body: utf8          // the reviewer's note
  author: utf8?       // who left it
  status: symbol?     // :open (default) / :resolved
  quote: utf8?        // exact text the reviewer had highlighted when commenting
}
