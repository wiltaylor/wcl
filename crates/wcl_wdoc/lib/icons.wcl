// ── Icons ──────────────────────────────────────────────────────────
//
// An `iconset` names a reference to one of the bundled SVG packs (today
// `lucide` and `bootstrap`, compiled into the binary) and sets the
// default styling for icons drawn from it. Icons are referenced three
// ways: the inline `:name:` (or `:set.name:`) handler in `span` text, an
// `icon` block inside a `diagram`, and they all draw from a shared
// `_wdoc/icons.svg` sprite the build emits with only the icons used.
//
// Styling rides the `class` system. Every icon paints with
// `currentColor`, so a `color` (on the iconset, an icon, or a referenced
// `class`) is the universal foreground knob — it recolours both
// stroke-based (Lucide) and fill-based (Bootstrap) packs. `size` scales
// inline icons (defaults to the surrounding font size, `1em`); `fill`
// and `background` are optional overrides.
@block("iconset")
type IconSet {
  @inline(0) name: identifier        // reference name, e.g. `ui`
  pack: utf8?                         // bundled pack; defaults to `name`
  size:        utf8?                  // default inline size, e.g. "1em", "20px"
  color:       utf8?                  // default foreground (drives currentColor)
  fill:        utf8?                  // optional explicit fill
  background:  utf8?                  // optional background
  class:       list<utf8>?            // classes added to every icon from this set
  @children("icon_def") icons: list<IconDef>
}

// Per-icon style override inside an `iconset`. Any field set here wins
// over the set default for that one icon.
@block("icon_def")
type IconDef {
  @inline(0) name: identifier         // icon name (file stem in the pack)
  size:        utf8?
  color:       utf8?
  fill:        utf8?
  background:  utf8?
  class:       list<utf8>?
}

// A placeable, scalable icon inside a `diagram` / `container`. `width` /
// `height` size it in diagram units (scaled further by `scale`); the
// anchors position it like any other shape. The `lower` is a stub — the
// icon is special-cased in the renderer (it resolves a bundled pack and
// emits a `<use>` of the shared sprite, which WCL can't express).
@block("icon")
type Icon extends SvgBlock {
  @inline(0) name: identifier         // icon name (optionally `set.name`)
  set: identifier?                    // which iconset (when more than one)
  size:        utf8?
  color:       utf8?
  fill:        utf8?
  background:  utf8?
  class: list<utf8>?
  id: identifier?
  // Defaults mirror the stdlib shapes so a bare icon lays out in
  // `:grid` / `:layered` diagrams and gets a bounding box for edges.
  x = 0.0  y = 0.0  width = 24.0  height = 24.0
  scale: f64?
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?

  lower = fn(i: Icon) -> list<SvgFundamental> []
}

// Default icon styling. The inline `:name:` handler emits an
// `<svg class="wdoc-icon">` sized to the surrounding text (1em); a
// per-icon `size` overrides it via inline style. Diagram icons are
// `<use>` elements sized by their width/height, so this `svg.wdoc-icon`
// (element+class) selector leaves them alone. Can't be a bare `class`.
stylesheet "wdoc-icon" {
  css = <<CSS
    svg.wdoc-icon { display: inline-block; width: 1em; height: 1em; vertical-align: -0.125em; }
    CSS
}

// Built-in iconsets for the compiled-in packs, so `lucide` and `bootstrap`
// work with no declaration — `:lucide.heart:`, a diagram `icon "lucide.x"`
// or `{ set = lucide }`, and (since any declared set feeds bare lookup) a
// bare `:heart:`. Use an explicit `:lucide.name:` when a bare word might
// also read as prose. Declare your own `iconset` to rename a pack or set
// default styling; a user iconset of the same name overrides these
// (the root document's sets are resolved before these library defaults).
iconset lucide {}        // `pack` defaults to the set's own name
iconset bootstrap {}

