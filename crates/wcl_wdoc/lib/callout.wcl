// Admonition: an icon + a coloured heading over a body. The built-in
// types — `note` / `info` / `tip` / `warning` / `error` / `success` —
// are selected by putting the name in `class`; each supplies an accent
// colour (CALLOUT_CSS) and a default icon (from the bundled Lucide pack,
// so it works with no `iconset` declared). `icon` overrides the default.
//
// This is the **first block routed through the semantic content IR**: the
// lowering below returns a `Content::Callout`, one node carrying the
// admonition's meaning — a typed `kind`, a heading, and body content —
// and every backend renders it from that. Before, the lowering built
// `<div>`s out of HTML fundamentals, which only the HTML backend could
// read; the PDF and Markdown backends each hand-reimplemented `callout`
// in Rust, matching the type by class name, and a user block whose own
// lowering returned another custom variant rendered in the book and
// nowhere else. The `body` runs through the inline-pattern engine (like
// `p "…"`), so `**bold**` / `` `code` `` / `[links](url)` / `:icons:` /
// `$math$` work; the `heading` stays a plain span.
namespace wdoc

@block("callout")
type Callout extends ContentBlock {
  @doc("Inline label — the coloured heading at the top of the callout.")
  @inline(0) heading: utf8
  @doc("The prose under the heading. Runs through the inline-pattern engine.")
  body:  utf8
  @doc("Optional explicit HTML id.")
  id:    identifier?
  @doc("The admonition's type, from the closed `CalloutKind` set. Preferred over `class`: a misspelling is a schema violation, where a stray class name only warns.")
  kind:  CalloutKind?
  @doc("Legacy type selection: `[\"note\"]` / `[\"tip\"]` / etc. May also carry user classes. `kind` wins when both are set.")
  class: list<utf8>?
  @doc("Override the default icon (any `pack.name` from a built-in or declared iconset).")
  icon:  utf8?

  lower = fn(c: Callout) -> list<Content> {
    let cls = if c.class == none { [] } else { c.class };
    // The built-in type, as a symbol from the declared vocabulary. An
    // explicit `kind` wins; otherwise it is read off `class`, which is
    // how every callout selected its type before `kind` existed. Each
    // backend maps the symbol to its own accent / icon / alert keyword —
    // none of them matches a class name by hand.
    let kind =
      if c.kind != none { c.kind }
      else if list_contains(cls, "warning") { :warning }
      else if list_contains(cls, "error") { :error }
      else if list_contains(cls, "success") { :success }
      else if list_contains(cls, "tip") { :tip }
      else if list_contains(cls, "info") { :info }
      else if list_contains(cls, "note") { :note }
      else { none };
    [
      Content::Callout {
        kind: kind,
        heading: c.heading,
        // The body is content, not a string: a `Paragraph` so it runs
        // through the inline-pattern engine on every backend.
        body: [Content::Paragraph { text: c.body }],
        // `icon` is the author's override only — the per-kind default
        // belongs to whichever backend draws icons.
        icon: c.icon,
        id: c.id,
        class: c.class,
      },
    ]
  }
}

// Default callout styling. The per-type accent rides a CSS custom
// property so it colours only the heading, the left border, and the
// (currentColor) icon — never the body text. The background is a
// theme-neutral translucent grey so callouts read on light + dark pages.
// Built on `var()`, compound `.callout.note/…`, and `:first/last-child`,
// so it can't be a bare `class`.
class "callout" { css = "--callout-accent: #888; margin: 1rem 0; padding: 0.6rem 0.9rem; border-left: 4px solid var(--callout-accent); border-radius: 4px; background: rgba(127,127,127,0.08);" }
class "callout-heading" { css = "display: flex; align-items: center; gap: 0.45rem; font-weight: 600; color: var(--callout-accent);" }
class "callout-title" { css = "margin: 0;" }
// The icon slot the renderer stamps beside the heading. Deliberately
// unstyled: the icon paints from `--callout-accent` on the heading, and
// the class is the hook a document restyles it through.
class "callout-icon" {}
class "callout-heading" {
  nest "svg.wdoc-icon" { css = "width: 1.15em; height: 1.15em;" }
}
class "callout-body" {
  nest "> :first-child" { css = "margin-top: 0;" }
}
class "callout-body" {
  nest "> :last-child" { css = "margin-bottom: 0;" }
}
// One hue per kind, all six distinct. `note` and `info` used to share a
// blue and `tip` used to borrow the cyan `info` now owns; `tip` moved to
// purple so `success` can keep the green that "it worked" means
// everywhere. These are the *unthemed* defaults — a selected theme
// repoints each to its own hue ring in `theme-rules.wcl`.
class "callout" {
  nest "&.note" { css = "--callout-accent: #5e81ac;" }
}
class "callout" {
  nest "&.info" { css = "--callout-accent: #88c0d0;" }
}
class "callout" {
  nest "&.tip" { css = "--callout-accent: #b48ead;" }
}
class "callout" {
  nest "&.warning" { css = "--callout-accent: #d08770;" }
}
class "callout" {
  nest "&.error" { css = "--callout-accent: #bf616a;" }
}
class "callout" {
  nest "&.success" { css = "--callout-accent: #a3be8c;" }
}

