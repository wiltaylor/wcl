// ── Rich-text card shape ───────────────────────────────────────────
//
// A `card` is a diagram shape whose body is arbitrary wdoc content —
// text with inline formatting, lists, code, callouts, even nested
// diagrams. Because it `extends SvgBlock`, it is a legal child of any
// `diagram` / `container` (positioned with `x`/`y` or anchors, and
// connectable by edges via `connect_points`), and it doubles as a
// `timeline`'s rich event item (a timeline reads each card child's
// `at` / `side` to place it on the axis).
//
// Like `map` / `tilemap`, a card is `@native`: the content is HTML
// produced by the block
// renderer + inline engine, which isn't expressible in WCL. The
// renderer emits an SVG `<foreignObject>` holding a `wdoc-card` `<div>`.
// Default styling is the `wdoc-card` stylesheet below; a themed site
// recolours `.wdoc-card` via the theme apply rules in render/theme.rs.

namespace wdoc

@block("card")
@native
type Card extends SvgBlock {
  // Free placement in a diagram / container (anchors like `rect`).
  @doc("Top-left x placement in the diagram (or use anchors).")
  x = 0.0
  @doc("Top-left y placement in the diagram (or use anchors).")
  y = 0.0
  @doc("Card box width (default 160).")
  width = 160.0
  @doc("Card box height (default 90).")
  height = 90.0
  @doc("Diagram anchor insets (left/right/top/bottom), like any shape.")
  anchor_left: f64?
  @hidden anchor_right: f64?
  @hidden anchor_top: f64?
  @hidden anchor_bottom: f64?

  // Timeline placement — used only when the card is a `timeline` child.
  @doc("ISO date the card is pinned to (used only when it's a `timeline` child).")
  on:   utf8?
  @doc("Timeline side: `:near` / `:far` / `:auto` (used only as a `timeline` child).")
  side: symbol?

  // Content.
  @doc("Optional plain-text heading.")
  title: utf8?
  @doc("Optional explicit HTML id.")
  id: identifier?
  @doc("Optional style classes.")
  class: list<utf8>?
  @doc("Diagram edge-attach sides, like any shape.")
  connect_points: list<AnchorSide>?
  @doc("The card's rich content (paragraphs, lists, callouts, nested diagrams…).")
  @children(WdocBlock) body: list<WdocBlock>

  // The rich HTML body is rendered in Rust — see src/card.rs.
}

// Default card styling. Bare-class selectors so user `class`es win, with
// neutral defaults and no `var(--wdoc-*)` (so a `site`-less doc stays
// unthemed); a themed site recolours `.wdoc-card` via render/theme.rs.
stylesheet "wdoc-card" {
  css = <<CSS
    .wdoc-card {
      box-sizing: border-box; overflow: hidden; height: 100%;
      padding: 0.5rem 0.6rem; border-radius: 6px;
      font-size: 0.85rem; line-height: 1.4;
      border: 1px solid #444; background: #262b33; color: #e6e6e6;
    }
    .wdoc-card > :first-child { margin-top: 0; }
    .wdoc-card > :last-child  { margin-bottom: 0; }
    .wdoc-card-title { font-weight: 600; margin: 0 0 0.3rem; }
    CSS
}
