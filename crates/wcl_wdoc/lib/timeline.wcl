// ── Stdlib timeline ────────────────────────────────────────────────
//
// `timeline` is a time axis placed inside a `diagram { }`. It tracks real
// calendar time: pick a `unit` (minute / hour / day / week / month /
// year), and the axis shows tick points at calendar boundaries with
// items and event cards pinned to explicit dates.
//
//   • items   — a dated event drawn as a marker + lead line + text label;
//               items auto-alternate sides unless one forces `:near`/`:far`.
//   • cards    — rich-text event boxes (the `card` child blocks), pinned
//               to a date via `on`.
//   • phases   — named date spans drawn as perpendicular boundary divider
//               lines, cycling the `wdoc-series-N` palette.
//   • the axis — `start`..`end` (auto-fit from the events when omitted);
//               ticks every `every` units (auto interval when omitted).
//
// Dates are ISO strings: `"2026-03-15"` or `"2026-03-15 14:30"` /
// `"2026-03-15T14:30"`. Unlike the charts, the timeline can't lower in
// WCL — calendar math (variable month lengths, leap years) lives in Rust
// — so its `lower` is a stub and the whole shape is drawn by
// `src/timeline.rs` (like `map` / `tilemap`). Default styling is the
// `wdoc-timeline-*` classes (see css-classes.wcl), so a `class` or a site
// `theme` recolours it like anything else.

// Two item variants so the common case stays terse: `On` auto-alternates
// the side; `OnSided` forces it with `side = :near | :far`. (Variant
// construction requires every field, so the optional side lives in its
// own variant.)
union TimelineItem {
  On      { label: utf8  on: utf8 }
  OnSided { label: utf8  on: utf8  side: symbol }
}
// A named span between two dates, drawn as boundary dividers + a heading.
union TimelinePhase { Of { label: utf8  from: utf8  to: utf8 } }

@block("timeline")
type Timeline extends SvgBlock {
  // Defaults match the chart convention so `:layered` / `:grid` layout
  // can position the timeline via a wrapper transform.
  x = 0.0  y = 0.0  width = 480.0  height = 200.0
  id: identifier?  class: list<utf8>?
  title:     utf8?
  direction: symbol?              // :horizontal (default) | :vertical
  unit:      symbol?              // :minutes|:hours|:days|:weeks|:months|:years (auto from span)
  start:     utf8?                // ISO scale start (auto-fit from events if omitted)
  end:       utf8?                // ISO scale end
  every:     i64?                 // tick interval in `unit`s (auto if omitted)
  phases:    list<TimelinePhase>?
  items:     list<TimelineItem>?
  @children("card") cards: list<Card>?    // rich-text event cards (pinned via `on`)
  connect_points: list<AnchorSide>?

  // Rendered entirely in Rust (src/timeline.rs); the WCL lower is a stub.
  lower = fn(t: Timeline) -> list<SvgFundamental> []
}
