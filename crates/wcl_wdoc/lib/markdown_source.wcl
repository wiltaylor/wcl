// ── markdown_source ────────────────────────────────────────────────
//
// Lowers its body to a Markdown string — the same output the Markdown backend
// produces — and shows it in a syntax-highlighted `code` block. Used to
// preview a page's generated Markdown inside the book, so it can be read
// beside the rendered page. `@native`, because the Markdown emitter isn't
// reachable from a WCL `lower` — and native on `:html` alone: the block taps
// the emitter from inside the HTML build, so it is a book-only device. Using
// it on another target is refused rather than silently rendering nothing.

namespace wdoc

@block("markdown_source")
@native(backends = [:html])
type MarkdownSource extends ContentBlock {
  @doc("Asset-filename stem for any diagram/terminal SVGs the body's Markdown writes — set it to the previewed page's name so the `![](…)` refs match the real Markdown output. Defaults to `markdown_source`.")
  id: utf8?
  @children(ContentBlock) children: list<ContentBlock>
}
