// ── Addressable content fragments (body) & projection (project) ──────
//
// A `body` attaches a chunk of renderable wdoc content to any data record
// as a *property* — without that record being a `WdocBlock`, and without
// the tag-scatter of `partial` / `collect`. A `project` elsewhere
// references that body and renders its children in place.
//
//   @block("server")
//   type Server {
//     @inline(0) name: identifier
//     region: utf8?
//     @child("body") overview: WdocAddressableBody?
//   }
//
//   server web01 { region = "us-east"
//     body { p $"Frontend in ${region}." }
//   }
//
//   page all {
//     wdoc_repeater { each = servers  as = :s
//       h2 $"${s.name}"
//       project { from = s.overview }   // render THIS record's body here
//     }
//   }
//
// `body` is marked `@by_ref`: when a server record is read as data (e.g. a
// repeater's `each`), its `body` slot reifies to a resolvable *reference*
// (a `Value::DataPath`) rather than inlined content, so `s.overview`
// carries the address of *that* server's body. `project` resolves the
// reference its `from` field evaluates to and renders the body's children.
// Both are `@native`, like `partial` / `collect` / `wdoc_repeater`.

namespace wdoc

// A named, renderable content fragment attached to a data record as a
// property. NOT a `WdocBlock`, so it never renders where it is declared and
// the page renderers pass over it; its content is reached only through a
// `project`. `@by_ref` makes a `@child` / `@children` slot of this kind
// reify to a `Value::DataPath` reference when its owning record is read as
// data, which is what lets `from = s.overview` address the right fragment.
//
// Naming: a single `@child("body")` slot is addressed by its slot, so the
// body needs no name (`body { … }`). A body in a `@children("body")` *list*
// — or one declared standalone at the document root (`bodies` on `Site`) —
// is addressed by its `@inline(0)` name, so give each a label
// (`body intro { … }`). A direct page-scope `project` names the full path
// from a root field (`from = loops.only.body`), since a block is reached
// through its `@children` field and label, not its bare kind.
//
// Records carrying a body may be nested arbitrarily (a `step` inside a
// `tutorial`, etc.) and may use a numeric `@inline(0)` label — a `tstep 1`'s
// body resolves via `st.body` from the repeater binding, or statically via
// `from = tuts.t1.steps.1.body`. Note `steps.1` matches the step *labelled*
// `1`, not the first element — it is label matching, not positional indexing.
@block("body") @by_ref
type WdocAddressableBody {
  @inline(0) name: identifier?
  @children(WdocBlock) children: list<WdocBlock>
}

// Renders the `body` that `from` resolves to — an expression yielding a body
// reference, typically a property of the data a `wdoc_repeater` / component
// is generating from (`from = s.overview`). May also resolve a list of
// references (a `@children("body")` slot), rendering each in order. Legal
// wherever a `WdocBlock` is. `@schemaless` because `from` evaluates to a
// reference value, not a static scalar. `@native`, and cycle-guarded
// against a body that projects itself.
@block("project") @schemaless
@native
type WdocProject extends WdocBlock {
  from: utf8
}
