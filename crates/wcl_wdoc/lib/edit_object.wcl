// ── edit_object ────────────────────────────────────────────────────
//
// An "edit this object" button, rendered ONLY in the `wcl editor` preview
// pane. Clicking it resolves one schema data object and opens its declaring
// `.wcl` source in an editor tab at that instance, so editing a rendered unit
// (a concept, an entity, a component — whatever the schema declares) is one
// click from its content.
//
//   edit_object { kind = "concept" target = unit.id label = "Edit this concept" }
//
//   • `kind`   — the schema `@block`/`@table` kind to edit (e.g. "concept").
//   • `target` — the instance id/label to open (matched against the object's
//                inline label, which is its id for id-labelled units); omit it
//                only when the document has exactly one instance of the kind.
//   • `label`  — button text override (defaults to "Edit <kind>").
//
// `@native`: edit mode is not visible to a WCL `lower`, so the button HTML is
// emitted by the renderer, gated on edit mode. Outside edit mode — `wcl wdoc
// build`, markdown, pdf — every backend renders it as nothing, which is why it
// is covered on all four targets: the button never leaks into published output
// and no build has to waive it.

namespace wdoc

@block("edit_object")
@native
type EditObject extends WdocBlock {
  @doc("The schema object kind to edit, e.g. \"concept\".")
  kind: utf8
  @doc("Instance id/label to open (matched against the object's inline label). May be omitted only when the kind has exactly one instance.")
  target: utf8?
  @doc("Button text override; defaults to \"Edit <kind>\".")
  label: utf8?
  @doc("Optional explicit HTML id.")
  id: identifier?
  @doc("Extra CSS classes on the button.")
  class: list<utf8>?
}

// Styling for the injected button. Kept self-contained (no `--wdoc-*` vars) so
// it is safe even though the button only ever appears in the `wcl editor`
// preview pane.
stylesheet "wdoc-edit-object" {
  css = <<CSS
    .wcl-edit-object-btn { display: inline-flex; align-items: center; gap: 0.35rem; margin: 0.4rem 0; padding: 0.3rem 0.7rem; border: 1px solid #4c8bf5; border-radius: 6px; background: rgba(76,139,245,0.12); color: #4c8bf5; font: 600 13px system-ui, sans-serif; cursor: pointer; }
    .wcl-edit-object-btn:hover { background: rgba(76,139,245,0.22); }
    CSS
}
