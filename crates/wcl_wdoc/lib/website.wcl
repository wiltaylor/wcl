// ── The `website` template ──────────────────────────────────────────
//
// A Hugo-style layout variant for building marketing / product sites: you
// bring the "fancy" HTML/CSS (a design exported from Figma, a Claude
// artifact, a hand-built theme) and slot wdoc-rendered content into it.
//
// Two seams make this work, on top of the ordinary `template` mechanism:
//
//   • Named SLOTS. A layout declares `slot hero: content?`; a page fills it
//     with a bare `hero { … }` block and the layout places it with
//     `slot(c, :hero)`. Everything else implicitly fills reserved `content`.
//
//   • HEAD assets. A layout emits `Html::Head { … }` at the TOP
//     LEVEL of its fundamentals to add `<link>` / `<script>` / `<meta>` /
//     fonts to the page `<head>` — wrap the common cases with the
//     `wdoc_head_*` helpers below. (The `site` block's `stylesheets` /
//     `scripts` / `fonts` fields do the same declaratively, and `assets`
//     copies an externally-built folder verbatim into the output.)
//
// A layout can combine raw-HTML fragments with typed slot placements and
// `${c.title}` interpolation. See the `website` scaffold (`wcl init website`)
// and the Websites reference page for a worked example. The default layout
// below is composed from parts so it stays robust when a slot is absent.

namespace wdoc

// A `<link rel="stylesheet" href>` added to the page `<head>`. `href` is
// emitted verbatim, so it may be a URL, a copied `assets` path, or a
// shipped `file`. Return it at a template's top level to take effect.
let wdoc_head_stylesheet = fn(href: utf8) -> list<Html> [
  Html::Head { children: [
    ela("link", [], [["rel", "stylesheet"], ["href", href]], []),
  ] },
]

// A deferred `<script src defer>` added to the page `<head>`.
let wdoc_head_script = fn(src: utf8) -> list<Html> [
  Html::Head { children: [
    ela("script", [], [["src", src], ["defer", ""]], []),
  ] },
]

// A web-font `<link rel="stylesheet" href>` (e.g. a Google Fonts URL).
// Identical to `wdoc_head_stylesheet`; named for intent at the call site.
let wdoc_head_font = fn(href: utf8) -> list<Html>
  wdoc_head_stylesheet(href)

// A `<meta name content>` tag added to the page `<head>` (description,
// viewport, an Open Graph `og:*` name, …).
let wdoc_head_meta = fn(name: utf8, content: utf8) -> list<Html> [
  Html::Head { children: [
    ela("meta", [], [["name", name], ["content", content]], []),
  ] },
]

// Verbatim head HTML — an escape hatch for anything the typed helpers
// don't cover (a `<base>`, a preconnect, an inline `<style>`, …).
let wdoc_head_raw = fn(html: utf8) -> list<Html> [
  Html::Head { children: [ raw(html) ] },
]

// ── The default layout ──────────────────────────────────────────────
//
// A clean, theme-aware shell you can use as-is or copy and replace with
// your own design. It paints from the same `--wdoc-*` theme variables as
// the rest of wdoc, so it follows the site `theme` / `accent`.
//
// IMPORTANT: this heredoc is emitted verbatim into the page <style>, so
// it must be pure CSS — never a `//` line (CSS has no `//` comment).
let website_css = <<CSS
  html { scroll-padding-top: 4.5rem; }
  .ws-header { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 0.9rem clamp(1rem, 5vw, 3rem); background: var(--wdoc-bg, #fff); border-bottom: 1px solid var(--wdoc-border, rgba(127,127,127,0.3)); }
  .ws-header .ws-brand { font-weight: 700; font-size: 1.15rem; color: inherit; text-decoration: none; }
  .ws-header ul.menu { list-style: none; margin: 0; padding: 0; display: flex; gap: 1.25rem; align-items: center; }
  .ws-header ul.menu a { color: inherit; text-decoration: none; opacity: 0.85; }
  .ws-header ul.menu a:hover, .ws-header ul.menu a.current { opacity: 1; color: var(--wdoc-accent, inherit); }
  .ws-header .ws-controls { display: flex; align-items: center; gap: 0.6rem; }
  .ws-header .ws-controls .wdoc-search { margin: 0; min-width: 12rem; }
  .ws-header .ws-controls .theme-toggle { margin: 0; padding: 0.25rem 0.7rem; cursor: pointer; background: transparent; border: 1px solid var(--wdoc-border, rgba(127,127,127,0.4)); border-radius: 999px; color: inherit; font: inherit; font-size: 0.8rem; white-space: nowrap; }
  .ws-header .ws-controls .theme-toggle:hover { border-color: var(--wdoc-border-strong, rgba(127,127,127,0.7)); }
  .ws-banner { border-bottom: 1px solid var(--wdoc-border, rgba(127,127,127,0.3)); padding: 0 clamp(1rem, 5vw, 3rem); }
  .ws-hero { padding: clamp(3rem, 10vw, 6rem) clamp(1rem, 5vw, 3rem); text-align: center; background: color-mix(in srgb, var(--wdoc-accent, #4060ff) 12%, var(--wdoc-bg)); border-bottom: 1px solid var(--wdoc-border, rgba(127,127,127,0.3)); }
  .ws-hero h1 { font-size: clamp(2rem, 6vw, 3.5rem); margin: 0 0 0.75rem; }
  .ws-layout { display: grid; grid-template-columns: 1fr; gap: 2.5rem; max-width: 70rem; margin: 0 auto; padding: clamp(2rem, 5vw, 3.5rem) clamp(1rem, 5vw, 3rem); box-sizing: border-box; }
  .ws-layout.has-aside { grid-template-columns: minmax(0, 1fr) 16rem; }
  @media (max-width: 48rem) { .ws-layout.has-aside { grid-template-columns: 1fr; } }
  .ws-aside { font-size: 0.95rem; }
  .ws-footer { padding: 2rem clamp(1rem, 5vw, 3rem); text-align: center; opacity: 0.7; border-top: 1px solid var(--wdoc-border, rgba(127,127,127,0.3)); }
  CSS

// The `website` template's `<style>` block — include it to inherit the
// default header / hero / layout / footer styling, or drop it for your own.
let wdoc_part_website_css = fn() -> list<Html> [
  el("style", [], [raw(website_css)]),
]

// The sticky site header: the title as a home link plus the curated
// `menu` (or a flat link per page when no `menu` is declared), and a
// right-side controls cluster — the search box and the light/dark theme
// toggle — when the site enables them (`search` / `theme_toggle`).
let website_header = fn(c: TemplateCtx) -> Html
  el("header", ["ws-header"], flatten([
    [ ela("a", ["ws-brand"],
        [["href", if c.home_href == "" { "index.html" } else { c.home_href }]],
        [raw(c.title)]) ],
    if len(c.menu) == 0 {
      [ el("ul", ["menu"], map(c.pages, fn(p: PageRef) -> Html
          el("li", [], [ ela("a", [], [["href", p.href]], [raw(p.name)]) ]))) ]
    } else {
      wdoc_part_menu_tree(c)
    },
    website_header_controls(c),
  ]))

// The header's right-side controls: search + theme toggle, wrapped in a
// `.ws-controls` cluster. Empty when neither feature is enabled, so
// sites that set neither flag get exactly the header they had before.
let website_header_controls = fn(c: TemplateCtx) -> list<Html>
  if c.search || c.theme_toggle {
    [ el("div", ["ws-controls"], flatten([
        wdoc_part_search_box(c.search),
        wdoc_part_theme_toggle(c.theme_toggle),
      ])) ]
  } else { [] }

// A named slot wrapped in `<tag class>`, or nothing when the page does not
// fill it (so the wrapper is never emitted empty).
let website_slot_section = fn(c: TemplateCtx, name: symbol, tag: utf8, cls: utf8) -> list<Html> {
  if len(slot_blocks(c, name)) == 0 { [] }
  else { [ el(tag, [cls], slot(c, name)) ] }
}

// The main content area: the default `content` plus, when the page
// fills `sidebar`, an `<aside>` next to it (two-column).
let website_body = fn(c: TemplateCtx) -> Html {
  let aside = slot_blocks(c, :sidebar);
  el("div", ["ws-layout", if len(aside) > 0 { "has-aside" }], flatten([
    [ el("main", ["ws-main"], slot(c, :content)) ],
    if len(aside) == 0 { [] }
    else { [ el("aside", ["ws-aside"], slot(c, :sidebar)) ] },
  ]))
}

// The site footer: the `footer` slot when filled, else the site title.
let website_footer = fn(c: TemplateCtx) -> Html {
  let footer = slot_blocks(c, :footer);
  el("footer", ["ws-footer"],
    if len(footer) == 0 { [raw(c.title)] } else { slot(c, :footer) })
}

// The full default `website` layout: style, header, optional banner and
// hero slot, the content body (+ optional sidebar), and the footer.
// The `website` template is exactly this — copy its body and swap parts
// to retheme.
let wdoc_website_layout = fn(c: TemplateCtx) -> list<Html>
  flatten([
    wdoc_part_website_css(),
    [ website_header(c) ],
    website_slot_section(c, :banner, "div", "ws-banner"),
    website_slot_section(c, :hero, "section", "ws-hero"),
    [ website_body(c) ],
    [ website_footer(c) ],
    wdoc_part_menu_script(c.menu),
  ])

template website {
  slot content: content
  slot banner: content?
  slot hero: content?
  slot sidebar: content?
  slot footer: content?
  render = fn(c: TemplateCtx) -> list<Html>
    wdoc_website_layout(c)
}
