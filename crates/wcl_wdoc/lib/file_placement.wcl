// wdoc standard library — object file placement.
//
// `@wdoc.file(...)` (or bare `@file(...)`, which resolves to the same wdoc
// decorator) tags a *data-object* schema (a `@block` / `@table` type) with a
// default location for NEW objects created through editor tooling. It does
// not change how the document is parsed or rendered — it is a hint a tool
// reads (via reflection over the schema's decorators) when deciding which
// `.wcl` file to append a new object to.
//
//   @block("character") @wdoc.file("data/characters.wcl")
//   type Character { @inline(0) id: identifier  name: utf8  hp: u32 }
//
//   @block("npc") @file("data/npcs", folder = true)
//   type Npc { @inline(0) id: identifier  name: utf8 }   // → data/npcs/<id>.wcl
//
// Semantics (all enforced by tooling, not the language):
//   - no `@wdoc.file`         → new objects go into the document's own file
//   - `path` (a single file)  → new objects are appended to that file
//   - `folder = true`         → each new object gets its own file
//                               `<path>/<id>.wcl` (id from the `@inline(0)` slot)
//   - existing objects stay where they are; the decorator only steers creation.
//
// Declaring it here documents the argument slots and lets reflection / the
// LSP see them.

namespace wdoc

@decorator("file")
type FilePlacement {
  @inline(0) path: utf8   // default target path for new objects (file, or folder)
  folder: bool?           // treat `path` as a folder: one file per object
}

// `@wdoc.editable(...)` (or bare `@editable(...)`) opts a data-object schema
// into the `wcl editor`'s Data mode: the editor shows one table of all its
// instances with add / modify / remove. The optional `file` names where new
// rows go; without it the `@wdoc.file` placement hint applies, and without
// either new rows land in the file already holding the most instances.
//
//   @block("character") @wdoc.editable("data/characters.wcl")
//   type Character { @inline(0) id: identifier  name: utf8  hp: u32 }
//
// Like `@wdoc.file` this is pure tooling vocabulary — parsing and rendering
// ignore it.
@decorator("editable")
type Editable {
  @inline(0) file: utf8?  // default target file for new rows
}
