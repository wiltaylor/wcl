// ── Stdlib terminal ────────────────────────────────────────────────
//
// A `terminal` is a monospace character grid rendered as inline SVG
// with the bundled JetBrains Mono Nerd Font, so box-drawing glyphs,
// powerline symbols, and Nerd Font icons all render. It is `@native` —
// the grid model, ANSI handling, and asciinema replay aren't expressible
// in WCL. Populate it three ways:
//
//   * authored text — `term_text` placed at 1-based character coordinates
//     with the full terminal style set (the one base primitive), plus the
//     higher-level elements in `tui.wcl` (`term_box` / `term_glyph` /
//     `term_fill` and the `tui_*` controls) that lower to text runs;
//   * `text = "..."` — plain content laid out by a virtual terminal;
//   * `source = "rec.cast"` — an asciinema recording, replayed by a
//     small bundled JS player (play / pause / seek / speed).
//
// `cols`/`rows` size the grid (defaults 80×24; a `source` recording
// overrides them with its own header size). Colours are themed by
// `palette` (:default | :light) plus `fg`/`bg` overrides; chrome
// draws a title bar.

// The terminal-output interface. Every implementation sits at a 1-based
// (row, col) and either lowers to terminal IR or is a native primitive.
// Placement is expressed separately by `Terminal.children` and container
// slots accepting `TermPrimitive`.
namespace wdoc

interface TermPrimitive {
  @doc("1-based grid row.")
  row: i64
  @doc("1-based grid column.")
  col: i64
  lower: fn(&TermPrimitive) -> list<TermFundamental>?
}

@block("terminal")
@native
type Terminal extends ContentBlock {
  @doc("Grid width in cells (default `80`; a `.cast` header overrides it).")
  cols:        i64?
  @doc("Grid height in cells (default `24`; a `.cast` header overrides it).")
  rows:        i64?
  @doc("Cell metric: font size.")
  font_size:   f64?
  @doc("Cell metric: line height.")
  line_height: f64?
  @doc("Seed colours: `:default` (dark) or `:light`.")
  palette:     symbol?       // :default (dark) | :light
  @doc("Explicit default foreground override.")
  fg:          utf8?
  @doc("Explicit default background override.")
  bg:          utf8?
  @doc("Draw a window title bar (default `true`).")
  chrome:      bool?         // window title bar (default true)
  @doc("Title shown in the chrome bar.")
  title:       utf8?
  @doc("Inline content fed to the virtual terminal (ANSI included).")
  text:        utf8?         // inline content fed to a virtual terminal
  @doc("Path to an asciinema `.cast` recording to replay.")
  source:      utf8?         // path to an asciinema .cast recording
  @doc("Replay control: start playing automatically.")
  autoplay:    bool?
  @doc("Replay control: loop playback.")
  loop:        bool?
  @doc("Replay control: playback speed multiplier.")
  speed:       f64?
  @doc("Optional explicit HTML id.")
  id:          identifier?
  @doc("Style classes (the `class` themes the window `<div>`).")
  class:       list<utf8>?
  @doc("Placeable terminal primitives and widgets.")
  @children(TermPrimitive) children: list<TermPrimitive>
}

// The one primitive: a run of text (may contain `\n` for multiple lines)
// at (row, col), with the full terminal style set. The renderer draws it
// directly; everything else (boxes, fills, glyphs, and the `tui_*`
// controls in `tui.wcl`) is a higher-level element that lowers to
// `TermFundamental::Text` runs.
@block("term_text")
@native
type TermText extends TermPrimitive {
  @doc("The text (`@inline(0)`, so `term_text \"hi\" { … }`).")
  @inline(0) content: utf8
  row: i64
  col: i64
  @doc("Foreground colour — ANSI name, 256 index, or `#hex`.")
  fg: utf8?
  @doc("Background colour — ANSI name, 256 index, or `#hex`.")
  bg: utf8?
  @doc("Bold style.")
  bold: bool?
  @doc("Dim style.")
  dim: bool?
  @doc("Italic style.")
  italic: bool?
  @doc("Underline style.")
  underline: bool?
  @doc("Strikethrough style.")
  strike: bool?
  @doc("Blink style.")
  blink: bool?
  @doc("Inverse (swap fg/bg) style.")
  inverse: bool?
  @doc("Conceal (hide) style.")
  conceal: bool?
}

// Default terminal styling: the embedded JetBrains Mono Nerd Font faces
// (served from `_wdoc/`, written only when a terminal is used), the
// cell-grid font binding, window chrome, blink/cursor animation, and
// replay controls. The terminal's colours come from the `class` system
// (`.wdoc-terminal` is the bare-class default a user `class` overrides);
// this carries the parts a class can't express — `@font-face`,
// `@keyframes`, `:hover`, `[hidden]`, and the descendant `.wdoc-terminal-svg
// text` selector.
stylesheet "wdoc-terminal" {
  css = <<CSS
    @font-face { font-family: 'JetBrainsMono Nerd Font'; font-weight: normal; font-style: normal; font-display: swap; src: url('_wdoc/JetBrainsMonoNerdFontMono-Regular.woff2') format('woff2'); }
    @font-face { font-family: 'JetBrainsMono Nerd Font'; font-weight: bold; font-style: normal; font-display: swap; src: url('_wdoc/JetBrainsMonoNerdFontMono-Bold.woff2') format('woff2'); }
    @font-face { font-family: 'JetBrainsMono Nerd Font'; font-weight: normal; font-style: italic; font-display: swap; src: url('_wdoc/JetBrainsMonoNerdFontMono-Italic.woff2') format('woff2'); }
    .wdoc-terminal { display: inline-block; max-width: 100%; border-radius: 6px; overflow: hidden; }
    .wdoc-terminal { background: #1c1c1c; color: #d0d0d0; }
    .wdoc-terminal-svg { display: block; max-width: 100%; height: auto; }
    .wdoc-terminal-svg text { font-family: 'JetBrainsMono Nerd Font', ui-monospace, 'Cascadia Code', 'Fira Code', Menlo, Consolas, monospace; }
    .term-chrome-bar { fill: currentColor; opacity: 0.08; }
    .term-title { fill: currentColor; opacity: 0.6; font-family: ui-sans-serif, system-ui, sans-serif; font-size: 0.75em; }
    .term-close { stroke: currentColor; opacity: 0.55; stroke-width: 1.5; stroke-linecap: round; }
    .term-close:hover { opacity: 1; }
    .term-chrome-btn { fill: currentColor; opacity: 0.55; font-size: 0.8em; cursor: pointer; }
    .term-chrome-btn:hover { opacity: 1; }
    .term-cursor { fill: currentColor; opacity: 0.65; }
    .term-blink { animation: wdoc-term-blink 1s steps(1) infinite; }
    @keyframes wdoc-term-blink { 50% { opacity: 0; } }
    .wdoc-terminal-error { color: #bf616a; font-family: monospace; }
    .wdoc-terminal-player { position: relative; }
    .term-overlay-play { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 4rem; height: 4rem; display: flex; align-items: center; justify-content: center; padding: 0; border: none; border-radius: 50%; cursor: pointer; background: rgba(20,20,20,0.55); color: #fff; font-size: 1.9rem; line-height: 1; }
    .term-overlay-play:hover { background: rgba(20,20,20,0.75); }
    .term-overlay-play[hidden] { display: none; }
    CSS
}
