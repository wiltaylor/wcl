// ── Components & repetition ───────────────────────────────────────
//
// Declarative, reusable fragments of wdoc markup with named slots, plus
// a list-driven repeater. These five block kinds are registered here so
// the parser / validator / formatter recognise them, but their
// *semantics* (slot binding, body expansion, iteration) live in Rust —
// like `list` / `table` / `map`, they are `@native`.
//
//   wdoc_component metric_card {
//     wdoc_slot label
//     wdoc_slot value
//     wdoc_slot status { default = "ok" }   // optional slot
//     wdoc_body {
//       callout $"${label}" { class = [status]  body = $"Value: ${value}%" }
//     }
//   }
//
//   page p {
//     metric_card { label = "CPU" value = 42 status = "warning" }   // instance
//     wdoc_repeater { each = inventory  as = :h
//       metric_card { label = h.name value = h.cpu status = h.status }
//     }
//   }
//
// A component is instantiated by its own name as a bare block; the
// instance's fields fill the slots, and the body's `${slot}` /
// bare-identifier references resolve to them. A `wdoc_repeater` renders
// its body once per element of `each`, binding the element to the symbol
// `as`. Both compose: a repeater may live inside a component body and
// iterate a (list-typed) slot, and a component may be instantiated inside
// a repeater body.

// A reusable template. `name` is the kind authors instantiate.
//
// `@declares_kind` is the language's word for "instances of this type
// declare block kinds of their own": it tells kind lookup to derive a
// schema for `metric_card` from this instance's `wdoc_slot`s, so an
// instance of it is validated like any other block — an undeclared slot
// is an unknown field, an unfilled defaultless slot a missing required
// one — with no component vocabulary inside the language.
namespace wdoc

@block("wdoc_component")
@declares_kind(name = 0, params = "slots", body = "body")
type WdocComponent {
  @inline(0) name: identifier
  @children("slot")      slots: list<Slot>
  // Compatibility for existing documents while `slot name: Type` replaces
  // the old untyped spelling. The derived component contract reads both.
  @children("wdoc_slot") legacy_slots: list<WdocSlot>
  @child("wdoc_body")    body:  WdocBody
}

// A typed slot declaration. `content` distinguishes content holes from
// parameter values; `content<T>` restricts the accepted child kind/interface.
// The parser retains the TypeRef and `?` / `*` modifiers on this ordinary
// block. `@block_slot` is the host-neutral language marker that separates a
// nested block hole from a scalar component parameter; wdoc owns its checks.
@block_slot
type content {}

@block("slot")
type Slot {
  @inline(0) name: identifier
  @schemaless default: utf8?
}

// One slot (parameter). A `default` makes the slot optional; without one
// the instance must supply a value. Defaults are evaluated in the
// component definition's scope.
@block("wdoc_slot")
type WdocSlot {
  @inline(0) name: identifier
  default: utf8?
}

// The component's renderable body — ordinary wdoc blocks, rendered with
// the instance's slots bound into scope. `@schemaless` because a body is
// a template: its blocks only have meaning once expanded at an instance
// site (a component used inside a diagram legitimately holds SvgBlocks),
// so context-free validation would reject valid bodies.
@block("wdoc_body") @schemaless
type WdocBody {
  @children(ContentBlock) children: list<ContentBlock>
}

// Marks where a component instance's own nested blocks render — a layout
// "content slot". Legal wherever a `ContentBlock` is, and `@native`.
@block("wdoc_content") @contextual
@native
type WdocContent extends ContentBlock {
}

// Repeats its body once per element of `each`, binding the element to the
// symbol `as`. `@native`; `each` is
// read dynamically, so the validator does not type-check its elements.
//
// A repeater is the single iteration concept at every level of a document:
//   • inside a page (or a `diagram` / `container`) its body is `ContentBlock`s
//     (resp. `SvgBlock`s) — repeated content / shapes;
//   • at the document root its body is `page` blocks — one rendered page per
//     element (the page's interpolated label becomes the route);
//   • inside a `toc` / `chapter` its body is `chapter` blocks — one TOC entry
//     per element.
// The `page` / `chapter` / `class` / `stylesheet` slots below register those
// placements so the validator accepts them. They take effect only where the
// renderer looks for them (document root for pages, the TOC reader for
// chapters, the CSS-collection pass for classes / stylesheets); a slot block
// placed where its consumer doesn't look is structurally legal but ignored.
// `@contextual`: placement is decided by context, not by kind — the
// repeater is legal wherever children are allowed at all, and its body is
// validated once expanded rather than in place.
@block("wdoc_repeater") @contextual
@native
type WdocRepeater extends ContentBlock {
  // `@schemaless`: the `each` elements are read dynamically at render
  // time — `list<WdocItem>` only names the list shape.
  @schemaless each: list<WdocItem>
  as: symbol
  @children(ContentBlock)    children: list<ContentBlock>
  @children("page")       pages:    list<Page>
  @children("chapter")    chapters: list<Chapter>
  @children("class")      classes:  list<Class>
  @children("stylesheet") sheets:   list<Stylesheet>
}

// Opaque element type for a repeater's `each` list. The renderer reads
// each element's fields dynamically; this only names the list shape.
type WdocItem {}

// Renders the `wdoc_component` whose name is the *value* of `component` —
// the render-by-reference counterpart to instantiating a component by
// writing its name as a block. Because the target is a data value, a
// repeater can emit a *different* component per element:
//
//   wdoc_repeater { each = screen.body  as = :node
//     wdoc_instance { component = node.ref  title = node.title }
//   }
//
// The instance's like-named fields fill the target's slots (falling back to
// each slot's `default`). `@schemaless`, so the forwarded slot fields need
// no static schema; `@native`. Context-polymorphic like `wdoc_repeater`
// — legal wherever a
// `ContentBlock` / `SvgBlock` is, expanding to whatever its component body
// contains.
@block("wdoc_instance") @schemaless @contextual
@native
type WdocInstance extends ContentBlock {
  component: utf8
}

// ── Partials (scatter & collect) ──────────────────────────────────
//
// A `partial` tags a body of wdoc blocks with a key; a `collect` with the
// same tag gathers every matching partial across the document — this file
// and its eagerly-imported files — and renders their bodies in document
// order at the collect site. This is the appendix / glossary / "collected
// sidebars" pattern: authors scatter tagged content, one place assembles it.
//
//   partial sidebar {                 // a deposit, invisible at its source
//     callout "Tip" { body = "..." }
//   }
//   page summary {
//     collect sidebar                  // gathers every `partial sidebar`
//   }
//
// `@native` like the repeater / component. A partial is invisible where
// it is defined unless
// `show_here = true`, which also renders the body at its source.
@block("partial")
@native
type WdocPartial extends ContentBlock {
  @inline(0) tag: symbol
  show_here: bool?
  @children(ContentBlock) children: list<ContentBlock>
}

@block("collect")
@native
type WdocCollect extends ContentBlock {
  @inline(0) tag: symbol
}
