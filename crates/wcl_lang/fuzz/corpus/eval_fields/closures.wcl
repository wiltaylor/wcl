// Function values capture their definition-site locals — let-bindings
// and outer function parameters — at the moment the literal is
// evaluated. Document-scope identifiers (fields, blocks, types,
// unions) resolve at call time and don't need capture.

// ── 1. Capture across a let block ────────────────────────────────────
@schemaless captured = {
  let n = 5;
  let f = fn(x: i64) -> i64 x + n;
  f(3)                                                       // -> 8
}

// ── 2. Curried adder ─────────────────────────────────────────────────
@schemaless adder    = fn(x: i64) -> fn(i64) -> i64 fn(y: i64) -> i64 x + y
@schemaless add10    = adder(10)
@schemaless fifteen  = add10(5)                              // -> 15

// ── 3. Inline curry call ─────────────────────────────────────────────
@schemaless seven    = adder(3)(4)                           // -> 7

// ── 4. Parameter shadows capture ─────────────────────────────────────
@schemaless shadowing = {
  let n = 100;
  let f = fn(n: i64) -> i64 n;
  f(7)                                                       // -> 7 (param wins)
}
