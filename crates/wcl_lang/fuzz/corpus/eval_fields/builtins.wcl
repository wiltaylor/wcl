xs = range(0, 5)
ys = map(xs, fn(x: i64) -> i64 x * 2)
total = fold(ys, 0, fn(a: i64, b: i64) -> i64 a + b)
words = split("a,b,c", ",")
joined = join(words, "-")
padded = pad_start("7", 3, "0")
wide = pad_end("x", 4, "ab")
shout = repeat(to_upper("ha"), 3)
swapped = replace("a-b-c", "-", "+")
letters = chars("hey")
flat = flatten([[1, 2], [3]])
pairs = zip([1, 2], ["a", "b"])
sorted = sort([3, 1, 2])
matched = glob_match("src/**/*.rs", "src/a/b.rs")
overlap = glob_overlaps("*a*b", "a*")
msg = format("{} + {}", 1, 2)
