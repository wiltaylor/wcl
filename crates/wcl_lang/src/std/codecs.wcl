// Standard transform codecs implemented in WCL.

export let __codec_error = message => { __wcl_codec_error = true message = message }

export let __codec_is_error = value =>
    type_of(value) == "map" ? (map_has(value, "__wcl_codec_error") ? value.__wcl_codec_error == true : false) : false

export let __json_error = message => __codec_error(message)

export let __json_is_error = value => __codec_is_error(value)

export let __json_is_ws = ch =>
    ch == " " || ch == "\n" || ch == "\r" || ch == "\t"

export let __json_is_digit = ch =>
    regex_match(ch, "^[0-9]$")

export let __json_is_number_char = ch =>
    regex_match(ch, "^[0-9eE+\\-.]$")

export let __json_skip_line_comment = cursor =>
    cursor.eof() ? null : {
        let ch = cursor.take(1)
        ch == "\n" ? null : __json_skip_line_comment(cursor)
    }

export let __json_skip_block_comment = cursor =>
    cursor.eof() ? __json_error("unterminated block comment") :
    cursor.match("*/") ? {
        let _end = cursor.take(2)
        null
    } : {
        let _ch = cursor.take(1)
        __json_skip_block_comment(cursor)
    }

export let __json_skip_ignored = cursor =>
    cursor.eof() ? null :
    __json_is_ws(cursor.peek(1)) ? {
        let _ws = cursor.take(1)
        __json_skip_ignored(cursor)
    } :
    cursor.match("//") ? {
        let _open = cursor.take(2)
        let _comment = __json_skip_line_comment(cursor)
        __json_skip_ignored(cursor)
    } :
    cursor.match("/*") ? {
        let _open = cursor.take(2)
        let result = __json_skip_block_comment(cursor)
        __json_is_error(result) ? result : __json_skip_ignored(cursor)
    } :
    null

export let __json_read_string = (cursor, acc) =>
    cursor.eof() ? __json_error("unterminated string") : {
        let ch = cursor.take(1)
        ch == "\"" ? acc :
        ch == "\\" ? {
            let esc = cursor.eof() ? "" : cursor.take(1)
            let value =
                esc == "\"" ? "\"" :
                esc == "\\" ? "\\" :
                esc == "/" ? "/" :
                esc == "n" ? "\n" :
                esc == "r" ? "\r" :
                esc == "t" ? "\t" :
                esc == "b" ? "" :
                esc == "f" ? "" :
                esc
            __json_read_string(cursor, acc + value)
        } :
        __json_read_string(cursor, acc + ch)
    }

export let __json_read_number = (cursor, acc) =>
    cursor.eof() ? acc :
    __json_is_number_char(cursor.peek(1)) ? {
        let ch = cursor.take(1)
        __json_read_number(cursor, acc + ch)
    } :
    acc

export let __json_token = (kind, text, start, end, value) =>
    { kind = kind, text = text, start = start, end = end, value = value }

export let __json_tokenizer = cursor => {
    let ignored = __json_skip_ignored(cursor)
    __json_is_error(ignored) ? ignored :
    cursor.eof() ? null : {
        let start = cursor.pos()
        let ch = cursor.peek(1)
        ch == "{" ? { let text = cursor.take(1) __json_token(:lbrace, text, start, cursor.pos(), text) } :
        ch == "}" ? { let text = cursor.take(1) __json_token(:rbrace, text, start, cursor.pos(), text) } :
        ch == "[" ? { let text = cursor.take(1) __json_token(:lbracket, text, start, cursor.pos(), text) } :
        ch == "]" ? { let text = cursor.take(1) __json_token(:rbracket, text, start, cursor.pos(), text) } :
        ch == ":" ? { let text = cursor.take(1) __json_token(:colon, text, start, cursor.pos(), text) } :
        ch == "," ? { let text = cursor.take(1) __json_token(:comma, text, start, cursor.pos(), text) } :
        ch == "\"" ? {
            let _open = cursor.take(1)
            let value = __json_read_string(cursor, "")
            __json_is_error(value) ? value : __json_token(:string, value, start, cursor.pos(), value)
        } :
        __json_is_number_char(ch) ? {
            let text = __json_read_number(cursor, "")
            __json_token(:number, text, start, cursor.pos(), text)
        } :
        cursor.match("true") ? {
            let text = cursor.take(4)
            __json_token(:true, text, start, cursor.pos(), true)
        } :
        cursor.match("false") ? {
            let text = cursor.take(5)
            __json_token(:false, text, start, cursor.pos(), false)
        } :
        cursor.match("null") ? {
            let text = cursor.take(4)
            __json_token(:null, text, start, cursor.pos(), null)
        } :
        __json_error("unexpected character")
    }
}

export let __json_expect = (tokens, kind, message) =>
    tokens.match_kind(kind) ? tokens.take(1) : __json_error(message)

export let __json_parse_number = text =>
    contains(text, ".") || contains(text, "e") || contains(text, "E") ?
        to_float(text) :
        to_int(text)

export let __json_parse_value = tokens =>
    tokens.eof() ? __json_error("unexpected end of JSON") :
    tokens.match_kind(:lbrace) ? __json_parse_object(tokens) :
    tokens.match_kind(:lbracket) ? __json_parse_array(tokens) :
    tokens.match_kind(:string) ? { let t = tokens.take(1) t.value } :
    tokens.match_kind(:number) ? { let t = tokens.take(1) __json_parse_number(t.text) } :
    tokens.match_kind(:true) ? { let _t = tokens.take(1) true } :
    tokens.match_kind(:false) ? { let _t = tokens.take(1) false } :
    tokens.match_kind(:null) ? { let _t = tokens.take(1) null } :
    __json_error("expected JSON value")

export let __json_parse_object = tokens => {
    let _open = __json_expect(tokens, :lbrace, "expected object")
    __json_is_error(_open) ? _open :
    tokens.match_kind(:rbrace) ? {
        let _close = tokens.take(1)
        {}
    } :
    __json_parse_object_entries(tokens, {})
}

export let __json_parse_object_entries = (tokens, acc) =>
    tokens.match_kind(:string) ? {
        let key = tokens.take(1)
        let colon = __json_expect(tokens, :colon, "expected ':' after object key")
        __json_is_error(colon) ? colon : {
            let value = __json_parse_value(tokens)
            __json_is_error(value) ? value : {
                let updated = map_set(acc, key.value, value)
                tokens.match_kind(:comma) ? {
                    let _comma = tokens.take(1)
                    __json_parse_object_entries(tokens, updated)
                } :
                tokens.match_kind(:rbrace) ? {
                    let _close = tokens.take(1)
                    updated
                } :
                __json_error("expected ',' or '}' in object")
            }
        }
    } :
    __json_error("expected object key")

export let __json_parse_array = tokens => {
    let _open = __json_expect(tokens, :lbracket, "expected array")
    __json_is_error(_open) ? _open :
    tokens.match_kind(:rbracket) ? {
        let _close = tokens.take(1)
        []
    } :
    __json_parse_array_items(tokens, [])
}

export let __json_parse_array_items = (tokens, acc) => {
    let value = __json_parse_value(tokens)
    __json_is_error(value) ? value : {
        let updated = concat(acc, [value])
        tokens.match_kind(:comma) ? {
            let _comma = tokens.take(1)
            __json_parse_array_items(tokens, updated)
        } :
        tokens.match_kind(:rbracket) ? {
            let _close = tokens.take(1)
            updated
        } :
        __json_error("expected ',' or ']' in array")
    }
}

export let __json_parser = tokens =>
    tokens.eof() ? null :
    tokens.match_kind(:lbracket) ? {
        let _open = tokens.take(1)
        tokens.match_kind(:rbracket) ? { let _close = tokens.take(1) null } : __json_parse_value(tokens)
    } :
    tokens.match_kind(:comma) ? {
        let _comma = tokens.take(1)
        tokens.match_kind(:rbracket) ? { let _close = tokens.take(1) null } : __json_parse_value(tokens)
    } :
    tokens.match_kind(:rbracket) ? { let _close = tokens.take(1) null } :
    __json_parse_value(tokens)

export let __json_quote = s => {
    let escaped1 = replace(s, "\\", "\\\\")
    let escaped2 = replace(escaped1, "\"", "\\\"")
    let escaped3 = replace(escaped2, "\n", "\\n")
    let escaped4 = replace(escaped3, "\r", "\\r")
    let escaped5 = replace(escaped4, "\t", "\\t")
    "\"" + escaped5 + "\""
}

export let __json_render = value =>
    type_of(value) == "null" ? "null" :
    type_of(value) == "bool" ? to_string(value) :
    type_of(value) == "int" ? to_string(value) :
    type_of(value) == "bigint" ? to_string(value) :
    type_of(value) == "float" ? to_string(value) :
    type_of(value) == "string" ? __json_quote(value) :
    type_of(value) == "identifier" ? __json_quote(to_string(value)) :
    type_of(value) == "symbol" ? __json_quote(substr(to_string(value), 1)) :
    type_of(value) == "list" ? "[" + join(",", map(value, item => __json_render(item))) + "]" :
    (type_of(value) == "map" || type_of(value) == "object") ? "{" + join(",", map(keys(value), key => __json_quote(key) + ":" + __json_render(value[key]))) + "}" :
    "null"

export let __json_indent = level =>
    level <= 0 ? "" : "  " + __json_indent(level - 1)

export let __json_render_pretty = (value, level) =>
    type_of(value) == "list" ? __json_render_pretty_list(value, level) :
    (type_of(value) == "map" || type_of(value) == "object") ? __json_render_pretty_map(value, level) :
    __json_render(value)

export let __json_render_pretty_list = (value, level) =>
    len(value) == 0 ? "[]" :
    "[\n" +
    join(",\n", map(value, item => __json_indent(level + 1) + __json_render_pretty(item, level + 1))) +
    "\n" + __json_indent(level) + "]"

export let __json_render_pretty_map = (value, level) =>
    len(keys(value)) == 0 ? "{}" :
    "{\n" +
    join(",\n", map(keys(value), key => __json_indent(level + 1) + __json_quote(key) + ": " + __json_render_pretty(value[key], level + 1))) +
    "\n" + __json_indent(level) + "}"

export let __json_is_pretty = options =>
    type_of(options) == "map" ?
        (map_has(options, "pretty") ? options.pretty : false) :
        false

export let __json_render_with_options = (value, options) =>
    __json_is_pretty(options) ? __json_render_pretty(value, 0) : __json_render(value)

codec json {
    mode = :text
    tokenizer = cursor => __json_tokenizer(cursor)
    parser = tokens => __json_parser(tokens)
    encoder = (record, options) => __json_render_with_options(record, options)
    encoder_all = (records, options) => __json_render_with_options(records, options) + "\n"
}

export let __csv_tokenizer = cursor =>
    cursor.eof() ? null : {
        let start = cursor.pos()
        let text = cursor.take(cursor.len())
        { kind = :source, text = text, start = start, end = cursor.pos(), value = text }
    }

export let __csv_error = message => __codec_error(message)

export let __csv_is_error = value => __codec_is_error(value)

export let __csv_option_separator = options =>
    type_of(options) == "map" && map_has(options, "separator") ? {
        let sep = options.separator
        type_of(sep) != "string" ? __csv_error("CSV option 'separator' must be string") :
        length(sep) != 1 ? __csv_error("CSV option 'separator' must be a single character") :
        sep
    } :
    ","

export let __csv_option_has_header = options =>
    type_of(options) == "map" && map_has(options, "has_header") ? {
        let has_header = options.has_header
        type_of(has_header) != "bool" ? __csv_error("CSV option 'has_header' must be bool") :
        has_header
    } :
    true

export let __csv_parse_rows = (text, sep) =>
    split_delimited(text, sep)

export let __csv_header_names = (count, i, prefix, acc) =>
    i >= count ? acc : __csv_header_names(count, i + 1, prefix, concat(acc, [prefix + to_string(i)]))

export let __csv_check_headers = (headers, i, seen) =>
    i >= len(headers) ? headers : {
        let header = headers[i]
        map_has(seen, header) ? __csv_error("duplicate CSV header: " + header) :
        __csv_check_headers(headers, i + 1, map_set(seen, header, true))
    }

export let __csv_row_to_map = (headers, row, i, acc) =>
    i >= len(headers) ? acc :
    __csv_row_to_map(headers, row, i + 1, map_set(acc, headers[i], row[i]))

export let __csv_rows_to_maps = (rows, headers, i, acc) =>
    i >= len(rows) ? acc : {
        let row = rows[i]
        len(row) != len(headers) ? __csv_error("CSV row has " + to_string(len(row)) + " fields but expected " + to_string(len(headers))) : {
            let mapped = __csv_row_to_map(headers, row, 0, {})
            __csv_rows_to_maps(rows, headers, i + 1, concat(acc, [mapped]))
        }
    }

export let __csv_records = (rows, has_header) =>
    len(rows) == 0 ? [] :
    has_header ? {
        let checked = __csv_check_headers(rows[0], 0, {})
        __csv_is_error(checked) ? checked : __csv_rows_to_maps(substr_list(rows, 1), checked, 0, [])
    } : {
        let headers = __csv_header_names(len(rows[0]), 0, "col", [])
        __csv_rows_to_maps(rows, headers, 0, [])
    }

export let __csv_parser_all = (tokens, options) => {
    let sep = __csv_option_separator(options)
    __csv_is_error(sep) ? sep : {
        let has_header = __csv_option_has_header(options)
        __csv_is_error(has_header) ? has_header :
        tokens.eof() ? [] : {
            let source = tokens.expect_kind(:source, "expected CSV source")
            __csv_is_error(source) ? source : {
                let rows = __csv_parse_rows(source.value, sep)
                __csv_is_error(rows) ? rows : __csv_records(rows, has_header)
            }
        }
    }
}

export let __csv_string_value = value =>
    type_of(value) == "null" ? "" : to_string(value)

export let __csv_quote_field = (field, sep) =>
    contains(field, sep) || contains(field, "\"") || contains(field, "\n") || contains(field, "\r") ?
        "\"" + replace(field, "\"", "\"\"") + "\"" :
        field

export let __csv_render_row = (fields, sep) =>
    join(sep, map(fields, field => __csv_quote_field(field, sep)))

export let __csv_record_fields = (record, headers, i, acc) =>
    i >= len(headers) ? acc :
    __csv_record_fields(record, headers, i + 1, concat(acc, [map_has(record, headers[i]) ? __csv_string_value(record[headers[i]]) : ""]))

export let __csv_records_rows = (records, headers, sep, i, acc) =>
    i >= len(records) ? acc :
    type_of(records[i]) != "map" ? __csv_error("CSV encode expects map records") : {
        let fields = __csv_record_fields(records[i], headers, 0, [])
        __csv_records_rows(records, headers, sep, i + 1, concat(acc, [__csv_render_row(fields, sep)]))
    }

export let __csv_encoder_all = (records, options) => {
    let sep = __csv_option_separator(options)
    __csv_is_error(sep) ? sep :
    len(records) == 0 ? "" :
    type_of(records[0]) != "map" ? __csv_error("CSV encode expects map records") : {
        let headers = keys(records[0])
        let header_row = __csv_render_row(headers, sep)
        let rows = __csv_records_rows(records, headers, sep, 0, [])
        __csv_is_error(rows) ? rows : join("\n", concat([header_row], rows)) + "\n"
    }
}

codec csv {
    mode = :text
    tokenizer = cursor => __csv_tokenizer(cursor)
    parser_all = (tokens, options) => __csv_parser_all(tokens, options)
    encoder = (record, options) => __csv_encoder_all([record], options)
    encoder_all = (records, options) => __csv_encoder_all(records, options)
}

export let __hcl_tokenizer = cursor =>
    cursor.eof() ? null : {
        let start = cursor.pos()
        let text = cursor.take(cursor.len())
        { kind = :source, text = text, start = start, end = cursor.pos(), value = text }
    }

export let __hcl_error = message => __codec_error(message)

export let __hcl_strip_comment_chars = (line, i, quote, acc) =>
    i >= length(line) ? acc : {
        let ch = substr(line, i, i + 1)
        let next = substr(line, i, i + 2)
        quote == "" && ch == "#" ? acc :
        quote == "" && next == "//" ? acc :
        quote == "" && (ch == "\"" || ch == "'") ? __hcl_strip_comment_chars(line, i + 1, ch, acc + ch) :
        quote != "" && ch == "\\" ? __hcl_strip_comment_chars(line, i + 2, quote, acc + substr(line, i, i + 2)) :
        quote != "" && ch == quote ? __hcl_strip_comment_chars(line, i + 1, "", acc + ch) :
        __hcl_strip_comment_chars(line, i + 1, quote, acc + ch)
    }

export let __hcl_strip_comment = line => trim(__hcl_strip_comment_chars(line, 0, "", ""))

export let __hcl_lines = source =>
    split("\n", replace(replace(source, "\r\n", "\n"), "\r", "\n"))

export let __hcl_unquote = text =>
    starts_with(text, "\"") && ends_with(text, "\"") ? __json_read_string_like(substr(text, 1, length(text) - 1)) :
    starts_with(text, "'") && ends_with(text, "'") ? substr(text, 1, length(text) - 1) :
    text

export let __hcl_header_parts_loop = (text, acc) => {
    let t = trim(text)
    t == "" ? acc :
    starts_with(t, "\"") ? {
        let cap = regex_capture(t, "^\"((\\\\.|[^\"])*)\"(.*)$")
        len(cap) < 3 ? __hcl_error("unterminated HCL block label") :
        __hcl_header_parts_loop(cap[2], concat(acc, [__json_read_string_like(cap[0])]))
    } : {
        let cap = regex_capture(t, "^([^ \t]+)(.*)$")
        len(cap) < 2 ? acc : __hcl_header_parts_loop(cap[1], concat(acc, [cap[0]]))
    }
}

export let __hcl_header_parts = text => __hcl_header_parts_loop(text, [])

export let __hcl_set_or_append = (mapv, key, value) =>
    map_has(mapv, key) ?
        (type_of(mapv[key]) == "list" ? map_set(mapv, key, concat(mapv[key], [value])) : map_set(mapv, key, [mapv[key], value])) :
        map_set(mapv, key, value)

export let __hcl_set_label_path = (mapv, labels, value) =>
    len(labels) == 0 ? value :
    len(labels) == 1 ? __hcl_set_or_append(mapv, labels[0], value) : {
        let child = map_has(mapv, labels[0]) ? mapv[labels[0]] : {}
        type_of(child) != "map" ? __hcl_error("HCL block label conflicts with existing value: " + labels[0]) : {
            let updated = __hcl_set_label_path(child, substr_list(labels, 1), value)
            __codec_is_error(updated) ? updated : map_set(mapv, labels[0], updated)
        }
    }

export let __hcl_set_block = (body, parts, value) =>
    len(parts) == 0 ? __hcl_error("missing HCL block type") : {
        let block_type = parts[0]
        let labels = substr_list(parts, 1)
        len(labels) == 0 ? __hcl_set_or_append(body, block_type, value) : {
            let container = map_has(body, block_type) ? body[block_type] : {}
            type_of(container) != "map" ? __hcl_error("HCL block type conflicts with existing value: " + block_type) : {
                let updated = __hcl_set_label_path(container, labels, value)
                __codec_is_error(updated) ? updated : map_set(body, block_type, updated)
            }
        }
    }

export let __hcl_set_attr = (body, key, value) =>
    map_has(body, key) ? __hcl_error("duplicate HCL attribute: " + key) : map_set(body, key, value)

export let __hcl_split_top_loop = (text, sep, i, depth, quote, current, acc) =>
    i >= length(text) ? concat(acc, [current]) : {
        let ch = substr(text, i, i + 1)
        quote == "" && (ch == "\"" || ch == "'") ? __hcl_split_top_loop(text, sep, i + 1, depth, ch, current + ch, acc) :
        quote != "" && ch == "\\" ? __hcl_split_top_loop(text, sep, i + 2, depth, quote, current + substr(text, i, i + 2), acc) :
        quote != "" && ch == quote ? __hcl_split_top_loop(text, sep, i + 1, depth, "", current + ch, acc) :
        quote != "" ? __hcl_split_top_loop(text, sep, i + 1, depth, quote, current + ch, acc) :
        ch == "[" || ch == "{" || ch == "(" ? __hcl_split_top_loop(text, sep, i + 1, depth + 1, quote, current + ch, acc) :
        ch == "]" || ch == "}" || ch == ")" ? __hcl_split_top_loop(text, sep, i + 1, depth - 1, quote, current + ch, acc) :
        depth == 0 && ch == sep ? __hcl_split_top_loop(text, sep, i + 1, depth, quote, "", concat(acc, [current])) :
        __hcl_split_top_loop(text, sep, i + 1, depth, quote, current + ch, acc)
    }

export let __hcl_split_top = (text, sep) => __hcl_split_top_loop(text, sep, 0, 0, "", "", [])

export let __hcl_match_any_op = (text, i, ops, j) =>
    j >= len(ops) ? "" :
    substr(text, i, i + length(ops[j])) == ops[j] ? ops[j] :
    __hcl_match_any_op(text, i, ops, j + 1)

export let __hcl_find_op_loop = (text, ops, i, depth, quote, last) =>
    i >= length(text) ? last : {
        let ch = substr(text, i, i + 1)
        quote == "" && (ch == "\"" || ch == "'") ? __hcl_find_op_loop(text, ops, i + 1, depth, ch, last) :
        quote != "" && ch == "\\" ? __hcl_find_op_loop(text, ops, i + 2, depth, quote, last) :
        quote != "" && ch == quote ? __hcl_find_op_loop(text, ops, i + 1, depth, "", last) :
        quote != "" ? __hcl_find_op_loop(text, ops, i + 1, depth, quote, last) :
        ch == "[" || ch == "{" || ch == "(" ? __hcl_find_op_loop(text, ops, i + 1, depth + 1, quote, last) :
        ch == "]" || ch == "}" || ch == ")" ? __hcl_find_op_loop(text, ops, i + 1, depth - 1, quote, last) : {
            let op = depth == 0 && i > 0 ? __hcl_match_any_op(text, i, ops, 0) : ""
            op == "" ? __hcl_find_op_loop(text, ops, i + 1, depth, quote, last) :
            __hcl_find_op_loop(text, ops, i + length(op), depth, quote, { index = i op = op })
        }
    }

export let __hcl_find_op = (text, ops) => __hcl_find_op_loop(text, ops, 0, 0, "", { index = -1 op = "" })

export let __hcl_vars = options =>
    type_of(options) == "map" && map_has(options, "variables") && type_of(options.variables) == "map" ? options.variables : {}

export let __hcl_lookup_path = (value, parts, i) =>
    i >= len(parts) ? value :
    type_of(value) != "map" ? __hcl_error("HCL variable path is not a map") :
    map_has(value, parts[i]) ? __hcl_lookup_path(value[parts[i]], parts, i + 1) :
    __hcl_error("unknown HCL variable: " + join(".", parts))

export let __hcl_eval_variable = (text, options) =>
    __hcl_lookup_path(__hcl_vars(options), split(".", text), 0)

export let __hcl_apply_binary = (left, op, right) =>
    op == "||" ? (left || right) :
    op == "&&" ? (left && right) :
    op == "==" ? (left == right) :
    op == "!=" ? (left != right) :
    op == ">" ? (left > right) :
    op == ">=" ? (left >= right) :
    op == "<" ? (left < right) :
    op == "<=" ? (left <= right) :
    op == "+" ? (left + right) :
    op == "-" ? (left - right) :
    op == "*" ? (left * right) :
    op == "/" ? (left / right) :
    op == "%" ? (left % right) :
    __hcl_error("unsupported HCL operator: " + op)

export let __hcl_eval_binary_level = (text, options, ops, next) => {
    let found = __hcl_find_op(text, ops)
    found.index < 0 ? next(text, options) : {
        let left = __hcl_eval_expr(substr(text, 0, found.index), options)
        __codec_is_error(left) ? left : {
            let right = __hcl_eval_expr(substr(text, found.index + length(found.op)), options)
            __codec_is_error(right) ? right : __hcl_apply_binary(left, found.op, right)
        }
    }
}

export let __hcl_eval_args = (items, options, i, acc) =>
    i >= len(items) ? acc : {
        let item = trim(items[i])
        item == "" ? __hcl_eval_args(items, options, i + 1, acc) : {
            let value = __hcl_eval_expr(item, options)
            __codec_is_error(value) ? value : __hcl_eval_args(items, options, i + 1, concat(acc, [value]))
        }
    }

export let __hcl_call_function = (name, args) =>
    name == "length" || name == "len" ? len(args[0]) :
    name == "upper" ? upper(args[0]) :
    name == "lower" ? lower(args[0]) :
    name == "trim" ? trim(args[0]) :
    name == "contains" ? contains(args[0], args[1]) :
    name == "join" ? join(args[0], args[1]) :
    name == "split" ? split(args[0], args[1]) :
    name == "min" ? min(args[0], args[1]) :
    name == "max" ? max(args[0], args[1]) :
    __hcl_error("unknown HCL function: " + name)

export let __hcl_eval_function = (text, options) => {
    let cap = regex_capture(text, "^([A-Za-z_][A-Za-z0-9_-]*)\\((.*)\\)$")
    len(cap) != 2 ? null : {
        let args = trim(cap[1]) == "" ? [] : __hcl_eval_args(__hcl_split_top(cap[1], ","), options, 0, [])
        __codec_is_error(args) ? args : __hcl_call_function(cap[0], args)
    }
}

export let __hcl_parse_list_items = (items, options, i, acc) =>
    i >= len(items) ? acc : {
        let item = trim(items[i])
        item == "" ? __hcl_parse_list_items(items, options, i + 1, acc) : {
            let value = __hcl_eval_expr(item, options)
            __codec_is_error(value) ? value : __hcl_parse_list_items(items, options, i + 1, concat(acc, [value]))
        }
    }

export let __hcl_parse_object_items = (items, options, i, acc) =>
    i >= len(items) ? acc : {
        let item = trim(items[i])
        item == "" ? __hcl_parse_object_items(items, options, i + 1, acc) : {
            let eq = __toml_find_equals_loop(item, 0, "")
            let colon = regex_capture(item, "^([^:]+):(.*)$")
            eq >= 0 ? {
                let key = trim(substr(item, 0, eq))
                let value = __hcl_eval_expr(substr(item, eq + 1), options)
                __codec_is_error(value) ? value : __hcl_parse_object_items(items, options, i + 1, map_set(acc, __hcl_unquote(key), value))
            } :
            len(colon) == 2 ? {
                let value = __hcl_eval_expr(colon[1], options)
                __codec_is_error(value) ? value : __hcl_parse_object_items(items, options, i + 1, map_set(acc, __hcl_unquote(trim(colon[0])), value))
            } :
            __hcl_error("expected HCL object item")
        }
    }

export let __hcl_eval_primary = (text, options) => {
    let t = trim(text)
    t == "" ? __hcl_error("empty HCL expression") :
    starts_with(t, "(") && ends_with(t, ")") ? __hcl_eval_expr(substr(t, 1, length(t) - 1), options) :
    starts_with(t, "\"") && ends_with(t, "\"") ? __hcl_unquote(t) :
    starts_with(t, "'") && ends_with(t, "'") ? __hcl_unquote(t) :
    starts_with(t, "[") && ends_with(t, "]") ? __hcl_parse_list_items(__hcl_split_top(substr(t, 1, length(t) - 1), ","), options, 0, []) :
    starts_with(t, "{") && ends_with(t, "}") ? __hcl_parse_object_items(__hcl_split_top(substr(t, 1, length(t) - 1), ","), options, 0, {}) :
    t == "true" ? true :
    t == "false" ? false :
    t == "null" ? null :
    regex_match(t, "^[+-]?[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?$") ? to_float(t) :
    regex_match(t, "^[+-]?[0-9]+([eE][+-]?[0-9]+)$") ? to_float(t) :
    regex_match(t, "^[+-]?[0-9]+$") ? to_int(t) : {
        let call = __hcl_eval_function(t, options)
        call != null ? call :
        regex_match(t, "^[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*)*$") ? __hcl_eval_variable(t, options) :
        "${" + t + "}"
    }
}

export let __hcl_eval_expr = (text, options) => {
    let t = trim(text)
    __hcl_eval_binary_level(t, options, ["||"], (x, o) =>
        __hcl_eval_binary_level(x, o, ["&&"], (x2, o2) =>
            __hcl_eval_binary_level(x2, o2, ["==", "!="], (x3, o3) =>
                __hcl_eval_binary_level(x3, o3, [">=", "<=", ">", "<"], (x4, o4) =>
                    __hcl_eval_binary_level(x4, o4, ["+", "-"], (x5, o5) =>
                        __hcl_eval_binary_level(x5, o5, ["*", "/", "%"], (x6, o6) =>
                            starts_with(trim(x6), "!") ? !__hcl_eval_expr(substr(trim(x6), 1), o6) :
                            starts_with(trim(x6), "-") && !regex_match(trim(x6), "^-[0-9]") ? -__hcl_eval_expr(substr(trim(x6), 1), o6) :
                            __hcl_eval_primary(x6, o6)
                        )
                    )
                )
            )
        )
    )
}

export let __hcl_read_heredoc = (lines, i, marker, acc) =>
    i >= len(lines) ? __hcl_error("unterminated HCL heredoc") :
    trim(lines[i]) == marker ? { value = join("\n", acc) next = i + 1 } :
    __hcl_read_heredoc(lines, i + 1, marker, concat(acc, [lines[i]]))

export let __hcl_parse_attr_value = (value_text, lines, i, options) => {
    let t = trim(value_text)
    starts_with(t, "<<-") || starts_with(t, "<<") ? {
        let marker = trim(starts_with(t, "<<-") ? substr(t, 3) : substr(t, 2))
        __hcl_read_heredoc(lines, i + 1, marker, [])
    } : {
        let value = __hcl_eval_expr(t, options)
        __codec_is_error(value) ? value : { value = value next = i + 1 }
    }
}

export let __hcl_parse_body = (lines, i, body, options) =>
    i >= len(lines) ? { value = body next = i } : {
        let line = __hcl_strip_comment(lines[i])
        line == "" ? __hcl_parse_body(lines, i + 1, body, options) :
        line == "}" ? { value = body next = i + 1 } : {
            let eq = __toml_find_equals_loop(line, 0, "")
            let open = regex_capture(line, "^(.*)\\{(.*)$")
            len(open) == 2 && (eq < 0 || length(open[0]) < eq) ? {
                let header = trim(open[0])
                let rest = trim(open[1])
                let parts = __hcl_header_parts(header)
                __codec_is_error(parts) ? parts :
                ends_with(rest, "}") ? {
                    let inner = trim(substr(rest, 0, length(rest) - 1))
                    let child = inner == "" ? {} : {
                        let inner_eq = __toml_find_equals_loop(inner, 0, "")
                        inner_eq < 0 ? __hcl_error("one-line HCL block supports a single attribute") : {
                            let child_value = __hcl_eval_expr(substr(inner, inner_eq + 1), options)
                            __codec_is_error(child_value) ? child_value : map_set({}, trim(substr(inner, 0, inner_eq)), child_value)
                        }
                    }
                    __codec_is_error(child) ? child : {
                        let updated = __hcl_set_block(body, parts, child)
                        __codec_is_error(updated) ? updated : __hcl_parse_body(lines, i + 1, updated, options)
                    }
                } : {
                    let child = __hcl_parse_body(lines, i + 1, {}, options)
                    __codec_is_error(child) ? child : {
                        let updated = __hcl_set_block(body, parts, child.value)
                        __codec_is_error(updated) ? updated : __hcl_parse_body(lines, child.next, updated, options)
                    }
                }
            } :
            eq >= 0 ? {
                let key = trim(substr(line, 0, eq))
                let parsed = __hcl_parse_attr_value(substr(line, eq + 1), lines, i, options)
                __codec_is_error(parsed) ? parsed : {
                    let updated = __hcl_set_attr(body, key, parsed.value)
                    __codec_is_error(updated) ? updated : __hcl_parse_body(lines, parsed.next, updated, options)
                }
            } :
            __hcl_error("expected HCL attribute or block")
        }
    }

export let __hcl_parser_all = (tokens, options) =>
    tokens.eof() ? [] : {
        let source = tokens.expect_kind(:source, "expected HCL source")
        __codec_is_error(source) ? source : {
            let parsed = __hcl_parse_body(__hcl_lines(source.value), 0, {}, options)
            __codec_is_error(parsed) ? parsed : [parsed.value]
        }
    }

export let __hcl_ident = key =>
    regex_match(key, "^[A-Za-z_][A-Za-z0-9_-]*$") ? key : __json_quote(key)

export let __hcl_render_value = value =>
    type_of(value) == "string" ? __json_quote(value) :
    type_of(value) == "null" ? "null" :
    type_of(value) == "bool" ? to_string(value) :
    type_of(value) == "int" || type_of(value) == "bigint" || type_of(value) == "float" ? to_string(value) :
    type_of(value) == "list" ? "[" + join(", ", map(value, item => __hcl_render_value(item))) + "]" :
    type_of(value) == "map" ? "{ " + join(", ", map(keys(value), key => __hcl_ident(key) + " = " + __hcl_render_value(value[key]))) + " }" :
    __json_quote(to_string(value))

export let __hcl_render_map = value =>
    join("", map(keys(value), key => __hcl_ident(key) + " = " + __hcl_render_value(value[key]) + "\n"))

export let __hcl_encoder_all = records =>
    join("\n", map(records, record => type_of(record) == "map" ? __hcl_render_map(record) : __hcl_render_value(record) + "\n"))

codec hcl {
    mode = :text
    tokenizer = cursor => __hcl_tokenizer(cursor)
    parser_all = (tokens, options) => __hcl_parser_all(tokens, options)
    encoder = record => __hcl_render_value(record) + "\n"
    encoder_all = records => __hcl_encoder_all(records)
}

export let __yaml_tokenizer = cursor =>
    cursor.eof() ? null : {
        let start = cursor.pos()
        let text = cursor.take(cursor.len())
        { kind = :source, text = text, start = start, end = cursor.pos(), value = text }
    }

export let __yaml_lines = source =>
    split("\n", replace(replace(source, "\r\n", "\n"), "\r", "\n"))

export let __yaml_is_error = value => __codec_is_error(value)

export let __yaml_line_indent = line => {
    let cap = regex_capture(line, "^( *)")
    length(cap[0])
}

export let __yaml_strip_comment = line =>
    starts_with(trim(line), "#") ? "" : regex_replace(line, "\\s+#.*$", "")

export let __yaml_is_ignored = line => {
    let stripped = trim(line)
    stripped == "" || starts_with(stripped, "#") || starts_with(stripped, "%")
}

export let __yaml_skip_ignored = (lines, i) =>
    i >= len(lines) ? i :
    __yaml_is_ignored(lines[i]) ? __yaml_skip_ignored(lines, i + 1) :
    i

export let __yaml_doc_line = (line, marker) => {
    let stripped = trim(line)
    stripped == marker || starts_with(stripped, marker + " ")
}

export let __yaml_marker_rest = (line, marker) => {
    let stripped = trim(line)
    trim(substr(stripped, length(marker)))
}

export let __yaml_append_doc = (docs, current) =>
    len(current) == 0 ? docs : concat(docs, [current])

export let __yaml_split_docs_loop = (lines, i, current, docs) =>
    i >= len(lines) ? __yaml_append_doc(docs, current) : {
        let line = lines[i]
        __yaml_doc_line(line, "---") ? {
            let docs2 = __yaml_append_doc(docs, current)
            let rest = __yaml_marker_rest(line, "---")
            let current2 = rest == "" ? [] : [rest]
            __yaml_split_docs_loop(lines, i + 1, current2, docs2)
        } :
        __yaml_doc_line(line, "...") ? {
            let docs2 = __yaml_append_doc(docs, current)
            __yaml_split_docs_loop(lines, i + 1, [], docs2)
        } :
        trim(line) == "" && len(current) == 0 ? __yaml_split_docs_loop(lines, i + 1, current, docs) :
        starts_with(trim(line), "%") && len(current) == 0 ? __yaml_split_docs_loop(lines, i + 1, current, docs) :
        __yaml_split_docs_loop(lines, i + 1, concat(current, [line]), docs)
    }

export let __yaml_split_docs = source =>
    __yaml_split_docs_loop(__yaml_lines(source), 0, [], [])

export let __yaml_result = (value, next, anchors) => { value = value next = next anchors = anchors }

export let __yaml_unquote_single = text =>
    replace(substr(text, 1, length(text) - 1), "''", "'")

export let __yaml_unquote_double = text => {
    let inner = substr(text, 1, length(text) - 1)
    let s1 = replace(inner, "\\\"", "\"")
    let s2 = replace(s1, "\\n", "\n")
    let s3 = replace(s2, "\\t", "\t")
    replace(s3, "\\\\", "\\")
}

export let __yaml_core_scalar = text => {
    let t = trim(text)
    t == "" || t == "~" || lower(t) == "null" ? null :
    lower(t) == "true" ? true :
    lower(t) == "false" ? false :
    regex_match(t, "^[+-]?[0-9]+$") ? to_int(t) :
    regex_match(t, "^[+-]?([0-9]+\\.[0-9]*|[0-9]*\\.[0-9]+)([eE][+-]?[0-9]+)?$") ? to_float(t) :
    regex_match(t, "^[+-]?[0-9]+[eE][+-]?[0-9]+$") ? to_float(t) :
    t
}

export let __yaml_parse_scalar = (text, anchors) => {
    let t0 = trim(text)
    let t = starts_with(t0, "!!int ") ? trim(substr(t0, 6)) : t0
    starts_with(t, "&") ? {
        let cap = regex_capture(t, "^&([^ ]+) +(.*)$")
        len(cap) == 2 ? {
            let parsed = __yaml_parse_scalar(cap[1], anchors)
            __yaml_is_error(parsed) ? parsed :
            { value = parsed.value anchors = map_set(parsed.anchors, cap[0], parsed.value) }
        } : __codec_error("invalid anchor")
    } :
    starts_with(t, "*") ? {
        let name = substr(t, 1)
        map_has(anchors, name) ? { value = anchors[name] anchors = anchors } : __codec_error("unidentified alias: " + name)
    } :
    starts_with(t, "\"") && !ends_with(t, "\"") ? __codec_error("unterminated double quoted scalar") :
    starts_with(t, "'") && !ends_with(t, "'") ? __codec_error("unterminated single quoted scalar") :
    starts_with(t, "'") && ends_with(t, "'") ? { value = __yaml_unquote_single(t) anchors = anchors } :
    starts_with(t, "\"") && ends_with(t, "\"") ? { value = __yaml_unquote_double(t) anchors = anchors } :
    starts_with(t, "[") && ends_with(t, "]") ? __yaml_parse_flow_seq(substr(t, 1, length(t) - 1), anchors) :
    starts_with(t, "{") && ends_with(t, "}") ? __yaml_parse_flow_map(substr(t, 1, length(t) - 1), anchors) :
    { value = __yaml_core_scalar(t) anchors = anchors }
}

export let __yaml_parse_flow_seq_items = (items, i, acc, anchors) =>
    i >= len(items) ? { value = acc anchors = anchors } : {
        let item = trim(items[i])
        item == "" ? __yaml_parse_flow_seq_items(items, i + 1, acc, anchors) : {
            let parsed = __yaml_parse_scalar(item, anchors)
            __yaml_is_error(parsed) ? parsed :
            __yaml_parse_flow_seq_items(items, i + 1, concat(acc, [parsed.value]), parsed.anchors)
        }
    }

export let __yaml_parse_flow_seq = (inner, anchors) =>
    trim(inner) == "" ? { value = [] anchors = anchors } :
    __yaml_parse_flow_seq_items(split(",", inner), 0, [], anchors)

export let __yaml_flow_pair = item => regex_capture(item, "^([^:]+):(.*)$")

export let __yaml_parse_flow_map_items = (items, i, acc, anchors) =>
    i >= len(items) ? { value = acc anchors = anchors } : {
        let item = trim(items[i])
        item == "" ? __yaml_parse_flow_map_items(items, i + 1, acc, anchors) : {
            let pair = __yaml_flow_pair(item)
            len(pair) != 2 ? __codec_error("expected ':' in flow mapping") : {
                let key = trim(pair[0])
                map_has(acc, key) ? __codec_error("duplicate mapping key: " + key) : {
                    let parsed = __yaml_parse_scalar(pair[1], anchors)
                    __yaml_is_error(parsed) ? parsed :
                    __yaml_parse_flow_map_items(items, i + 1, map_set(acc, key, parsed.value), parsed.anchors)
                }
            }
        }
    }

export let __yaml_parse_flow_map = (inner, anchors) =>
    trim(inner) == "" ? { value = {} anchors = anchors } :
    __yaml_parse_flow_map_items(split(",", inner), 0, {}, anchors)

export let __yaml_collect_block = (lines, i, indent, acc) =>
    i >= len(lines) ? { text = acc next = i } : {
        let line = lines[i]
        trim(line) == "" && i + 1 >= len(lines) ? { text = acc next = i + 1 } :
        trim(line) == "" ? __yaml_collect_block(lines, i + 1, indent, acc + "\n") :
        __yaml_line_indent(line) < indent ? { text = acc next = i } :
        __yaml_collect_block(lines, i + 1, indent, acc + substr(line, indent) + "\n")
    }

export let __yaml_fold_lines = text =>
    replace(replace(text, "\n\n", "__WCL_YAML_BLANK_LINE__"), "\n", " ")

export let __yaml_block_value = (style, block) =>
    starts_with(style, ">") ? replace(__yaml_fold_lines(block.text), "__WCL_YAML_BLANK_LINE__", "\n") : block.text

export let __yaml_collect_flow = (lines, i, acc) =>
    i >= len(lines) ? __codec_error("unterminated flow collection") : {
        let part = trim(__yaml_strip_comment(lines[i]))
        let acc2 = acc + " " + part
        contains(part, "}") || contains(part, "]") ? { text = acc2 next = i + 1 } :
        __yaml_collect_flow(lines, i + 1, acc2)
    }

export let __yaml_parse_node = (lines, i, indent, anchors) => {
    let j = __yaml_skip_ignored(lines, i)
    j >= len(lines) ? __yaml_result(null, j, anchors) : {
        let line = lines[j]
        let clean = __yaml_strip_comment(line)
        let actual = __yaml_line_indent(line)
        actual < indent ? __yaml_result(null, j, anchors) :
        starts_with(trim(clean), "|") || starts_with(trim(clean), ">") ? {
            let block = __yaml_collect_block(lines, j + 1, 0, "")
            __yaml_result(__yaml_block_value(trim(clean), block), block.next, anchors)
        } :
        starts_with(substr(line, actual), "-") ? __yaml_parse_seq(lines, j, actual, [], anchors) :
        contains(clean, ":") ? __yaml_parse_map(lines, j, actual, {}, anchors) : {
            let parsed = __yaml_parse_scalar(clean, anchors)
            __yaml_is_error(parsed) ? parsed : __yaml_result(parsed.value, j + 1, parsed.anchors)
        }
    }
}

export let __yaml_parse_map = (lines, i, indent, acc, anchors) => {
    let j = __yaml_skip_ignored(lines, i)
    j >= len(lines) ? __yaml_result(acc, j, anchors) : {
        let line = lines[j]
        let clean = __yaml_strip_comment(line)
        let actual = __yaml_line_indent(line)
        actual < indent ? __yaml_result(acc, j, anchors) :
        actual != indent ? __yaml_result(acc, j, anchors) : {
            let pair = regex_capture(substr(clean, indent), "^([^:]+):(.*)$")
            len(pair) != 2 ? __yaml_result(acc, j, anchors) : {
                let key = trim(pair[0])
                let rest = trim(pair[1])
                map_has(acc, key) ? __codec_error("duplicate mapping key: " + key) :
                rest == "" ? {
                    let child = __yaml_parse_node(lines, j + 1, indent + 2, anchors)
                    __yaml_is_error(child) ? child :
                    __yaml_parse_map(lines, child.next, indent, map_set(acc, key, child.value), child.anchors)
                } :
                starts_with(rest, "|") || starts_with(rest, ">") ? {
                    let block = __yaml_collect_block(lines, j + 1, indent + 2, "")
                    __yaml_parse_map(lines, block.next, indent, map_set(acc, key, __yaml_block_value(rest, block)), anchors)
                } :
                (starts_with(rest, "{") && !ends_with(rest, "}")) || (starts_with(rest, "[") && !ends_with(rest, "]")) ? {
                    let flow = __yaml_collect_flow(lines, j + 1, rest)
                    __yaml_is_error(flow) ? flow : {
                        let parsed = __yaml_parse_scalar(flow.text, anchors)
                        __yaml_is_error(parsed) ? parsed :
                        __yaml_parse_map(lines, flow.next, indent, map_set(acc, key, parsed.value), parsed.anchors)
                    }
                } : {
                    let parsed = __yaml_parse_scalar(rest, anchors)
                    __yaml_is_error(parsed) ? parsed :
                    __yaml_parse_map(lines, j + 1, indent, map_set(acc, key, parsed.value), parsed.anchors)
                }
            }
        }
    }
}

export let __yaml_parse_seq_inline_map = (rest, lines, j, indent, anchors) => {
    let pair = regex_capture(rest, "^([^:]+):(.*)$")
    len(pair) != 2 ? __codec_error("expected sequence mapping") : {
        let key = trim(pair[0])
        let value_text = trim(pair[1])
        value_text == "" ? {
            let child = __yaml_parse_node(lines, j + 1, indent + 2, anchors)
            __yaml_is_error(child) ? child :
            __yaml_result(map_set({}, key, child.value), child.next, child.anchors)
        } :
        starts_with(value_text, "|") || starts_with(value_text, ">") ? {
            let block_indent = contains(value_text, "2") ? indent + 4 : indent + 2
            let block = __yaml_collect_block(lines, j + 1, block_indent, "")
            let first = map_set({}, key, __yaml_block_value(value_text, block))
            let more = __yaml_parse_map(lines, block.next, indent + 2, first, anchors)
            __yaml_is_error(more) ? more : __yaml_result(more.value, more.next, more.anchors)
        } : {
            let parsed = __yaml_parse_scalar(value_text, anchors)
            __yaml_is_error(parsed) ? parsed : {
                let first = map_set({}, key, parsed.value)
                let more = __yaml_parse_map(lines, j + 1, indent + 2, first, parsed.anchors)
                __yaml_is_error(more) ? more : __yaml_result(more.value, more.next, more.anchors)
            }
        }
    }
}

export let __yaml_parse_seq = (lines, i, indent, acc, anchors) => {
    let j = __yaml_skip_ignored(lines, i)
    j >= len(lines) ? __yaml_result(acc, j, anchors) : {
        let line = lines[j]
        let actual = __yaml_line_indent(line)
        actual < indent ? __yaml_result(acc, j, anchors) :
        actual != indent ? __yaml_result(acc, j, anchors) : {
            let stripped = substr(line, indent)
            !starts_with(stripped, "-") ? __yaml_result(acc, j, anchors) : {
                let rest = trim(substr(stripped, 1))
                rest == "" ? {
                    let child = __yaml_parse_node(lines, j + 1, indent + 2, anchors)
                    __yaml_is_error(child) ? child :
                    __yaml_parse_seq(lines, child.next, indent, concat(acc, [child.value]), child.anchors)
                } :
                contains(rest, ":") && !starts_with(rest, "\"") && !starts_with(rest, "'") && !starts_with(rest, "{") ? {
                    let item = __yaml_parse_seq_inline_map(rest, lines, j, indent, anchors)
                    __yaml_is_error(item) ? item :
                    __yaml_parse_seq(lines, item.next, indent, concat(acc, [item.value]), item.anchors)
                } :
                starts_with(rest, "|") || starts_with(rest, ">") ? {
                    let block = __yaml_collect_block(lines, j + 1, indent + 2, "")
                    __yaml_parse_seq(lines, block.next, indent, concat(acc, [__yaml_block_value(rest, block)]), anchors)
                } : {
                    let parsed = __yaml_parse_scalar(__yaml_strip_comment(rest), anchors)
                    __yaml_is_error(parsed) ? parsed :
                    __yaml_parse_seq(lines, j + 1, indent, concat(acc, [parsed.value]), parsed.anchors)
                }
            }
        }
    }
}

export let __yaml_parse_doc = lines => {
    let parsed = __yaml_parse_node(lines, 0, 0, {})
    __yaml_is_error(parsed) ? parsed : {
        let next = __yaml_skip_ignored(lines, parsed.next)
        next >= len(lines) ? parsed.value : __codec_error("unexpected content after YAML document")
    }
}

export let __yaml_records_from_doc = value =>
    type_of(value) == "list" ? value : [value]

export let __yaml_parse_docs = (docs, i, acc) =>
    i >= len(docs) ? acc : {
        let value = __yaml_parse_doc(docs[i])
        __yaml_is_error(value) ? value :
        __yaml_parse_docs(docs, i + 1, concat(acc, __yaml_records_from_doc(value)))
    }

export let __yaml_parser_all = tokens => {
    let source = tokens.expect_kind(:source, "expected YAML source")
    __yaml_is_error(source) ? source :
    __yaml_parse_docs(__yaml_split_docs(source.value), 0, [])
}

export let __yaml_needs_quote = s =>
    s == "" || contains(s, ":") || starts_with(s, "-") || starts_with(s, "#") || starts_with(s, "{") || starts_with(s, "[") || contains(s, "\n")

export let __yaml_quote = s => "\"" + replace(replace(replace(s, "\\", "\\\\"), "\"", "\\\""), "\n", "\\n") + "\""

export let __yaml_scalar_render = value =>
    type_of(value) == "null" ? "null" :
    type_of(value) == "bool" ? to_string(value) :
    type_of(value) == "int" ? to_string(value) :
    type_of(value) == "bigint" ? to_string(value) :
    type_of(value) == "float" ? to_string(value) :
    type_of(value) == "symbol" ? __yaml_quote(substr(to_string(value), 1)) :
    type_of(value) == "identifier" ? __yaml_quote(to_string(value)) :
    type_of(value) == "string" ? (__yaml_needs_quote(value) ? __yaml_quote(value) : value) :
    "null"

export let __yaml_indent = level =>
    level <= 0 ? "" : "  " + __yaml_indent(level - 1)

export let __yaml_render = (value, level) =>
    type_of(value) == "list" ? __yaml_render_list(value, level) :
    type_of(value) == "map" ? __yaml_render_map(value, level) :
    __yaml_scalar_render(value)

export let __yaml_render_list = (value, level) =>
    len(value) == 0 ? "[]" :
    join("\n", map(value, item =>
        type_of(item) == "map" || type_of(item) == "list" ?
            __yaml_indent(level) + "-\n" + __yaml_indent_block(__yaml_render(item, level + 1), level + 1) :
            __yaml_indent(level) + "- " + __yaml_render(item, level + 1)
    ))

export let __yaml_render_map = (value, level) =>
    len(keys(value)) == 0 ? "{}" :
    join("\n", map(keys(value), key =>
        type_of(value[key]) == "map" || type_of(value[key]) == "list" ?
            __yaml_indent(level) + key + ":\n" + __yaml_indent_block(__yaml_render(value[key], level + 1), level + 1) :
            __yaml_indent(level) + key + ": " + __yaml_render(value[key], level + 1)
    ))

export let __yaml_indent_block = (text, level) =>
    join("\n", map(split("\n", text), line => __yaml_indent(level) + line))

export let __yaml_encoder_all = records =>
    __yaml_render(records, 0) + "\n"

codec yaml {
    mode = :text
    tokenizer = cursor => __yaml_tokenizer(cursor)
    parser_all = tokens => __yaml_parser_all(tokens)
    encoder = record => __yaml_render(record, 0) + "\n"
    encoder_all = records => __yaml_encoder_all(records)
}

export let __toml_tokenizer = cursor =>
    cursor.eof() ? null : {
        let start = cursor.pos()
        let text = cursor.take(cursor.len())
        { kind = :source, text = text, start = start, end = cursor.pos(), value = text }
    }

export let __toml_lines = source =>
    split("\n", replace(replace(source, "\r\n", "\n"), "\r", "\n"))

export let __toml_strip_comment_chars = (line, i, quote, acc) =>
    i >= length(line) ? acc : {
        let ch = substr(line, i, i + 1)
        quote == "" && ch == "#" ? acc :
        quote == "" && ch == "\"" ? __toml_strip_comment_chars(line, i + 1, "\"", acc + ch) :
        quote == "" && ch == "'" ? __toml_strip_comment_chars(line, i + 1, "'", acc + ch) :
        quote == "\"" && ch == "\\" ? __toml_strip_comment_chars(line, i + 2, quote, acc + substr(line, i, i + 2)) :
        quote == ch ? __toml_strip_comment_chars(line, i + 1, "", acc + ch) :
        __toml_strip_comment_chars(line, i + 1, quote, acc + ch)
    }

export let __toml_strip_comment = line => trim(__toml_strip_comment_chars(line, 0, "", ""))

export let __toml_split_top_loop = (text, sep, i, depth, quote, current, acc) =>
    i >= length(text) ? concat(acc, [current]) : {
        let ch = substr(text, i, i + 1)
        quote == "" && (ch == "\"" || ch == "'") ? __toml_split_top_loop(text, sep, i + 1, depth, ch, current + ch, acc) :
        quote != "" && quote == "\"" && ch == "\\" ? __toml_split_top_loop(text, sep, i + 2, depth, quote, current + substr(text, i, i + 2), acc) :
        quote != "" && ch == quote ? __toml_split_top_loop(text, sep, i + 1, depth, "", current + ch, acc) :
        quote != "" ? __toml_split_top_loop(text, sep, i + 1, depth, quote, current + ch, acc) :
        ch == "[" || ch == "{" ? __toml_split_top_loop(text, sep, i + 1, depth + 1, quote, current + ch, acc) :
        ch == "]" || ch == "}" ? __toml_split_top_loop(text, sep, i + 1, depth - 1, quote, current + ch, acc) :
        depth == 0 && ch == sep ? __toml_split_top_loop(text, sep, i + 1, depth, quote, "", concat(acc, [current])) :
        __toml_split_top_loop(text, sep, i + 1, depth, quote, current + ch, acc)
    }

export let __toml_split_top = (text, sep) => __toml_split_top_loop(text, sep, 0, 0, "", "", [])

export let __toml_find_equals_loop = (text, i, quote) =>
    i >= length(text) ? -1 : {
        let ch = substr(text, i, i + 1)
        quote == "" && (ch == "\"" || ch == "'") ? __toml_find_equals_loop(text, i + 1, ch) :
        quote != "" && quote == "\"" && ch == "\\" ? __toml_find_equals_loop(text, i + 2, quote) :
        quote != "" && ch == quote ? __toml_find_equals_loop(text, i + 1, "") :
        quote == "" && ch == "=" ? i :
        __toml_find_equals_loop(text, i + 1, quote)
    }

export let __toml_key_part = part => {
    let p = trim(part)
    starts_with(p, "\"") && ends_with(p, "\"") ? __json_read_string_like(substr(p, 1, length(p) - 1)) :
    starts_with(p, "'") && ends_with(p, "'") ? substr(p, 1, length(p) - 1) :
    p
}

export let __json_read_string_like = s => {
    let s1 = replace(s, "\\\"", "\"")
    let s2 = replace(s1, "\\n", "\n")
    let s3 = replace(s2, "\\t", "\t")
    let s4 = replace(s3, "\\r", "\r")
    replace(s4, "\\\\", "\\")
}

export let __toml_parse_key = text => map(__toml_split_top(text, "."), part => __toml_key_part(part))

export let __toml_parse_basic_string = text =>
    __json_read_string_like(substr(text, 1, length(text) - 1))

export let __toml_parse_literal_string = text =>
    substr(text, 1, length(text) - 1)

export let __toml_clean_num = text => replace(text, "_", "")

export let __toml_parse_value = text => {
    let t = trim(text)
    t == "" ? __codec_error("missing TOML value") :
    starts_with(t, "\"") && ends_with(t, "\"") ? __toml_parse_basic_string(t) :
    starts_with(t, "'") && ends_with(t, "'") ? __toml_parse_literal_string(t) :
    starts_with(t, "[") && ends_with(t, "]") ? __toml_parse_array(substr(t, 1, length(t) - 1)) :
    starts_with(t, "{") && ends_with(t, "}") ? __toml_parse_inline_table(substr(t, 1, length(t) - 1)) :
    t == "true" ? true :
    t == "false" ? false :
    regex_match(t, "^[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:[0-9]{2})$") ? offset_datetime(t) :
    regex_match(t, "^[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?$") ? local_datetime(t) :
    regex_match(t, "^[0-9]{4}-[0-9]{2}-[0-9]{2}$") ? date(t) :
    regex_match(t, "^[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?$") ? local_time(t) :
    t == "inf" || t == "+inf" ? to_float("inf") :
    t == "-inf" ? to_float("-inf") :
    t == "nan" || t == "+nan" || t == "-nan" ? to_float("NaN") :
    regex_match(t, "^[+-]?([0-9][0-9_]*\\.[0-9][0-9_]*|[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*|[0-9][0-9_]*\\.[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*)$") ? to_float(__toml_clean_num(t)) :
    regex_match(t, "^[+-]?[0-9][0-9_]*$") ? to_int(__toml_clean_num(t)) :
    regex_match(t, "^0x[0-9A-Fa-f_]+$") ? __codec_error("hex TOML integers are not supported yet") :
    __codec_error("invalid TOML value: " + t)
}

export let __toml_parse_array_items = (items, i, acc) =>
    i >= len(items) ? acc : {
        let item = trim(items[i])
        item == "" ? __toml_parse_array_items(items, i + 1, acc) : {
            let value = __toml_parse_value(item)
            __codec_is_error(value) ? value : __toml_parse_array_items(items, i + 1, concat(acc, [value]))
        }
    }

export let __toml_parse_array = inner => __toml_parse_array_items(__toml_split_top(inner, ","), 0, [])

export let __toml_parse_inline_items = (items, i, acc) =>
    i >= len(items) ? acc : {
        let item = trim(items[i])
        item == "" ? __toml_parse_inline_items(items, i + 1, acc) : {
            let eq = __toml_find_equals_loop(item, 0, "")
            eq < 0 ? __codec_error("expected '=' in inline table") : {
                let key = __toml_key_part(substr(item, 0, eq))
                let value = __toml_parse_value(substr(item, eq + 1))
                __codec_is_error(value) ? value :
                map_has(acc, key) ? __codec_error("duplicate TOML key: " + key) :
                __toml_parse_inline_items(items, i + 1, map_set(acc, key, value))
            }
        }
    }

export let __toml_parse_inline_table = inner => __toml_parse_inline_items(__toml_split_top(inner, ","), 0, {})

export let __toml_set_path = (root, path, value) =>
    len(path) == 0 ? value :
    len(path) == 1 ? (map_has(root, path[0]) ? __codec_error("duplicate TOML key: " + path[0]) : map_set(root, path[0], value)) : {
        let key = path[0]
        let child = map_has(root, key) ? root[key] : {}
        type_of(child) != "map" ? __codec_error("TOML key is not a table: " + key) : {
            let updated = __toml_set_path(child, substr_list(path, 1), value)
            __codec_is_error(updated) ? updated : map_set(root, key, updated)
        }
    }

export let substr_list = (items, start) =>
    start >= len(items) ? [] : concat([items[start]], substr_list(items, start + 1))

export let __toml_get_path = (root, path) =>
    len(path) == 0 ? root :
    map_has(root, path[0]) ? __toml_get_path(root[path[0]], substr_list(path, 1)) : {}

export let __toml_set_current = (root, current, key_path, value) =>
    __toml_set_path(root, concat(current, key_path), value)

export let __toml_replace_last = (items, value) =>
    len(items) == 0 ? [value] :
    len(items) == 1 ? [value] :
    concat([items[0]], __toml_replace_last(substr_list(items, 1), value))

export let __toml_set_array_current = (root, array_key, key_path, value) => {
    let arr = map_has(root, array_key) ? root[array_key] : []
    let current = len(arr) == 0 ? {} : arr[len(arr) - 1]
    let updated = __toml_set_path(current, key_path, value)
    __codec_is_error(updated) ? updated : map_set(root, array_key, __toml_replace_last(arr, updated))
}

export let __toml_parse_lines = (lines, i, root, current, array_key) =>
    i >= len(lines) ? root : {
        let line = __toml_strip_comment(lines[i])
        line == "" ? __toml_parse_lines(lines, i + 1, root, current, array_key) :
        starts_with(line, "[[") && ends_with(line, "]]") ? {
            let key = __toml_key_part(substr(line, 2, length(line) - 2))
            let arr = map_has(root, key) ? root[key] : []
            type_of(arr) != "list" ? __codec_error("TOML array of tables conflicts with key: " + key) :
            __toml_parse_lines(lines, i + 1, map_set(root, key, concat(arr, [{}])), [], key)
        } :
        starts_with(line, "[") && ends_with(line, "]") ? {
            let path = __toml_parse_key(substr(line, 1, length(line) - 1))
            let ensured = __toml_set_path(root, path, __toml_get_path(root, path))
            __codec_is_error(ensured) ? ensured : __toml_parse_lines(lines, i + 1, ensured, path, "")
        } : {
            let eq = __toml_find_equals_loop(line, 0, "")
            eq < 0 ? __codec_error("expected '=' in TOML key/value") : {
                let key_path = __toml_parse_key(substr(line, 0, eq))
                let value = __toml_parse_value(substr(line, eq + 1))
                __codec_is_error(value) ? value : {
                    let updated = array_key == "" ? __toml_set_current(root, current, key_path, value) : __toml_set_array_current(root, array_key, key_path, value)
                    __codec_is_error(updated) ? updated : __toml_parse_lines(lines, i + 1, updated, current, array_key)
                }
            }
        }
    }

export let __toml_first_record_key = (root, ks, i) =>
    i >= len(ks) ? "" :
    type_of(root[ks[i]]) == "list" && every(root[ks[i]], item => type_of(item) == "map") ? ks[i] :
    __toml_first_record_key(root, ks, i + 1)

export let __toml_records_from_root = root => {
    let record_key = __toml_first_record_key(root, keys(root), 0)
    record_key == "" ? [root] : root[record_key]
}

export let __toml_parser_all = tokens => {
    let source = tokens.expect_kind(:source, "expected TOML source")
    __codec_is_error(source) ? source : {
        let root = __toml_parse_lines(__toml_lines(source.value), 0, {}, [], "")
        __codec_is_error(root) ? root : __toml_records_from_root(root)
    }
}

export let __toml_quote = s => "\"" + replace(replace(replace(replace(s, "\\", "\\\\"), "\"", "\\\""), "\n", "\\n"), "\t", "\\t") + "\""

export let __toml_bare_key = key =>
    regex_match(key, "^[A-Za-z0-9_-]+$") ? key : __toml_quote(key)

export let __toml_temporal_text = value => {
    let s = to_string(value)
    type_of(value) == "date" ? substr(s, 2, length(s) - 1) :
    type_of(value) == "offset_datetime" ? substr(s, 4, length(s) - 1) :
    type_of(value) == "local_datetime" ? substr(s, 4, length(s) - 1) :
    type_of(value) == "local_time" ? substr(s, 3, length(s) - 1) :
    s
}

export let __toml_render_value = value =>
    type_of(value) == "string" ? __toml_quote(value) :
    type_of(value) == "int" || type_of(value) == "bigint" || type_of(value) == "float" ? to_string(value) :
    type_of(value) == "bool" ? to_string(value) :
    type_of(value) == "date" || type_of(value) == "offset_datetime" || type_of(value) == "local_datetime" || type_of(value) == "local_time" ? __toml_temporal_text(value) :
    type_of(value) == "list" ? "[" + join(", ", map(value, item => __toml_render_value(item))) + "]" :
    type_of(value) == "map" ? "{ " + join(", ", map(keys(value), key => __toml_bare_key(key) + " = " + __toml_render_value(value[key]))) + " }" :
    __toml_quote(to_string(value))

export let __toml_render_scalars = value =>
    join("", map(keys(value), key =>
        type_of(value[key]) == "map" ? "" :
        type_of(value[key]) == "list" && every(value[key], item => type_of(item) == "map") ? "" :
        __toml_bare_key(key) + " = " + __toml_render_value(value[key]) + "\n"
    ))

export let __toml_render_tables = (value, prefix) =>
    join("", map(keys(value), key =>
        type_of(value[key]) == "map" ?
            "\n[" + (prefix == "" ? __toml_bare_key(key) : prefix + "." + __toml_bare_key(key)) + "]\n" +
            __toml_render_map(value[key], prefix == "" ? __toml_bare_key(key) : prefix + "." + __toml_bare_key(key)) :
        type_of(value[key]) == "list" && every(value[key], item => type_of(item) == "map") ?
            join("", map(value[key], item => "\n[[" + (prefix == "" ? __toml_bare_key(key) : prefix + "." + __toml_bare_key(key)) + "]]\n" + __toml_render_map(item, prefix == "" ? __toml_bare_key(key) : prefix + "." + __toml_bare_key(key)))) :
        ""
    ))

export let __toml_render_map = (value, prefix) =>
    __toml_render_scalars(value) + __toml_render_tables(value, prefix)

export let __toml_encoder_all = records =>
    len(records) == 1 ? __toml_render_map(records[0], "") :
    join("", map(records, record => "[[records]]\n" + __toml_render_map(record, "records") + "\n"))

codec toml {
    mode = :text
    tokenizer = cursor => __toml_tokenizer(cursor)
    parser_all = tokens => __toml_parser_all(tokens)
    encoder = record => __toml_render_map(record, "")
    encoder_all = records => __toml_encoder_all(records)
}

export let __msgpack_tokenizer = cursor =>
    cursor.eof() ? null : {
        let start = cursor.pos()
        let data = cursor.take(cursor.len())
        { kind = :source, start = start, end = cursor.pos(), value = data }
    }

export let __msgpack_error = message => __codec_error(message)
export let __msgpack_is_error = value => __codec_is_error(value)
export let __msgpack_state = (data, pos) => { data = data pos = pos }
export let __msgpack_ok = (state, value) => { state = state value = value }
export let __msgpack_eof = state => state.pos >= len(state.data)
export let __msgpack_slice = (items, start, count, i, acc) =>
    i >= count ? acc : __msgpack_slice(items, start, count, i + 1, concat(acc, [items[start + i]]))

export let __msgpack_take = (state, n, message) =>
    state.pos + n > len(state.data) ? __msgpack_error(message) :
    __msgpack_ok(__msgpack_state(state.data, state.pos + n), __msgpack_slice(state.data, state.pos, n, 0, []))

export let __msgpack_byte = (state, message) => {
    let taken = __msgpack_take(state, 1, message)
    __msgpack_is_error(taken) ? taken : __msgpack_ok(taken.state, taken.value[0])
}

export let __msgpack_uint = (state, n, message) => {
    let taken = __msgpack_take(state, n, message)
    __msgpack_is_error(taken) ? taken : __msgpack_ok(taken.state, bytes_to_uint_be(taken.value))
}

export let __msgpack_int = (state, n, message) => {
    let taken = __msgpack_take(state, n, message)
    __msgpack_is_error(taken) ? taken : __msgpack_ok(taken.state, bytes_to_int_be(taken.value))
}

export let __msgpack_str = (state, n) => {
    let taken = __msgpack_take(state, n, "unexpected EOF in MessagePack string")
    __msgpack_is_error(taken) ? taken : {
        let text = bytes_to_utf8(taken.value)
        __msgpack_is_error(text) ? text : __msgpack_ok(taken.state, text)
    }
}

export let __msgpack_bin = (state, n) => {
    let taken = __msgpack_take(state, n, "unexpected EOF in MessagePack binary")
    __msgpack_is_error(taken) ? taken : __msgpack_ok(taken.state, bytes(taken.value))
}

export let __msgpack_ext_type_id = byte => byte >= 128 ? byte - 256 : byte

export let __msgpack_timestamp_from_ext = data =>
    len(data) == 4 ? msgpack_timestamp(bytes_to_uint_be(data), 0) :
    len(data) == 8 ? {
        let raw = bytes_to_uint_be(data)
        let seconds = raw % 17179869184
        let nanos = raw / 17179869184
        msgpack_timestamp(seconds, nanos)
    } :
    len(data) == 12 ? {
        let nanos = bytes_to_uint_be(__msgpack_slice(data, 0, 4, 0, []))
        let seconds = bytes_to_int_be(__msgpack_slice(data, 4, 8, 0, []))
        msgpack_timestamp(seconds, nanos)
    } :
    __msgpack_error("invalid MessagePack timestamp extension length")

export let __msgpack_ext = (state, n) => {
    let type_byte = __msgpack_byte(state, "unexpected EOF in MessagePack extension type")
    __msgpack_is_error(type_byte) ? type_byte : {
        let data = __msgpack_take(type_byte.state, n, "unexpected EOF in MessagePack extension data")
        __msgpack_is_error(data) ? data : {
            let type_id = __msgpack_ext_type_id(type_byte.value)
            let value = type_id == 0 - 1 ? __msgpack_timestamp_from_ext(data.value) : msgpack_ext(type_id, data.value)
            __msgpack_is_error(value) ? value : __msgpack_ok(data.state, value)
        }
    }
}

export let __msgpack_parse_array_items = (state, count, i, acc) =>
    i >= count ? __msgpack_ok(state, acc) : {
        let item = __msgpack_parse_value(state)
        __msgpack_is_error(item) ? item : __msgpack_parse_array_items(item.state, count, i + 1, concat(acc, [item.value]))
    }

export let __msgpack_map_entry = (key, value) => { key = key value = value }

export let __msgpack_parse_map_entries = (state, count, i, entries) =>
    i >= count ? __msgpack_ok(state, entries) : {
        let key = __msgpack_parse_value(state)
        __msgpack_is_error(key) ? key : {
            let value = __msgpack_parse_value(key.state)
            __msgpack_is_error(value) ? value :
            __msgpack_parse_map_entries(value.state, count, i + 1, concat(entries, [__msgpack_map_entry(key.value, value.value)]))
        }
    }

export let __msgpack_all_string_keys = (entries, i) =>
    i >= len(entries) ? true :
    type_of(entries[i].key) == "string" ? __msgpack_all_string_keys(entries, i + 1) : false

export let __msgpack_entries_to_map = (entries, i, acc) =>
    i >= len(entries) ? acc :
    __msgpack_entries_to_map(entries, i + 1, map_set(acc, entries[i].key, entries[i].value))

export let __msgpack_entries_to_pair_maps = (entries, i, acc) =>
    i >= len(entries) ? acc :
    __msgpack_entries_to_pair_maps(entries, i + 1, concat(acc, [{ key = entries[i].key value = entries[i].value }]))

export let __msgpack_map_value = entries =>
    __msgpack_all_string_keys(entries, 0) ?
        __msgpack_entries_to_map(entries, 0, {}) :
        { __msgpack_type = "map" entries = __msgpack_entries_to_pair_maps(entries, 0, []) }

export let __msgpack_parse_map = (state, count) => {
    let entries = __msgpack_parse_map_entries(state, count, 0, [])
    __msgpack_is_error(entries) ? entries : __msgpack_ok(entries.state, __msgpack_map_value(entries.value))
}

export let __msgpack_parse_value = state => {
    let h = __msgpack_byte(state, "unexpected EOF in MessagePack value")
    __msgpack_is_error(h) ? h : {
        let b = h.value
        b <= 127 ? __msgpack_ok(h.state, b) :
        b >= 224 ? __msgpack_ok(h.state, b - 256) :
        b >= 128 && b <= 143 ? __msgpack_parse_map(h.state, b - 128) :
        b >= 144 && b <= 159 ? {
            let arr = __msgpack_parse_array_items(h.state, b - 144, 0, [])
            __msgpack_is_error(arr) ? arr : __msgpack_ok(arr.state, arr.value)
        } :
        b >= 160 && b <= 191 ? __msgpack_str(h.state, b - 160) :
        b == 192 ? __msgpack_ok(h.state, null) :
        b == 194 ? __msgpack_ok(h.state, false) :
        b == 195 ? __msgpack_ok(h.state, true) :
        b == 196 ? { let n = __msgpack_uint(h.state, 1, "unexpected EOF in bin8 length") __msgpack_is_error(n) ? n : __msgpack_bin(n.state, n.value) } :
        b == 197 ? { let n = __msgpack_uint(h.state, 2, "unexpected EOF in bin16 length") __msgpack_is_error(n) ? n : __msgpack_bin(n.state, n.value) } :
        b == 198 ? { let n = __msgpack_uint(h.state, 4, "unexpected EOF in bin32 length") __msgpack_is_error(n) ? n : __msgpack_bin(n.state, n.value) } :
        b == 199 ? { let n = __msgpack_uint(h.state, 1, "unexpected EOF in ext8 length") __msgpack_is_error(n) ? n : __msgpack_ext(n.state, n.value) } :
        b == 200 ? { let n = __msgpack_uint(h.state, 2, "unexpected EOF in ext16 length") __msgpack_is_error(n) ? n : __msgpack_ext(n.state, n.value) } :
        b == 201 ? { let n = __msgpack_uint(h.state, 4, "unexpected EOF in ext32 length") __msgpack_is_error(n) ? n : __msgpack_ext(n.state, n.value) } :
        b == 202 ? { let bs = __msgpack_take(h.state, 4, "unexpected EOF in float32") __msgpack_is_error(bs) ? bs : __msgpack_ok(bs.state, bytes_to_f32_be(bs.value)) } :
        b == 203 ? { let bs = __msgpack_take(h.state, 8, "unexpected EOF in float64") __msgpack_is_error(bs) ? bs : __msgpack_ok(bs.state, bytes_to_f64_be(bs.value)) } :
        b == 204 ? __msgpack_uint(h.state, 1, "unexpected EOF in uint8") :
        b == 205 ? __msgpack_uint(h.state, 2, "unexpected EOF in uint16") :
        b == 206 ? __msgpack_uint(h.state, 4, "unexpected EOF in uint32") :
        b == 207 ? __msgpack_uint(h.state, 8, "unexpected EOF in uint64") :
        b == 208 ? __msgpack_int(h.state, 1, "unexpected EOF in int8") :
        b == 209 ? __msgpack_int(h.state, 2, "unexpected EOF in int16") :
        b == 210 ? __msgpack_int(h.state, 4, "unexpected EOF in int32") :
        b == 211 ? __msgpack_int(h.state, 8, "unexpected EOF in int64") :
        b == 212 ? __msgpack_ext(h.state, 1) :
        b == 213 ? __msgpack_ext(h.state, 2) :
        b == 214 ? __msgpack_ext(h.state, 4) :
        b == 215 ? __msgpack_ext(h.state, 8) :
        b == 216 ? __msgpack_ext(h.state, 16) :
        b == 217 ? { let n = __msgpack_uint(h.state, 1, "unexpected EOF in str8 length") __msgpack_is_error(n) ? n : __msgpack_str(n.state, n.value) } :
        b == 218 ? { let n = __msgpack_uint(h.state, 2, "unexpected EOF in str16 length") __msgpack_is_error(n) ? n : __msgpack_str(n.state, n.value) } :
        b == 219 ? { let n = __msgpack_uint(h.state, 4, "unexpected EOF in str32 length") __msgpack_is_error(n) ? n : __msgpack_str(n.state, n.value) } :
        b == 220 ? { let n = __msgpack_uint(h.state, 2, "unexpected EOF in array16 length") __msgpack_is_error(n) ? n : __msgpack_parse_array_items(n.state, n.value, 0, []) } :
        b == 221 ? { let n = __msgpack_uint(h.state, 4, "unexpected EOF in array32 length") __msgpack_is_error(n) ? n : __msgpack_parse_array_items(n.state, n.value, 0, []) } :
        b == 222 ? { let n = __msgpack_uint(h.state, 2, "unexpected EOF in map16 length") __msgpack_is_error(n) ? n : __msgpack_parse_map(n.state, n.value) } :
        b == 223 ? { let n = __msgpack_uint(h.state, 4, "unexpected EOF in map32 length") __msgpack_is_error(n) ? n : __msgpack_parse_map(n.state, n.value) } :
        __msgpack_error("reserved MessagePack marker")
    }
}

export let __msgpack_parser_all = tokens => {
    let source = tokens.expect_kind(:source, "expected MessagePack source")
    __codec_is_error(source) ? source : {
        let parsed = __msgpack_parse_value(__msgpack_state(source.value, 0))
        __msgpack_is_error(parsed) ? parsed :
        __msgpack_eof(parsed.state) == false ? __msgpack_error("trailing bytes after MessagePack value") :
        type_of(parsed.value) == "list" ? parsed.value : [parsed.value]
    }
}

export let __msgpack_str_prefix = n =>
    n < 32 ? [160 + n] :
    n <= 255 ? concat([217], uint_to_bytes_be(n, 1)) :
    n <= 65535 ? concat([218], uint_to_bytes_be(n, 2)) :
    concat([219], uint_to_bytes_be(n, 4))

export let __msgpack_bin_prefix = n =>
    n <= 255 ? concat([196], uint_to_bytes_be(n, 1)) :
    n <= 65535 ? concat([197], uint_to_bytes_be(n, 2)) :
    concat([198], uint_to_bytes_be(n, 4))

export let __msgpack_array_prefix = n =>
    n < 16 ? [144 + n] :
    n <= 65535 ? concat([220], uint_to_bytes_be(n, 2)) :
    concat([221], uint_to_bytes_be(n, 4))

export let __msgpack_map_prefix = n =>
    n < 16 ? [128 + n] :
    n <= 65535 ? concat([222], uint_to_bytes_be(n, 2)) :
    concat([223], uint_to_bytes_be(n, 4))

export let __msgpack_encode_str = text => {
    let bs = utf8_to_bytes(text)
    concat(__msgpack_str_prefix(len(bs)), bs)
}

export let __msgpack_encode_bin = value => {
    let bs = bytes_data(value)
    concat(__msgpack_bin_prefix(len(bs)), bs)
}

export let __msgpack_encode_int = n =>
    n >= 0 && n <= 127 ? [n] :
    n < 0 && n >= 0 - 32 ? [256 + n] :
    n >= 0 && n <= 255 ? concat([204], uint_to_bytes_be(n, 1)) :
    n >= 0 && n <= 65535 ? concat([205], uint_to_bytes_be(n, 2)) :
    n >= 0 && n <= 4294967295 ? concat([206], uint_to_bytes_be(n, 4)) :
    n >= 0 ? concat([207], uint_to_bytes_be(n, 8)) :
    n >= 0 - 128 ? concat([208], int_to_bytes_be(n, 1)) :
    n >= 0 - 32768 ? concat([209], int_to_bytes_be(n, 2)) :
    n >= 0 - 2147483648 ? concat([210], int_to_bytes_be(n, 4)) :
    concat([211], int_to_bytes_be(n, 8))

export let __msgpack_encode_array_items = (items, i, acc) =>
    i >= len(items) ? acc : {
        let encoded = __msgpack_encode_value(items[i])
        __msgpack_is_error(encoded) ? encoded : __msgpack_encode_array_items(items, i + 1, concat(acc, encoded))
    }

export let __msgpack_encode_array = items => {
    let body = __msgpack_encode_array_items(items, 0, [])
    __msgpack_is_error(body) ? body :
    concat(__msgpack_array_prefix(len(items)), body)
}

export let __msgpack_encode_map_pairs = (pairs, i, acc) =>
    i >= len(pairs) ? acc : {
        let key = __msgpack_encode_value(pairs[i].key)
        __msgpack_is_error(key) ? key : {
            let value = __msgpack_encode_value(pairs[i].value)
            __msgpack_is_error(value) ? value : __msgpack_encode_map_pairs(pairs, i + 1, concat(concat(acc, key), value))
        }
    }

export let __msgpack_map_key_pairs = (mapv, ks, i, acc) =>
    i >= len(ks) ? acc :
    __msgpack_map_key_pairs(mapv, ks, i + 1, concat(acc, [{ key = ks[i] value = mapv[ks[i]] }]))

export let __msgpack_is_pair_map = value =>
    type_of(value) == "map" && map_has(value, "__msgpack_type") && value.__msgpack_type == "map" && map_has(value, "entries")

export let __msgpack_encode_map = value => {
    let pairs = __msgpack_is_pair_map(value) ? value.entries : __msgpack_map_key_pairs(value, keys(value), 0, [])
    let body = __msgpack_encode_map_pairs(pairs, 0, [])
    __msgpack_is_error(body) ? body :
    concat(__msgpack_map_prefix(len(pairs)), body)
}

export let __msgpack_encode_ext_data = (type_id, data) =>
    len(data) == 1 ? concat([212, type_id < 0 ? 256 + type_id : type_id], data) :
    len(data) == 2 ? concat([213, type_id < 0 ? 256 + type_id : type_id], data) :
    len(data) == 4 ? concat([214, type_id < 0 ? 256 + type_id : type_id], data) :
    len(data) == 8 ? concat([215, type_id < 0 ? 256 + type_id : type_id], data) :
    len(data) == 16 ? concat([216, type_id < 0 ? 256 + type_id : type_id], data) :
    len(data) <= 255 ? concat(concat([199], uint_to_bytes_be(len(data), 1)), concat([type_id < 0 ? 256 + type_id : type_id], data)) :
    len(data) <= 65535 ? concat(concat([200], uint_to_bytes_be(len(data), 2)), concat([type_id < 0 ? 256 + type_id : type_id], data)) :
    concat(concat([201], uint_to_bytes_be(len(data), 4)), concat([type_id < 0 ? 256 + type_id : type_id], data))

export let __msgpack_encode_timestamp = value => {
    let seconds = msgpack_timestamp_seconds(value)
    let nanos = msgpack_timestamp_nanoseconds(value)
    nanos == 0 && seconds >= 0 && seconds <= 4294967295 ?
        __msgpack_encode_ext_data(0 - 1, uint_to_bytes_be(seconds, 4)) :
    seconds >= 0 && seconds < 17179869184 ?
        __msgpack_encode_ext_data(0 - 1, uint_to_bytes_be(nanos * 17179869184 + seconds, 8)) :
        __msgpack_encode_ext_data(0 - 1, concat(uint_to_bytes_be(nanos, 4), int_to_bytes_be(seconds, 8)))
}

export let __msgpack_encode_value = value =>
    type_of(value) == "null" ? [192] :
    type_of(value) == "bool" ? (value ? [195] : [194]) :
    type_of(value) == "int" || type_of(value) == "bigint" ? __msgpack_encode_int(value) :
    type_of(value) == "float" ? concat([203], f64_to_bytes_be(value)) :
    type_of(value) == "string" ? __msgpack_encode_str(value) :
    type_of(value) == "bytes" ? __msgpack_encode_bin(value) :
    type_of(value) == "msgpack_ext" ? __msgpack_encode_ext_data(msgpack_ext_type_id(value), msgpack_ext_data(value)) :
    type_of(value) == "msgpack_timestamp" ? __msgpack_encode_timestamp(value) :
    type_of(value) == "list" ? __msgpack_encode_array(value) :
    type_of(value) == "map" ? __msgpack_encode_map(value) :
    type_of(value) == "identifier" || type_of(value) == "symbol" ? __msgpack_encode_str(to_string(value)) :
    __msgpack_error("cannot encode " + type_of(value) + " as MessagePack")

export let __msgpack_encoder_all = records =>
    __msgpack_encode_array(records)

codec msgpack {
    mode = :bytes
    tokenizer = cursor => __msgpack_tokenizer(cursor)
    parser_all = tokens => __msgpack_parser_all(tokens)
    encoder = record => __msgpack_encoder_all([record])
    encoder_all = records => __msgpack_encoder_all(records)
}

export let __xml_tokenizer = cursor =>
    cursor.eof() ? null : {
        let start = cursor.pos()
        let text = cursor.take(cursor.len())
        { kind = :source, text = text, start = start, end = cursor.pos(), value = text }
    }

export let __xml_xml_ns = () => "http://www.w3.org/XML/1998/namespace"
export let __xml_xmlns_ns = () => "http://www.w3.org/2000/xmlns/"

export let __xml_error = message => __codec_error(message)

export let __xml_is_error = value => __codec_is_error(value)

export let __xml_state = (src, pos, version) => { src = src pos = pos version = version }

export let __xml_ok = (state, value) => { state = state value = value }

export let __xml_len = state => length(state.src)

export let __xml_eof = state => state.pos >= __xml_len(state)

export let __xml_at = (state, n) => substr(state.src, state.pos, state.pos + n)

export let __xml_starts = (state, text) => __xml_at(state, length(text)) == text

export let __xml_set_pos = (state, pos) => __xml_state(state.src, pos, state.version)

export let __xml_take = (state, n) =>
    __xml_ok(__xml_set_pos(state, state.pos + n), substr(state.src, state.pos, state.pos + n))

export let __xml_consume = (state, text, message) =>
    __xml_starts(state, text) ? __xml_ok(__xml_set_pos(state, state.pos + length(text)), text) : __xml_error(message)

export let __xml_skip_ws = state =>
    __xml_eof(state) ? state : {
        let ch = __xml_at(state, 1)
        ch == " " || ch == "\n" || ch == "\r" || ch == "\t" ? __xml_skip_ws(__xml_set_pos(state, state.pos + 1)) : state
    }

export let __xml_index_of = (src, needle, from) =>
    from + length(needle) > length(src) ? 0 - 1 :
    substr(src, from, from + length(needle)) == needle ? from :
    __xml_index_of(src, needle, from + 1)

export let __xml_take_until = (state, needle, message) => {
    let idx = __xml_index_of(state.src, needle, state.pos)
    idx < 0 ? __xml_error(message) : __xml_ok(__xml_set_pos(state, idx), substr(state.src, state.pos, idx))
}

export let __xml_code = ch => char_codepoint(ch)

export let __xml_is_char = (ch, version) => {
    let c = __xml_code(ch)
    c == 9 || c == 10 || c == 13 ||
    (c >= 32 && c <= 55295) ||
    (c >= 57344 && c <= 65533) ||
    (c >= 65536 && c <= 1114111)
}

export let __xml_validate_chars = (src, i, version) =>
    i >= length(src) ? null : {
        let ch = substr(src, i, i + 1)
        __xml_is_char(ch, version) ? __xml_validate_chars(src, i + 1, version) :
        __xml_error("illegal XML character U+" + to_string(char_codepoint(ch)))
    }

export let __xml_is_name_start = ch =>
    ch == ":" || ch == "_" || regex_match(ch, "^[\\p{L}]$")

export let __xml_is_name_char = ch =>
    __xml_is_name_start(ch) || regex_match(ch, "^[0-9\\-.]$") || ch == "·"

export let __xml_split_qname = name => {
    let parts = split(":", name)
    len(parts) == 1 ? { prefix = "" local = parts[0] } :
    len(parts) == 2 && parts[0] != "" && parts[1] != "" ? { prefix = parts[0] local = parts[1] } :
    __xml_error("invalid qualified XML name '" + name + "'")
}

export let __xml_valid_name_chars = (name, i) =>
    i >= length(name) ? true :
    __xml_is_name_char(substr(name, i, i + 1)) ? __xml_valid_name_chars(name, i + 1) : false

export let __xml_validate_qname = name =>
    length(name) == 0 ? __xml_error("XML name must not be empty") :
    __xml_is_name_start(substr(name, 0, 1)) == false ? __xml_error("invalid XML name '" + name + "'") :
    __xml_valid_name_chars(name, 1) == false ? __xml_error("invalid XML name '" + name + "'") :
    __xml_split_qname(name)

export let __xml_read_name_loop = (state, acc) =>
    __xml_eof(state) ? __xml_ok(state, acc) : {
        let ch = __xml_at(state, 1)
        __xml_is_name_char(ch) ? __xml_read_name_loop(__xml_set_pos(state, state.pos + 1), acc + ch) :
        __xml_ok(state, acc)
    }

export let __xml_read_name = state =>
    __xml_eof(state) ? __xml_error("expected XML name") : {
        let ch = __xml_at(state, 1)
        __xml_is_name_start(ch) == false ? __xml_error("invalid XML name start '" + ch + "'") : {
            let read = __xml_read_name_loop(__xml_set_pos(state, state.pos + 1), ch)
            __xml_is_error(read) ? read : {
                let q = __xml_validate_qname(read.value)
                __xml_is_error(q) ? q : read
            }
        }
    }

export let __xml_hex_value = ch =>
    ch >= "0" && ch <= "9" ? char_codepoint(ch) - char_codepoint("0") :
    ch >= "a" && ch <= "f" ? 10 + char_codepoint(ch) - char_codepoint("a") :
    ch >= "A" && ch <= "F" ? 10 + char_codepoint(ch) - char_codepoint("A") :
    0 - 1

export let __xml_parse_hex = (text, i, acc) =>
    i >= length(text) ? acc : {
        let value = __xml_hex_value(substr(text, i, i + 1))
        value < 0 ? 0 - 1 : __xml_parse_hex(text, i + 1, acc * 16 + value)
    }

export let __xml_numeric_char = (digits, radix, version) => {
    let code = radix == 16 ? __xml_parse_hex(digits, 0, 0) : (regex_match(digits, "^[0-9]+$") ? to_int(digits) : 0 - 1)
    code < 0 ? __xml_error("invalid numeric character reference") : {
        let ch = char_from_codepoint(code)
        __xml_is_char(ch, version) ? ch : __xml_error("numeric character reference U+" + to_string(code) + " is not allowed")
    }
}

export let __xml_decode_ref_text = (text, version) =>
    text == "lt" ? "<" :
    text == "gt" ? ">" :
    text == "amp" ? "&" :
    text == "apos" ? "'" :
    text == "quot" ? "\"" :
    starts_with(text, "#x") ? __xml_numeric_char(substr(text, 2), 16, version) :
    starts_with(text, "#") ? __xml_numeric_char(substr(text, 1), 10, version) :
    __xml_error("unknown entity reference '&" + text + ";'")

export let __xml_parse_reference = state => {
    let open = __xml_consume(state, "&", "expected entity reference")
    __xml_is_error(open) ? open : {
        let body = __xml_take_until(open.state, ";", "unterminated entity reference")
        __xml_is_error(body) ? body : {
            let close = __xml_consume(body.state, ";", "unterminated entity reference")
            __xml_is_error(close) ? close : {
                let value = __xml_decode_ref_text(body.value, state.version)
                __xml_is_error(value) ? value : __xml_ok(close.state, value)
            }
        }
    }
}

export let __xml_attr_value_loop = (state, quote, acc) =>
    __xml_eof(state) ? __xml_error("unterminated attribute value") : {
        let ch = __xml_at(state, 1)
        ch == quote ? __xml_ok(__xml_set_pos(state, state.pos + 1), acc) :
        ch == "<" ? __xml_error("attribute values must not contain '<'") :
        ch == "&" ? {
            let entity = __xml_parse_reference(state)
            __xml_is_error(entity) ? entity : __xml_attr_value_loop(entity.state, quote, acc + entity.value)
        } :
        __xml_attr_value_loop(__xml_set_pos(state, state.pos + 1), quote, acc + ch)
    }

export let __xml_read_attr_value = state =>
    __xml_eof(state) ? __xml_error("attribute value must be quoted") : {
        let quote = __xml_at(state, 1)
        quote != "\"" && quote != "'" ? __xml_error("attribute value must be quoted") :
        __xml_attr_value_loop(__xml_set_pos(state, state.pos + 1), quote, "")
    }

export let __xml_parse_comment = state => {
    let open = __xml_consume(state, "<!--", "expected comment")
    __xml_is_error(open) ? open : {
        let body = __xml_take_until(open.state, "-->", "unterminated comment")
        __xml_is_error(body) ? body :
        contains(body.value, "--") || ends_with(body.value, "-") ? __xml_error("XML comments must not contain '--' or end with '-'") : {
            let close = __xml_consume(body.state, "-->", "unterminated comment")
            __xml_is_error(close) ? close : __xml_ok(close.state, { type = "comment" text = body.value })
        }
    }
}

export let __xml_parse_cdata = state => {
    let open = __xml_consume(state, "<![CDATA[", "expected CDATA")
    __xml_is_error(open) ? open : {
        let body = __xml_take_until(open.state, "]]>", "unterminated CDATA section")
        __xml_is_error(body) ? body : {
            let close = __xml_consume(body.state, "]]>", "unterminated CDATA section")
            __xml_is_error(close) ? close : __xml_ok(close.state, body.value)
        }
    }
}

export let __xml_parse_pi = state => {
    let open = __xml_consume(state, "<?", "expected processing instruction")
    __xml_is_error(open) ? open : {
        let target = __xml_read_name(open.state)
        __xml_is_error(target) ? target :
        lower(target.value) == "xml" ? __xml_error("processing instruction target 'xml' is reserved") : {
            let body = __xml_take_until(target.state, "?>", "unterminated processing instruction")
            __xml_is_error(body) ? body : {
                let close = __xml_consume(body.state, "?>", "unterminated processing instruction")
                __xml_is_error(close) ? close : __xml_ok(close.state, { type = "pi" target = target.value text = trim(body.value) })
            }
        }
    }
}

export let __xml_text_loop = (state, acc) =>
    __xml_eof(state) || __xml_starts(state, "<") ? __xml_ok(state, acc) :
    __xml_starts(state, "&") ? {
        let entity = __xml_parse_reference(state)
        __xml_is_error(entity) ? entity : __xml_text_loop(entity.state, acc + entity.value)
    } : {
        let ch = __xml_at(state, 1)
        __xml_text_loop(__xml_set_pos(state, state.pos + 1), acc + ch)
    }

export let __xml_namespace_allowed = (prefix, uri) =>
    prefix == "" && (uri == __xml_xml_ns() || uri == __xml_xmlns_ns()) ? __xml_error("reserved namespace URI cannot be used as the default namespace") :
    prefix == "xml" && uri != __xml_xml_ns() ? __xml_error("xml prefix must be bound to its reserved namespace") :
    prefix == "xmlns" || uri == __xml_xmlns_ns() ? __xml_error("xmlns prefix and namespace URI are reserved") :
    prefix != "xml" && uri == __xml_xml_ns() ? __xml_error("XML namespace URI may only be bound to the xml prefix") :
    prefix != "" && uri == "" ? __xml_error("namespace prefixes must not be undeclared") :
    null

export let __xml_attr_loop = (state, scope, namespaces, attrs, seen) => {
    let s = __xml_skip_ws(state)
    __xml_starts(s, "/>") ? __xml_ok(__xml_set_pos(s, s.pos + 2), { scope = scope namespaces = namespaces attrs = attrs empty = true }) :
    __xml_starts(s, ">") ? __xml_ok(__xml_set_pos(s, s.pos + 1), { scope = scope namespaces = namespaces attrs = attrs empty = false }) : {
        let name = __xml_read_name(s)
        __xml_is_error(name) ? name :
        map_has(seen, name.value) ? __xml_error("duplicate attribute '" + name.value + "'") : {
            let q = __xml_split_qname(name.value)
            __xml_is_error(q) ? q : {
                let eq_state = __xml_skip_ws(name.state)
                let eq = __xml_consume(eq_state, "=", "expected '=' after attribute name")
                __xml_is_error(eq) ? eq : {
                    let value = __xml_read_attr_value(__xml_skip_ws(eq.state))
                    __xml_is_error(value) ? value :
                    name.value == "xmlns" ? {
                        let allowed = __xml_namespace_allowed("", value.value)
                        __xml_is_error(allowed) ? allowed :
                        __xml_attr_loop(value.state, map_set(scope, "", value.value), map_set(namespaces, "", value.value), attrs, map_set(seen, name.value, true))
                    } :
                    q.prefix == "xmlns" ? {
                        let allowed = __xml_namespace_allowed(q.local, value.value)
                        __xml_is_error(allowed) ? allowed :
                        __xml_attr_loop(value.state, map_set(scope, q.local, value.value), map_set(namespaces, q.local, value.value), attrs, map_set(seen, name.value, true))
                    } :
                    __xml_attr_loop(value.state, scope, namespaces, concat(attrs, [{ name = name.value prefix = q.prefix local_name = q.local value = value.value }]), map_set(seen, name.value, true))
                }
            }
        }
    }
}

export let __xml_resolve_element_ns = (prefix, scope) =>
    prefix == "xml" ? __xml_xml_ns() :
    prefix == "" ? (map_has(scope, "") ? scope[""] : "") :
    map_has(scope, prefix) ? scope[prefix] :
    __xml_error("unbound namespace prefix '" + prefix + "'")

export let __xml_resolve_attrs = (attrs, scope, i, seen, acc) =>
    i >= len(attrs) ? acc : {
        let attr = attrs[i]
        let ns = attr.prefix == "" ? "" : (map_has(scope, attr.prefix) ? scope[attr.prefix] : __xml_error("unbound namespace prefix '" + attr.prefix + "'"))
        __xml_is_error(ns) ? ns : {
            let expanded = ns + "|" + attr.local_name
            map_has(seen, expanded) ? __xml_error("duplicate attribute by expanded name '" + attr.name + "'") :
            __xml_resolve_attrs(attrs, scope, i + 1, map_set(seen, expanded, true), concat(acc, [{
                name = attr.name prefix = attr.prefix local_name = attr.local_name namespace_uri = ns value = attr.value
            }]))
        }
    }

export let __xml_text_node = text => { type = "text" text = text }

export let __xml_children_loop = (state, scope, element_name, children, text) =>
    __xml_eof(state) ? __xml_error("unterminated element '" + element_name + "'") :
    __xml_starts(state, "</") ? {
        let open = __xml_consume(state, "</", "expected end tag")
        let close_name = __xml_read_name(open.state)
        __xml_is_error(close_name) ? close_name : {
            let close = __xml_consume(__xml_skip_ws(close_name.state), ">", "expected '>' after end tag")
            __xml_is_error(close) ? close :
            close_name.value != element_name ? __xml_error("mismatched end tag: expected </" + element_name + ">, got </" + close_name.value + ">") :
            __xml_ok(close.state, { children = children text = text })
        }
    } :
    __xml_starts(state, "<!--") ? {
        let comment = __xml_parse_comment(state)
        __xml_is_error(comment) ? comment : __xml_children_loop(comment.state, scope, element_name, concat(children, [comment.value]), text)
    } :
    __xml_starts(state, "<![CDATA[") ? {
        let cdata = __xml_parse_cdata(state)
        __xml_is_error(cdata) ? cdata : __xml_children_loop(cdata.state, scope, element_name, concat(children, [__xml_text_node(cdata.value)]), text + cdata.value)
    } :
    __xml_starts(state, "<?") ? {
        let pi = __xml_parse_pi(state)
        __xml_is_error(pi) ? pi : __xml_children_loop(pi.state, scope, element_name, concat(children, [pi.value]), text)
    } :
    __xml_starts(state, "<!") ? __xml_error("markup declarations are only allowed in the DOCTYPE internal subset") :
    __xml_starts(state, "<") ? {
        let child = __xml_parse_element(state, scope)
        __xml_is_error(child) ? child : __xml_children_loop(child.state, scope, element_name, concat(children, [child.value]), text)
    } : {
        let data = __xml_text_loop(state, "")
        __xml_is_error(data) ? data :
        data.value == "" ? __xml_children_loop(data.state, scope, element_name, children, text) :
        __xml_children_loop(data.state, scope, element_name, concat(children, [__xml_text_node(data.value)]), text + data.value)
    }

export let __xml_parse_element = (state, inherited_scope) => {
    let open = __xml_consume(state, "<", "expected element")
    __xml_is_error(open) ? open : {
        let name = __xml_read_name(open.state)
        __xml_is_error(name) ? name : {
            let q = __xml_split_qname(name.value)
            __xml_is_error(q) ? q :
            q.prefix == "xmlns" ? __xml_error("element names must not use the reserved xmlns prefix") : {
                let parsed_attrs = __xml_attr_loop(name.state, inherited_scope, {}, [], {})
                __xml_is_error(parsed_attrs) ? parsed_attrs : {
                    let ns = __xml_resolve_element_ns(q.prefix, parsed_attrs.value.scope)
                    __xml_is_error(ns) ? ns : {
                        let attrs = __xml_resolve_attrs(parsed_attrs.value.attrs, parsed_attrs.value.scope, 0, {}, [])
                        __xml_is_error(attrs) ? attrs :
                        parsed_attrs.value.empty ? __xml_ok(parsed_attrs.state, {
                            type = "element" name = name.value prefix = q.prefix local_name = q.local namespace_uri = ns
                            attributes = attrs namespaces = parsed_attrs.value.namespaces children = [] text = ""
                        }) : {
                            let content = __xml_children_loop(parsed_attrs.state, parsed_attrs.value.scope, name.value, [], "")
                            __xml_is_error(content) ? content : __xml_ok(content.state, {
                                type = "element" name = name.value prefix = q.prefix local_name = q.local namespace_uri = ns
                                attributes = attrs namespaces = parsed_attrs.value.namespaces children = content.value.children text = content.value.text
                            })
                        }
                    }
                }
            }
        }
    }
}

export let __xml_parse_xml_decl = state =>
    __xml_starts(state, "<?xml") ? {
        let body = __xml_take_until(state, "?>", "unterminated XML declaration")
        __xml_is_error(body) ? body : {
            let version =
                contains(body.value, "version=\"1.1\"") || contains(body.value, "version='1.1'") ? "1.1" :
                contains(body.value, "version=\"1.0\"") || contains(body.value, "version='1.0'") ? "1.0" :
                ""
            version == "" ? __xml_error("XML declaration must declare version 1.0 or 1.1") : {
                let close = __xml_consume(body.state, "?>", "unterminated XML declaration")
                __xml_is_error(close) ? close : __xml_ok(__xml_state(close.state.src, close.state.pos, version), null)
            }
        }
    } : __xml_ok(state, null)

export let __xml_parse_misc = state => {
    let s = __xml_skip_ws(state)
    __xml_starts(s, "<!--") ? {
        let c = __xml_parse_comment(s)
        __xml_is_error(c) ? c : __xml_parse_misc(c.state)
    } :
    __xml_starts(s, "<?") ? {
        let p = __xml_parse_pi(s)
        __xml_is_error(p) ? p : __xml_parse_misc(p.state)
    } :
    __xml_ok(s, null)
}

export let __xml_doctype_loop = (state, depth, quote) =>
    __xml_eof(state) ? __xml_error("unterminated DOCTYPE") : {
        let ch = __xml_at(state, 1)
        let next = __xml_set_pos(state, state.pos + 1)
        quote != "" ? (ch == quote ? __xml_doctype_loop(next, depth, "") : __xml_doctype_loop(next, depth, quote)) :
        ch == "\"" || ch == "'" ? __xml_doctype_loop(next, depth, ch) :
        ch == "[" ? __xml_doctype_loop(next, depth + 1, "") :
        ch == "]" && depth > 0 ? __xml_doctype_loop(next, depth - 1, "") :
        ch == ">" && depth == 0 ? __xml_ok(next, null) :
        __xml_doctype_loop(next, depth, "")
    }

export let __xml_parse_doctype = state =>
    __xml_starts(state, "<!DOCTYPE") ? {
        let start = state.pos
        let skipped = __xml_doctype_loop(__xml_set_pos(state, state.pos + length("<!DOCTYPE")), 0, "")
        __xml_is_error(skipped) ? skipped : {
            let text = substr(state.src, start, skipped.state.pos)
            contains(text, "SYSTEM") || contains(text, "PUBLIC") ? __xml_error("external DOCTYPE identifiers are not supported") :
            contains(text, "<!ENTITY") || contains(text, "<!NOTATION") || contains(text, "%") ? __xml_error("DTD entity declarations are not supported") :
            skipped
        }
    } : __xml_ok(state, null)

export let __xml_parse_document = source => {
    let base = starts_with(source, char_from_codepoint(65279)) ? __xml_state(source, 1, "1.0") : __xml_state(source, 0, "1.0")
    let decl = __xml_parse_xml_decl(__xml_skip_ws(base))
    __xml_is_error(decl) ? decl : {
        let chars = __xml_validate_chars(source, 0, decl.state.version)
        __xml_is_error(chars) ? chars : {
            let misc1 = __xml_parse_misc(decl.state)
            __xml_is_error(misc1) ? misc1 : {
                let doctype = __xml_parse_doctype(misc1.state)
                __xml_is_error(doctype) ? doctype : {
                    let misc2 = __xml_parse_misc(doctype.state)
                    __xml_is_error(misc2) ? misc2 :
                    __xml_starts(misc2.state, "<") == false || __xml_starts(misc2.state, "</") ? __xml_error("XML document must contain one root element") : {
                        let scope = map_set({}, "xml", __xml_xml_ns())
                        let root = __xml_parse_element(misc2.state, scope)
                        __xml_is_error(root) ? root : {
                            let tail = __xml_parse_misc(root.state)
                            __xml_is_error(tail) ? tail :
                            __xml_eof(tail.state) == false ? __xml_error("XML document has content after the root element") :
                            [root.value]
                        }
                    }
                }
            }
        }
    }
}

export let __xml_escape_text = text =>
    replace(replace(replace(text, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")

export let __xml_escape_attr = text =>
    replace(replace(replace(replace(replace(text, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), "\"", "&quot;"), "'", "&apos;")

export let __xml_node_type = node =>
    type_of(node) == "map" && map_has(node, "type") && type_of(node.type) == "string" ? node.type : ""

export let __xml_is_element_node = node => __xml_node_type(node) == "element"

export let __xml_render_namespaces_loop = (namespaces, ns_keys, i, acc) =>
    i >= len(ns_keys) ? acc : {
        let prefix = ns_keys[i]
        let uri = namespaces[prefix]
        type_of(uri) != "string" ? __xml_error("XML namespace URI must be string") :
        prefix != "" && __xml_is_error(__xml_validate_qname(prefix)) ? __xml_validate_qname(prefix) :
        __xml_render_namespaces_loop(namespaces, ns_keys, i + 1, acc + (
            prefix == "" ?
                " xmlns=\"" + __xml_escape_attr(uri) + "\"" :
                " xmlns:" + prefix + "=\"" + __xml_escape_attr(uri) + "\""
        ))
    }

export let __xml_render_namespaces = namespaces =>
    type_of(namespaces) != "map" ? __xml_error("XML element namespaces must be a map") :
    __xml_render_namespaces_loop(namespaces, keys(namespaces), 0, "")

export let __xml_render_attrs_loop = (attrs, i, acc) =>
    i >= len(attrs) ? acc : {
        let attr = attrs[i]
        type_of(attr) != "map" ? __xml_error("XML attributes must be maps") : {
            let q = __xml_validate_qname(attr.name)
            __xml_is_error(q) ? q :
            attr.name == "xmlns" || starts_with(attr.name, "xmlns:") ? __xml_error("namespace declarations must be encoded via namespaces") :
            __xml_render_attrs_loop(attrs, i + 1, acc + " " + attr.name + "=\"" + __xml_escape_attr(attr.value) + "\"")
        }
    }

export let __xml_render_attrs = attrs =>
    type_of(attrs) != "list" ? __xml_error("XML element attributes must be a list") :
    __xml_render_attrs_loop(attrs, 0, "")

export let __xml_render_node = node =>
    __xml_node_type(node) == "text" ? __xml_escape_text(node.text) :
    __xml_node_type(node) == "comment" ? (contains(node.text, "--") || ends_with(node.text, "-") ? __xml_error("XML comments must not contain '--' or end with '-'") : "<!--" + node.text + "-->") :
    __xml_node_type(node) == "pi" ? (lower(node.target) == "xml" || contains(node.text, "?>") ? __xml_error("invalid processing instruction") : "<?" + node.target + (node.text == "" ? "" : " " + node.text) + "?>") :
    __xml_node_type(node) == "element" ? __xml_render_element(node) :
    __xml_error("unknown XML node type")

export let __xml_render_children = (children, i, acc) =>
    i >= len(children) ? acc : {
        let rendered = __xml_render_node(children[i])
        __xml_is_error(rendered) ? rendered : __xml_render_children(children, i + 1, acc + rendered)
    }

export let __xml_render_element = node => {
    let q = __xml_validate_qname(node.name)
    __xml_is_error(q) ? q : {
        let attrs = __xml_render_attrs(node.attributes)
        let ns = __xml_render_namespaces(node.namespaces)
        __xml_is_error(attrs) ? attrs :
        __xml_is_error(ns) ? ns :
        type_of(node.children) != "list" ? __xml_error("XML element children must be a list") : {
        let children = node.children
        len(children) == 0 ? "<" + node.name + ns + attrs + "/>" : {
            let rendered = __xml_render_children(children, 0, "")
            __xml_is_error(rendered) ? rendered : "<" + node.name + ns + attrs + ">" + rendered + "</" + node.name + ">"
        }
        }
    }
}

export let __xml_scalar_text = value =>
    type_of(value) == "null" ? "" : to_string(value)

export let __xml_render_plain_map = (value, ks, i, acc) =>
    i >= len(ks) ? acc : {
        let key = ks[i]
        let q = __xml_validate_qname(key)
        __xml_is_error(q) ? q : {
            let rendered = __xml_render_plain(value[key])
            __xml_is_error(rendered) ? rendered : __xml_render_plain_map(value, ks, i + 1, acc + "<" + key + ">" + rendered + "</" + key + ">")
        }
    }

export let __xml_render_plain_list = (items, i, acc) =>
    i >= len(items) ? acc : {
        let rendered = __xml_render_plain(items[i])
        __xml_is_error(rendered) ? rendered : __xml_render_plain_list(items, i + 1, acc + rendered)
    }

export let __xml_render_plain = value =>
    type_of(value) == "map" ? __xml_render_plain_map(value, keys(value), 0, "") :
    type_of(value) == "list" ? __xml_render_plain_list(value, 0, "") :
    __xml_escape_text(__xml_scalar_text(value))

export let __xml_option_string = (options, key, default) =>
    type_of(options) == "map" && map_has(options, key) ? options[key] : default

export let __xml_option_bool = (options, key, default) =>
    type_of(options) == "map" && map_has(options, key) ? options[key] : default

export let __xml_parser_all = (tokens, options) => {
    let source = tokens.expect_kind(:source, "expected XML source")
    __codec_is_error(source) ? source : __xml_parse_document(source.value)
}

export let __xml_encoder_all = (records, options) => {
    let root_name = __xml_option_string(options, "root_name", "root")
    let declaration = __xml_option_bool(options, "xml_declaration", false) ? "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" : ""
    let body =
        len(records) == 1 && __xml_is_element_node(records[0]) ? __xml_render_element(records[0]) :
        {
            let q = __xml_validate_qname(root_name)
            __xml_is_error(q) ? q : "<" + root_name + ">" + join("", map(records, record => __xml_render_plain(record))) + "</" + root_name + ">"
        }
    __xml_is_error(body) ? body : declaration + body + "\n"
}

codec xml {
    mode = :text
    tokenizer = cursor => __xml_tokenizer(cursor)
    parser_all = (tokens, options) => __xml_parser_all(tokens, options)
    encoder = (record, options) => __xml_encoder_all([record], options)
    encoder_all = (records, options) => __xml_encoder_all(records, options)
}
