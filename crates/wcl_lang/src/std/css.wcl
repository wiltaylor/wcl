    export let __plain_kind = kind =>
        starts_with(kind, "css::") ? substr(kind, 5) :
        starts_with(kind, "wdoc::css::") ? substr(kind, 11) :
        kind

    export let __kind = value =>
        type_of(value) == "block_ref" ? css::__plain_kind(block_kind(value)) :
        type_of(value) == "map" ? (map_has(value, "kind") ? css::__plain_kind(to_string(value.kind)) : (map_has(value, "selector") ? "rule" : "stylesheet")) :
        ""

    export let __attrs = value =>
        type_of(value) == "block_ref" ? block_attrs(value) :
        type_of(value) == "map" ? value :
        {}

    export let __children = value => {
        let attrs = css::__attrs(value)
        let direct = type_of(value) == "block_ref" ? block_children(value) : []
        let mapped = map_has(attrs, "children") && type_of(attrs.children) == "list" ? attrs.children : []
        concat(direct, mapped)
    }

    export let __property_name = name =>
        starts_with(name, "--") ? name : replace(name, "_", "-")

    export let __structural = name =>
        contains(["kind", "children", "selector", "query", "condition", "name", "id", "value", "content", "frames", "prelude"], name)

    export let __declaration_value = value =>
        type_of(value) == "list" ? join(" ", map(value, item => to_string(item))) :
        to_string(value)

    export let __decl = (name, value) =>
        css::__structural(name) || type_of(value) == "null" ? "" :
        "  " + css::__property_name(name) + ": " + css::__declaration_value(value) + ";"

    export let __var_decls = vars =>
        type_of(vars) == "map" ? map(keys(vars), key => "  " + key + ": " + css::__declaration_value(vars[key]) + ";") :
        []

    export let __decls = attrs => {
        let regular = map(keys(attrs), key => css::__decl(key, attrs[key]))
        let vars = map_has(attrs, "vars") ? css::__var_decls(attrs.vars) : []
        join("\n", filter(concat(regular, vars), line => line != ""))
    }

    export let __block_body = (attrs, children) => {
        let decls = css::__decls(attrs)
        let rendered = join("\n", filter(map(children, child => css::render(child)), text => text != ""))
        decls == "" ? rendered :
        rendered == "" ? decls :
        decls + "\n" + rendered
    }

    export let __indent = text =>
        text == "" ? "" : "  " + replace(text, "\n", "\n  ")

    export let __rule = (selector, attrs, children) => {
        let body = css::__block_body(attrs, children)
        body == "" ? "" : selector + " {\n" + body + "\n}"
    }

    export let __at_name = kind =>
        kind == "font_face" ? "font-face" :
        kind == "font_feature_values" ? "font-feature-values" :
        kind == "font_palette_values" ? "font-palette-values" :
        kind == "counter_style" ? "counter-style" :
        kind == "starting_style" ? "starting-style" :
        kind == "view_transition" ? "view-transition" :
        kind == "position_try" ? "position-try" :
        replace(kind, "_", "-")

    export let __prelude = (kind, attrs) =>
        kind == "media" ? (map_has(attrs, "query") ? to_string(attrs.query) : "") :
        kind == "supports" ? (map_has(attrs, "condition") ? to_string(attrs.condition) : "") :
        kind == "container" ? (map_has(attrs, "query") ? to_string(attrs.query) : "") :
        kind == "scope" ? (map_has(attrs, "prelude") ? to_string(attrs.prelude) : "") :
        map_has(attrs, "name") ? to_string(attrs.name) :
        map_has(attrs, "id") ? to_string(attrs.id) :
        ""

    export let __at_block = (kind, attrs, children) => {
        let at = "@" + css::__at_name(kind)
        let prelude = css::__prelude(kind, attrs)
        let body = css::__block_body(attrs, children)
        body == "" ? at + (prelude == "" ? "" : " " + prelude) + ";" :
        at + (prelude == "" ? "" : " " + prelude) + " {\n" + css::__indent(body) + "\n}"
    }

    export let __frame_selector = (kind, attrs) =>
        kind == "from" || kind == "to" ? kind :
        map_has(attrs, "selector") ? to_string(attrs.selector) :
        map_has(attrs, "name") ? to_string(attrs.name) :
        ""

    export let __keyframe = value => {
        let kind = css::__kind(value)
        let attrs = css::__attrs(value)
        let selector = css::__frame_selector(kind, attrs)
        let body = css::__decls(attrs)
        selector == "" || body == "" ? "" : "  " + selector + " {\n" + css::__indent(body) + "\n  }"
    }

    export let __keyframes = (attrs, children) => {
        let name = map_has(attrs, "name") ? to_string(attrs.name) : (map_has(attrs, "id") ? to_string(attrs.id) : "")
        let frames = map_has(attrs, "frames") && type_of(attrs.frames) == "list" ? attrs.frames : []
        "@keyframes " + name + " {\n" + join("\n", filter(map(concat(frames, children), frame => css::__keyframe(frame)), text => text != "")) + "\n}"
    }

    export let render = value =>
        type_of(value) == "null" ? "" :
        type_of(value) == "string" ? value :
        type_of(value) == "list" ? join("\n", filter(map(value, item => css::render(item)), text => text != "")) : {
            let kind = css::__kind(value)
            let attrs = css::__attrs(value)
            let children = css::__children(value)
            kind == "stylesheet" ? join("\n", filter(map(children, child => css::render(child)), text => text != "")) :
            kind == "raw" ? (map_has(attrs, "content") ? to_string(attrs.content) : "") :
            kind == "comment" ? "/* " + (map_has(attrs, "content") ? to_string(attrs.content) : "") + " */" :
            kind == "rule" ? css::__rule(map_has(attrs, "selector") ? to_string(attrs.selector) : "", attrs, children) :
            kind == "keyframes" ? css::__keyframes(attrs, children) :
            kind == "frame" || kind == "from" || kind == "to" ? css::__keyframe(value) :
            kind == "import" || kind == "charset" || kind == "namespace" ? "@" + kind + " " + (map_has(attrs, "value") ? to_string(attrs.value) : "") + ";" :
            css::__at_block(kind, attrs, children)
        }

}

codec css {
    mode = :text
    encoder = value => css::render(value)
    encoder_all = values => join("\n", filter(map(values, value => css::render(value)), text => text != ""))
}
