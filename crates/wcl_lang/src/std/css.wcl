// Standard CSS schemas, MDN CSS reference lists, and WCL-authored css codec output.
// Reference data is generated from https://github.com/mdn/data/tree/main/css.

namespace css {
    @open schema "stylesheet" { }

    @open schema "rule" {
        selector: string
    }

    @open schema "raw" {
        content: string @text
    }

    @open schema "comment" {
        content: string @text
    }

    @open schema "media" { query: string @optional }
    @open schema "supports" { condition: string @optional }
    @open schema "container" { query: string @optional }
    @open schema "layer" { name: string @optional }
    @open schema "scope" { prelude: string @optional }
    @open schema "starting_style" { }
    @open schema "view_transition" { }
    @open schema "position_try" { name: string @optional }
    @open schema "page" { name: string @optional }
    @open schema "property" { name: string @optional }
    @open schema "counter_style" { name: string @optional }
    @open schema "font_face" { }
    @open schema "font_feature_values" { name: string @optional }
    @open schema "font_palette_values" { name: string @optional }
    @open schema "keyframes" { name: string }
    @open schema "frame" { selector: string }
    @open schema "from" { }
    @open schema "to" { }
    @open schema "import" { value: string }
    @open schema "charset" { value: string }
    @open schema "namespace" { value: string }


