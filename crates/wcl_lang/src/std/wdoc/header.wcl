// wdoc standard library — common document elements and template functions
//
// Usage:
//   import <wdoc.wcl>
//   use wdoc::{doc, page, section, style, layout, heading, paragraph, image, code, data_table, callout, bold, italic, link, icon, icon_styled}
//   use wdoc::draw::{diagram, rect, circle, ellipse, line, path, text, image, connection, ...}

// Helper used by shape template functions to read attributes with defaults.
// Registered globally (outside the wdoc namespace) so widget lambda bodies can
// reference it as bare `attr_or` without qualification.
declare attr_or(block: any, key: string, default: any) -> any

// Core helper for recursive templates. Returns direct child BlockRefs, optionally
// filtered by exact block kind, e.g. children(item, "UiMenuItem").
declare children(block: any) -> list(any)
declare children(block: any, kind: string) -> list(any)
declare block_children(block: any) -> list(any)
declare block_body_children(block: any) -> list(any)
declare block_qualified_id(block: any) -> any
declare url_component_encode(value: any) -> string

namespace wdoc {

    // --- Structural schemas ---

    @open
    schema "doc" {
        title: string
        template: string @optional
        version: string @optional
        author: string @optional
    }

    @open
    schema "page" {
        section: ref("wdoc::section") @ref("wdoc::section")
        title: string
        template: string @optional
        path: string @optional
        date: string @optional
        draft: bool @optional
        weight: i64 @optional
        summary: string @optional
        tags: list(string) @optional
        categories: list(string) @optional
        params: map(string, string) @optional
    }

    @template("html", "wdoc::render_site_header")
    @open
    schema "site_header" {
        title: string @optional
        logo: string @optional
    }

    @template("html", "wdoc::render_site_nav")
    @open
    schema "site_nav" { }

    @template("html", "wdoc::render_site_footer")
    @open
    schema "site_footer" {
        text: string @optional
    }

    @template("html", "wdoc::render_site_main")
    @open
    schema "site_main" { }

    @template("html", "wdoc::render_site_section")
    @auto_id @open
    schema "site_section" {
        title: string @optional
    }

    @template("html", "wdoc::render_site_hero")
    @auto_id @open
    schema "site_hero" {
        title: string
        subtitle: string @optional
        image: string @optional
    }

    @template("html", "wdoc::render_site_card_grid")
    @auto_id @open
    schema "site_card_grid" { }

    @template("html", "wdoc::render_site_card")
    @auto_id @open
    schema "site_card" {
        title: string
        href: string @optional
        summary: string @optional
    }

    @parent(["wdoc::page"]) @open
    schema "signal" {
        initial: any @optional
        type: string @optional
    }

    @parent(["wdoc::page", "wdoc::layout"]) @open
    schema "binding" {
        signal: string
        target: string
        property: string
        path: string @optional
        format: string @optional
    }

    @open
    schema "section" { }

    @open
    schema "style" { }

    // Style child schemas — same names as content schemas but scoped to style blocks.
    // Inside a style block, these are CSS property containers, not content elements.
    @parent(["wdoc::style"]) @open schema "heading" { }
    @parent(["wdoc::style"]) @open schema "paragraph" { }
    @parent(["wdoc::style"]) @open schema "image" { }
    @parent(["wdoc::style"]) @open schema "code" { }
    @parent(["wdoc::style"]) @open schema "equation" { }
    @parent(["wdoc::style"]) @open schema "data_table" { }
    @parent(["wdoc::style"]) @open schema "callout" { }

    @open
    schema "layout" { }

    @assert(
        check = len(children(self, "split")) == 0 || abs(sum(map(children(self, "split"), s => has(s, "size") ? s.size : 0)) - 100) <= 0.01,
        message = "split sizes should sum to 100%",
        severity = "warning"
    )
    @open
    schema "vsplit" { }

    @assert(
        check = len(children(self, "split")) == 0 || abs(sum(map(children(self, "split"), s => has(s, "size") ? s.size : 0)) - 100) <= 0.01,
        message = "split sizes should sum to 100%",
        severity = "warning"
    )
    @open
    schema "hsplit" { }

    @open
    schema "split" {
        size: f64 @optional
    }

    // --- Content element schemas ---

    @template("html", "wdoc::render_heading")
    @auto_id @open
    schema "heading" {
        level: i32
        content: string
    }

    // Per-level heading shorthands. Schemas use `@text` so users can write
    // `h1 "Title"` (and `h1 myh1 "Title"` to also assign an anchor id).
    // `@auto_id` prevents sibling h1/h2/... blocks from colliding when no
    // explicit id is given.
    @template("html", "wdoc::render_h1") @auto_id @open schema "h1" { content: string @text }
    @template("html", "wdoc::render_h2") @auto_id @open schema "h2" { content: string @text }
    @template("html", "wdoc::render_h3") @auto_id @open schema "h3" { content: string @text }
    @template("html", "wdoc::render_h4") @auto_id @open schema "h4" { content: string @text }
    @template("html", "wdoc::render_h5") @auto_id @open schema "h5" { content: string @text }
    @template("html", "wdoc::render_h6") @auto_id @open schema "h6" { content: string @text }

    @template("html", "wdoc::render_paragraph")
    @auto_id @open
    schema "paragraph" {
        content: string
    }

    // Paragraph shorthand: `p "body text"`.
    @template("html", "wdoc::render_paragraph") @auto_id @open schema "p" { content: string @text }

    @template("html", "wdoc::render_image")
    @auto_id @open
    schema "image" {
        src: string
        alt: string @optional
        width: string @optional
        height: string @optional
    }

    @template("html", "wdoc::render_code")
    @auto_id @open
    schema "code" {
        language: string @optional
        content: string
    }

    @template("html", "wdoc::render_equation")
    @auto_id @open
    schema "equation" {
        content: string @text
    }

    @template("html", "wdoc::render_table")
    @auto_id @open
    schema "data_table" {
        caption: string @optional
    }

    @template("html", "wdoc::render_callout")
    @auto_id @open
    schema "callout" {
        icon: string @optional
        header: string @optional
        color: string @optional
    }

    // Reusable scoped CSS emitted once into the shared WDoc stylesheet.
    schema "css_fragment" {
        scope: string
        css: string
    }

    // Raw global CSS emitted once into the shared WDoc stylesheet.
    schema "global_css" {
        css: string
    }

    // First-class font asset declaration. The referenced font file is copied
    // to the build output when the generated @font-face rule is emitted.
    schema "font_asset" {
        family: string
        src: string
        weight: string @optional
        style: string @optional
        display: string @optional
    }

    schema "icon_set" {
        path: string
        default: bool @optional
        normalize_width: f64 @optional
        normalize_height: f64 @optional
        normalize_mode: string @optional
    }

    @parent(["wdoc::icon_set"]) @open schema "icon_part" {
        selector: string
        property: string
        default: string @optional
    }

    // --- Diagram and shape schemas ---

    namespace draw {

        // diagram has no @template — it's special-cased by the wdoc renderer so
        // shape template dispatch can run with the full context.
        @open
        schema "diagram" {
            width: i32 @optional
            height: i32 @optional
        }

        // Primitive shapes — handled directly by the renderer, no template fn.
        @open schema "rect" { }
        @open schema "circle" { }
        @open schema "ellipse" { }
        @open schema "line" { }
        @open schema "path" { }
        @open schema "text" { }
        @open schema "text_block" { }
        @open
        schema "inline_svg" {
            src: string @optional
            content: string @optional
            stroke: string @optional
            fill: string @optional
            stroke_width: f64 @optional
            class: string @optional
            opacity: f64 @optional
        }
        @open
        schema "image" {
            src: string
            fit: string @optional @default("contain")
            alt: string @optional
            opacity: f64 @optional
            rx: f64 @optional
            ry: f64 @optional
            tile_width: f64 @optional
            tile_height: f64 @optional
        }
        @open
        schema "icon" {
            name: string
            icon_set: string @optional
            fill: string @optional
            stroke: string @optional
            props: map(string, any) @optional
            normalize_width: f64 @optional
            normalize_height: f64 @optional
            normalize_mode: string @optional
            class: string @optional
            opacity: f64 @optional
        }
        @open
        schema "map" {
            src: string
            content_width: f64 @optional
            content_height: f64 @optional
            view_x: f64 @optional
            view_y: f64 @optional
            view_width: f64 @optional
            view_height: f64 @optional
            min_zoom: f64 @optional
            max_zoom: f64 @optional
            alt: string @optional
            background_fill: string @optional
        }
        @parent(["wdoc::draw::diagram"]) @open schema "dopesheet" {
            src: string
            columns: i32
            frame_width: f64
            frame_height: f64
            frame_count: i32 @optional
            offset_x: f64 @optional
            offset_y: f64 @optional
            gap_x: f64 @optional
            gap_y: f64 @optional
            sheet_width: f64 @optional
            sheet_height: f64 @optional
        }
        @open schema "sprite" {
            sheet: string
            frame: i32 @optional
            fit: string @optional
            alt: string @optional
            transparent_color: string @optional
            transparent_tolerance: i32 @optional
        }
        @open schema "dopesheet_view" {
            sheet: string
            grid_stroke: string @optional
            grid_stroke_width: f64 @optional
            background_fill: string @optional
        }
        @open schema "tilemap" {
            sheet: string
            tile_width: f64
            tile_height: f64
            tile_render_height: f64 @optional
            rows: list(any)
            orientation: string @optional
            background_fill: string @optional
            grid_stroke: string @optional
            grid_stroke_width: f64 @optional
            transparent_color: string @optional
            transparent_tolerance: i32 @optional
        }
        @open schema "game_layer" {
            parallax: f64 @optional
            locked: bool @optional
            clip: bool @optional
            opacity: f64 @optional
            class: string @optional
        }
        @open schema "group" { }
        @open
        schema "terminal" {
            rows: i32 @optional
            cols: i32 @optional
            content: string @optional
            chrome: string @optional
            title: string @optional
            chrome_height: f64 @optional
            chrome_fill: string @optional
            chrome_foreground_fill: string @optional
            chrome_border_fill: string @optional
            background_fill: string @optional
            foreground_fill: string @optional
        }
        @parent(["wdoc::draw::terminal"]) @open schema "terminal_text" {
            row: i32
            col: i32
            content: string
        }
        @parent(["wdoc::draw::terminal"]) @open schema "terminal_box" {
            row: i32
            col: i32
            rows: i32
            cols: i32
            title: string @optional
        }
        @parent(["wdoc::draw::terminal"]) @open schema "terminal_rule" {
            row: i32
            col: i32
            rows: i32 @optional
            cols: i32 @optional
            direction: string @optional
        }
        @template("shape", "wdoc::terminal_widget_menubar")
        @parent(["wdoc::draw::terminal"]) @open schema "terminal_menubar" {
            row: i32
            col: i32
            cols: i32 @optional
            close_targets: string @optional
        }
        @template("shape", "wdoc::terminal_widget_menu")
        @parent(["wdoc::draw::terminal"]) @open schema "terminal_menu" {
            row: i32
            col: i32
            rows: i32 @optional
            cols: i32 @optional
            close_targets: string @optional
            leave_close_targets: string @optional
            leave_guard_targets: string @optional
        }
        @template("shape", "wdoc::terminal_widget_context_menu")
        @parent(["wdoc::draw::terminal"]) @open schema "terminal_context_menu" {
            row: i32
            col: i32
            rows: i32 @optional
            cols: i32 @optional
            close_targets: string @optional
            leave_close_targets: string @optional
            leave_guard_targets: string @optional
        }
        @parent(["wdoc::draw::terminal"]) @open schema "terminal_cursor" {
            row: i32
            col: i32
            mode: string @optional
        }
        @parent(["wdoc::draw::terminal"]) @open schema "terminal_surface" {
            row: i32
            col: i32
            rows: i32 @optional
            cols: i32
        }
        @template("shape", "wdoc::terminal_widget_button")
        @parent(["wdoc::draw::terminal"]) @open schema "terminal_button" {
            row: i32
            col: i32
            cols: i32 @optional
        }
        @template("shape", "wdoc::terminal_widget_textbox")
        @parent(["wdoc::draw::terminal"]) @open schema "terminal_textbox" {
            row: i32
            col: i32
            rows: i32 @optional
            cols: i32 @optional
        }
        @template("shape", "wdoc::terminal_widget_checkbox")
        @parent(["wdoc::draw::terminal"]) @open schema "terminal_checkbox" {
            row: i32
            col: i32
            cols: i32 @optional
        }
        @template("shape", "wdoc::terminal_widget_radio")
        @parent(["wdoc::draw::terminal"]) @open schema "terminal_radio" {
            row: i32
            col: i32
            cols: i32 @optional
        }
        @template("shape", "wdoc::terminal_widget_dropdown")
        @parent(["wdoc::draw::terminal"]) @open schema "terminal_dropdown" {
            row: i32
            col: i32
            cols: i32 @optional
        }
        @open schema "connection" { }
        @open schema "class" { }
        @parent(["wdoc::draw::class"]) @open schema "state" { }
        @parent(["wdoc::draw::class"]) @open schema "animation" { }
        @parent(["wdoc::draw::animation"]) @open schema "keyframe" { }
        @parent([
            "wdoc::draw::rect",
            "wdoc::draw::circle",
            "wdoc::draw::ellipse",
            "wdoc::draw::line",
            "wdoc::draw::path",
            "wdoc::draw::text",
            "wdoc::draw::text_block",
            "wdoc::draw::inline_svg",
            "wdoc::draw::image",
            "wdoc::draw::icon",
            "wdoc::draw::map",
            "wdoc::draw::sprite",
            "wdoc::draw::dopesheet_view",
            "wdoc::draw::tilemap",
            "wdoc::draw::game_layer",
            "wdoc::draw::group",
            "wdoc::draw::terminal",
            "wdoc::draw::terminal_text",
            "wdoc::draw::terminal_box",
            "wdoc::draw::terminal_rule",
            "wdoc::draw::terminal_menubar",
            "wdoc::draw::terminal_menu",
            "wdoc::draw::terminal_context_menu",
            "wdoc::draw::terminal_cursor",
            "wdoc::draw::terminal_surface",
            "wdoc::draw::terminal_button",
            "wdoc::draw::terminal_textbox",
            "wdoc::draw::terminal_checkbox",
            "wdoc::draw::terminal_radio",
            "wdoc::draw::terminal_dropdown",
            "wdoc::draw::phone",
            "wdoc::draw::phone_landscape",
            "wdoc::draw::browser",
            "wdoc::draw::window",
            "wdoc::draw::tablet",
            "wdoc::draw::tablet_landscape",
            "wdoc::draw::button",
            "wdoc::draw::slider",
            "wdoc::draw::input",
            "wdoc::draw::card",
            "wdoc::draw::collapsible_panel",
            "wdoc::draw::avatar",
            "wdoc::draw::toggle",
            "wdoc::draw::checkbox",
            "wdoc::draw::radio",
            "wdoc::draw::button_group",
            "wdoc::draw::textbox",
            "wdoc::draw::dropdown",
            "wdoc::draw::inline_image",
            "wdoc::draw::menubar",
            "wdoc::draw::context_menu",
            "wdoc::draw::badge",
            "wdoc::draw::navbar",
            "wdoc::draw::stat_card",
            "wdoc::draw::profile_card",
            "wdoc::draw::action_panel",
            "wdoc::draw::list_item",
            "wdoc::draw::datatable",
            "wdoc::draw::graph_node",
            "wdoc::draw::pie_chart",
            "wdoc::draw::bar_chart",
            "wdoc::draw::line_chart",
            "wdoc::draw::flowchart",
            "wdoc::draw::flow_process",
            "wdoc::draw::flow_decision",
            "wdoc::draw::flow_terminal",
            "wdoc::draw::flow_io",
            "wdoc::draw::flow_subprocess",
            "wdoc::draw::c4_person",
            "wdoc::draw::c4_system",
            "wdoc::draw::c4_container",
            "wdoc::draw::c4_component",
            "wdoc::draw::c4_boundary",
            "wdoc::draw::uml_class",
            "wdoc::draw::uml_actor",
            "wdoc::draw::uml_package",
            "wdoc::draw::uml_note",
            "wdoc::draw::server",
            "wdoc::draw::database",
            "wdoc::draw::cloud",
            "wdoc::draw::user"
        ])
        @open schema "event" {
            trigger: string
            state: string @optional
            target: string @optional
            button: string @optional
            mode: string @optional
            duration_ms: i32 @optional
            prevent_default: bool @optional
            guard_targets: string @optional
        }
        @parent(["wdoc::draw::event"]) @open schema "set_signal" {
            signal: string
            value: any @optional
            path: string @optional
        }

        // --- Composite widgets ---
        // Each widget is bound to a `@template("shape", "fn")` function defined
        // in WCL further down this file. The dispatcher calls the function with
        // the widget's BlockRef and converts the returned list of shape
        // descriptors into the widget's child shapes.

        @template("shape", "wdoc::widget_phone")    @open schema "phone" { }
        @template("shape", "wdoc::widget_phone_landscape") @open schema "phone_landscape" { }
        @template("shape", "wdoc::widget_browser")  @open schema "browser" { }
        @template("shape", "wdoc::widget_window")   @open schema "window" { }
        @template("shape", "wdoc::widget_tablet")   @open schema "tablet" { }
        @template("shape", "wdoc::widget_tablet_landscape") @open schema "tablet_landscape" { }
        @template("shape", "wdoc::widget_button")   @open schema "button" { }
        @template("shape", "wdoc::widget_slider")   @open schema "slider" { }
        @template("shape", "wdoc::widget_input")    @open schema "input" { }
        @template("shape", "wdoc::widget_card")     @open schema "card" { }
        @template("shape", "wdoc::widget_collapsible_panel") @open schema "collapsible_panel" { }
        @template("shape", "wdoc::widget_avatar")   @open schema "avatar" { }
        @template("shape", "wdoc::widget_toggle")   @open schema "toggle" { }
        @template("shape", "wdoc::widget_checkbox") @open schema "checkbox" { }
        @template("shape", "wdoc::widget_radio")    @open schema "radio" { }
        @template("shape", "wdoc::widget_button_group") @open schema "button_group" { }
        @template("shape", "wdoc::widget_textbox")  @open schema "textbox" { }
        @template("shape", "wdoc::widget_dropdown") @open schema "dropdown" { }
        @template("shape", "wdoc::widget_inline_image") @open schema "inline_image" { }
        @template("shape", "wdoc::widget_menubar")  @open schema "menubar" { }
        @template("shape", "wdoc::widget_context_menu") @open schema "context_menu" { }
        @parent([
            "wdoc::draw::menubar",
            "wdoc::draw::context_menu",
            "wdoc::draw::terminal_menubar",
            "wdoc::draw::terminal_menu",
            "wdoc::draw::terminal_context_menu",
            "wdoc::draw::terminal_dropdown"
        ])
        @open schema "menu_item" { }
        @template("shape", "wdoc::widget_badge")    @open schema "badge" { }
        @template("shape", "wdoc::widget_navbar")   @open schema "navbar" { }
        @template("shape", "wdoc::widget_stat_card") @open schema "stat_card" { }
        @template("shape", "wdoc::widget_profile_card") @open schema "profile_card" { }
        @template("shape", "wdoc::widget_action_panel") @open schema "action_panel" { }
        @template("shape", "wdoc::widget_list_item") @open schema "list_item" { }
        @template("shape", "wdoc::widget_datatable") @open schema "datatable" { }
        @structural @parent(["wdoc::draw::datatable"]) @open schema "datatable_column" { }
        @structural @parent(["wdoc::draw::datatable"]) @open schema "datatable_row" { }
        @structural @parent(["wdoc::draw::datatable_row"]) @open schema "datatable_cell" { }
        @template("shape", "wdoc::widget_graph_node") @open schema "graph_node" { }
        @structural @parent(["wdoc::draw::graph_node"]) @open schema "graph_row" { }
        @structural @parent(["wdoc::draw::graph_node"]) @open schema "graph_divider" { }
        @template("shape", "wdoc::widget_pie_chart") @open schema "pie_chart" { }
        @template("shape", "wdoc::widget_bar_chart") @open schema "bar_chart" { }
        @template("shape", "wdoc::widget_line_chart") @open schema "line_chart" { }
        @parent([
            "wdoc::draw::pie_chart",
            "wdoc::draw::bar_chart",
            "wdoc::draw::line_chart"
        ])
        @structural @open schema "chart_point" { }
        @structural @open schema "tooltip" { }
        @parent(["wdoc::draw::text_block"]) @open schema "paragraph" { content: string }
        @parent(["wdoc::draw::text_block"]) @open schema "p" { content: string @text }
        @parent(["wdoc::draw::text_block"]) @open schema "code" {
            language: string @optional
            content: string
        }

        @template("shape", "wdoc::widget_flowchart")       @open schema "flowchart" { }
        @template("shape", "wdoc::widget_flow_process")    @open schema "flow_process" { }
        @template("shape", "wdoc::widget_flow_decision")   @open schema "flow_decision" { }
        @template("shape", "wdoc::widget_flow_terminal")   @open schema "flow_terminal" { }
        @template("shape", "wdoc::widget_flow_io")         @open schema "flow_io" { }
        @template("shape", "wdoc::widget_flow_subprocess") @open schema "flow_subprocess" { }

        @template("shape", "wdoc::widget_c4_person")    @open schema "c4_person" { }
        @template("shape", "wdoc::widget_c4_system")    @open schema "c4_system" { }
        @template("shape", "wdoc::widget_c4_container") @open schema "c4_container" { }
        @template("shape", "wdoc::widget_c4_component") @open schema "c4_component" { }
        @template("shape", "wdoc::widget_c4_boundary")  @open schema "c4_boundary" { }

        @template("shape", "wdoc::widget_uml_class")   @open schema "uml_class" { }
        @template("shape", "wdoc::widget_uml_actor")   @open schema "uml_actor" { }
        @template("shape", "wdoc::widget_uml_package") @open schema "uml_package" { }
        @template("shape", "wdoc::widget_uml_note")    @open schema "uml_note" { }

        @template("shape", "wdoc::widget_server")   @open schema "server" { }
        @template("shape", "wdoc::widget_database") @open schema "database" { }
        @template("shape", "wdoc::widget_cloud")    @open schema "cloud" { }
        @template("shape", "wdoc::widget_user")     @open schema "user" { }

    }

    // --- Decorator schemas ---

    decorator_schema "style" {
        target = [block]
        name: ref("wdoc::style")
    }

    // --- Inline formatting functions ---

    export let shape_default_attrs = (b) => {
        let kind = b.kind
        kind == "wdoc::draw::flowchart" ? {
            align = "layered",
            gap = 48,
            content_left = 16,
            content_top = 36,
            content_right = 16,
            content_bottom = 16
        } : (
            kind == "wdoc::draw::card" && attr_or(b, "title", "") != "" ? {
                content_top = 36
            } : (
                kind == "wdoc::draw::collapsible_panel" ? {
                    content_top = attr_or(b, "header_height", 36),
                    data_wdoc_collapsible_panel = "true",
                    data_wdoc_collapse_group = attr_or(b, "collapse_group", ""),
                    data_wdoc_collapse_header_height = attr_or(b, "header_height", 36),
                    data_wdoc_collapse_collapsed = attr_or(b, "collapsed", false),
                    _wdoc_runtime = "true"
                } : (
                    kind == "wdoc::draw::phone" ? {
                    content_top = 74,
                    content_bottom = 50
                } : (
                    kind == "wdoc::draw::phone_landscape" ? {
                        content_left = 18,
                        content_top = 68,
                        content_right = 28,
                        content_bottom = 14
                    } : (
                        kind == "wdoc::draw::browser" ? {
                            content_top = 72
                        } : (
                            kind == "wdoc::draw::window" ? {
                                content_top = 36
                            } : (
                                kind == "wdoc::draw::tablet" ? {
                                    content_left = 18,
                                    content_top = 42,
                                    content_right = 18,
                                    content_bottom = 24
                                } : (
                                    kind == "wdoc::draw::tablet_landscape" ? {
                                        content_left = 18,
                                        content_top = 42,
                                        content_right = 24,
                                        content_bottom = 18
                                    } : null
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
    }

    export let html_escape = value => replace(replace(replace(replace(to_string(value), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), "\"", "&quot;")

    @markup("**{text}**")
    export let bold = text => "**" + to_string(text) + "**"

    @markup("_{text}_")
    export let italic = text => "_" + to_string(text) + "_"

    @markup("`{text}`")
    export let code_span = text => "`" + to_string(text) + "`"

    @markup("[{text}]({url})")
    export let link = (text, url) => "[" + to_string(text) + "](" + to_string(url) + ")"

    @markup(":{name}:")
    export let icon_markup = name => wdoc::icon(name)

    export let restore_trusted_inline_markup = text => {
        let strong = regex_replace_all(text, "&lt;strong&gt;((?:[^&]|&quot;|&amp;)*)&lt;/strong&gt;", "<strong>$1</strong>")
        let emphasized = regex_replace_all(strong, "&lt;em&gt;((?:[^&]|&quot;|&amp;)*)&lt;/em&gt;", "<em>$1</em>")
        let coded = regex_replace_all(emphasized, "&lt;code&gt;((?:[^&]|&quot;|&amp;)*)&lt;/code&gt;", "<code>$1</code>")
        let linked = regex_replace_all(coded, "&lt;a href=&quot;((?:[^&]|&amp;)*)&quot;&gt;((?:[^&]|&quot;|&amp;)*)&lt;/a&gt;", "<a href=\"$1\">$2</a>")
        let icons_with_set_and_props = regex_replace_all(linked, "&lt;span data-wdoc-icon=&quot;true&quot; data-name=&quot;((?:[^&]|&amp;)*)&quot; data-size=&quot;((?:[^&]|&amp;)*)&quot; data-set=&quot;((?:[^&]|&amp;)*)&quot; data-props=&quot;((?:[^&]|&amp;)*)&quot;&gt;&lt;/span&gt;", "<span data-wdoc-icon=\"true\" data-name=\"$1\" data-size=\"$2\" data-set=\"$3\" data-props=\"$4\"></span>")
        let icons_with_props = regex_replace_all(icons_with_set_and_props, "&lt;span data-wdoc-icon=&quot;true&quot; data-name=&quot;((?:[^&]|&amp;)*)&quot; data-size=&quot;((?:[^&]|&amp;)*)&quot; data-props=&quot;((?:[^&]|&amp;)*)&quot;&gt;&lt;/span&gt;", "<span data-wdoc-icon=\"true\" data-name=\"$1\" data-size=\"$2\" data-props=\"$3\"></span>")
        let icons_with_set = regex_replace_all(icons_with_props, "&lt;span data-wdoc-icon=&quot;true&quot; data-name=&quot;((?:[^&]|&amp;)*)&quot; data-size=&quot;((?:[^&]|&amp;)*)&quot; data-set=&quot;((?:[^&]|&amp;)*)&quot;&gt;&lt;/span&gt;", "<span data-wdoc-icon=\"true\" data-name=\"$1\" data-size=\"$2\" data-set=\"$3\"></span>")
        regex_replace_all(icons_with_set, "&lt;span data-wdoc-icon=&quot;true&quot; data-name=&quot;((?:[^&]|&amp;)*)&quot; data-size=&quot;((?:[^&]|&amp;)*)&quot;&gt;&lt;/span&gt;", "<span data-wdoc-icon=\"true\" data-name=\"$1\" data-size=\"$2\"></span>")
    }

    export let render_markup = text => {
        let escaped = wdoc::html_escape(text)
        let code = regex_replace_all(escaped, "`([^`]+)`", "<code>$1</code>")
        let bolded = regex_replace_all(code, "\\*\\*([^*]+)\\*\\*", "<strong>$1</strong>")
        let italicized = regex_replace_all(bolded, "_([^_]+)_", "<em>$1</em>")
        let linked = regex_replace_all(italicized, "\\[([^\\]]+)\\]\\(([^\\)]+)\\)", "<a href=\"$2\">$1</a>")
        let iconed = regex_replace_all(linked, ":([A-Za-z0-9_:-]+):", "<span data-wdoc-icon=\"true\" data-name=\"$1\" data-size=\"1em\"></span>")
        wdoc::restore_trusted_inline_markup(iconed)
    }

    export let render_children = block => {
        let project = attr_or(block, "_wdoc_project", null)
        project == null ? "" : join("", map(block_body_children(block), child => wdoc::render_project_block(project, child) + "\n"))
    }
    declare layout_stack(ctx: map(string, any)) -> map(string, any)
    declare layout_flow(ctx: map(string, any)) -> map(string, any)
    declare layout_center(ctx: map(string, any)) -> map(string, any)
    declare layout_grid(ctx: map(string, any)) -> map(string, any)
    declare layout_layered(ctx: map(string, any)) -> map(string, any)
    declare layout_force(ctx: map(string, any)) -> map(string, any)
    declare layout_radial(ctx: map(string, any)) -> map(string, any)
    declare route_connections(ctx: map(string, any)) -> list(map(string, any))

    @layout("stack")
    export let default_layout_stack = ctx => wdoc::layout_stack(ctx)

    @layout("flow")
    export let default_layout_flow = ctx => wdoc::layout_flow(ctx)

    @layout("center")
    export let default_layout_center = ctx => wdoc::layout_center(ctx)

    @layout("grid")
    export let default_layout_grid = ctx => wdoc::layout_grid(ctx)

    @layout("layered")
    export let default_layout_layered = ctx => wdoc::layout_layered(ctx)

    @layout("force")
    export let default_layout_force = ctx => wdoc::layout_force(ctx)

    @layout("radial")
    export let default_layout_radial = ctx => wdoc::layout_radial(ctx)

    // --- Generic WDoc helpers ---

    export let __icon_prop_query = props => {
        let prop_keys = keys(props)
        join("&", map(prop_keys, key => url_component_encode(key) + "=" + url_component_encode(attr_or(props, key, ""))))
    }

    export let __icon_placeholder = (name, size, set_name, props) => {
        let query = wdoc::__icon_prop_query(props)
        html::render({
            tag = "span",
            data_wdoc_icon = "true",
            data_name = to_string(name),
            data_size = to_string(size),
            data_set = set_name != null && to_string(set_name) != "" ? to_string(set_name) : null,
            data_props = query != "" ? query : null
        })
    }

    export let icon = name => wdoc::__icon_placeholder(name, "1em", null, {})

    export let icon_styled = (name, size, color) => wdoc::__icon_placeholder(name, size, null, { fill = color })

    export let icon_props = (name, size, props) => wdoc::__icon_placeholder(name, size, null, props)

    export let table_rows = block => {
        let attrs = type_of(block) == "block_ref" ? block_attrs(block) : (type_of(block) == "map" || type_of(block) == "object" ? block : {})
        let caption = attr_or(attrs, "caption", "")
        let row_lists = filter(values(attrs), value => type_of(value) == "list")
        let rows = len(row_lists) > 0 ? row_lists[0] : []
        len(rows) == 0 ? { caption = caption, empty = true, headers = [], rows = [] } : {
            let first = rows[0]
            let headers = type_of(first) == "map" || type_of(first) == "object" ? keys(first) : []
            {
                caption = caption,
                empty = false,
                headers = headers,
                rows = filter(map(rows, row => (type_of(row) == "map" || type_of(row) == "object") ? map(values(row), value => to_string(value)) : null), row => row != null)
            }
        }
    }

    export let __text_attrs = value => type_of(value) == "block_ref" ? block_attrs(value) : ((type_of(value) == "map" || type_of(value) == "object") ? value : {})

    export let __num_attr = (attrs, key, default) => {
        let value = attr_or(attrs, key, null)
        value == null ? default : to_float(value)
    }

    export let __css_length = (value, font_size) => {
        let text = trim(to_string(value))
        ends_with(text, "em") ? to_float(substr(text, 0, length(text) - 2)) * font_size :
        ends_with(text, "px") ? to_float(substr(text, 0, length(text) - 2)) :
        to_float(text)
    }

    export let __char_advance_factor = ch =>
        ch == " " || ch == "\n" || ch == "\r" || ch == "\t" ? 0.33 :
        contains("ijlI!|.,:;'", ch) ? 0.28 :
        contains("frt()[]{}", ch) ? 0.38 :
        contains("mwMW@#%&", ch) ? 0.88 :
        regex_match(ch, "^[0-9]$") ? 0.56 :
        regex_match(ch, "^[\\x00-\\x7F]$") ? 0.54 :
        1.0

    export let __font_style_width_factor = attrs => {
        let font_style = lower(to_string(attr_or(attrs, "font_style", "")))
        let font_weight = attr_or(attrs, "font_weight", "")
        let weight_text = lower(to_string(font_weight))
        let numeric_weight = regex_match(weight_text, "^[0-9]+$") ? to_int(weight_text) : 0
        1.0 + (font_style == "italic" || font_style == "oblique" ? 0.02 : 0.0) + (weight_text == "bold" || numeric_weight >= 600 ? 0.03 : 0.0)
    }

    export let __line_width = (line, font_size, letter_spacing, attrs) => {
        let indexes = range(0, length(line))
        let width = sum(map(indexes, i => wdoc::__char_advance_factor(substr(line, i, i + 1)) * font_size))
        (width + (length(line) > 1 ? letter_spacing * (length(line) - 1) : 0)) * wdoc::__font_style_width_factor(attrs)
    }

    export let __push_wrapped_word = (word, max_width, font_size, letter_spacing, attrs, i, current, lines) =>
        i >= length(word) ? { current = current, lines = lines } : {
            let ch = substr(word, i, i + 1)
            let candidate = current + ch
            current == "" || wdoc::__line_width(candidate, font_size, letter_spacing, attrs) <= max_width ?
                wdoc::__push_wrapped_word(word, max_width, font_size, letter_spacing, attrs, i + 1, candidate, lines) :
                wdoc::__push_wrapped_word(word, max_width, font_size, letter_spacing, attrs, i + 1, ch, concat(lines, [current]))
        }

    export let __wrap_words = (words, max_width, font_size, letter_spacing, attrs, i, current, lines) =>
        i >= len(words) ? (current != "" ? concat(lines, [current]) : lines) : {
            let word = words[i]
            let candidate = current == "" ? word : current + " " + word
            wdoc::__line_width(candidate, font_size, letter_spacing, attrs) <= max_width ?
                wdoc::__wrap_words(words, max_width, font_size, letter_spacing, attrs, i + 1, candidate, lines) :
                current != "" ?
                    wdoc::__wrap_words(words, max_width, font_size, letter_spacing, attrs, i, "", concat(lines, [current])) :
                    {
                        let wrapped = wdoc::__push_wrapped_word(word, max_width, font_size, letter_spacing, attrs, 0, "", lines)
                        wdoc::__wrap_words(words, max_width, font_size, letter_spacing, attrs, i + 1, wrapped.current, wrapped.lines)
                    }
        }

    export let __wrap_segment = (segment, max_width, font_size, letter_spacing, attrs) =>
        segment == "" ? [""] : wdoc::__wrap_words(filter(split(" ", segment), word => trim(word) != ""), max_width, font_size, letter_spacing, attrs, 0, "", [])

    export let __text_lines_loop = (segments, max_width, font_size, letter_spacing, attrs, i, lines) =>
        i >= len(segments) ? (len(lines) == 0 ? [""] : lines) :
            wdoc::__text_lines_loop(
                segments,
                max_width,
                font_size,
                letter_spacing,
                attrs,
                i + 1,
                concat(lines, max_width > 0 ? wdoc::__wrap_segment(segments[i], max_width, font_size, letter_spacing, attrs) : [segments[i]])
            )

    export let __text_lines = (content, max_width, font_size, letter_spacing, attrs) =>
        wdoc::__text_lines_loop(split("\n", content), max_width, font_size, letter_spacing, attrs, 0, [])

    export let measure_text = text => {
        let attrs = wdoc::__text_attrs(text)
        let content = to_string(attr_or(attrs, "content", ""))
        let font_size = wdoc::__num_attr(attrs, "font_size", 14.0)
        let line_height = wdoc::__num_attr(attrs, "line_height", 1.2)
        let letter_spacing = attr_or(attrs, "letter_spacing", null) == null ? 0.0 : wdoc::__css_length(attr_or(attrs, "letter_spacing", 0), font_size)
        let width_value = attr_or(attrs, "max_width", attr_or(attrs, "width", null))
        let max_width = width_value == null ? 0.0 : to_float(width_value)
        let lines = wdoc::__text_lines(content, max_width, font_size, letter_spacing, attrs)
        let line_step = font_size * line_height
        {
            width = len(lines) == 0 ? 0.0 : max_of(map(lines, line => wdoc::__line_width(line, font_size, letter_spacing, attrs))),
            height = line_step * len(lines),
            baseline = max((line_step - font_size), 0.0) / 2.0 + font_size * 0.8
        }
    }

    // --- Template rendering functions ---

    export let slugify = value => regex_replace_all(regex_replace_all(regex_replace_all(lower(to_string(value)), "[^\\p{L}\\p{N}]", "-"), "^-+", ""), "-+$", "")

    export let render_heading_at = (b, level) => {
        let content = attr_or(b, "content", "")
        let id = wdoc::slugify(content)
        html::render({ tag = "h" + to_string(level), id = id, class_name = "wdoc-heading", html = wdoc::render_markup(content) })
    }

    export let render_heading = (b) => {
        let level = attr_or(b, "level", 1)
        let safe_level = level < 1 ? 1 : (level > 6 ? 6 : level)
        wdoc::render_heading_at(b, safe_level)
    }

    export let render_h1 = (b) => wdoc::render_heading_at(b, 1)
    export let render_h2 = (b) => wdoc::render_heading_at(b, 2)
    export let render_h3 = (b) => wdoc::render_heading_at(b, 3)
    export let render_h4 = (b) => wdoc::render_heading_at(b, 4)
    export let render_h5 = (b) => wdoc::render_heading_at(b, 5)
    export let render_h6 = (b) => wdoc::render_heading_at(b, 6)

    export let render_paragraph = (b) => {
        let content = attr_or(b, "content", "")
        let rendered = wdoc::render_markup(content)
        let has_block = contains(rendered, "<ul") || contains(rendered, "<ol") || contains(rendered, "<table") || contains(rendered, "<div")
        html::render({ tag = has_block ? "div" : "p", class_name = "wdoc-paragraph", html = rendered })
    }

    export let render_image = (b) => {
        let src = attr_or(b, "src", "")
        let alt = attr_or(b, "alt", "")
        let width = attr_or(b, "width", "")
        let height = attr_or(b, "height", "")
        html::render({ tag = "img", src = src, alt = alt != "" ? alt : null, width = width != "" ? width : null, height = height != "" ? height : null, class_name = "wdoc-image" })
    }

    export let render_code = (b) => {
        let content = attr_or(b, "content", "")
        let language = attr_or(b, "language", "")
        let code_class = language != "" ? "language-" + language : null
        html::render({ tag = "pre", class_name = "wdoc-code", children = [{ tag = "code", class_name = code_class, content = content }] })
    }

    export let render_equation = (b) => {
        let content = attr_or(b, "content", "")
        html::render({ tag = "div", class_name = "wdoc-equation", data_wdoc_equation = "display", content = "\\[" + content + "\\]" })
    }

    export let render_table = (b) => {
        let tbl = wdoc::table_rows(b)
        tbl.empty ? html::render({ tag = "p", class_name = "wdoc-paragraph", children = [{ tag = "em", content = "(empty table)" }] }) : html::render({
            tag = "table",
            class_name = "wdoc-table",
            children = concat(
                tbl.caption != "" ? [{ tag = "caption", html = wdoc::render_markup(tbl.caption) }] : [],
                concat(
                    len(tbl.headers) > 0 ? [{ tag = "thead", children = [{ tag = "tr", children = map(tbl.headers, header => { tag = "th", html = wdoc::render_markup(header) }) }] }] : [],
                    [{ tag = "tbody", children = map(tbl.rows, row => { tag = "tr", children = map(row, cell => { tag = "td", html = wdoc::render_markup(cell) }) }) }]
                )
            )
        })
    }

    export let render_callout = (b) => {
        let color = attr_or(b, "color", "var(--color-nav-border)")
        let header = attr_or(b, "header", "")
        let icon = attr_or(b, "icon", "")
        let icon_html = icon != "" ? wdoc::icon_styled(icon, "1em", color) + " " : ""
        let header_html = (header != "" || icon != "") ? html::render({ tag = "div", class_name = "wdoc-callout-header", style = { color = color }, children = [{ tag = "raw", html = icon_html + wdoc::render_markup(header) }] }) : ""
        html::render({
            tag = "div",
            class_name = "wdoc-callout",
            style = { border_left_color = color },
            children = [
                { tag = "raw", html = header_html },
                { tag = "div", class_name = "wdoc-callout-body", html = wdoc::render_children(b) }
            ]
        })
    }

    export let render_site_header = (b) => {
        let title = attr_or(b, "title", "")
        let logo = attr_or(b, "logo", "")
        let children_html = wdoc::render_children(b)
        html::render({ tag = "header", class_name = "wdoc-site-header", children = [{ tag = "div", class_name = "wdoc-site-header-inner", children = concat(
            logo != "" ? [{ tag = "img", class_name = "wdoc-site-logo", src = logo, alt = "" }] : [],
            concat(title != "" ? [{ tag = "div", class_name = "wdoc-site-title", html = wdoc::render_markup(title) }] : [], [{ tag = "raw", html = children_html }])
        ) }] })
    }

    export let render_site_nav = (b) => {
        let children_html = wdoc::render_children(b)
        html::render({ tag = "nav", class_name = "wdoc-site-nav", html = children_html })
    }

    export let render_site_footer = (b) => {
        let text = attr_or(b, "text", "")
        let children_html = wdoc::render_children(b)
        html::render({ tag = "footer", class_name = "wdoc-site-footer", children = concat(text != "" ? [{ tag = "p", html = wdoc::render_markup(text) }] : [], [{ tag = "raw", html = children_html }]) })
    }

    export let render_site_main = (b) => {
        let children_html = wdoc::render_children(b)
        html::render({ tag = "main", class_name = "wdoc-site-main", html = children_html })
    }

    export let render_site_section = (b) => {
        let title = attr_or(b, "title", "")
        let id = attr_or(b, "id", "")
        let children_html = wdoc::render_children(b)
        html::render({ tag = "section", id = id != "" ? id : null, class_name = "wdoc-site-section", children = concat(title != "" ? [{ tag = "h2", class_name = "wdoc-site-section-title", html = wdoc::render_markup(title) }] : [], [{ tag = "raw", html = children_html }]) })
    }

    export let render_site_hero = (b) => {
        let title = attr_or(b, "title", "")
        let subtitle = attr_or(b, "subtitle", "")
        let image = attr_or(b, "image", "")
        let children_html = wdoc::render_children(b)
        html::render({ tag = "section", class_name = "wdoc-site-hero", style = image != "" ? { background_image = "linear-gradient(rgba(0,0,0,.40),rgba(0,0,0,.40)),url('" + image + "')" } : null, children = [{ tag = "div", class_name = "wdoc-site-hero-inner", children = concat([{ tag = "h1", html = wdoc::render_markup(title) }], concat(subtitle != "" ? [{ tag = "p", html = wdoc::render_markup(subtitle) }] : [], [{ tag = "raw", html = children_html }])) }] })
    }

    export let render_site_card_grid = (b) => {
        let children_html = wdoc::render_children(b)
        html::render({ tag = "div", class_name = "wdoc-site-card-grid", html = children_html })
    }

    export let render_site_card = (b) => {
        let title = attr_or(b, "title", "")
        let href = attr_or(b, "href", "")
        let summary = attr_or(b, "summary", "")
        let children_html = wdoc::render_children(b)
        let body = concat([{ tag = "h3", html = wdoc::render_markup(title) }], concat(summary != "" ? [{ tag = "p", html = wdoc::render_markup(summary) }] : [], [{ tag = "raw", html = children_html }]))
        html::render({ tag = href != "" ? "a" : "div", class_name = "wdoc-site-card", href = href != "" ? href : null, children = body })
    }

    export let render_content_block = (b) => {
        let id = attr_or(b, "id", "")
        let style = attr_or(b, "style", "")
        let kind = attr_or(b, "css_kind", wdoc::style_target_leaf(attr_or(b, "kind", "")))
        let content_html = attr_or(b, "html", attr_or(b, "rendered_html", ""))
        let wrapped = (id != "" || style != "") ? html::render({ tag = "div", id = id != "" ? id : null, data_wdoc_content_id = id != "" ? id : null, class_name = style != "" ? "wdoc-style-" + style + "--" + kind : null, html = content_html }) : content_html
        wrapped + "\n"
    }

    export let render_split_group = (item) => {
        let dir_class = item.direction == "vertical" ? "wdoc-vsplit" : "wdoc-hsplit"
        let children_html = join("", map(item.splits, (split) => wdoc::render_split(split)))
        html::render({ tag = "div", class_name = dir_class, html = "\n" + children_html }) + "\n"
    }

    export let render_split = (item) => {
        let children_html = wdoc::render_layout_items(item.children)
        html::render({ tag = "div", class_name = "wdoc-split", style = "flex: 0 0 " + to_string(item.size_percent) + "%;", html = "\n" + children_html }) + "\n"
    }

    export let render_layout_item = (item) => {
        let item_kind = attr_or(item, "item_kind", "")
        item_kind == "content" ? wdoc::render_content_block(item) : (
            item_kind == "split_group" ? wdoc::render_split_group(item) : (
                item_kind == "split" ? wdoc::render_split(item) : ""
            )
        )
    }

    export let render_layout_items = (items) => join("", map(items, (item) => wdoc::render_layout_item(item)))

    export let script_node = source => { tag = "script", html = replace(to_string(source), "</", "<\\/") }

    export let script_src_node = src => { tag = "script", defer = true, src = src }

    export let path_parent_depth = path => {
        let parts = filter(split("/", to_string(path)), part => part != "")
        len(parts) <= 1 ? 0 : len(parts) - 1
    }

    export let repeat_text = (text, count) => count <= 0 ? "" : text + wdoc::repeat_text(text, count - 1)

    export let css_path_for = path => wdoc::repeat_text("../", wdoc::path_parent_depth(path)) + "styles.css"

    export let asset_href_for = (css_path, asset) => trim_suffix(css_path, "styles.css") + asset

    export let normalize_html_path = path => {
        let trimmed = trim_prefix(trim(to_string(path)), "/")
        trimmed == "" ? "index.html" : (
            ends_with(trimmed, "/") ? trimmed + "index.html" : (
                ends_with(trimmed, ".html") ? trimmed : trimmed + ".html"
            )
        )
    }

    export let page_output_path = page => attr_or(page, "path", null) != null ? wdoc::normalize_html_path(page.path) : page.id + ".html"

    export let section_output_path = section => "sections/" + wdoc::slugify(section.id) + ".html"

    export let relative_href = (from_path, to_path) =>
        starts_with(to_path, "http://") || starts_with(to_path, "https://") || starts_with(to_path, "/") ? to_path :
        wdoc::repeat_text("../", wdoc::path_parent_depth(from_path)) + to_path

    export let page_effective_template = (doc, page) => attr_or(page, "template", null) != null ? page.template : doc.template

    export let page_layout_items = page => attr_or(attr_or(page, "layout", {}), "children", [])

    export let page_signal_runtime = (ctx, page) => {
        let signals = attr_or(page, "signals", [])
        let bindings = attr_or(page, "bindings", [])
        len(signals) == 0 && len(bindings) == 0 ? null : replace(import_raw("<WCL>:/assets/wdoc/runtime/page_signal_template.js"), "__WDOC_SIGNAL_CONFIG_JSON__", json_encode({ signals = signals, bindings = bindings }))
    }

    export let page_view = (ctx, page) => {
        let output_path = wdoc::page_output_path(page)
        map_merge(page, {
            template = wdoc::page_effective_template(ctx.doc, page),
            output_path = output_path,
            css_path = wdoc::css_path_for(output_path),
            layout_items = wdoc::page_layout_items(page),
            signal_runtime = wdoc::page_signal_runtime(ctx, page),
            href = output_path
        })
    }

    export let page_views = ctx => map(filter(ctx.doc.pages, page => attr_or(page, "draft", false) != true), page => wdoc::page_view(ctx, page))

    export let pages_for_section = (pages_by_section, section, from_path) =>
        map(attr_or(pages_by_section, section.id, []), page => map_merge(page, { href = wdoc::relative_href(from_path, page.output_path) }))

    export let first_page_for_section = (pages_by_section, section) => {
        let direct = attr_or(pages_by_section, section.id, [])
        len(direct) > 0 ? direct[0] : null
    }

    export let first_page_path_for_section = (pages_by_section, section) => {
        let page = wdoc::first_page_for_section(pages_by_section, section)
        page != null ? page.output_path : (
            len(section.children) > 0 ? wdoc::first_page_path_for_section(pages_by_section, section.children[0]) : "#"
        )
    }

    export let section_view = (pages_by_section, section) => {
        let output_path = wdoc::section_output_path(section)
        map_merge(section, {
            output_path = output_path,
            css_path = wdoc::css_path_for(output_path),
            pages = wdoc::pages_for_section(pages_by_section, section, output_path),
            first_page_path = wdoc::first_page_path_for_section(pages_by_section, section),
            children = map(section.children, child => wdoc::section_view(pages_by_section, child))
        })
    }

    export let section_views = (pages_by_section, sections) => map(sections, section => wdoc::section_view(pages_by_section, section))

    export let collect_section_outputs = sections => flat_map(sections, section => {
        let own = (len(section.pages) > 0 || len(section.children) > 0) ? [{ kind = "section", section = section }] : []
        concat(own, wdoc::collect_section_outputs(section.children))
    })

    export let term_values = (pages, kind) => distinct(flat_map(pages, page => kind == "tags" ? attr_or(page, "tags", []) : attr_or(page, "categories", [])))

    export let taxonomy_outputs = (pages, kind) => map(wdoc::term_values(pages, kind), term => {
        let path = kind + "/" + wdoc::slugify(term) + ".html"
        {
            kind = "taxonomy",
            path = path,
            title = kind + ": " + term,
            pages = map(filter(pages, page => contains(kind == "tags" ? attr_or(page, "tags", []) : attr_or(page, "categories", []), term)), page => map_set(page, "href", wdoc::relative_href(path, page.output_path)))
        }
    })

    export let section_presentation_pages = (section, pages_by_section) => {
        let own = attr_or(pages_by_section, section.id, [])
        let first = len(own) > 0 ? [own[0]] : []
        concat(first, flat_map(section.children, child => wdoc::section_presentation_pages(child, pages_by_section)))
    }

    export let presentation_grid = (doc, pages, pages_by_section) => {
        let rows = filter_map(doc.sections, section => {
            let row = wdoc::section_presentation_pages(section, pages_by_section)
            len(row) > 0 ? row : null
        })
        let row_ids = flat_map(rows, row => list_attr(row, "id"))
        let uncategorized = filter(pages, page => !contains(row_ids, page.id))
        len(uncategorized) > 0 ? concat(rows, [uncategorized]) : rows
    }

    export let row_index_for_page = (grid, page_id, i) =>
        i >= len(grid) ? -1 : (contains(list_attr(grid[i], "id"), page_id) ? i : wdoc::row_index_for_page(grid, page_id, i + 1))

    export let page_index_in_row = (row, page_id) => index_of(list_attr(row, "id"), page_id)

    export let nearest_slide = (grid, row, col) =>
        row < 0 || row >= len(grid) || len(grid[row]) == 0 ? null : grid[row][min(col, len(grid[row]) - 1)]

    export let presentation_nav_from_grid = (grid, page) => {
        let row = wdoc::row_index_for_page(grid, page.id, 0)
        let col = row < 0 ? -1 : wdoc::page_index_in_row(grid[row], page.id)
        {
            left = row >= 0 && col > 0 ? grid[row][col - 1].output_path : null,
            right = row >= 0 && col + 1 < len(grid[row]) ? grid[row][col + 1].output_path : null,
            up = row > 0 ? wdoc::nearest_slide(grid, row - 1, col).output_path : null,
            down = row >= 0 && row + 1 < len(grid) ? wdoc::nearest_slide(grid, row + 1, col).output_path : null
        }
    }

    export let prepare_pages = ctx => {
        let pages = wdoc::page_views(ctx)
        let pages_by_section = group_by_attr(pages, "section_id")
        let grid = wdoc::presentation_grid(ctx.doc, pages, pages_by_section)
        map(pages, page => map_merge(page, { presentation_nav = wdoc::presentation_nav_from_grid(grid, page) }))
    }

    export let prepare_render_context = ctx => {
        let pages = wdoc::prepare_pages(ctx)
        let pages_by_section = group_by_attr(pages, "section_id")
        let sections = wdoc::section_views(pages_by_section, ctx.doc.sections)
        let doc = map_merge(ctx.doc, { pages = pages, sections = sections })
        map_merge(ctx, { doc = doc, site_outputs = concat(wdoc::collect_section_outputs(sections), concat(wdoc::taxonomy_outputs(pages, "tags"), wdoc::taxonomy_outputs(pages, "categories"))) })
    }

    export let document_head = (doc, title, css_path, content_html) => {
        let math_nodes = contains(content_html, "data-wdoc-equation=") ? [
            wdoc::script_src_node(wdoc::asset_href_for(css_path, doc.runtime.mathjax_config)),
            { tag = "script", defer = true, src = "https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js" }
        ] : []
        { tag = "head", children = concat([
            { tag = "meta", charset = "utf-8" },
            { tag = "meta", name = "viewport", content_attr = "width=device-width, initial-scale=1" },
            { tag = "title", content = title + " — " + doc.title },
            { tag = "link", rel = "stylesheet", href = css_path },
            { tag = "link", rel = "stylesheet", href = wdoc::asset_href_for(css_path, "highlight-light.min.css"), id = "hljs-light" },
            { tag = "link", rel = "stylesheet", href = wdoc::asset_href_for(css_path, "highlight-dark.min.css"), id = "hljs-dark", disabled = true },
            wdoc::script_src_node(wdoc::asset_href_for(css_path, "highlight.min.js")),
            wdoc::script_src_node(wdoc::asset_href_for(css_path, "wcl-grammar.js"))
        ], math_nodes) }
    }

    export let document_html = (doc, title, css_path, content_html, body_class, body_children) => {
        let node = {
            tag = "html",
            lang = "en",
            children = [
                wdoc::document_head(doc, title, css_path, content_html),
                { tag = "body", class_name = body_class, children = body_children }
            ]
        }
        "<!DOCTYPE html>" + codec_encode("html", node, {}) + "\n"
    }

    export let site_page_card = page => {
        tag = "a",
        class_name = "wdoc-site-card",
        href = page.href,
        children = concat(
            [{ tag = "h3", content = page.title }],
            concat(
                page.summary != null ? [{ tag = "p", content = page.summary }] : [],
                page.date != null ? [{ tag = "span", content = page.date }] : []
            )
        )
    }

    export let site_before_main = doc => {
        let header = doc.site.header_html != null ? doc.site.header_html + "\n" : ""
        let nav = doc.site.nav_html != null ? doc.site.nav_html + "\n" : ""
        header + nav
    }

    export let site_after_main = doc => doc.site.footer_html != null ? doc.site.footer_html : ""

    export let site_shell = (doc, title, css_path, content_html, body_class, main_class, before_main, after_main, runtime) => {
        let before_nodes = before_main != "" ? [{ tag = "raw", html = before_main }] : []
        let after_nodes = after_main != "" ? [{ tag = "raw", html = after_main }] : []
        let runtime_nodes = runtime != null ? [wdoc::script_node(runtime)] : []
        let body_nodes = concat(
            before_nodes,
            concat(
                [{ tag = "main", class_name = main_class, html = content_html }],
                concat(after_nodes, concat(runtime_nodes, [wdoc::script_src_node(wdoc::asset_href_for(css_path, doc.runtime.theme))]))
            )
        )
        wdoc::document_html(doc, title, css_path, content_html, body_class, body_nodes)
    }

    export let nav_section_item = (section, active_section) => {
        let child_nodes = len(section.children) > 0 ? [{ tag = "ul", children = map(section.children, child => wdoc::nav_section_item(child, active_section)) }] : []
        {
            tag = "li",
            children = concat([{
                tag = "a",
                href = section.first_page_path != null ? section.first_page_path : "#",
                class_name = active_section == section.id ? "active" : null,
                content = section.title
            }], child_nodes)
        }
    }

    export let book_nav = (doc, active_section) => html::render({
        tag = "nav",
        class_name = "wdoc-nav",
        children = [
            { tag = "div", class_name = "wdoc-nav-title", content = doc.title },
            { tag = "ul", children = map(doc.sections, section => wdoc::nav_section_item(section, active_section)) },
            {
                tag = "div",
                class_name = "wdoc-theme-toggle",
                id = "wdoc-theme-toggle",
                children = [
                    { tag = "span", id = "wdoc-theme-icon", class_name = "wdoc-theme-icon", html = "&#x1F319;" },
                    { tag = "div", class_name = "wdoc-theme-toggle-track", children = [{ tag = "div", class_name = "wdoc-theme-toggle-knob" }] },
                    { tag = "span", content = "Dark mode" }
                ]
            }
        ]
    })

    @page_template("book")
    export let page_template_book = (ctx, page) => {
        let content_html = wdoc::render_layout_items(page.layout_items)
        wdoc::site_shell(ctx.doc, page.title, page.css_path, content_html, "wdoc-template-book", "wdoc-content", wdoc::book_nav(ctx.doc, page.section_id), "", page.signal_runtime)
    }

    @page_template("site")
    export let page_template_site = (ctx, page) => {
        let content_html = wdoc::render_layout_items(page.layout_items)
        wdoc::site_shell(ctx.doc, page.title, page.css_path, content_html, "wdoc-template-site", "wdoc-site-main", wdoc::site_before_main(ctx.doc), wdoc::site_after_main(ctx.doc), page.signal_runtime)
    }

    export let presentation_nav_link = (href, direction, label) => href == null ? null : {
        tag = "a",
        href = href,
        data_wdoc_slide_up = direction == "up" ? true : null,
        data_wdoc_slide_left = direction == "left" ? true : null,
        data_wdoc_slide_right = direction == "right" ? true : null,
        data_wdoc_slide_down = direction == "down" ? true : null,
        aria_label = label
    }

    export let presentation_nav_links = nav => filter([
        wdoc::presentation_nav_link(nav.up, "up", "Previous section"),
        wdoc::presentation_nav_link(nav.left, "left", "Previous slide"),
        wdoc::presentation_nav_link(nav.right, "right", "Next slide"),
        wdoc::presentation_nav_link(nav.down, "down", "Next section")
    ], item => item != null)

    @page_template("presentation")
    export let page_template_presentation = (ctx, page) => {
        let content_html = wdoc::render_layout_items(page.layout_items)
        let body_nodes = concat([{
            tag = "main",
            class_name = "wdoc-presentation",
            aria_label = "Presentation slide",
            children = [
                { tag = "nav", class_name = "wdoc-presentation-nav", aria_hidden = "true", children = wdoc::presentation_nav_links(page.presentation_nav) },
                { tag = "section", class_name = "wdoc-slide", html = content_html }
            ]
        }], concat(page.signal_runtime != null ? [wdoc::script_node(page.signal_runtime)] : [], [
            wdoc::script_src_node(wdoc::asset_href_for(page.css_path, ctx.runtime.theme)),
            wdoc::script_src_node(wdoc::asset_href_for(page.css_path, ctx.runtime.presentation))
        ]))
        wdoc::document_html(ctx.doc, page.title, page.css_path, content_html, "wdoc-template-presentation", body_nodes)
    }

    export let page_template_html = (ctx, page) => {
        let template_name = page["template"]
        template_name == "book" ? wdoc::page_template_book(ctx, page) : (
            template_name == "site" ? wdoc::page_template_site(ctx, page) : (
                template_name == "presentation" ? wdoc::page_template_presentation(ctx, page) : ""
            )
        )
    }

    export let render_page_output = (ctx, page) => {
        path = page.output_path,
        html = wdoc::page_template_html(ctx, page)
    }

    export let section_output_html = (ctx, section) => {
        let child_links = map(section.children, child => {
            tag = "a",
            class_name = "wdoc-site-list-item",
            href = wdoc::relative_href(section.output_path, child.output_path),
            children = [{ tag = "h3", content = child.title }]
        })
        let cards = map(section.pages, page => wdoc::site_page_card(page))
        html::render({
            tag = "section",
            class_name = "wdoc-site-list",
            children = [
                { tag = "h1", content = section.title },
                { tag = "raw", html = html::render(child_links) },
                { tag = "div", class_name = "wdoc-site-card-grid", children = cards }
            ]
        })
    }

    export let taxonomy_output_html = output => html::render({
        tag = "section",
        class_name = "wdoc-site-list",
        children = [
            { tag = "h1", content = output.title },
            { tag = "div", class_name = "wdoc-site-card-grid", children = map(output.pages, page => wdoc::site_page_card(page)) }
        ]
    })

    export let render_site_output = (ctx, output) => {
        let path = output.kind == "section" ? output.section.output_path : output.path
        let title = output.kind == "section" ? output.section.title : output.title
        let css_path = output.kind == "section" ? output.section.css_path : "../styles.css"
        let content_html = output.kind == "section" ? wdoc::section_output_html(ctx, output.section) : wdoc::taxonomy_output_html(output)
        {
            path = path,
            html = wdoc::site_shell(ctx.doc, title, css_path, content_html, "wdoc-template-site", "wdoc-site-main", wdoc::site_before_main(ctx.doc), wdoc::site_after_main(ctx.doc), null)
        }
    }

    export let redirect_output = ctx => {
        let paths = map(ctx.doc.pages, page => page.output_path)
        let first = len(ctx.doc.pages) > 0 ? ctx.doc.pages[0] : null
        contains(paths, "index.html") || first == null ? [] : [{
            path = "index.html",
            html = "<!DOCTYPE html>" + html::render({ tag = "html", children = [{ tag = "head", children = [{ tag = "meta", http_equiv = "refresh", content_attr = "0;url=" + first.output_path }] }, { tag = "body" }] })
        }]
    }

    export let render_html_outputs = ctx => {
        let prepared = wdoc::prepare_render_context(ctx)
        concat(
            concat(map(prepared.doc.pages, page => wdoc::render_page_output(prepared, page)), prepared.doc.template == "site" ? map(prepared.site_outputs, output => wdoc::render_site_output(prepared, output)) : []),
            wdoc::redirect_output(prepared)
        )
    }

    export let render_context = doc => {
        let runtime = map_has(doc, "runtime") ? doc.runtime : {}
        let doc_with_runtime = map_merge(doc, { runtime = runtime })
        { doc = doc_with_runtime, runtime = runtime }
    }

    export let runtime_assets = () => {
        mathjax_config = "wdoc-mathjax-config.js"
        theme = "wdoc-theme.js"
        presentation = "wdoc-presentation.js"
    }

    export let prepare_site_document = doc => map_merge(doc, { runtime = wdoc::runtime_assets() })

    export let raw_css_node = content => { kind = "raw", content = content }

    export let site_css_children = doc => concat(
        [wdoc::style_css(map_has(doc, "styles") ? doc.styles : [])],
        concat(
            map(attr_or(doc, "font_css", []), css => wdoc::raw_css_node(css)),
            concat(
                map(attr_or(doc, "global_css", []), css => wdoc::raw_css_node(css)),
                concat(
                    map(attr_or(doc, "css_fragments", []), css => wdoc::raw_css_node(css)),
                    [wdoc::raw_css_node(map_has(doc, "extra_css") ? doc.extra_css : "")]
                )
            )
        )
    )

    export let site_css = doc => {
        kind = "stylesheet",
        children = wdoc::site_css_children(doc)
    }

    export let html_output_file = output => {
        path = output.path,
        content = output.html
    }

    export let embedded_asset_file = (path, src) => {
        path = path,
        content = file_stream(src)
    }

    export let local_asset_file = asset => {
        path = asset.path,
        content = file_stream(asset.src, { allow_absolute = true })
    }

    export let local_asset_files = doc => map(attr_or(doc, "assets", []), asset => wdoc::local_asset_file(asset))

    export let embedded_asset_files = () => [
        wdoc::embedded_asset_file("highlight.min.js", "<WCL>:/assets/highlightjs/highlight.min.js"),
        wdoc::embedded_asset_file("highlight-light.min.css", "<WCL>:/assets/highlightjs/github.min.css"),
        wdoc::embedded_asset_file("highlight-dark.min.css", "<WCL>:/assets/highlightjs/github-dark.min.css"),
        wdoc::embedded_asset_file("wcl-grammar.js", "<WCL>:/assets/highlightjs/wcl.js"),
        wdoc::embedded_asset_file("wdoc-theme.js", "<WCL>:/assets/wdoc/runtime/theme.js"),
        wdoc::embedded_asset_file("wdoc-presentation.js", "<WCL>:/assets/wdoc/runtime/presentation.js"),
        wdoc::embedded_asset_file("wdoc-mathjax-config.js", "<WCL>:/assets/wdoc/runtime/mathjax_config.js"),
        wdoc::embedded_asset_file("fonts/JetBrainsMonoNerdFontMono-Regular.ttf", "<WCL>:/assets/fonts/JetBrainsMonoNerdFontMono-Regular.ttf"),
        wdoc::embedded_asset_file("fonts/JetBrainsMonoNerdFontMono-Bold.ttf", "<WCL>:/assets/fonts/JetBrainsMonoNerdFontMono-Bold.ttf"),
        wdoc::embedded_asset_file("fonts/JetBrainsMonoNerdFontMono-Italic.ttf", "<WCL>:/assets/fonts/JetBrainsMonoNerdFontMono-Italic.ttf"),
        wdoc::embedded_asset_file("fonts/JetBrainsMonoNerdFontMono-BoldItalic.ttf", "<WCL>:/assets/fonts/JetBrainsMonoNerdFontMono-BoldItalic.ttf")
    ]

    export let project_schema_matches = (registered, requested) => registered == requested || registered == wdoc::kind_leaf(requested)

    export let builtin_shape_template_name = (project, schema_name) => {
        let leaf = wdoc::kind_leaf(schema_name)
        let widget_name = "wdoc::widget_" + leaf
        let terminal_name = starts_with(leaf, "terminal_") ? "wdoc::terminal_widget_" + trim_prefix(leaf, "terminal_") : null
        map_has(project.values, widget_name) ? widget_name : (
            terminal_name != null && map_has(project.values, terminal_name) ? terminal_name : null
        )
    }

    declare project_template_name_native(project: map(string, any), fmt: string, schema_name: string) -> any

    export let project_template_name = (project, fmt, schema_name) => wdoc::project_template_name_native(project, fmt, schema_name)

    declare project_extends_name_native(project: map(string, any), schema_name: string) -> any

    export let project_extends_name = (project, schema_name) => wdoc::project_extends_name_native(project, schema_name)

    export let kind_leaf = kind => {
        let parts = split("::", to_string(kind))
        len(parts) == 0 ? to_string(kind) : parts[len(parts) - 1]
    }

    export let kind_matches = (kind, name) => kind == name || kind == "wdoc::" + name

    export let block_is = (block, name) => wdoc::kind_matches(block_kind(block), name)

    export let block_attr_map = block => block_attrs(block)

    export let block_title = block => {
        let attrs = block_attrs(block)
        let args = attr_or(attrs, "_args", [])
        attr_or(attrs, "title", len(args) > 0 ? args[0] : attr_or(attrs, "id", ""))
    }

    export let child_blocks_matching = (block, name) => block_body_children_kinds(block, [name, "wdoc::" + name])

    export let top_level_blocks_matching = (project, name) => filter(values(project.values), value => type_of(value) == "block_ref" && wdoc::block_is(value, name))

    export let project_block_values = project => filter(values(project.values), value => type_of(value) == "block_ref")

    export let project_blocks_collecting = (project, names) => {
        let qualified = concat(names, map(names, name => "wdoc::" + name))
        flat_map(wdoc::project_block_values(project), block => block_collect_kinds(block, qualified))
    }

    export let source_path = (project, path) => {
        let raw = to_string(path)
        let candidates = map(project.source_dirs, dir => dir + "/" + raw)
        let matches = filter(candidates, candidate => file_exists(candidate, { allow_absolute = true }))
        len(matches) > 0 ? matches[0] : raw
    }

    export let read_text_file = (project, path) => {
        let src = wdoc::source_path(project, path)
        file_exists(src, { allow_absolute = true }) ? {
            let chunks = file_stream(src, { allow_absolute = true }).to_list()
            len(chunks) == 0 ? "" : bytes_to_utf8(bytes_data(chunks[0]))
        } : ""
    }

    export let icon_sets_in_block = block => block_collect_kinds(block, ["wdoc::icon_set", "icon_set"])

    export let icon_part_value = part => {
        let attrs = block_attrs(part)
        {
            name = attr_or(attrs, "id", ""),
            selector = attr_or(attrs, "selector", ""),
            property = attr_or(attrs, "property", ""),
            default = attr_or(attrs, "default", null)
        }
    }

    export let icon_set_value = icon_set_block => {
        let attrs = block_attrs(icon_set_block)
        {
            id = attr_or(attrs, "id", ""),
            path = attr_or(attrs, "path", ""),
            default = attr_or(attrs, "default", false),
            normalize_width = attr_or(attrs, "normalize_width", null),
            normalize_height = attr_or(attrs, "normalize_height", null),
            normalize_mode = attr_or(attrs, "normalize_mode", "viewbox"),
            parts = filter_map(block_body_children(icon_set_block), child => wdoc::block_is(child, "icon_part") ? wdoc::icon_part_value(child) : null)
        }
    }

    export let collect_icon_sets = project => map(wdoc::project_blocks_collecting(project, ["icon_set"]), icon_set_block => wdoc::icon_set_value(icon_set_block))

    export let split_icon_set = name => {
        let parts = split(":", to_string(name))
        len(parts) > 1 ? { set_name = parts[0], name = parts[1] } : { set_name = null, name = to_string(name) }
    }

    export let default_icon_set = icon_sets => {
        let defaults = filter(icon_sets, icon_set_item => icon_set_item.default == true)
        len(defaults) > 0 ? defaults[0] : (len(icon_sets) > 0 ? icon_sets[0] : null)
    }

    export let find_icon_set = (icon_sets, requested) => {
        let matches = filter(icon_sets, icon_set_item => icon_set_item.id == requested)
        len(matches) > 0 ? matches[0] : null
    }

    export let icon_part_css = part => part.selector != "" && part.property != "" ? part.selector + "{" + part.property + ":var(--wdoc-icon-" + part.name + (part.default != null ? "," + part.default : "") + ");}" : ""

    export let icon_css = icon_set_item => ":where(path,rect,circle,ellipse,polygon,polyline,line,text,tspan):not([fill]){fill:var(--wdoc-icon-fill,currentColor);}:where(path,rect,circle,ellipse,polygon,polyline,line,text,tspan):not([stroke]){stroke:var(--wdoc-icon-stroke,none);}" + join("", map(icon_set_item.parts, part => wdoc::icon_part_css(part)))

    export let icon_style_vars = props => join("", map(keys(props), key => "--wdoc-icon-" + key + ":" + to_string(props[key]) + ";"))

    export let url_component_decode_basic = value => replace(replace(replace(replace(to_string(value), "%23", "#"), "%20", " "), "%2F", "/"), "%3A", ":")

    export let icon_props_from_query = query => reduce(filter(split("&", replace(to_string(query), "&amp;", "&")), part => part != ""), {}, (acc, part) => {
        let pieces = split("=", part)
        len(pieces) > 1 ? map_set(acc, wdoc::url_component_decode_basic(pieces[0]), wdoc::url_component_decode_basic(pieces[1])) : acc
    })

    export let resolve_icon = (project, name, set_name, normalize_width, normalize_height, normalize_mode) => {
        let icon_sets = attr_or(project, "_wdoc_icon_sets", wdoc::collect_icon_sets(project))
        let split_name = wdoc::split_icon_set(name)
        let chosen_name = set_name != null && to_string(set_name) != "" ? set_name : split_name.set_name
        let icon_set_item = chosen_name != null ? wdoc::find_icon_set(icon_sets, chosen_name) : wdoc::default_icon_set(icon_sets)
        icon_set_item == null ? null : {
            let content = wdoc::read_text_file(project, icon_set_item.path + "/" + split_name.name + ".svg")
            content == "" ? null : {
                name = split_name.name,
                content = content,
                css = wdoc::icon_css(icon_set_item),
                normalize_width = normalize_width != null ? normalize_width : icon_set_item.normalize_width,
                normalize_height = normalize_height != null ? normalize_height : icon_set_item.normalize_height,
                normalize_mode = normalize_mode != null ? normalize_mode : icon_set_item.normalize_mode
            }
        }
    }

    export let render_inline_icon_svg = (icon, size, props) => {
        let svg = icon.content
        let style = wdoc::icon_style_vars(props)
        let open = "<svg class=\"wdoc-icon\" width=\"" + size + "\" height=\"" + size + "\" style=\"" + wdoc::html_escape(style) + "\" "
        contains(svg, "<svg ") ? replace(svg, "<svg ", open) : (contains(svg, "<svg\n") ? replace(svg, "<svg\n", open + "\n") : svg)
    }

    export let render_inline_icon_from_tag = (project, tag) => {
        let names = regex_capture(tag, "data-name=\"([^\"]*)\"")
        let sizes = regex_capture(tag, "data-size=\"([^\"]*)\"")
        let sets = regex_capture(tag, "data-set=\"([^\"]*)\"")
        let props_values = regex_capture(tag, "data-props=\"([^\"]*)\"")
        let name = len(names) > 0 ? names[0] : ""
        let size = len(sizes) > 0 ? sizes[0] : "1em"
        let set_name = len(sets) > 0 ? sets[0] : null
        let props = len(props_values) > 0 ? wdoc::icon_props_from_query(props_values[0]) : {}
        let icon = wdoc::resolve_icon(project, name, set_name, null, null, null)
        icon == null ? html::render({ tag = "span", class_name = "wdoc-icon wdoc-icon-missing", aria_hidden = "true", content = name }) : wdoc::render_inline_icon_svg(icon, size, props)
    }

    export let resolve_icons = (project, html) => {
        let tags = distinct(regex_find_all(html, "<span data-wdoc-icon=\"true\"[^>]*></span>"))
        len(tags) == 0 ? html : reduce(tags, html, (acc, tag) => replace(acc, tag, wdoc::render_inline_icon_from_tag(project, tag)))
    }

    export let render_project_block = (project, block) => {
        let kind = block_kind(block)
        let is_structural = wdoc::block_is(block, "layout") || wdoc::block_is(block, "section") || wdoc::block_is(block, "page") || wdoc::block_is(block, "doc") || wdoc::block_is(block, "style")
        is_structural ? "" : (
            wdoc::kind_leaf(kind) == "diagram" ? wdoc::render_project_diagram(project, block) : {
                let fn_name = wdoc::project_template_name(project, "html", kind)
                let needs_project = contains(["wdoc::callout", "wdoc::site_header", "wdoc::site_nav", "wdoc::site_footer", "wdoc::site_main", "wdoc::site_section", "wdoc::site_hero", "wdoc::site_card_grid", "wdoc::site_card"], kind)
                let template_block = needs_project ? block_set_attr(block, "_wdoc_project", project) : block
                fn_name == null || !map_has(project.values, fn_name) ? "" : wdoc::resolve_icons(project, project.values[fn_name](template_block))
            }
        )
    }

    export let shape_descriptor_with_project = (project, item, sheets) => {
        let item_type = type_of(item)
        item_type == "block_ref" ? wdoc::shape_from_block(project, item, sheets) : (
            item_type != "map" && item_type != "object" ? item : (
                map_has(item, "children") ? map_set(item, "children", map(item.children, child => wdoc::shape_descriptor_with_project(project, child, sheets))) : item
            )
        )
    }

    export let shape_template_result = (project, block, schema_name, stack, sheets) => {
        let has_cycle = contains(stack, schema_name)
        has_cycle ? [] : {
            let fn_name = wdoc::project_template_name(project, "shape", schema_name)
            let missing = fn_name == null || !map_has(project.values, fn_name)
            missing ? [] : {
                let base_schema = wdoc::project_extends_name(project, schema_name)
                let base = base_schema != null ? wdoc::shape_template_result(project, block, base_schema, concat(stack, [schema_name]), sheets) : null
                let result = base_schema != null ? project.values[fn_name](block, base) : project.values[fn_name](block)
                let result_type = type_of(result)
                let shapes = result_type == "list" ? result : (result_type == "map" || result_type == "object" ? attr_or(result, "shapes", []) : [])
                map(shapes, item => wdoc::shape_descriptor_with_project(project, item, sheets))
            }
        }
    }

    export let is_structural_shape = (project, block) => {
        let kind = block_kind(block)
        contains(project.metadata.structural_schemas, kind) || contains(project.metadata.structural_schemas, wdoc::kind_leaf(kind))
    }

    export let is_connection_block = block => block_kind(block) == "wdoc::draw::connection"

    export let is_shape_skip_block = (project, block) =>
        wdoc::is_connection_block(block) || wdoc::is_structural_shape(project, block) ||
        contains(["wdoc::draw::event", "wdoc::draw::class", "wdoc::draw::state", "wdoc::draw::animation", "wdoc::draw::keyframe", "wdoc::draw::dopesheet"], block_kind(block))

    export let shape_skip_kinds = project => concat(project.metadata.structural_schemas, [
        "wdoc::draw::connection",
        "wdoc::draw::event",
        "wdoc::draw::class",
        "wdoc::draw::state",
        "wdoc::draw::animation",
        "wdoc::draw::keyframe",
        "wdoc::draw::dopesheet",
        "connection",
        "event",
        "class",
        "state",
        "animation",
        "keyframe",
        "dopesheet"
    ])

    export let dopesheet_blocks_in = block => block_collect_kinds(block, ["wdoc::draw::dopesheet", "dopesheet"])

    export let dopesheet_value = block => {
        let attrs = block_attrs(block)
        map_set(attrs, "id", attr_or(attrs, "id", block_id(block)))
    }

    export let dopesheets_for_diagram = diagram => map(wdoc::dopesheet_blocks_in(diagram), sheet => wdoc::dopesheet_value(sheet))

    export let find_dopesheet = (sheets, id) => {
        let matches = filter(sheets, sheet => sheet.id == id)
        len(matches) > 0 ? matches[0] : null
    }

    export let apply_dopesheet_attrs = (attrs, sheets) => {
        let kind = attr_or(attrs, "kind", "")
        let sheet_id = attr_or(attrs, "sheet", attr_or(attrs, "dopesheet", ""))
        let sheet = sheet_id != "" ? wdoc::find_dopesheet(sheets, sheet_id) : null
        sheet == null || !(kind == "sprite" || kind == "dopesheet_view" || kind == "tilemap") ? attrs : (
            map_merge(attrs, {
                _wdoc_sheet_src = attr_or(sheet, "src", ""),
                _wdoc_sheet_columns = attr_or(sheet, "columns", ""),
                _wdoc_sheet_frame_width = attr_or(sheet, "frame_width", ""),
                _wdoc_sheet_frame_height = attr_or(sheet, "frame_height", ""),
                _wdoc_sheet_rows = attr_or(sheet, "rows", ""),
                _wdoc_sheet_frames = attr_or(sheet, "frames", "")
            })
        )
    }

    export let hydrate_inline_svg_shape = (project, attrs) => {
        let src = attr_or(attrs, "src", "")
        src != "" && !map_has(attrs, "_wdoc_inline_svg_content") && !map_has(attrs, "content") ? map_merge(attrs, { _wdoc_inline_svg_content = wdoc::read_text_file(project, src) }) : attrs
    }

    export let hydrate_icon_shape = (project, attrs) => {
        let name = attr_or(attrs, "name", "")
        let icon = name == "" ? null : wdoc::resolve_icon(project, name, attr_or(attrs, "icon_set", attr_or(attrs, "set", null)), attr_or(attrs, "normalize_width", null), attr_or(attrs, "normalize_height", null), attr_or(attrs, "normalize_mode", null))
        icon == null ? map_merge(attrs, { _wdoc_icon_missing = name }) : map_merge(attrs, {
            _wdoc_icon_content = icon.content,
            _wdoc_icon_css = icon.css,
            _wdoc_icon_normalize_mode = icon.normalize_mode,
            _wdoc_icon_normalize_width = icon.normalize_width,
            _wdoc_icon_normalize_height = icon.normalize_height
        })
    }

    export let shape_attrs = (project, block, sheets) => {
        let attrs = block_attrs(block)
        let kind = wdoc::kind_leaf(block_kind(block))
        let with_kind = wdoc::apply_dopesheet_attrs(map_merge(attrs, { kind = kind, id = attr_or(attrs, "id", block_id(block)) }), sheets)
        kind == "inline_svg" ? wdoc::hydrate_inline_svg_shape(project, with_kind) : (kind == "icon" ? wdoc::hydrate_icon_shape(project, with_kind) : with_kind)
    }

    export let shape_from_block = (project, block, sheets) => {
        let kind = block_kind(block)
        let is_composite = wdoc::project_template_name(project, "shape", kind) != null
        let template_shapes = is_composite ? wdoc::shape_template_result(project, block, kind, [], sheets) : []
        let child_shapes = wdoc::shape_blocks(project, block, sheets)
        let attrs = wdoc::shape_attrs(project, block, sheets)
        let base = is_composite ? map_merge(attrs, { fill = attr_or(attrs, "fill", "none"), stroke = attr_or(attrs, "stroke", "none") }) : attrs
        map_set(base, "children", concat(template_shapes, child_shapes))
    }

    export let shape_blocks = (project, block, sheets) =>
        map(block_body_children_except_kinds(block, wdoc::shape_skip_kinds(project)), child => wdoc::shape_from_block(project, child, sheets))

    export let connection_from_block = block => {
        let attrs = block_attrs(block)
        map_merge(attrs, { from = attr_or(attrs, "from", ""), to = attr_or(attrs, "to", "") })
    }

    export let connections_in_block = block => map(block_collect_kinds(block, ["wdoc::draw::connection"]), child => wdoc::connection_from_block(child))

    export let diagram_value = (project, block) => {
        let attrs = block_attrs(block)
        let sheets = wdoc::dopesheets_for_diagram(block)
        {
            id = block_id(block),
            width = attr_or(attrs, "width", 600),
            height = attr_or(attrs, "height", 400),
            align = attr_or(attrs, "align", "none"),
            gap = attr_or(attrs, "gap", 40),
            padding = attr_or(attrs, "padding", 0),
            shapes = wdoc::shape_blocks(project, block, sheets),
            connections = wdoc::connections_in_block(block)
        }
    }

    declare primitive_diagram_value(project: map(string, any), block: any) -> any

    export let render_project_diagram = (project, block) => {
        let native = wdoc::primitive_diagram_value(project, block)
        let attrs = block_attrs(block)
        let diagram = native == null ? wdoc::diagram_value(project, block) : native
        let without_inline_css = map_set(diagram, "css", "")
        let html = diagram_svg(without_inline_css)
        let design_system = attr_or(attrs, "design_system", "")
        design_system == "" ? html : "<div class=\"wad-ds-" + design_system + "\">" + html + "</div>"
    }

    export let extract_section = (project, block, parent_path) => {
        let short_id = attr_or(block_attrs(block), "id", "")
        let id = parent_path == "" ? short_id : parent_path + "." + short_id
        {
            id = id,
            short_id = short_id,
            title = wdoc::block_title(block),
            children = map(wdoc::child_blocks_matching(block, "section"), child => wdoc::extract_section(project, child, id))
        }
    }

    export let extract_signal = block => {
        let attrs = block_attrs(block)
        { name = attr_or(attrs, "id", ""), initial = attr_or(attrs, "initial", null), type_name = attr_or(attrs, "type", null) }
    }

    export let binding_blocks_in = block => block_collect_kinds(block, ["wdoc::binding", "binding"])

    export let extract_binding = block => {
        let attrs = block_attrs(block)
        { name = attr_or(attrs, "id", null), signal = attr_or(attrs, "signal", ""), target = attr_or(attrs, "target", ""), property = attr_or(attrs, "property", ""), path = attr_or(attrs, "path", null), format = attr_or(attrs, "format", null) }
    }

    export let content_item = (kind, id, content_html, style) => { item_kind = "content", kind = kind, id = id, rendered_html = content_html + "", style = style }

    export let split_item = (direction, splits) => { item_kind = "split_group", direction = direction, splits = splits }

    export let extract_layout_child = (project, child) => {
        let is_vsplit = wdoc::block_is(child, "vsplit")
        let is_hsplit = wdoc::block_is(child, "hsplit")
        let is_structural = wdoc::block_is(child, "split") || wdoc::block_is(child, "signal") || wdoc::block_is(child, "binding") || wdoc::block_is(child, "section") || wdoc::block_is(child, "page") || wdoc::block_is(child, "style")
        is_vsplit ? wdoc::split_item("vertical", map(wdoc::child_blocks_matching(child, "split"), split => wdoc::extract_split(project, split))) : (
            is_hsplit ? wdoc::split_item("horizontal", map(wdoc::child_blocks_matching(child, "split"), split => wdoc::extract_split(project, split))) : (
                is_structural ? null : wdoc::content_item(block_kind(child), block_id(child), wdoc::render_project_block(project, child), attr_or(block_attrs(child), "style", null))
            )
        )
    }

    export let extract_layout_children = (project, block) => filter_map(block_body_children(block), child => wdoc::extract_layout_child(project, child))

    export let extract_split = (project, block) => {
        let attrs = block_attrs(block)
        { size_percent = attr_or(attrs, "size", 0.0), children = wdoc::extract_layout_children(project, block) }
    }

    export let extract_layout = (project, block) => { children = wdoc::extract_layout_children(project, block) }

    export let page_section_id = value => type_of(value) == "block_ref" ? block_qualified_id(value) : value

    export let extract_page = (project, block) => {
        let attrs = block_attrs(block)
        let children = block_body_children(block)
        let layout_blocks = wdoc::child_blocks_matching(block, "layout")
        {
            id = attr_or(attrs, "id", ""),
            section_id = wdoc::page_section_id(attr_or(attrs, "section", "")),
            title = attr_or(attrs, "title", ""),
            template = attr_or(attrs, "template", null),
            path = attr_or(attrs, "path", null),
            date = attr_or(attrs, "date", null),
            draft = attr_or(attrs, "draft", false),
            weight = attr_or(attrs, "weight", null),
            summary = attr_or(attrs, "summary", null),
            tags = attr_or(attrs, "tags", []),
            categories = attr_or(attrs, "categories", []),
            params = attr_or(attrs, "params", {}),
            "layout" = len(layout_blocks) > 0 ? wdoc::extract_layout(project, layout_blocks[0]) : { children = [] },
            signals = map(filter(children, child => wdoc::block_is(child, "signal")), signal => wdoc::extract_signal(signal)),
            bindings = map(wdoc::binding_blocks_in(block), binding => wdoc::extract_binding(binding))
        }
    }

    export let extract_style_rule = block => {
        let attrs = block_attrs(block)
        { target = block_kind(block), properties = attrs }
    }

    export let extract_style = block => {
        let attrs = block_attrs(block)
        { name = attr_or(attrs, "id", "default"), rules = map(block_body_children(block), child => wdoc::extract_style_rule(child)) }
    }

    export let asset_from_src = (project, src) => { path = src, src = wdoc::source_path(project, src) }

    declare media_assets(project: map(string, any)) -> list(map(string, any))

    export let media_assets_in_block = (project, block) =>
        map(filter(block_collect_kinds(block, ["wdoc::image", "image", "wdoc::draw::image", "wdoc::draw::map", "wdoc::draw::sprite", "wdoc::draw::dopesheet", "wdoc::draw::dopesheet_view", "wdoc::draw::tilemap"]), child => map_has(block_attrs(child), "src")), child => wdoc::asset_from_src(project, block_attrs(child).src))

    export let scope_css = (scope, css) => {
        let trimmed = trim(to_string(css))
        scope == "" || trimmed == "" ? trimmed : ".wad-ds-" + scope + " " + trimmed
    }

    export let css_fragment_css = block => {
        let attrs = block_attrs(block)
        wdoc::scope_css(attr_or(attrs, "scope", ""), attr_or(attrs, "css", ""))
    }

    export let diagram_css_fragment = block => {
        let attrs = block_attrs(block)
        wdoc::scope_css(attr_or(attrs, "design_system", ""), attr_or(attrs, "css", ""))
    }

    export let project_css_fragments = project => {
        let explicit = map(wdoc::top_level_blocks_matching(project, "css_fragment"), block => wdoc::css_fragment_css(block))
        let diagrams = map(wdoc::project_blocks_collecting(project, ["diagram", "draw::diagram"]), block => wdoc::diagram_css_fragment(block))
        distinct(filter(concat(explicit, diagrams), css => css != ""))
    }

    export let global_css_value = block => attr_or(block_attrs(block), "css", "")

    export let project_global_css = project => distinct(filter(map(wdoc::top_level_blocks_matching(project, "global_css"), block => wdoc::global_css_value(block)), css => css != ""))

    export let font_asset_value = (project, block) => {
        let attrs = block_attrs(block)
        let src = attr_or(attrs, "src", "")
        {
            family = attr_or(attrs, "family", ""),
            src = src,
            path = src,
            weight = attr_or(attrs, "weight", null),
            style = attr_or(attrs, "style", null),
            display = attr_or(attrs, "display", null),
            source = wdoc::source_path(project, src)
        }
    }

    export let project_font_assets = project => distinct(filter(map(wdoc::top_level_blocks_matching(project, "font_asset"), block => wdoc::font_asset_value(project, block)), font => font.family != "" && font.src != ""))

    export let font_format = src =>
        ends_with(src, ".woff2") ? "woff2" :
        ends_with(src, ".woff") ? "woff" :
        ends_with(src, ".ttf") ? "truetype" :
        ends_with(src, ".otf") ? "opentype" :
        ""

    export let font_asset_css = font => {
        let fmt = wdoc::font_format(font.src)
        "@font-face {\n  font-family: \"" + font.family + "\";\n  src: url(\"" + font.src + "\")" + (fmt == "" ? "" : " format(\"" + fmt + "\")") + ";\n" +
        (font.weight == null ? "" : "  font-weight: " + font.weight + ";\n") +
        (font.style == null ? "" : "  font-style: " + font.style + ";\n") +
        (font.display == null ? "" : "  font-display: " + font.display + ";\n") +
        "}"
    }

    export let font_asset_files = fonts => map(fonts, font => { path = font.path, src = font.source })

    export let project_document = project => {
        let root = project.root
        let attrs = block_attrs(root)
        let project_with_icons = map_set(project, "_wdoc_icon_sets", wdoc::collect_icon_sets(project))
        let child_pages = wdoc::child_blocks_matching(root, "page")
        let top_pages = filter(wdoc::top_level_blocks_matching(project, "page"), page => !contains(map(child_pages, p => block_id(p)), block_id(page)))
        let site_headers = wdoc::child_blocks_matching(root, "site_header")
        let site_navs = wdoc::child_blocks_matching(root, "site_nav")
        let site_footers = wdoc::child_blocks_matching(root, "site_footer")
        let child_sections = wdoc::child_blocks_matching(root, "section")
        let child_styles = wdoc::child_blocks_matching(root, "style")
        let font_assets = wdoc::project_font_assets(project_with_icons)
        {
            name = attr_or(attrs, "id", ""),
            title = attr_or(attrs, "title", ""),
            template = attr_or(attrs, "template", "book"),
            version = attr_or(attrs, "version", null),
            author = attr_or(attrs, "author", null),
            site = {
                header_html = len(site_headers) > 0 ? wdoc::render_project_block(project_with_icons, site_headers[0]) : null,
                nav_html = len(site_navs) > 0 ? wdoc::render_project_block(project_with_icons, site_navs[0]) : null,
                footer_html = len(site_footers) > 0 ? wdoc::render_project_block(project_with_icons, site_footers[0]) : null
            },
            sections = map(child_sections, section => wdoc::extract_section(project_with_icons, section, attr_or(attrs, "id", ""))),
            pages = map(concat(top_pages, child_pages), page => wdoc::extract_page(project_with_icons, page)),
            styles = map(concat(wdoc::top_level_blocks_matching(project, "style"), child_styles), style => wdoc::extract_style(style)),
            assets = distinct(concat(wdoc::media_assets(project_with_icons), wdoc::font_asset_files(font_assets))),
            css_fragments = wdoc::project_css_fragments(project_with_icons),
            global_css = wdoc::project_global_css(project_with_icons),
            font_css = map(font_assets, font => wdoc::font_asset_css(font)),
            extra_css = ""
        }
    }

    export let render_site_files = doc => {
        let prepared_doc = wdoc::prepare_site_document(doc)
        let ctx = wdoc::render_context(prepared_doc)
        let html_files = map(wdoc::render_html_outputs(ctx), output => wdoc::html_output_file(output))
        let generated_css = codec_encode("css", wdoc::site_css(prepared_doc), {})
        let styles_content = byte_stream([file_stream("<WCL>:/assets/wdoc/base_styles.css"), utf8_to_bytes(generated_css)])
        concat([{ path = "styles.css", content = styles_content }], concat(html_files, concat(wdoc::local_asset_files(prepared_doc), wdoc::embedded_asset_files())))
    }

    export let render_project_site_files = (doc, options) => wdoc::render_site_files(map_has(doc, "root") ? wdoc::project_document(doc) : doc)

    export let style_target_leaf = target => {
        let parts = split("::", target)
        len(parts) == 0 ? target : parts[len(parts) - 1]
    }

    export let style_rule_selector = (style_name, target) => {
        let leaf = wdoc::style_target_leaf(target)
        style_name == "default" ? ".wdoc-" + leaf : ".wdoc-style-" + style_name + "--" + leaf
    }

    export let style_rule_asset = (style, rule) => {
        kind = "rule",
        selector = wdoc::style_rule_selector(style.name, rule.target),
        props = rule.properties
    }

    export let style_css = styles => {
        kind = "stylesheet",
        children = flat_map(styles, style => map(style.rules, rule => wdoc::style_rule_asset(style, rule)))
    }

    // ----------------------------------------------------------------------
    // Widget shape templates
    // ----------------------------------------------------------------------
    //
    // Each widget below is a function that takes a block (the WCL block the
    // user wrote in their diagram) and returns a list of "shape descriptors":
    // maps with a `kind` field plus positioning and visual attributes. The
    // wdoc renderer converts these descriptors into the widget's child shapes
    // before resolving layout and emitting SVG.
    //
    // Recognized descriptor fields:
    //   kind     — "rect" | "circle" | "ellipse" | "line" | "path" | "text" |
    //              "inline_svg" | "icon" | "image" | "map" | "group" | "connection"
    //   id       — shape ID for layout and connection endpoints
    //   x, y, width, height       — absolute placement (relative to widget)
    //   top, bottom, left, right  — anchored placement
    //   map children use the map's content_width/content_height coordinate space
    //   align, gap, padding       — layout for nested children
    //   layout_role               — "node" opts template children into parent layout
    //   z_index                   — sibling paint order, higher renders later
    //   rx, ry, r                 — corner / radius
    //   fill, stroke, stroke_width, stroke_dasharray, opacity
    //   class, style, cursor, pointer_events
    //   x1, y1, x2, y2 (line) | d (path)
    //   from, to, direction, label, curve, from_anchor, to_anchor (connection)
    //   content, font_size, anchor, font_family, font_weight, font_style,
    //   line_height, text_decoration, letter_spacing (text)
    //   children                  — list of more descriptors (nested)
    //
    // Use `attr_or(block, "key", default)` to read user attributes safely.

    // ----- UI widgets -----
}
