namespace wdoc {
    export let widget_avatar = (b) => {
        let w = attr_or(b, "width", 40)
        let initials = attr_or(b, "initials", "?")
        let color = attr_or(b, "color", "var(--color-link)")
        let bg_fill = attr_or(b, "background_fill", color)
        let label_fill = attr_or(b, "label_fill", "#fff")
        let r = w / 2
        [
            { kind = "circle", x = 0, y = 0, r = r, fill = bg_fill },
            { kind = "text", x = 0, y = 0, width = w, height = w,
              content = initials, font_size = r, fill = label_fill }
        ]
    }

}
