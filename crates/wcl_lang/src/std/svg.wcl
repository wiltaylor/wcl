// Standard SVG element schemas and WCL-authored svg codec output.

namespace svg {
    @open schema "svg" { }
    @open schema "g" { }
    @open schema "defs" { }
    @open schema "style" { content: string @optional }
    @open schema "title" { content: string @optional }
    @open schema "desc" { content: string @optional }

    @open schema "rect" { }
    @open schema "circle" { }
    @open schema "ellipse" { }
    @open schema "line" { }
    @open schema "polyline" { }
    @open schema "polygon" { }
    @open schema "path" { }
    @open schema "text" { content: string @optional }
    @open schema "tspan" { content: string @optional }
    @open schema "image" { href: string @optional }
    @open schema "use" { href: string @optional }
    @open schema "symbol" { }
    @open schema "marker" { }
    @open schema "clipPath" { }
    @open schema "mask" { }
    @open schema "pattern" { }
    @open schema "linearGradient" { }
    @open schema "radialGradient" { }
    @open schema "stop" { }
    @open schema "filter" { }

    // Element coverage from MDN browser-compat-data svg/elements.
    @open schema "a" { }
    @open schema "animate" { }
    @open schema "animateMotion" { }
    @open schema "animateTransform" { }
    @open schema "feBlend" { }
    @open schema "feColorMatrix" { }
    @open schema "feComponentTransfer" { }
    @open schema "feComposite" { }
    @open schema "feConvolveMatrix" { }
    @open schema "feDiffuseLighting" { }
    @open schema "feDisplacementMap" { }
    @open schema "feDistantLight" { }
    @open schema "feDropShadow" { }
    @open schema "feFlood" { }
    @open schema "feFuncA" { }
    @open schema "feFuncB" { }
    @open schema "feFuncG" { }
    @open schema "feFuncR" { }
    @open schema "feGaussianBlur" { }
    @open schema "feImage" { }
    @open schema "feMerge" { }
    @open schema "feMergeNode" { }
    @open schema "feMorphology" { }
    @open schema "feOffset" { }
    @open schema "fePointLight" { }
    @open schema "feSpecularLighting" { }
    @open schema "feSpotLight" { }
    @open schema "feTile" { }
    @open schema "feTurbulence" { }
    @open schema "foreignObject" { }
    @open schema "metadata" { }
    @open schema "mpath" { }
    @open schema "script" { content: string @optional }
    @open schema "set" { }
    @open schema "switch" { }
    @open schema "textPath" { content: string @optional }
    @open schema "view" { }

    @open schema "element" {
        tag: string
    }

    @open schema "raw" {
        content: string @text
    }

    export let __escape_text = value => {
        let text = to_string(value)
        replace(replace(replace(text, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
    }

    export let __escape_attr = value => {
        let text = to_string(value)
        let escaped = svg::__escape_text(text)
        let quoted = replace(escaped, "\"", "&quot;")
        let apos = replace(quoted, "'", "&apos;")
        replace(apos, "\n", "&#10;")
    }

    export let __plain_kind = kind =>
        starts_with(kind, "svg::") ? substr(kind, 5) :
        starts_with(kind, "wdoc::svg::") ? substr(kind, 11) :
        kind

    export let __kind = value =>
        type_of(value) == "block_ref" ? svg::__plain_kind(block_kind(value)) :
        type_of(value) == "map" ? (map_has(value, "tag") ? to_string(value.tag) : (map_has(value, "kind") ? svg::__plain_kind(to_string(value.kind)) : (map_has(value, "element") ? to_string(value.element) : ""))) :
        ""

    export let __attrs = value =>
        type_of(value) == "block_ref" ? block_attrs(value) :
        type_of(value) == "map" ? value :
        {}

    export let __children = value => {
        let attrs = svg::__attrs(value)
        let direct = type_of(value) == "block_ref" ? block_children(value) : []
        let mapped = map_has(attrs, "children") && type_of(attrs.children) == "list" ? attrs.children : []
        concat(direct, mapped)
    }

    export let __attr_name = name =>
        name == "class_name" ? "class" :
        replace(name, "_", "-")

    export let __style_value = value =>
        type_of(value) == "map" ? join("; ", map(keys(value), key => replace(key, "_", "-") + ": " + to_string(value[key]))) :
        to_string(value)

    export let __skip_attr = name =>
        contains(["tag", "kind", "element", "children", "content", "text", "raw"], name)

    export let __render_attr = (name, value) =>
        svg::__skip_attr(name) || type_of(value) == "null" || value == false ? "" : {
            let attr = svg::__attr_name(name)
            let rendered = attr == "style" ? svg::__style_value(value) : to_string(value)
            " " + attr + "=\"" + svg::__escape_attr(rendered) + "\""
        }

    export let __render_attrs = (tag, attrs) =>
        tag == "svg" && !map_has(attrs, "xmlns") ?
            " xmlns=\"http://www.w3.org/2000/svg\"" + join("", map(keys(attrs), key => svg::__render_attr(key, attrs[key]))) :
            join("", map(keys(attrs), key => svg::__render_attr(key, attrs[key])))

    export let __content = attrs =>
        map_has(attrs, "raw") ? to_string(attrs.raw) :
        map_has(attrs, "text") ? svg::__escape_text(attrs.text) :
        map_has(attrs, "content") ? svg::__escape_text(attrs.content) :
        ""

    export let render = value =>
        type_of(value) == "null" ? "" :
        type_of(value) == "string" ? value :
        type_of(value) == "list" ? join("", map(value, item => svg::render(item))) : {
            let tag = svg::__kind(value)
            let attrs = svg::__attrs(value)
            let children = svg::__children(value)
            tag == "raw" ? (map_has(attrs, "raw") ? to_string(attrs.raw) : (map_has(attrs, "content") ? to_string(attrs.content) : "")) :
            tag == "" ? "" :
            "<" + tag + svg::__render_attrs(tag, attrs) + ">" + svg::__content(attrs) + join("", map(children, item => svg::render(item))) + "</" + tag + ">"
        }
}

codec svg {
    mode = :text
    encoder = value => svg::render(value)
    encoder_all = values => join("", map(values, value => svg::render(value)))
}
