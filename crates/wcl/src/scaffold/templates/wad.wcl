// The `wad` built-in template: scaffold a WAD — Wil's Architecture Document,
// a typed data model of a software system (arc42-inspired views over a C4
// drill-down) rendered into a twelve-chapter book by wdoc. Ported from the
// reference WAD in this repository's .wad/; the schema and book templates
// are emitted verbatim (raw heredocs), the root document / README via
// ${answer(...)} substitution.
//
//   wcl init wad ./my-system
//
// The `schema/base.wcl` heredoc below (terminator WAD_SCHEMA_BASE_WCL) is
// the CANONICAL copy of the WAD base schema — `just wad-schema-sync`
// propagates it to .wad/schema/base.wcl and `just wad-schema-check` fails CI
// on drift. Edit the schema here, never in an instance.

import <scaffold.wcl>

property "system_id" {
  prompt  = "System id (an identifier, e.g. acme_shop)"
  default = "system"
}

property "system_name" {
  prompt  = "System name"
  default = "System"
}

property "system_summary" {
  prompt  = "One-line summary of the system"
  default = "An architecture document."
}

property "date" {
  prompt  = "Created (YYYY-MM-DD)"
  default = "1970-01-01"
}

property "include_extractors" {
  prompt  = "Ship example extractor scripts (Python / uv)? (yes/no)"
  default = "yes"
}

file ".gitignore" {
  content = <<'WAD__GITIGNORE'
# Rendered output — regenerate with `just book-build` / `just md-build`.
# data/**/generated/ is COMMITTED on purpose (the diff→spec workflow needs it).
/_site/
/_md/
WAD__GITIGNORE
}

file "README.md" {
  content = $<<WAD_README_MD
# ${answer("system_name")} — architecture document (WAD)

A **WAD**: one folder holding a typed data model of *${answer("system_name")}* —
systems, containers, relations, infrastructure, decisions, procedures, domain
objects, documentation, specs — rendered into a twelve-chapter architecture book by wdoc.
Humans review the book; scripts populate the data; AI coding agents work from
the WAD itself and the specs decomposed out of it.

## Layout

```
wad.wcl               # entry point: system metadata + schema/data imports
schema/base.wcl       # base block types (DO NOT hand-edit — scaffold-owned)
schema/kinds.wcl      # vocabularies (container kinds, relation kinds, …) — extend freely
schema/extensions.wcl # custom block types for this system
data/<view>/          # the content, one folder per view (overview, context, …)
data/generated/       # extractor-owned files — never hand-edit, always committed
scripts/              # extractor scripts (uv single-file Python)
wdoc/                 # the book projection templates (no content — pure structure)
_site/ _md/           # rendered output (gitignored)
```

## Build

```bash
just                  # list recipes
just wad-check        # validate the model
just book-serve       # live-preview the book (comment mode)
just book-build       # render _site/
just md-build         # render _md/ (AI-consumable Markdown)
```

## Populate

Author block instances under `data/<view>/` and add one import line in that
view's `main.wcl`. Every diagram derives from the data — the context diagram
from `relation` blocks, container diagrams from the same relations rolled up,
the ER diagram from `domain_object` fields. Start with systems + containers +
relations; the book renders "not recorded yet" stubs for everything else.

Extractors keep machine-derivable data honest: run `just extract` after the
source of truth changes (see `scripts/README.md`).

## Change specs

Once a version of this WAD has been reviewed, record its revision. To propose
changes: edit the data, then

```bash
wcl wad spec --from <reviewed-rev> wad.wcl
```

seeds a spec skeleton (the exact field-level delta) into `data/specs/`; an
LLM — with a human shaping the cut — decomposes the change into implementation
specs sized for the coding agent that will build it.
WAD_README_MD
}

file "justfile" {
  when    = answer("include_extractors") == "yes"
  content = <<'WAD_JUSTFILE'
# This WAD — build recipes. Self-contained: uses the `wcl` CLI directly.

[default, private]
main:
	@just --list

# Validate the WAD model and the book template
[group('check')]
wad-check:
	wcl check wad.wcl
	wcl check wdoc/book/main.wcl

# Render the book to _site/ (wiped first — removed pages would otherwise linger)
[group('render')]
book-build: wad-check
	rm -rf _site
	wcl wdoc build wdoc/book/main.wcl --out _site

# Serve the book with live reload; click a block to leave a review comment
[group('render')]
book-serve:
	wcl wdoc serve wdoc/book/main.wcl --comment

# Render the AI-consumable Markdown to _md/ (wiped first)
[group('render')]
md-build: wad-check
	rm -rf _md
	wcl wdoc markdown wdoc/book/main.wcl --out _md

# Run every extractor script, then re-validate
[group('data')]
extract:
	for s in scripts/extract_*.py; do echo "==> $s" >&2; uv run "$s"; done
	just wad-check

# Derive a change-spec skeleton from a reviewed revision
[group('data')]
spec-new REV:
	wcl wad spec --from {{REV}} wad.wcl

# Remove rendered output
[group('check')]
clean:
	rm -rf _site _md
WAD_JUSTFILE
}

file "justfile" {
  when    = answer("include_extractors") != "yes"
  content = <<'WAD_JUSTFILE_NOX'
# This WAD — build recipes. Self-contained: uses the `wcl` CLI directly.

[default, private]
main:
	@just --list

# Validate the WAD model and the book template
[group('check')]
wad-check:
	wcl check wad.wcl
	wcl check wdoc/book/main.wcl

# Render the book to _site/ (wiped first — removed pages would otherwise linger)
[group('render')]
book-build: wad-check
	rm -rf _site
	wcl wdoc build wdoc/book/main.wcl --out _site

# Serve the book with live reload; click a block to leave a review comment
[group('render')]
book-serve:
	wcl wdoc serve wdoc/book/main.wcl --comment

# Render the AI-consumable Markdown to _md/ (wiped first)
[group('render')]
md-build: wad-check
	rm -rf _md
	wcl wdoc markdown wdoc/book/main.wcl --out _md

# Derive a change-spec skeleton from a reviewed revision
[group('data')]
spec-new REV:
	wcl wad spec --from {{REV}} wad.wcl

# Remove rendered output
[group('check')]
clean:
	rm -rf _site _md
WAD_JUSTFILE_NOX
}

file "wad.wcl" {
  content = $<<WAD_WAD_WCL
// ${answer("system_name")} — architecture document (WAD) root.
//
//   wcl check wad.wcl                              # validate the model
//   wcl wdoc serve wdoc/book/main.wcl --comment    # review the book
//   wcl wdoc build wdoc/book/main.wcl --out _site  # render it
//   wcl wad spec --from <rev> wad.wcl              # derive a change spec

import <wdoc.wcl>
import "./schema/base.wcl"
import "./schema/extensions.wcl"
import "./data/main.wcl"

schema_version = "0.4.0"

wad ${answer("system_id")} {
  name    = "${answer("system_name")}"
  summary = "${answer("system_summary")}"
  created = "${answer("date")}"
}
WAD_WAD_WCL
}

file "schema/base.wcl" {
  content = <<'WAD_SCHEMA_BASE_WCL'
// WAD base schema — ships with the `wcl init wad` scaffold.
//
// Schema version: 0.4.0 (mirror it in `schema_version` in wad.wcl).
// 0.4.0 is additive over 0.3.0 (adr_option children on adr; typed
// context/instructions/acceptance on spec) — 0.3.0 data validates unchanged.
//
// DO NOT HAND-EDIT. The canonical copy lives in the scaffold template
// (crates/wcl/src/scaffold/templates/wad.wcl); regenerate with
// `just wad-schema-sync`. Everything system-specific belongs in
// `extensions.wcl`, and the vocabularies (kinds.wcl) ARE hand-editable.
//
// A WAD (Wil's Architecture Document) is a typed data model of a software
// system — arc42-inspired views over a C4 drill-down — that users and
// extractor scripts populate under data/, and the wdoc templates under
// wdoc/book/ render into a twelve-chapter book. The schema travels with
// the document: a WAD folder is fully interpretable (check + render)
// without any external tooling beyond `wcl`.
//
// Conventions:
//   - every top-level block carries `@inline(0) id: identifier`; ids become
//     page routes, so keep them to `A-Za-z0-9_-`
//   - diagram-node kinds (system / container / component / external_system /
//     persona / environment / infra_node / screen) share ONE id space — a
//     `relation` endpoint must resolve unambiguously
//   - cross-references are bare identifiers (`system = acme_shop`), never
//     nested blocks — scripts can emit them line by line
//   - freeform prose rides on records via `@child("body")` and is projected
//     by the templates; it is never required
namespace wcl.wad

import <wdoc.wcl>
import "./kinds.wcl"

// ---------------------------------------------------------------------------
// Root metadata (exactly one per WAD)
// ---------------------------------------------------------------------------

// The document's own metadata — which system this WAD describes and the
// version of that system it reflects. Templates bind `let wad = head(wads)`.
@block("wad")
type Wad {
  @inline(0) id: identifier
  @doc("Human name of the described system.")
  name: utf8
  @doc("One-line summary of the described system.")
  summary: utf8
  @doc("Longer prose introduction (heredoc).")
  description: utf8?
  @doc("Version of the DESCRIBED system this WAD reflects.")
  version: utf8?
  @default([]) tags: list<utf8>
  @doc("ISO date the WAD was created.")
  created: utf8
  @doc("ISO date of the last full update sweep.")
  updated: utf8?
  maintainer: utf8?
}

// ---------------------------------------------------------------------------
// View 1 — Overview: stakeholders, RACI, ADRs
// ---------------------------------------------------------------------------

// A named person or party with a stake in the system.
@block("stakeholder")
type Stakeholder {
  @inline(0) id: identifier
  name: utf8
  @doc("Their role relative to the system (sponsor, architect, operator…).")
  role: utf8
  org: utf8?
  contact: utf8?
  @doc("Optional persona id this stakeholder acts as.")
  persona: identifier?
}

// One RACI row: an activity and who is Responsible / Accountable /
// Consulted / Informed for it (stakeholder ids).
@block("raci_entry")
type RaciEntry {
  @inline(0) id: identifier
  @doc("The activity or concern this row governs.")
  activity: utf8
  @default([]) responsible: list<identifier>
  @default([]) accountable: list<identifier>
  @default([]) consulted:   list<identifier>
  @default([]) informed:    list<identifier>
}

// One alternative weighed while making a decision. An option without
// `rejected_because` is the one that won (the ADR's `decision` states it);
// record the losers with why they lost.
@block("adr_option")
type AdrOption {
  @inline(0) id: identifier
  title: utf8
  summary: utf8?
  @doc("Why this option lost, for the ones that did.")
  rejected_because: utf8?
}

// An architecture decision record. Short structured form in fields, the
// alternatives weighed as `adr_option` children; the body is for extras
// (diagrams, long-form context) the typed fields don't carry.
@block("adr")
type Adr {
  @inline(0) id: identifier
  @doc("ADR number — the book renders and cross-references it as ADR-<n> (zero-padded). Assign sequentially; never renumber.")
  n: u32
  title: utf8
  status: AdrStatus
  @doc("ISO date the decision was made (or last moved status).")
  date: utf8
  @default([]) deciders: list<utf8>
  @doc("What situation forced a decision.")
  context: utf8?
  @doc("What was decided.")
  decision: utf8?
  @doc("What follows from the decision — good and bad.")
  consequences: utf8?
  @doc("ADR id this decision supersedes (the inverse link is computed).")
  supersedes: identifier?
  @doc("The alternatives weighed, including the winner when naming it adds signal.")
  @children("adr_option") options: list<AdrOption>
  @default([]) related: list<identifier>
  @default([]) tags: list<utf8>
  @child("body") body: WdocAddressableBody?
}

// ---------------------------------------------------------------------------
// View 2 — System context: relations
// ---------------------------------------------------------------------------

// A directed relationship between two nodes (any ids from the shared node
// space: systems, containers, components, externals, personas). Author a
// relation at the LOWEST meaningful level — container↔container,
// container↔external, persona↔container; every diagram above that level
// derives its edges by rolling endpoints up, never by duplicate authoring.
@block("relation")
type Relation {
  @inline(0) id: identifier
  @doc("Origin node id.")
  source: identifier
  @doc("Target node id.")
  destination: identifier
  kind: RelationKind
  @doc("Edge text; defaults from the kind when omitted.")
  label: utf8?
  @doc("Wire protocol / mechanism (HTTPS, AMQP, spawn, …).")
  protocol: utf8?
  @doc("What data flows across this relation.")
  data: utf8?
  notes: utf8?
  @default([]) tags: list<utf8>
}

// ---------------------------------------------------------------------------
// View 3 — External systems
// ---------------------------------------------------------------------------

// Someone to call when the external system misbehaves.
@block("support_contact")
type SupportContact {
  @inline(0) id: identifier
  name: utf8
  role: utf8?
  @doc("How to reach them (email, portal, phone…).")
  channel: utf8
  details: utf8?
}

// A concrete connection detail: URL, IP, queue name, config knob.
@block("endpoint")
type Endpoint {
  @inline(0) id: identifier
  name: utf8
  @doc("Environment id this endpoint belongs to (omit when shared).")
  environment: identifier?
  @doc("What sort of detail this is: url / ip / config / queue / …")
  kind: utf8
  value: utf8
  notes: utf8?
}

// A pointer to API documentation or another integration reference.
@block("api_ref")
type ApiRef {
  @inline(0) id: identifier
  name: utf8
  @doc("What sort of reference: openapi / docs / repo / postman / …")
  kind: utf8
  @doc("Where it lives (URL or path).")
  location: utf8
  notes: utf8?
}

// A security-relevant fact about the integration.
@block("security_note")
type SecurityNote {
  @inline(0) id: identifier
  title: utf8
  detail: utf8
  severity: Criticality?
}

// A third-party system this design integrates with AS PART OF ITS FUNCTION —
// an API it calls, an identity provider, a payment gateway, a data feed.
// Platforms that host, build, or ship the system (clouds, CI services, CDNs,
// package registries the build pulls from) are NOT externals — model those
// as `infra_node`s in the infrastructure view.
@block("external_system")
type ExternalSystem {
  @inline(0) id: identifier
  name: utf8
  summary: utf8
  kind: ExternalKind
  vendor: utf8?
  url: utf8?
  criticality: Criticality?
  @default([]) tags: list<utf8>
  @children("support_contact") contacts:  list<SupportContact>
  @children("endpoint")        endpoints: list<Endpoint>
  @children("api_ref")         api_refs:  list<ApiRef>
  @children("security_note")   security:  list<SecurityNote>
  @child("body") body: WdocAddressableBody?
}

// ---------------------------------------------------------------------------
// View 4 — Systems: the C4 drill-down (system → container → component → code)
// ---------------------------------------------------------------------------

// A system: the top C4 level — something you'd draw as one box when
// explaining the estate to an outsider.
@block("system")
type System {
  @inline(0) id: identifier
  name: utf8
  summary: utf8
  @doc("Stakeholder id who owns this system.")
  owner: identifier?
  @default([]) repos: list<identifier>
  @default([]) tags: list<utf8>
  @child("body") body: WdocAddressableBody?
}

// A container: the independently deployable / runnable unit inside a system
// (C4 level 2). Block kinds are namespace-scoped, so `container` here lives
// in `wcl.wad` and never collides with wdoc's diagram-grouping `container`
// shape — data files carry `namespace wcl.wad`, so they author it bare.
@block("container")
type Container {
  @inline(0) id: identifier
  @doc("System id this container belongs to.")
  system: identifier
  name: utf8
  summary: utf8
  kind: ContainerKind
  @doc("Runtime / language / stack (\"Rust\", \"Postgres 16\", …).")
  technology: utf8?
  @doc("Repository id where this container's source lives.")
  repo: identifier?
  @default([]) tags: list<utf8>
  @child("body") body: WdocAddressableBody?
}

// A component: a cohesive part inside a container (C4 level 3).
@block("component")
type Component {
  @inline(0) id: identifier
  @doc("Container id this component belongs to.")
  container: identifier
  name: utf8
  summary: utf8
  @doc("Free-text component taxonomy (\"module\", \"handler\", \"store\"…).")
  kind: utf8?
  technology: utf8?
  @default([]) tags: list<utf8>
  @child("body") body: WdocAddressableBody?
}

// One positional argument of a `cli_command`.
@block("cli_arg")
type CliArg {
  @inline(0) id: identifier
  @doc("Placeholder as it appears in usage (\"<file>\", \"[template]\").")
  name: utf8
  description: utf8
  @default(true) required: bool
}

// One switch / option of a `cli_command`.
@block("cli_flag")
type CliFlag {
  @inline(0) id: identifier
  @doc("The flag as typed (\"--out\", \"-D\").")
  name: utf8
  @doc("Value placeholder when the flag takes one (\"<dir>\", \"<key=value>\").")
  value: utf8?
  description: utf8
  @doc("Default value, when one applies.")
  default: utf8?
  @default(false) repeatable: bool
}

// One worked example of a `cli_command` — a real invocation plus what it does.
@block("cli_example")
type CliExample {
  @inline(0) id: identifier
  @doc("The command line as typed.")
  command: utf8
  @doc("What this invocation does.")
  description: utf8?
}

// One CLI command or subcommand, documented like API docs: summary,
// positional args, switches, longer prose. This is HOW a WAD documents a
// command-line surface — never as prose paragraphs or a flat table.
// Attach each command to the component that implements it; the
// component's page renders the full listing.
@block("cli_command")
type CliCommand {
  @inline(0) id: identifier
  @doc("Full invocation (\"wcl parse\", \"wcl wdoc build\").")
  name: utf8
  summary: utf8
  @doc("Component id this command belongs to.")
  component: identifier?
  @doc("Longer behaviour prose (heredoc).")
  description: utf8?
  @default([]) aliases: list<utf8>
  @default([]) tags: list<utf8>
  @children("cli_arg")     args:     list<CliArg>
  @children("cli_flag")    flags:    list<CliFlag>
  @children("cli_example") examples: list<CliExample>
  @child("body") body: WdocAddressableBody?
}

// One member row of a `code_node` — a field, enum variant, method, or free
// function with its rendered signature. A member is an edge PORT: the
// renderer gives its node_row the member's id, so `deps` edges leave the
// exact row. `deps` may only name code_nodes of the SAME code_item — each
// code_item draws its own diagram, cross-item edges have nowhere to render.
@block("code_member")
type CodeMember {
  @inline(0) id: identifier
  @doc("Rendered signature line (\"fn parse(src: &str) -> Doc\", \"kind: TokenKind\").")
  signature: utf8
  @doc("What the member is: fn / method / field / variant / assoc_type / const / impl / overflow.")
  kind: utf8?
  @doc("Visibility when narrower than pub (\"crate\", \"super\").")
  visibility: utf8?
  @doc("Ids of code_nodes in the same code_item this signature references.")
  @default([]) deps: list<identifier>
}

// One node in a `code_item`'s module graph or class/API diagram.
@block("code_node")
type CodeNode {
  @inline(0) id: identifier
  name: utf8
  kind: utf8?
  summary: utf8?
  @doc("Ids of other code_nodes this one depends on (drawn as edges).")
  @default([]) deps: list<identifier>
  @doc("Member lines for class-diagram rendering (fields / methods).")
  @default([]) members: list<utf8>
  @doc("Typed member rows with row-level edge ports (:module_api rendering).")
  @children("code_member") rows: list<CodeMember>
}

// One column of a database table.
@block("db_column")
type DbColumn {
  @inline(0) name: identifier
  type: utf8
  @default(false) pk: bool
  @default(false) nullable: bool
  @doc("Foreign key: the table id this column references.")
  ref_table: identifier?
  @doc("Foreign key: the column name referenced in ref_table.")
  ref_column: identifier?
}

// One database table of a `code_item`'s db_schema payload.
@block("db_table")
type DbTable {
  @inline(0) id: identifier
  name: utf8?
  @children("db_column") columns: list<DbColumn>
}

// One parameter of an `api_endpoint` (path / query / header / cookie).
@block("api_param")
type ApiParam {
  @inline(0) id: identifier
  name: utf8
  @doc("Where the parameter rides (ApiParamLoc).")
  location: ApiParamLoc
  @doc("Value type, as legible text (\"string\", \"u32\", \"ISO date\"…).")
  type: utf8?
  @default(false) required: bool
  description: utf8?
  example: utf8?
}

// One response of an `api_endpoint`.
@block("api_response")
type ApiResponse {
  @inline(0) id: identifier
  @doc("HTTP status (\"200\", \"409\", \"2xx\").")
  status: utf8
  description: utf8
  @doc("Media type (\"application/json\", \"text/html\").")
  media_type: utf8?
  @doc("Body schema or example, as legible text (heredoc).")
  schema: utf8?
}

// One endpoint of a `code_item`'s api payload — OpenAPI-shaped on purpose:
// method/path/summary/description map to an OpenAPI operation, `params` to
// its parameters, `request`+`request_media_type` to the requestBody, and
// `responses` to per-status responses — so an OpenAPI spec imports via a
// mechanical extractor and a spec can be generated back out as a
// projection. The bare `request`/`response` text fields remain the simple
// form for surfaces that don't need per-status detail.
@block("api_endpoint")
type ApiEndpoint {
  @inline(0) id: identifier
  @doc("HTTP method or verb-equivalent (GET / POST / subscribe…).")
  method: utf8
  path: utf8
  summary: utf8
  @doc("Longer behaviour prose (heredoc).")
  description: utf8?
  @doc("Auth requirement (\"none\", \"bearer token\", …).")
  auth: utf8?
  @default([]) tags: list<utf8>
  @doc("Request body media type (\"application/json\").")
  request_media_type: utf8?
  @doc("Request body schema or example, as legible text.")
  request: utf8?
  @doc("Simple-form response text (use `responses` for per-status detail).")
  response: utf8?
  @children("api_param")    params:    list<ApiParam>
  @children("api_response") responses: list<ApiResponse>
}

// A code-level artefact (C4 level 4): a module graph, DB schema, class
// diagram, module API surface, or HTTP API surface. `kind` selects which
// payload family the renderer reads; the unused families stay empty. This
// is the level extractor scripts usually own.
@block("code_item")
type CodeItem {
  @inline(0) id: identifier
  @doc("Component id this code item details (set this or `container`).")
  component: identifier?
  @doc("Container id this code item details (set this or `component`).")
  container: identifier?
  name: utf8
  summary: utf8?
  kind: CodeItemKind
  @children("code_node")    nodes:     list<CodeNode>
  @children("db_table")     tables:    list<DbTable>
  @children("api_endpoint") endpoints: list<ApiEndpoint>
  @child("body") body: WdocAddressableBody?
}

// ---------------------------------------------------------------------------
// View 5 — Infrastructure
// ---------------------------------------------------------------------------

// A deployment environment (local, ci, staging, prod…).
@block("environment")
type Environment {
  @inline(0) id: identifier
  name: utf8
  summary: utf8?
  kind: EnvKind?
  @doc("Display / promotion sort order (lower first).")
  order: u32?
  @doc("Environment id changes promote to (drawn as the promotion chain).")
  promotes_to: identifier?
  url: utf8?
  @child("body") body: WdocAddressableBody?
}

// A piece of infrastructure. Nodes nest to arbitrary depth via `parent`
// (flat references, so scripts can append nodes without editing parents).
// A node listing more than one environment is shared infrastructure.
@block("infra_node")
type InfraNode {
  @inline(0) id: identifier
  name: utf8
  kind: InfraKind
  @doc("Parent infra_node id; omit for a top-level node.")
  parent: identifier?
  @doc("Environment ids this node serves; >1 marks shared infra.")
  @default([]) environments: list<identifier>
  technology: utf8?
  @doc("Address / locator (hostname, IP, ARN…).")
  address: utf8?
  notes: utf8?
  @child("body") body: WdocAddressableBody?
}

// Where a container runs: container × environment × infra node.
@block("deploy_target")
type DeployTarget {
  @inline(0) id: identifier
  @doc("Container id that is deployed.")
  container: identifier
  @doc("Environment id it runs in.")
  environment: identifier
  @doc("Infra node id it runs on.")
  infra_node: identifier
  replicas: u32?
  url: utf8?
  notes: utf8?
}

// ---------------------------------------------------------------------------
// View 6 — Build & deploy
// ---------------------------------------------------------------------------

// One notable path inside a repository. A path that is really another
// repository (a git submodule / vendored tree) says so: `repo` when it is
// one of ours (renders as a link to that repository's page), `external_url`
// when it is outside our control (renders marked external).
@block("repo_path")
type RepoPath {
  @inline(0) id: identifier
  path: utf8
  description: utf8
  @doc("Repository id when this path is one of OUR repos pulled in as a submodule/subtree.")
  repo: identifier?
  @doc("Upstream URL when this path is a submodule outside our control.")
  external_url: utf8?
}

// A source repository.
@block("repository")
type Repository {
  @inline(0) id: identifier
  name: utf8
  url: utf8
  summary: utf8?
  primary_language: utf8?
  @children("repo_path") structure: list<RepoPath>
  @child("body") body: WdocAddressableBody?
}

// One stage of a pipeline. `next` wires the stage DAG (branch-safe) that
// the pipeline flowchart draws.
@block("pipeline_stage")
type PipelineStage {
  @inline(0) id: identifier
  name: utf8?
  summary: utf8?
  @doc("Environment id this stage deploys to, when it deploys.")
  environment: identifier?
  @doc("Human gates / conditions on this stage (\"main branch only\"…).")
  @default([]) gates: list<utf8>
  @doc("Stage ids that run after this one.")
  @default([]) next: list<identifier>
}

// A CI/CD pipeline.
@block("pipeline")
type Pipeline {
  @inline(0) id: identifier
  name: utf8
  @doc("Repository id the pipeline belongs to.")
  repo: identifier?
  @doc("What starts it (push, tag, schedule, manual…).")
  trigger: utf8?
  summary: utf8?
  @children("pipeline_stage") stages: list<PipelineStage>
  @child("body") body: WdocAddressableBody?
}

// One released version of the system — what shipped and when. Ideal
// extractor territory: derive these from git tags or the hosting
// platform's releases API, never by hand.
@block("release")
type Release {
  @inline(0) id: identifier
  version: utf8
  @doc("ISO date the release was cut.")
  date: utf8?
  @doc("Repository id the release was cut from.")
  repo: identifier?
  summary: utf8?
  @doc("What went into the release (one line per change).")
  @default([]) highlights: list<utf8>
  url: utf8?
}

// ---------------------------------------------------------------------------
// View 8 — User personas
// ---------------------------------------------------------------------------

// How a persona gets access to a system.
@block("access_grant")
type AccessGrant {
  @inline(0) id: identifier
  @doc("System id the grant is for.")
  system: identifier
  @doc("How access is granted (SSO, signup, admin invite, install…).")
  method: utf8
  @doc("Who approves the grant, when someone does.")
  approver: utf8?
}

// A kind of USER of the system — human, AI agent, or service. Personas are
// who the system exists for; the people who build, maintain, or operate it
// are `stakeholder`s (view 1, with RACI rows), not personas.
@block("persona")
type Persona {
  @inline(0) id: identifier
  name: utf8
  summary: utf8
  kind: PersonaKind
  @default([]) goals: list<utf8>
  @children("access_grant") access: list<AccessGrant>
  @child("body") body: WdocAddressableBody?
}

// A typical way one persona uses the system, as a checkable flow. Record a
// good selection per persona — enough to exercise what that user kind does
// day to day (they make good user-acceptance tests). Steps and `from -> to`
// flow statements reuse the SOP machinery (view 9), so each use case
// renders as a flowchart above its step detail.
@block("use_case", required_children = ["step"])
type UseCase {
  @inline(0) id: identifier
  title: utf8
  @doc("Persona id this use case belongs to.")
  persona: identifier
  summary: utf8?
  @doc("What the user has / knows before starting.")
  @default([]) preconditions: list<utf8>
  @doc("The observable result when the use case succeeds.")
  outcome: utf8?
  @default([]) tags: list<utf8>
  @children("step") steps: list<Step>
  @connections(StepFlow) flow: list<StepFlow>
  @child("body") body: WdocAddressableBody?
}

// ---------------------------------------------------------------------------
// View 9 — System admin: SOPs / runbooks
// ---------------------------------------------------------------------------

// Flow-chart shape of a step.
symbol_set StepShape { process decision terminator }

// The label on a flow edge between two steps: `:default` is a plain arrow,
// `:yes` / `:no` annotate the branches out of a decision step.
symbol_set StepFlowKind { default yes no }

// One step in an SOP. The label is its `id` — the name the `from -> to`
// flow statements wire together. `n` is its display number.
@block("step")
type Step {
  @inline(0) id: identifier
  n: u32
  title: utf8?
  @default(:process) shape: StepShape
  @children("body") bodies: list<WdocAddressableBody>
}

// A directed flow edge between two steps, authored as `from -> to`
// (optionally `from -> to :yes` / `:no`) in the sop body.
connection StepFlow: Step -> Step : StepFlowKind

// A standard operating procedure / runbook: the reliable sequence for a
// task. Steps render as a flow chart above the step detail.
@block("sop", required_children = ["step"])
type Sop {
  @inline(0) id: identifier
  title: utf8
  purpose: utf8
  kind: SopKind
  @default([]) preconditions: list<utf8>
  @doc("How you know it worked.")
  verification: utf8?
  @doc("Where the automation lives, for automated runbooks (script, workflow…).")
  automation: utf8?
  @default([]) related: list<identifier>
  @default([]) tags: list<utf8>
  @children("step") steps: list<Step>
  @connections(StepFlow) flow: list<StepFlow>
}

// ---------------------------------------------------------------------------
// View 10 — Standards & rules
// ---------------------------------------------------------------------------

// One enforceable rule inside a standard.
@block("rule")
type Rule {
  @inline(0) id: identifier
  text: utf8
  rationale: utf8?
  @doc("What enforces it (CI, review, linter…), when something does.")
  enforced_by: utf8?
}

// A named standard the system is held to.
@block("standard")
type Standard {
  @inline(0) id: identifier
  title: utf8
  kind: StandardKind
  summary: utf8
  @children("rule") rules: list<Rule>
  @child("body") body: WdocAddressableBody?
}

// ---------------------------------------------------------------------------
// View 11 — Domain
// ---------------------------------------------------------------------------

// One field of a domain object.
@block("field")
type DomainField {
  @inline(0) name: identifier
  type: utf8
  @default(false) required: bool
  summary: utf8?
}

// A relationship from one domain object to another. `via_field` attaches
// the ER edge to a specific field row instead of the whole object.
@block("domain_rel")
type DomainRel {
  @inline(0) id: identifier
  @doc("Target domain_object id.")
  to: identifier
  kind: DomainRelKind
  label: utf8?
  @doc("Field name on THIS object the edge leaves from (row-level port).")
  via_field: identifier?
}

// A domain object: a concept the system's data model is built around.
@block("domain_object")
type DomainObject {
  @inline(0) id: identifier
  name: utf8
  summary: utf8
  @children("field") fields: list<DomainField>
  @children("domain_rel") relations: list<DomainRel>
  @child("body") body: WdocAddressableBody?
}

// A glossary entry (ubiquitous-language term).
@block("term")
type Term {
  @inline(0) id: identifier
  term: utf8
  definition: utf8
  @default([]) aliases: list<utf8>
}

// ---------------------------------------------------------------------------
// View 12 — Specs
// ---------------------------------------------------------------------------

// One field-level change inside a spec `change` block. `old` / `new` carry
// the rendered WCL of the values (any type renders legibly as text).
@block("field_change")
type FieldChange {
  @inline(0) path: utf8
  @doc("What happened: changed / added / removed / …")
  kind: utf8
  old: utf8?
  new: utf8?
}

// One entity-level change a spec covers. The inline label is the diff's
// entity key (`kind:label`); `value` carries the rendered WCL of an added
// or removed entity. Emitted mechanically by `wcl wad spec`.
@block("change")
type SpecChange {
  @inline(0) entity: utf8
  @doc(":added / :removed / :modified")
  op: symbol
  @doc("Rendered WCL of the added/removed entity.")
  value: utf8?
  @children("field_change") fields: list<FieldChange>
}

// A work package for an implementing agent: the detail needed to build
// part of the system, carried through the status lifecycle. Optionally
// seeded mechanically from a WAD diff (`wcl wad spec` pins the baseline
// sha and the exact change list); the intent — the typed `context`,
// `instructions`, and `acceptance` fields — is authored by the LLM/human
// decomposing the change. The body is for extras (diagrams, long-form
// rationale) the typed fields don't carry.
@block("spec")
type Spec {
  @inline(0) id: identifier
  title: utf8
  status: SpecStatus
  @doc("ISO date the spec was created.")
  created: utf8
  updated: utf8?
  owner: utf8?
  summary: utf8
  @doc("The situation the work starts from — why this change set exists.")
  context: utf8?
  @doc("Ordered implementation steps — name the files/modules to touch.")
  @default([]) instructions: list<utf8>
  @doc("Checkable criteria that prove the work is done (commands, tests, rendered output).")
  @default([]) acceptance: list<utf8>
  @doc("Git revision (full sha) of the WAD baseline this spec diffs from.")
  from_rev: utf8?
  @doc("System / container ids this spec touches.")
  @default([]) affected: list<identifier>
  @doc("Spec id this one supersedes.")
  supersedes: identifier?
  @default([]) tags: list<utf8>
  @children("change") changes: list<SpecChange>
  @child("body") body: WdocAddressableBody?
}

// ---------------------------------------------------------------------------
// View 7 — Documentation
// ---------------------------------------------------------------------------

// A documentation artefact the project ships: a hosted site, a book, an
// agent skill folder, a reference, a README. Documentation is an OUTPUT of
// the system, not a system — model where it lives and who it serves here,
// never as a `system`/`container` in view 4.
@block("doc_item")
type DocItem {
  @inline(0) id: identifier
  name: utf8
  summary: utf8
  kind: DocKind
  @doc("Where the source is authored (repo path, \"docs/main.wcl\"…).")
  source: utf8?
  @doc("Where readers find it (URL or install location).")
  url: utf8?
  @doc("Container id that builds / renders this artefact, when one does.")
  built_by: identifier?
  @doc("Where the published artefact is hosted (\"Cloudflare Pages\"…).")
  hosted_on: utf8?
  @doc("Persona ids this documentation serves.")
  @default([]) audience: list<identifier>
  @default([]) tags: list<utf8>
  @child("body") body: WdocAddressableBody?
}

// ---------------------------------------------------------------------------
// Screens (rendered inside View 4 under their owning component / container)
// ---------------------------------------------------------------------------

// A screen / UI surface of the system. The body holds its wireframe
// (`diagram { wf_browser { … } }`) or terminal mock-up. Screens attach at
// component level (`component`); `container` is the coarser fallback when
// the WAD doesn't model components.
@block("screen")
type Screen {
  @inline(0) id: identifier
  name: utf8
  summary: utf8?
  @doc("Component id that serves this screen (preferred).")
  component: identifier?
  @doc("Container id that serves this screen (fallback when components aren't modelled).")
  container: identifier?
  @doc("Route / location inside the container (URL path, menu path…).")
  route: utf8?
  @doc("Persona ids that use this screen.")
  @default([]) personas: list<identifier>
  @doc("Screen ids this one navigates to (drawn as the screen-flow).")
  @default([]) nav_to: list<identifier>
  @child("body") body: WdocAddressableBody?
}

// ---------------------------------------------------------------------------
// Articles — freeform sub-pages for any view
// ---------------------------------------------------------------------------

// A freeform prose page filed under one of the eleven views — the escape
// hatch for topics the typed blocks don't cover.
@block("article")
type Article {
  @inline(0) id: identifier
  title: utf8
  @doc("Which view's chapter the article appears under.")
  section: WadSection
  summary: utf8?
  @doc("Sort order within the section (lower first).")
  order: u32?
  @default([]) related: list<identifier>
  @child("body") body: WdocAddressableBody?
}

// ---------------------------------------------------------------------------
// Root document — gathers every block instance for the projections
// ---------------------------------------------------------------------------

// NOTE: gather-field names share the merged document schema with wdoc's own
// @document, so they must not reuse its field names (pages, templates,
// components, sites, bodies, …). That is why component instances gather as
// `sw_components` — bare `components` is wdoc's wdoc_component list, and the
// collision breaks template iteration.
@document
type WadDoc {
  schema_version: utf8
  @children("wad")             wads:            list<Wad>
  @children("stakeholder")     stakeholders:    list<Stakeholder>
  @children("raci_entry")      raci:            list<RaciEntry>
  @children("adr")             adrs:            list<Adr>
  @children("relation")        relations:       list<Relation>
  @children("external_system") externals:       list<ExternalSystem>
  @children("system")          systems:         list<System>
  @children("container")       containers:      list<Container>
  @children("component")       sw_components:   list<Component>
  @children("cli_command")     cli_commands:    list<CliCommand>
  @children("code_item")       code_items:      list<CodeItem>
  @children("environment")     environments:    list<Environment>
  @children("infra_node")      infra_nodes:     list<InfraNode>
  @children("deploy_target")   deploy_targets:  list<DeployTarget>
  @children("repository")      repositories:    list<Repository>
  @children("pipeline")        pipelines:       list<Pipeline>
  @children("release")         releases:        list<Release>
  @children("persona")         personas:        list<Persona>
  @children("use_case")        use_cases:       list<UseCase>
  @children("sop")             sops:            list<Sop>
  @children("standard")        standards:       list<Standard>
  @children("domain_object")   domain_objects:  list<DomainObject>
  @children("term")            terms:           list<Term>
  @children("spec")            specs:           list<Spec>
  @children("doc_item")        doc_items:       list<DocItem>
  @children("screen")          screens:         list<Screen>
  @children("article")         articles:        list<Article>
}
WAD_SCHEMA_BASE_WCL
}

file "schema/kinds.wcl" {
  content = <<'WAD_SCHEMA_KINDS_WCL'
// WAD vocabularies — the hand-editable half of the schema.
//
// These symbol_sets are the closed vocabularies the base schema's kind fields
// draw from. Extend them freely for your system (add members; avoid renaming
// existing ones — data files reference them by symbol). Structural types stay
// in base.wcl (DO NOT HAND-EDIT); everything here is yours.
namespace wcl.wad

// What a C4 container (a `container` block) fundamentally is.
symbol_set ContainerKind {
  service web_app spa cli library db queue cache batch_job function
  mobile_app desktop_app editor_plugin gateway static_site other
}

// What an external system is to this design.
symbol_set ExternalKind {
  saas api registry identity datastore ci cdn payment partner ai_service other
}

// How two nodes relate — drives edge labels in the generated diagrams.
symbol_set RelationKind {
  sync_api async_msg reads writes reads_writes publishes subscribes
  uses depends_on authenticates triggers hosts other
}

// What an infrastructure node is.
symbol_set InfraKind {
  cloud region network vpc cluster namespace vm container_runtime
  physical_host paas_service ci_runner registry workstation storage edge other
}

// What an environment is for.
symbol_set EnvKind { local ci dev test staging prod dr other }

// ADR lifecycle.
symbol_set AdrStatus { proposed accepted rejected superseded deprecated }

// Spec lifecycle: planning → in_progress (↔ blocked) → complete | abandoned.
symbol_set SpecStatus { planning in_progress blocked complete abandoned }

// Who (or what) a persona is.
symbol_set PersonaKind { human ai_agent service }

// What kind of operating procedure an `sop` is.
symbol_set SopKind { operations incident change runbook release dev }

// What a standard governs.
symbol_set StandardKind { coding style business security process documentation }

// How one domain object relates to another.
symbol_set DomainRelKind { has_one has_many references extends uses }

// Which payload family a `code_item` carries (selects the renderer).
symbol_set CodeItemKind { module_graph db_schema class_diagram module_api api other }

// Where an `api_param` rides (mirrors OpenAPI's parameter `in`).
symbol_set ApiParamLoc { path query header cookie }

// Severity / criticality scale (externals, security notes).
symbol_set Criticality { low medium high critical }

// What a `doc_item` (view 12) fundamentally is.
symbol_set DocKind { site book skill reference readme guide changelog other }

// The twelve views — an `article` files itself under one of these.
symbol_set WadSection {
  overview context externals systems infrastructure build_deploy
  documentation personas sysadmin standards domain specs
}

// NOTE: there is deliberately no RaciRole vocabulary — a `raci_entry` row
// carries four stakeholder-id lists (responsible / accountable / consulted /
// informed), which renders the matrix directly.
WAD_SCHEMA_KINDS_WCL
}

file "schema/extensions.wcl" {
  content = <<'WAD_SCHEMA_EXTENSIONS_WCL'
// WAD custom block types — per-system schema extensions.
//
// Custom blocks declared here join the `wcl.wad` namespace (shared with the
// base schema). The namespace line below is the file's first statement;
// uncomment your @block/@document beneath it and they are scoped
// automatically — bare references from data files and templates keep
// resolving.
namespace wcl.wad

// The base schema (base.wcl) is never edited in place; everything
// system-specific goes here. Two ways to add custom content:
//
//   1. An `article` block (defined in base.wcl) needs NOTHING here — file a
//      freeform prose page under any view with `section = :domain` (etc.).
//
//   2. A first-class typed custom block: declare an @block with your own
//      fields AND a @document that gathers it. Imported @document schemas
//      MERGE with the base, so this composes cleanly. Then add a render
//      snippet to the book template (wdoc/book/main.wcl or a component).
//
// Example (uncomment and adapt):
//
// @block("slo")
// type Slo {
//   @inline(0) id: identifier
//   metric:  utf8
//   target:  utf8
//   window:  utf8?
// }
//
// @document
// type Extensions {
//   @children("slo") slos: list<Slo>
// }
//
// Then in the book template, alongside the other sections:
//
//   wdoc_repeater { each = slos  as = :s
//     p $"`${s.metric}` — ${s.target}"
//   }
WAD_SCHEMA_EXTENSIONS_WCL
}

file "data/main.wcl" {
  content = <<'WAD_DATA_MAIN_WCL'
// Data hub — imports every view's data. One folder per view; each view's
// main.wcl imports its sibling files, so adding a data file means adding
// one import line in its view hub (or here, for generated/ output).
namespace wcl.wad

import "./overview/main.wcl"
import "./context/main.wcl"
import "./externals/main.wcl"
import "./systems/main.wcl"
import "./infrastructure/main.wcl"
import "./build/main.wcl"
import "./personas/main.wcl"
import "./sysadmin/main.wcl"
import "./standards/main.wcl"
import "./documentation/main.wcl"
import "./domain/main.wcl"
import "./specs/main.wcl"
import "./screens/main.wcl"
import "./generated/main.wcl"
WAD_DATA_MAIN_WCL
}

file "data/overview/main.wcl" {
  content = <<'WAD_DATA_OVERVIEW_MAIN_WCL'
// View data hub — stakeholders, RACI rows, and ADRs.
// Import one file per entry (or small group) below.
namespace wcl.wad
WAD_DATA_OVERVIEW_MAIN_WCL
}

file "data/context/main.wcl" {
  content = <<'WAD_DATA_CONTEXT_MAIN_WCL'
// View data hub — relations — the directed edges every context/container diagram derives from.
// Import one file per entry (or small group) below.
namespace wcl.wad
WAD_DATA_CONTEXT_MAIN_WCL
}

file "data/externals/main.wcl" {
  content = <<'WAD_DATA_EXTERNALS_MAIN_WCL'
// View data hub — external systems: contacts, endpoints, API refs, security notes.
// Import one file per entry (or small group) below.
namespace wcl.wad
WAD_DATA_EXTERNALS_MAIN_WCL
}

file "data/systems/main.wcl" {
  content = <<'WAD_DATA_SYSTEMS_MAIN_WCL'
// View data hub — the C4 drill-down: systems, containers, components (gathered as `sw_components`). Code items are extractor-owned — see data/generated/.
// Import one file per entry (or small group) below.
namespace wcl.wad
WAD_DATA_SYSTEMS_MAIN_WCL
}

file "data/infrastructure/main.wcl" {
  content = <<'WAD_DATA_INFRASTRUCTURE_MAIN_WCL'
// View data hub — environments, infra_nodes, deploy_targets.
// Import one file per entry (or small group) below.
namespace wcl.wad
WAD_DATA_INFRASTRUCTURE_MAIN_WCL
}

file "data/build/main.wcl" {
  content = <<'WAD_DATA_BUILD_MAIN_WCL'
// View data hub — repositories and pipelines (hand-authored ones).
// Import one file per entry (or small group) below.
namespace wcl.wad
WAD_DATA_BUILD_MAIN_WCL
}

file "data/personas/main.wcl" {
  content = <<'WAD_DATA_PERSONAS_MAIN_WCL'
// View data hub — user personas and their access grants.
// Import one file per entry (or small group) below.
namespace wcl.wad
WAD_DATA_PERSONAS_MAIN_WCL
}

file "data/sysadmin/main.wcl" {
  content = <<'WAD_DATA_SYSADMIN_MAIN_WCL'
// View data hub — SOPs / runbooks.
// Import one file per entry (or small group) below.
namespace wcl.wad
WAD_DATA_SYSADMIN_MAIN_WCL
}

file "data/standards/main.wcl" {
  content = <<'WAD_DATA_STANDARDS_MAIN_WCL'
// View data hub — standards and their rules.
// Import one file per entry (or small group) below.
namespace wcl.wad
WAD_DATA_STANDARDS_MAIN_WCL
}

file "data/domain/main.wcl" {
  content = <<'WAD_DATA_DOMAIN_MAIN_WCL'
// View data hub — domain objects and glossary terms.
// Import one file per entry (or small group) below.
namespace wcl.wad
WAD_DATA_DOMAIN_MAIN_WCL
}

file "data/specs/main.wcl" {
  content = <<'WAD_DATA_SPECS_MAIN_WCL'
// View data hub — specs — change contracts with status; wcl wad spec writes new files here.
// Import one file per entry (or small group) below.
namespace wcl.wad
WAD_DATA_SPECS_MAIN_WCL
}

file "data/documentation/main.wcl" {
  content = <<'WAD_DATA_DOCUMENTATION_MAIN_WCL'
// View data hub — doc_items: the documentation artefacts the project ships.
// Import one file per entry (or small group) below.
namespace wcl.wad
WAD_DATA_DOCUMENTATION_MAIN_WCL
}

file "data/screens/main.wcl" {
  content = <<'WAD_DATA_SCREENS_MAIN_WCL'
// View data hub — screens: wireframes / terminal mock-ups, owned by components.
// Import one file per entry (or small group) below.
namespace wcl.wad
WAD_DATA_SCREENS_MAIN_WCL
}

file "data/generated/main.wcl" {
  when    = answer("include_extractors") == "yes"
  content = <<'WAD_DATA_GENERATED_MAIN_WCL'
// SCRIPT-OWNED zone — extractor scripts overwrite files here wholesale.
// Never hand-edit anything under generated/; fix the extractor and re-run
// (`just extract`). Hand-authored data may REFERENCE generated ids, but
// never lives here. Commit these files: `wcl diff` against an old git
// revision materialises that revision's tree, so uncommitted generated
// data would silently vanish from the old side of every diff.
namespace wcl.wad

import "./repo.wcl"     // owned by scripts/extract_repo.py
import "./releases.wcl" // owned by scripts/extract_releases.py
WAD_DATA_GENERATED_MAIN_WCL
}

file "data/generated/main.wcl" {
  when    = answer("include_extractors") != "yes"
  content = <<'WAD_DATA_GENERATED_MAIN_WCL_NOX'
// SCRIPT-OWNED zone — extractor scripts overwrite files here wholesale.
// Never hand-edit anything under generated/; fix the extractor and re-run
// (`just extract`). Hand-authored data may REFERENCE generated ids, but
// never lives here. Commit these files: `wcl diff` against an old git
// revision materialises that revision's tree, so uncommitted generated
// data would silently vanish from the old side of every diff.
namespace wcl.wad
WAD_DATA_GENERATED_MAIN_WCL_NOX
}

file "data/generated/repo.wcl" {
  when    = answer("include_extractors") == "yes"
  content = <<'WAD_DATA_GENERATED_REPO_WCL'
// GENERATED by scripts/extract_repo.py — do not hand-edit; re-run `just extract`.
// (placeholder: the extractor has not run yet)
namespace wcl.wad
WAD_DATA_GENERATED_REPO_WCL
}

file "data/generated/releases.wcl" {
  when    = answer("include_extractors") == "yes"
  content = <<'WAD_DATA_GENERATED_RELEASES_WCL'
// GENERATED by scripts/extract_releases.py — do not hand-edit; re-run `just extract`.
// (placeholder: the extractor has not run yet)
namespace wcl.wad
WAD_DATA_GENERATED_RELEASES_WCL
}

file "scripts/extract_releases.py" {
  when    = answer("include_extractors") == "yes"
  content = <<'WAD_SCRIPTS_EXTRACT_RELEASES_PY'
#!/usr/bin/env -S uv run
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Extract released versions from git tags into data/generated/releases.wcl:
one `release` block per `v*` tag, dated from the tag, with the commit
subjects between it and the previous tag as highlights. Release URLs are
derived from the `origin` remote when it points at a known forge."""

import re
import subprocess
import sys
from pathlib import Path

WAD_ROOT = Path(__file__).resolve().parents[1]
REPO_ROOT = WAD_ROOT.parent
OUT = WAD_ROOT / "data" / "generated" / "releases.wcl"

MAX_RELEASES = 20
MAX_HIGHLIGHTS = 8


def wcl_str(s: str) -> str:
    out = s.replace("\\", "\\\\").replace('"', '\\"')
    out = out.replace("\n", "\\n").replace("\t", "\\t").replace("\r", "\\r")
    return f'"{out}"'


def slug(s: str) -> str:
    return re.sub(r"[^A-Za-z0-9_]", "_", s)


def git(*args: str) -> str:
    return subprocess.run(
        ["git", *args], cwd=REPO_ROOT, check=True, capture_output=True, text=True
    ).stdout


def releases_url_base() -> str | None:
    """https://<forge>/<owner>/<repo>/releases/tag for GitHub-shaped remotes."""
    try:
        remote = git("remote", "get-url", "origin").strip()
    except subprocess.CalledProcessError:
        return None
    m = re.match(r"(?:https://|git@)([^:/]+)[:/](.+?)(?:\.git)?$", remote)
    if not m or m.group(1) not in ("github.com", "gitlab.com"):
        return None
    return f"https://{m.group(1)}/{m.group(2)}/releases/tag"


def main() -> int:
    lines = [
        "// GENERATED by scripts/extract_releases.py — do not hand-edit; re-run `just extract`.",
        "// Source: git tags (v*) and the commit subjects between them",
        "namespace wcl.wad",
        "",
    ]
    # Outside a git repository (or with git missing) there is nothing to
    # extract — write the placeholder and succeed, like extract_repo.py.
    try:
        raw_tags = git(
            "tag", "--list", "v*", "--sort=creatordate", "--format=%(refname:strip=2)\t%(creatordate:short)"
        )
    except (subprocess.CalledProcessError, FileNotFoundError):
        print("not inside a git repository — writing the empty placeholder", file=sys.stderr)
        OUT.write_text(
            "// GENERATED by scripts/extract_releases.py — do not hand-edit; re-run `just extract`.\n"
            "// Source: git tags (no repository found)\n"
            "namespace wcl.wad\n"
        )
        return 0
    url_base = releases_url_base()
    tags = [t for t in raw_tags.splitlines() if t.strip()]
    parsed = [tuple(t.split("\t", 1)) for t in tags]
    blocks: list[str] = []
    prev: str | None = None
    for tag, date in parsed:
        span = f"{prev}..{tag}" if prev else tag
        subjects = [
            s for s in git("log", "--format=%s", span).splitlines() if s.strip()
        ]
        subjects.reverse()  # oldest change first reads as a changelog
        shown = subjects[:MAX_HIGHLIGHTS]
        if len(subjects) > MAX_HIGHLIGHTS:
            shown.append(f"… and {len(subjects) - MAX_HIGHLIGHTS} more changes")
        body = [
            f"release rel_{slug(tag)} {{",
            f"  version = {wcl_str(tag)}",
            f"  date    = {wcl_str(date)}",
            f"  summary = {wcl_str(f'{len(subjects)} changes since {prev}' if prev else f'{len(subjects)} changes (first tagged release)')}",
            "  highlights = [",
            *[f"    {wcl_str(s)}," for s in shown],
            "  ]",
        ]
        if url_base:
            body.append(f"  url     = {wcl_str(f'{url_base}/{tag}')}")
        body += ["}", ""]
        blocks.append("\n".join(body))
        prev = tag
    # Newest first, capped — the table leads with the current release.
    for b in reversed(blocks[-MAX_RELEASES:]):
        lines.append(b)
    OUT.write_text("\n".join(lines))
    print(f"wrote {OUT.relative_to(WAD_ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
WAD_SCRIPTS_EXTRACT_RELEASES_PY
}

file "wdoc/book/main.wcl" {
  content = <<'WAD_WDOC_BOOK_MAIN_WCL'
// Book projection — the twelve-chapter architecture book over the WAD data
// model. This template contains NO architecture content — only projections
// over the blocks gathered by the root @document (systems, relations, ADRs…).
//
//   wcl wdoc serve .wad/wdoc/book/main.wcl --comment   # review it
//   wcl wdoc build .wad/wdoc/book/main.wcl --out .wad/_site
//
// Structure: this file holds the site + toc + the shared `let` helper layer
// (node index, name/link resolution, edge roll-up). Each view's landing page
// and its generated per-entity pages live in one file under pages/ — those
// files resolve the `let`s defined here, so they are only valid as part of
// this document.

import <wdoc.wcl>
import "../../wad.wcl"

import "../pages/overview.wcl"        // index, adrs_page, adr_* pages
import "../pages/context.wcl"         // system_context
import "../pages/externals.wcl"       // externals_page, external_*
import "../pages/systems.wcl"         // systems_page, system_*, container_*, component_*, code_*, screen_*
import "../pages/infrastructure.wcl"  // infrastructure_page, env_*
import "../pages/build.wcl"           // build_page, repo_*, pipeline_*
import "../pages/documentation.wcl"   // documentation_page, doc_*
import "../pages/personas.wcl"        // personas_page, persona_*
import "../pages/sysadmin.wcl"        // sysadmin_page, sop_*
import "../pages/standards.wcl"       // standards_page, standard_*
import "../pages/domain.wcl"          // domain_page, domain_*, glossary_page
import "../pages/specs.wcl"           // specs_page, spec_*
import "../pages/articles.wcl"        // article_* pages

// --- the document's one wad block ---------------------------------------
let wad = head(wads)

// --- node index: every diagram-node id → name + page route ---------------
// Systems, containers, components, externals, personas, environments and
// screens share one id space (relation endpoints resolve against it).
type NodeRef { id: identifier  name: utf8  href: utf8  level: utf8 }
let all_nodes = flatten([
  map(systems,      fn(s: System)         -> NodeRef { { id: s.id, name: s.name, href: $"system_${s.id}",    level: "system" } }),
  map(containers,   fn(c: Container)      -> NodeRef { { id: c.id, name: c.name, href: $"container_${c.id}", level: "container" } }),
  map(sw_components,   fn(c: Component)      -> NodeRef { { id: c.id, name: c.name, href: $"component_${c.id}", level: "component" } }),
  map(externals,    fn(e: ExternalSystem) -> NodeRef { { id: e.id, name: e.name, href: $"external_${e.id}",  level: "external" } }),
  map(personas,     fn(pe: Persona)       -> NodeRef { { id: pe.id, name: pe.name, href: $"persona_${pe.id}", level: "persona" } }),
  map(environments, fn(e: Environment)    -> NodeRef { { id: e.id, name: e.name, href: $"env_${e.id}",       level: "environment" } }),
  map(screens,      fn(sc: Screen)        -> NodeRef { { id: sc.id, name: sc.name, href: $"screen_${sc.id}", level: "screen" } }),
  map(infra_nodes,  fn(n: InfraNode)      -> NodeRef { { id: n.id, name: n.name, href: "",                   level: "infra" } }),
  map(repositories, fn(r: Repository)     -> NodeRef { { id: r.id, name: r.name, href: $"repo_${r.id}",      level: "repository" } }),
  map(doc_items,    fn(d: DocItem)        -> NodeRef { { id: d.id, name: d.name, href: $"doc_${d.id}",       level: "documentation" } }),
])
let node_of = fn(nid: identifier) -> NodeRef {
  find(all_nodes, fn(n: NodeRef) -> bool { n.id == nid }) ?? { id: nid, name: $"${nid}", href: "", level: "unknown" }
}
let name_of = fn(nid: identifier) -> utf8 { let n = node_of(nid); n.name }
// Markdown link to a node's page, or its bare name when it has none.
let link_of = fn(nid: identifier) -> utf8 {
  let n = node_of(nid);
  match n.href { "" => n.name, _ => $"[${n.name}](${n.href})" }
}

// --- ownership roll-up ----------------------------------------------------
// Lift any node id to its owning container / system. Ids that aren't a
// component/container (externals, personas, systems themselves) pass through.
let owner_container = fn(nid: identifier) -> identifier {
  let c = find(sw_components, fn(x: Component) -> bool { x.id == nid });
  match c { none => nid, _ => c.container }
}
let owner_system = fn(nid: identifier) -> identifier {
  let cid = owner_container(nid);
  let c = find(containers, fn(x: Container) -> bool { x.id == cid });
  match c { none => cid, _ => c.system }
}

// --- relation → edge derivation -------------------------------------------
let kind_text = fn(k: RelationKind) -> utf8 {
  match k {
    :sync_api => "calls", :async_msg => "messages", :reads => "reads",
    :writes => "writes", :reads_writes => "reads/writes",
    :publishes => "publishes", :subscribes => "subscribes", :uses => "uses",
    :depends_on => "depends on", :authenticates => "authenticates",
    :triggers => "triggers", :hosts => "hosts", _ => "relates to",
  }
}
let rel_label = fn(r: Relation) -> utf8 { r.label ?? kind_text(r.kind) }

// One relation lifted to an arbitrary level, keyed for dedup.
type RolledEdge { key: utf8  source: identifier  destination: identifier  label: utf8 }

// Dedup a rolled list into renderable edges, merging parallel labels.
let dedup_edges = fn(rolled: list<RolledEdge>) -> list<Edge> {
  map(unique(map(rolled, fn(e: RolledEdge) -> utf8 { e.key })), fn(k: utf8) -> Edge {
    let es = filter(rolled, fn(x: RolledEdge) -> bool { x.key == k });
    let e = head(es);
    { source: e.source, destination: e.destination,
      label: join(unique(map(es, fn(x: RolledEdge) -> utf8 { x.label })), ", ") }
  })
}

// System-level context edges (View 2): endpoints rolled to their systems,
// self-edges dropped, parallel relations merged.
let ctx_rolled = filter(
  map(relations, fn(r: Relation) -> RolledEdge {
    let s = owner_system(r.source);
    let d = owner_system(r.destination);
    { key: $"${s}|${d}", source: s, destination: d, label: rel_label(r) }
  }),
  fn(e: RolledEdge) -> bool { e.source != e.destination })
let ctx_edges = dedup_edges(ctx_rolled)

// Container-level edges touching one system (View 4 system pages).
let sys_rolled = fn(sid: identifier) -> list<RolledEdge> {
  filter(
    map(relations, fn(r: Relation) -> RolledEdge {
      let s = owner_container(r.source);
      let d = owner_container(r.destination);
      { key: $"${s}|${d}", source: s, destination: d, label: rel_label(r) }
    }),
    fn(e: RolledEdge) -> bool {
      e.source != e.destination
        && (owner_system(e.source) == sid || owner_system(e.destination) == sid)
    })
}

// The nodes a system's container diagram must draw besides its own
// containers: everything its rolled edges touch that lives elsewhere.
let sys_neighbors = fn(sid: identifier) -> list<NodeRef> {
  let es = sys_rolled(sid);
  let ids = unique(flatten(map(es, fn(e: RolledEdge) -> list<identifier> { [e.source, e.destination] })));
  map(filter(ids, fn(nid: identifier) -> bool { owner_system(nid) != sid }),
      fn(nid: identifier) -> NodeRef { node_of(nid) })
}

// Relations touching the given ids (directly or via ownership roll-up).
let rels_touching = fn(ids: list<identifier>) -> list<Relation> {
  filter(relations, fn(r: Relation) -> bool {
    list_contains(ids, r.source) || list_contains(ids, r.destination)
      || list_contains(ids, owner_container(r.source)) || list_contains(ids, owner_container(r.destination))
      || list_contains(ids, owner_system(r.source)) || list_contains(ids, owner_system(r.destination))
  })
}
let rel_rows = fn(rels: list<Relation>) -> list<list<utf8>> {
  map(rels, fn(r: Relation) -> list<utf8> {
    [link_of(r.source), rel_label(r), link_of(r.destination), r.protocol ?? "—", r.data ?? "—"]
  })
}

// --- misc shared helpers ----------------------------------------------------
let containers_of = fn(sid: identifier) -> list<Container> {
  filter(containers, fn(c: Container) -> bool { c.system == sid })
}
let components_of = fn(cid: identifier) -> list<Component> {
  filter(sw_components, fn(c: Component) -> bool { c.container == cid })
}
// Code items attach at component level; direct container attachment is the
// fallback for WADs that don't model components (kept navigable in the toc).
let code_items_of = fn(cid: identifier) -> list<CodeItem> {
  filter(code_items, fn(ci: CodeItem) -> bool { ci.container == cid })
}
let code_items_of_comp = fn(coid: identifier) -> list<CodeItem> {
  filter(code_items, fn(ci: CodeItem) -> bool { ci.component == coid })
}
let screens_of = fn(cid: identifier) -> list<Screen> {
  filter(screens, fn(sc: Screen) -> bool { sc.container == cid })
}
let screens_of_comp = fn(coid: identifier) -> list<Screen> {
  filter(screens, fn(sc: Screen) -> bool { sc.component == coid })
}
let stakeholder_names = fn(ids: list<identifier>) -> utf8 {
  let xs = map(ids, fn(sid: identifier) -> utf8 {
    let st = find(stakeholders, fn(x: Stakeholder) -> bool { x.id == sid });
    match st { none => $"${sid}", _ => st.name }
  });
  match len(xs) { 0 => "—", _ => join(xs, ", ") }
}
// Articles filed under a view, in `order`.
let articles_in = fn(sec: WadSection) -> list<Article> {
  sort_by(filter(articles, fn(a: Article) -> bool { a.section == sec }),
          fn(a: Article) -> utf8 { pad_start($"${a.order ?? 99}", 4, "0") })
}
let envs_sorted = sort_by(environments, fn(e: Environment) -> utf8 { pad_start($"${e.order ?? 99}", 4, "0") })

// --- site -------------------------------------------------------------------
site book {
  default_template = :book
  title            = $"${wad.name} — Architecture"
  summary          = $"${wad.summary}"
  root             = true
  theme            = :nord
  accent           = :cyan
  theme_toggle     = true
  search           = true
  toc {
    chapter "Overview" { page = index
      chapter "Decisions (ADRs)" { page = adrs_page
        wdoc_repeater { each = adrs_sorted  as = :a
          chapter $"${adr_ref(a)}: ${a.title}" { page = $"adr_${a.id}" }
        }
      }
      wdoc_repeater { each = articles_in(:overview)  as = :ar
        chapter $"${ar.title}" { page = $"article_${ar.id}" }
      }
    }
    chapter "System context" { page = system_context
      wdoc_repeater { each = articles_in(:context)  as = :ar
        chapter $"${ar.title}" { page = $"article_${ar.id}" }
      }
    }
    chapter "External systems" { page = externals_page
      wdoc_repeater { each = externals  as = :e
        chapter $"${e.name}" { page = $"external_${e.id}" }
      }
      wdoc_repeater { each = articles_in(:externals)  as = :ar
        chapter $"${ar.title}" { page = $"article_${ar.id}" }
      }
    }
    chapter "Systems" { page = systems_page
      wdoc_repeater { each = systems  as = :s
        chapter $"${s.name}" { page = $"system_${s.id}"
          wdoc_repeater { each = containers_of(s.id)  as = :c
            chapter $"${c.name}" { page = $"container_${c.id}"
              wdoc_repeater { each = components_of(c.id)  as = :co
                chapter $"${co.name}" { page = $"component_${co.id}"
                  wdoc_repeater { each = code_items_of_comp(co.id)  as = :ci
                    chapter $"${ci.name}" { page = $"code_${ci.id}" }
                  }
                  wdoc_repeater { each = screens_of_comp(co.id)  as = :sc
                    chapter $"${sc.name}" { page = $"screen_${sc.id}" }
                  }
                }
              }
              wdoc_repeater { each = code_items_of(c.id)  as = :ci
                chapter $"${ci.name}" { page = $"code_${ci.id}" }
              }
              wdoc_repeater { each = screens_of(c.id)  as = :sc
                chapter $"${sc.name}" { page = $"screen_${sc.id}" }
              }
            }
          }
        }
      }
      wdoc_repeater { each = articles_in(:systems)  as = :ar
        chapter $"${ar.title}" { page = $"article_${ar.id}" }
      }
    }
    chapter "Infrastructure" { page = infrastructure_page
      wdoc_repeater { each = envs_sorted  as = :e
        chapter $"${e.name}" { page = $"env_${e.id}" }
      }
      wdoc_repeater { each = articles_in(:infrastructure)  as = :ar
        chapter $"${ar.title}" { page = $"article_${ar.id}" }
      }
    }
    chapter "Build & deploy" { page = build_page
      wdoc_repeater { each = repositories  as = :r
        chapter $"${r.name}" { page = $"repo_${r.id}" }
      }
      wdoc_repeater { each = pipelines  as = :pl
        chapter $"${pl.name}" { page = $"pipeline_${pl.id}" }
      }
      wdoc_repeater { each = articles_in(:build_deploy)  as = :ar
        chapter $"${ar.title}" { page = $"article_${ar.id}" }
      }
    }
    chapter "Documentation" { page = documentation_page
      wdoc_repeater { each = doc_items  as = :d
        chapter $"${d.name}" { page = $"doc_${d.id}" }
      }
      wdoc_repeater { each = articles_in(:documentation)  as = :ar
        chapter $"${ar.title}" { page = $"article_${ar.id}" }
      }
    }
    chapter "User personas" { page = personas_page
      wdoc_repeater { each = personas  as = :pe
        chapter $"${pe.name}" { page = $"persona_${pe.id}"
          wdoc_repeater { each = filter(use_cases, fn(uc: UseCase) -> bool { uc.persona == pe.id })  as = :uc
            chapter $"${uc.title}" { page = $"uc_${uc.id}" }
          }
        }
      }
      wdoc_repeater { each = articles_in(:personas)  as = :ar
        chapter $"${ar.title}" { page = $"article_${ar.id}" }
      }
    }
    chapter "System admin" { page = sysadmin_page
      wdoc_repeater { each = sops  as = :so
        chapter $"${so.title}" { page = $"sop_${so.id}" }
      }
      wdoc_repeater { each = articles_in(:sysadmin)  as = :ar
        chapter $"${ar.title}" { page = $"article_${ar.id}" }
      }
    }
    chapter "Standards & rules" { page = standards_page
      wdoc_repeater { each = standards  as = :st
        chapter $"${st.title}" { page = $"standard_${st.id}" }
      }
      wdoc_repeater { each = articles_in(:standards)  as = :ar
        chapter $"${ar.title}" { page = $"article_${ar.id}" }
      }
    }
    chapter "Domain" { page = domain_page
      wdoc_repeater { each = domain_objects  as = :d
        chapter $"${d.name}" { page = $"domain_${d.id}" }
      }
      chapter "Glossary" { page = glossary_page }
      wdoc_repeater { each = articles_in(:domain)  as = :ar
        chapter $"${ar.title}" { page = $"article_${ar.id}" }
      }
    }
    chapter "Specs" { page = specs_page
      wdoc_repeater { each = specs  as = :sp
        chapter $"${sp.title}" { page = $"spec_${sp.id}" }
      }
      wdoc_repeater { each = articles_in(:specs)  as = :ar
        chapter $"${ar.title}" { page = $"article_${ar.id}" }
      }
    }
  }
}

// Small shared stylesheet: the external-system card tint plus tightened
// metadata paragraphs. Everything else rides on the theme.
stylesheet "wad-book" {
  css = <<CSS
.wad-external { border-style: dashed; opacity: 0.92; }
.wad-meta p { margin: 0.15rem 0; }
CSS
}
WAD_WDOC_BOOK_MAIN_WCL
}

file "wdoc/pages/articles.wcl" {
  content = <<'WAD_WDOC_PAGES_ARTICLES_WCL'
// Articles — freeform prose sub-pages filed under a view via `section`.
// The toc in wdoc/book/main.wcl places each under its view's chapter; this
// file generates the pages themselves.

wdoc_repeater { each = articles  as = :ar
  page $"article_${ar.id}" { title = $"${ar.title}"
    h1 $"${ar.title}"
    wdoc_repeater { each = match ar.summary { none => [], sx => [sx] }  as = :sx
      p $"_${sx}_"
    }
    wdoc_repeater { each = match ar.body { none => [], _ => [true] }  as = :_b
      project { from = ar.body }
    }
    wdoc_repeater { each = match len(ar.related) { 0 => [], _ => [true] }  as = :_r
      h2 "Related"
      wdoc_repeater { each = ar.related  as = :rid
        p $"- ${link_of(rid)}"
      }
    }
    edit_object { kind = "article"  target = $"${ar.id}" }
  }
}
WAD_WDOC_PAGES_ARTICLES_WCL
}

file "wdoc/pages/build.wcl" {
  content = <<'WAD_WDOC_PAGES_BUILD_WCL'
// View 6 — Build & deploy: repositories, pipelines, and releases. The
// landing page lists all three plus the day-to-day dev runbooks; each
// repository gets a structure diagram (submodule-aware) and each pipeline a
// stage flowchart (from the stage `next` DAG) with per-stage detail.
// Resolves the `let` helpers from wdoc/book/main.wcl.

let stage_edges = fn(pl: Pipeline) -> list<Edge> {
  flatten(map(pl.stages, fn(st: PipelineStage) -> list<Edge> {
    map(st.next, fn(nx: identifier) -> Edge { { source: st.id, destination: nx } })
  }))
}
let stage_name = fn(st: PipelineStage) -> utf8 { st.name ?? $"${st.id}" }
let stage_name_of = fn(pl: Pipeline, sid: identifier) -> utf8 {
  let st = find(pl.stages, fn(x: PipelineStage) -> bool { x.id == sid });
  match st { none => $"${sid}", _ => stage_name(st) }
}
// A structure path's submodule note: ours links to its repository page,
// an external one is named as outside our control.
let repo_path_note = fn(rp: RepoPath) -> utf8 {
  match rp.repo {
    none => match rp.external_url { none => "", u2 => $" · **external submodule** — ${u2}" },
    rid  => $" · submodule → ${link_of(rid)}",
  }
}

page build_page { title = "Build & deploy"
  h1 "Build & deploy"
  p  "How the system is built, tested, shipped, and promoted between environments."

  h2 "Repositories"
  wdoc_repeater { each = match len(repositories) { 0 => [true], _ => [] }  as = :_e
    p "_No repositories recorded._"
  }
  wdoc_repeater { each = match len(repositories) { 0 => [], _ => [true] }  as = :_t
    table {
      header = ["Repository", "Language", "URL", "Summary"]
      rows = map(repositories, fn(r: Repository) -> list<utf8> {
        [$"[${r.name}](repo_${r.id})", r.primary_language ?? "—", r.url, r.summary ?? "—"]
      })
    }
  }

  h2 "Pipelines"
  wdoc_repeater { each = match len(pipelines) { 0 => [true], _ => [] }  as = :_e2
    p "_No pipelines recorded._"
  }
  wdoc_repeater { each = pipelines  as = :pl
    p $"- [${pl.name}](pipeline_${pl.id})${match pl.trigger { none => "", t2 => $" — triggered by ${t2}" }}${match pl.summary { none => "", sx => $" — ${sx}" }}"
  }

  h2 "Releases"
  wdoc_repeater { each = match len(releases) { 0 => [true], _ => [] }  as = :_e3
    p "_No releases recorded._"
  }
  wdoc_repeater { each = match len(releases) { 0 => [], _ => [true] }  as = :_rt
    p "What shipped in each version, newest first — extractor-owned (derived from git tags), never hand-maintained."
    table {
      header = ["Version", "Date", "What's in it"]
      rows = map(releases, fn(rl: Release) -> list<utf8> {
        [match rl.url { none => rl.version, u2 => $"[${rl.version}](${u2})" },
         rl.date ?? "—", join(rl.highlights, " · ")]
      })
    }
  }

  wdoc_repeater { each = match len(filter(sops, fn(so: Sop) -> bool { so.kind == :dev })) { 0 => [], _ => [true] }  as = :_ld
    h2 "Local development"
    p  "The day-to-day development runbooks (articles under this chapter carry the longer setup / branching / release detail):"
    wdoc_repeater { each = filter(sops, fn(so: Sop) -> bool { so.kind == :dev })  as = :so
      p $"- [${so.title}](sop_${so.id}) — ${so.purpose}"
    }
  }
}

// --- one page per repository ---------------------------------------------------
wdoc_repeater { each = repositories  as = :r
  page $"repo_${r.id}" { title = $"${r.name}"
    h1 $"${r.name}"
    wdoc_repeater { each = match r.summary { none => [], sx => [sx] }  as = :sx
      p $"_${sx}_"
    }
    p $"**URL:** ${r.url}${match r.primary_language { none => "", l2 => $" · **Language:** ${l2}" }}"

    wdoc_repeater { each = match len(r.structure) { 0 => [], _ => [true] }  as = :_s
      h2 "Structure"
      // The nesting picture: the repo fans out to its notable paths. A path
      // that is really another repo says so — ours link to their page,
      // external submodules draw dashed (outside our control).
      diagram { width = 960  height = 520  layout = :layered  direction = :left_to_right
        layer_gap = 110.0  node_gap = 26.0  pan_zoom = true
        desc = $"Structure of ${r.name}"
        card { id = r.id  title = r.name  width = 190.0  height = 80.0
          text $"${r.summary ?? ""}"
        }
        wdoc_repeater { each = filter(r.structure, fn(rp: RepoPath) -> bool { rp.external_url == none })  as = :rp
          card { id = rp.id  title = rp.path  width = 300.0  height = 96.0
            text $"${rp.description}${repo_path_note(rp)}"
          }
        }
        wdoc_repeater { each = filter(r.structure, fn(rp: RepoPath) -> bool { rp.external_url != none })  as = :rp
          card { id = rp.id  title = rp.path  width = 300.0  height = 96.0  class = ["wad-external"]
            text $"${rp.description}${repo_path_note(rp)}"
          }
        }
        edges = map(r.structure, fn(rp: RepoPath) -> Edge {
          { source: r.id, destination: rp.id }
        })
      }
    }

    wdoc_repeater { each = match r.body { none => [], _ => [true] }  as = :_b
      project { from = r.body }
    }
    edit_object { kind = "repository"  target = $"${r.id}" }
  }
}

// --- one page per pipeline -------------------------------------------------------
wdoc_repeater { each = pipelines  as = :pl
  page $"pipeline_${pl.id}" { title = $"${pl.name}"
    h1 $"${pl.name}"
    wdoc_repeater { each = match pl.summary { none => [], sx => [sx] }  as = :sx
      p $"_${sx}_"
    }
    p $"${match pl.repo { none => "", rid => $"**Repository:** ${link_of(rid)} · " }}**Trigger:** ${pl.trigger ?? "—"}"

    wdoc_repeater { each = match len(pl.stages) { 0 => [], _ => [true] }  as = :_d
      diagram { width = 920  height = 420  layout = :layered  direction = :left_to_right
        layer_gap = 80.0  node_gap = 36.0  pan_zoom = true
        desc = $"Stage flow for ${pl.name}"
        wdoc_repeater { each = pl.stages  as = :st
          process $"${stage_name(st)}" { id = st.id  width = 160.0  height = 56.0 }
        }
        edges = stage_edges(pl)
      }
      h2 "Stages"
      wdoc_repeater { each = pl.stages  as = :st
        h3 $"${stage_name(st)}"
        wdoc_repeater { each = match st.summary { none => [], sx => [sx] }  as = :sx
          p $"**Does:** ${sx}"
        }
        wdoc_repeater { each = match st.environment { none => [], eid => [eid] }  as = :eid
          p $"**Deploys to:** ${link_of(eid)}"
        }
        wdoc_repeater { each = match len(st.gates) { 0 => [], _ => [true] }  as = :_g
          p $"**Runs when:** ${join(st.gates, "; ")}"
        }
        wdoc_repeater { each = match len(st.next) { 0 => [], _ => [true] }  as = :_n
          p $"**Then:** ${join(map(st.next, fn(nx: identifier) -> utf8 { stage_name_of(pl, nx) }), ", ")}"
        }
      }
    }

    wdoc_repeater { each = match pl.body { none => [], _ => [true] }  as = :_b
      project { from = pl.body }
    }
    edit_object { kind = "pipeline"  target = $"${pl.id}" }
  }
}
WAD_WDOC_PAGES_BUILD_WCL
}

file "wdoc/pages/context.wcl" {
  content = <<'WAD_WDOC_PAGES_CONTEXT_WCL'
// View 2 — System context: one derived diagram of the whole estate (systems
// in a boundary, externals dashed, personas as actors) wired by the
// system-level roll-up of every authored relation. Nothing here is drawn by
// hand — it all derives from `relation` blocks. Resolves the `let` helpers
// from wdoc/book/main.wcl.

let ctx_sys_ids = map(systems, fn(s: System) -> identifier { s.id })

page system_context { title = "System context"
  h1 "System context"
  p  $"How ${wad.name} sits in the world: the systems this design owns, the external systems it integrates with, and the personas that use it. Every edge derives from an authored `relation`, rolled up to system level."

  wdoc_repeater { each = match len(relations) { 0 => [true], _ => [] }  as = :_e
    callout "No relations yet" { class = ["note"]
      body = "Author `relation` blocks under data/context/ and this diagram draws itself." }
  }

  // Radial layout: hub-and-spoke reads naturally for a context view, and
  // its boundary-member inflation gives non-members (personas, externals)
  // clearance from the boundary band. (Every planned layout additionally
  // guarantees non-members are evicted from boundary boxes post-plan.)
  diagram { width = 960  height = 560  layout = :radial
    node_gap = 48.0  pan_zoom = true
    desc = $"System context diagram for ${wad.name}"
    wdoc_repeater { each = systems  as = :s
      card { id = s.id  title = s.name  width = 190.0  height = 100.0
        text $"${s.summary} [Details](system_${s.id})"
      }
    }
    wdoc_repeater { each = externals  as = :e
      card { id = e.id  title = e.name  width = 190.0  height = 90.0  class = ["wad-external"]
        text $"${e.summary} [Details](external_${e.id})"
      }
    }
    wdoc_repeater { each = personas  as = :pe
      process $"${pe.name}" { id = pe.id  width = 140.0  height = 60.0
        icon = "lucide.user"  link = $"persona_${pe.id}"
      }
    }
    wdoc_repeater { each = match len(systems) { 0 => [], _ => [true] }  as = :_bd
      // Padding ≥ the label headroom so the member inflation the radial
      // solver applies covers the title band too.
      boundary $"${wad.name}" { members = ctx_sys_ids  padding = 28.0 }
    }
    edges = ctx_edges
  }
}
WAD_WDOC_PAGES_CONTEXT_WCL
}

file "wdoc/pages/documentation.wcl" {
  content = <<'WAD_WDOC_PAGES_DOCUMENTATION_WCL'
// Documentation view — the documentation artefacts the project ships: sites,
// books, agent skills, references, READMEs. Documentation is an OUTPUT of
// the system, not a system: this view records where each artefact is
// authored, what builds it, where it's hosted, and who it serves. Resolves
// the `let` helpers from wdoc/book/main.wcl.

page documentation_page { title = "Documentation"
  h1 "Documentation"
  p  "Everything the project publishes to be read. Each artefact records where it's authored, what builds it, where it's hosted, and who it serves — so the docs estate is reviewable like the rest of the architecture."

  wdoc_repeater { each = match len(doc_items) { 0 => [true], _ => [] }  as = :_e
    p "_No documentation recorded._"
  }
  wdoc_repeater { each = match len(doc_items) { 0 => [], _ => [true] }  as = :_t
    table {
      header = ["Artefact", "Kind", "Published at", "Summary"]
      rows = map(doc_items, fn(d: DocItem) -> list<utf8> {
        [$"[${d.name}](doc_${d.id})", $"`${d.kind}`", d.url ?? "—", d.summary]
      })
    }
  }
}

// --- one page per doc_item -----------------------------------------------------
wdoc_repeater { each = doc_items  as = :d
  page $"doc_${d.id}" { title = $"${d.name}"
    h1 $"${d.name}"
    p  $"_${d.summary}_"
    table {
      rows = [
        ["Kind", $"${d.kind}"],
        ["Source", match d.source { none => "—", sx => $"`${sx}`" }],
        ["Published at", d.url ?? "—"],
        ["Built by", match d.built_by { none => "—", b2 => link_of(b2) }],
        ["Hosted on", d.hosted_on ?? "—"],
        ["Audience", match len(d.audience) { 0 => "—", _ => join(map(d.audience, fn(pid: identifier) -> utf8 { link_of(pid) }), ", ") }],
      ]
    }
    wdoc_repeater { each = match d.body { none => [], _ => [true] }  as = :_b
      project { from = d.body }
    }
    edit_object { kind = "doc_item"  target = $"${d.id}" }
  }
}
WAD_WDOC_PAGES_DOCUMENTATION_WCL
}

file "wdoc/pages/domain.wcl" {
  content = <<'WAD_WDOC_PAGES_DOMAIN_WCL'
// View 10 — Domain: the ER diagram over every domain object (node_table per
// object, relationship edges attached to field rows via `via_field`), one
// page per object, and the glossary. Resolves the `let` helpers from
// wdoc/book/main.wcl.

let domain_rel_text = fn(k: DomainRelKind) -> utf8 {
  match k { :has_one => "has one", :has_many => "has many", :references => "references",
            :extends => "extends", :uses => "uses", _ => "relates to" }
}
// ER edges: leave from a field row when `via_field` names one, from the
// whole object otherwise; always land on the target object.
let er_edges = flatten(map(domain_objects, fn(d: DomainObject) -> list<Edge> {
  map(d.relations, fn(r: DomainRel) -> Edge {
    { source: match r.via_field { none => $"${d.id}", vf => $"${d.id}_${vf}" },
      destination: $"${r.to}",
      label: r.label ?? domain_rel_text(r.kind) }
  })
}))

page domain_page { title = "Domain"
  h1 "Domain"
  p  "The objects the system's model is built around, their fields, and how they relate."

  wdoc_repeater { each = match len(domain_objects) { 0 => [true], _ => [] }  as = :_e
    p "_No domain objects recorded._"
  }
  wdoc_repeater { each = match len(domain_objects) { 0 => [], _ => [true] }  as = :_d
    diagram { width = 960  height = 620  layout = :force  link_distance = 230.0  repulsion = 14000.0  pan_zoom = true
      desc = "Domain object relationships"
      wdoc_repeater { each = domain_objects  as = :d
        node_table { id = d.id  title = d.name  width = 220.0
          wdoc_repeater { each = d.fields  as = :f
            node_row { id = $"${d.id}_${f.name}"
              text $"${f.name}: `${f.type}`${match f.required { true => "", _ => "?" }}"
            }
          }
        }
      }
      edges = er_edges
    }
    wdoc_repeater { each = domain_objects  as = :d
      p $"- [${d.name}](domain_${d.id}) — ${d.summary}"
    }
  }
  p "See also the [glossary](glossary_page)."
}

// --- one page per domain object -------------------------------------------------------
wdoc_repeater { each = domain_objects  as = :d
  page $"domain_${d.id}" { title = $"${d.name}"
    h1 $"${d.name}"
    p  $"_${d.summary}_"

    wdoc_repeater { each = match len(d.fields) { 0 => [], _ => [true] }  as = :_f
      h2 "Fields"
      table {
        header = ["Field", "Type", "Required", "Summary"]
        rows = map(d.fields, fn(f: DomainField) -> list<utf8> {
          [$"`${f.name}`", $"`${f.type}`", match f.required { true => "yes", _ => "no" }, f.summary ?? "—"]
        })
      }
    }

    wdoc_repeater { each = match len(d.relations) { 0 => [], _ => [true] }  as = :_r
      h2 "Relationships"
      wdoc_repeater { each = d.relations  as = :r
        p $"- ${domain_rel_text(r.kind)} [${name_of(r.to)}](domain_${r.to})${match r.via_field { none => "", vf => $" (via `${vf}`)" }}"
      }
    }

    wdoc_repeater { each = match d.body { none => [], _ => [true] }  as = :_b
      project { from = d.body }
    }
    edit_object { kind = "domain_object"  target = $"${d.id}" }
  }
}

// --- glossary -------------------------------------------------------------------------
page glossary_page { title = "Glossary"
  h1 "Glossary"
  wdoc_repeater { each = match len(terms) { 0 => [true], _ => [] }  as = :_e
    p "_No terms recorded._"
  }
  wdoc_repeater { each = match len(terms) { 0 => [], _ => [true] }  as = :_t
    table {
      header = ["Term", "Definition", "Aliases"]
      rows = map(sort_by(terms, fn(t2: Term) -> utf8 { to_lower(t2.term) }), fn(t2: Term) -> list<utf8> {
        [$"**${t2.term}**", t2.definition, match len(t2.aliases) { 0 => "—", _ => join(t2.aliases, ", ") }]
      })
    }
  }
}
WAD_WDOC_PAGES_DOMAIN_WCL
}

file "wdoc/pages/externals.wcl" {
  content = <<'WAD_WDOC_PAGES_EXTERNALS_WCL'
// View 3 — External systems: a landing table plus one page per external
// system (support contacts, connection endpoints per environment, API
// references, security notes, touching relations). Resolves the `let`
// helpers from wdoc/book/main.wcl.

let criticality_text = fn(c: Criticality) -> utf8 {
  match c { :low => "low", :medium => "medium", :high => "high", :critical => "critical", _ => "—" }
}
let ext_kind_text = fn(k: ExternalKind) -> utf8 {
  match k { :saas => "SaaS", :api => "API", :registry => "registry", :identity => "identity",
            :datastore => "datastore", :ci => "CI", :cdn => "CDN", :payment => "payment",
            :partner => "partner", :ai_service => "AI service", _ => "other" }
}

page externals_page { title = "External systems"
  h1 "External systems"
  p  "Systems outside this design that it depends on or integrates with — who runs them, how to reach them, and what to watch."

  wdoc_repeater { each = match len(externals) { 0 => [true], _ => [] }  as = :_e
    p "_No external systems recorded._"
  }
  wdoc_repeater { each = match len(externals) { 0 => [], _ => [true] }  as = :_t
    table {
      header = ["System", "Kind", "Vendor", "Criticality"]
      rows = map(externals, fn(e: ExternalSystem) -> list<utf8> {
        [$"[${e.name}](external_${e.id})", ext_kind_text(e.kind), e.vendor ?? "—",
         match e.criticality { none => "—", c => criticality_text(c) }]
      })
    }
  }
}

// --- one page per external system --------------------------------------------
wdoc_repeater { each = externals  as = :e
  page $"external_${e.id}" { title = $"${e.name}"
    h1 $"${e.name}"
    p  $"_${e.summary}_"
    table {
      rows = [
        ["Kind", ext_kind_text(e.kind)],
        ["Vendor", e.vendor ?? "—"],
        ["URL", e.url ?? "—"],
        ["Criticality", match e.criticality { none => "—", c => criticality_text(c) }],
      ]
    }

    wdoc_repeater { each = match len(e.contacts) { 0 => [], _ => [true] }  as = :_c
      h2 "Support"
      table {
        header = ["Contact", "Role", "Channel", "Details"]
        rows = map(e.contacts, fn(ct: SupportContact) -> list<utf8> {
          [ct.name, ct.role ?? "—", ct.channel, ct.details ?? "—"]
        })
      }
    }

    wdoc_repeater { each = match len(e.endpoints) { 0 => [], _ => [true] }  as = :_p
      h2 "Connection details"
      table {
        header = ["Name", "Environment", "Kind", "Value", "Notes"]
        rows = map(e.endpoints, fn(ep: Endpoint) -> list<utf8> {
          [ep.name, match ep.environment { none => "shared", env => name_of(env) },
           ep.kind, $"`${ep.value}`", ep.notes ?? "—"]
        })
      }
    }

    wdoc_repeater { each = match len(e.api_refs) { 0 => [], _ => [true] }  as = :_a
      h2 "API & integration references"
      wdoc_repeater { each = e.api_refs  as = :ar
        p $"- **${ar.name}** (${ar.kind}) — ${ar.location}${match ar.notes { none => "", nx => $" — ${nx}" }}"
      }
    }

    wdoc_repeater { each = e.security  as = :sn
      callout $"${sn.title}" {
        class = [match sn.severity { none => "note", :low => "note", :medium => "warning", _ => "error" }]
        body  = $"${sn.detail}"
      }
    }

    wdoc_repeater { each = match len(rels_touching([e.id])) { 0 => [], _ => [true] }  as = :_r
      h2 "Relations involving this system"
      table {
        header = ["From", "Relation", "To", "Protocol", "Data"]
        rows = rel_rows(rels_touching([e.id]))
      }
    }

    wdoc_repeater { each = match e.body { none => [], _ => [true] }  as = :_b
      project { from = e.body }
    }
    edit_object { kind = "external_system"  target = $"${e.id}" }
  }
}
WAD_WDOC_PAGES_EXTERNALS_WCL
}

file "wdoc/pages/infrastructure.wcl" {
  content = <<'WAD_WDOC_PAGES_INFRASTRUCTURE_WCL'
// View 5 — Infrastructure: the environment list + promotion chain on the
// landing page, then one page per environment rendering its infra-node
// hierarchy (flat `parent` refs unrolled to four levels — deeper nodes land
// in a flat table) and its deployment map. Resolves the `let` helpers from
// wdoc/book/main.wcl.

let infra_children = fn(pid: identifier) -> list<InfraNode> {
  filter(infra_nodes, fn(n: InfraNode) -> bool { n.parent == pid })
}
let env_top_nodes = fn(eid: identifier) -> list<InfraNode> {
  filter(infra_nodes, fn(n: InfraNode) -> bool {
    n.parent == none && list_contains(n.environments, eid)
  })
}
let shared_mark = fn(n: InfraNode) -> utf8 {
  match len(n.environments) { 0 => "", 1 => "", _ => " · _shared_" }
}
let infra_line = fn(n: InfraNode) -> utf8 {
  $"**${n.name}** (`${n.kind}`)${match n.technology { none => "", t2 => $" — ${t2}" }}${match n.address { none => "", ad => $" · `${ad}`" }}${shared_mark(n)}"
}
// Nodes deeper than the 4 rendered levels (level-4 nodes that still have
// children) — surfaced in a flat table so nothing silently disappears.
let promo_edges = flatten(map(environments, fn(e: Environment) -> list<Edge> {
  match e.promotes_to { none => [], t2 => [{ source: e.id, destination: t2, label: "promotes to" }] }
}))
let env_deploys = fn(eid: identifier) -> list<DeployTarget> {
  filter(deploy_targets, fn(dt: DeployTarget) -> bool { dt.environment == eid })
}
let shared_nodes = filter(infra_nodes, fn(n: InfraNode) -> bool { len(n.environments) > 1 })

page infrastructure_page { title = "Infrastructure"
  h1 "Infrastructure"
  p  "The environments the system runs in, how changes promote between them, and the infrastructure shared across them."

  wdoc_repeater { each = match len(environments) { 0 => [true], _ => [] }  as = :_e
    p "_No environments recorded._"
    p "Having no infrastructure is common — software that runs entirely on the user's machine (CLI tools, desktop apps, libraries) has no environments to promote through. Build and release plumbing lives in Build & deploy."
  }

  wdoc_repeater { each = match len(environments) { 0 => [], _ => [true] }  as = :_d
    diagram { width = 860  height = 220  layout = :layered  direction = :left_to_right
      layer_gap = 110.0  pan_zoom = true
      desc = "Environment promotion chain"
      wdoc_repeater { each = envs_sorted  as = :e
        card { id = e.id  title = e.name  width = 170.0  height = 80.0
          text $"${e.summary ?? ""} [Details](env_${e.id})"
        }
      }
      edges = promo_edges
    }
    table {
      header = ["Environment", "Kind", "URL"]
      rows = map(envs_sorted, fn(e: Environment) -> list<utf8> {
        [$"[${e.name}](env_${e.id})", match e.kind { none => "—", k2 => $"${k2}" }, e.url ?? "—"]
      })
    }
  }

  wdoc_repeater { each = match len(shared_nodes) { 0 => [], _ => [true] }  as = :_s
    h2 "Shared infrastructure"
    p  "Nodes serving more than one environment — changes here have blast radius."
    table {
      header = ["Node", "Kind", "Environments"]
      rows = map(shared_nodes, fn(n: InfraNode) -> list<utf8> {
        [n.name, $"${n.kind}", join(map(n.environments, fn(eid: identifier) -> utf8 { link_of(eid) }), ", ")]
      })
    }
  }
}

// --- one page per environment ---------------------------------------------------
wdoc_repeater { each = environments  as = :e
  page $"env_${e.id}" { title = $"${e.name}"
    h1 $"${e.name}"
    wdoc_repeater { each = match e.summary { none => [], sx => [sx] }  as = :sx
      p $"_${sx}_"
    }
    wdoc_repeater { each = match e.url { none => [], u2 => [u2] }  as = :u2
      p $"**URL:** ${u2}"
    }
    wdoc_repeater { each = match e.promotes_to { none => [], t2 => [t2] }  as = :t2
      p $"**Promotes to:** ${link_of(t2)}"
    }
    wdoc_repeater { each = match e.body { none => [], _ => [true] }  as = :_b
      project { from = e.body }
    }

    h2 "Infrastructure"
    wdoc_repeater { each = match len(env_top_nodes(e.id)) { 0 => [true], _ => [] }  as = :_n
      p "_No infrastructure nodes recorded for this environment._"
    }
    wdoc_repeater { each = env_top_nodes(e.id)  as = :n1
      h3 $"${n1.name}"
      p  $"`${n1.kind}`${match n1.technology { none => "", t2 => $" — ${t2}" }}${match n1.address { none => "", ad => $" · `${ad}`" }}${shared_mark(n1)}${match n1.notes { none => "", nt => $" — ${nt}" }}"
      wdoc_repeater { each = match n1.body { none => [], _ => [true] }  as = :_b
        project { from = n1.body }
      }
      wdoc_repeater { each = infra_children(n1.id)  as = :n2
        p $"- ${infra_line(n2)}"
        wdoc_repeater { each = infra_children(n2.id)  as = :n3
          p $"    - ${infra_line(n3)}"
          wdoc_repeater { each = infra_children(n3.id)  as = :n4
            p $"        - ${infra_line(n4)}"
          }
        }
      }
    }

    wdoc_repeater { each = match len(env_deploys(e.id)) { 0 => [], _ => [true] }  as = :_d
      h2 "Deployment map"
      table {
        header = ["Container", "Runs on", "Replicas", "URL"]
        rows = map(env_deploys(e.id), fn(dt: DeployTarget) -> list<utf8> {
          [link_of(dt.container), name_of(dt.infra_node),
           match dt.replicas { none => "—", n2 => $"${n2}" }, dt.url ?? "—"]
        })
      }
    }
    edit_object { kind = "environment"  target = $"${e.id}" }
  }
}
WAD_WDOC_PAGES_INFRASTRUCTURE_WCL
}

file "wdoc/pages/overview.wcl" {
  content = <<'WAD_WDOC_PAGES_OVERVIEW_WCL'
// View 1 — Overview: the landing page (wad metadata, stakeholders, RACI)
// plus the ADR sub-section (one numbered table of every decision, the
// timeline, one page per ADR). Resolves the `let` helpers from
// wdoc/book/main.wcl.

let adr_status_text = fn(s: AdrStatus) -> utf8 {
  match s { :proposed => "Proposed", :accepted => "Accepted", :rejected => "Rejected",
            :superseded => "Superseded", :deprecated => "Deprecated", _ => "Unknown" }
}
let adr_status_class = fn(s: AdrStatus) -> utf8 {
  match s { :accepted => "tip", :proposed => "note", _ => "warning" }
}
// The reference form every rendering uses: ADR-001, ADR-002, …
let adr_ref = fn(a: Adr) -> utf8 { $"ADR-${pad_start($"${a.n}", 3, "0")}" }
let adrs_sorted = sort_by(adrs, fn(a: Adr) -> utf8 { pad_start($"${a.n}", 6, "0") })

page index { title = "Overview"
  h1 $"${wad.name}"
  p  $"_${wad.summary}_"
  wdoc_repeater { each = match wad.description { none => [], d => [d] }  as = :d
    p $"${d}"
  }

  table {
    rows = [
      ["Described version", wad.version ?? "—"],
      ["Created", wad.created],
      ["Last updated", wad.updated ?? wad.created],
      ["Maintainer", wad.maintainer ?? "—"],
    ]
  }

  h2 "Stakeholders"
  wdoc_repeater { each = match len(stakeholders) { 0 => [true], _ => [] }  as = :_e
    p "_No stakeholders recorded._"
  }
  wdoc_repeater { each = match len(stakeholders) { 0 => [], _ => [true] }  as = :_s
    table {
      header = ["Name", "Role", "Organisation", "Contact"]
      rows = map(stakeholders, fn(st: Stakeholder) -> list<utf8> {
        [st.name, st.role, st.org ?? "—", st.contact ?? "—"]
      })
    }
  }

  h2 "Responsibilities (RACI)"
  wdoc_repeater { each = match len(raci) { 0 => [true], _ => [] }  as = :_e
    p "_No RACI rows recorded._"
  }
  wdoc_repeater { each = match len(raci) { 0 => [], _ => [true] }  as = :_r
    table {
      header = ["Activity", "Responsible", "Accountable", "Consulted", "Informed"]
      rows = map(raci, fn(r: RaciEntry) -> list<utf8> {
        [r.activity, stakeholder_names(r.responsible), stakeholder_names(r.accountable),
         stakeholder_names(r.consulted), stakeholder_names(r.informed)]
      })
    }
  }

  h2 "Decisions"
  p $"${len(adrs)} architecture decision record(s) — see [Decisions (ADRs)](adrs_page)."
  edit_object { kind = "wad"  target = $"${wad.id}" }
}

// --- ADR index -------------------------------------------------------------
page adrs_page { title = "Decisions (ADRs)"
  h1 "Architecture decision records"
  p  "Every decision of record for the system, in one numbered table — reference them as ADR-001, ADR-002, … Each links to its full record."

  wdoc_repeater { each = match len(adrs) { 0 => [true], _ => [] }  as = :_e
    p "_No decisions recorded._"
  }
  wdoc_repeater { each = match len(adrs) { 0 => [], _ => [true] }  as = :_t
    table {
      header = ["#", "Decision", "Status", "Date", "Deciders"]
      rows = map(adrs_sorted, fn(a: Adr) -> list<utf8> {
        [$"**${adr_ref(a)}**", $"[${a.title}](adr_${a.id})", adr_status_text(a.status),
         a.date, join(a.deciders, ", ")]
      })
    }
    diagram { width = 900  height = 240  pan_zoom = true
      timeline { width = 880.0  height = 220.0  title = "Decision timeline"
        items = map(adrs_sorted, fn(a: Adr) -> TimelineItem { { label: adr_ref(a), on: a.date } })
      }
    }
  }
}

// --- one page per ADR --------------------------------------------------------
wdoc_repeater { each = adrs  as = :a
  page $"adr_${a.id}" { title = $"${adr_ref(a)}: ${a.title}"
    h1 $"${adr_ref(a)} — ${a.title}"
    callout $"${adr_status_text(a.status)}" {
      class = [adr_status_class(a.status)]
      body  = $"Decided ${a.date}${match len(a.deciders) { 0 => "", _ => $" by ${join(a.deciders, ", ")}" }}."
    }
    wdoc_repeater { each = match a.context { none => [], c => [c] }  as = :c
      h2 "Context"
      p $"${c}"
    }
    wdoc_repeater { each = match len(a.options) { 0 => [], _ => [true] }  as = :_o
      h2 "Options considered"
      table {
        header = ["Option", "Summary", "Outcome"]
        rows = map(a.options, fn(o: AdrOption) -> list<utf8> {
          [$"**${o.title}**", o.summary ?? "—",
           match o.rejected_because { none => "**Chosen**", rb => $"Rejected — ${rb}" }]
        })
      }
    }
    wdoc_repeater { each = match a.decision { none => [], d => [d] }  as = :d
      h2 "Decision"
      p $"${d}"
    }
    wdoc_repeater { each = match a.consequences { none => [], c => [c] }  as = :c
      h2 "Consequences"
      p $"${c}"
    }
    wdoc_repeater { each = match a.body { none => [], _ => [true] }  as = :_b
      project { from = a.body }
    }
    wdoc_repeater { each = match a.supersedes { none => [], sid => [sid] }  as = :sid
      wdoc_repeater { each = filter(adrs, fn(x: Adr) -> bool { x.id == sid })  as = :prev
        p $"Supersedes [${adr_ref(prev)}: ${prev.title}](adr_${prev.id})."
      }
    }
    wdoc_repeater { each = filter(adrs, fn(x: Adr) -> bool { x.supersedes == a.id })  as = :nxt
      p $"Superseded by [${adr_ref(nxt)}: ${nxt.title}](adr_${nxt.id})."
    }
    edit_object { kind = "adr"  target = $"${a.id}" }
  }
}
WAD_WDOC_PAGES_OVERVIEW_WCL
}

file "wdoc/pages/personas.wcl" {
  content = <<'WAD_WDOC_PAGES_PERSONAS_WCL'
// User personas view: who uses the system, what they're trying to do, how
// they get access (security controls only — installation isn't access
// control), and their typical use cases as flowcharts. Resolves the `let`
// helpers from wdoc/book/main.wcl.

let persona_icon = fn(k: PersonaKind) -> utf8 {
  match k { :ai_agent => "lucide.bot", :service => "lucide.cog", _ => "lucide.user" }
}
let persona_kind_text = fn(k: PersonaKind) -> utf8 {
  match k { :ai_agent => "AI agent", :service => "service", _ => "human" }
}
let use_cases_of = fn(pid: identifier) -> list<UseCase> {
  filter(use_cases, fn(uc: UseCase) -> bool { uc.persona == pid })
}

page personas_page { title = "User personas"
  h1 "User personas"
  p  "The kinds of user — human, AI agent, or service — that interact with the system, and how each is granted access."

  wdoc_repeater { each = match len(personas) { 0 => [true], _ => [] }  as = :_e
    p "_No personas recorded._"
  }
  wdoc_repeater { each = match len(personas) { 0 => [], _ => [true] }  as = :_t
    table {
      header = ["Persona", "Kind", "Summary"]
      rows = map(personas, fn(pe: Persona) -> list<utf8> {
        [$"[${pe.name}](persona_${pe.id})", persona_kind_text(pe.kind), pe.summary]
      })
    }
  }
}

// --- one page per persona --------------------------------------------------------
wdoc_repeater { each = personas  as = :pe
  page $"persona_${pe.id}" { title = $"${pe.name}"
    h1 $"${pe.name}"
    p  $"_${pe.summary}_ (`${persona_kind_text(pe.kind)}`)"

    wdoc_repeater { each = match len(pe.goals) { 0 => [], _ => [true] }  as = :_g
      h2 "Goals"
      wdoc_repeater { each = pe.goals  as = :g
        p $"- ${g}"
      }
    }

    wdoc_repeater { each = match len(pe.access) { 0 => [], _ => [true] }  as = :_a
      h2 "Access"
      table {
        header = ["System", "How access is granted", "Approver"]
        rows = map(pe.access, fn(ag: AccessGrant) -> list<utf8> {
          [link_of(ag.system), ag.method, ag.approver ?? "—"]
        })
      }
    }

    wdoc_repeater { each = match len(use_cases_of(pe.id)) { 0 => [], _ => [true] }  as = :_u
      h2 "Use cases"
      p  "Typical flows for this persona — a selection broad enough to exercise most of what they do (they double as user-acceptance test scripts)."
      wdoc_repeater { each = use_cases_of(pe.id)  as = :uc
        p $"- [${uc.title}](uc_${uc.id})${match uc.summary { none => "", sx => $" — ${sx}" }}"
      }
    }

    wdoc_repeater { each = match len(filter(screens, fn(sc: Screen) -> bool { list_contains(sc.personas, pe.id) })) { 0 => [], _ => [true] }  as = :_s
      h2 "Screens used"
      wdoc_repeater { each = filter(screens, fn(sc: Screen) -> bool { list_contains(sc.personas, pe.id) })  as = :sc
        p $"- [${sc.name}](screen_${sc.id})"
      }
    }

    wdoc_repeater { each = match pe.body { none => [], _ => [true] }  as = :_b
      project { from = pe.body }
    }
    edit_object { kind = "persona"  target = $"${pe.id}" }
  }
}

// --- one page per use case ---------------------------------------------------------
wdoc_repeater { each = use_cases  as = :uc
  page $"uc_${uc.id}" { title = $"${uc.title}"
    h1 $"${uc.title}"
    wdoc_repeater { each = match uc.summary { none => [], sx => [sx] }  as = :sx
      p $"_${sx}_"
    }
    p $"**Persona:** ${link_of(uc.persona)}"

    wdoc_repeater { each = match len(uc.preconditions) { 0 => [], _ => [true] }  as = :_p
      h2 "Preconditions"
      wdoc_repeater { each = uc.preconditions  as = :pc
        p $"- ${pc}"
      }
    }

    h2 "Flow"
    diagram {
      width = 560  height = len(uc.steps) * 96 + 64
      layout = :layered  direction = :top_to_bottom  layer_gap = 28.0  node_gap = 32.0
      wdoc_repeater { each = uc.steps  as = :st
        wdoc_repeater { each = match st.shape { :process => [true], _ => [] }  as = :_sh
          process $"${st.n}. ${st.title ?? ""}" { id = $"${st.id}"  width = 190.0  height = 46.0 } }
        wdoc_repeater { each = match st.shape { :decision => [true], _ => [] }  as = :_sh
          decision $"${st.title ?? ""}" { id = $"${st.id}"  width = 170.0  height = 72.0 } }
        wdoc_repeater { each = match st.shape { :terminator => [true], _ => [] }  as = :_sh
          terminator $"${st.title ?? ""}" { id = $"${st.id}"  width = 150.0  height = 46.0 } }
      }
      edges = map(uc.flow, fn(e: StepFlow) -> Edge {
        { source: $"${e.source}", destination: $"${e.destination}",
          kind: :flow, label: match e.kind { :yes => "yes", :no => "no", _ => "" } }
      })
    }

    h2 "Steps"
    wdoc_repeater { each = uc.steps  as = :st
      h3 $"Step ${st.n}${match st.title { none => "", ti => $": ${ti}" }}"
      project { from = st.bodies }
    }

    wdoc_repeater { each = match uc.outcome { none => [], v => [v] }  as = :v
      callout "Outcome" { class = ["success"]  body = $"${v}" }
    }
    edit_object { kind = "use_case"  target = $"${uc.id}" }
  }
}
WAD_WDOC_PAGES_PERSONAS_WCL
}

file "wdoc/pages/specs.wcl" {
  content = <<'WAD_WDOC_PAGES_SPECS_WCL'
// View 11 — Specs: change contracts grouped by status, one page per spec
// (metadata, affected nodes, the mechanical change list emitted by
// `wcl wad spec`, and the authored intent — the typed context /
// instructions / acceptance fields). Resolves the `let` helpers from
// wdoc/book/main.wcl.

let spec_groups = [
  { status: :in_progress, name: "In progress", class: "note" },
  { status: :blocked,     name: "Blocked",     class: "warning" },
  { status: :planning,    name: "Planning",    class: "note" },
  { status: :complete,    name: "Complete",    class: "success" },
  { status: :abandoned,   name: "Abandoned",   class: "warning" },
]
let specs_with = fn(s: SpecStatus) -> list<Spec> {
  filter(specs, fn(sp: Spec) -> bool { sp.status == s })
}
let spec_status_text = fn(s: SpecStatus) -> utf8 {
  match s { :planning => "Planning", :in_progress => "In progress", :blocked => "Blocked",
            :complete => "Complete", :abandoned => "Abandoned", _ => "Unknown" }
}
let spec_status_class = fn(s: SpecStatus) -> utf8 {
  match s { :complete => "success", :abandoned => "warning", :blocked => "warning", _ => "note" }
}

page specs_page { title = "Specs"
  h1 "Specs"
  p  "Work packages decomposed from this architecture: the implementation detail an AI coding agent needs to build part of the system, each carried through planning → in progress (or blocked) → complete (or abandoned). Seed one mechanically from a WAD diff with `wcl wad spec --from <rev>`; the intent — context, instructions, acceptance — is authored by whoever cuts the change."

  wdoc_repeater { each = match len(specs) { 0 => [true], _ => [] }  as = :_e
    p "_No specs recorded._"
  }
  wdoc_repeater { each = spec_groups  as = :g
    wdoc_repeater { each = match len(specs_with(g.status)) { 0 => [], _ => [true] }  as = :_h
      h2 $"${g.name}"
      table {
        header = ["Spec", "Created", "Updated", "Owner", "Affects"]
        rows = map(specs_with(g.status), fn(sp: Spec) -> list<utf8> {
          [$"[${sp.title}](spec_${sp.id})", sp.created, sp.updated ?? "—", sp.owner ?? "—",
           match len(sp.affected) { 0 => "—", _ => join(map(sp.affected, fn(aid: identifier) -> utf8 { link_of(aid) }), ", ") }]
        })
      }
    }
  }
}

// --- one page per spec ------------------------------------------------------------------
wdoc_repeater { each = specs  as = :sp
  page $"spec_${sp.id}" { title = $"${sp.title}"
    h1 $"${sp.title}"
    callout $"${spec_status_text(sp.status)}" {
      class = [spec_status_class(sp.status)]
      body  = $"Created ${sp.created}${match sp.updated { none => "", u2 => $" · updated ${u2}" }}${match sp.owner { none => "", o2 => $" · owner ${o2}" }}."
    }
    p $"_${sp.summary}_"
    wdoc_repeater { each = match len(sp.affected) { 0 => [], _ => [true] }  as = :_a
      p $"**Affects:** ${join(map(sp.affected, fn(aid: identifier) -> utf8 { link_of(aid) }), ", ")}"
    }
    wdoc_repeater { each = match sp.from_rev { none => [], rv => [rv] }  as = :rv
      p $"**Baseline revision:** `${rv}`"
    }

    wdoc_repeater { each = match sp.context { none => [], cx => [cx] }  as = :cx
      h2 "Context"
      p $"${cx}"
    }

    wdoc_repeater { each = match len(sp.changes) { 0 => [], _ => [true] }  as = :_c
      h2 "Changes"
      wdoc_repeater { each = sp.changes  as = :ch
        h3 $"`${ch.entity}` — ${match ch.op { :added => "added", :removed => "removed", _ => "modified" }}"
        wdoc_repeater { each = match ch.value { none => [], vx => [vx] }  as = :vx
          code wcl { source = vx }
        }
        wdoc_repeater { each = match len(ch.fields) { 0 => [], _ => [true] }  as = :_f
          table {
            header = ["Field", "Change", "Old", "New"]
            rows = map(ch.fields, fn(fc: FieldChange) -> list<utf8> {
              [$"`${fc.path}`", fc.kind, match fc.old { none => "—", ov => $"`${ov}`" }, match fc.new { none => "—", nv => $"`${nv}`" }]
            })
          }
        }
      }
    }

    wdoc_repeater { each = match len(sp.instructions) { 0 => [], _ => [true] }  as = :_i
      h2 "Instructions"
      list { style = :numbered
        items = map(sp.instructions, fn(t: utf8) -> Li { { text: t } })
      }
    }
    wdoc_repeater { each = match len(sp.acceptance) { 0 => [], _ => [true] }  as = :_ac
      h2 "Acceptance"
      list {
        items = map(sp.acceptance, fn(t: utf8) -> Li { { text: t } })
      }
    }

    wdoc_repeater { each = match sp.body { none => [], _ => [true] }  as = :_b
      project { from = sp.body }
    }

    wdoc_repeater { each = match sp.supersedes { none => [], sid => [sid] }  as = :sid
      wdoc_repeater { each = filter(specs, fn(x: Spec) -> bool { x.id == sid })  as = :prev
        p $"Supersedes [${prev.title}](spec_${prev.id})."
      }
    }
    wdoc_repeater { each = filter(specs, fn(x: Spec) -> bool { x.supersedes == sp.id })  as = :nxt
      p $"Superseded by [${nxt.title}](spec_${nxt.id})."
    }
    edit_object { kind = "spec"  target = $"${sp.id}" }
  }
}
WAD_WDOC_PAGES_SPECS_WCL
}

file "wdoc/pages/standards.wcl" {
  content = <<'WAD_WDOC_PAGES_STANDARDS_WCL'
// View 9 — Standards & rules: the standards the system is held to, grouped
// by kind, each with its enforceable rules. Resolves the `let` helpers from
// wdoc/book/main.wcl.

let standard_groups = [
  { kind: :coding,        name: "Coding" },
  { kind: :style,         name: "Style" },
  { kind: :business,      name: "Business" },
  { kind: :security,      name: "Security" },
  { kind: :process,       name: "Process" },
  { kind: :documentation, name: "Documentation" },
]
let standards_with = fn(k: StandardKind) -> list<Standard> {
  filter(standards, fn(st: Standard) -> bool { st.kind == k })
}

page standards_page { title = "Standards & rules"
  h1 "Standards & rules"
  p  "Coding standards, business rules, and style rules the system is held to — and what enforces each."

  wdoc_repeater { each = match len(standards) { 0 => [true], _ => [] }  as = :_e
    p "_No standards recorded._"
  }
  wdoc_repeater { each = standard_groups  as = :g
    wdoc_repeater { each = match len(standards_with(g.kind)) { 0 => [], _ => [true] }  as = :_h
      h2 $"${g.name}"
      wdoc_repeater { each = standards_with(g.kind)  as = :st
        p $"- [${st.title}](standard_${st.id}) — ${st.summary}"
      }
    }
  }
}

// --- one page per standard ----------------------------------------------------------
wdoc_repeater { each = standards  as = :st
  page $"standard_${st.id}" { title = $"${st.title}"
    h1 $"${st.title}"
    p  $"_${st.summary}_"

    wdoc_repeater { each = match len(st.rules) { 0 => [], _ => [true] }  as = :_r
      h2 "Rules"
      table {
        header = ["Rule", "Rationale", "Enforced by"]
        rows = map(st.rules, fn(ru: Rule) -> list<utf8> {
          [ru.text, ru.rationale ?? "—", ru.enforced_by ?? "—"]
        })
      }
    }

    wdoc_repeater { each = match st.body { none => [], _ => [true] }  as = :_b
      project { from = st.body }
    }
    edit_object { kind = "standard"  target = $"${st.id}" }
  }
}
WAD_WDOC_PAGES_STANDARDS_WCL
}

file "wdoc/pages/sysadmin.wcl" {
  content = <<'WAD_WDOC_PAGES_SYSADMIN_WCL'
// View 8 — System admin: standard operating procedures grouped by kind,
// one page per SOP with a step flowchart (wired by the sop's `from -> to`
// flow statements) above the step detail. Resolves the `let` helpers from
// wdoc/book/main.wcl.

let sop_groups = [
  { kind: :operations, name: "Operations" },
  { kind: :incident,   name: "Incident handling" },
  { kind: :change,     name: "Change management" },
  { kind: :release,    name: "Release" },
  { kind: :runbook,    name: "Automation runbooks" },
  { kind: :dev,        name: "Development" },
]
let sops_with = fn(k: SopKind) -> list<Sop> {
  filter(sops, fn(so: Sop) -> bool { so.kind == k })
}

page sysadmin_page { title = "System admin"
  h1 "System admin"
  p  "How the system is operated: standard procedures, incident and change handling, and automation runbooks."

  wdoc_repeater { each = match len(sops) { 0 => [true], _ => [] }  as = :_e
    p "_No procedures recorded._"
  }
  wdoc_repeater { each = sop_groups  as = :g
    wdoc_repeater { each = match len(sops_with(g.kind)) { 0 => [], _ => [true] }  as = :_h
      h2 $"${g.name}"
      wdoc_repeater { each = sops_with(g.kind)  as = :so
        p $"- [${so.title}](sop_${so.id}) — ${so.purpose}"
      }
    }
  }
}

// --- one page per SOP -------------------------------------------------------------
wdoc_repeater { each = sops  as = :so
  page $"sop_${so.id}" { title = $"${so.title}"
    h1 $"${so.title}"
    p  $"_${so.purpose}_"

    wdoc_repeater { each = match so.automation { none => [], au => [au] }  as = :au
      callout "Automated" { class = ["tip"]  body = $"This runbook is automated: ${au}" }
    }

    wdoc_repeater { each = match len(so.preconditions) { 0 => [], _ => [true] }  as = :_p
      h2 "Preconditions"
      wdoc_repeater { each = so.preconditions  as = :pc
        p $"- ${pc}"
      }
    }

    h2 "Flow"
    diagram {
      width = 560  height = len(so.steps) * 96 + 64
      layout = :layered  direction = :top_to_bottom  layer_gap = 28.0  node_gap = 32.0
      wdoc_repeater { each = so.steps  as = :st
        wdoc_repeater { each = match st.shape { :process => [true], _ => [] }  as = :_sh
          process $"${st.n}. ${st.title ?? ""}" { id = $"${st.id}"  width = 190.0  height = 46.0 } }
        wdoc_repeater { each = match st.shape { :decision => [true], _ => [] }  as = :_sh
          decision $"${st.title ?? ""}" { id = $"${st.id}"  width = 170.0  height = 72.0 } }
        wdoc_repeater { each = match st.shape { :terminator => [true], _ => [] }  as = :_sh
          terminator $"${st.title ?? ""}" { id = $"${st.id}"  width = 150.0  height = 46.0 } }
      }
      edges = map(so.flow, fn(e: StepFlow) -> Edge {
        { source: $"${e.source}", destination: $"${e.destination}",
          kind: :flow, label: match e.kind { :yes => "yes", :no => "no", _ => "" } }
      })
    }

    h2 "Steps"
    wdoc_repeater { each = so.steps  as = :st
      h3 $"Step ${st.n}${match st.title { none => "", ti => $": ${ti}" }}"
      project { from = st.bodies }
    }

    wdoc_repeater { each = match so.verification { none => [], v => [v] }  as = :v
      callout "Verification" { class = ["success"]  body = $"${v}" }
    }
    edit_object { kind = "sop"  target = $"${so.id}" }
  }
}
WAD_WDOC_PAGES_SYSADMIN_WCL
}

file "wdoc/pages/systems.wcl" {
  content = <<'WAD_WDOC_PAGES_SYSTEMS_WCL'
// View 4 — Systems: the C4 drill-down. A landing page, then one page per
// system (derived container diagram), per container (components, code items,
// deployments), per component (with its screens and their flow), per code
// item (renderer dispatched on its kind: module graph / db schema / class
// diagram / module api / api), and per screen. Resolves the `let` helpers
// from wdoc/book/main.wcl.

// Dependency edges for a code item's nodes (module graphs, class diagrams).
let dep_edges = fn(ci: CodeItem) -> list<Edge> {
  flatten(map(ci.nodes, fn(nd: CodeNode) -> list<Edge> {
    map(nd.deps, fn(d2: identifier) -> Edge { { source: nd.id, destination: d2 } })
  }))
}
// Row-level edges for a code item's module_api payload: a member's deps
// leave its own row (the port is the member id), landing on the whole
// target node_table.
let member_edges = fn(ci: CodeItem) -> list<Edge> {
  flatten(map(ci.nodes, fn(nd: CodeNode) -> list<Edge> {
    flatten(map(nd.rows, fn(m: CodeMember) -> list<Edge> {
      map(m.deps, fn(d2: identifier) -> Edge { { source: m.id, destination: d2 } })
    }))
  }))
}
// Foreign-key edges for a code item's db schema — row-level ports on both
// ends when the referenced column is named, the whole table otherwise.
let db_fk_edges = fn(ci: CodeItem) -> list<Edge> {
  flatten(map(ci.tables, fn(t: DbTable) -> list<Edge> {
    flatten(map(t.columns, fn(col: DbColumn) -> list<Edge> {
      match col.ref_table {
        none => [],
        rt => [{
          source: $"${t.id}_${col.name}",
          destination: match col.ref_column { none => $"${rt}", rc => $"${rt}_${rc}" },
          label: "fk",
        }],
      }
    }))
  }))
}
let screen_flow_edges = fn(scs: list<Screen>) -> list<Edge> {
  flatten(map(scs, fn(sc: Screen) -> list<Edge> {
    map(sc.nav_to, fn(t2: identifier) -> Edge { { source: sc.id, destination: t2 } })
  }))
}
let cli_commands_of = fn(coid: identifier) -> list<CliCommand> {
  filter(cli_commands, fn(c: CliCommand) -> bool { c.component == coid })
}
// Usage synopsis derived from the command's own args/flags.
let cli_usage = fn(c: CliCommand) -> utf8 {
  $"${c.name}${match len(c.flags) { 0 => "", _ => " [options]" }}${join(map(c.args, fn(a: CliArg) -> utf8 { $" ${a.name}" }), "")}"
}
// Component-level edges inside one container: relations whose endpoints are
// both components of that container (endpoints equal to the container id
// itself are the container's own relations, drawn a level up).
let comp_rels = fn(cid: identifier) -> list<RolledEdge> {
  map(filter(relations, fn(r: Relation) -> bool {
    r.source != cid && r.destination != cid && r.source != r.destination
      && owner_container(r.source) == cid && owner_container(r.destination) == cid
  }), fn(r: Relation) -> RolledEdge {
    { key: $"${r.source}|${r.destination}", source: r.source, destination: r.destination, label: rel_label(r) }
  })
}

page systems_page { title = "Systems"
  h1 "Systems"
  p  "The C4 drill-down: each system decomposes into containers (independently runnable units), components, and code-level artefacts. Drill into a system for its containers."
  wdoc_repeater { each = match len(systems) { 0 => [true], _ => [] }  as = :_e
    p "_No systems recorded._"
  }
  wdoc_repeater { each = match len(systems) { 0 => [], _ => [true] }  as = :_t
    table {
      header = ["System", "Summary"]
      rows = map(systems, fn(s: System) -> list<utf8> {
        [$"[${s.name}](system_${s.id})", s.summary]
      })
    }
  }
}

// --- one page per system ------------------------------------------------------
wdoc_repeater { each = systems  as = :s
  page $"system_${s.id}" { title = $"${s.name}"
    h1 $"${s.name}"
    p  $"_${s.summary}_"
    wdoc_repeater { each = match s.owner { none => [], o => [o] }  as = :o
      p $"**Owner:** ${stakeholder_names([o])}"
    }
    wdoc_repeater { each = match len(s.repos) { 0 => [], _ => [true] }  as = :_r
      p $"**Repositories:** ${join(map(s.repos, fn(rid: identifier) -> utf8 { link_of(rid) }), ", ")}"
    }
    wdoc_repeater { each = match s.body { none => [], _ => [true] }  as = :_b
      project { from = s.body }
    }

    // A system with no containers (a small deliverable that needs no
    // drill-down) skips the container diagram rather than drawing empty.
    wdoc_repeater { each = match len(containers_of(s.id)) { 0 => [], _ => [true] }  as = :_cd
      h2 "Containers"
      diagram { width = 960  height = 560  layout = :layered  direction = :left_to_right
        layer_gap = 90.0  node_gap = 40.0  pan_zoom = true
        desc = $"Container diagram for ${s.name}"
        wdoc_repeater { each = containers_of(s.id)  as = :c
          card { id = c.id  title = c.name  width = 190.0  height = 105.0
            text $"${c.summary} [Details](container_${c.id})"
          }
        }
        // Non-persona neighbours draw as dashed cards; personas draw as
        // icon'd actors, matching the context diagram.
        wdoc_repeater { each = filter(sys_neighbors(s.id), fn(nb: NodeRef) -> bool { nb.level != "persona" })  as = :nb
          card { id = nb.id  title = nb.name  width = 170.0  height = 70.0  class = ["wad-external"]
            text $"${nb.level} — ${link_of(nb.id)}"
          }
        }
        wdoc_repeater { each = filter(sys_neighbors(s.id), fn(nb: NodeRef) -> bool { nb.level == "persona" })  as = :nb
          process $"${nb.name}" { id = nb.id  width = 140.0  height = 60.0
            icon = "lucide.user"  link = $"persona_${nb.id}"
          }
        }
        boundary $"${s.name}" {
          members = map(containers_of(s.id), fn(c: Container) -> identifier { c.id })
        }
        edges = dedup_edges(sys_rolled(s.id))
      }
    }
    edit_object { kind = "system"  target = $"${s.id}" }
  }
}

// --- one page per container ---------------------------------------------------
wdoc_repeater { each = containers  as = :c
  page $"container_${c.id}" { title = $"${c.name}"
    h1 $"${c.name}"
    p  $"_${c.summary}_"
    table {
      rows = [
        ["System", link_of(c.system)],
        ["Kind", $"${c.kind}"],
        ["Technology", c.technology ?? "—"],
        ["Repository", match c.repo { none => "—", rid => link_of(rid) }],
      ]
    }
    wdoc_repeater { each = match c.body { none => [], _ => [true] }  as = :_b
      project { from = c.body }
    }

    wdoc_repeater { each = match len(filter(deploy_targets, fn(dt: DeployTarget) -> bool { dt.container == c.id })) { 0 => [], _ => [true] }  as = :_d
      h2 "Deployments"
      table {
        header = ["Environment", "Runs on", "Replicas", "URL"]
        rows = map(filter(deploy_targets, fn(dt: DeployTarget) -> bool { dt.container == c.id }),
                   fn(dt: DeployTarget) -> list<utf8> {
          [link_of(dt.environment), name_of(dt.infra_node),
           match dt.replicas { none => "—", n2 => $"${n2}" }, dt.url ?? "—"]
        })
      }
    }

    wdoc_repeater { each = match len(components_of(c.id)) { 0 => [], _ => [true] }  as = :_c
      h2 "Components"
      // The C4 level-3 picture: every component inside the container's
      // boundary. Grid-placed (component relations are rare, so a flow
      // layout would stack them in one column); any component-level
      // relations still draw as edges.
      diagram { width = 960  height = 460
        layout = :grid  columns = 3  cell_width = 250.0  cell_height = 110.0  gap = 28.0
        pan_zoom = true
        desc = $"Component diagram for ${c.name}"
        wdoc_repeater { each = components_of(c.id)  as = :co
          card { id = co.id  title = co.name  width = 250.0  height = 110.0
            text $"${co.summary} [Details](component_${co.id})"
          }
        }
        boundary $"${c.name}" {
          members = map(components_of(c.id), fn(co: Component) -> identifier { co.id })
          padding = 28.0
        }
        edges = dedup_edges(comp_rels(c.id))
      }
    }

    // Container-attached code items (crate-level module graphs etc.) render
    // inline here, like component-attached ones do on component pages.
    wdoc_repeater { each = code_items_of(c.id)  as = :ci
      h2 $"[${ci.name}](code_${ci.id})"
      wdoc_repeater { each = match ci.summary { none => [], sx => [sx] }  as = :sx
        p $"_${sx}_"
      }
      code_item_view { ci = ci }
    }

    wdoc_repeater { each = match len(screens_of(c.id)) { 0 => [], _ => [true] }  as = :_s
      h2 "Screens"
      wdoc_repeater { each = screens_of(c.id)  as = :sc
        p $"- [${sc.name}](screen_${sc.id})${match sc.summary { none => "", sx => $" — ${sx}" }}"
      }
    }

    wdoc_repeater { each = match len(rels_touching([c.id])) { 0 => [], _ => [true] }  as = :_r
      h2 "Relations"
      table {
        header = ["From", "Relation", "To", "Protocol", "Data"]
        rows = rel_rows(rels_touching([c.id]))
      }
    }
    edit_object { kind = "container"  target = $"${c.id}" }
  }
}

// --- one page per component ---------------------------------------------------
wdoc_repeater { each = sw_components  as = :co
  page $"component_${co.id}" { title = $"${co.name}"
    h1 $"${co.name}"
    p  $"_${co.summary}_"
    table {
      rows = [
        ["Container", link_of(co.container)],
        ["Kind", co.kind ?? "—"],
        ["Technology", co.technology ?? "—"],
      ]
    }
    wdoc_repeater { each = match co.body { none => [], _ => [true] }  as = :_b
      project { from = co.body }
    }
    // A command-line surface documents itself as `cli_command` blocks,
    // rendered API-docs style by cli_command_view.
    wdoc_repeater { each = match len(cli_commands_of(co.id)) { 0 => [], _ => [true] }  as = :_cl
      h2 "Commands"
      wdoc_repeater { each = cli_commands_of(co.id)  as = :c
        cli_command_view { c = c }
      }
    }
    // Code items live at component level: each renders its diagram right
    // here (the heading link drills into the code item's own page).
    wdoc_repeater { each = code_items_of_comp(co.id)  as = :ci
      h2 $"[${ci.name}](code_${ci.id})"
      wdoc_repeater { each = match ci.summary { none => [], sx => [sx] }  as = :sx
        p $"_${sx}_"
      }
      code_item_view { ci = ci }
    }
    // Screens attach at component level — the flow chart of this
    // component's screens draws here, not on the system page.
    wdoc_repeater { each = match len(screens_of_comp(co.id)) { 0 => [], _ => [true] }  as = :_s
      h2 "Screens"
      diagram { width = 860  height = 380  layout = :layered  direction = :left_to_right  pan_zoom = true
        wdoc_repeater { each = screens_of_comp(co.id)  as = :sc
          card { id = sc.id  title = sc.name  width = 180.0  height = 80.0
            text $"${sc.summary ?? ""} [Open](screen_${sc.id})"
          }
        }
        edges = screen_flow_edges(screens_of_comp(co.id))
      }
    }
    edit_object { kind = "component"  target = $"${co.id}" }
  }
}

// --- CLI command rendering --------------------------------------------------------
// One `cli_command` rendered like API docs: heading, summary, usage
// synopsis, argument and flag tables. The blocks are the data — never
// document a CLI as prose paragraphs.
wdoc_component cli_command_view {
  wdoc_slot c
  wdoc_body {
    h3 $"`${c.name}`"
    p  $"${c.summary}"
    code "text" { source = cli_usage(c) }
    wdoc_repeater { each = match len(c.aliases) { 0 => [], _ => [true] }  as = :_al
      p $"**Aliases:** ${join(map(c.aliases, fn(a2: utf8) -> utf8 { $"`${a2}`" }), ", ")}"
    }
    wdoc_repeater { each = match c.description { none => [], dx => [dx] }  as = :dx
      p $"${dx}"
    }
    // Each table carries a label paragraph — it names the section AND keeps
    // consecutive tables from sitting flush against each other.
    wdoc_repeater { each = match len(c.args) { 0 => [], _ => [true] }  as = :_ar
      p "**Arguments**"
      table {
        header = ["Argument", "", "Description"]
        rows = map(c.args, fn(a: CliArg) -> list<utf8> {
          [$"`${a.name}`", match a.required { true => "required", _ => "optional" }, a.description]
        })
      }
    }
    wdoc_repeater { each = match len(c.flags) { 0 => [], _ => [true] }  as = :_fl
      p "**Flags**"
      table {
        header = ["Flag", "Default", "Description"]
        rows = map(c.flags, fn(f2: CliFlag) -> list<utf8> {
          [$"`${f2.name}${match f2.value { none => "", v2 => $" ${v2}" }}`${match f2.repeatable { true => " _(repeatable)_", _ => "" }}",
           f2.default ?? "—", f2.description]
        })
      }
    }
    wdoc_repeater { each = match len(c.examples) { 0 => [], _ => [true] }  as = :_ex
      p "**Examples**"
      wdoc_repeater { each = c.examples  as = :ex
        code "bash" { source = ex.command }
        wdoc_repeater { each = match ex.description { none => [], dx2 => [dx2] }  as = :dx2
          p $"${dx2}"
        }
      }
    }
    wdoc_repeater { each = match c.body { none => [], _ => [true] }  as = :_b
      project { from = c.body }
    }
  }
}

// --- code item payload rendering (shared) ---------------------------------------
// Kind-dispatched rendering of one code item's payload. Instantiated on the
// owning component's page (the drill-in view) AND on the code item's own
// page, so both stay identical.
wdoc_component code_item_view {
  wdoc_slot ci
  wdoc_body {
    // :module_graph — layered dependency diagram over the code nodes.
    wdoc_repeater { each = match ci.kind { :module_graph => [true], _ => [] }  as = :_mg
      diagram { width = 940  height = 520  layout = :layered  layer_gap = 70.0  node_gap = 34.0  pan_zoom = true
        wdoc_repeater { each = ci.nodes  as = :nd
          process $"${nd.name}" { id = nd.id  width = 170.0  height = 56.0 }
        }
        edges = dep_edges(ci)
      }
      wdoc_repeater { each = filter(ci.nodes, fn(nd: CodeNode) -> bool { nd.summary != none })  as = :nd
        p $"- **${nd.name}**${match nd.summary { none => "", sx => $" — ${sx}" }}"
      }
    }

    // :db_schema — node_table per table, FK edges on row-level ports.
    wdoc_repeater { each = match ci.kind { :db_schema => [true], _ => [] }  as = :_db
      diagram { width = 940  height = 560  layout = :force  link_distance = 200.0  pan_zoom = true
        wdoc_repeater { each = ci.tables  as = :t
          node_table { id = t.id  title = t.name ?? $"${t.id}"  width = 220.0
            wdoc_repeater { each = t.columns  as = :col
              node_row { id = $"${t.id}_${col.name}"
                text $"${match col.pk { true => "🔑 ", _ => "" }}${col.name}: `${col.type}`${match col.nullable { true => "?", _ => "" }}"
              }
            }
          }
        }
        edges = db_fk_edges(ci)
      }
    }

    // :class_diagram — node_table per class, member rows, dep edges.
    wdoc_repeater { each = match ci.kind { :class_diagram => [true], _ => [] }  as = :_cd
      diagram { width = 940  height = 560  layout = :force  link_distance = 220.0  pan_zoom = true
        wdoc_repeater { each = ci.nodes  as = :nd
          node_table { id = nd.id  title = nd.name  width = 230.0
            wdoc_repeater { each = nd.members  as = :m
              node_row { text $"`${m}`" }
            }
          }
        }
        edges = dep_edges(ci)
      }
    }

    // :module_api — node_table per type (struct/enum/trait/fns), one row per
    // member signature; a row is an edge port, so signature type-references
    // draw from the exact member to the type it mentions.
    wdoc_repeater { each = match ci.kind { :module_api => [true], _ => [] }  as = :_ma
      diagram { width = 960  height = 640  layout = :force  link_distance = 260.0  repulsion = 16000.0  pan_zoom = true
        wdoc_repeater { each = ci.nodes  as = :nd
          node_table { id = nd.id  width = 280.0
            title = $"${nd.name}${match nd.kind { none => "", k2 => $" «${k2}»" }}"
            wdoc_repeater { each = nd.rows  as = :m
              node_row { id = m.id  text $"`${m.signature}`" }
            }
          }
        }
        edges = flatten([dep_edges(ci), member_edges(ci)])
      }
      wdoc_repeater { each = filter(ci.nodes, fn(nd: CodeNode) -> bool { nd.summary != none })  as = :nd
        p $"- **${nd.name}**${match nd.summary { none => "", sx => $" — ${sx}" }}"
      }
    }

    // :api — the endpoint index, then one swagger-style detail section per
    // endpoint that carries any depth (description, auth, params, bodies).
    wdoc_repeater { each = match ci.kind { :api => [true], _ => [] }  as = :_api
      table {
        header = ["Method", "Path", "Summary"]
        rows = map(ci.endpoints, fn(ep: ApiEndpoint) -> list<utf8> {
          [$"`${ep.method}`", $"`${ep.path}`", ep.summary]
        })
      }
      wdoc_repeater { each = filter(ci.endpoints, fn(ep: ApiEndpoint) -> bool {
          ep.description != none || ep.auth != none || ep.request != none
            || ep.response != none || len(ep.params) > 0 || len(ep.responses) > 0
        })  as = :ep
        h3 $"`${ep.method} ${ep.path}`"
        p  $"${ep.summary}"
        wdoc_repeater { each = match ep.description { none => [], dx => [dx] }  as = :dx
          p $"${dx}"
        }
        wdoc_repeater { each = match ep.auth { none => [], au => [au] }  as = :au
          p $"**Auth:** ${au}"
        }
        wdoc_repeater { each = match len(ep.params) { 0 => [], _ => [true] }  as = :_pp
          table {
            header = ["Parameter", "In", "Type", "", "Description"]
            rows = map(ep.params, fn(pa: ApiParam) -> list<utf8> {
              [$"`${pa.name}`", $"${pa.location}", pa.type ?? "—",
               match pa.required { true => "required", _ => "optional" },
               $"${pa.description ?? ""}${match pa.example { none => "", ex => $" — e.g. `${ex}`" }}"]
            })
          }
        }
        wdoc_repeater { each = match ep.request { none => [], rq => [rq] }  as = :rq
          p $"**Request body${match ep.request_media_type { none => "", mt => $" (`${mt}`)" }}:**"
          code "json" { source = rq }
        }
        wdoc_repeater { each = match len(ep.responses) { 0 => [], _ => [true] }  as = :_rr
          table {
            header = ["Status", "Media type", "Description"]
            rows = map(ep.responses, fn(rs: ApiResponse) -> list<utf8> {
              [$"`${rs.status}`", rs.media_type ?? "—", rs.description]
            })
          }
          wdoc_repeater { each = filter(ep.responses, fn(rs: ApiResponse) -> bool { rs.schema != none })  as = :rs
            p $"**${rs.status} body:**"
            code "json" { source = rs.schema ?? "" }
          }
        }
        wdoc_repeater { each = match ep.response { none => [], rs2 => [rs2] }  as = :rs2
          p $"**Response:** ${rs2}"
        }
      }
    }
  }
}

// --- one page per code item -------------------------------------------------------
wdoc_repeater { each = code_items  as = :ci
  page $"code_${ci.id}" { title = $"${ci.name}"
    h1 $"${ci.name}"
    wdoc_repeater { each = match ci.summary { none => [], sx => [sx] }  as = :sx
      p $"_${sx}_"
    }
    code_item_view { ci = ci }
    wdoc_repeater { each = match ci.body { none => [], _ => [true] }  as = :_b
      project { from = ci.body }
    }
    edit_object { kind = "code_item"  target = $"${ci.id}" }
  }
}

// --- one page per screen --------------------------------------------------------
wdoc_repeater { each = screens  as = :sc
  page $"screen_${sc.id}" { title = $"${sc.name}"
    h1 $"${sc.name}"
    wdoc_repeater { each = match sc.summary { none => [], sx => [sx] }  as = :sx
      p $"_${sx}_"
    }
    table {
      rows = [
        ["Component", match sc.component { none => "—", coid => link_of(coid) }],
        ["Container", match sc.container { none => "—", cid => link_of(cid) }],
        ["Route", match sc.route { none => "—", rt => $"`${rt}`" }],
        ["Used by", match len(sc.personas) { 0 => "—", _ => join(map(sc.personas, fn(pid: identifier) -> utf8 { link_of(pid) }), ", ") }],
      ]
    }
    wdoc_repeater { each = match sc.body { none => [], _ => [true] }  as = :_b
      project { from = sc.body }
    }
    wdoc_repeater { each = match len(sc.nav_to) { 0 => [], _ => [true] }  as = :_n
      h2 "Navigates to"
      wdoc_repeater { each = sc.nav_to  as = :t2
        p $"- ${link_of(t2)}"
      }
    }
    edit_object { kind = "screen"  target = $"${sc.id}" }
  }
}
WAD_WDOC_PAGES_SYSTEMS_WCL
}

file "scripts/README.md" {
  when    = answer("include_extractors") == "yes"
  content = <<'WAD_SCRIPTS_README_MD'
# scripts/ — WAD extractors

Standalone Python scripts that read a live source of truth (the build system,
CI config, a database, an API) and write WCL data files into
`../data/generated/`. Run them all with `just extract`, or one at a time with
`uv run scripts/<name>.py`.

## The conventions (every extractor follows these)

1. **uv single-file scripts.** Shebang `#!/usr/bin/env -S uv run` plus a
   [PEP 723](https://peps.python.org/pep-0723/) inline-metadata header:

   ```python
   # /// script
   # requires-python = ">=3.11"
   # dependencies = ["pyyaml>=6"]
   # ///
   ```

   Self-contained on purpose: each script carries its own ~20-line WCL-emit
   helper rather than importing a shared module — copy it into new scripts.

2. **One script, one output file.** `extract_repo.py` owns
   `data/generated/repo.wcl` — nothing else writes it, and it writes nothing
   else. Re-running is always a **full overwrite**, never an append or merge.

3. **A generated banner, always first:**

   ```
   // GENERATED by scripts/extract_repo.py — do not hand-edit; re-run `just extract`.
   // Source: git remote + top-level tree
   ```

4. **Deterministic output.** No timestamps; sort every collection. A re-run
   with an unchanged source must be byte-identical, so `git status` stays
   quiet and `wcl diff` (the spec workflow) sees only real changes.

5. **Stable ids derived from source names.** Hand-authored data may
   *reference* generated ids but must never reuse them.

6. **Empty result still writes the file** (banner + `namespace` line), so the
   committed import line never dangles.

7. **Output must pass `wcl check`.** `just extract` chains into `wad-check`;
   a broken emitter is a broken run.

8. **Generated files are committed.** The diff→spec workflow materialises old
   git revisions; uncommitted generated data would vanish from the old side
   of every diff.

## Writing a new extractor

Start from `extract_repo.py`. The shape is always:

1. locate the WAD root (`Path(__file__).resolve().parents[1]`) and the source
   of truth relative to it;
2. read the source (subprocess, file parse, DB query, HTTP call — uv deps
   make any of these one line of metadata);
3. map source records onto WAD block kinds (relations, pipelines, code_items,
   domain_objects, infra_nodes…), with a small in-script table for anything
   that needs human naming (e.g. crate → container id);
4. render WCL text with the emit helper and overwrite the output file, then
   add the one import line in `data/generated/main.wcl`.

This scaffold ships two starters: `extract_repo.py` (git remote + top-level
tree → repository) and `extract_releases.py` (git tags → the releases table).
The reference WAD in the WCL repository ships two more worked examples:
`extract_cargo.py` (cargo metadata → container relations + a crate module
graph) and `extract_ci.py` (workflow YAML → pipeline stages).
WAD_SCRIPTS_README_MD
}

file "scripts/extract_repo.py" {
  when    = answer("include_extractors") == "yes"
  content = <<'WAD_SCRIPTS_EXTRACT_REPO_PY'
#!/usr/bin/env -S uv run
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Extract repository facts (git remote, top-level layout) into
data/generated/repo.wcl — the generic starter extractor. Adapt it, or copy
its shape for your own extractors."""

import subprocess
import sys
from pathlib import Path

WAD_ROOT = Path(__file__).resolve().parents[1]
OUT = WAD_ROOT / "data" / "generated" / "repo.wcl"

# Top-level entries that say nothing about the architecture.
SKIP = {".git", ".github", "target", "node_modules", "_site", "_md", "out", ".venv"}

# Path -> human description. Extend THIS table (never the generated file) to
# describe what lives where.
PATH_DESCRIPTIONS: dict[str, str] = {}


def wcl_str(s: str) -> str:
    """Quote a Python string as a WCL string literal."""
    out = s.replace("\\", "\\\\").replace('"', '\\"')
    out = out.replace("\n", "\\n").replace("\t", "\\t").replace("\r", "\\r")
    return f'"{out}"'


def git(*args: str) -> str:
    return subprocess.run(
        ["git", *args], cwd=WAD_ROOT, check=True, capture_output=True, text=True
    ).stdout.strip()


def main() -> int:
    try:
        repo_root = Path(git("rev-parse", "--show-toplevel"))
    except subprocess.CalledProcessError:
        print("not inside a git repository — writing the empty placeholder", file=sys.stderr)
        OUT.write_text(
            "// GENERATED by scripts/extract_repo.py — do not hand-edit; re-run `just extract`.\n"
            "// Source: git remote + top-level tree (no repository found)\n"
            "namespace wcl.wad\n"
        )
        return 0
    try:
        url = git("remote", "get-url", "origin")
    except subprocess.CalledProcessError:
        url = str(repo_root)
    name = url.rstrip("/").split("/")[-1].removesuffix(".git") or repo_root.name
    rid = "repo_" + "".join(c if c.isalnum() else "_" for c in name)

    lines = [
        "// GENERATED by scripts/extract_repo.py — do not hand-edit; re-run `just extract`.",
        "// Source: git remote + top-level tree",
        "namespace wcl.wad",
        "",
        f"repository {rid} {{",
        f"  name = {wcl_str(name)}",
        f"  url  = {wcl_str(url)}",
        '  summary = "Extracted from the git remote and top-level tree; describe paths via PATH_DESCRIPTIONS in scripts/extract_repo.py."',
    ]
    for entry in sorted(p.name for p in repo_root.iterdir() if p.is_dir() and p.name not in SKIP):
        pid = "rp_" + "".join(c if c.isalnum() else "_" for c in entry)
        desc = PATH_DESCRIPTIONS.get(entry, "(map this path in extract_repo.py's PATH_DESCRIPTIONS)")
        lines += [
            f"  repo_path {pid} {{",
            f"    path = {wcl_str(entry + '/')}",
            f"    description = {wcl_str(desc)}",
            "  }",
        ]
    lines += ["}", ""]
    OUT.write_text("\n".join(lines))
    print(f"wrote {OUT.relative_to(WAD_ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
WAD_SCRIPTS_EXTRACT_REPO_PY
}
