// The `wskill` built-in template: scaffold a single wskill — a WCL document
// format that captures a topic completely and projects it into a book and a
// Claude Code skill. Ported from the wskill project's scaffold tree; the
// schema and wdoc templates are emitted verbatim (raw heredocs), the topic
// metadata / README / justfile via ${answer(...)} substitution.
//
//   wcl init wskill ./my-topic

import <scaffold.wcl>

property "topic_id" {
  prompt  = "Topic id (an identifier, e.g. ls)"
  default = "topic"
}

property "topic_name" {
  prompt  = "Topic name"
  default = "Topic"
}

property "topic_summary" {
  prompt  = "One-line summary"
  default = "A wskill."
}

property "date" {
  prompt  = "Created (YYYY-MM-DD)"
  default = "1970-01-01"
}

property "include_presentation" {
  prompt  = "Ship a presentation view — an overview deck? (yes/no)"
  default = "no"
}

property "include_training" {
  prompt  = "Ship a training view — a hands-on tutorial series? (yes/no)"
  default = "no"
}

file ".gitignore" {
  content = <<'WSK__GITIGNORE'
# Generated projections — regenerate with `just render`.
# Delete these lines if you want to commit the rendered outputs.
/out/
WSK__GITIGNORE
}

file "README.md" {
  content = $<<WSK_README_MD
# ${answer("topic_name")} — wskill

A **wskill**: one self-contained folder capturing everything about *${answer("topic_name")}*
— reference, processes, and curated indexes — as a single WCL data model, projected into
a human-readable book and a Claude Code skill (plus optional presentation-deck and
training-course views).

## Layout

```
wskill.wcl            # entry point: topic, version pin, meta, sources, data imports
schema/base.wcl       # base block types (DO NOT hand-edit)
schema/kinds.wcl      # topic-owned vocabularies (entity kinds, …) — extend freely
schema/extensions.wcl # custom block types for this topic
data/                 # the content: reference / processes / presentation / training
assets/               # images, PDFs, data files referenced by pages (see assets/README.md)
wdoc/                 # projection templates (no content — pure structure):
                      #   book, skill, presentation (deck), training (tutorial book)
out/                  # generated outputs (gitignored)
```

## Build

```bash
just                 # list recipes
just wskill-check    # validate against the schema
just render          # build out/book (site) and out/skill (SKILL.md + references)
just book-serve      # live-preview the book
```

Install the rendered skill into a repo by copying it:

```bash
cp -r out/skill <repo>/.claude/skills/<name>
```

## Editing

Add content by writing block instances into `data/`. The templates project them
automatically — never hand-edit `out/`. Keep `wskill-check` green and re-render
after changes.
WSK_README_MD
}

file "assets/README.md" {
  content = <<'WSK_ASSETS_README_MD'
# assets/

Static files used by this wskill's pages — images, PDFs, datasets, and any other
data file you want to reference from content.

Both projection entry points live at `wdoc/<book|skill>/main.wcl`, so this
wskill-root `assets/` folder is reachable from either as `../../assets/…`. Content
bodies (shared by both projections) reference it with the same path.

## Images

Embed an image in any `body { … }` (concept / entity / fact / process / index) or
page. The source resolves relative to the build entry file and is copied into the
output automatically:

```wcl
image "../../assets/diagram.png" { alt = "Architecture diagram"  width = 640 }
```

## PDFs and other data files

Ship an arbitrary file (PDF, JSON, CSV, …) into the output with the `file` block.
`dir` names the output subfolder; `as` renders a download link (omit `as` to ship
it silently and link it yourself):

```wcl
file "../../assets/report.pdf" { dir = "files"  as = "Download the report (PDF)" }
```

This folder is not generated output — commit the files you add here.
WSK_ASSETS_README_MD
}

file "data/processes/processes.wcl" {
  content = $<<WSK_DATA_PROCESSES_PROCESSES_WCL
// Processes for ${answer("topic_name")} — runbooks for *doing* a specific task. Written
// for someone who already knows the topic and needs the reliable sequence.
//
// Each step stores two addressable body fragments: `body screen { … }` (what's on
// screen — a single code/callout/image box) and `body steps { … }` (the action). The
// book lays the step number in a gutter beside the title, with the two fragments
// projected stacked below, in order.
//
//   procedure <id> {
//     title   = "…"
//     purpose = "…"
//     preconditions = ["…"]
//     step first { n = 1
//       title = "Optional step title"
//       body screen { code "bash" { source = "command --here" } }
//       body steps  { p "Do this." }
//     }
//     step second { n = 2
//       body steps { p "Then do this." }
//     }
//     first -> second              // flow edge (add `:yes` / `:no` to label a branch)
//     verification = "How you know it worked."
//   }
WSK_DATA_PROCESSES_PROCESSES_WCL
}

file "data/reference/reference.wcl" {
  content = $<<WSK_DATA_REFERENCE_REFERENCE_WCL
// Reference content for ${answer("topic_name")}: concepts, entities, facts,
// terms and examples. Split into more files under data/reference/
// as this grows (add an import line in wskill.wcl per new file). For tables or any
// other topic-specific shape, declare a typed block in schema/extensions.wcl.
//
// Block forms (all fields beyond the required ones are optional):
//
// concept / entity / fact are the three interlinking units. Each is a thin record
// plus an addressable `body { … }` of wdoc blocks (paragraphs, tables, code, links)
// that rides on the record and is projected onto its own page. `related` lists other
// unit ids (any kind — ids are unique across them), resolved to links.
//
//   concept <id> {
//     name = "…"  summary = "…"  related = [other_unit]
//     body { p "The body — paragraphs, tables, links." }
//   }
//
//   entity <id> {                    // reserved for concrete NAMED things
//     name = "…"  kind = :software  summary = "…"  related = [other_unit]
//     // kind is a closed vocabulary — see schema/kinds.wcl (extend it there)
//     body {
//       table { header = ["Attribute", "Value"]  rows = [["key", "value"]] }
//     }
//   }
//
//   fact <id> {                       // a container of factual data
//     title = "…"  related = [other_unit]
//     body { table { header = ["…"]  rows = [["…"]] } }
//   }
//   term <id>      { term = "…"  definition = "…"  aliases = ["…"] }
//   example <id>   { title = "…"  unit = <concept/entity/fact id>  // renders on that unit's page
//                    narrative = "…"  code_lang = "bash"
//                    code = <<'SH'
//   …
//   SH
//                    expected = "…" }
WSK_DATA_REFERENCE_REFERENCE_WCL
}

file "data/presentation/main.wcl" {
  when    = answer("include_presentation") == "yes"
  content = <<'WSK_DATA_PRESENTATION_MAIN_WCL'
// The presentation view's deck — the topic's introduction as slides
// (schema/presentation.wcl). Author ONE `presentation` block; each
// `pres_section` is a deck column, each `pres_slide` one slide. A slide that
// names a `unit` pulls that concept/entity/fact/procedure's headline + summary
// onto the slide; `body` holds extra wdoc blocks; `speaker_notes` shows in the
// presenter's notes overlay (toggle with `s`). Ship the view by uncommenting
// the `artifact slides { … }` line in wskill.wcl and rendering with
// `just presentation-build`.
//
// presentation intro {
//   summary = "One-line deck subtitle (falls back to the topic summary)."
//   pres_section first {
//     title = "Section title"
//     pres_slide opening {
//       unit = some_concept              // pull headline + summary from a unit
//       speaker_notes = "What to say while this slide is up."
//     }
//     pres_slide detail {
//       title = "Explicit slide title"
//       body {
//         p "- bullet one"
//         p "- bullet two"
//       }
//     }
//   }
// }
WSK_DATA_PRESENTATION_MAIN_WCL
}

file "data/training/main.wcl" {
  when    = answer("include_training") == "yes"
  content = <<'WSK_DATA_TRAINING_MAIN_WCL'
// The training view's course — an ordered tutorial series
// (schema/training.wcl). Author `lesson` blocks (grouped into `module`s when
// the course has parts); lessons order by `n`, link back to the reference
// units they teach via `related`, and end with hands-on `exercise`s whose
// `expected` result lets the learner verify their work. Ship the view by
// uncommenting the `artifact training { … }` line in wskill.wcl and rendering
// with `just training-build`.
//
// lesson getting_started {
//   n       = 1
//   title   = "Getting started"
//   summary = "What the learner can do after this lesson."
//   objectives    = ["First capability", "Second capability"]
//   related       = [some_concept]      // reference units this lesson teaches
//   body { p "The lesson material — any wdoc blocks." }
//   exercise try_it {
//     title     = "Try it"
//     task      = "What to do, imperatively."
//     code_lang = "bash"
//     code      = "echo hello"
//     expected  = "How the learner knows it worked."
//     hint      = "A nudge for when they get stuck."
//   }
// }
//
// lesson next_steps {
//   n             = 2
//   title         = "Next steps"
//   prerequisites = [getting_started]   // lesson ids to complete first
//   body { p "Builds on lesson 1." }
// }
WSK_DATA_TRAINING_MAIN_WCL
}

file "justfile" {
  content = $<<WSK_JUSTFILE
# ${answer("topic_name")} wskill — build recipes.
#
# Self-contained: uses the `wcl` CLI directly, so this wskill stands alone. Install
# the rendered skill by copying out/skill into a repo's .claude/skills/<name>/.

[default, private]
main:
	@just --list

# Validate the wskill model and every projection template against the schema
[group('check')]
wskill-check:
	wcl check wskill.wcl
	wcl check wdoc/book/main.wcl
	wcl check wdoc/skill/main.wcl
	@[ ! -f wdoc/presentation/main.wcl ] || wcl check wdoc/presentation/main.wcl
	@[ ! -f wdoc/training/main.wcl ] || wcl check wdoc/training/main.wcl

# Render the human-readable book projection to out/book
[group('render')]
book-build: wskill-check
	wcl wdoc build wdoc/book/main.wcl --out out/book

# Render the Claude Code skill projection to out/skill
[group('render')]
skill-build: wskill-check
	wcl wdoc skill wdoc/skill/main.wcl --out out/skill

# Render the presentation (overview deck) projection to out/presentation
[group('render')]
presentation-build: wskill-check
	wcl wdoc build wdoc/presentation/main.wcl --out out/presentation

# Render the training (tutorial series) projection to out/training
[group('render')]
training-build: wskill-check
	wcl wdoc build wdoc/training/main.wcl --out out/training

# Render every shipped projection
[group('render')]
render: book-build skill-build${match answer("include_presentation") { "yes" => " presentation-build", _ => "" }}${match answer("include_training") { "yes" => " training-build", _ => "" }}

# Serve the book projection with live reload
[group('render')]
book-serve:
	wcl wdoc serve wdoc/book/main.wcl

# Remove generated output
[group('clean')]
out-clean:
	rm -rf out
WSK_JUSTFILE
}

file "schema/base.wcl" {
  content = <<'WSK_SCHEMA_BASE_WCL'
// wskill base schema — ships with the WSKILL skill scaffold.
//
// Schema version: 1.0.0 (mirror it in `schema_version` in wskill.wcl).
//
// DO NOT HAND-EDIT. Everything topic-specific belongs in `extensions.wcl`, and
// the topic-owned vocabularies (entity kinds, artifact kinds) in `kinds.wcl` —
// that file IS hand-editable. This file is versioned with the WSKILL skill;
// upgrade procedures live in the skill's references. It defines the base block
// types (the wskill data model) and the root @document that gathers every
// block instance so the wdoc template sets can project over them.
//
// The schema travels with the document: a wskill folder is fully interpretable
// (lint + render) without the WSKILL skill present.
//
// Field decorators (@default, @inline, @child, @children) are PREFIX — they sit
// before the field they describe.
//
// All wskill declarations live in the `wcl.wskill` namespace. Importers (the root
// wskill.wcl, data files, wdoc templates) keep using bare names — a relative import
// auto-joins this namespace to the bare-name search path — and a name can be
// qualified (`wcl.wskill::concept`) when it would otherwise be ambiguous.
namespace wcl.wskill

import <wdoc.wcl>
import "./kinds.wcl"     // topic-owned vocabularies (EntityKind, ArtifactKind)

// ---------------------------------------------------------------------------
// Shared row types
// ---------------------------------------------------------------------------

// Key/value attribute row — used by `entity.attributes` and `custom.attrs`.
// Authorable with WCL pipe-table syntax:
//   attributes:
//     | "flag" | "-l" |
//     | "name" | "long format" |
@table("attr")
type Attr {
  key:   utf8
  value: utf8
}

// ---------------------------------------------------------------------------
// Topic (one per wskill)
// ---------------------------------------------------------------------------

// The overarching subject — wraps everything inside the wskill — together with
// the wskill's own document-level metadata (creation/maintenance dates).
// Exactly one per wskill.
@block("topic")
type Topic {
  @inline(0) id: identifier      // topic ls { … }  → id = ls
  name:        utf8              // human title
  summary:     utf8              // one-line description
  description: utf8?             // longer prose (heredoc)
  version:     utf8?             // pinned upstream version, where the topic has one
  @default([]) tags: list<utf8>

  // Document-level metadata for the wskill itself (not topic content).
  created:    utf8               // ISO date the wskill was created
  updated:    utf8?             // ISO date of last full update sweep
  maintainer: utf8?
  maintainer_entity: identifier?  // entity id holding maintainer details; the book links to it
  note:       utf8?
}

// ---------------------------------------------------------------------------
// Skill (one per wskill — the skill-projection config + bundled artifacts)
// ---------------------------------------------------------------------------
//
// Skill artifacts (script / asset) are real files bundled into the emitted Claude
// Code skill (the `scripts/` and `assets/` folders a skill expects). They are
// authored as CHILDREN of the `skill` block below (so they drop the `skill_`
// prefix). The skill template ships each via wdoc's `file` block; the executable
// bit is preserved, so scripts arrive runnable. The book projection lists them with
// a download link (it cannot inline a file's bytes).
//
// Two fields carry the file's identity:
//   `source` — WHERE IT COMES FROM: the file's path under the wskill root, e.g.
//              "skill/scripts/build.sh". Templates resolve it relative to the root.
//   `name`   — WHAT IT IS CALLED IN THE RENDERED SKILL: the filename it ships as
//              under scripts/ or assets/, e.g. "build.sh".
// wdoc's `file` block names the copied output by the source's basename, so `name`
// must equal that basename. See references/schema.md.

// A runnable script shipped into the skill's scripts/ folder.
@block("script")
type Script {
  @inline(0) id: identifier
  source:      utf8             // where it comes from: path under the wskill root (e.g. "skill/scripts/build.sh")
  name:        utf8             // filename in the rendered skill (= basename of source, e.g. "build.sh")
  description: utf8             // what it does AND when to run it
  usage:       utf8             // invocation, e.g. "scripts/build.sh ARG"
  @default([]) tags: list<utf8>
}

// Optional custom SKILL.md summary content — a sub-block of `skill` whose plain
// fields are pulled onto the skill's start page (no wdoc body projection, which
// the `skill`/wdoc block-kind collision prevents). Author one inside `skill`.
@block("summary")
type Summary {
  @default([]) overview:   list<utf8>   // intro paragraph(s) under the topic summary
}

// An invocation parameter the skill accepts — rendered into the SKILL.md
// "Parameters" section. `name` is the Claude Code placeholder or label (e.g.
// "$ARGUMENTS", "$1", "$2"); `value` says how to determine what to pass. The kind
// is `skill_param` (not `parameter`, which the language module already declares).
@block("skill_param")
type SkillParam {
  @inline(0) name: utf8        // e.g. "$ARGUMENTS", "$1", "$2"
  description: utf8?           // what the parameter represents
  value:       utf8?          // how to determine / where to source the value
}

// Behavioural guardrails for the skill — rendered into SKILL.md inside
// `<Boundary> … </Boundary>` tags so an agent treats them as hard rules. The kind
// is `skill_boundary` (bare `boundary` collides with a wdoc diagram block).
@block("skill_boundary")
type SkillBoundary {
  @default([]) always: list<utf8>   // things to always do
  @default([]) ask:    list<utf8>   // things to ask before doing
  @default([]) never:  list<utf8>   // things to never do
}

// A static data file (fixture, dataset, sample config) shipped into assets/.
@block("asset")
type Asset {
  @inline(0) id: identifier
  source:      utf8             // where it comes from: path under the wskill root (e.g. "skill/assets/data.json")
  name:        utf8             // filename in the rendered skill (= basename of source, e.g. "data.json")
  description: utf8
  @default([]) tags: list<utf8>
}

// Controls written into the generated SKILL.md frontmatter, plus the bundled
// artifacts (script / asset children). A `skill` block kind is only possible
// because the schema is namespaced (`wcl.wskill::skill`) — bare it would collide
// with wdoc's own `skill` block. Defaults are absent-equivalent (empty list = no
// pre-approval / no restriction; false = model may invoke), so they are safe to
// always emit. Exactly one per wskill; the templates bind `let skill = head(skills)`.
@block("skill")
type Skill {
  @default([])    allowed_tools:            list<utf8>   // → SKILL.md `allowed-tools`
  @default([])    disallowed_tools:         list<utf8>   // → `disallowed-tools`
  @default(false) disable_model_invocation: bool         // → `disable-model-invocation`
  // Bundled skill artifacts — authored nested inside the skill block.
  @children("script") skill_scripts: list<Script>
  @children("asset")  skill_assets:  list<Asset>
  // Optional custom SKILL.md summary content (pulled, not projected — see Summary).
  @children("summary") summary: list<Summary>
  // Invocation parameters documented in the SKILL.md "Parameters" section.
  @children("skill_param") parameters: list<SkillParam>
  // Behavioural guardrails rendered into SKILL.md inside <Boundary> tags.
  @children("skill_boundary") boundary: list<SkillBoundary>
}

// ---------------------------------------------------------------------------
// Sources (update-workflow metadata — never rendered as topic content)
// ---------------------------------------------------------------------------

// Where current/authoritative information about the topic lives. Drives the
// update workflow only; it carries no content. See references/workflow-update.md.
@block("source")
type Source {
  @inline(0) id: identifier
  kind:             utf8         // website | repo | book | docs (extensible)
  locator:          utf8         // URL, git URL, ISBN, or path
  covers:           utf8         // free text: what this source is good for
  last_checked:     utf8?       // ISO date the agent last consulted it
  reflects_version: utf8?       // upstream version this source described when checked
}

// ---------------------------------------------------------------------------
// Cross-references to other wskills
// ---------------------------------------------------------------------------

// A relationship to another wskill. Resolved by `name` against repo peers /
// the collection manifest first, by `url` otherwise. `status = "planned"` is
// the stub form: it renders but the validator reports it as a warning so the
// planned-skill backlog stays visible without blocking renders.
@block("wskill_ref")
type WskillRef {
  @inline(0) id: identifier
  name:     utf8                 // referenced wskill's topic name
  url:      utf8?               // git URL when not a repo peer
  relation: utf8?               // "builds on", "see also", "prerequisite"
  @default("exists") status: utf8     // "exists" | "planned"
}

// ---------------------------------------------------------------------------
// Artifacts — the views this wskill ships, as first-class described data
// ---------------------------------------------------------------------------

// One shipped view (book / ai_skill / presentation / training — the ArtifactKind
// vocabulary lives in schema/kinds.wcl). The book overview lists these, a
// registry landing can enumerate them, and processes can name them in prose.
// Declaring an artifact documents that `entry` exists and renders to `output`;
// it does not build anything by itself.
@block("artifact")
type Artifact {
  @inline(0) id: identifier
  kind:    ArtifactKind          // which view family (see schema/kinds.wcl)
  name:    utf8?                 // display name; the templates default it per kind
  summary: utf8?
  entry:   utf8                  // projection entry file, e.g. "wdoc/book/main.wcl"
  output:  utf8?                 // conventional output dir, e.g. "out/book"
}

// ---------------------------------------------------------------------------
// Reference blocks
// ---------------------------------------------------------------------------
//
// Every content block below carries an `audience` field (the `Audience` symbol_set
// declared just below) controlling which projections render it.
//
// concept / entity / fact are the three interlinking *units of information*. Each
// is a thin record — an id, a headline, audience/tags — plus a rich **wdoc body**:
// an addressable `body { … }` holding arbitrary wdoc blocks (paragraphs, tables,
// code, callouts, links). Each unit renders to its own page (`<kind>_<id>`), and
// the body rides on the record as a property, `project`ed onto its page from the
// template (`project { from = c.body }`). `related` lists the ids of other units
// (any of the three kinds — ids are unique across them); the templates resolve each
// to a link to that unit's page. Bodies can also link inline with `[text](<kind>_<id>)`.

// Which projections a content block renders into: `:book` (default — human docs
// only), `:ai` (skill/agent-only notes), or `:both`. A symbol_set, so an unknown
// value is a `wcl check` error. The per-field default is `:book`, so content stays
// out of the skill until opted in with `:ai` / `:both` — curate the skill up. A
// `step` inherits its procedure's choice.
symbol_set Audience { book ai both }

// An idea the reader must understand.
@block("concept")
type Concept {
  @inline(0) id: identifier
  name:    utf8                          // headline (also the link text)
  summary: utf8                          // one-liner for the concept index
  @default([]) related: list<identifier> // ids of related units (concept/entity/fact)
  @default(:book) audience: Audience     // :book (default) | :ai | :both
  @default([]) tags: list<utf8>
  // The body — an addressable `body { …wdoc… }`, projected onto the page.
  @child("body") body: WdocAddressableBody?
}

// A concrete NAMED thing in the topic's world — a person, an organization, a
// piece of software, a command, a file format, a place. NOT a catch-all: an
// idea is a `concept`, a value/table is a `fact`, a repeatable task is a
// `procedure`. `kind` classifies it against the closed EntityKind vocabulary
// (schema/kinds.wcl — extend the set there when a topic needs a new kind).
@block("entity")
type Entity {
  @inline(0) id: identifier
  name:    utf8
  kind:    EntityKind                    // e.g. :software, :person (see schema/kinds.wcl)
  summary: utf8?                         // optional one-liner for the index
  @default([]) related: list<identifier>
  @default(:book) audience: Audience     // :book (default) | :ai | :both
  @default([]) tags: list<utf8>
  // The body — an addressable `body { …wdoc… }` (attributes go in a table here).
  @child("body") body: WdocAddressableBody?
}

// A factual unit — a container for values, constants, value tables. The `title`
// names it; the body holds the data (a `table`, `code`, prose).
@block("fact")
type Fact {
  @inline(0) id: identifier
  title:   utf8                          // headline (also the link text)
  @default([]) related: list<identifier>
  @default(:book) audience: Audience     // :book (default) | :ai | :both
  @default([]) tags: list<utf8>
  // The body — an addressable `body { …wdoc… }`, projected onto the page.
  @child("body") body: WdocAddressableBody?
}

// An index — a curated grouping that pins units (concepts / entities / facts /
// procedures) into a topic-meaningful arrangement. Unlike concept/entity/fact/
// procedure it is NOT filed under Reference: each index is a top-level entry in
// the book navigation (between Overview and Reference). In the BOOK it renders as
// a sidebar heading (no page of its own) whose children are the unit pages named
// in `related`, pinned into the nav tree. In the SKILL it renders as a
// link-collection page: the `body` (an addressable `body { … }`) holds the
// curated prose and `related` auto-resolves to a link list (so `body` is read by
// the skill projection only).
// An index may nest child indexes one level deep (`@children("index")`): write a
// child `index { … }` block inside the parent and both projections render it
// nested — under the parent heading in the book nav, indented under the parent
// bullet in the skill. Document-level `@children("index")` gathers only direct
// children, so a nested index is not also listed at the top level.
@block("index")
type Index {
  @inline(0) id: identifier
  name:    utf8
  summary: utf8?
  @default([]) related: list<identifier>
  @default(:book) audience: Audience     // :book (default) | :ai | :both
  @default([]) tags: list<utf8>
  @child("body") body: WdocAddressableBody?
  @children("index") children: list<Index>   // nested sub-indexes (one level rendered)
}

// A glossary entry.
@block("term")
type Term {
  @inline(0) id: identifier
  term:       utf8
  definition: utf8
  @default([]) aliases: list<utf8>
  @default(:book) audience: Audience     // :book (default) | :ai | :both
  @default([]) tags: list<utf8>
}

// A worked example or code sample. It is NOT a section of its own — it projects
// onto a unit: `unit` names the id of the concept/entity/fact it illustrates, and
// the templates render it on that unit's page (after the body).
@block("example")
type Example {
  @inline(0) id: identifier
  title:     utf8
  unit:      identifier?       // owning concept / entity / fact id (renders on its page)
  narrative: utf8?
  code_lang: utf8?             // language tag for the code listing
  code:      utf8?             // the sample (raw heredoc in data)
  expected:  utf8?             // expected result / output
  @default(:book) audience: Audience     // :book (default) | :ai | :both
  @default([]) tags: list<utf8>
}

// ---------------------------------------------------------------------------
// Processes (ordered step blocks)
// ---------------------------------------------------------------------------

// The flowchart shape a step draws in the process flow chart: a `process` box
// (an action), a `decision` diamond (a branch), or a `terminator` oval (start/end).
symbol_set StepShape { process decision terminator }

// The label on a flow edge between two steps: `:default` is a plain arrow, while
// `:yes` / `:no` annotate the branches out of a decision step.
symbol_set StepFlowKind { default yes no }

// One step in a process (procedure). The label is its `id` — the name the
// procedure's `from -> to` flow statements wire together. `n` is its display
// number and `shape` its flow-chart shape.
@block("step")
type Step {
  @inline(0) id: identifier
  n: u32                                  // display number (gutter / "Step N")
  title: utf8?
  @default(:process) shape: StepShape     // its shape in the flow chart
  // Two addressable body fragments per step: `body screen { … }` (what's on screen —
  // a callout/code/image box) and `body steps { … }` (the steps to follow — a list).
  // The book lays the number in a gutter beside the title; both fragments project
  // full-width below, in order, via a single `project { from = s.bodies }`.
  @children("body") bodies: list<WdocAddressableBody>
}

// A directed flow edge between two steps, authored as `from -> to` (optionally
// `from -> to :yes` / `:no`) in the procedure body — the wiring the flow chart draws.
connection StepFlow: Step -> Step : StepFlowKind

// A runbook for *doing* a specific task. Written for someone who already knows
// the topic and needs the reliable sequence. A `procedure` is a fourth interlinking
// unit (alongside concept/entity/fact) — it keeps its structured, step-based shape,
// but carries `related` and renders to its own page, so units can link to and from
// it. Its steps render as a flow chart (wired by the author's `from -> to` flow
// statements) above the step detail. (`process` is the user-facing name; the block
// is `procedure`.)
@block("procedure", required_children = ["step"])
type Procedure {
  @inline(0) id: identifier
  title:         utf8
  purpose:       utf8
  @default([]) preconditions: list<utf8>
  verification:  utf8?         // "how you know it worked"
  @default([]) related: list<identifier>   // ids of related units (any kind)
  @default(:book) audience: Audience     // :book (default) | :ai | :both
  @default([]) tags: list<utf8>
  @children("step") steps: list<Step>
  @connections(StepFlow) flow: list<StepFlow>   // the `from -> to` step wiring
}

// ---------------------------------------------------------------------------
// Custom content: declare a typed @block in extensions.wcl
// ---------------------------------------------------------------------------
//
// There is no generic catch-all block. Topic-specific content that doesn't fit a
// base block is modeled with a first-class typed block: declare an @block plus a
// merging @document in schema/extensions.wcl, and add a render to both template
// sets. Cards, keybindings, a CLI vocabulary — all are typed extension blocks.
// (A reference table is a `fact` whose body is a `table`, not a typed block.)
// See references/schema.md.

// ---------------------------------------------------------------------------
// Root document — gathers every block instance for the projections
// ---------------------------------------------------------------------------

// Merges with wdoc's library @document (so `site` / `page` template blocks are
// legal alongside content) and with any @document declared in extensions.wcl.
@document
type WSkillDoc {
  schema_version: utf8

  // Exactly one topic and one skill block are expected. They are gathered
  // as lists — not @child singles — because list elements resolve omitted
  // optional fields to `none`, which a single @child block does not. Templates
  // bind `let topic = head(topics)` / `let skill = head(skills)`.
  @children("topic") topics: list<Topic>
  @children("skill") skills: list<Skill>

  @children("source")     sources:    list<Source>
  @children("wskill_ref") refs:       list<WskillRef>
  @children("artifact")   artifacts:  list<Artifact>

  @children("concept")   concepts:   list<Concept>
  @children("entity")    entities:   list<Entity>
  @children("fact")      facts:      list<Fact>
  @children("term")      terms:      list<Term>
  @children("example")   examples:   list<Example>
  @children("index")     indexes:    list<Index>

  @children("procedure") procedures: list<Procedure>
}
WSK_SCHEMA_BASE_WCL
}

file "schema/kinds.wcl" {
  content = <<'WSK_SCHEMA_KINDS_WCL'
// wskill vocabulary — the topic-OWNED symbol sets the base schema builds on.
//
// Unlike base.wcl, this file IS yours to edit: append topic-specific members
// below. A symbol_set is a closed vocabulary — `wcl check` rejects any symbol
// not listed here — so adding a member is how you extend it. The shipped
// members are the shared baseline; keep them so cross-wskill tooling can rely
// on a common vocabulary.
namespace wcl.wskill

// What an `entity` is — the classifier shown on entity pages and indexes.
// Entities are reserved for concrete NAMED things; if none of these (or your
// additions) fit, the unit is probably a concept, fact, or procedure instead.
symbol_set EntityKind {
  person          // a human (maintainer, author, researcher)
  organization    // a company, team, standards body
  software        // an application, language, or product
  tool            // a CLI tool or utility
  command         // a single command of a CLI
  library         // a code library or framework
  service         // a hosted service / API
  hardware        // a physical device
  file_format     // a file type or on-disk format
  standard        // a specification or protocol
  place           // a physical or virtual location
  document        // a named external document
  dataset         // a named data collection
}

// Which views a wskill ships — used by the `artifact` block in base.wcl.
symbol_set ArtifactKind {
  book            // the human-readable reference book (wdoc/book)
  ai_skill        // the Claude Code skill folder (wdoc/skill)
  presentation    // the topic-overview slide deck (wdoc/presentation)
  training        // the hands-on tutorial book (wdoc/training)
}
WSK_SCHEMA_KINDS_WCL
}

file "schema/cli.wcl" {
  content = <<'WSK_SCHEMA_CLI_WCL'
// wskill OPTIONAL standard module — map a command-line interface as data.
//
// Import this from a wskill's root (`import "./schema/cli.wcl"`) only when the
// wskill documents a CLI. Parallel to the language module: a `cli` is the root
// (like `language`), `subcommand` blocks nest under it (like `feature`), and each
// command carries positional `cli_arg`s and `cli_switch`es (the leaf data). The
// consuming wskill's templates render a "CLI" section over the gathered `clis`.
//
// All declarations share the base `wcl.wskill` namespace. The merging @document
// below adds `clis` to the gathered document only in wskills that import this file.
namespace wcl.wskill

import <wdoc.wcl>
import "./base.wcl"        // Audience
import "./language.wcl"    // reuse CodeExample

// A positional argument of a command. The label is a block id; `name` is the
// displayed argument name (which may contain characters a bare label can't).
@block("cli_arg")
type CliArg {
  @inline(0) id: identifier
  name: utf8
  description: utf8?
  @default(true)  required: bool
  @default(false) variadic: bool       // accepts multiple values
  remarks: utf8?
}

// A flag / option. `value_name` unset = boolean flag; set = takes a value.
@block("cli_switch")
type CliSwitch {
  @inline(0) id: identifier
  long: utf8                           // e.g. "--in-place"
  short: utf8?                         // e.g. "-D"
  value_name: utf8?                    // e.g. "KEY=VALUE"; unset = boolean flag
  description: utf8?
  remarks: utf8?
}

// A subcommand — nestable; carries its own args, switches and examples.
@block("subcommand")
type Subcommand {
  @inline(0) id: identifier
  name: utf8
  description: utf8?
  remarks: utf8?
  @default([]) aliases: list<utf8>
  @default(:book) audience: Audience
  @children("cli_arg")      args:        list<CliArg>
  @children("cli_switch")   switches:    list<CliSwitch>
  @children("subcommand")   subcommands: list<Subcommand>   // nested subcommands
  @children("code_example") examples:    list<CodeExample>
}

// A CLI root — global switches + top-level subcommands.
@block("cli")
type Cli {
  @inline(0) id: identifier
  name: utf8
  description: utf8?
  version: utf8?
  @default(:book) audience: Audience
  @children("cli_switch")   switches:    list<CliSwitch>    // GLOBAL switches
  @children("cli_arg")      args:        list<CliArg>
  @children("subcommand")   subcommands: list<Subcommand>
  @children("code_example") examples:    list<CodeExample>
}

// Merges with the base @document — `clis` gathered only when this module is imported.
@document
type CliDoc {
  @children("cli") clis: list<Cli>
}
WSK_SCHEMA_CLI_WCL
}

file "schema/extensions.wcl" {
  content = <<'WSK_SCHEMA_EXTENSIONS_WCL'
// wskill custom block types — per-wskill schema extensions.
//
// Custom blocks declared here join the `wcl.wskill` namespace (shared with the base
// schema). The namespace line below is the file's first statement; uncomment your
// @block/@document beneath it and they are scoped automatically — bare references
// from data files and templates keep resolving.
namespace wcl.wskill

// The base schema (base.wcl) is never edited in place; everything topic-specific
// goes here (new vocabulary members — entity kinds — go in kinds.wcl instead).
// There is no generic catch-all block: topic-specific content that doesn't fit a
// base block is modeled as a first-class typed custom block — declare an @block
// with your own fields AND a @document that gathers it. Imported @document
// schemas MERGE with the base, so this composes cleanly. Then add a render
// snippet to BOTH template sets (wdoc/book/main.wcl and wdoc/skill/main.wcl) —
// the WSKILL skill helps with this.
//
// Example (uncomment and adapt):
//
// @block("keybinding")
// type Keybinding {
//   @inline(0) id: identifier
//   keys:     utf8
//   action:   utf8
//   context:  utf8?
// }
//
// @document
// type Extensions {
//   @children("keybinding") keybindings: list<Keybinding>
// }
//
// Then in each template set, alongside the other sections:
//
//   wdoc_repeater { each = keybindings  as = :k
//     p $"`${k.keys}` — ${k.action}"
//   }
WSK_SCHEMA_EXTENSIONS_WCL
}

file "schema/language.wcl" {
  content = <<'WSK_SCHEMA_LANGUAGE_WCL'
// wskill OPTIONAL standard module — describe a language as data.
//
// Import this from a wskill's root (`import "./schema/language.wcl"`) only when the
// wskill documents a language. It is NOT a content unit like concept/entity/fact —
// it carries no auto-rendered pages. A `language` groups `feature` blocks; each
// feature names the `concepts` and/or `facts` that compose it, and the consuming
// wskill's templates PROJECT those into the book wherever they choose. See
// references/schema.md.
//
// All declarations share the base schema's `wcl.wskill` namespace; importers keep
// using bare names. The merging @document below adds `languages` to the gathered
// document only in wskills that import this file.
namespace wcl.wskill

import <wdoc.wcl>
import "./base.wcl"          // for Audience + WdocAddressableBody

// ---------------------------------------------------------------------------
// API objects — structs and functions (with fields / parameters)
// ---------------------------------------------------------------------------
//
// Beyond prose units, a feature can document API-shaped objects as structured data:
// `struct` types (typed `field`s + `function` methods) and `function`s (typed
// `parameter`s + return). Each carries description / remarks / `code_example`s, and
// every field and parameter carries its own description and remarks. Functions are
// overloadable: the block `id` is unique, while `name` may repeat across overloads.

// A typed field of a struct.
@block("field")
type Field {
  @inline(0) name: utf8
  type:        utf8                 // field type, free text (e.g. "f64", "list<utf8>")
  description: utf8?
  remarks:     utf8?
}

// A function parameter.
@block("parameter")
type Parameter {
  @inline(0) name: utf8
  type:        utf8?                // optional (some params untyped)
  description: utf8?
  remarks:     utf8?
}

// A worked example attached to a struct/function (nested; not gathered globally).
@block("code_example")
type CodeExample {
  @inline(0) title: utf8?
  lang:        utf8?               // code-fence language
  code:        utf8                // the sample
  description: utf8?
  result:      utf8?               // expected result / output
}

// A function definition. `id` is unique; `name` may repeat across overloads.
@block("function")
type Function {
  @inline(0) id: identifier
  name:        utf8
  description: utf8?
  remarks:     utf8?
  returns:             utf8?       // return type
  returns_description: utf8?
  @default(:book) audience: Audience
  @children("parameter")    parameters: list<Parameter>
  @children("code_example") examples:   list<CodeExample>
}

// A struct / record type with typed fields and functions (methods).
@block("struct")
type Struct {
  @inline(0) id: identifier
  name:        utf8
  description: utf8?
  remarks:     utf8?
  @default(:book) audience: Audience
  @children("field")        fields:    list<Field>
  @children("function")     functions: list<Function>     // methods on the struct
  @children("code_example") examples:  list<CodeExample>
}

// One area / capability of a language, grouping the concepts and/or facts that make
// it up. A feature renders nothing on its own; the consuming template projects them.
// Features may nest via `@children("feature")` — a parent feature groups child
// features (e.g. a "Syntax" feature holding "Fields & Blocks" and "Comments"), which
// the consuming template renders as nested menu entries. Document-level gathering is
// direct-only, so a nested feature is not also listed at the top level. A feature may
// also hold `struct` / `function` objects, projected inline on its page.
@block("feature")
type Feature {
  @inline(0) id: identifier
  name:    utf8
  summary: utf8?
  @default([]) @ref("concept") concepts: list<identifier>  // concepts this feature groups (each checked)
  @default([]) @ref("fact")    facts:    list<identifier>  // facts this feature groups (each checked)
  @default(:book) audience: Audience     // :book (default) | :ai | :both
  @default([]) tags: list<utf8>
  @child("body") body: WdocAddressableBody?                // optional feature intro
  @children("feature")  children:  list<Feature>           // nested sub-features
  @children("struct")   structs:   list<Struct>            // struct/record objects
  @children("function") functions: list<Function>          // function objects
}

// A language the wskill describes; `feature` children describe its areas.
@block("language")
type Language {
  @inline(0) id: identifier
  name:    utf8
  summary: utf8?
  version: utf8?
  @default(:book) audience: Audience     // :book (default) | :ai | :both
  @default([]) tags: list<utf8>
  @child("body") body: WdocAddressableBody?
  @children("feature") features: list<Feature>
}

// Merges with the base @document, so `languages` joins the gathered document only
// in wskills that import this module.
@document
type LanguageDoc {
  @children("language") languages: list<Language>
}
WSK_SCHEMA_LANGUAGE_WCL
}

file "schema/presentation.wcl" {
  content = <<'WSK_SCHEMA_PRESENTATION_WCL'
// wskill OPTIONAL standard module — a topic-overview slide deck as data.
//
// Imported from the wskill root (`import "./schema/presentation.wcl"`); the
// gathered list stays empty until you author a `presentation` block under
// data/presentation/. The view SHIPS when you declare a matching
// `artifact { kind = :presentation … }` in wskill.wcl and render
// wdoc/presentation/main.wcl (the stdlib `:presentation` template). A
// presentation is the topic's INTRODUCTION — an overview deck a reader flips
// through before the reference book — not a second home for reference content:
// a slide `unit`-features an existing concept/entity/fact/procedure or carries
// a short `body`, and the detail stays in the unit it points at.
//
// All declarations share the base `wcl.wskill` namespace; the merging @document
// below adds `presentations` to the gathered document only in wskills that
// import this file. Block kinds are `pres_`-prefixed because bare `slide` /
// `section` / `deck` are wdoc template blocks.
namespace wcl.wskill

import <wdoc.wcl>
import "./base.wcl"          // WdocAddressableBody

// One slide. Content comes from `unit` (the projection pulls the named
// concept/entity/fact/procedure's headline + summary onto the slide), from the
// wdoc `body`, or both (pulled headline first). `speaker_notes` lands in the
// deck's notes overlay (toggle with `s` while presenting); use a
// `fragment { … }` inside `body` for step-reveals.
@block("pres_slide")
type PresSlide {
  @inline(0) id: identifier
  title: utf8?                    // slide heading; defaults to the featured unit's name
  unit:  identifier?              // concept / entity / fact / procedure id to feature
  speaker_notes: utf8?
  @default([]) tags: list<utf8>
  @child("body") body: WdocAddressableBody?
}

// One deck column (maps to a wdoc deck `section`; ← → move between sections,
// ↑ ↓ between the slides within one).
@block("pres_section")
type PresSection {
  @inline(0) id: identifier
  title: utf8
  @children("pres_slide") slides: list<PresSlide>
}

// The wskill's presentation view — an overview/introduction deck. At most one
// per wskill. The projection generates a title slide from `topic`, then one
// deck section per pres_section.
@block("presentation")
type Presentation {
  @inline(0) id: identifier
  title:   utf8?                  // deck title; defaults to topic.name
  summary: utf8?                  // subtitle on the generated title slide
  @default([]) tags: list<utf8>
  @children("pres_section") sections: list<PresSection>
}

// Merges with the base @document — `presentations` gathered only when this
// module is imported.
@document
type PresentationDoc {
  @children("presentation") presentations: list<Presentation>
}
WSK_SCHEMA_PRESENTATION_WCL
}

file "schema/training.wcl" {
  content = <<'WSK_SCHEMA_TRAINING_WCL'
// wskill OPTIONAL standard module — a tutorial series (training book) as data.
//
// Imported from the wskill root (`import "./schema/training.wcl"`); the
// gathered lists stay empty until you author `lesson` / `module` blocks under
// data/training/. The view SHIPS when you declare a matching
// `artifact { kind = :training … }` in wskill.wcl and render
// wdoc/training/main.wcl as a separate book. Training is for LEARNERS walking
// the topic for the first time — ordered lessons with hands-on exercises —
// where a `procedure` is for practitioners who already know the topic and
// need the reliable sequence.
//
// Lessons order by `n`; group them into `module`s when the course has parts (a
// small topic can author top-level lessons only). `related` names the reference
// units a lesson teaches, so the course links back into the book.
//
// All declarations share the base `wcl.wskill` namespace. The merging @document
// below adds `modules` / `lessons` to the gathered document only in wskills
// that import this file.
namespace wcl.wskill

import <wdoc.wcl>
import "./base.wcl"          // WdocAddressableBody

// A hands-on exercise inside a lesson, with the expected result so the learner
// (or a grading agent) can verify their work.
@block("exercise")
type Exercise {
  @inline(0) id: identifier
  title:     utf8
  task:      utf8              // what to do, imperatively
  code_lang: utf8?             // language tag for the starter snippet
  code:      utf8?             // starter code / command (raw heredoc)
  expected:  utf8?             // expected result / output — "how you know it worked"
  hint:      utf8?
  @child("body") body: WdocAddressableBody?   // richer material when fields aren't enough
}

// One tutorial step. `related` names the reference units (concept/entity/fact/
// procedure ids) the lesson teaches, rendered as "Covered in the reference"
// links back into the book's pages.
@block("lesson")
type Lesson {
  @inline(0) id: identifier
  title:   utf8
  summary: utf8?
  n:       u32                                   // order within its module (or the course)
  @default([]) objectives:    list<utf8>         // "after this lesson you can …"
  @default([]) prerequisites: list<identifier>   // lesson ids to complete first
  @default([]) related:       list<identifier>   // reference units this lesson teaches
  @default([]) tags: list<utf8>
  @child("body") body: WdocAddressableBody?
  @children("exercise") exercises: list<Exercise>
}

// A part of the course: an ordered group of lessons. Optional — a small topic
// can author top-level lessons only. (`module` is safe as a kind because the
// schema is namespaced: `wcl.wskill::module`.)
@block("module")
type TrainingModule {
  @inline(0) id: identifier
  title:   utf8
  summary: utf8?
  n:       u32
  @children("lesson") lessons: list<Lesson>
}

// Merges with the base @document — gathered only when this module is imported.
// Document-level @children gathers direct children only, so a module-nested
// lesson is not also listed in `lessons`.
@document
type TrainingDoc {
  @children("module") modules: list<TrainingModule>
  @children("lesson") lessons: list<Lesson>   // ungrouped top-level lessons
}
WSK_SCHEMA_TRAINING_WCL
}

file "skill/assets/.gitkeep" {
  content = <<'WSK_SKILL_ASSETS__GITKEEP'
# Drop static data files (datasets, sample configs) here. A `skill_asset` block
# in data/skill/artifacts.wcl ships each one into the rendered skill's assets/.
WSK_SKILL_ASSETS__GITKEEP
}

file "skill/scripts/example.sh" {
  content = $<<WSK_SKILL_SCRIPTS_EXAMPLE_SH
#!/usr/bin/env bash
# Example bundled script for the ${answer("topic_name")} skill.
#
# Files in skill/scripts/ ship into the rendered skill's scripts/ folder
# (executable bit preserved). Reference this file from a `skill_script` block in
# data/skill/artifacts.wcl. Replace this with a real helper, or delete both.
set -euo pipefail

echo "Hello from the ${answer("topic_name")} skill. Replace me with something useful."
WSK_SKILL_SCRIPTS_EXAMPLE_SH
}

// ---------------------------------------------------------------------------
// wdoc projection components — shared per-unit page bodies (book + skill).
// One component per unit kind, plus the shared related/examples/index helpers.
// A component body resolves names in ITS OWN file scope plus its declared
// `wdoc_slot`s — never the caller's `let`s — so every list/value is threaded in
// as a slot.
// ---------------------------------------------------------------------------

file "wdoc/component/common.wcl" {
  content = <<'WSK_WDOC_COMPONENT_COMMON_WCL'
// Shared infrastructure for the per-unit page components (concept / entity /
// fact / process), which live one-per-file alongside this one.
//
// A component body resolves names in THIS file's lexical scope plus its own
// slots — never the call site's `let`s — so every list/value a body needs is
// threaded in as a slot (`unit`, `examples`, `all_units`, …). Both projections
// (book + skill) import these files; the page repeaters in each `main.wcl`
// just invoke the matching component.

import <wdoc.wcl>
import "../../schema/base.wcl"

// A flattened cross-reference row: every unit projected to a uniform
// { id, name, href, related } so a unit's `related` ids resolve to links and
// the inverse (backlinks) can be computed. Each projection builds `all_units`
// over its own audience-filtered lists and passes it into the components.
type UnitRef { id: identifier  name: utf8  href: utf8  related: list<identifier> }

// A kind symbol's display text ( `$"${:file_format}"` → "file format" ) — used
// wherever an entity's `kind` (or an artifact's) renders as prose. Symbols
// interpolate as `:name`, so pass the interpolated string: `kind_text($"${e.kind}")`.
let kind_text = fn(k: utf8) -> utf8 { replace(replace(k, ":", ""), "_", " ") }

// "Examples" — examples authored against this unit (`example.unit == id`).
wdoc_component unit_examples {
  wdoc_slot unit_id
  wdoc_slot examples
  wdoc_body {
    wdoc_repeater { each = match len(filter(examples, fn(z: Example) -> bool { z.unit == unit_id })) { 0 => [], _ => [true] }  as = :_xh  h2 "Examples" }
    wdoc_repeater { each = filter(examples, fn(z: Example) -> bool { z.unit == unit_id })  as = :z
      h3 $"${z.title}"
      wdoc_repeater { each = match z.narrative { none => [], n => [n] }  as = :n  p $"${n}" }
      wdoc_repeater { each = match z.code { none => [], cc => [cc] }  as = :src  code $"${z.code_lang ?? "text"}" { source = src } }
      wdoc_repeater { each = match z.expected { none => [], e => [e] }  as = :e  p $"**Expected:** ${e}" }
    }
  }
}

// "Related" — each related id resolved to a link via `all_units`.
wdoc_component unit_related {
  wdoc_slot related
  wdoc_slot all_units
  wdoc_body {
    wdoc_repeater { each = match len(related) { 0 => [], _ => [true] }  as = :_r  h2 "Related" }
    wdoc_repeater { each = related  as = :rid
      wdoc_repeater { each = filter(all_units, fn(u: UnitRef) -> bool { u.id == rid })  as = :u  p $"- [${u.name}](${u.href})" }
    }
  }
}

// "Referenced by" — units whose `related` points at this one (book footer).
wdoc_component unit_referenced_by {
  wdoc_slot backlinks
  wdoc_body {
    wdoc_repeater { each = match len(backlinks) { 0 => [], _ => [true] }  as = :_rb  h2 "Referenced by" }
    wdoc_repeater { each = backlinks  as = :u  p $"- [${u.name}](${u.href})" }
  }
}

// "Related" + "Referenced by" together. `layout = "columns"` lays them side by
// side in a two-column grid (the book); any other value stacks them. The skill
// keeps the default "stack" because the Markdown backend drops `column`, and it
// passes no `backlinks`, so "Referenced by" renders nothing there.
wdoc_component related_section {
  wdoc_slot related
  wdoc_slot all_units
  wdoc_slot backlinks
  wdoc_slot layout { default = "stack" }
  wdoc_body {
    wdoc_repeater { each = match layout { "columns" => [true], _ => [] }  as = :_col
      // Each side is wrapped in its own single-column `column` so it is one grid
      // cell — otherwise the section's heading + links would interleave across
      // the two outer columns.
      column { widths = [50.0, 50.0]  class = ["related-cols"]
        column { widths = [100.0]  unit_related       { related = related  all_units = all_units } }
        column { widths = [100.0]  unit_referenced_by { backlinks = backlinks } }
      }
    }
    wdoc_repeater { each = match layout { "columns" => [], _ => [true] }  as = :_stk
      unit_related { related = related  all_units = all_units }
    }
  }
}
WSK_WDOC_COMPONENT_COMMON_WCL
}

file "wdoc/component/concept.wcl" {
  content = <<'WSK_WDOC_COMPONENT_CONCEPT_WCL'
// Concept page body — invoked by the per-concept page repeater in each
// projection's main.wcl. Renders the summary, projected body, examples and
// related links; the caller fills `wdoc_content` with its projection-specific
// footer (a "Referenced by" section in the book, an index back-link in the
// skill).

import "./common.wcl"

wdoc_component concept_body {
  wdoc_slot unit
  wdoc_slot examples
  wdoc_slot all_units
  wdoc_slot backlinks
  wdoc_slot layout    { default = "stack" }
  wdoc_body {
    h1 $"${unit.name}"
    // Edit-mode only: jump straight into this object in the WYSIWYG editor.
    edit_object { kind = "concept" target = $"${unit.id}" label = "Edit this concept" }
    p  $"_${unit.summary}_"
    project { from = unit.body }
    unit_examples { unit_id = unit.id  examples = examples }
    related_section { related = unit.related  all_units = all_units  backlinks = backlinks  layout = layout }
    wdoc_content
  }
}
WSK_WDOC_COMPONENT_CONCEPT_WCL
}

file "wdoc/component/entity.wcl" {
  content = <<'WSK_WDOC_COMPONENT_ENTITY_WCL'
// Entity page body — invoked by the per-entity page repeater in each
// projection's main.wcl. Renders the kind line, optional summary, projected
// body, examples and related links; the caller fills `wdoc_content` with its
// projection-specific footer.

import "./common.wcl"

wdoc_component entity_body {
  wdoc_slot unit
  wdoc_slot examples
  wdoc_slot all_units
  wdoc_slot backlinks
  wdoc_slot layout    { default = "stack" }
  wdoc_body {
    h1 $"${unit.name}"
    // Edit-mode only: jump straight into this object in the WYSIWYG editor.
    edit_object { kind = "entity" target = $"${unit.id}" label = "Edit this entity" }
    p  $"_${kind_text($"${unit.kind}")}_"
    wdoc_repeater { each = match unit.summary { none => [], s => [s] }  as = :s  p $"${s}" }
    project { from = unit.body }
    unit_examples { unit_id = unit.id  examples = examples }
    related_section { related = unit.related  all_units = all_units  backlinks = backlinks  layout = layout }
    wdoc_content
  }
}
WSK_WDOC_COMPONENT_ENTITY_WCL
}

file "wdoc/component/fact.wcl" {
  content = <<'WSK_WDOC_COMPONENT_FACT_WCL'
// Fact page body — invoked by the per-fact page repeater in each projection's
// main.wcl. Renders the projected body, examples and related links; the caller
// fills `wdoc_content` with its projection-specific footer.

import "./common.wcl"

wdoc_component fact_body {
  wdoc_slot unit
  wdoc_slot examples
  wdoc_slot all_units
  wdoc_slot backlinks
  wdoc_slot layout    { default = "stack" }
  wdoc_body {
    h1 $"${unit.title}"
    // Edit-mode only: jump straight into this object in the WYSIWYG editor.
    edit_object { kind = "fact" target = $"${unit.id}" label = "Edit this fact" }
    project { from = unit.body }
    unit_examples { unit_id = unit.id  examples = examples }
    related_section { related = unit.related  all_units = all_units  backlinks = backlinks  layout = layout }
    wdoc_content
  }
}
WSK_WDOC_COMPONENT_FACT_WCL
}

file "wdoc/component/process.wcl" {
  content = <<'WSK_WDOC_COMPONENT_PROCESS_WCL'
// Process (procedure) page body — invoked by the per-process page repeater in
// each projection's main.wcl. Renders purpose, prerequisites, the step
// flowchart, the step descriptions, verification and related links; the caller
// fills `wdoc_content` with its projection-specific footer.
//
// `step_style` selects the step-heading layout: `:book`-style "book" (a
// number / title two-column row) or "skill" ("Step N: title").

import "./common.wcl"

wdoc_component process_body {
  wdoc_slot unit
  wdoc_slot all_units
  wdoc_slot step_style { default = "book" }
  wdoc_slot backlinks
  wdoc_slot layout     { default = "stack" }
  wdoc_body {
    h1 $"${unit.title}"
    // Edit-mode only: jump straight into this object in the WYSIWYG editor.
    edit_object { kind = "procedure" target = $"${unit.id}" label = "Edit this process" }
    h2 "Purpose"
    p  $"${unit.purpose}"
    wdoc_repeater { each = match len(unit.preconditions) { 0 => [], _ => [true] }  as = :_p
      h2 "Prerequisites"
      list { items = map(unit.preconditions, fn(pc: utf8) -> Li { { text: pc } }) }
    }
    h2 "Flowchart"
    diagram {
      width = 540  height = len(unit.steps) * 96 + 64
      layout = :layered  direction = :top_to_bottom  layer_gap = 28.0  node_gap = 32.0
      wdoc_repeater { each = unit.steps  as = :s
        wdoc_repeater { each = match s.shape { :process => [true], _ => [] }  as = :_sh
          process $"${s.n}. ${s.title ?? ""}" { id = $"${s.id}"  width = 180.0  height = 46.0 } }
        wdoc_repeater { each = match s.shape { :decision => [true], _ => [] }  as = :_sh
          decision $"${s.title ?? ""}" { id = $"${s.id}"  width = 160.0  height = 72.0 } }
        wdoc_repeater { each = match s.shape { :terminator => [true], _ => [] }  as = :_sh
          terminator $"${s.title ?? ""}" { id = $"${s.id}"  width = 140.0  height = 46.0 } }
      }
      edges = map(unit.flow, fn(e: StepFlow) -> Edge {
        { source: $"${e.source}", destination: $"${e.destination}",
          kind: :flow, label: match e.kind { :yes => "yes", :no => "no", _ => "" } }
      })
    }
    h2 "Steps"
    wdoc_repeater { each = unit.steps  as = :s
      wdoc_repeater { each = match step_style { "skill" => [], _ => [true] }  as = :_bk
        column { widths = [6.0, 94.0]
          h3 $"${s.n}"
          h3 $"${s.title ?? ""}"
        }
      }
      wdoc_repeater { each = match step_style { "skill" => [true], _ => [] }  as = :_sk
        h3 $"Step ${s.n}${match s.title { none => "", ti => $": ${ti}" }}"
      }
      project { from = s.bodies }
    }
    wdoc_repeater { each = match unit.verification { none => [], v => [v] }  as = :v
      callout "Verification" { class = ["success"]  body = $"${v}" }
    }
    related_section { related = unit.related  all_units = all_units  backlinks = backlinks  layout = layout }
    wdoc_content
  }
}
WSK_WDOC_COMPONENT_PROCESS_WCL
}

file "wdoc/component/type_index.wcl" {
  content = <<'WSK_WDOC_COMPONENT_TYPE_INDEX_WCL'
// Shared index-page component for the four unit kinds (concept / entity / fact /
// process). Renders the kind heading, an intro line, and a bullet list of
// pre-formatted entries — the caller maps its units to bullet text (the format
// differs per kind: summary, kind, purpose, …) and passes them as `items`.
//
//   type_index {
//     heading = "Concepts"
//     intro   = "Each concept has its own page — …"
//     items   = map(concepts, fn(c: Concept) -> utf8 { $"[**${c.name}**](concept_${c.id}) — ${c.summary}" })
//   }

import <wdoc.wcl>

wdoc_component type_index {
  wdoc_slot heading
  wdoc_slot intro
  wdoc_slot items
  wdoc_body {
    h1 $"${heading}"
    p  $"${intro}"
    wdoc_repeater { each = items  as = :it  p $"- ${it}" }
  }
}
WSK_WDOC_COMPONENT_TYPE_INDEX_WCL
}

// ---------------------------------------------------------------------------
// wdoc projection pages — standalone book pages, one file each. These resolve
// the `let`s defined in book/main.wcl, so they are only valid as part of that
// document (not standalone-checkable).
// ---------------------------------------------------------------------------

file "wdoc/pages/overview.wcl" {
  content = <<'WSK_WDOC_PAGES_OVERVIEW_WCL'
// Book Overview — the start page (topic header, metadata, related skills, sources).
//
// Imported by book/main.wcl; resolves that file's `let`s (`topic`) and the
// gathered document lists (`refs`, `sources`). Not standalone-checkable — it is
// only valid as part of the book document.

page index { start = true
  h1 $"${topic.name}"
  callout "Summary" { class = ["info"]  body = $"${topic.summary}" }
  table {
    header = ["", ""]
    rows = [
      ["Version", topic.version ?? "—"],
      ["Created", topic.created],
      ["Last updated", topic.updated ?? "—"],
      ["Maintainer", match topic.maintainer_entity { none => topic.maintainer ?? "—", id => $"[${topic.maintainer ?? "maintainer"}](entity_${id})" }],
    ]
  }
  wdoc_repeater { each = match topic.description { none => [], d => [d] }  as = :d
    p $"${d}"
  }

  wdoc_repeater { each = match len(artifacts) { 0 => [], _ => [true] }  as = :_af
    h2 "Artifacts"
    p  "The views this wskill ships — build them with `just render` (or the per-view recipes)."
    table {
      header = ["View", "Entry", "Output"]
      rows = map(artifacts, fn(a: Artifact) -> list<utf8> {
        [a.name ?? kind_text($"${a.kind}"), $"`${a.entry}`", match a.output { none => "—", o => $"`${o}`" }]
      })
    }
  }

  h2 "Related skills"
  wdoc_repeater { each = match len(refs) { 0 => [true], _ => [] }  as = :_n
    p "No related wskills declared yet."
  }
  wdoc_repeater { each = match len(refs) { 0 => [], _ => [true] }  as = :_r
    table {
      header = ["Name", "Relation", "Status"]
      rows = map(refs, fn(r: WskillRef) -> list<utf8> {
        [match r.url { none => r.name, u => $"[${r.name}](${u})" }, r.relation ?? "—", r.status]
      })
    }
  }

  wdoc_repeater { each = match len(sources) { 0 => [], _ => [true] }  as = :_s
    h2 "Sources"
    p "Sources drive the update workflow only — they are not topic content."
    table {
      header = ["ID", "Kind", "Locator", "Covers", "Last checked", "Reflects version"]
      rows   = map(sources, fn(s: Source) -> list<utf8> {
        [$"${s.id}", s.kind, s.locator, s.covers, s.last_checked ?? "—", s.reflects_version ?? "—"]
      })
    }
  }
}
WSK_WDOC_PAGES_OVERVIEW_WCL
}

file "wdoc/pages/reference.wcl" {
  content = <<'WSK_WDOC_PAGES_REFERENCE_WCL'
// Book Reference landing — a force-directed graph of every unit, with a bullet
// summary of the four kinds beneath it. Imported by book/main.wcl. Not
// standalone-checkable (resolves the `concepts` / `entities` / `facts` /
// `procedures` lets defined in main.wcl).
//
// (The canonical wskill also shows an "index coverage" table here; a starter
// has no curated indexes yet, so this page keeps to the graph + summary and
// grows once you add `index` blocks and a richer reference page.)

// Record for the graph diagram's computed `edges = [...]` field. Node ids are
// the raw unit ids, so a `related` id maps straight to its node. The diagram's
// Edge connection is `@dynamic`, so an endpoint naming a missing node is dropped
// with a build warning rather than failing the build.
type GraphEdge { source: utf8  destination: utf8 }

// One edge per (unit, related-id) pair, across all four unit kinds.
let note_edges = flatten([
  flatten(map(concepts,   fn(c: Concept)   -> list<GraphEdge> { map(c.related, fn(r: identifier) -> GraphEdge { { source: $"${c.id}", destination: $"${r}" } }) })),
  flatten(map(entities,   fn(e: Entity)    -> list<GraphEdge> { map(e.related, fn(r: identifier) -> GraphEdge { { source: $"${e.id}", destination: $"${r}" } }) })),
  flatten(map(facts,      fn(f: Fact)      -> list<GraphEdge> { map(f.related, fn(r: identifier) -> GraphEdge { { source: $"${f.id}", destination: $"${r}" } }) })),
  flatten(map(procedures, fn(p: Procedure) -> list<GraphEdge> { map(p.related, fn(r: identifier) -> GraphEdge { { source: $"${p.id}", destination: $"${r}" } }) })),
])

// Node colours for the graph: paint each circle by note type, and give the
// label white text so it stays legible on the fill in both light and dark mode.
stylesheet "graph-node-colours" {
  css = <<CSS
circle.gnode-concept { fill: #2563eb }
circle.gnode-entity  { fill: #b45309 }
circle.gnode-fact    { fill: #15803d }
circle.gnode-process { fill: #7c3aed }
text.gnode-concept, text.gnode-entity, text.gnode-fact, text.gnode-process { fill: #ffffff }
CSS
}

page reference_page {
  h1 "Reference"
  p  "Everything about this topic, mapped below as a force-directed graph and listed beneath it."
  p  "Each circle is a note (click it to open its page) and each line is a `related` link — colour-coded by type (**concepts** blue, **entities** amber, **facts** green, **processes** purple). Scroll to zoom and drag to pan."

  wdoc_repeater { each = match len(note_edges) { 0 => [], _ => [true] }  as = :_g
    diagram {
      width    = 960
      height   = 640
      layout   = :force
      pan_zoom = true
      zoom_min = 1.0
      zoom_max = 4.0
      link_distance = 150.0
      routing  = :straight
      desc = "Force-directed graph of every wskill note and its related links."

      wdoc_repeater { each = concepts   as = :c  node $"${c.name}"  { id = c.id  link = $"concept_${c.id}"  class = ["gnode-concept"]  width = 120.0  height = 120.0 } }
      wdoc_repeater { each = entities   as = :e  node $"${e.name}"  { id = e.id  link = $"entity_${e.id}"   class = ["gnode-entity"]   width = 120.0  height = 120.0 } }
      wdoc_repeater { each = facts      as = :f  node $"${f.title}" { id = f.id  link = $"fact_${f.id}"     class = ["gnode-fact"]     width = 120.0  height = 120.0 } }
      wdoc_repeater { each = procedures as = :p  node $"${p.title}" { id = p.id  link = $"process_${p.id}"  class = ["gnode-process"]  width = 120.0  height = 120.0 } }

      edges = note_edges
    }
  }

  h2 "Catalogue"
  wdoc_repeater { each = match len(concepts) { 0 => [], _ => [true] }  as = :_uc
    p $"- [**Concepts**](concepts_page) — ${len(concepts)} ideas to understand."
  }
  wdoc_repeater { each = match len(entities) { 0 => [], _ => [true] }  as = :_ue
    p $"- [**Entities**](entities_page) — ${len(entities)} concrete things in the topic's world."
  }
  wdoc_repeater { each = match len(facts) { 0 => [], _ => [true] }  as = :_uf
    p $"- [**Facts**](facts_page) — ${len(facts)} values and value tables."
  }
  wdoc_repeater { each = match len(procedures) { 0 => [], _ => [true] }  as = :_up
    p $"- [**Processes**](processes_page) — ${len(procedures)} runbooks for doing tasks."
  }
  wdoc_repeater { each = match len(flatten([concepts, []])) { 0 => [true], _ => [] }  as = :_empty
    wdoc_repeater { each = match len(flatten([entities, []])) { 0 => [true], _ => [] }  as = :_e2
      wdoc_repeater { each = match len(flatten([facts, []])) { 0 => [true], _ => [] }  as = :_f2
        wdoc_repeater { each = match len(flatten([procedures, []])) { 0 => [true], _ => [] }  as = :_p2
          p "No reference content yet. Add `concept` / `entity` / `fact` / `procedure` blocks in `data/reference/` and `data/processes/`."
        }
      }
    }
  }

  // ---- TYPED EXTENSION BLOCKS render here ------------------------------------
  // The base schema has no generic table/custom block. Model topic-specific content
  // (lookup tables, cards, a CLI vocabulary) as typed @blocks in schema/extensions.wcl
  // and add their render here (and in the skill template). Worked examples attach to a
  // unit via `example.unit` and render on that unit's page. See references/schema.md.
}
WSK_WDOC_PAGES_REFERENCE_WCL
}

file "wdoc/pages/concepts.wcl" {
  content = <<'WSK_WDOC_PAGES_CONCEPTS_WCL'
// Book Concepts index — links to each concept's generated page (via the shared
// type_index component). Imported by book/main.wcl (resolves its `concepts`
// let). Not standalone-checkable.

page concepts_page {
  type_index {
    heading = "Concepts"
    intro   = "Each concept has its own page — open one from the list below or the sidebar."
    items   = map(concepts, fn(c: Concept) -> utf8 { $"[**${c.name}**](concept_${c.id}) — ${c.summary}" })
  }
}
WSK_WDOC_PAGES_CONCEPTS_WCL
}

file "wdoc/pages/entities.wcl" {
  content = <<'WSK_WDOC_PAGES_ENTITIES_WCL'
// Book Entities index — links to each entity's generated page via the shared
// type_index component (gated: no page when there are no entities). Imported by
// book/main.wcl. Not standalone-checkable.

wdoc_repeater { each = match len(entities) { 0 => [], _ => [true] }  as = :_ei
  page entities_page {
    type_index {
      heading = "Entities"
      intro   = "Each entity has its own page — open one from the list below or the sidebar."
      items   = map(entities, fn(e: Entity) -> utf8 { $"[**${e.name}**](entity_${e.id}) — _${kind_text($"${e.kind}")}_${match e.summary { none => "", s => $" — ${s}" }}" })
    }
  }
}
WSK_WDOC_PAGES_ENTITIES_WCL
}

file "wdoc/pages/facts.wcl" {
  content = <<'WSK_WDOC_PAGES_FACTS_WCL'
// Book Facts index — links to each fact's generated page via the shared
// type_index component (gated: no page when there are no facts). Imported by
// book/main.wcl. Not standalone-checkable.

wdoc_repeater { each = match len(facts) { 0 => [], _ => [true] }  as = :_fi
  page facts_page {
    type_index {
      heading = "Facts"
      intro   = "Each fact is a container of factual data on its own page."
      items   = map(facts, fn(f: Fact) -> utf8 { $"[**${f.title}**](fact_${f.id})" })
    }
  }
}
WSK_WDOC_PAGES_FACTS_WCL
}

file "wdoc/pages/processes.wcl" {
  content = <<'WSK_WDOC_PAGES_PROCESSES_WCL'
// Book Processes index — links to each process's generated page via the shared
// type_index component. Imported by book/main.wcl (resolves its `procedures`
// let). Not standalone-checkable.

page processes_page {
  type_index {
    heading = "Processes"
    intro   = "Each process is a runbook on its own page — open one from the list below or the sidebar."
    items   = map(procedures, fn(pr: Procedure) -> utf8 { $"[**${pr.title}**](process_${pr.id}) — ${pr.purpose}" })
  }
}
WSK_WDOC_PAGES_PROCESSES_WCL
}

file "wdoc/book/main.wcl" {
  content = <<'WSK_WDOC_BOOK_MAIN_WCL'
// Book projection — human-readable wdoc site over the wskill data model.
//
// Build:  wcl wdoc build wdoc/book/main.wcl --out out/book
//
// This template contains NO topic content — only projections over the data
// gathered by the root @document (concepts, entities, …). The per-unit page
// bodies live in wdoc/component/ (shared with the skill projection); the
// standalone index pages live in wdoc/pages/. When you add a typed extension
// block in schema/extensions.wcl, add a render section for it (search "TYPED
// EXTENSION", in wdoc/pages/reference.wcl).

import <wdoc.wcl>
import "../../wskill.wcl"
import "../component/common.wcl"     // UnitRef + shared per-unit sub-sections
import "../component/concept.wcl"    // concept_body
import "../component/entity.wcl"     // entity_body
import "../component/fact.wcl"       // fact_body
import "../component/process.wcl"    // process_body
import "../component/type_index.wcl" // shared unit-index page component

// Built-in standalone pages — one file each under pages/ (the generated
// per-unit pages stay as repeaters below). These resolve the `let`s defined in
// this file, so they are only valid as part of this document.
import "../pages/overview.wcl"    // index (start page)
import "../pages/reference.wcl"   // reference_page
import "../pages/concepts.wcl"    // concepts_page
import "../pages/entities.wcl"    // entities_page
import "../pages/facts.wcl"       // facts_page
import "../pages/processes.wcl"   // processes_page

// The single topic block, bound from its gather list (see base.wcl
// for why it is a list). A wskill always has exactly one.
let topic = head(topics)

// Audience filter — the book is the comprehensive human reference. Each `let`
// shadows the gathered list of the same name with its "both"/"book" subset
// (dropping ai-only notes), so the book renders everything meant for readers.
let in_book    = fn(a: Audience) -> bool { match a { :ai => false, _ => true } }
let concepts   = filter(concepts,   fn(c: Concept)   -> bool { in_book(c.audience) })
let entities   = filter(entities,   fn(e: Entity)    -> bool { in_book(e.audience) })
let facts      = filter(facts,      fn(f: Fact)      -> bool { in_book(f.audience) })
let terms      = filter(terms,      fn(t: Term)      -> bool { in_book(t.audience) })
let examples   = filter(examples,   fn(x: Example)   -> bool { in_book(x.audience) })
let indexes    = filter(indexes,    fn(x: Index)      -> bool { in_book(x.audience) })
let procedures = filter(procedures, fn(p: Procedure) -> bool { in_book(p.audience) })

// Backlinks: every unit flattened to a uniform UnitRef so a unit page can list
// the notes that point *at* it (the inverse of its own `related`). Built from
// the audience-filtered lists above, so backlinks track the book's view.
// UnitRef is declared in component/common.wcl (shared with the components).
let all_units = flatten([
  map(concepts,   fn(c: Concept)   -> UnitRef { { id: c.id, name: c.name,  href: $"concept_${c.id}", related: c.related } }),
  map(entities,   fn(e: Entity)    -> UnitRef { { id: e.id, name: e.name,  href: $"entity_${e.id}",  related: e.related } }),
  map(facts,      fn(f: Fact)      -> UnitRef { { id: f.id, name: f.title, href: $"fact_${f.id}",    related: f.related } }),
  map(procedures, fn(p: Procedure) -> UnitRef { { id: p.id, name: p.title, href: $"process_${p.id}", related: p.related } }),
])
let referenced_by = fn(uid: identifier) -> list<UnitRef> {
  filter(all_units, fn(u: UnitRef) -> bool { list_contains(u.related, uid) })
}

// The per-unit "Related" / "Referenced by" two-column block: top-align the two
// columns and tighten the bullet rows (grid cells don't collapse margins, which
// otherwise leaves the lists looking double-spaced).
stylesheet "related-cols" {
  css = <<CSS
.related-cols { align-items: start; }
.related-cols p { margin: 0.15rem 0; }
.related-cols .heading-2 { margin: 0 0 0.35rem; }
CSS
}

// --- site -------------------------------------------------------------------

site book {
  default_template = :book
  title            = $"${topic.name}"
  summary          = $"${topic.summary}"
  root             = true
  theme            = :nord
  theme_toggle     = true
  search           = true
  toc {
    chapter "Overview"       { page = index }
    // Curated `index` groupings (none in a fresh starter) pin units into the
    // nav tree: each is a heading whose children are the concept / entity /
    // fact / process pages it lists in `related`, plus one level of nested
    // sub-indexes. A `related` id that resolves to no book-included unit
    // contributes nothing.
    wdoc_repeater { each = indexes  as = :ix  chapter $"${ix.name}" {
      wdoc_repeater { each = ix.related  as = :rid
        wdoc_repeater { each = filter(concepts,   fn(x: Concept)   -> bool { x.id == rid })  as = :t  chapter $"${t.name}"  { page = $"concept_${t.id}" } }
        wdoc_repeater { each = filter(entities,   fn(x: Entity)    -> bool { x.id == rid })  as = :t  chapter $"${t.name}"  { page = $"entity_${t.id}" } }
        wdoc_repeater { each = filter(facts,      fn(x: Fact)      -> bool { x.id == rid })  as = :t  chapter $"${t.title}" { page = $"fact_${t.id}" } }
        wdoc_repeater { each = filter(procedures, fn(x: Procedure) -> bool { x.id == rid })  as = :t  chapter $"${t.title}" { page = $"process_${t.id}" } }
      }
      wdoc_repeater { each = filter(ix.children, fn(x: Index) -> bool { in_book(x.audience) })  as = :cix  chapter $"${cix.name}" {
        wdoc_repeater { each = cix.related  as = :rid
          wdoc_repeater { each = filter(concepts,   fn(x: Concept)   -> bool { x.id == rid })  as = :t  chapter $"${t.name}"  { page = $"concept_${t.id}" } }
          wdoc_repeater { each = filter(entities,   fn(x: Entity)    -> bool { x.id == rid })  as = :t  chapter $"${t.name}"  { page = $"entity_${t.id}" } }
          wdoc_repeater { each = filter(facts,      fn(x: Fact)      -> bool { x.id == rid })  as = :t  chapter $"${t.title}" { page = $"fact_${t.id}" } }
          wdoc_repeater { each = filter(procedures, fn(x: Procedure) -> bool { x.id == rid })  as = :t  chapter $"${t.title}" { page = $"process_${t.id}" } }
        }
      } }
    } }
    // Per-kind chapters — the starter's spine. Each is gated on its kind being
    // non-empty, listing every generated unit page beneath its index page so the
    // nav is usable out of the box and grows as you add content.
    wdoc_repeater { each = match len(concepts) { 0 => [], _ => [true] }  as = :_cg
      chapter "Concepts" { page = concepts_page
        wdoc_repeater { each = concepts  as = :c  chapter $"${c.name}" { page = $"concept_${c.id}" } }
      }
    }
    wdoc_repeater { each = match len(entities) { 0 => [], _ => [true] }  as = :_eg
      chapter "Entities" { page = entities_page
        wdoc_repeater { each = entities  as = :e  chapter $"${e.name}" { page = $"entity_${e.id}" } }
      }
    }
    wdoc_repeater { each = match len(facts) { 0 => [], _ => [true] }  as = :_fg
      chapter "Facts" { page = facts_page
        wdoc_repeater { each = facts  as = :f  chapter $"${f.title}" { page = $"fact_${f.id}" } }
      }
    }
    wdoc_repeater { each = match len(procedures) { 0 => [], _ => [true] }  as = :_pg
      chapter "Processes" { page = processes_page
        wdoc_repeater { each = procedures  as = :pr  chapter $"${pr.title}" { page = $"process_${pr.id}" } }
      }
    }
    chapter "Glossary"       { page = glossary_page }
  }
  // The Reference catalogue (the four units and the relationship graph) lives
  // behind a single pinned sidebar button — `reference_page` lists everything;
  // the unit / graph pages are still generated and reached from there and via
  // cross-links.
  sidebar_footer {
    button "Reference" { page = reference_page  icon = "lucide.chart-network" }
  }
}

// --- Overview / index / per-kind index pages --------------------------------
// The Overview, Reference, per-kind index and (below) Glossary pages live one
// per file under pages/ (imported above), each delegating to a component where
// shared. The generated per-unit pages stay here as repeaters.

// --- Concepts — one generated page per concept ------------------------------
// concepts_page (the index) lives in pages/concepts.wcl; each concept's body is
// generated below and appears as a TOC sub-entry.
wdoc_repeater { each = concepts  as = :c
  page $"concept_${c.id}" { title = $"${c.name}"
    concept_body { unit = c  examples = examples  all_units = all_units  backlinks = referenced_by(c.id)  layout = "columns" }
  }
}

// --- Entities — one page per entity (entities_page → pages/entities.wcl) -----
wdoc_repeater { each = entities  as = :e
  page $"entity_${e.id}" { title = $"${e.name}"
    entity_body { unit = e  examples = examples  all_units = all_units  backlinks = referenced_by(e.id)  layout = "columns" }
  }
}

// --- Facts — one page per fact (facts_page → pages/facts.wcl) ----------------
wdoc_repeater { each = facts  as = :f
  page $"fact_${f.id}" { title = $"${f.title}"
    fact_body { unit = f  examples = examples  all_units = all_units  backlinks = referenced_by(f.id)  layout = "columns" }
  }
}

// --- Reference — reference_page lives in pages/reference.wcl -----------------

// --- Processes — one generated page per procedure ---------------------------
// processes_page (the index) lives in pages/processes.wcl.
wdoc_repeater { each = procedures  as = :pr
  page $"process_${pr.id}" { title = $"${pr.title}"
    process_body { unit = pr  all_units = all_units  backlinks = referenced_by(pr.id)  layout = "columns" }
  }
}

// --- Indexes — curated groupings pinned into the nav tree (see the `toc`) -----
// An index does not render its own page in the book: it's a heading in the
// sidebar whose children are the unit pages it lists in `related` (plus nested
// sub-indexes). The `toc` block above wires this up; nothing is generated here.

// --- Glossary ---------------------------------------------------------------

page glossary_page {
  h1 "Glossary"
  wdoc_repeater { each = match len(terms) { 0 => [true], _ => [] }  as = :_n
    p "No glossary terms yet. Add `term` blocks in `data/reference/`."
  }
  wdoc_repeater { each = match len(terms) { 0 => [], _ => [true] }  as = :_g
    table {
      header = ["Term", "Definition", "Aliases"]
      rows = map(terms, fn(t: Term) -> list<utf8> { [t.term, t.definition, join(t.aliases, ", ")] })
    }
  }
}
WSK_WDOC_BOOK_MAIN_WCL
}

file "wdoc/skill/main.wcl" {
  content = <<'WSK_WDOC_SKILL_MAIN_WCL'
// Skill projection — a Claude Code skill folder over the wskill data model.
//
// Build:  wcl wdoc skill wdoc/skill/main.wcl --out out/skill
//
// The start page becomes SKILL.md (lean: topic summary, version pin, concept
// index, process menus, pointers to reference files).
// Every other page lands under references/. Like the book template it contains
// NO topic content — only projections, reusing the per-unit page components in
// wdoc/component/. When you add a typed extension block in schema/extensions.wcl,
// add a render section (search "TYPED EXTENSION", in references_ref below).

import <wdoc.wcl>
import "../../wskill.wcl"
import "../component/common.wcl"     // UnitRef + shared per-unit sub-sections
import "../component/concept.wcl"    // concept_body
import "../component/entity.wcl"     // entity_body
import "../component/fact.wcl"       // fact_body
import "../component/process.wcl"    // process_body

// The single topic block, bound from its gather list (see base.wcl).
let topic = head(topics)
let skill = head(skills)

// Skill artifacts are authored as children of the skill block (base.wcl).
let skill_scripts = skill.skill_scripts
let skill_assets  = skill.skill_assets

// Audience filter — keep the skill lean. Each `let` shadows the gathered list of
// the same name with its "both"/"ai" subset (dropping book-only blocks), so
// every projection below renders only what belongs in the skill.
let in_skill   = fn(a: Audience) -> bool { match a { :book => false, _ => true } }
let concepts   = filter(concepts,   fn(c: Concept)   -> bool { in_skill(c.audience) })
let entities   = filter(entities,   fn(e: Entity)    -> bool { in_skill(e.audience) })
let facts      = filter(facts,      fn(f: Fact)      -> bool { in_skill(f.audience) })
let terms      = filter(terms,      fn(t: Term)      -> bool { in_skill(t.audience) })
let examples   = filter(examples,   fn(x: Example)   -> bool { in_skill(x.audience) })
let indexes    = filter(indexes,    fn(x: Index)      -> bool { in_skill(x.audience) })
let child_indexes = filter(flatten(map(indexes, fn(x: Index) -> list<Index> { x.children })), fn(x: Index) -> bool { in_skill(x.audience) })
let all_indexes   = flatten([indexes, child_indexes])
let procedures = filter(procedures, fn(p: Procedure) -> bool { in_skill(p.audience) })

// Flattened cross-reference rows over the skill's audience-filtered units, so a
// unit's `related` ids resolve to links (UnitRef + the components live in
// component/common.wcl). The skill passes no `backlinks`, so the components'
// "Referenced by" section renders nothing here.
let all_units = flatten([
  map(concepts,   fn(c: Concept)   -> UnitRef { { id: c.id, name: c.name,  href: $"concept_${c.id}", related: c.related } }),
  map(entities,   fn(e: Entity)    -> UnitRef { { id: e.id, name: e.name,  href: $"entity_${e.id}",  related: e.related } }),
  map(facts,      fn(f: Fact)      -> UnitRef { { id: f.id, name: f.title, href: $"fact_${f.id}",    related: f.related } }),
  map(procedures, fn(p: Procedure) -> UnitRef { { id: p.id, name: p.title, href: $"process_${p.id}", related: p.related } }),
])

site skill {
  default_template = :ai_skill
  skill {
    name        = $"${topic.name}"
    description = $"Reference and processes for ${topic.name}. ${topic.summary} Use when working with ${topic.name} or answering questions about it."
    // license  = "MIT"   // optional; written to SKILL.md front matter
  }
}

// --- SKILL.md (start page) --------------------------------------------------

page index { sites = [:skill]  start = true
  // Static frontmatter: the base-schema version this wskill was built from. It is
  // a required field (always present), so reading it here is safe. The upstream
  // topic version lives in the body line below — it's hand-maintained in
  // wskill.wcl (bump it on updates), not stamped in.
  @schemaless frontmatter {
    wskill_schema_version = $"${schema_version}"
    // Skill frontmatter controls, from the skill block (empty/false = unrestricted).
    "allowed-tools"            = skill.allowed_tools
    "disallowed-tools"         = skill.disallowed_tools
    "disable-model-invocation" = skill.disable_model_invocation
  }

  h1 $"${topic.name}"
  p  $"${topic.summary}"
  wdoc_repeater { each = match topic.version { none => [], v => [v] }  as = :v
    p $"**Upstream version:** `${v}`. If the real upstream has moved past this, the skill may be stale — bump `topic.version` and re-verify (see the update workflow)."
  }

  // Custom summary details, pulled from the skill's `summary` sub-block (field reads,
  // not a body projection — works on the static start page).
  wdoc_repeater { each = skill.summary  as = :sm
    wdoc_repeater { each = sm.overview  as = :o  p $"${o}" }
  }

  // Invocation parameters (Claude Code placeholders $ARGUMENTS, $1, $2, …), pulled
  // from the skill block's `skill_param` sub-blocks.
  wdoc_repeater { each = match len(skill.parameters) { 0 => [], _ => [true] }  as = :_pmh
    h2 "Parameters"
    p  "Values to pass when invoking this skill — reference them as `$ARGUMENTS`, `$1`, `$2`, … in the prompt."
    table {
      header = ["Parameter", "Description", "How to determine the value"]
      rows = map(skill.parameters, fn(pp: SkillParam) -> list<utf8> { [pp.name, pp.description ?? "—", pp.value ?? "—"] })
    }
  }

  // Behavioural guardrails, rendered inside <Boundary> tags (hard rules for an agent).
  wdoc_repeater { each = skill.boundary  as = :bd
    p "<Boundary>"
    wdoc_repeater { each = match len(bd.always) { 0 => [], _ => [true] }  as = :_ba  p "**Always:**" }
    wdoc_repeater { each = bd.always  as = :it  p $"- ${it}" }
    wdoc_repeater { each = match len(bd.ask) { 0 => [], _ => [true] }  as = :_bk  p "**Ask first:**" }
    wdoc_repeater { each = bd.ask  as = :it  p $"- ${it}" }
    wdoc_repeater { each = match len(bd.never) { 0 => [], _ => [true] }  as = :_bn  p "**Never:**" }
    wdoc_repeater { each = bd.never  as = :it  p $"- ${it}" }
    p "</Boundary>"
  }

  h2 "Reference"
  // Curated index pages plus the per-kind reference indexes — all under references/.
  wdoc_repeater { each = indexes  as = :ix
    p $"- [${ix.name}](index_${ix.id})${match ix.summary { none => "", s => $" — ${s}" }}"
    wdoc_repeater { each = filter(ix.children, fn(x: Index) -> bool { in_skill(x.audience) })  as = :cix
      p $"  - [${cix.name}](index_${cix.id})${match cix.summary { none => "", s => $" — ${s}" }}"
    }
  }
  wdoc_repeater { each = match len(concepts)   { 0 => [], _ => [true] }  as = :_ci  p "- [Concepts](concepts_ref) — core ideas, one page each." }
  wdoc_repeater { each = match len(entities)   { 0 => [], _ => [true] }  as = :_ei  p "- [Entities](entities_ref) — concrete things in the topic." }
  wdoc_repeater { each = match len(facts)      { 0 => [], _ => [true] }  as = :_fi  p "- [Facts](facts_ref) — value tables and constants." }
  wdoc_repeater { each = match len(procedures) { 0 => [], _ => [true] }  as = :_pi  p "- [Processes](processes_ref) — task runbooks." }
  p "- [Glossary](glossary_ref) — terms and definitions."
  p "- [Related skills](related_ref) — cross-references to other wskills."
  wdoc_repeater { each = match len(flatten([match len(skill_scripts) { 0 => [], _ => [true] }, match len(skill_assets) { 0 => [], _ => [true] }])) { 0 => [], _ => [true] }  as = :_bf
    p "- [Bundled files](assets_ref) — scripts and data shipped with this skill."
  }
}

// --- Units: concept / entity / fact — index + per-unit page + body + related -
// Each unit's body is an addressable `body`, projected onto its own page;
// `related` ids resolve to links to the matching unit's page (any of the kinds).

page concepts_ref { sites = [:skill]
  h1 $"${topic.name} — concepts"
  p  "Each concept has its own page. This is the index."
  wdoc_repeater { each = concepts  as = :c
    p $"- [**${c.name}**](concept_${c.id}) — ${c.summary}"
  }
}
wdoc_repeater { each = concepts  as = :c
  page $"concept_${c.id}" { sites = [:skill]  title = $"${c.name}"
    concept_body { unit = c  examples = examples  all_units = all_units  backlinks = []
      p "[← All concepts](concepts_ref) · [← Back to SKILL.md](index)"
    }
  }
}

wdoc_repeater { each = match len(entities) { 0 => [], _ => [true] }  as = :_ei
  page entities_ref { sites = [:skill]
    h1 $"${topic.name} — entities"
    p  "Each entity has its own page. This is the index."
    wdoc_repeater { each = entities  as = :e
      p $"- [**${e.name}**](entity_${e.id}) — _${kind_text($"${e.kind}")}_${match e.summary { none => "", s => $" — ${s}" }}"
    }
  }
}
wdoc_repeater { each = entities  as = :e
  page $"entity_${e.id}" { sites = [:skill]  title = $"${e.name}"
    entity_body { unit = e  examples = examples  all_units = all_units  backlinks = []
      p "[← All entities](entities_ref) · [← Back to SKILL.md](index)"
    }
  }
}

wdoc_repeater { each = match len(facts) { 0 => [], _ => [true] }  as = :_fi
  page facts_ref { sites = [:skill]
    h1 $"${topic.name} — facts"
    p  "Each fact is a container of factual data on its own page. This is the index."
    wdoc_repeater { each = facts  as = :f
      p $"- [**${f.title}**](fact_${f.id})"
    }
  }
}
wdoc_repeater { each = facts  as = :f
  page $"fact_${f.id}" { sites = [:skill]  title = $"${f.title}"
    fact_body { unit = f  examples = examples  all_units = all_units  backlinks = []
      p "[← All facts](facts_ref) · [← Back to SKILL.md](index)"
    }
  }
}

// --- references/references.md -----------------------------------------------

page references_ref { sites = [:skill]
  h1 $"${topic.name} — reference"
  p  "The four units, plus examples and any typed-extension sections."
  wdoc_repeater { each = match len(concepts) { 0 => [], _ => [true] }  as = :_uc
    p $"- [**Concepts**](concepts_ref) — ${len(concepts)} ideas to understand."
  }
  wdoc_repeater { each = match len(entities) { 0 => [], _ => [true] }  as = :_ue
    p $"- [**Entities**](entities_ref) — ${len(entities)} concrete things in the topic's world."
  }
  wdoc_repeater { each = match len(facts) { 0 => [], _ => [true] }  as = :_uf
    p $"- [**Facts**](facts_ref) — ${len(facts)} values and value tables."
  }
  wdoc_repeater { each = match len(procedures) { 0 => [], _ => [true] }  as = :_up
    p $"- [**Processes**](processes_ref) — ${len(procedures)} runbooks for doing tasks."
  }

  // ---- TYPED EXTENSION BLOCKS render here ------------------------------------
  // The base schema has no generic table/custom block. Model topic-specific content
  // (lookup tables, cards, a CLI vocabulary) as typed @blocks in schema/extensions.wcl
  // and add their render here (and in the book template). Worked examples attach to a
  // unit via `example.unit` and render on that unit's page. See references/schema.md.
}

// --- references/assets.md + the shipped scripts/assets ----------------------

page assets_ref { sites = [:skill]
  h1 $"${topic.name} — bundled files"
  wdoc_repeater { each = match len(flatten([match len(skill_scripts) { 0 => [], _ => [true] }, match len(skill_assets) { 0 => [], _ => [true] }])) { 0 => [true], _ => [] }  as = :_n
    p "No files bundled with this skill."
  }

  wdoc_repeater { each = match len(skill_scripts) { 0 => [], _ => [true] }  as = :_s
    h2 "Scripts"
    p  "Runnable scripts shipped under the skill's `scripts/` directory."
  }
  wdoc_repeater { each = skill_scripts  as = :s
    h3 $"${s.name}"
    p  $"${s.description}"
    p  $"**Run:** `${s.usage}` — shipped to `scripts/${s.name}`."
    // Ships <source> into scripts/<name> (name = source's basename; exec bit preserved).
    file $"../../${s.source}" { dir = "scripts" }
  }

  wdoc_repeater { each = match len(skill_assets) { 0 => [], _ => [true] }  as = :_a
    h2 "Data files"
    p  "Static data shipped under `assets/`."
  }
  wdoc_repeater { each = skill_assets  as = :a
    h3 $"${a.name}"
    p  $"${a.description} — shipped to `assets/${a.name}`."
    file $"../../${a.source}" { dir = "assets" }
  }
}

// --- references/index_<id>.md — curated link-collection pages ---------------
wdoc_repeater { each = all_indexes  as = :ix
  page $"index_${ix.id}" { sites = [:skill]  title = $"${ix.name}"
    h1 $"${ix.name}"
    wdoc_repeater { each = match ix.summary { none => [], s => [s] }  as = :s  p $"_${s}_" }
    project { from = ix.body }
    wdoc_repeater { each = match len(ix.related) { 0 => [], _ => [true] }  as = :_r  h2 "Related" }
    wdoc_repeater { each = ix.related  as = :rid
      wdoc_repeater { each = filter(concepts, fn(x: Concept) -> bool { x.id == rid })  as = :t  p $"- [${t.name}](concept_${t.id})" }
      wdoc_repeater { each = filter(entities, fn(x: Entity)  -> bool { x.id == rid })  as = :t  p $"- [${t.name}](entity_${t.id})" }
      wdoc_repeater { each = filter(facts,    fn(x: Fact)    -> bool { x.id == rid })  as = :t  p $"- [${t.title}](fact_${t.id})" }
      wdoc_repeater { each = filter(procedures, fn(x: Procedure) -> bool { x.id == rid })  as = :t  p $"- [${t.title}](process_${t.id})" }
    }
  }
}

// --- references/processes.md ------------------------------------------------

page processes_ref { sites = [:skill]
  h1 $"${topic.name} — processes"
  p  "Each process is a runbook on its own page. This is the index."
  wdoc_repeater { each = procedures  as = :pr
    p $"- [**${pr.title}**](process_${pr.id}) — ${pr.purpose}"
  }
}
wdoc_repeater { each = procedures  as = :pr
  page $"process_${pr.id}" { sites = [:skill]  title = $"${pr.title}"
    process_body { unit = pr  all_units = all_units  step_style = "skill"  backlinks = []
      p "[← All processes](processes_ref) · [← Back to SKILL.md](index)"
    }
  }
}

// --- references/glossary.md -------------------------------------------------

page glossary_ref { sites = [:skill]
  h1 $"${topic.name} — glossary"
  wdoc_repeater { each = match len(terms) { 0 => [], _ => [true] }  as = :_g
    table {
      header = ["Term", "Definition", "Aliases"]
      rows = map(terms, fn(t: Term) -> list<utf8> { [t.term, t.definition, join(t.aliases, ", ")] })
    }
  }
}

// --- references/related.md --------------------------------------------------

page related_ref { sites = [:skill]
  h1 $"${topic.name} — related skills"
  wdoc_repeater { each = match len(refs) { 0 => [true], _ => [] }  as = :_n
    p "No related wskills declared."
  }
  wdoc_repeater { each = refs  as = :r
    p $"**${r.name}**${match r.relation { none => "", rel => $" — ${rel}" }} ${match r.status { "planned" => "_(planned — stub)_", _ => "" }}${match r.url { none => "", u => $" · ${u}" }}"
  }
}
WSK_WDOC_SKILL_MAIN_WCL
}

file "wdoc/presentation/main.wcl" {
  when    = answer("include_presentation") == "yes"
  content = <<'WSK_WDOC_PRESENTATION_MAIN_WCL'
// Presentation projection — a single-file overview deck over the wskill data.
//
// Build:  wcl wdoc build wdoc/presentation/main.wcl --out out/presentation
//
// Like the book/skill templates this contains NO topic content — only
// projections over the `presentation` data (schema/presentation.wcl, authored
// under data/presentation/). The deck opens with a generated title slide from
// `topic`; every authored `pres_slide` becomes one slide. A slide that names a
// `unit` pulls that concept/entity/fact/procedure's headline + summary onto
// the slide (its `body`, if any, renders below); the reference detail stays in
// the book.

import <wdoc.wcl>
import "../../wskill.wcl"

// The single topic / presentation block, bound from their gather lists.
let topic = head(topics)

// Every authored slide, in deck order (sections in authored order).
let all_slides = flatten(map(presentations, fn(pr: Presentation) -> list<PresSlide> {
  flatten(map(pr.sections, fn(sec: PresSection) -> list<PresSlide> { sec.slides }))
}))

// Featured-unit lookup: unit id -> [{ name, summary }] (empty when the id
// matches no unit, so a stale reference degrades to an empty pull, not an error).
type UnitHead { name: utf8  summary: utf8 }
let featured = fn(uid: identifier) -> list<UnitHead> { flatten([
  map(filter(concepts,   fn(c: Concept)   -> bool { c.id == uid }), fn(c: Concept)   -> UnitHead { { name: c.name,  summary: c.summary } }),
  map(filter(entities,   fn(e: Entity)    -> bool { e.id == uid }), fn(e: Entity)    -> UnitHead { { name: e.name,  summary: e.summary ?? "" } }),
  map(filter(facts,      fn(f: Fact)      -> bool { f.id == uid }), fn(f: Fact)      -> UnitHead { { name: f.title, summary: "" } }),
  map(filter(procedures, fn(p: Procedure) -> bool { p.id == uid }), fn(p: Procedure) -> UnitHead { { name: p.title, summary: p.purpose } }),
]) }

// --- site --------------------------------------------------------------------

site deck {
  default_template = :presentation
  title = $"${topic.name}"
  theme = :nord
  deck {
    section "Overview" { slide title_slide }
    wdoc_repeater { each = presentations  as = :pr
      wdoc_repeater { each = pr.sections  as = :sec
        section $"${sec.title}" {
          wdoc_repeater { each = sec.slides  as = :s  slide $"pres_${s.id}" }
        }
      }
    }
  }
}

// --- generated slides ---------------------------------------------------------

page title_slide { sites = [:deck]
  h1 $"${topic.name}"
  wdoc_repeater { each = presentations  as = :pr
    wdoc_repeater { each = match pr.summary { none => [topic.summary], su => [su] }  as = :su
      p $"${su}"
    }
  }
}

wdoc_repeater { each = all_slides  as = :s
  page $"pres_${s.id}" { sites = [:deck]
    // Heading: the explicit title, else the featured unit's name.
    wdoc_repeater { each = match s.title { none => [], t => [t] }  as = :t  h2 $"${t}" }
    wdoc_repeater { each = match s.unit { none => [], u => featured(u) }  as = :fu
      wdoc_repeater { each = match s.title { none => [fu.name], _ => [] }  as = :n  h2 $"${n}" }
      wdoc_repeater { each = match fu.summary { "" => [], su => [su] }  as = :su  p $"_${su}_" }
    }
    wdoc_repeater { each = match s.body { none => [], b => [true] }  as = :_b
      project { from = s.body }
    }
    wdoc_repeater { each = match s.speaker_notes { none => [], n => [n] }  as = :n
      notes { p $"${n}" }
    }
  }
}
WSK_WDOC_PRESENTATION_MAIN_WCL
}

file "wdoc/training/main.wcl" {
  when    = answer("include_training") == "yes"
  content = <<'WSK_WDOC_TRAINING_MAIN_WCL'
// Training projection — a tutorial-series book over the wskill's lessons.
//
// Build:  wcl wdoc build wdoc/training/main.wcl --out out/training
//
// A separate `:book` site rendering the `lesson` / `module` data
// (schema/training.wcl, authored under data/training/). The syllabus (start
// page + toc) orders top-level lessons first, then each module's lessons;
// every lesson gets its own page with objectives, prerequisites, the projected
// body, its exercises (task → starter code → expected result → hint), and
// links back into the reference book for the units it teaches.

import <wdoc.wcl>
import "../../wskill.wcl"

let topic = head(topics)

// Ordering: lessons by `n` (top-level course lessons first, then each sorted
// module's lessons, module-major).
let by_lesson_n    = fn(l: Lesson) -> u32 { l.n }
let course_lessons = sort_by(lessons, by_lesson_n)
let sorted_modules = sort_by(modules, fn(m: TrainingModule) -> u32 { m.n })
let all_lessons    = flatten([course_lessons, flatten(map(sorted_modules,
                       fn(m: TrainingModule) -> list<Lesson> { sort_by(m.lessons, by_lesson_n) }))])

// A lesson id resolved to a syllabus link (empty when unknown, so a stale
// prerequisite degrades to nothing rather than an error).
let lesson_link = fn(lid: identifier) -> list<utf8> {
  map(filter(all_lessons, fn(x: Lesson) -> bool { x.id == lid }),
      fn(x: Lesson) -> utf8 { $"[${x.title}](lesson_${x.id})" })
}

// --- site --------------------------------------------------------------------

site training {
  default_template = :book
  title   = $"${topic.name} — training"
  summary = $"A hands-on tutorial series for ${topic.name}."
  root         = true
  theme        = :nord
  theme_toggle = true
  search       = true
  toc {
    chapter "Start here" { page = index }
    wdoc_repeater { each = course_lessons  as = :l
      chapter $"${l.n}. ${l.title}" { page = $"lesson_${l.id}" }
    }
    wdoc_repeater { each = sorted_modules  as = :m
      chapter $"${m.title}" {
        wdoc_repeater { each = sort_by(m.lessons, by_lesson_n)  as = :l
          chapter $"${l.n}. ${l.title}" { page = $"lesson_${l.id}" }
        }
      }
    }
  }
}

// --- syllabus (start page) ----------------------------------------------------

page index { start = true
  h1 $"${topic.name} — training"
  p  $"${topic.summary}"
  p  "Work through the lessons in order — each builds on the previous one, and every lesson ends with exercises you can check against the expected results."

  wdoc_repeater { each = match len(course_lessons) { 0 => [], _ => [true] }  as = :_cl
    h2 "Lessons"
    wdoc_repeater { each = course_lessons  as = :l
      p $"${l.n}. [${l.title}](lesson_${l.id})${match l.summary { none => "", s => $" — ${s}" }}"
    }
  }
  wdoc_repeater { each = sorted_modules  as = :m
    h2 $"${m.title}"
    wdoc_repeater { each = match m.summary { none => [], s => [s] }  as = :s  p $"_${s}_" }
    wdoc_repeater { each = sort_by(m.lessons, by_lesson_n)  as = :l
      p $"${l.n}. [${l.title}](lesson_${l.id})${match l.summary { none => "", s => $" — ${s}" }}"
    }
  }
}

// --- lesson pages --------------------------------------------------------------

wdoc_repeater { each = all_lessons  as = :l
  page $"lesson_${l.id}" { title = $"${l.title}"
    h1 $"${l.n}. ${l.title}"
    wdoc_repeater { each = match l.summary { none => [], s => [s] }  as = :s  p $"_${s}_" }

    wdoc_repeater { each = match len(l.objectives) { 0 => [], _ => [true] }  as = :_ob
      callout "After this lesson you can" { class = ["info"]
        body = join(map(l.objectives, fn(o: utf8) -> utf8 { $"- ${o}" }), "\n")
      }
    }
    wdoc_repeater { each = match len(l.prerequisites) { 0 => [], _ => [true] }  as = :_pr
      p $"**Before you start:** ${join(flatten(map(l.prerequisites, lesson_link)), " · ")}"
    }

    wdoc_repeater { each = match l.body { none => [], b => [true] }  as = :_b
      project { from = l.body }
    }

    wdoc_repeater { each = l.exercises  as = :ex
      h2 $"Exercise: ${ex.title}"
      p $"${ex.task}"
      wdoc_repeater { each = match ex.code { none => [], c => [c] }  as = :c
        code $"${ex.code_lang ?? "text"}" { source = c }
      }
      wdoc_repeater { each = match ex.body { none => [], b => [true] }  as = :_b
        project { from = ex.body }
      }
      wdoc_repeater { each = match ex.expected { none => [], e => [e] }  as = :e
        callout "Expected result" { class = ["success"]  body = $"${e}" }
      }
      wdoc_repeater { each = match ex.hint { none => [], h => [h] }  as = :h
        callout "Hint" { class = ["warning"]  body = $"${h}" }
      }
    }
  }
}
WSK_WDOC_TRAINING_MAIN_WCL
}

file "wskill.wcl" {
  content = $<<WSK_WSKILL_WCL
// ${answer("topic_name")} — wskill root document.
//
// Single entry point: declares the topic (subject + metadata) and sources, and
// includes the data files. `wcl check wskill.wcl` validates the whole model.
// The wdoc template sets in wdoc/ project this model into the book and skill.

import <wdoc.wcl>
import "./schema/base.wcl"
import "./schema/extensions.wcl"
import "./schema/presentation.wcl"     // the overview-deck view (author data/presentation/)
import "./schema/training.wcl"         // the tutorial-series view (author data/training/)

// Data — split into more files by area as the wskill grows, adding
// an import line per file. Keep templates (wdoc/) free of topic content.
import "./data/reference/reference.wcl"
import "./data/processes/processes.wcl"
${match answer("include_presentation") { "yes" => "", _ => "// " }}import "./data/presentation/main.wcl"
${match answer("include_training") { "yes" => "", _ => "// " }}import "./data/training/main.wcl"

schema_version = "1.0.0"

topic ${answer("topic_id")} {
  name    = "${answer("topic_name")}"
  summary = "${answer("topic_summary")}"
  // version = "0.0.0"          // pin the upstream version, where the topic has one
  created = "${answer("date")}"
  // maintainer = "you@example.com"
}

// The views this wskill ships — first-class data the overview and any registry
// landing can enumerate. Declaring one documents it; the just recipes build
// them. The optional views (deck / training) ship once uncommented AND
// authored (data/presentation/, data/training/).
artifact book     { kind = :book      entry = "wdoc/book/main.wcl"   output = "out/book" }
artifact ai_skill { kind = :ai_skill  entry = "wdoc/skill/main.wcl"  output = "out/skill" }
${match answer("include_presentation") { "yes" => "", _ => "// " }}artifact slides   { kind = :presentation  entry = "wdoc/presentation/main.wcl"  output = "out/presentation" }
${match answer("include_training") { "yes" => "", _ => "// " }}artifact training { kind = :training      entry = "wdoc/training/main.wcl"      output = "out/training" }

// Skill-projection config — written into SKILL.md frontmatter. The defaults (no
// tool pre-approval, model may invoke) are safe; pre-approve tools if needed.
// Bundle real files into the emitted skill as script / asset CHILDREN of this block
// (the scaffold ships matching example files under skill/). `source` is where the
// file comes from (its path under the wskill root); `name` is the filename it ships
// as in the rendered skill (the basename of source).
wcl.wskill::skill {
  // allowed_tools = ["Bash"]

  // script example {
  //   source      = "skill/scripts/example.sh"   // where it comes from
  //   name        = "example.sh"                 // filename in the rendered skill
  //   description = "What it does and when to run it."
  //   usage       = "scripts/example.sh"
  // }

  // asset example_data {
  //   source      = "skill/assets/data.json"
  //   name        = "data.json"
  //   description = "Static data the skill relies on."
  // }
}

// Sources describe where current information lives — they drive the update
// workflow only and are never rendered as content. Add one per upstream source.
//
// source upstream_docs {
//   kind         = "docs"
//   locator      = "https://example.com/docs"
//   covers       = "Reference for the whole topic."
//   last_checked = "${answer("date")}"
// }

// Cross-references to other wskills (status = "exists" | "planned").
//
// wskill_ref related {
//   name     = "other-topic"
//   relation = "see also"
//   status   = "planned"
// }
WSK_WSKILL_WCL
}
