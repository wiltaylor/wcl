// The `wskill-registry` built-in template: scaffold a collection root that
// holds many wskills under wskills/ with an auto-discovering landing page.
// Ported from the wskill project's collection-scaffold tree.
//
//   wcl init wskill-registry ./my-registry

import <scaffold.wcl>

property "collection_id" {
  prompt  = "Collection id (an identifier)"
  default = "registry"
}

property "collection_name" {
  prompt  = "Collection name"
  default = "Registry"
}

folder "wskills" {
}

file ".gitignore" {
  content = <<'WSK__GITIGNORE'
# Generated deploy tree — regenerate with `just build`.
# Delete these lines if you want to commit the rendered site.
/out/
WSK__GITIGNORE
}

file "README.md" {
  content = $<<WSK_README_MD
# ${answer("collection_name")} — a wskill collection

A **collection repo**: one folder whose member [wskills](https://) live under a
`wskills/` subdirectory, with a top-level **landing page** that links down to each
member's book. Use it to publish a whole shelf of wskills as one hostable site.

## Layout

```
collection.wcl        # the collection block (name, summary, intro) + imports
schema/collection.wcl # collection block type (DO NOT hand-edit)
wdoc/page/main.wcl    # the landing-page template (auto-discovers members)
wskills/<topic>/      # a member wskill (a full self-contained wskill folder)
out/site/             # generated deploy tree (gitignored)
```

## Adding a wskill

Drop a wskill folder into the `wskills/` subdirectory (scaffold one with the WSKILL
skill, or copy an existing wskill in). The build discovers it automatically — its
`topic` name and summary become its entry on the landing page. Nothing to register
by hand.

## Build

Building uses `wcl wdoc` directly — there is no build script and no member list to
maintain. The landing page's `include` auto-discovers every wskill under `wskills/`
and builds its book; one command builds the whole deploy tree:

```bash
wcl wdoc build wdoc/page/main.wcl --out out/site   # landing + every member book
```

`out/site/` is a single static site you can host anywhere: `index.html` is the
landing page; each member's book sits under `out/site/wskills/<topic>/`.

```bash
just build               # landing + every member book
just serve               # build, then serve the landing + every member book
just clean               # remove out/
```

## Editing

Edit the hero copy in `collection.wcl`. Members are auto-discovered — just drop a
wskill folder under `wskills/` (or remove one) and re-run the build; the landing
links and member books update from each member's book site. Never hand-edit `out/`.
WSK_README_MD
}

file "collection.wcl" {
  content = $<<WSK_COLLECTION_WCL
// ${answer("collection_name")} — a wskill collection.
//
// This is the top of a *collection repo*: a folder holding many wskills as
// sibling subfolders, with a landing page (wdoc/page/main.wcl) that links down to
// each member's book. Author the collection block below; the member list is
// generated — drop a wskill folder in and re-run the build.
//
//   wcl wdoc build wdoc/page/main.wcl --out out/site   # landing + every member book
//   wcl wdoc serve wdoc/page/main.wcl   # preview the landing (after a build)

import <wdoc.wcl>
import "./schema/collection.wcl"

schema_version = "1.0.0"

collection ${answer("collection_id")} {
  name    = "${answer("collection_name")}"
  summary = "A collection of wskills."
  description = <<END
A longer introduction to this collection, shown under the hero on the landing
page. Describe what these wskills have in common and who they are for.
END
}
WSK_COLLECTION_WCL
}

file "justfile" {
  content = $<<WSK_JUSTFILE
# ${answer("collection_name")} collection — build recipes.
#
# Members live under wskills/. The landing page's `include` auto-discovers them and
# builds each book in one command. There is no build script and no member list to
# maintain.

[default, private]
main:
	@just --list

# Build the deploy tree: landing page + every member book under wskills/
[group('render')]
build:
	wcl wdoc build wdoc/page/main.wcl --out out/site

# Serve the landing page and every member book under it (build first)
[group('render')]
serve: build
	wcl wdoc serve wdoc/page/main.wcl --out out/site

# Remove generated output
[group('clean')]
clean:
	rm -rf out
WSK_JUSTFILE
}

file "schema/collection.wcl" {
  content = <<'WSK_SCHEMA_COLLECTION_WCL'
// Collection schema — ships with the WSKILL skill's collection scaffold.
//
// DO NOT HAND-EDIT. This defines the data model for a *collection repo*: a folder
// holding many wskills as siblings, with a top-level landing page that links down
// to each member's book. Like a wskill's base.wcl, this schema travels with the
// collection so the landing page renders without the WSKILL skill present.
//
// Field decorators (@default, @inline, @children) are PREFIX.
//
// All collection declarations live in the `wcl.wskill` namespace (shared with the
// wskill base schema). Importers keep using bare names — a relative import auto-joins
// this namespace to the bare-name search path.
namespace wcl.wskill

import <wdoc.wcl>

// ---------------------------------------------------------------------------
// Collection (one per collection repo)
// ---------------------------------------------------------------------------

// Repository-level metadata for the landing page (authored once in collection.wcl).
@block("collection")
type Collection {
  @inline(0) id: identifier
  name:        utf8              // human title, e.g. "My Tools"
  summary:     utf8              // one-line description shown under the hero
  description: utf8?             // longer intro (heredoc)
  @default([]) tags: list<utf8>
}

// ---------------------------------------------------------------------------
// Members (auto-generated — never hand-edited)
// ---------------------------------------------------------------------------

// (Legacy) member record. Members are now auto-discovered by the landing page's
// `include` + `included_sites`; this block type is unused but kept for compatibility.
// it scans the sibling wskill folders and copies each topic's name + summary here,
// with `href` pointing at that member's book inside the rendered deploy tree.
@block("member")
type Member {
  @inline(0) id: identifier
  name:    utf8                  // member's topic.name
  summary: utf8                  // member's topic.summary
  href:    utf8                  // relative link to its book, e.g. "./ls/"
}

// ---------------------------------------------------------------------------
// Root document — gathers the collection block + every member
// ---------------------------------------------------------------------------

// Merges with wdoc's library @document (so `site` / `page` template blocks are
// legal alongside the data).
@document
type CollectionDoc {
  schema_version: utf8
  @children("collection") collections: list<Collection>
  @children("member")     members:     list<Member>
}
WSK_SCHEMA_COLLECTION_WCL
}

file "wdoc/page/main.wcl" {
  content = <<'WSK_WDOC_PAGE_MAIN_WCL'
// Collection landing page — a wskill registry rendered in the Forge design.
//
// Build:  wcl wdoc build wdoc/page/main.wcl --out out/site
//   The `include` below builds each member wskill's book into out/site/wskills/<name>/
//   (entry mode: only each member's wdoc/book/main.wcl, no recursion into out/ or
//   bundled trees), and `included_sites(...)` discovers the same set for the cards —
//   so there is no member list to maintain and one command builds everything.
//
// The HTML projection uses a bespoke `registry` template (a topbar + hero + live
// search + a card grid, scoped under `.wsk-root`). The page body below is the
// Markdown / PDF fallback (templates are HTML-only) and lists the same members.

import <wdoc.wcl>
import "../../collection.wcl"

// Build every member book as a sub-site under out/site/wskills/<name>/.
include "../../wskills" { entry = "wdoc/book/main.wcl" }

// Members that ship the optional views — the entry file exists only when a
// member ships that view — built as extra sub-sites under decks/ / training/
// (`prefix` keeps them clear of the book output).
include "../../wskills" { entry = "wdoc/presentation/main.wcl"  prefix = "decks" }
include "../../wskills" { entry = "wdoc/training/main.wcl"      prefix = "training" }

// The single collection block, bound from its gather list (head(...) resolves
// omitted optional fields — the same pattern wskill templates use for topic).
let coll = head(collections)

// Every member wskill, discovered + built by the `include` above. Each record is
// { name, href, title, summary? } (href root-relative; title falls back to name).
let wskills = included_sites({ folder: "../../wskills", entry: "wdoc/book/main.wcl" })

// The optional views per member (empty lists when nobody ships one). A card
// adds a deck / course link only for members present here.
let decks     = included_sites({ folder: "../../wskills", entry: "wdoc/presentation/main.wcl", prefix: "decks" })
let trainings = included_sites({ folder: "../../wskills", entry: "wdoc/training/main.wcl", prefix: "training" })
let deck_link = fn(n: utf8) -> utf8 join(map(filter(decks, fn(d: IncludeEntry) -> bool { d.name == n }),
  fn(d: IncludeEntry) -> utf8 { $"<a class='wsk-view' href='./${d.href}'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><rect x='2' y='4' width='20' height='14' rx='2'></rect><line x1='8' y1='22' x2='16' y2='22'></line><line x1='12' y1='18' x2='12' y2='22'></line></svg>deck</a>" }), "")
let training_link = fn(n: utf8) -> utf8 join(map(filter(trainings, fn(t: IncludeEntry) -> bool { t.name == n }),
  fn(t: IncludeEntry) -> utf8 { $"<a class='wsk-view' href='./${t.href}'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M22 10v6M2 10l10-5 10 5-10 5z'></path><path d='M6 12v5c3 3 9 3 12 0v-5'></path></svg>course</a>" }), "")

// One registry card per member. `$<<` interpolates the slots; `summary` is
// optional, so a `match` folds it onto the description when present.
let card = fn(s: IncludeEntry) -> utf8 $<<CARD
<article class="wsk-card" data-search="${s.name} ${s.title}${match s.summary { none => "", su => $" ${su}" }}">
  <a class="wsk-cover" href="./${s.href}"><span class="wsk-cover-name">${s.name}</span><span class="wsk-kindtag">wskill</span></a>
  <div class="wsk-card-body">
    <a class="wsk-name" href="./${s.href}">${s.name}</a>
    <p class="wsk-desc">${s.title}${match s.summary { none => "", su => $" — ${su}" }}</p>
  </div>
  <div class="wsk-card-foot">
    ${deck_link(s.name)}${training_link(s.name)}<a class="wsk-view" href="./${s.href}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>book</a>
  </div>
</article>
CARD

let cards_html = join(map(wskills, card), "\n")

// ---- the Forge design system, scoped to .wsk-root (dark default + light) -----
// Structured selectors rendered into a page <style> by `css_style`.
style "registry_css" {
  class "wsk-root" {
    nest "*" { css = "box-sizing:border-box;" }
  }
  class "wsk-root" { css = "--bg-0:#0B0D10;--bg-1:#11141A;--bg-2:#171B22;--bg-3:#1E232C;--bg-4:#252B36;\n  --fg-0:#ECEEF2;--fg-1:#B7BDC8;--fg-2:#7C8593;--fg-3:#4E5664;\n  --border-subtle:#1A1F27;--border:#262C36;--border-strong:#3A4250;\n  --accent:oklch(0.62 0.16 250);--accent-hover:oklch(0.66 0.17 250);--accent-press:oklch(0.56 0.16 250);\n  --accent-bg:oklch(0.62 0.16 250 / 0.14);--accent-fg:oklch(0.82 0.13 250);--accent-contrast:#fff;\n  --success:oklch(0.68 0.14 150);--warning:oklch(0.78 0.14 75);--info:oklch(0.68 0.13 230);\n  --font-sans:'IBM Plex Sans',ui-sans-serif,system-ui,sans-serif;\n  --font-mono:'JetBrains Mono',ui-monospace,Menlo,Consolas,monospace;\n  --fs-xs:11px;--fs-sm:12px;--fs-base:14px;--fs-md:16px;--fs-lg:18px;--fs-xl:22px;--fs-2xl:28px;--fs-3xl:34px;\n  --lh-relaxed:1.65;--fw-regular:400;--fw-medium:500;--fw-semibold:600;\n  --tracking-tight:-0.01em;--tracking-wide:0.04em;--tracking-eyebrow:0.08em;\n  --sp-1:4px;--sp-2:8px;--sp-3:12px;--sp-4:16px;--sp-5:20px;--sp-6:24px;--sp-8:32px;--sp-10:40px;--sp-12:48px;--sp-16:64px;\n  --r-sm:4px;--r-md:6px;--r-lg:8px;--r-pill:999px;\n  --ease-out:cubic-bezier(0.2,0,0,1);--dur-1:80ms;\n  background:var(--bg-0);color:var(--fg-0);font-family:var(--font-sans);font-size:var(--fs-base);line-height:1.5;\n  min-height:100vh;-webkit-font-smoothing:antialiased;font-feature-settings:'cv02','cv03','cv04','cv11';" }
  media "(prefers-color-scheme: light)" {
    class "wsk-root" {
      nest "&:not([data-theme=\"dark\"])" { css = "--bg-0:#FAFAFA;--bg-1:#FFFFFF;--bg-2:#F4F5F7;--bg-3:#EAECEF;--bg-4:#FFFFFF;\n    --fg-0:#0C0F14;--fg-1:#3D4654;--fg-2:#6B7383;--fg-3:#A0A6B2;\n    --border-subtle:#EEF0F3;--border:#DCDFE4;--border-strong:#B6BBC4;\n    --accent:oklch(0.52 0.18 250);--accent-hover:oklch(0.46 0.19 250);--accent-press:oklch(0.40 0.19 250);\n    --accent-bg:oklch(0.55 0.17 250 / 0.14);--accent-fg:oklch(0.38 0.19 250);" }
    }
  }
  class "wsk-root" {
    nest "&[data-theme=\"light\"]" { css = "--bg-0:#FAFAFA;--bg-1:#FFFFFF;--bg-2:#F4F5F7;--bg-3:#EAECEF;--bg-4:#FFFFFF;\n  --fg-0:#0C0F14;--fg-1:#3D4654;--fg-2:#6B7383;--fg-3:#A0A6B2;\n  --border-subtle:#EEF0F3;--border:#DCDFE4;--border-strong:#B6BBC4;\n  --accent:oklch(0.52 0.18 250);--accent-hover:oklch(0.46 0.19 250);--accent-press:oklch(0.40 0.19 250);\n  --accent-bg:oklch(0.55 0.17 250 / 0.14);--accent-fg:oklch(0.38 0.19 250);" }
  }
  base ".wsk-root::selection,.wsk-root *::selection" { css = "background:var(--accent-bg);color:var(--fg-0);" }
  class "wsk-root" {
    nest "a" { css = "text-decoration:none;color:inherit;" }
  }
  class "wsk-topbar" { css = "position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;height:56px;padding:0 var(--sp-6);border-bottom:1px solid var(--border);background:color-mix(in srgb,var(--bg-0) 80%,transparent);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);" }
  class "wsk-brandwrap" { css = "display:flex;align-items:center;gap:var(--sp-3);" }
  class "wsk-mark" { css = "width:26px;height:26px;color:var(--fg-0);" }
  class "wsk-brand" { css = "font-family:var(--font-mono);font-size:var(--fs-md);font-weight:var(--fw-medium);color:var(--fg-0);letter-spacing:var(--tracking-tight);" }
  class "wsk-brand" {
    nest ".wsk-reg" { css = "color:var(--fg-2);font-weight:var(--fw-regular);" }
  }
  class "wsk-navlinks" { css = "display:flex;align-items:center;gap:var(--sp-5);" }
  class "wsk-navlink" { css = "font-size:var(--fs-sm);color:var(--fg-2);" }
  class "wsk-navlink" {
    nest "&:hover" { css = "color:var(--fg-0);" }
  }
  class "wsk-iconbtn" { css = "display:flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:var(--r-sm);border:1px solid var(--border);background:var(--bg-1);color:var(--fg-1);cursor:pointer;transition:border-color var(--dur-1) var(--ease-out),background var(--dur-1) var(--ease-out);" }
  class "wsk-iconbtn" {
    nest "&:hover" { css = "border-color:var(--border-strong);background:var(--bg-2);color:var(--fg-0);" }
  }
  class "wsk-iconbtn" {
    nest "svg" { css = "width:16px;height:16px;" }
  }
  class "wsk-page" { css = "max-width:1200px;margin:0 auto;padding:var(--sp-12) var(--sp-6) var(--sp-16);" }
  class "wsk-hero" { css = "display:flex;flex-direction:column;gap:var(--sp-4);max-width:680px;margin-bottom:var(--sp-10);" }
  class "wsk-eyebrow" { css = "font-size:var(--fs-xs);font-weight:var(--fw-semibold);letter-spacing:var(--tracking-eyebrow);text-transform:uppercase;color:var(--fg-2);" }
  class "wsk-herotitle" { css = "font-size:var(--fs-3xl);font-weight:var(--fw-semibold);letter-spacing:var(--tracking-tight);margin:0;line-height:1.1;" }
  class "wsk-herosub" { css = "font-size:var(--fs-md);color:var(--fg-1);line-height:var(--lh-relaxed);margin:0;" }
  class "wsk-herostat" { css = "font-size:var(--fs-sm);color:var(--fg-2);font-variant-numeric:tabular-nums;" }
  class "wsk-herostat" {
    nest "b" { css = "color:var(--fg-1);font-weight:var(--fw-medium);" }
  }
  class "wsk-search" { css = "position:relative;margin-top:var(--sp-2);max-width:440px;" }
  class "wsk-search" {
    nest "svg" { css = "position:absolute;left:12px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:var(--fg-2);" }
  }
  class "wsk-searchinput" { css = "width:100%;height:40px;padding:0 var(--sp-4) 0 38px;background:var(--bg-1);border:1px solid var(--border);border-radius:var(--r-sm);color:var(--fg-0);font-family:var(--font-sans);font-size:var(--fs-base);outline:none;transition:border-color var(--dur-1) var(--ease-out);" }
  class "wsk-searchinput" {
    nest "&::placeholder" { css = "color:var(--fg-3);" }
  }
  class "wsk-searchinput" {
    nest "&:focus" { css = "border-color:var(--accent);" }
  }
  class "wsk-cards" { css = "display:grid;grid-template-columns:repeat(auto-fill,minmax(360px,1fr));gap:var(--sp-5);" }
  class "wsk-card" { css = "display:flex;flex-direction:column;background:var(--bg-1);border:1px solid var(--border);border-radius:var(--r-md);overflow:hidden;transition:border-color var(--dur-1) var(--ease-out),background var(--dur-1) var(--ease-out);" }
  class "wsk-card" {
    nest "&:hover" { css = "border-color:var(--border-strong);background:var(--bg-2);" }
  }
  class "wsk-cover" { css = "position:relative;display:flex;align-items:center;height:128px;padding:0 var(--sp-5);background-color:var(--bg-2);background-image:radial-gradient(var(--border) 1px,transparent 1px);background-size:14px 14px;border-bottom:1px solid var(--border-subtle);" }
  class "wsk-card" {
    nest "&:hover .wsk-cover" { css = "background-color:var(--bg-3);" }
  }
  class "wsk-cover-name" { css = "font-family:var(--font-mono);font-size:var(--fs-2xl);font-weight:var(--fw-medium);color:var(--fg-0);letter-spacing:var(--tracking-tight);" }
  class "wsk-cover-name" {
    nest "&::before" { css = "content:\"/\";color:var(--fg-3);margin-right:2px;" }
  }
  class "wsk-kindtag" { css = "position:absolute;top:var(--sp-3);right:var(--sp-3);font-family:var(--font-mono);font-size:var(--fs-xs);color:var(--fg-2);letter-spacing:var(--tracking-wide);text-transform:uppercase;" }
  class "wsk-card-body" { css = "display:flex;flex-direction:column;gap:var(--sp-3);padding:var(--sp-5);flex:1;" }
  class "wsk-name" { css = "font-family:var(--font-mono);font-size:var(--fs-md);font-weight:var(--fw-medium);color:var(--fg-0);" }
  class "wsk-name" {
    nest "&:hover" { css = "color:var(--accent-fg);" }
  }
  class "wsk-desc" { css = "font-size:var(--fs-sm);color:var(--fg-1);line-height:var(--lh-relaxed);text-wrap:pretty;margin:0;" }
  class "wsk-card-foot" { css = "display:flex;align-items:center;justify-content:flex-end;gap:var(--sp-3);padding:var(--sp-3) var(--sp-5);border-top:1px solid var(--border-subtle);" }
  class "wsk-view" { css = "display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 var(--sp-2);border-radius:var(--r-sm);font-size:var(--fs-xs);font-weight:var(--fw-medium);color:var(--fg-1);border:1px solid transparent;transition:background var(--dur-1) var(--ease-out),color var(--dur-1) var(--ease-out),border-color var(--dur-1) var(--ease-out);" }
  class "wsk-view" {
    nest "svg" { css = "width:13px;height:13px;" }
  }
  class "wsk-view" {
    nest "&:hover" { css = "background:var(--bg-3);border-color:var(--border);color:var(--fg-0);" }
  }
  class "wsk-empty" { css = "grid-column:1/-1;display:none;flex-direction:column;align-items:center;gap:var(--sp-2);padding:var(--sp-16) 0;text-align:center;" }
  class "wsk-empty" {
    nest "&.on" { css = "display:flex;" }
  }
  class "wsk-empty" {
    nest "h4" { css = "color:var(--fg-1);font-weight:var(--fw-medium);margin:0;" }
  }
  class "wsk-empty" {
    nest "p" { css = "font-size:var(--fs-sm);color:var(--fg-2);margin:0;" }
  }
  class "wsk-root" {
    nest ".ico-moon" { css = "display:none;" }
  }
  class "wsk-root" {
    nest ".ico-sun" { css = "display:inline-flex;" }
  }
  media "(prefers-color-scheme: light)" {
    class "wsk-root" {
      nest "&:not([data-theme=\"dark\"]) .ico-sun" { css = "display:none;" }
    }
    class "wsk-root" {
      nest "&:not([data-theme=\"dark\"]) .ico-moon" { css = "display:inline-flex;" }
    }
  }
  class "wsk-root" {
    nest "&[data-theme=\"dark\"] .ico-sun" { css = "display:inline-flex;" }
  }
  class "wsk-root" {
    nest "&[data-theme=\"dark\"] .ico-moon" { css = "display:none;" }
  }
  class "wsk-root" {
    nest "&[data-theme=\"light\"] .ico-sun" { css = "display:none;" }
  }
  class "wsk-root" {
    nest "&[data-theme=\"light\"] .ico-moon" { css = "display:inline-flex;" }
  }
  media "(prefers-reduced-motion: reduce)" {
    class "wsk-root" {
      nest "*" { css = "transition-duration:.01ms!important;" }
    }
  }
}

// ---- topbar + hero + open card grid (needs coll / count → interpolating) -----
let registry_top = $<<HTML
<div class="wsk-root">
  <header class="wsk-topbar">
    <div class="wsk-brandwrap">
      <svg class="wsk-mark" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9 L26 9 L22 15 L10 15 Z"></path><path d="M4 19 L28 19 L24 25 L8 25 Z"></path><line x1="16" y1="15" x2="16" y2="19"></line></svg>
      <span class="wsk-brand">wskill<span class="wsk-reg"> registry</span></span>
    </div>
    <nav class="wsk-navlinks">
      <a class="wsk-navlink" href="https://wcl.dev">wcl.dev</a>
      <a class="wsk-navlink" href="https://github.com/wiltaylor/wcl">github</a>
      <button class="wsk-iconbtn" type="button" data-theme-toggle title="Toggle theme" aria-label="Toggle theme">
        <span class="ico-moon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg></span>
        <span class="ico-sun"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg></span>
      </button>
    </nav>
  </header>
  <main class="wsk-page">
    <section class="wsk-hero">
      <span class="wsk-eyebrow">registry</span>
      <h1 class="wsk-herotitle">${coll.name}</h1>
      <p class="wsk-herosub">${coll.summary}</p>
      <div class="wsk-search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input class="wsk-searchinput" id="wsk-search" type="text" placeholder="Search wskills…" autocomplete="off">
      </div>
      <span class="wsk-herostat"><b>${len(wskills)}</b> wskills · book view · built with wdoc</span>
    </section>
    <div class="wsk-cards" id="wsk-cards">
HTML

// ---- empty-state + closing tags (no interpolation) ---------------------------
let registry_bottom = <<HTML
      <div class="wsk-empty" id="wsk-empty">
        <h4>No wskills to show.</h4>
        <p>Try a different search, or add a wskill folder under wskills/.</p>
      </div>
    </div>
  </main>
</div>
HTML

// ---- theme toggle (persisted) + live search ----------------------------------
let registry_js = <<JS
<script>
(function(){
  var root = document.querySelector('.wsk-root');
  if (!root) return;
  try {
    var saved = localStorage.getItem('wsk-theme');
    if (saved === 'dark' || saved === 'light') root.setAttribute('data-theme', saved);
  } catch (e) {}
  var btn = root.querySelector('[data-theme-toggle]');
  if (btn) btn.addEventListener('click', function () {
    var cur = root.getAttribute('data-theme');
    if (!cur) cur = (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) ? 'light' : 'dark';
    var next = cur === 'light' ? 'dark' : 'light';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('wsk-theme', next); } catch (e) {}
  });
  var input = root.querySelector('#wsk-search');
  var cards = Array.prototype.slice.call(root.querySelectorAll('.wsk-card'));
  var empty = root.querySelector('#wsk-empty');
  if (input) input.addEventListener('input', function () {
    var q = input.value.trim().toLowerCase();
    var shown = 0;
    cards.forEach(function (c) {
      var hay = (c.getAttribute('data-search') || '').toLowerCase();
      var hit = q === '' || hay.indexOf(q) !== -1;
      c.style.display = hit ? '' : 'none';
      if (hit) shown++;
    });
    if (empty) empty.classList.toggle('on', shown === 0);
  });
  if (empty && cards.length === 0) empty.classList.add('on');
})();
</script>
JS

// --- site -------------------------------------------------------------------

site landing {
  default_template = :registry
  title            = $"${coll.name}"
  root             = true
}

// Markdown / PDF fallback body — templates are HTML-only, so this lists the same
// members for the non-HTML backends.
page index { sites = [:landing]  start = true
  h1 $"${coll.name}"
  p  $"${coll.summary}"
  wdoc_repeater { each = match coll.description { none => [], d => [d] }  as = :d
    p $"${d}"
  }

  h2 "Skills"
  // Empty-state: shown until a member wskill is added under wskills/.
  wdoc_repeater { each = match len(wskills) { 0 => [true], _ => [] }  as = :_n
    p "No wskills found in this collection yet."
  }
  wdoc_repeater { each = wskills  as = :s
    p $"**[${s.title}](./${s.href})**${match s.summary { none => "", su => $" — ${su}" }}"
  }
}

// --- the Forge registry template (HTML only) --------------------------------
// Fonts go into <head> (so they load before paint), then the scoped <style>, the
// topbar/hero, the dynamically-built cards, the empty-state, and the toggle +
// search script. `c.content` is intentionally ignored — the page body above is
// the Markdown / PDF fallback.
template registry {
  slot content: content
  render = fn(c: TemplateCtx) -> list<Html>
    flatten([
      wdoc_head_font("https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"),
      [
        css_style(:registry_css),
        raw(registry_top),
        raw(cards_html),
        raw(registry_bottom),
        raw(registry_js),
      ],
    ])
}
WSK_WDOC_PAGE_MAIN_WCL
}
