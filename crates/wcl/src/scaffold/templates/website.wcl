// The `website` built-in template: a Hugo-style website project where you
// own the HTML/CSS design and slot wdoc-rendered content into it.
//
//   wcl init website ./my-site
//
// Layout it generates:
//   main.wcl           — imports + the `site` (default template, head assets)
//   theme.wcl          — your custom `template`, authored as raw HTML + slots
//   components.wcl     — starter landing components (hero / features / steps /
//                        footer), themed via `--wdoc-*` — edit or replace them
//   content.wcl        — the page: components + named slots + default content
//   assets/app.js      — the design's script (shipped verbatim)
//
// The `site` block copies the whole `assets/` folder into the output
// (`assets = ["assets"]`) — the same path an externally-built bundle (a
// Vite/webpack `dist/`) takes — and links its script via `scripts`.
//
// Only `main.wcl` interpolates a scaffold answer (`${answer("name")}`), so
// it uses an interpolating heredoc; the others are raw (`<<'TAG'`) so their
// `wdoc_blocks(c.content)` / `$<<HTML …` / `$"…"` expressions reach the generated files
// verbatim and are evaluated by `wcl wdoc build`, not at scaffold time.
import <scaffold.wcl>

property "name" {
  prompt = "Site name"
  default = "my-site"
}

file "main.wcl" {
  content = $<<MAIN
// Project root: pull in the wdoc schema, your layout + components +
// content, then declare the site. `assets = ["assets"]` copies the folder
// verbatim into the build output; `scripts` links the copied script into
// every page `<head>`. `theme_toggle = true` puts the
// standard light/dark toggle in the header (see theme.wcl).
import <wdoc.wcl>
import "./theme.wcl"
import "./components.wcl"
import "./content.wcl"

site web {
  default_template = :site_main
  title        = "${answer("name")}"
  root         = true
  theme_toggle = true
  assets       = ["assets"]
  scripts      = ["assets/app.js"]
}
MAIN
}

file "theme.wcl" {
  content = <<'THEME'
// Your website layout. Paste a design here (a Figma export, a Claude
// artifact, a hand-built theme) and mark the slots:
//
//   ${c.title}                — the site title
//   slot(c, :content)         — typed placement of the page's authored blocks
//   slot(c, :name)            — typed placement of a declared named slot
//
// Raw HTML and stdlib parts compose freely: the header below is raw HTML
// split around `wdoc_part_theme_toggle` (the standard light/dark button),
// and `wdoc_head_*` helpers add `<head>` content (here, a viewport meta);
// the site's `scripts` add the rest.
template site_main {
  slot content: content
  slot footer: content?
  render = fn(c: TemplateCtx) -> list<Html>
    flatten([
      wdoc_head_meta("viewport", "width=device-width, initial-scale=1"),
      [el("header", ["nav"], flatten([
        [raw($<<HTML
          <a class="brand" href="index.html">${c.title}</a>
          <nav><a href="#features">Features</a><a href="#start">Get started</a></nav>
        HTML
        )],
        wdoc_part_theme_toggle(c.theme_toggle),
      ]))],
      [
        el("main", ["content"], slot(c, :content)),
        el("footer", ["foot"], slot(c, :footer)),
      ],
    ])
}
THEME
}

file "components.wcl" {
  content = <<'COMPONENTS'
// Starter landing components: `lp_hero` (+ `lp_cta` buttons),
// `lp_features` (+ `lp_feature` cards), `lp_steps` (+ `lp_step` rows),
// and `lp_footer` (+ `lp_footcol` / `lp_footlink`). Each is an ordinary
// user-declared `@block(...) extends ContentBlock` whose `lower` builds a
// semantic element tree, so the same content renders as HTML here and
// degrades to sensible Markdown / PDF (headings stay headings, links
// ride `Inline` markdown text, chrome drops away). Edit them, restyle
// them, or replace them with your own.
//
// Everything paints from `var(--wdoc-*, fallback)`, so the design
// follows the site `theme` / `accent` and the standard theme toggle.

// The design shell and component selectors are structured blocks;
// declaration bodies remain CSS text.
base "*" { sites = [:web]  css = "box-sizing: border-box;" }
base "body" { sites = [:web]  css = "margin: 0;" }
base "html" { sites = [:web]  css = "scroll-padding-top: 4.5rem;" }

class "nav" {
  sites = [:web]
  css = "display: flex; align-items: center; gap: 1.5rem; padding: 0.9rem clamp(1rem, 5vw, 3rem); border-bottom: 1px solid var(--wdoc-border, #e6e8ee); position: sticky; top: 0; z-index: 10; background: var(--wdoc-bg, #fff);"
  nest ".brand" { css = "font-weight: 700; font-size: 1.15rem; text-decoration: none; color: inherit;" }
  nest "nav" { css = "margin-left: auto; display: flex; gap: 1.25rem;" }
  nest "nav a" { css = "color: inherit; opacity: 0.8; text-decoration: none;" }
  nest "nav a:hover" { css = "opacity: 1; color: var(--wdoc-accent, #4060ff);" }
  nest ".theme-toggle" { css = "margin: 0; padding: 0.25rem 0.7rem; cursor: pointer; background: transparent; border: 1px solid var(--wdoc-border, #dcdfe4); border-radius: 999px; color: inherit; font: inherit; font-size: 0.8rem; white-space: nowrap;" }
  nest ".theme-toggle:hover" { css = "border-color: var(--wdoc-border-strong, #b6bbc4);" }
}

class "content" { sites = [:web]  css = "max-width: 70rem; margin: 0 auto; padding: 1rem clamp(1rem, 5vw, 3rem) 3rem;" }
class "foot" { sites = [:web]  css = "border-top: 1px solid var(--wdoc-border, #e6e8ee);" }

class "lp-hero" { sites = [:web]  css = "position: relative; text-align: center; padding: 4.5rem 0 3rem;" }
class "lp-hero" {
  sites = [:web]
  nest "> :not(.lp-hero-bg)" { css = "position: relative;" }
}
class "lp-hero-bg" { sites = [:web]  css = "position: absolute; inset: 0; pointer-events: none; opacity: 0.55; background-image: linear-gradient(var(--wdoc-border, rgba(127,127,127,0.25)) 1px, transparent 1px), linear-gradient(90deg, var(--wdoc-border, rgba(127,127,127,0.25)) 1px, transparent 1px); background-size: 44px 44px; -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 0%, transparent 72%); mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 0%, transparent 72%);" }
class "lp-badge" { sites = [:web]  css = "display: inline-flex; align-items: center; gap: 0.5rem; margin: 0; padding: 0.3rem 0.8rem; border: 1px solid var(--wdoc-border, rgba(127,127,127,0.35)); border-radius: 999px; background: var(--wdoc-bg-alt, transparent); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--wdoc-fg-muted, inherit);" }
class "lp-badge" {
  sites = [:web]
  nest "&::before" { css = "content: \"\"; width: 6px; height: 6px; border-radius: 999px; background: var(--wdoc-accent, #4060ff);" }
}
class "lp-hero" {
  sites = [:web]
  nest "h1" { css = "margin: 1.4rem auto 0; max-width: 16ch; font-size: clamp(2.4rem, 6vw, 4rem); line-height: 1.05; letter-spacing: -0.03em; text-wrap: balance;" }
}
class "lp-hero" {
  sites = [:web]
  nest ".lp-lede" { css = "margin: 1.3rem auto 0;" }
}
class "lp-lede" { sites = [:web]  css = "max-width: 60ch; font-size: 1.05rem; line-height: 1.6; color: var(--wdoc-fg-muted, inherit);" }
class "lp-ctas" { sites = [:web]  css = "display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; margin-top: 2rem;" }
class "lp-ctas" {
  sites = [:web]
  nest "p" { css = "margin: 0;" }
}
class "lp-cta" {
  sites = [:web]
  nest "a" { css = "display: inline-flex; align-items: center; gap: 0.5rem; height: 2.6rem; padding: 0 1.25rem; border-radius: 6px; font-weight: 600; font-size: 0.9rem; text-decoration: none;" }
}
class "lp-cta-primary" {
  sites = [:web]
  nest "a" { css = "background: var(--wdoc-accent, #4060ff); color: var(--wdoc-on-accent, #fff); border: 1px solid transparent;" }
}
class "lp-cta-primary" {
  sites = [:web]
  nest "a::after" { css = "content: \"→\";" }
}
class "lp-cta-primary" {
  sites = [:web]
  nest "a:hover" { css = "background: color-mix(in srgb, var(--wdoc-accent, #4060ff) 85%, var(--wdoc-fg, #000) 15%);" }
}
class "lp-cta-ghost" {
  sites = [:web]
  nest "a" { css = "background: transparent; color: inherit; border: 1px solid var(--wdoc-border, rgba(127,127,127,0.35)); font-weight: 500;" }
}
class "lp-cta-ghost" {
  sites = [:web]
  nest "a:hover" { css = "border-color: var(--wdoc-border-strong, rgba(127,127,127,0.7)); background: var(--wdoc-bg-alt, transparent);" }
}
class "lp-hero-footnote" { sites = [:web]  css = "margin-top: 1.4rem; font-size: 0.8rem; color: var(--wdoc-fg-subtle, inherit);" }
class "lp-section" { sites = [:web]  css = "padding: 2.75rem 0 1rem;" }
class "lp-section-head" { sites = [:web]  css = "display: block; text-align: center; max-width: 60ch; margin: 0 auto 2.25rem;" }
class "lp-section-head" {
  sites = [:web]
  nest "h2" { css = "margin: 0.7rem 0 0; font-size: 1.9rem; letter-spacing: -0.02em; line-height: 1.12;" }
}
class "lp-section-head" {
  sites = [:web]
  nest ".lp-lede" { css = "margin: 0.85rem auto 0; font-size: 1rem;" }
}
class "lp-eyebrow" { sites = [:web]  css = "margin: 0; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--wdoc-fg-subtle, inherit);" }
class "lp-grid" { sites = [:web]  css = "display: grid; grid-template-columns: repeat(auto-fit, minmax(17.5rem, 1fr)); gap: 1rem;" }
class "lp-card" { sites = [:web]  css = "display: flex; flex-direction: column; margin: 0; border: 1px solid var(--wdoc-border, rgba(127,127,127,0.35)); border-radius: 8px; background: var(--wdoc-bg-alt, transparent); padding: 1.4rem;" }
class "lp-card" {
  sites = [:web]
  nest "&:hover" { css = "border-color: var(--wdoc-border-strong, rgba(127,127,127,0.7));" }
}
class "lp-card-icon" { sites = [:web]  css = "display: inline-flex; align-items: center; justify-content: center; width: 2.25rem; height: 2.25rem; margin: 0 0 0.85rem; border-radius: 8px; background: color-mix(in srgb, var(--wdoc-accent, #4060ff) 14%, transparent); color: var(--wdoc-accent, #4060ff);" }
class "lp-card-icon" {
  sites = [:web]
  nest "svg.wdoc-icon" { css = "width: 1.2rem; height: 1.2rem;" }
}
class "lp-card" {
  sites = [:web]
  nest "h3" { css = "margin: 0 0 0.4rem; font-size: 1rem;" }
}
class "lp-card" {
  sites = [:web]
  nest "p:last-child" { css = "margin: 0; font-size: 0.88rem; line-height: 1.6; color: var(--wdoc-fg-muted, inherit);" }
}
class "lp-steps-panel" { sites = [:web]  css = "border: 1px solid var(--wdoc-border, rgba(127,127,127,0.35)); border-radius: 8px; background: var(--wdoc-bg-alt, transparent); padding: 1.9rem;" }
class "lp-steps-panel" {
  sites = [:web]
  nest ".lp-section-head" { css = "text-align: left; margin: 0 0 1.5rem; max-width: 60ch;" }
}
base "ol.lp-steps" { sites = [:web]  css = "list-style: none; counter-reset: lp-step; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1rem;" }
base "ol.lp-steps > li" { sites = [:web]  css = "position: relative; padding-left: 2.5rem;" }
base "ol.lp-steps > li::before" { sites = [:web]  css = "counter-increment: lp-step; content: counter(lp-step); position: absolute; left: 0; top: 0; width: 1.5rem; height: 1.5rem; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--wdoc-border, rgba(127,127,127,0.35)); border-radius: 999px; font-size: 0.75rem; font-weight: 600; font-family: var(--wdoc-font-mono, ui-monospace, monospace); color: var(--wdoc-fg-muted, inherit);" }
class "lp-step-title" { sites = [:web]  css = "margin: 0 0 0.5rem; font-weight: 500;" }
class "lp-cmd" { sites = [:web]  css = "margin: 0; padding: 0.65rem 0.9rem; border: 1px solid var(--wdoc-border, rgba(127,127,127,0.25)); border-radius: 6px; background: var(--wdoc-bg-inset, rgba(127,127,127,0.06)); font-size: 0.85rem; overflow-x: auto; white-space: nowrap;" }
class "lp-cmd" {
  sites = [:web]
  nest "&::before" { css = "content: \"$ \"; color: var(--wdoc-fg-subtle, inherit); font-family: var(--wdoc-font-mono, ui-monospace, monospace);" }
}
class "lp-cmd" {
  sites = [:web]
  nest "code" { css = "background: none; border: 0; padding: 0;" }
}
class "lp-footgrid" { sites = [:web]  css = "max-width: 70rem; margin: 0 auto; padding: 2.75rem clamp(1rem, 5vw, 3rem); display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 2rem;" }
class "lp-footbrand" {
  sites = [:web]
  nest "p" { css = "margin: 0 0 0.75rem;" }
}
class "lp-footlogo" { sites = [:web]  css = "display: flex; align-items: center; gap: 0.6rem; font-family: var(--wdoc-font-mono, ui-monospace, monospace); font-weight: 600; color: var(--wdoc-heading, inherit);" }
class "lp-footlogo" {
  sites = [:web]
  nest "svg.wdoc-icon" { css = "width: 1.1rem; height: 1.1rem; color: var(--wdoc-accent, #4060ff);" }
}
class "lp-foottag" { sites = [:web]  css = "max-width: 34ch; font-size: 0.85rem; line-height: 1.6; color: var(--wdoc-fg-subtle, inherit);" }
class "lp-footcol" {
  sites = [:web]
  nest "p" { css = "margin: 0 0 0.55rem; font-size: 0.85rem;" }
}
class "lp-foothead" { sites = [:web]  css = "font-size: 0.7rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--wdoc-fg-subtle, inherit);" }
class "lp-footlink" {
  sites = [:web]
  nest "a" { css = "color: var(--wdoc-fg-muted, inherit); text-decoration: none;" }
}
class "lp-footlink" {
  sites = [:web]
  nest "a:hover" { css = "color: var(--wdoc-fg, inherit);" }
}
class "lp-footbottom" { sites = [:web]  css = "display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: space-between; max-width: 70rem; margin: 0 auto; padding: 1rem clamp(1rem, 5vw, 3rem); border-top: 1px solid var(--wdoc-border, rgba(127,127,127,0.2));" }
class "lp-footbottom" {
  sites = [:web]
  nest "p" { css = "margin: 0; font-size: 0.75rem; color: var(--wdoc-fg-subtle, inherit);" }
}
media "(max-width: 48rem)" {
  sites = [:web]
  class "lp-footgrid" { css = "grid-template-columns: 1fr 1fr;" }
}
media "(prefers-reduced-motion: reduce)" {
  sites = [:web]
  class "lp-hero-bg" { css = "opacity: 0.3;" }
}

// ── Child-element helpers ────────────────────────────────────────────
// Top-level `let` fns so every parent `lower` can map its materialised
// `@children` records through them.

// A call-to-action button: a styled `<p><a></a></p>` whose link rides
// the inline-pattern engine, so Markdown keeps a real `[label](href)`.
let lp_cta_el = fn(x: LpCta) -> Html
  el("p", ["lp-cta", if x.primary == true { "lp-cta-primary" } else { "lp-cta-ghost" }], [inl($"[${x.label}](${x.href})")])

// One feature card: icon chip, title, body prose.
let lp_feature_el = fn(f: LpFeature) -> Html {
  let icon_name = if f.icon == none { "lucide.sparkles" } else { f.icon };
  el("article", ["lp-card"], [
      el("p", ["lp-card-icon"], [icon(icon_name, [])]),
      el("h3", [], [inl(f.title)]),
      el("p", [], [inl(f.body)]),
    ])
}

// One getting-started step: a numbered row (the number is a CSS counter)
// with a title and a command line rendered as inline code.
let lp_step_el = fn(s: LpStep) -> Html
  el("li", [], [
      el("p", ["lp-step-title"], [inl(s.title)]),
      el("p", ["lp-cmd"], [inl($"`${s.command}`")]),
    ])

// One footer column: an uppercase heading over a list of links.
let lp_footcol_el = fn(col: LpFootcol) -> Html {
  let links = if col.links == none { [] } else { col.links };
  el("section", ["lp-footcol"], flatten([
      [ el("p", ["lp-foothead"], [inl(col.title) ])],
      map(links, fn(l: LpFootlink) -> Html
        el("p", ["lp-footlink"], [inl($"[${l.label}](${l.href})")])),
    ]))
}

// The eyebrow / title / lede header shared by the section wrappers. The
// wrapper is a `<header>` (not a `<div>`) so Markdown descends into it
// as blocks and the `<h2>` survives as a `##` heading.
let lp_section_head = fn(eyebrow: utf8, title: utf8, lede: utf8, cls: utf8) -> list<Html> {
  let parts = flatten([
    if eyebrow == none || eyebrow == "" { [] }
    else {
      [ el("p", ["lp-eyebrow"], [inl(eyebrow) ])]
    },
    if title == none || title == "" { [] }
    else {
      [ el("h2", [], [inl(title) ])]
    },
    if lede == none || lede == "" { [] }
    else {
      [ el("p", ["lp-lede"], [inl(lede) ])]
    },
  ]);
  if len(parts) == 0 { [] }
  else {
    [ el("header", [cls], parts) ]
  }
}

// ── The components ───────────────────────────────────────────────────

// The hero: a decorative grid backdrop, an optional badge pill, the
// headline, the lede, CTA buttons, and an optional footnote.
@block("lp_hero")
type LpHero extends ContentBlock {
  @doc("The main headline (rendered as the page `<h1>`).")
  @inline(0) heading: utf8
  @doc("The supporting paragraph under the headline.")
  lede: utf8
  @doc("Optional uppercase badge pill above the headline.")
  badge: utf8?
  @doc("Optional small print under the CTA buttons.")
  footnote: utf8?
  id: identifier?
  @children("lp_cta") ctas: list<LpCta>?

  lower = fn(b: LpHero) -> list<Html> {
    let ctas = if b.ctas == none { [] } else { b.ctas };
    [
      eli("section", b.id, ["lp-hero"], flatten([
          [ ela("div", ["lp-hero-bg"], [["aria-hidden", "true"]], []) ],
          if b.badge == none { [] }
          else {
            [ el("p", ["lp-badge"], [inl(b.badge) ])]
          },
          [ el("h1", [], [inl(b.heading) ])],
          [ el("p", ["lp-lede"], [inl(b.lede) ])],
          if len(ctas) == 0 { [] }
          else {
            [ el("nav", ["lp-ctas"], map(ctas, lp_cta_el)) ]
          },
          if b.footnote == none { [] }
          else {
            [ el("p", ["lp-hero-footnote"], [inl(b.footnote) ])]
          },
        ])),
    ]
  }
}

// A CTA button (child of `lp_hero`). `primary = true` fills it with the
// accent colour; otherwise it renders as a ghost/outline button.
@block("lp_cta")
type LpCta extends ContentBlock {
  @inline(0) label: utf8
  href: utf8
  primary: bool?
  id: identifier?
  lower = fn(x: LpCta) -> list<Html> [ lp_cta_el(x) ]
}

// A feature-card grid section with an optional centred header.
@block("lp_features")
type LpFeatures extends ContentBlock {
  eyebrow: utf8?
  title: utf8?
  lede: utf8?
  id: identifier?
  @children("lp_feature") items: list<LpFeature>?

  lower = fn(b: LpFeatures) -> list<Html> {
    let items = if b.items == none { [] } else { b.items };
    [
      eli("section", b.id, ["lp-section"], flatten([
          lp_section_head(b.eyebrow, b.title, b.lede, "lp-section-head"),
          if len(items) == 0 { [] }
          else {
            [ el("section", ["lp-grid"], map(items, lp_feature_el)) ]
          },
        ])),
    ]
  }
}

// One feature card (child of `lp_features`).
@block("lp_feature")
type LpFeature extends ContentBlock {
  @inline(0) title: utf8
  body: utf8
  @doc("Icon as `pack.name` (default `lucide.sparkles`).")
  icon: utf8?
  id: identifier?
  lower = fn(f: LpFeature) -> list<Html> [ lp_feature_el(f) ]
}

// A getting-started panel: header plus numbered steps, each a title over
// a command line.
@block("lp_steps")
type LpSteps extends ContentBlock {
  eyebrow: utf8?
  title: utf8?
  lede: utf8?
  id: identifier?
  @children("lp_step") steps: list<LpStep>?

  lower = fn(b: LpSteps) -> list<Html> {
    let steps = if b.steps == none { [] } else { b.steps };
    [
      eli("section", b.id, ["lp-section"], [
          el("article", ["lp-steps-panel"], flatten([
              lp_section_head(b.eyebrow, b.title, b.lede, "lp-section-head"),
              if len(steps) == 0 { [] }
              else {
                [ el("ol", ["lp-steps"], map(steps, lp_step_el)) ]
              },
            ])),
        ]),
    ]
  }
}

// One numbered step (child of `lp_steps`).
@block("lp_step")
type LpStep extends ContentBlock {
  @inline(0) title: utf8
  command: utf8
  id: identifier?
  lower = fn(s: LpStep) -> list<Html> [ lp_step_el(s) ]
}

// The multi-column site footer: a brand cell (icon + wordmark + tagline)
// beside link columns, over a bottom bar with the copyright and a note.
@block("lp_footer")
type LpFooter extends ContentBlock {
  @doc("Short prose under the brand wordmark.")
  tagline: utf8
  @doc("Brand wordmark text (chrome — dropped in Markdown).")
  brand: utf8?
  copyright: utf8?
  note: utf8?
  id: identifier?
  @children("lp_footcol") columns: list<LpFootcol>?

  lower = fn(b: LpFooter) -> list<Html> {
    let cols = if b.columns == none { [] } else { b.columns };
    let brand = if b.brand == none { "" } else { b.brand };
    let bottom = flatten([
      if b.copyright == none { [] }
      else {
        [ el("p", [], [inl(b.copyright) ])]
      },
      if b.note == none { [] }
      else {
        [ el("p", [], [inl(b.note) ])]
      },
    ]);
    flatten([
      [ eli("nav", b.id, ["lp-footgrid"], flatten([
            [ el("header", ["lp-footbrand"], [
                  el("p", ["lp-footlogo"], [
                      icon("lucide.layers", []),
                      el("span", [], [raw(brand)]),
                    ]),
                  el("p", ["lp-foottag"], [inl(b.tagline)]),
                ]) ],
            map(cols, lp_footcol_el),
          ])) ],
      if len(bottom) == 0 { [] }
      else {
        [ el("section", ["lp-footbottom"], bottom) ]
      },
    ])
  }
}

// One footer link column (child of `lp_footer`). Links may be authored
// as nested `lp_footlink` blocks or spliced in as data with
// `links = map(...)` (computed `@children`).
@block("lp_footcol")
type LpFootcol extends ContentBlock {
  @inline(0) title: utf8
  id: identifier?
  @children("lp_footlink") links: list<LpFootlink>?
  lower = fn(col: LpFootcol) -> list<Html> [ lp_footcol_el(col) ]
}

// One footer link (child of `lp_footcol`).
@block("lp_footlink")
type LpFootlink extends ContentBlock {
  @inline(0) label: utf8
  href: utf8
  id: identifier?
  lower = fn(l: LpFootlink) -> list<Html> [
    el("p", ["lp-footlink"], [inl($"[${l.label}](${l.href})")]),
  ]
}
COMPONENTS
}

file "content.wcl" {
  content = <<'CONTENT'
// The page content, authored in wdoc from the starter components in
// components.wcl. Named fills render into the matching declaration in
// theme.wcl; other authored page blocks fill the reserved `content` slot.
page index { sites = [:web]  start = true
  lp_hero "Build something great" {
    badge    = "A wdoc starter"
    lede     = "A starter website — the layout lives in theme.wcl, the components and design rules in components.wcl, and the words live here."
    footnote = "Built with WCL + wdoc."
    lp_cta "Get started" { href = "#start"  primary = true }
    lp_cta "Learn wdoc"  { href = "https://wcl.dev/wskills/wdoc/" }
  }

  lp_features {
    id      = features
    eyebrow = "Features"
    title   = "Everything is a block."
    lede    = "Edit these cards in content.wcl — or open components.wcl and change what a card is."

    lp_feature "Your layout" {
      icon = "lucide.layout-template"
      body = "The `site_main` template in theme.wcl is raw HTML with slots — paste any design and mark where the content goes."
    }
    lp_feature "Your components" {
      icon = "lucide.blocks"
      body = "Each `lp_*` block lowers to semantic HTML and degrades to clean Markdown. Copy one to invent your own."
    }
    lp_feature "Any wdoc block" {
      icon = "lucide.sparkles"
      body = "Headings, lists, code, tables, diagrams — everything outside a named fill lands in the default content slot."
    }
  }

  lp_steps {
    id      = start
    eyebrow = "Getting started"
    title   = "Build and serve it."
    lede    = "The dev server rebuilds on Enter; the build writes a static site."

    lp_step "Serve with live preview" { command = "wcl wdoc serve main.wcl" }
    lp_step "Build the static site"   { command = "wcl wdoc build main.wcl --out _site" }
  }

  footer {
    lp_footer {
      brand   = "my-site"
      tagline = "A starter website built with WCL + wdoc."
      note    = "Edit this footer in content.wcl."

      lp_footcol "Site" {
        lp_footlink "Home"     { href = "index" }
        lp_footlink "Features" { href = "#features" }
      }
      lp_footcol "wdoc" {
        lp_footlink "wcl.dev"        { href = "https://wcl.dev/" }
        lp_footlink "wdoc reference" { href = "https://wcl.dev/wskills/wdoc/" }
      }
    }
  }
}
CONTENT
}

file "assets/app.js" {
  content = <<'JS'
// The design's script — shipped verbatim and loaded (deferred) on every
// page. Replace with your own bundle.
console.log("site ready");
JS
}
