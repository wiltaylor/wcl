// The `wplan` built-in template: scaffold a wplan plan folder — a software
// project planned as a gated WCL pipeline (interview, research, PRD, a DAG
// of parallel-safe specs) rendered into a human book and self-contained
// markdown briefs. Originally ported from the wplan skill (now the plan
// mode of the wad wskill, docs/wskills/wad); every file is emitted as a raw
// heredoc — the plan is generic until the planning process fills it in.
//
//   wcl init wplan <project>/plan --defaults
//
// The `schema/plan_schema.wcl` heredoc below (terminator WPLAN_SCHEMA_WCL)
// is the CANONICAL copy of the wplan plan schema — extract it with
// `just wplan-schema-extract`; `just wplan-template-check` scaffolds and
// gates the shipped template in CI. Edit the schema here, never in a plan.

import <scaffold.wcl>

// Research finding files (`research/<id>.wcl`) land here; empty on day one.
folder "research"

file "plan.wcl" {
  content = <<'WPLAN_PLAN_WCL'
// wplan entry point — imports the schema and every data file.
// Add an import line here for each new spec and research finding file.
import "./schema/plan_schema.wcl"
import "./questions.wcl"
import "./research.wcl"
import "./prd.wcl"
import "./surfaces.wcl"
import "./scenarios.wcl"
import "./contracts.wcl"
import "./models.wcl"
import "./asbuilt.wcl"
import "./signoffs.wcl"
import "./specs/spec_000_repo.wcl"
import "./specs/spec_010_build.wcl"
import "./status.wcl"
import "./lessons.wcl"
WPLAN_PLAN_WCL
}

file "justfile" {
  content = <<'WPLAN_JUSTFILE'
# wplan justfile — run from the plan/ directory.

# Structural tier: schema + every gate EXCEPT phase signoffs. Green on a fresh
# template; keep it green after every edit.
check:
    wcl check plan.wcl
    wcl check gates.wcl
    @for g in $(grep -oE '^gate [a-z_0-9]+' gates.wcl | cut -d' ' -f2 | grep -v '^signoffs_complete$'); do \
        printf 'gate %-24s ' "$g"; \
        wcl eval gates.wcl "gates.$g.ok" || exit 1; \
    done

# Full tier: everything including signoffs. Rendering requires this, so a plan
# cannot be handed to agents while a phase was skipped silently.
check-full: check
    @printf 'gate %-24s ' signoffs_complete
    @wcl eval gates.wcl gates.signoffs_complete.ok

# Build the human-readable book.
book:
    wcl wdoc build wdoc/book/main.wcl --out out/book

# Export one self-contained markdown brief per spec for implementation agents.
specs:
    wcl wdoc markdown wdoc/agent/main.wcl --out out/specs

# Gates + both outputs.
render: check-full book specs

# Walk pending interview questions interactively and record answers.
answer:
    wcl answer plan.wcl

# Live-preview the book.
serve:
    wcl wdoc serve wdoc/book/main.wcl

# Query a spec's status (verification agents update status.wcl directly).
status spec:
    wcl eval plan.wcl statuses.{{spec}}.state
# Scaffold the plan's WAD (wad/) — the browsable architecture book of the
# planned solution; hand-author systems/personas there, the extractor derives the rest.
wad-init id name:
    wcl init wad wad -D system_id={{id}} -D system_name='{{name}}' -D system_summary='Planned system — see the PRD.' -D date=$(date +%F) -D include_extractors=no --defaults --force
    printf 'import "./plan.wcl"    // owned by scripts/extract_plan.py (plan folder)\n' >> wad/data/generated/main.wcl
    printf '// GENERATED by scripts/extract_plan.py — run `just wad-extract`.\nnamespace wcl.wad\n' > wad/data/generated/plan.wcl
    wcl check wad/wad.wcl

# Re-derive wad/data/generated/plan.wcl from the plan and validate the WAD.
wad-extract:
    uv run scripts/extract_plan.py
    wcl check wad/wad.wcl

# Build the WAD book — the architecture view of the finished solution.
wad-book: wad-extract
    wcl wdoc build wad/wdoc/book/main.wcl --out wad/_site

# Review the WAD book live with click-to-comment.
wad-serve:
    wcl wdoc serve wad/wdoc/book/main.wcl --comment

# Graduate the plan's WAD into the built repo (run after the build completes):
# moves wad/ to <dest>, sheds the plan extractor + its generated file, and
# leaves the adopt checklist. <dest> is the repo's WAD home, e.g. ../../.wad
# for a plan at <repo>/plans/<slug>/plan. Then: convert derived blocks worth
# keeping into hand-authored data, install code extractors, and run the wad
# skill's codebase-scan checklist to backfill what the plan never knew.
wad-graduate dest:
    test -d wad || { echo 'no wad/ folder to graduate'; exit 1; }
    test ! -e {{dest}} || { echo '{{dest}} already exists — not overwriting'; exit 1; }
    rm -f scripts/extract_plan.py wad/data/generated/plan.wcl
    grep -v 'extract_plan.py (plan folder)' wad/data/generated/main.wcl > wad/data/generated/main.wcl.tmp \
        && mv wad/data/generated/main.wcl.tmp wad/data/generated/main.wcl
    mv wad {{dest}}
    wcl check {{dest}}/wad.wcl
    @echo "graduated: {{dest}} — next: convert keeper blocks to hand-authored data, add code extractors, run the codebase-scan backfill"

WPLAN_JUSTFILE
}

file "schema/plan_schema.wcl" {
  content = <<'WPLAN_SCHEMA_WCL'
// wplan schema — types for PRD planning documents.
// Imported by plan.wcl; every data file is reached from there.
import <wdoc.wcl>
import <answer.wcl>

// ---- state vocabularies -------------------------------------------------
symbol_set PlanQuestionState { open answered dropped }
symbol_set PlanResearchState { open in_progress done blocked }
symbol_set PlanSpecState { todo in_progress implemented verified reviewed merged blocked }
symbol_set PlanPriority { must should could wont }

// ---- interview ----------------------------------------------------------
@answerable(prompt = "question", response = "answer", status = "status",
            pending = :open, resolved = :answered, skipped = :dropped)
@block("question")
type PlanQuestion {
  @inline(0) id: identifier
  question: utf8
  @default(:open) status: PlanQuestionState
  answer: utf8?
  // :single_select | :multi_select | :free_text (default). Options accelerate
  // the common case; `wcl answer` always offers free text alongside them.
  kind: symbol?
  @children("option") options: list<AnswerOption>
}

// ---- research -----------------------------------------------------------
@block("research")
type PlanResearch {
  @inline(0) id: identifier
  topic: utf8
  why: utf8
  @default(:open) status: PlanResearchState
  // Path (relative to plan/) of the finding file, e.g. "research/r_auth.wcl".
  findings_file: utf8?
}

@block("finding")
type PlanFinding {
  @inline(0) id: identifier
  summary: utf8
  // Rich detail rendered in the book and copyable into specs.
  @child("body") detail: WdocAddressableBody?
}

// ---- PRD ----------------------------------------------------------------
@block("goal")
type PlanGoal {
  @inline(0) id: identifier
  text: utf8
}

@block("non_goal")
type PlanNonGoal {
  @inline(0) id: identifier
  text: utf8
}

@block("requirement")
type PlanRequirement {
  @inline(0) id: identifier
  text: utf8
  @default(:must) priority: PlanPriority
}

// Project-wide rules copied verbatim into every exported spec.
@block("rule")
type PlanRule {
  @inline(0) id: identifier
  text: utf8
}

// ---- surfaces -------------------------------------------------------------
symbol_set PlanSurfaceKind { screen command endpoint }
symbol_set PlanStateKind { empty loading error populated custom }

@block("element")
type PlanElement {
  @inline(0) id: identifier
  text: utf8                        // what it is and how it behaves
}

@block("state")
type PlanState {
  @inline(0) id: identifier
  kind: PlanStateKind
  shows: utf8                       // exactly what the user sees in this state
}

@block("interaction")
type PlanInteraction {
  @inline(0) id: identifier
  action: utf8                      // what the user does
  outcome: utf8                     // what happens, including which surface it leads to
}

@block("surface")
type PlanSurface {
  @inline(0) id: identifier
  name: utf8
  kind: PlanSurfaceKind
  purpose: utf8
  entry: utf8                       // route / command / keybinding that reaches it
  layout: utf8?                     // textual arrangement (renders into briefs)
  @default([]) @ref("surface") leads_to: list<identifier>
  @children("element") elements: list<PlanElement>
  @children("state") states: list<PlanState>
  @children("interaction") interactions: list<PlanInteraction>
  // Book-only richness: wireframe diagrams + prose. NOT projected into briefs
  // (diagrams render as images weak agents cannot see) - the structured fields
  // above are the textual contract.
  @child("body") detail: WdocAddressableBody?
}

// ---- scenarios --------------------------------------------------------------
@block("sstep")
type PlanScenarioStep {
  @inline(0) id: identifier
  action: utf8
  expect: utf8
}

@block("scenario")
type PlanScenario {
  @inline(0) id: identifier
  name: utf8
  goal: utf8                        // what the user accomplishes end to end
  @default([]) @ref("surface") touches: list<identifier>
  // Run this scenario as soon as this spec merges (unset = final acceptance only).
  @ref("spec") ready_after: identifier?
  @children("sstep") steps: list<PlanScenarioStep>
}

// ---- contracts --------------------------------------------------------------
@block("citem")
type PlanContractItem {
  @inline(0) id: identifier
  signature: utf8                   // exact signature / type / error shape
  notes: utf8?
}

@block("contract")
type PlanContract {
  @inline(0) id: identifier
  name: utf8
  purpose: utf8
  @ref("spec") provided_by: identifier
  @children("citem") items: list<PlanContractItem>
}

// ---- data models -------------------------------------------------------------
@block("field")
type PlanModelField {
  @inline(0) id: identifier
  type: utf8
  @default(true) required: bool
  validation: utf8?
  notes: utf8?
}

@block("model")
type PlanModel {
  @inline(0) id: identifier
  name: utf8
  purpose: utf8
  persistence: utf8                 // where/how stored (table, file, in-memory...)
  @default([]) @ref("model") relates_to: list<identifier>
  @children("field") fields: list<PlanModelField>
}

// ---- as-built notes (verification agent only) ---------------------------------
@block("asbuilt")
type PlanAsBuilt {
  @inline(0) spec: identifier
  note: utf8                        // deviations from the brief downstream specs must know
}

// ---- phase signoffs ------------------------------------------------------------
symbol_set PlanSignoffState { pending done not_applicable }

@block("signoff")
type PlanSignoff {
  @inline(0) id: identifier         // interview, research, surfaces, scenarios, data_model, prd
  @default(:pending) state: PlanSignoffState
  note: utf8?                       // why n/a, or approval context
}

// ---- specs --------------------------------------------------------------
@block("task")
type PlanTask {
  @inline(0) id: identifier
  text: utf8
}

@block("wstep")
type PlanWalkStep {
  @inline(0) id: identifier
  do: utf8
  expect: utf8
}

@block("accept")
type PlanAccept {
  @inline(0) id: identifier
  check: utf8
  // Runnable verification command; empty means manual check.
  command: utf8?
  // Manual walkthrough for surface behaviour the verifier executes in order.
  @children("wstep") walkthrough: list<PlanWalkStep>
}

@block("spec")
type PlanSpec {
  @inline(0) id: identifier
  title: utf8
  objective: utf8
  @default([]) @ref("spec") depends_on: list<identifier>
  // Surfaces this spec fully implements (coverage gate: exactly one spec each).
  @default([]) @ref("surface") implements: list<identifier>
  // Contracts this spec provides (its own exports) / consumes (build against exactly).
  @default([]) @ref("contract") consumes: list<identifier>
  // Data models this spec owns the implementation of (exactly one spec each) / reads-writes.
  @default([]) @ref("model") defines_models: list<identifier>
  @default([]) @ref("model") uses_models: list<identifier>
  // PRD requirements this spec implements (fully or in part). A requirement may
  // be covered by several specs; every :must requirement must appear in at
  // least one spec's covers list (requirements_covered gate).
  @default([]) @ref("requirement") covers: list<identifier>
  // How to launch/exercise this spec's work for walkthrough verification
  // (command, stubs, seed data). REQUIRED when the spec implements surfaces
  // or has walkthrough acceptance steps (harness_defined gate).
  harness: utf8?
  // Git branch this spec is built on, e.g. "spec/000-repo".
  branch: utf8
  // Files/dirs this spec owns exclusively (globs). No other spec may touch them.
  owns: list<utf8>
  allowed: list<utf8>
  not_allowed: list<utf8>
  done: list<utf8>
  @children("task") tasks: list<PlanTask>
  @children("accept") acceptance: list<PlanAccept>
  // Self-contained context copied in at authoring time (PRD excerpts,
  // research findings, conventions). Rendered into the exported markdown.
  @child("body") context: WdocAddressableBody?
}

// ---- status (verification agent only) ------------------------------------
@block("status")
type PlanStatus {
  @inline(0) spec: identifier
  @default(:todo) state: PlanSpecState
  by: utf8?
  note: utf8?
}

// ---- lessons -------------------------------------------------------------
@block("lesson")
type PlanLesson {
  @inline(0) id: identifier
  date: utf8
  context: utf8
  lesson: utf8
  action: utf8?
}

// ---- gates ----------------------------------------------------------------
@block("gate")
type PlanGate {
  @inline(0) id: identifier
  ok: bool
}

// ---- document root ---------------------------------------------------------
@document
type PlanDoc {
  @children("question") questions: list<PlanQuestion>
  @children("research") research: list<PlanResearch>
  @children("finding") findings: list<PlanFinding>
  @children("goal") goals: list<PlanGoal>
  @children("non_goal") non_goals: list<PlanNonGoal>
  @children("requirement") requirements: list<PlanRequirement>
  @children("rule") rules: list<PlanRule>
  @children("surface") surfaces: list<PlanSurface>
  @children("scenario") scenarios: list<PlanScenario>
  @children("contract") contracts: list<PlanContract>
  @children("model") models: list<PlanModel>
  @children("asbuilt") asbuilts: list<PlanAsBuilt>
  @children("signoff") signoffs: list<PlanSignoff>
  @children("spec") specs: list<PlanSpec>
  @children("status") statuses: list<PlanStatus>
  @children("lesson") lessons: list<PlanLesson>
  @children("gate") gates: list<PlanGate>
}
WPLAN_SCHEMA_WCL
}

file "questions.wcl" {
  content = <<'WPLAN_QUESTIONS_WCL'
// Interview questions. The PRD may not be written while any question has
// status :open (default). Record the user's answer verbatim in `answer`.
// Answer via `just answer` (interactive), `wcl wdoc serve --answer` (browser),
// or non-interactively: wcl answer plan.wcl --id q_example --pick linux --text "..."
// Give likely answers as options where you can - choices are faster for the
// user and free text is always offered alongside.
// question q_example {
//   question = "What platforms must be supported?"
//   kind = :single_select        // :single_select | :multi_select | omit for free text
//   option linux { label = "Linux x86_64" }
//   option mac { label = "macOS" }
// }
WPLAN_QUESTIONS_WCL
}

file "research.wcl" {
  content = <<'WPLAN_RESEARCH_WCL'
// Research items. Each item gets its own finding file under research/ so
// items can be researched in parallel. The PRD may not be finalised while
// any item is not :done. Add `import "./research/<id>.wcl"` to plan.wcl
// when a finding file is created.
// research r_example {
//   topic = "CLI arg parsing crate selection"
//   why = "Spec 030 needs a settled crate so the agent doesn't pick one."
//   status = :open
//   findings_file = "research/r_example.wcl"
// }
WPLAN_RESEARCH_WCL
}

file "prd.wcl" {
  content = <<'WPLAN_PRD_WCL'
// The PRD: goals, non-goals, prioritised requirements, and project rules.
// Rules are copied verbatim into EVERY exported spec brief — keep them short,
// imperative, and universally applicable.
// goal g_example { text = "Sub-second startup for typical workloads." }
// non_goal ng_example { text = "No Windows support in v1." }
// requirement req_example { text = "Tool is invoked via a CLI binary." priority = :must }
// Every :must requirement must appear in some spec's `covers` list before
// rendering (requirements_covered gate). Prefer EARS phrasing for testability:
// "WHEN [event] THE SYSTEM SHALL [observable behaviour]".
rule rule_commits { text = "Commit after every green test run with a conventional-commit message." }
rule rule_no_deps { text = "Do not add dependencies not listed in your spec." }
rule rule_scope { text = "Only create or modify files listed under File ownership in your spec." }
WPLAN_PRD_WCL
}

file "surfaces.wcl" {
  content = <<'WPLAN_SURFACES_WCL'
// Surfaces: every screen, CLI command, or API endpoint the application exposes.
// Defined during the PRD phase (draft before research, refine after). Gates:
// each surface is implemented by exactly ONE spec, every :screen defines the
// four standard states, and every surface is touched by at least one scenario.
// Wireframes (wf_* diagram widgets) go in the body - book-only; the structured
// fields ARE the contract that reaches implementation agents.
// surface s_example {
//   name = "Task list"
//   kind = :screen                  // :screen | :command | :endpoint
//   purpose = "Browse and manage all tasks."
//   entry = "default screen on launch"
//   layout = "Header bar with title and Add button; task table below."
//   leads_to = [s_other]
//   element e_add { text = "Add button (top right) - opens the edit screen." }
//   state st_empty { kind = :empty  shows = "Centered 'No tasks yet' + Add button." }
//   state st_loading { kind = :loading  shows = "Spinner over the table area." }
//   state st_error { kind = :error  shows = "Red banner with error text and Retry." }
//   state st_pop { kind = :populated  shows = "Task table; overdue rows tinted red." }
//   interaction i_add { action = "Click Add"  outcome = "Navigate to edit screen with empty fields." }
//   body {
//     diagram { width = 420  height = 300
//       wf_window "Tasks" {
//         wf_button "Add" { icon = "lucide.plus" }
//       }
//     }
//   }
// }
WPLAN_SURFACES_WCL
}

file "scenarios.wcl" {
  content = <<'WPLAN_SCENARIOS_WCL'
// Usage scenarios: end-to-end walks through the finished application, written
// during planning. They are the system-level definition of done - after the
// final wave merges, every scenario must pass on trunk. Every surface must be
// touched by at least one scenario (scenario_coverage gate).
// scenario sc_example {
//   name = "Create the first task"
//   goal = "A new user creates their first task and sees it in the list."
//   touches = [s_example]
//   sstep s1 { action = "Launch with no data"  expect = "Empty state shows." }
//   sstep s2 { action = "Click Add, fill title, Save"  expect = "Row visible in list." }
// }
WPLAN_SCENARIOS_WCL
}

file "contracts.wcl" {
  content = <<'WPLAN_CONTRACTS_WCL'
// Interface contracts: the exact signatures/types/errors crossing spec
// boundaries. The providing spec implements them verbatim; consuming specs
// build against them and never reach past them. Consumers must (transitively)
// depend on the provider (contract_order gate).
// contract c_example {
//   name = "Task store API"
//   purpose = "How other modules read/write tasks."
//   provided_by = spec_020_core
//   citem fn_add { signature = "pub fn add_task(title: &str) -> Result<TaskId, StoreError>" }
//   citem err { signature = "pub enum StoreError { Io(std::io::Error), Validation(String) }" }
// }
WPLAN_CONTRACTS_WCL
}

file "models.wcl" {
  content = <<'WPLAN_MODELS_WCL'
// Data models: every entity the application stores or passes between specs -
// fields, types, validation, persistence. Exactly one spec defines each
// (models_defined_once gate); any spec touching one lists it in defines_models
// or uses_models and gets the full definition in its brief.
// model m_example {
//   name = "Task"
//   purpose = "A single to-do item."
//   persistence = "JSON file at data/tasks.json"
//   field f_id { type = "u64"  notes = "monotonic, never reused" }
//   field f_title { type = "String"  validation = "non-empty, <=200 chars" }
//   field f_due { type = "Option<Date>"  required = false }
// }
WPLAN_MODELS_WCL
}

file "asbuilt.wcl" {
  content = <<'WPLAN_ASBUILT_WCL'
// As-built notes - written by the VERIFICATION agent when it verifies a spec:
// any deviation from the brief that downstream specs must know (renamed
// modules, changed commands, adjusted signatures). "none" needs no row.
// Rendered into the briefs of every spec that depends on the noted spec, so
// re-render (just specs) after adding rows. Implementation agents never edit this.
// asbuilt spec_010_build { note = "test recipe is `just test`, not cargo test directly." }
WPLAN_ASBUILT_WCL
}

file "signoffs.wcl" {
  content = <<'WPLAN_SIGNOFFS_WCL'
// Phase signoffs - each phase must be explicitly resolved with the user before
// rendering: :done (reviewed and approved) or :not_applicable (with a note
// saying why, e.g. no UI => surfaces n/a). `just check` ignores these
// (structural tier); `just check-full` and therefore `just render` enforce
// them, so a skipped phase is always a recorded decision, never an accident.
signoff interview { }
signoff research { }
signoff surfaces { }
signoff scenarios { }
signoff data_model { }
signoff prd { }
WPLAN_SIGNOFFS_WCL
}

file "specs/spec_000_repo.wcl" {
  content = <<'WPLAN_SPEC_000_REPO_WCL'
spec spec_000_repo {
  title = "Repository setup"
  objective = "Initialise the git repository, base layout, and ignore rules."
  depends_on = []
  branch = "spec/000-repo"
  owns = [".gitignore", "README.md", ".tree/"]
  allowed = ["git init and initial commit", "create README.md and .gitignore"]
  not_allowed = ["creating any source code", "adding dependencies"]
  done = ["git repo exists with main branch", ".tree/ is gitignored"]
  task t1 { text = "Run `git init -b main` in the project root." }
  task t2 { text = "Create .gitignore containing `.tree/` and `target/`." }
  task t3 { text = "Create README.md with the project name and one-line description." }
  task t4 { text = "Commit: `chore: initial repository setup`." }
  accept a1 { check = "Repo initialised on main" command = "git rev-parse --abbrev-ref HEAD | grep -qx main" }
  accept a2 { check = ".tree ignored" command = "git check-ignore .tree/x" }
  body {
    p "This is the root spec. It runs on the main branch directly (no worktree) because nothing exists yet."
  }
}
WPLAN_SPEC_000_REPO_WCL
}

file "specs/spec_010_build.wcl" {
  content = <<'WPLAN_SPEC_010_BUILD_WCL'
spec spec_010_build {
  title = "Build setup"
  objective = "Create the cargo workspace and CI-runnable build/test commands."
  depends_on = [spec_000_repo]
  branch = "spec/010-build"
  owns = ["Cargo.toml", "Cargo.lock", "justfile"]
  allowed = ["cargo init", "create justfile with build/test/lint recipes"]
  not_allowed = ["implementing any feature logic"]
  done = ["cargo build and cargo test pass", "just build works"]
  task t1 { text = "Run `cargo init --name demo` and confirm `cargo build` passes." }
  task t2 { text = "Create a justfile with recipes: build, test, lint (clippy)." }
  accept a1 { check = "Builds clean" command = "cargo build 2>&1 | grep -qv error" }
  body {
    p "TEMPLATE: adapt this spec to the project language/toolchain settled in the interview. The Rust content below is the default."
  }
}
WPLAN_SPEC_010_BUILD_WCL
}

file "status.wcl" {
  content = <<'WPLAN_STATUS_WCL'
// Managed by the VERIFICATION agent only. Implementation agents never edit
// or read this file — their briefs do not mention it.
// One row per spec (the status_covered gate enforces coverage).
status spec_000_repo { state = :todo }
status spec_010_build { state = :todo }
WPLAN_STATUS_WCL
}

file "lessons.wcl" {
  content = <<'WPLAN_LESSONS_WCL'
// Lessons learnt during this project's build runs. After the project ships,
// feed durable lessons back into the wplan skill itself.
// lesson l_example {
//   date = "2026-07-04"
//   context = "spec_020 agent added an unlisted dependency"
//   lesson = "Weak models treat 'allowed' lists as suggestions unless the rule is repeated in tasks."
//   action = "Repeat critical boundaries inside the relevant task text."
// }
WPLAN_LESSONS_WCL
}

file "gates.wcl" {
  content = <<'WPLAN_GATES_WCL'
// wplan gates — configured by the planning model. `just check` fails while any gate fails.
// Evaluate a gate: wcl eval gates.wcl gates.<id>.ok
import "./plan.wcl"

// The PRD may not be finalised while any interview question is open.
gate questions_closed {
  ok = assert(
    all(questions, fn(q: PlanQuestion) -> bool { q.status != :open }),
    "GATE FAILED: open interview questions remain (questions.wcl)") == none
}

// The PRD may not be finalised while any research item is incomplete.
gate research_done {
  ok = assert(
    all(research, fn(r: PlanResearch) -> bool { r.status == :done }),
    "GATE FAILED: research items not done (research.wcl)") == none
}

// The spec dependency graph must be acyclic (Kahn fixpoint: after N passes,
// the set of specs whose deps are all resolvable must cover every spec).
gate dag_acyclic {
  ok = assert(
    len(fold(range(0, len(specs)), [],
      fn(acc: list<identifier>, _i: i64) -> list<identifier> {
        map(
          filter(specs, fn(s: PlanSpec) -> bool {
            all(s.depends_on, fn(d: identifier) -> bool { list_contains(acc, d) })
          }),
          fn(s: PlanSpec) -> identifier { s.id })
      })) == len(specs),
    "GATE FAILED: dependency cycle detected in specs") == none
}

// No two specs may own the same path (parallel-merge safety).
gate owns_disjoint {
  ok = assert(
    len(unique(flatten(map(specs, fn(s: PlanSpec) -> list<utf8> { s.owns })))) ==
      len(flatten(map(specs, fn(s: PlanSpec) -> list<utf8> { s.owns }))),
    "GATE FAILED: two specs claim ownership of the same path") == none
}

// Every spec must have a status row (verification agent bookkeeping).
gate status_covered {
  ok = assert(
    all(specs, fn(s: PlanSpec) -> bool {
      any(statuses, fn(st: PlanStatus) -> bool { st.spec == s.id })
    }),
    "GATE FAILED: spec missing from status.wcl") == none
}

// Every surface must be implemented by exactly one spec (parallel-safe coverage).
gate surface_coverage {
  ok = assert(
    all(surfaces, fn(sf: PlanSurface) -> bool {
      len(filter(specs, fn(s: PlanSpec) -> bool { list_contains(s.implements, sf.id) })) == 1
    }),
    "GATE FAILED: a surface is not implemented by exactly one spec") == none
}

// Every :screen surface must define the four standard states.
gate surface_states {
  ok = assert(
    all(filter(surfaces, fn(sf: PlanSurface) -> bool { sf.kind == :screen }),
      fn(sf: PlanSurface) -> bool {
        all([:empty, :loading, :error, :populated], fn(k: symbol) -> bool {
          any(sf.states, fn(st: PlanState) -> bool { st.kind == k })
        })
      }),
    "GATE FAILED: a screen surface is missing one of the empty/loading/error/populated states") == none
}

// Every surface must be exercised by at least one scenario.
gate scenario_coverage {
  ok = assert(
    all(surfaces, fn(sf: PlanSurface) -> bool {
      any(scenarios, fn(sc: PlanScenario) -> bool { list_contains(sc.touches, sf.id) })
    }),
    "GATE FAILED: a surface is not touched by any scenario") == none
}

// Every contract's consumer must (transitively) depend on its provider, so the
// provider is always merged before the consumer builds against it.
gate contract_order {
  ok = assert(
    all(specs, fn(s: PlanSpec) -> bool {
      all(s.consumes, fn(c: identifier) -> bool {
        any(contracts, fn(ct: PlanContract) -> bool {
          ct.id == c && list_contains(
            fold(range(0, len(specs)), s.depends_on,
              fn(acc: list<identifier>, _i: i64) -> list<identifier> {
                unique(flatten([acc, flatten(map(
                  filter(specs, fn(d: PlanSpec) -> bool { list_contains(acc, d.id) }),
                  fn(d: PlanSpec) -> list<identifier> { d.depends_on }))]))
              }),
            ct.provided_by)
        })
      })
    }),
    "GATE FAILED: a spec consumes a contract whose provider is not among its (transitive) dependencies") == none
}

// Every data model is defined (implementation-owned) by exactly one spec.
gate models_defined_once {
  ok = assert(
    all(models, fn(m: PlanModel) -> bool {
      len(filter(specs, fn(s: PlanSpec) -> bool { list_contains(s.defines_models, m.id) })) == 1
    }),
    "GATE FAILED: a data model is not defined by exactly one spec") == none
}

// Every :must requirement must be covered by at least one spec (set
// covers = [req_id, ...] on the implementing spec). Passes vacuously with no
// requirements, so a fresh template stays green.
gate requirements_covered {
  ok = assert(
    all(filter(requirements, fn(r: PlanRequirement) -> bool { r.priority == :must }),
      fn(r: PlanRequirement) -> bool {
        any(specs, fn(s: PlanSpec) -> bool { list_contains(s.covers, r.id) })
      }),
    "GATE FAILED: a :must requirement is not in any spec's covers list") == none
}

// A spec that implements surfaces or has walkthrough acceptance must say how
// to run its work for verification.
gate harness_defined {
  ok = assert(
    all(specs, fn(s: PlanSpec) -> bool {
      (len(s.implements) == 0 &&
       all(s.acceptance, fn(a: PlanAccept) -> bool { len(a.walkthrough) == 0 }))
      || s.harness != none
    }),
    "GATE FAILED: a spec with surfaces or walkthrough accepts has no harness") == none
}

// Every phase signoff must be explicitly resolved (done or not_applicable).
// Excluded from `just check` (structural tier); enforced by `just check-full`,
// which `just render` requires - so nothing renders while a phase was skipped
// silently.
gate signoffs_complete {
  ok = assert(
    all(signoffs, fn(sg: PlanSignoff) -> bool { sg.state != :pending }),
    "GATE FAILED: a phase signoff is still :pending - resolve it (done / not_applicable) with the user") == none
}

// Optional stricter gates — uncomment per project judgement:
// gate interview_happened {
//   ok = assert(len(questions) > 0, "GATE FAILED: no interview questions recorded") == none
// }
// gate specs_exist {
//   ok = assert(len(specs) >= 2, "GATE FAILED: bootstrap specs missing") == none
// }
WPLAN_GATES_WCL
}

file "wdoc/book/main.wcl" {
  content = <<'WPLAN_WDOC_BOOK_MAIN_WCL'
// wplan book — the human-readable view. Build: wcl wdoc build wdoc/book/main.wcl --out out/book
import "../../plan.wcl"

// Waves: fold Kahn's algorithm into list of waves for the build-order table.
let all_owns = flatten(map(specs, fn(s: PlanSpec) -> list<utf8> { s.owns }))
let waves = fold(range(0, len(specs)), [],
  fn(acc: list<list<identifier>>, _i: i64) -> list<list<identifier>> {
    let resolved = flatten(acc);
    let next = map(
      filter(specs, fn(s: PlanSpec) -> bool {
        !list_contains(resolved, s.id) &&
        all(s.depends_on, fn(d: identifier) -> bool { list_contains(resolved, d) })
      }),
      fn(s: PlanSpec) -> identifier { s.id });
    if len(next) == 0 { acc } else { flatten([acc, [next]]) }
  })

site plan {
  default_template = :book
  title = "Project Plan"
  theme = :tokyonight
  theme_toggle = true
  root = true
  toc {
    chapter "PRD" { page = index }
    chapter "Interview" { page = interview }
    chapter "Research" { page = research_page }
    chapter "Surfaces" {
      page = surface_map
      wdoc_repeater { each = surfaces  as = :sf
        chapter $"${sf.name}" { page = $"surface_${sf.id}" }
      }
    }
    chapter "Scenarios" { page = scenarios_page }
    chapter "Contracts" { page = contracts_page }
    chapter "Data models" { page = models_page }
    chapter "Spec DAG" { page = dag }
    chapter "Specs" {
      wdoc_repeater { each = specs  as = :s
        chapter $"${s.title}" { page = $"spec_${s.id}" }
      }
    }
    chapter "Status" { page = status_page }
    chapter "Lessons" { page = lessons_page }
  }
}

page index { sites = [:plan]  start = true
  h1 "Product Requirements"
  h2 "Goals"
  wdoc_repeater { each = goals  as = :g  p $"**${g.id}** — ${g.text}" }
  h2 "Non-goals"
  wdoc_repeater { each = non_goals  as = :g  p $"**${g.id}** — ${g.text}" }
  h2 "Requirements"
  wdoc_repeater { each = requirements  as = :r  p $"**${r.id}** (${r.priority}) — ${r.text}" }
  h2 "Project rules"
  wdoc_repeater { each = rules  as = :r  p $"**${r.id}** — ${r.text}" }
}

page interview { sites = [:plan]
  h1 "Interview questions"
  wdoc_repeater { each = questions  as = :q
    h3 $"${q.id} (${q.status})"
    p $"${q.question}"
    p $"**Answer:** ${q.answer}"
  }
}

page research_page { sites = [:plan]
  h1 "Research"
  wdoc_repeater { each = research  as = :r
    h3 $"${r.id} (${r.status})"
    p $"${r.topic}"
    p $"_Why:_ ${r.why}"
  }
  h2 "Findings"
  wdoc_repeater { each = findings  as = :f
    h3 $"${f.id}"
    p $"${f.summary}"
    project { from = f.detail }
  }
}

page dag { sites = [:plan]
  h1 "Spec dependency DAG"
  diagram {
    width = 700
    height = 500
    layout = :layered
    direction = :top_to_bottom
    layer_gap = 40.0
    wdoc_repeater { each = specs  as = :s
      process $"${s.id}" { id = $"${s.id}"  width = 170.0  height = 44.0  link = $"spec_${s.id}" }
    }
    edges = flatten(map(specs, fn(s: PlanSpec) -> list<record> {
      map(s.depends_on, fn(d: identifier) -> record {
        { source: $"${d}", destination: $"${s.id}" }
      })
    }))
  }
  h2 "Build order (parallel waves)"
  wdoc_repeater { each = enumerate(waves)  as = :w
    p $"**Wave ${at(w, 0)}:** ${join(map(at(w, 1), fn(i: identifier) -> utf8 { $"`${i}`" }), ", ")}"
  }
}

wdoc_repeater { each = specs  as = :s
  page $"spec_${s.id}" { sites = [:plan]
    title = s.title
    h1 $"${s.id} — ${s.title}"
    p $"${s.objective}"
    p $"**Branch:** `${s.branch}` · **Depends on:** ${join(map(s.depends_on, fn(d: identifier) -> utf8 { $"`${d}`" }), ", ")}"
    h2 "Context"
    wdoc_repeater { each = filter([s], fn(x: PlanSpec) -> bool { x.context != none })  as = :sc
      project { from = sc.context }
    }
    h2 "Owns"
    wdoc_repeater { each = s.owns  as = :o  p $"`${o}`" }
    h2 "Tasks"
    wdoc_repeater { each = s.tasks  as = :t  p $"**${t.id}** — ${t.text}" }
    h2 "Boundary"
    callout "Allowed" { class = ["success"]  body = join(s.allowed, " · ") }
    callout "Not allowed" { class = ["error"]  body = join(s.not_allowed, " · ") }
    h2 "Acceptance"
    wdoc_repeater { each = s.acceptance  as = :a  p $"**${a.id}** — ${a.check} — `${a.command}`" }
    h2 "Definition of done"
    wdoc_repeater { each = s.done  as = :d  p $"- ${d}" }
  }
}

page surface_map { sites = [:plan]
  h1 "Surface navigation map"
  diagram {
    width = 700
    height = 400
    layout = :layered
    direction = :left_to_right
    layer_gap = 60.0
    wdoc_repeater { each = surfaces  as = :sf
      process $"${sf.name}" { id = $"${sf.id}"  width = 170.0  height = 44.0  link = $"surface_${sf.id}" }
    }
    edges = flatten(map(surfaces, fn(sf: PlanSurface) -> list<record> {
      map(sf.leads_to, fn(d: identifier) -> record {
        { source: $"${sf.id}", destination: $"${d}" }
      })
    }))
  }
}

wdoc_repeater { each = surfaces  as = :sf
  page $"surface_${sf.id}" { sites = [:plan]
    title = sf.name
    h1 $"${sf.name} (`${sf.id}`)"
    p $"${sf.purpose}"
    p $"**Kind:** ${sf.kind} · **Entry:** ${sf.entry}"
    p $"**Layout:** ${sf.layout}"
    wdoc_repeater { each = filter([sf], fn(x: PlanSurface) -> bool { x.detail != none })  as = :sfd
      project { from = sfd.detail }
    }
    h2 "Elements"
    wdoc_repeater { each = sf.elements  as = :e  p $"- **${e.id}** — ${e.text}" }
    h2 "States"
    wdoc_repeater { each = sf.states  as = :st  p $"- **${st.kind}** — ${st.shows}" }
    h2 "Interactions"
    wdoc_repeater { each = sf.interactions  as = :i  p $"- ${i.action} → ${i.outcome}" }
  }
}

page scenarios_page { sites = [:plan]
  h1 "Usage scenarios"
  wdoc_repeater { each = scenarios  as = :sc
    h2 $"${sc.name}"
    p $"${sc.goal}"
    p $"**Touches:** ${join(map(sc.touches, fn(t: identifier) -> utf8 { $"`${t}`" }), ", ")}"
    wdoc_repeater { each = sc.steps  as = :s
      p $"1. ${s.action} → _${s.expect}_"
    }
  }
}

page contracts_page { sites = [:plan]
  h1 "Interface contracts"
  wdoc_repeater { each = contracts  as = :c
    h2 $"${c.name} (`${c.id}`)"
    p $"${c.purpose}"
    p $"**Provided by:** `${c.provided_by}`"
    wdoc_repeater { each = c.items  as = :ci
      p $"- `${ci.signature}`${if ci.notes != none { $" — ${ci.notes}" } else { "" }}"
    }
  }
}

page models_page { sites = [:plan]
  h1 "Data models"
  diagram {
    width = 700
    height = 350
    layout = :layered
    direction = :left_to_right
    layer_gap = 60.0
    wdoc_repeater { each = models  as = :m
      process $"${m.name}" { id = $"${m.id}"  width = 150.0  height = 44.0 }
    }
    edges = flatten(map(models, fn(m: PlanModel) -> list<record> {
      map(m.relates_to, fn(r: identifier) -> record {
        { source: $"${m.id}", destination: $"${r}" }
      })
    }))
  }
  wdoc_repeater { each = models  as = :m
    h2 $"${m.name} (`${m.id}`)"
    p $"${m.purpose}"
    p $"**Persistence:** ${m.persistence}"
    wdoc_repeater { each = m.fields  as = :f
      p $"- **${f.id}**: `${f.type}`${if f.required { "" } else { " (optional)" }}${if f.validation != none { $" — ${f.validation}" } else { "" }}"
    }
  }
}

page status_page { sites = [:plan]
  h1 "Status"
  h2 "Phase signoffs"
  wdoc_repeater { each = signoffs  as = :sg
    p $"`${sg.id}` — **${sg.state}**${if sg.note != none { $" — ${sg.note}" } else { "" }}"
  }
  h2 "Specs"
  wdoc_repeater { each = statuses  as = :st
    p $"`${st.spec}` — **${st.state}**"
  }
}

page lessons_page { sites = [:plan]
  h1 "Lessons learnt"
  wdoc_repeater { each = lessons  as = :l
    h3 $"${l.id} (${l.date})"
    p $"_Context:_ ${l.context}"
    p $"${l.lesson}"
  }
}
WPLAN_WDOC_BOOK_MAIN_WCL
}

file "wdoc/agent/main.wcl" {
  content = <<'WPLAN_WDOC_AGENT_MAIN_WCL'
// wplan agent export — one self-contained markdown brief per spec, plus an index.
// Build: wcl wdoc markdown wdoc/agent/main.wcl --out out/specs
// Implementation agents read ONLY these .md files. They never need wcl or wdoc.
import "../../plan.wcl"

let waves = fold(range(0, len(specs)), [],
  fn(acc: list<list<identifier>>, _i: i64) -> list<list<identifier>> {
    let resolved = flatten(acc);
    let next = map(
      filter(specs, fn(s: PlanSpec) -> bool {
        !list_contains(resolved, s.id) &&
        all(s.depends_on, fn(d: identifier) -> bool { list_contains(resolved, d) })
      }),
      fn(s: PlanSpec) -> identifier { s.id });
    if len(next) == 0 { acc } else { flatten([acc, [next]]) }
  })

site agent {
  default_template = :webpage
  title = "Agent Specs"
  root = true
}

page index { sites = [:agent]  start = true
  frontmatter {
    doc = "spec-index"
    audience = "orchestrator"
  }
  h1 "Spec index"
  p "One markdown file per spec. Build specs wave by wave; specs within a wave are independent and may be built in parallel on their own branches."
  h2 "Build order (waves)"
  wdoc_repeater { each = enumerate(waves)  as = :w
    p $"**Wave ${at(w, 0)}:** ${join(map(at(w, 1), fn(i: identifier) -> utf8 { $"[`${i}`](spec_${i})" }), ", ")}"
  }
  h2 "Final acceptance scenarios"
  p "After the last wave is merged, every scenario below must pass end to end on trunk. These are the system-level definition of done."
  wdoc_repeater { each = scenarios  as = :sc
    h3 $"${sc.name}"
    p $"${sc.goal}"
    p $"${if sc.ready_after != none { $"**Runnable after `${sc.ready_after}` merges** - run it then; do not wait for the end." } else { "**Final acceptance only** - runnable once every spec is merged." }}"
    wdoc_repeater { each = sc.steps  as = :s
      p $"1. ${s.action} → expect: ${s.expect}"
    }
  }
  h2 "Worktree convention"
  p "Each spec is implemented in its own git worktree at `.tree/<branch>` (branch named in the spec file). Example: `git worktree add .tree/spec/010-build -b spec/010-build`. Merge a spec's branch only after every spec it depends on is merged."
}

wdoc_repeater { each = specs  as = :s
  page $"spec_${s.id}" { sites = [:agent]
    title = s.title
    frontmatter {
      spec = $"${s.id}"
      branch = s.branch
      depends_on = map(s.depends_on, fn(d: identifier) -> utf8 { $"${d}" })
      owns = s.owns
    }
    h1 $"${s.id} — ${s.title}"
    h2 "Objective"
    p $"${s.objective}"
    h2 "Git instructions"
    p $"Work ONLY in the worktree `.tree/${s.branch}` on branch `${s.branch}`. Create it from the project root with: `git worktree add .tree/${s.branch} -b ${s.branch}`. Commit your work to this branch. Do NOT merge; merging is handled after verification."
    p $"**Depends on (must be merged before you start):** ${join(map(s.depends_on, fn(d: identifier) -> utf8 { $"`${d}`" }), ", ")}"
    wdoc_repeater { each = filter(asbuilts, fn(ab: PlanAsBuilt) -> bool { list_contains(s.depends_on, ab.spec) })  as = :ab
      p $"**As built (`${ab.spec}`):** ${ab.note}"
    }
    h2 "Project rules (apply to every spec)"
    wdoc_repeater { each = rules  as = :r  p $"- **${r.id}**: ${r.text}" }
    h2 "Context"
    wdoc_repeater { each = filter([s], fn(x: PlanSpec) -> bool { x.context != none })  as = :sc
      project { from = sc.context }
    }
    wdoc_repeater { each = filter(surfaces, fn(sf: PlanSurface) -> bool { list_contains(s.implements, sf.id) })  as = :sf
      h2 $"Surface to implement: ${sf.name} (`${sf.id}`)"
      p $"${sf.purpose}"
      p $"**Kind:** ${sf.kind} · **Entry:** ${sf.entry}"
      p $"**Layout:** ${sf.layout}"
      p $"**Leads to:** ${join(map(sf.leads_to, fn(d: identifier) -> utf8 { $"`${d}`" }), ", ")}"
      h3 "Elements (all REQUIRED)"
      wdoc_repeater { each = sf.elements  as = :e  p $"- **${e.id}** — ${e.text}" }
      h3 "States (all REQUIRED - the surface is incomplete until every state is implemented)"
      wdoc_repeater { each = sf.states  as = :st  p $"- **${st.kind}** — ${st.shows}" }
      h3 "Interactions (all REQUIRED)"
      wdoc_repeater { each = sf.interactions  as = :i  p $"- ${i.action} → ${i.outcome}" }
    }
    wdoc_repeater { each = filter(contracts, fn(c: PlanContract) -> bool { c.provided_by == s.id })  as = :c
      h2 $"Contract you MUST provide: ${c.name} (`${c.id}`)"
      p $"${c.purpose} Other specs are built against these EXACT signatures - implement them verbatim; renaming or reshaping them breaks sibling specs."
      wdoc_repeater { each = c.items  as = :ci
        p $"- `${ci.signature}`${if ci.notes != none { $" — ${ci.notes}" } else { "" }}"
      }
    }
    wdoc_repeater { each = filter(contracts, fn(c: PlanContract) -> bool { list_contains(s.consumes, c.id) })  as = :c
      h2 $"Contract you consume: ${c.name} (`${c.id}`)"
      p $"Provided by `${c.provided_by}` (already merged). Build against these EXACT signatures - do not reimplement them, do not reach past them into that spec's internals."
      wdoc_repeater { each = c.items  as = :ci
        p $"- `${ci.signature}`${if ci.notes != none { $" — ${ci.notes}" } else { "" }}"
      }
    }
    wdoc_repeater { each = filter(models, fn(m: PlanModel) -> bool { list_contains(s.defines_models, m.id) || list_contains(s.uses_models, m.id) })  as = :m
      h2 $"Data model: ${m.name} (`${m.id}`)${if list_contains(s.defines_models, m.id) { " — you implement this" } else { " — you use this exactly as defined" }}"
      p $"${m.purpose}"
      p $"**Persistence:** ${m.persistence}"
      wdoc_repeater { each = m.fields  as = :f
        p $"- **${f.id}**: `${f.type}`${if f.required { "" } else { " (optional)" }}${if f.validation != none { $" — ${f.validation}" } else { "" }}"
      }
    }
    h2 "File ownership"
    p "You may create or modify ONLY the paths listed below. Every other file in the repository is owned by another spec — do not touch it."
    wdoc_repeater { each = s.owns  as = :o  p $"- `${o}`" }
    h2 "Tasks (in order)"
    wdoc_repeater { each = s.tasks  as = :t  p $"1. **${t.id}** — ${t.text}" }
    h2 "Boundary"
    callout "Allowed" { class = ["success"]  body = join(map(s.allowed, fn(x: utf8) -> utf8 { $"- ${x}" }), "\n") }
    callout "Not allowed" { class = ["error"]  body = join(map(s.not_allowed, fn(x: utf8) -> utf8 { $"- ${x}" }), "\n") }
    h2 "Acceptance checks"
    p "Run every command below from the worktree root. All must pass before you finish."
    p $"${if s.harness != none { $"**How to run this spec's work:** ${s.harness}" } else { "" }}"
    wdoc_repeater { each = s.acceptance  as = :a
      p $"- **${a.id}** — ${a.check}${if a.command != none { $": `${a.command}`" } else { " (manual walkthrough)" }}"
      wdoc_repeater { each = a.walkthrough  as = :w
        p $"    1. ${w.do} → expect: ${w.expect}"
      }
    }
    h2 "Definition of done"
    wdoc_repeater { each = s.done  as = :d  p $"- ${d}" }
    p "When all of the above is complete, stop. Do NOT update any status files; a separate verification agent does that."
  }
}
WPLAN_WDOC_AGENT_MAIN_WCL
}

file "scripts/extract_plan.py" {
  content = <<'WPLAN_SCRIPTS_EXTRACT_PLAN_PY'
#!/usr/bin/env -S uv run
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Derive the plan's WAD data from the plan itself.

Reads plan.wcl (via `wcl diff` against an empty-schema baseline, which returns
every plan block as structured JSON) and fully overwrites
wad/data/generated/plan.wcl with the WAD projection of the planned system:

  surface :screen/:command -> screen        (wireframe body copied verbatim;
                                             post-build code extractors later
                                             replace :command screens with real
                                             cli_command blocks)
  surface :endpoint        -> api_endpoint rows in one :api code_item
  contract                 -> :module_api code_item (signature rows)
  model                    -> domain_object (+fields, :references relations)
  scenario                 -> use_case (steps + sequential flow)
  requirement (not :wont)  -> rule rows under `standard plan_requirements`
  rule                     -> rule rows under `standard plan_rules`
  goal / non_goal          -> `article plan_goals` (overview chapter)
  spec (+status)           -> spec (tasks -> instructions, accept -> acceptance,
                                    exact plan state kept as a plan_state: tag)

Attribution: fill the SURFACE_CONTAINER / SPEC_CONTAINER / SCENARIO_PERSONA
tables below with ids of hand-authored containers/personas (declare those in
wad/data/systems/ and wad/data/personas/). Unmapped blocks fall back to the
synthetic `plan_unassigned` container / `plan_user` persona so everything
renders on day one — their presence in the book is the steering prompt.

Run via `just wad-extract` from the plan folder.
"""

import json
import re
import subprocess
import sys
from pathlib import Path

PLAN_ROOT = Path(__file__).resolve().parents[1]
WAD_ROOT = PLAN_ROOT / "wad"
OUT = WAD_ROOT / "data" / "generated" / "plan.wcl"
BASELINE = PLAN_ROOT / "out" / ".wad_baseline.wcl"

# ---- attribution tables (the steering knobs — edit these, never the output) --
SYSTEM_ID = "auto"                      # "auto" = read from wad/wad.wcl
SURFACE_CONTAINER: dict[str, str] = {}  # surface id -> hand-authored container id
SPEC_CONTAINER: dict[str, str] = {}     # spec id -> container id (spec.affected + contract homes)
SCENARIO_PERSONA: dict[str, str] = {}   # scenario id -> hand-authored persona id

UNASSIGNED = "plan_unassigned"
DEFAULT_PERSONA = "plan_user"

BANNER = (
    "// GENERATED by scripts/extract_plan.py (plan folder) — do not hand-edit;\n"
    "// re-run `just wad-extract`. Source: plan.wcl via `wcl diff --format json`.\n"
    "// Hand-authored WAD data must NOT reuse plan ids or the `plan_` prefix.\n"
    "namespace wcl.wad\n"
)


def wcl_str(s: str) -> str:
    out = s.replace("\\", "\\\\").replace('"', '\\"')
    out = out.replace("\n", "\\n").replace("\t", "\\t").replace("\r", "\\r")
    return f'"{out}"'


# ---- input: the plan as JSON --------------------------------------------------


def read_plan() -> dict[str, list[dict]]:
    """Every plan block, grouped by entity kind, via the diff-JSON seam."""
    BASELINE.parent.mkdir(parents=True, exist_ok=True)
    BASELINE.write_text('import "../schema/plan_schema.wcl"\n')
    proc = subprocess.run(
        ["wcl", "diff", str(BASELINE), "plan.wcl", "--format", "json"],
        cwd=PLAN_ROOT,
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr)
        sys.stderr.write("extract_plan: `wcl diff` failed — is plan.wcl green?\n")
        sys.exit(1)
    by_kind: dict[str, list[dict]] = {}
    for change in json.loads(proc.stdout):
        if change.get("op") != "added":
            continue
        kind = change["entity"].split(":", 1)[0]
        by_kind.setdefault(kind, []).append(change["value"])
    for vals in by_kind.values():
        vals.sort(key=lambda v: str(v.get("id") or v.get("spec") or ""))
    return by_kind


def read_wad_meta() -> tuple[str, str]:
    """(system id, created date) from wad/wad.wcl."""
    text = (WAD_ROOT / "wad.wcl").read_text()
    m_id = re.search(r"^wad\s+([A-Za-z_][A-Za-z0-9_]*)\s*\{", text, re.M)
    m_created = re.search(r'created\s*=\s*"([^"]+)"', text)
    system = SYSTEM_ID if SYSTEM_ID != "auto" else (m_id.group(1) if m_id else "system")
    created = m_created.group(1) if m_created else "1970-01-01"
    return system, created


# ---- wireframe pass: copy surface bodies verbatim out of surfaces.wcl ---------


def surface_bodies() -> dict[str, str]:
    """surface id -> the verbatim inner source of its `body { … }` block.

    A small string/comment/heredoc-aware brace scanner — bodies hold wireframe
    diagrams the diff JSON can only show as opaque refs. A body the scanner
    can't match is skipped with a warning; the run never fails on this pass.
    """
    path = PLAN_ROOT / "surfaces.wcl"
    if not path.exists():
        return {}
    text = path.read_text()
    tokens = _scan_regions(text)
    bodies: dict[str, str] = {}
    for sid, start, end in tokens:
        bodies[sid] = text[start:end]
    return bodies


def _scan_regions(text: str) -> list[tuple[str, int, int]]:
    """(surface id, body-inner-start, body-inner-end) triples."""
    out: list[tuple[str, int, int]] = []
    i, n = 0, len(text)
    depth = 0
    surface_id: str | None = None
    surface_depth = -1

    def skip_ws_comments(j: int) -> int:
        while j < n:
            if text[j] in " \t\r\n":
                j += 1
            elif text.startswith("//", j):
                while j < n and text[j] != "\n":
                    j += 1
            else:
                break
        return j

    while i < n:
        ch = text[i]
        if text.startswith("//", i):
            while i < n and text[i] != "\n":
                i += 1
            continue
        if ch == '"':
            i += 1
            while i < n and text[i] != '"':
                i += 2 if text[i] == "\\" else 1
            i += 1
            continue
        m = re.match(r"\$?<<'?([A-Za-z_][A-Za-z0-9_]*)'?", text[i:]) if ch in "$<" else None
        if m:
            term = m.group(1)
            end = text.find(f"\n{term}\n", i)
            i = (end + len(term) + 2) if end != -1 else n
            continue
        if ch == "{":
            depth += 1
            i += 1
            continue
        if ch == "}":
            depth -= 1
            if surface_id is not None and depth < surface_depth:
                surface_id = None
            i += 1
            continue
        m = re.match(r"surface\s+([A-Za-z_][A-Za-z0-9_]*)\s*", text[i:])
        if m and depth == 0 and (i == 0 or text[i - 1] in " \t\r\n"):
            j = skip_ws_comments(i + m.end())
            if j < n and text[j] == "{":
                surface_id = m.group(1)
                surface_depth = depth + 1
            i += m.end()
            continue
        m = re.match(r"body\s*", text[i:])
        if (
            m
            and surface_id is not None
            and depth == surface_depth
            and (i == 0 or text[i - 1] in " \t\r\n")
        ):
            j = skip_ws_comments(i + m.end())
            if j < n and text[j] == "{":
                inner_start = j + 1
                # find the matching close brace with the same scanner rules
                k, d = inner_start, 1
                while k < n and d > 0:
                    c = text[k]
                    if text.startswith("//", k):
                        while k < n and text[k] != "\n":
                            k += 1
                        continue
                    if c == '"':
                        k += 1
                        while k < n and text[k] != '"':
                            k += 2 if text[k] == "\\" else 1
                        k += 1
                        continue
                    mh = re.match(r"\$?<<'?([A-Za-z_][A-Za-z0-9_]*)'?", text[k:]) if c in "$<" else None
                    if mh:
                        term = mh.group(1)
                        e2 = text.find(f"\n{term}\n", k)
                        k = (e2 + len(term) + 2) if e2 != -1 else n
                        continue
                    if c == "{":
                        d += 1
                    elif c == "}":
                        d -= 1
                    k += 1
                if d == 0:
                    out.append((surface_id, inner_start, k - 1))
                    i = k
                    surface_id = None
                    continue
                sys.stderr.write(
                    f"extract_plan: warning — unterminated body for surface {surface_id}; skipping wireframe\n"
                )
            i += m.end()
            continue
        i += 1
    return out


# ---- emitters ------------------------------------------------------------------


def emit_body_lines(lines: list[str], indent: str = "  ") -> list[str]:
    return [f"{indent}{ln}" for ln in lines]


def surface_prose(s: dict) -> list[str]:
    """The structured surface fields as body statements (list of WCL lines)."""
    out: list[str] = []
    if s.get("layout"):
        out.append(f'p {wcl_str("**Layout.** " + s["layout"])}')
    if s.get("elements"):
        out.append('p "**Elements**"')
        out.append("list {")
        for e in s["elements"]:
            out.append(f"  li {wcl_str(e['text'])}")
        out.append("}")
    if s.get("states"):
        out.append('p "**States**"')
        out.append("list {")
        for st in s["states"]:
            out.append(f"  li {wcl_str('**' + st['kind'] + '** — ' + st['shows'])}")
        out.append("}")
    if s.get("interactions"):
        out.append('p "**Interactions**"')
        out.append("list {")
        for ia in s["interactions"]:
            out.append(f"  li {wcl_str(ia['action'] + ' → ' + ia['outcome'])}")
        out.append("}")
    return out


def surface_detail_text(s: dict) -> str:
    """The structured fields as one plain-text block (api_endpoint description)."""
    parts: list[str] = []
    if s.get("layout"):
        parts.append(f"Layout: {s['layout']}")
    for e in s.get("elements", []):
        parts.append(f"Element: {e['text']}")
    for st in s.get("states", []):
        parts.append(f"State {st['kind']}: {st['shows']}")
    for ia in s.get("interactions", []):
        parts.append(f"Interaction: {ia['action']} → {ia['outcome']}")
    return "\n".join(parts)


def check_collisions(emitted_ids: set[str]) -> None:
    """Fail when hand-authored WAD data declares an id this run emits."""
    block_re = re.compile(
        r"^\s*(?:screen|use_case|domain_object|standard|article|spec|persona|container|code_item)"
        r"\s+([A-Za-z_][A-Za-z0-9_]*)\s*\{",
        re.M,
    )
    clashes: list[str] = []
    for path in sorted((WAD_ROOT / "data").rglob("*.wcl")):
        if path == OUT or "generated" in path.parts:
            continue
        for m in block_re.finditer(path.read_text()):
            if m.group(1) in emitted_ids:
                clashes.append(f"  {m.group(1)}  (also in {path.relative_to(WAD_ROOT)})")
    if clashes:
        sys.stderr.write(
            "extract_plan: hand-authored WAD data reuses plan-owned ids — rename these blocks:\n"
            + "\n".join(clashes)
            + "\n"
        )
        sys.exit(1)


def main() -> int:
    if not WAD_ROOT.exists():
        sys.stderr.write("extract_plan: no wad/ folder — run `just wad-init <id> \"<Name>\"` first\n")
        return 1
    plan = read_plan()
    system_id, created = read_wad_meta()
    bodies = surface_bodies()

    surfaces = plan.get("surface", [])
    screens = [s for s in surfaces if s.get("kind") in ("screen", "command")]
    endpoints = [s for s in surfaces if s.get("kind") == "endpoint"]
    scenarios = plan.get("scenario", [])
    contracts = plan.get("contract", [])
    models = plan.get("model", [])
    requirements = [r for r in plan.get("requirement", []) if r.get("priority") != "wont"]
    rules = plan.get("rule", [])
    goals = plan.get("goal", [])
    non_goals = plan.get("non_goal", [])
    specs = plan.get("spec", [])
    status_of = {st["spec"]: st.get("state", "todo") for st in plan.get("status", [])}

    screen_ids = {s["id"] for s in screens}
    emitted = (
        screen_ids
        | {c["id"] for c in contracts}
        | {m_["id"] for m_ in models}
        | {sc["id"] for sc in scenarios}
        | {sp["id"] for sp in specs}
        | ({"plan_http_api"} if endpoints else set())
        | ({"plan_requirements"} if requirements else set())
        | ({"plan_rules"} if rules else set())
        | ({"plan_goals"} if goals or non_goals else set())
    )
    check_collisions(emitted)
    need_persona = bool(screens) or any(sc["id"] not in SCENARIO_PERSONA for sc in scenarios)
    need_unassigned = (
        any(s["id"] not in SURFACE_CONTAINER for s in screens)
        or any(c.get("provided_by") not in SPEC_CONTAINER for c in contracts)
        or (bool(endpoints) and any(s["id"] not in SURFACE_CONTAINER for s in endpoints))
    )

    blocks: list[str] = []

    # -- synthetic fallbacks (only when something needs them) --
    if need_persona:
        lines = [
            f"persona {DEFAULT_PERSONA} {{",
            '  name    = "The user"',
            '  summary = "Placeholder persona from the plan — replace by mapping scenarios in extract_plan.py\'s SCENARIO_PERSONA and authoring real personas."',
            "  kind    = :human",
        ]
        if goals:
            lines.append("  goals = [")
            lines += [f"    {wcl_str(g['text'])}," for g in goals]
            lines.append("  ]")
        lines.append("}")
        blocks.append("\n".join(lines))
    if need_unassigned:
        blocks.append(
            "\n".join(
                [
                    f"container {UNASSIGNED} {{",
                    f"  system  = {system_id}",
                    '  name    = "Unassigned (map in extract_plan.py)"',
                    '  summary = "Everything the plan extractor could not attribute — fill the SURFACE_CONTAINER / SPEC_CONTAINER tables and re-extract."',
                    "  kind    = :other",
                    "}",
                ]
            )
        )

    # -- screens (screen + command surfaces) --
    for s in screens:
        container = SURFACE_CONTAINER.get(s["id"], UNASSIGNED)
        nav = [t for t in s.get("leads_to", []) if t in screen_ids]
        lines = [
            f"screen {s['id']} {{",
            f"  name      = {wcl_str(s['name'])}",
            f"  summary   = {wcl_str(s['purpose'])}",
            f"  container = {container}",
            f"  route     = {wcl_str(s['entry'])}",
            f"  personas  = [{DEFAULT_PERSONA}]" if need_persona else "  personas  = []",
        ]
        if nav:
            lines.append(f"  nav_to    = [{', '.join(nav)}]")
        prose = surface_prose(s)
        wire = bodies.get(s["id"])
        if prose or wire:
            lines.append("  body {")
            lines += emit_body_lines(prose, "    ")
            if wire:
                lines.append(_dedent_verbatim(wire, "    "))
            lines.append("  }")
        lines.append("}")
        blocks.append("\n".join(lines))

    # -- endpoint surfaces: one :api code_item --
    if endpoints:
        ep_containers = {SURFACE_CONTAINER.get(s["id"]) for s in endpoints}
        container = ep_containers.pop() if len(ep_containers) == 1 and None not in ep_containers else UNASSIGNED
        lines = [
            "code_item plan_http_api {",
            f"  container = {container}",
            '  name      = "Planned API surface"',
            '  summary   = "The endpoint surfaces the plan defines."',
            "  kind      = :api",
        ]
        for s in endpoints:
            m = re.match(r"([A-Z]+)\s+(\S.*)", s.get("entry", ""))
            method, path_ = (m.group(1), m.group(2)) if m else ("GET", s.get("entry", "/"))
            lines.append(f"  api_endpoint ep_{s['id']} {{")
            lines.append(f"    method = {wcl_str(method)}  path = {wcl_str(path_)}")
            lines.append(f"    summary = {wcl_str(s['purpose'])}")
            detail = surface_detail_text(s)
            if detail:
                lines.append(f"    description = {wcl_str(detail)}")
            lines.append("  }")
        lines.append("}")
        blocks.append("\n".join(lines))

    # -- contracts: one :module_api code_item each --
    for c in contracts:
        container = SPEC_CONTAINER.get(c.get("provided_by", ""), UNASSIGNED)
        lines = [
            f"code_item {c['id']} {{",
            f"  container = {container}",
            f"  name      = {wcl_str(c['name'])}",
            f"  summary   = {wcl_str(c['purpose'] + ' Provided by spec ' + c.get('provided_by', '?') + '.')}",
            "  kind      = :module_api",
            f"  code_node n_{c['id']} {{",
            f"    name = {wcl_str(c['name'])}",
            '    kind = "contract"',
        ]
        for i, item in enumerate(c.get("items", [])):
            sig = item["signature"] + (f" — {item['notes']}" if item.get("notes") else "")
            lines.append(f"    code_member m_{c['id']}_{i} {{")
            lines.append(f"      signature = {wcl_str(sig)}")
            lines.append("    }")
        lines += ["  }", "}"]
        blocks.append("\n".join(lines))

    # -- models: domain objects --
    for m_ in models:
        lines = [
            f"domain_object {m_['id']} {{",
            f"  name    = {wcl_str(m_['name'])}",
            f"  summary = {wcl_str(m_['purpose'])}",
        ]
        for f in m_.get("fields", []):
            notes = " · ".join(x for x in [f.get("validation"), f.get("notes")] if x)
            extra = f"  summary = {wcl_str(notes)}" if notes else ""
            req = "true" if f.get("required", True) else "false"
            lines.append(f"  field {f['id']} {{ type = {wcl_str(f['type'])}  required = {req}{extra} }}")
        for to in m_.get("relates_to", []):
            lines.append(f"  domain_rel rel_{m_['id']}_{to} {{ to = {to}  kind = :references }}")
        if m_.get("persistence"):
            lines += ["  body {", f"    p {wcl_str('**Persistence.** ' + m_['persistence'])}", "  }"]
        lines.append("}")
        blocks.append("\n".join(lines))

    # -- scenarios: use cases --
    for sc in scenarios:
        persona = SCENARIO_PERSONA.get(sc["id"], DEFAULT_PERSONA)
        tags = [f"plan:touches:{t}" for t in sc.get("touches", [])]
        if sc.get("ready_after"):
            tags.append(f"plan:ready_after:{sc['ready_after']}")
        lines = [
            f"use_case {sc['id']} {{",
            f"  title   = {wcl_str(sc['name'])}",
            f"  persona = {persona}",
            f"  summary = {wcl_str(sc['goal'])}",
            f"  outcome = {wcl_str(sc['goal'])}",
        ]
        if tags:
            lines.append(f"  tags = [{', '.join(wcl_str(t) for t in tags)}]")
        steps = sc.get("steps", [])
        for i, st in enumerate(steps, start=1):
            lines.append(f"  step {sc['id']}_s{i} {{ n = {i}")
            lines.append(f"    title = {wcl_str(st['action'])}")
            lines.append(f"    body b {{ p {wcl_str('Expect: ' + st['expect'])} }}")
            lines.append("  }")
        for i in range(1, len(steps)):
            lines.append(f"  {sc['id']}_s{i} -> {sc['id']}_s{i + 1}")
        lines.append("}")
        blocks.append("\n".join(lines))

    # -- PRD requirements & rules as standards --
    if requirements:
        lines = [
            "standard plan_requirements {",
            '  title   = "PRD requirements"',
            "  kind    = :business",
            '  summary = "What the planned system must do — the plan PRD\'s requirements (non-:wont)."',
        ]
        for r in requirements:
            lines.append(f"  rule {r['id']} {{")
            lines.append(f"    text = {wcl_str(r['text'])}")
            lines.append(f"    rationale = {wcl_str('Priority: ' + r.get('priority', 'must'))}")
            lines.append("  }")
        lines.append("}")
        blocks.append("\n".join(lines))
    if rules:
        lines = [
            "standard plan_rules {",
            '  title   = "Project rules (from the plan)"',
            "  kind    = :process",
            '  summary = "Universal rules every implementation agent works under."',
        ]
        for r in rules:
            lines.append(f"  rule {r['id']} {{")
            lines.append(f"    text = {wcl_str(r['text'])}")
            lines.append('    enforced_by = "wplan briefs (copied into every spec)"')
            lines.append("  }")
        lines.append("}")
        blocks.append("\n".join(lines))

    # -- goals article --
    if goals or non_goals:
        lines = [
            "article plan_goals {",
            '  title   = "Goals & non-goals"',
            "  section = :overview",
            '  summary = "What the planned system must achieve — from the plan PRD."',
            "  order   = 99",
            "  body {",
        ]
        if goals:
            lines.append('    p "**Goals**"')
            lines.append("    list {")
            lines += [f"      li {wcl_str(g['text'])}" for g in goals]
            lines.append("    }")
        if non_goals:
            lines.append('    p "**Non-goals**"')
            lines.append("    list {")
            lines += [f"      li {wcl_str(g['text'])}" for g in non_goals]
            lines.append("    }")
        lines += ["  }", "}"]
        blocks.append("\n".join(lines))

    # -- specs --
    state_map = {"todo": ":planning", "merged": ":complete", "blocked": ":blocked"}
    for sp in specs:
        state = status_of.get(sp["id"], "todo")
        wad_status = state_map.get(state, ":in_progress")
        tags = [f"plan_state:{state}", f"plan:branch:{sp.get('branch', '')}"]
        tags += [f"plan:depends_on:{d}" for d in sp.get("depends_on", [])]
        lines = [
            f"spec {sp['id']} {{",
            f"  title   = {wcl_str(sp['title'])}",
            f"  status  = {wad_status}",
            f"  created = {wcl_str(created)}",
            f"  summary = {wcl_str(sp['objective'])}",
        ]
        if sp.get("tasks"):
            lines.append("  instructions = [")
            lines += [f"    {wcl_str(t['text'])}," for t in sp["tasks"]]
            lines.append("  ]")
        if sp.get("acceptance"):
            lines.append("  acceptance = [")
            for a in sp["acceptance"]:
                text = a["check"] + (f" — verify: `{a['command']}`" if a.get("command") else "")
                lines.append(f"    {wcl_str(text)},")
            lines.append("  ]")
        if sp["id"] in SPEC_CONTAINER:
            lines.append(f"  affected = [{SPEC_CONTAINER[sp['id']]}]")
        lines.append(f"  tags = [{', '.join(wcl_str(t) for t in tags)}]")
        lines.append("}")
        blocks.append("\n".join(lines))

    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(BANNER + "\n" + "\n\n".join(blocks) + ("\n" if blocks else ""))
    print(f"wrote {OUT.relative_to(PLAN_ROOT)} ({len(blocks)} blocks)")
    return 0


def _dedent_verbatim(text: str, indent: str) -> str:
    """Re-indent a verbatim body slice to sit inside the generated block."""
    lines = text.strip("\n").splitlines()
    strip = min((len(ln) - len(ln.lstrip()) for ln in lines if ln.strip()), default=0)
    return "\n".join(indent + ln[strip:] if ln.strip() else "" for ln in lines)


if __name__ == "__main__":
    sys.exit(main())
WPLAN_SCRIPTS_EXTRACT_PLAN_PY
}
