    <div style="border-top:1px solid var(--border-subtle);">
      <div style="max-width:1120px; margin:0 auto; padding:18px 24px; display:flex; flex-wrap:wrap; gap:12px; justify-content:space-between; align-items:center;">
        <span style="font-size:12px; color:var(--fg-3);">© 2026 WCL · Wil Taylor</span>
        <span style="font-size:12px; color:var(--fg-3); display:inline-flex; align-items:center; gap:7px;"><span style="width:6px; height:6px; border-radius:999px; background:var(--warning); display:inline-block;"></span> Heavy development — not production ready</span>
      </div>
    </div>
  </footer>

</div>
HTML

let landing_js = <<JS
<script>
(function(){
  var root = document.querySelector('.wcl-root');
  if (!root) return;
  try {
    var saved = localStorage.getItem('wcl-theme');
    if (saved === 'dark' || saved === 'light') root.setAttribute('data-theme', saved);
  } catch (e) {}
  var btn = root.querySelector('[data-theme-toggle]');
  if (btn) btn.addEventListener('click', function () {
    var cur = root.getAttribute('data-theme');
    if (!cur) cur = (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) ? 'light' : 'dark';
    var next = cur === 'light' ? 'dark' : 'light';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('wcl-theme', next); } catch (e) {}
  });
})();
</script>
JS

// The landing template: the design's fonts go into <head> (so they load
// before paint), then the scoped <style>, the markup, and the toggle script
// render into <body>. `c.content` is intentionally ignored — the HTML design
// carries its own copy; the page body exists only for the Markdown/PDF output.
template landing {
  render = fn(c: TemplateCtx) -> list<HtmlFundamental>
    flatten([
      wdoc_head_font("https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"),
      [
        HtmlFundamental::Element {
          tag: "style", id: none, class: none, attrs: none,
          children: [ HtmlFundamental::Raw { html: landing_css } ],
        },
        HtmlFundamental::Raw { html: landing_html },
        HtmlFundamental::Raw { html: landing_js },
      ],
    ])
}
