// WCL landing page. `start = true` makes it the page served at `/`.
// `template = :landing` renders the bespoke marketing design (HTML/CSS,
// see landing.wcl) for the HTML build; that template ignores `c.content`,
// so the wdoc blocks below exist purely so the Markdown / PDF backends —
// which don't run the template — still get a sensible page.

// The optional views each member ships (empty lists when nobody does) —
// appended to a member's entry as extra links.
let wskill_decks   = included_sites({ folder: "wskills", entry: "wdoc/presentation/main.wcl", prefix: "decks" })
let wskill_courses = included_sites({ folder: "wskills", entry: "wdoc/training/main.wcl", prefix: "training" })
let wskill_view_links = fn(n: utf8) -> utf8 {
  let d = join(map(filter(wskill_decks,   fn(x: IncludeEntry) -> bool { x.name == n }), fn(x: IncludeEntry) -> utf8 { $" · [deck](./${x.href})" }), "");
  let c = join(map(filter(wskill_courses, fn(x: IncludeEntry) -> bool { x.name == n }), fn(x: IncludeEntry) -> utf8 { $" · [course](./${x.href})" }), "");
  $"${d}${c}"
}

page index { sites = [:wcl]  title = "Why WCL?"  start = true  template = :landing
  callout "Heavy development — not production ready" {
    class = ["warning"]
    body  = "WCL is under **heavy active development** and is **not ready for production use**. The language, APIs, and `wdoc` output can change at any time without notice."
  }

  h1 "Why WCL?"


  p "WCL was created out of my desire to have a language that could express most forms of data in a natural way."

  p "This then enables a lot of different use cases. Detailed configurations, WDoc which lets you model the data in a format that makes sense and then present multiple views on it."

  h2 "Reference"

  p "WCL's reference is published as **wskills** — self-contained WCL models, each projected into a book (linked below) and a Claude Code skill. The [wdoc Reference](reference:index) book documents the documentation generator's blocks."

  // One linked entry per wskill under docs/wskills/, discovered and built by the
  // `include` in main.wcl. Title / summary come from each member's book site; the
  // `wskills/<name>/` href is root-relative (this landing is the root site).
  // Members that ship the optional deck / training views get extra links (their
  // entry files exist only when a member ships that view).
  wdoc_repeater { each = included_sites({ folder: "wskills", entry: "wdoc/book/main.wcl" })  as = :s
    p $"**[${s.title}](./${s.href})**${match s.summary { none => "", su => $" — ${su}" }}${wskill_view_links(s.name)}"
  }

  h2 "A taste"

  p "A document is fields and blocks; a schema declared with decorators validates the structure."

  code wcl {
    source = <<'WCL'
      @block("service")
      type Service {
        @inline(0)   name: utf8     // service "web" → name = "web"
        @default(80) port: u32
        region: utf8
      }

      @document
      type Config {
        @children("service") services: list<Service>
      }

      service "web" {
        region = "us-east-1"
      }
      service "api" {
        port   = 9090u32
        region = "eu-west-1"
      }
      WCL
  }
}
