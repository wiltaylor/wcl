// wdoc section: Pages.
page wdoc_pages { sites = [:reference]  title = "Pages"
  h1 "Pages"

  p "A `page` block declares one rendered HTML page. Each page joins one or more sites and holds the content blocks that make up its body."

  h2 "Fields"

  type_table { type = Page }

  h2 "A page"

  code wcl {
    source = <<'WCL'
import <wdoc.wcl>

page index { sites = [:mysite]  start = true
  h1 "My project"
  p "A short intro."
}
WCL
  }

  callout "Per-site page names" {
    class = ["note"]
    body  = "Page names are unique per site, so two different sites can each have a page called index. Once a document declares more than one site, every page must name its sites — a page carrying none is a build error, and a shared page says so with sites = [:docs, :blog]. A single-site document needs no sites field anywhere."
  }

  h2 "Cross-page links"

  p "Inside any `p` or `span`, write a markdown-style link where the URL is a bare page name for an in-site link, or `site_name:page_name` for a cross-site link. Links to unknown pages are build errors, so renaming a page can't silently break navigation."
  code wcl {
    source = <<'WCL'
p "See [the about page](about) or jump to [the docs](docs:index)."
WCL
  }
}
