// wdoc section: Icons.
page wdoc_icons { sites = [:reference]
  h1 "Icons"

  p "Full **Lucide** and **Bootstrap Icons** packs ship compiled into the binary. No runtime disk read; only used icons are emitted into the output sprite (`_wdoc/icons.svg`). Icons paint with `currentColor`, so colour follows the surrounding text or class."

  h2 "Three ways to use an icon"

  code wcl {
    source = <<'WCL'
// 1. Inline pattern in a p (or span):
p "Status: :lucide.check: ready"

// 2. Placeable icon block (a legal diagram child):
diagram {
  width = 80  height = 80
  icon {
    name = "lucide.compass"
    x = 10.0  y = 10.0  width = 60.0  height = 60.0
  }
}

// 3. Badge on a shape — any rect/circle/container/process/...
//    accepts icon / icon_size / icon_pos / icon_class.
process "Validate" {
  id = v  width = 120.0  height = 50.0
  icon = "lucide.shield-check"
  icon_pos = :top_right
}
WCL
  }

  h2 "Iconsets"

  p "Declare an `iconset` to rename a pack or set default styling. Per-icon `icon_def` children override individual icons within the set."

  code wcl {
    source = <<'WCL'
iconset ui {
  pack  = "lucide"
  size  = "1.15em"
  color = "var(--wdoc-accent)"
  icon_def "heart" { color = "#bf616a" }
}

// Bare :name: now reads from the ui iconset:
p "We :heart: WCL."
WCL
  }

  h2 "Icon-position symbols"

  p "When using `icon` as a shape badge, `icon_pos` accepts one of: `:center`, `:top_left` (default), `:top_right`, `:bottom_left`, `:bottom_right`, `:left`, `:right`."

  callout "Icons need serving" {
    class = ["note"]
    body  = "The icon sprite is referenced by <use href>, so icons only resolve when served or hosted — not via file:// directly. Same limitation as terminal fonts and tileset images."
  }

  p "Next: [Images](wdoc_images)."
}
