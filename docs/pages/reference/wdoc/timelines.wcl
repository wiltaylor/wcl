// wdoc section: Timelines.
page wdoc_timelines { sites = [:reference]
  h1 "Timelines"

  p "`timeline` is a **real-time axis** — dates are ISO strings (`\"2026-03-15\"` / `\"…14:30\"`) and tick boundaries land on real calendar dates (month 1sts, Mondays, …). A `unit` (`:minutes`..`:years`) sets granularity; omit it for auto-fit from the event span."

  h2 "Authoring"

  code wcl {
    source = <<'WCL'
timeline {
  start = "2026-01-01"
  end   = "2026-12-31"
  unit  = :months
  items: list<TimelineItem> = [
    TimelineItem::On { label: "Kickoff",  on: "2026-02-01" },
    TimelineItem::On { label: "Beta",     on: "2026-06-15" },
    TimelineItem::On { label: "Release",  on: "2026-11-01" },
  ]
  phases: list<TimelinePhase> = [
    TimelinePhase::Of { label: "Build",  from: "2026-02-01", to: "2026-06-15" },
    TimelinePhase::Of { label: "Polish", from: "2026-06-15", to: "2026-11-01" },
  ]
}
WCL
  }

  h2 "Fields"

  table {
    rows:
      | "Field"        | "Meaning" |
      | "`start` / `end`" | "ISO date bounds (auto-fit from items otherwise)" |
      | "`unit`"       | "`:minutes` / `:hours` / `:days` / `:weeks` / `:months` / `:years`" |
      | "`every`"      | "Override tick interval (default ~6–12 ticks)" |
      | "`direction`"  | "`:horizontal` (default) or `:vertical`" |
      | "`items`"      | "List of `TimelineItem::On` (auto-alternates side) or `TimelineItem::OnSided` (forces `:near`/`:far`)" |
      | "`phases`"     | "List of `TimelinePhase::Of { label from to }` for dated bands" |
  }

  h2 "Items vs phases"

  p "An **item** is a point event — a marker, a lead line, and a label, pinned to a single date. A **phase** is a span — a labelled band between `from` and `to`, drawn as a divider plus a heading. Phases cycle the `wdoc-series-N` palette so adjacent bands stand out."

  callout "Bad dates skip" {
    class = ["info"]
    body  = "A malformed or unparseable date skips that single element rather than failing the build. The rest of the timeline still renders."
  }

  p "A timeline can also accept rich-text **cards** as event items, pinned to dates. See the next chapter."

  p "Next: [Cards](wdoc_cards)."
}
