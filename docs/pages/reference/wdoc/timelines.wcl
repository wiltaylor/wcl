// wdoc section: Timelines.
page wdoc_timelines { sites = [:reference]
  h1 "Timelines"

  p "`timeline` is a **real-time axis** — dates are ISO strings (`\"2026-03-15\"` / `\"…14:30\"`) and tick boundaries land on real calendar dates (month 1sts, Mondays, …). A `unit` (`:minutes`..`:years`) sets granularity; omit it for auto-fit from the event span."

  h2 "Horizontal"

  diagram { width = 560  height = 220
    timeline { width = 560.0  height = 220.0
      title = "2026 roadmap"
      start = "2026-01-01"
      end   = "2026-12-31"
      unit  = :months
      items = [
        { label: "Kickoff",  on: "2026-02-20" },
        { label: "Beta",     on: "2026-05-10" },
        { label: "Release",  on: "2026-09-20", side: :far },
      ]
      phases = [
        { label: "Build",  from: "2026-02-01", to: "2026-06-15" },
        { label: "Polish", from: "2026-06-15", to: "2026-11-01" },
      ]
    }
  }

  code wcl {
    source = <<'WCL'
diagram { width = 560  height = 220
  timeline { width = 560.0  height = 220.0
    title = "2026 roadmap"
    start = "2026-01-01"
    end   = "2026-12-31"
    unit  = :months
    items = [
      { label: "Kickoff",  on: "2026-02-20" },
      { label: "Beta",     on: "2026-05-10" },
      { label: "Release",  on: "2026-09-20", side: :far },
    ]
    phases = [
      { label: "Build",  from: "2026-02-01", to: "2026-06-15" },
      { label: "Polish", from: "2026-06-15", to: "2026-11-01" },
    ]
  }
}
WCL
  }

  h2 "Vertical"

  p "Set `direction = :vertical` to read top-to-bottom, with items alternating left and right of the axis. Omitting `start` / `end` auto-fits the scale to the event dates."

  diagram { width = 300  height = 320
    timeline { width = 300.0  height = 320.0
      direction = :vertical
      title     = "Release history"
      unit      = :months
      items = [
        { label: "1.0 alpha", on: "2025-10-15" },
        { label: "1.0",       on: "2026-01-10" },
        { label: "2.0 beta",  on: "2026-05-01" },
        { label: "2.0",       on: "2026-07-10" },
      ]
      phases = [
        { label: "1.x", from: "2025-09-01", to: "2026-02-01" },
        { label: "2.x", from: "2026-02-01", to: "2026-08-01" },
      ]
    }
  }

  code wcl {
    source = <<'WCL'
diagram { width = 300  height = 320
  timeline { width = 300.0  height = 320.0
    direction = :vertical
    title     = "Release history"
    unit      = :months
    items = [
      { label: "1.0 alpha", on: "2025-10-15" },
      { label: "1.0",       on: "2026-01-10" },
      { label: "2.0 beta",  on: "2026-05-01" },
      { label: "2.0",       on: "2026-07-10" },
    ]
    phases = [
      { label: "1.x", from: "2025-09-01", to: "2026-02-01" },
      { label: "2.x", from: "2026-02-01", to: "2026-08-01" },
    ]
  }
}
WCL
  }

  h2 "Fields"

  type_table { type = Timeline }

  h2 "Phases"

  p "A **phase** is a labelled span between a `from` and a `to` date — drawn as a perpendicular divider at each boundary with a heading naming the band. Phases group the point items into stages (discovery, build, launch, …); each one cycles the `wdoc-series-N` palette so adjacent bands stand out, and follows the site theme or a `class` override like everything else."

  diagram { width = 560  height = 200
    timeline { width = 560.0  height = 200.0
      title = "Project phases"
      start = "2026-01-01"
      end   = "2026-12-31"
      unit  = :months
      phases = [
        { label: "Discovery", from: "2026-01-01", to: "2026-03-01" },
        { label: "Design",    from: "2026-03-01", to: "2026-05-15" },
        { label: "Build",     from: "2026-05-15", to: "2026-10-01" },
        { label: "Launch",    from: "2026-10-01", to: "2026-12-31" },
      ]
      items = [
        { label: "Sign-off", on: "2026-04-20" },
        { label: "GA",       on: "2026-11-10" },
      ]
    }
  }

  code wcl {
    source = <<'WCL'
diagram { width = 560  height = 200
  timeline { width = 560.0  height = 200.0
    title = "Project phases"
    start = "2026-01-01"
    end   = "2026-12-31"
    unit  = :months
    phases = [
      { label: "Discovery", from: "2026-01-01", to: "2026-03-01" },
      { label: "Design",    from: "2026-03-01", to: "2026-05-15" },
      { label: "Build",     from: "2026-05-15", to: "2026-10-01" },
      { label: "Launch",    from: "2026-10-01", to: "2026-12-31" },
    ]
    items = [
      { label: "Sign-off", on: "2026-04-20" },
      { label: "GA",       on: "2026-11-10" },
    ]
  }
}
WCL
  }

  h2 "Event cards"

  p "A timeline also accepts rich-text `card` children — each pinned to a date with `on` and filled with formatted wdoc content (text, lists, callouts, …). A card renders in place on the axis; `width` / `height` size the box and `side: :near|:far` forces which side of the axis it sits on."

  diagram { width = 720  height = 320
    timeline { width = 720.0  height = 320.0
      title = "Release timeline"
      unit  = :months
      start = "2026-01-01"
      end   = "2026-12-31"
      card { on = "2026-02-01"  title = "1.0"  width = 210.0  height = 104.0
        text { span "First " {} span "stable" { class = ["accent"] } span " release. APIs frozen." {} }
      }
      card { on = "2026-05-15"  side = :far  title = "1.4"  width = 210.0  height = 104.0
        text { span "Plugin system + the " {} span "wdoc" { class = ["accent"] } span " generator." {} }
      }
      card { on = "2026-10-01"  title = "2.0"  width = 210.0  height = 104.0
        text { span "Rewrite: lazy eval, schema check, LSP." {} }
      }
    }
  }

  code wcl {
    source = <<'WCL'
diagram { width = 720  height = 320
  timeline { width = 720.0  height = 320.0
    title = "Release timeline"
    unit  = :months
    start = "2026-01-01"
    end   = "2026-12-31"
    card { on = "2026-02-01"  title = "1.0"  width = 210.0  height = 104.0
      text { span "First " {} span "stable" { class = ["accent"] } span " release. APIs frozen." {} }
    }
    card { on = "2026-05-15"  side = :far  title = "1.4"  width = 210.0  height = 104.0
      text { span "Plugin system + the " {} span "wdoc" { class = ["accent"] } span " generator." {} }
    }
    card { on = "2026-10-01"  title = "2.0"  width = 210.0  height = 104.0
      text { span "Rewrite: lazy eval, schema check, LSP." {} }
    }
  }
}
WCL
  }

  p "Next: [Tilemaps](wdoc_tilemaps)."
}
