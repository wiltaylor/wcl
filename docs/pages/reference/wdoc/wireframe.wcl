// wdoc section: Wireframe.

// A custom widget used in the "Custom widgets" section below: a coloured
// status badge. It extends Widget (so it's a legal diagram shape) and its
// `lower` returns SVG fundamentals — a rounded box with a centred label —
// positioned at its own `x` / `y`, exactly like the built-in `process` shape.
@block("wf_badge")
type WfBadge extends Widget {
  @inline(0) text: utf8
  fill = "#2e7d32"
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width = 96.0  height = 26.0
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
  lower = fn(b: WfBadge) -> list<Svg> {
    [ Svg::Rect {
        x: b.x, y: b.y, width: b.width, height: b.height,
        fill: b.fill, class: b.class,
      },
      Svg::Label {
        content: b.text,
        x: b.x + b.width / 2.0,
        y: b.y + b.height / 2.0 + 4.0,
        fit_width: b.width, fit_height: b.height,
        fill: "#ffffff",
      } ]
  }
}

page wdoc_wireframe { sites = [:reference]  title = "Wireframe"
  h1 "Wireframe"

  p "Wireframe widgets mock up a UI — windows, device frames (browser / phone / tablet), panels, inputs, controls — as **diagram shapes**. Each `wf_*` block `extends SvgBlock`, so it lives inside a `diagram`: you place it with `x` / `y` (or anchors), connect widgets with edges, and mix them with any other shape. Container widgets nest other widgets, so you compose a window of panels of rows of controls; the whole group is sized by its content and the diagram just frames it. They're visual mockups — static SVG, not interactive."

  p "Here's a full window composed of a panel and a button row, framed by a diagram:"

  diagram {
    width = 300  height = 200
    wf_window "Account settings" {
      wf_panel { title = "Profile"
        wf_input "Display name" { value = "Wil Taylor" }
        wf_input "Email"        { value = "ai@wiltaylor.dev" }
      }
      wf_row {
        wf_button "Cancel"
        wf_button "Save" { icon = "lucide.check" }
      }
    }
  }

  code wcl {
    source = <<'WCL'
diagram {
  width = 300  height = 200
  wf_window "Account settings" {
    wf_panel { title = "Profile"
      wf_input "Display name" { value = "Wil Taylor" }
      wf_input "Email"        { value = "ai@wiltaylor.dev" }
    }
    wf_row {
      wf_button "Cancel"
      wf_button "Save" { icon = "lucide.check" }
    }
  }
}
WCL
  }

  h2 "Placing and connecting widgets"

  p "Because widgets are diagram shapes, you place them by `x` / `y` and draw edges between them by `id` — just like connecting any two shapes. A widget is sized by its content, so you only position the top-left corner."

  diagram {
    width = 360  height = 170
    wf_button "Open settings" { id = launch  x = 20.0  y = 65.0 }
    wf_window "Settings" {
      id = win  x = 180.0  y = 20.0
      wf_checkbox "Dark mode" { checked = true }
      wf_button "Close"
    }
    launch -> win
  }

  code wcl {
    source = <<'WCL'
diagram {
  width = 360  height = 170
  wf_button "Open settings" { id = launch  x = 20.0  y = 65.0 }
  wf_window "Settings" {
    id = win  x = 180.0  y = 20.0
    wf_checkbox "Dark mode" { checked = true }
    wf_button "Close"
  }
  launch -> win
}
WCL
  }

  p "Under an auto-layout `diagram` (`layout = :layered` / `:force`), widgets are sized by their measured content and placed by the solver — omit `x` / `y` and let the layout flow them."

  h2 "Containers"

  p "Every container takes `@children(Widget)` — drop any other widget inside, nested arbitrarily. The Rust renderer measures and lays the children out internally (their `x` / `y` are ignored; only the root widget's placement positions the whole group)."

  h3 "wf_window"

  p "The outer chrome: a titlebar (with traffic-light controls, hidden by `controls = false`) over a body that hosts other widgets."

  diagram {
    width = 300  height = 110
    wf_window "Settings" {
      wf_label "The window body stacks its children vertically."
    }
  }

  code wcl {
    source = <<'WCL'
diagram {
  width = 300  height = 110
  wf_window "Settings" {
    wf_label "The window body stacks its children vertically."
  }
}
WCL
  }

  type_table { type = WfWindow }

  h3 "wf_browser"

  p "A web-browser frame: a toolbar with traffic-light dots and an address bar (the inline label is the URL) over a content area that hosts other widgets. Drop a `wf_window` or any controls inside to mock up a web app."

  diagram {
    width = 480  height = 260
    wf_browser "app.example.com/dashboard" {
      wf_panel { title = "Welcome back"
        wf_input "Search…"
        wf_row {
          wf_button "Open"
          wf_button "New" { icon = "lucide.check" }
        }
      }
    }
  }

  code wcl {
    source = <<'WCL'
diagram { width = 480  height = 260
  wf_browser "app.example.com/dashboard" {
    wf_panel { title = "Welcome back"
      wf_input "Search…"
      wf_row {
        wf_button "Open"
        wf_button "New" { icon = "lucide.check" }
      }
    }
  }
}
WCL
  }

  p "Unlike the other widgets — sized to their content — the device frames have a realistic **fixed** default size (`wf_browser` is 640 × 440) so the content sizes inside them properly. An explicit `width` / `height` pins that axis (the other keeps the device default), and the height still grows if the content would overflow."

  type_table { type = WfBrowser }

  h3 "wf_phone"

  p "A phone shell — a bezel around a screen with a status bar (the inline label is an optional caption) and a home-indicator pill. Set `orientation = :landscape` to rotate it; the default is `:portrait` (280 × 580, swapped in landscape)."

  diagram {
    width = 320  height = 480
    wf_phone "9:41" {
      wf_panel { title = "Account"
        wf_input "Email" { value = "ada@example.com" }
        wf_toggle "Notifications" { on = true }
      }
      wf_button "Sign in" { icon = "lucide.check" }
    }
  }

  code wcl {
    source = <<'WCL'
diagram { width = 320  height = 480
  wf_phone "9:41" {
    wf_panel { title = "Account"
      wf_input "Email" { value = "ada@example.com" }
      wf_toggle "Notifications" { on = true }
    }
    wf_button "Sign in" { icon = "lucide.check" }
  }
}
WCL
  }

  type_table { type = WfPhone }

  h3 "wf_tablet"

  p "A tablet shell — the same chrome as `wf_phone` on a larger, squarer frame (480 × 640 portrait). Shown here in landscape:"

  diagram {
    width = 460  height = 320
    wf_tablet { orientation = :landscape
      wf_row {
        wf_panel { title = "Library"
          wf_label "Recent"
          wf_label "Favourites"
        }
        wf_panel { title = "Reader"
          wf_label "Select an item to read."
        }
      }
    }
  }

  code wcl {
    source = <<'WCL'
diagram { width = 460  height = 320
  wf_tablet { orientation = :landscape
    wf_row {
      wf_panel { title = "Library"
        wf_label "Recent"
        wf_label "Favourites"
      }
      wf_panel { title = "Reader"
        wf_label "Select an item to read."
      }
    }
  }
}
WCL
  }

  type_table { type = WfTablet }

  h3 "wf_panel"

  p "A bordered group with an optional `title` caption — use it to box a set of related controls."

  diagram {
    width = 220  height = 120
    wf_panel { title = "Network"
      wf_toggle "Wi-Fi" { on = true }
      wf_toggle "Bluetooth"
    }
  }

  code wcl {
    source = <<'WCL'
diagram { width = 220  height = 120
  wf_panel { title = "Network"
    wf_toggle "Wi-Fi" { on = true }
    wf_toggle "Bluetooth"
  }
}
WCL
  }

  type_table { type = WfPanel }

  h3 "wf_row"

  p "Lay children out **horizontally** (a panel / window body stacks vertically by default)."

  diagram {
    width = 320  height = 50
    wf_row {
      wf_button "Back"
      wf_button "Next"
      wf_button "Finish" { icon = "lucide.check" }
    }
  }

  code wcl {
    source = <<'WCL'
diagram { width = 320  height = 50
  wf_row {
    wf_button "Back"
    wf_button "Next"
    wf_button "Finish" { icon = "lucide.check" }
  }
}
WCL
  }

  type_table { type = WfRow }

  h3 "wf_column"

  p "Stack children **vertically** — the default flow, useful for an explicit column inside a `wf_row` or `wf_grid`."

  diagram {
    width = 220  height = 80
    wf_column {
      wf_label "Name"
      wf_input "Full name"
    }
  }

  code wcl {
    source = <<'WCL'
diagram { width = 220  height = 80
  wf_column {
    wf_label "Name"
    wf_input "Full name"
  }
}
WCL
  }

  type_table { type = WfColumn }

  h3 "wf_grid"

  p "A grid of equal-width columns; `columns` sets the count (default 2) and children flow across the rows."

  diagram {
    width = 280  height = 120
    wf_grid { columns = 3
      wf_button "1"
      wf_button "2"
      wf_button "3"
      wf_button "4"
      wf_button "5"
      wf_button "6"
    }
  }

  code wcl {
    source = <<'WCL'
diagram { width = 280  height = 120
  wf_grid { columns = 3
    wf_button "1"
    wf_button "2"
    wf_button "3"
    wf_button "4"
    wf_button "5"
    wf_button "6"
  }
}
WCL
  }

  type_table { type = WfGrid }

  h2 "Node graphs"

  p "A `wf_node_graph` mocks up a node editor — a shader graph, a blueprint, a dataflow pipeline. Each `wf_node` is a titled box with labeled `inputs` down its left edge and `outputs` down its right edge; a `wf_link` wires one node's output to another's input, addressing ports as `\"node.port\"` (a bare `\"node\"` targets its first port). It's one diagram shape — placed and connectable as a whole — that renders its nodes and links itself."

  p "Nodes auto-lay-out left-to-right from the link graph (the same layered solver an auto-layout `diagram` uses), and links route with the orthogonal edge router. Set `direction = :top_to_bottom` to flow downward, or give a node an explicit `x` / `y` to pin it while the rest auto-flow."

  diagram {
    width = 560  height = 240
    wf_node_graph {
      wf_node "Texture"  { id = tex   outputs = ["RGB", "Alpha"] }
      wf_node "Fresnel"  { id = fres  outputs = ["Factor"] }
      wf_node "Multiply" { id = mul   inputs = ["A", "B"]  outputs = ["Result"] }
      wf_node "Output"   { id = out   inputs = ["Color"] }
      wf_link "tex.RGB"     { to = "mul.A" }
      wf_link "fres.Factor" { to = "mul.B" }
      wf_link "mul.Result"  { to = "out.Color" }
    }
  }

  code wcl {
    source = <<'WCL'
diagram { width = 560  height = 240
  wf_node_graph {
    wf_node "Texture"  { id = tex   outputs = ["RGB", "Alpha"] }
    wf_node "Fresnel"  { id = fres  outputs = ["Factor"] }
    wf_node "Multiply" { id = mul   inputs = ["A", "B"]  outputs = ["Result"] }
    wf_node "Output"   { id = out   inputs = ["Color"] }
    wf_link "tex.RGB"     { to = "mul.A" }
    wf_link "fres.Factor" { to = "mul.B" }
    wf_link "mul.Result"  { to = "out.Color" }
  }
}
WCL
  }

  type_table { type = WfNodeGraph }

  p "Each node:"

  type_table { type = WfNode }

  p "Each link:"

  type_table { type = WfLink }

  h2 "Controls"

  h3 "wf_label"

  p "A plain text label."

  diagram {
    width = 220  height = 30
    wf_label "Just some label text."
  }

  code wcl {
    source = <<'WCL'
diagram { width = 220  height = 30
  wf_label "Just some label text."
}
WCL
  }

  type_table { type = WfLabel }

  h3 "wf_button"

  p "A button caption, with an optional leading `icon` (any `pack.name`, e.g. `\"lucide.check\"`)."

  diagram {
    width = 320  height = 50
    wf_row {
      wf_button "Save" { icon = "lucide.check" }
      wf_button "Cancel"
      wf_button "Delete" { disabled = true }
    }
  }

  code wcl {
    source = <<'WCL'
diagram { width = 320  height = 50
  wf_row {
    wf_button "Save" { icon = "lucide.check" }
    wf_button "Cancel"
    wf_button "Delete" { disabled = true }
  }
}
WCL
  }

  type_table { type = WfButton }

  h3 "wf_input"

  p "A text field. With no `value` the `@inline` placeholder shows greyed; a `value` fills it with solid text."

  diagram {
    width = 240  height = 90
    wf_column {
      wf_input "Search projects…"
      wf_input "Name" { value = "Ada Lovelace" }
    }
  }

  code wcl {
    source = <<'WCL'
diagram { width = 240  height = 90
  wf_column {
    wf_input "Search projects…"
    wf_input "Name" { value = "Ada Lovelace" }
  }
}
WCL
  }

  type_table { type = WfInput }

  h3 "wf_dropdown"

  p "A select field showing the currently-chosen option label with a chevron."

  diagram {
    width = 200  height = 44
    wf_dropdown "Release build"
  }

  code wcl {
    source = <<'WCL'
diagram { width = 200  height = 44
  wf_dropdown "Release build"
}
WCL
  }

  type_table { type = WfDropdown }

  h3 "wf_checkbox"

  p "An on/off checkbox; `checked = true` fills the box with a tick."

  diagram {
    width = 240  height = 70
    wf_column {
      wf_checkbox "Enable telemetry" { checked = true }
      wf_checkbox "Join the beta"
    }
  }

  code wcl {
    source = <<'WCL'
diagram { width = 240  height = 70
  wf_column {
    wf_checkbox "Enable telemetry" { checked = true }
    wf_checkbox "Join the beta"
  }
}
WCL
  }

  type_table { type = WfCheckbox }

  h3 "wf_radio"

  p "A radio button — like a checkbox but round; mark the active one with `selected = true` in a group you lay out yourself."

  diagram {
    width = 160  height = 70
    wf_column {
      wf_radio "Dark" { selected = true }
      wf_radio "Light"
    }
  }

  code wcl {
    source = <<'WCL'
diagram { width = 160  height = 70
  wf_column {
    wf_radio "Dark" { selected = true }
    wf_radio "Light"
  }
}
WCL
  }

  type_table { type = WfRadio }

  h3 "wf_toggle"

  p "A sliding on/off switch with an optional trailing label; `on = true` slides the knob across."

  diagram {
    width = 220  height = 70
    wf_column {
      wf_toggle "Notifications" { on = true }
      wf_toggle "Do not disturb"
    }
  }

  code wcl {
    source = <<'WCL'
diagram { width = 220  height = 70
  wf_column {
    wf_toggle "Notifications" { on = true }
    wf_toggle "Do not disturb"
  }
}
WCL
  }

  type_table { type = WfToggle }

  h2 "Common fields"

  p "Every widget extends a shared `Widget` interface — its diagram placement geometry (`x` / `y` / anchors / `connect_points`) plus the per-element theming hints:"

  type_table { type = Widget }

  h2 "Custom widgets"

  p "Wireframe widgets are user-extensible diagram shapes. Declare a `@block(\"name\") type … extends Widget` with a `lower` that returns `list<Svg>`, and it plugs into the diagram render path like any custom shape — placed directly in a `diagram` by its own `x` / `y` and connectable by edges. (The built-in containers only lay out the built-in widgets, so a custom widget renders as a standalone shape, not nested inside a `wf_window`.)"

  p "Here's a coloured status `wf_badge`. The `lower` reads its `x` / `y` and emits a filled box with a centred label — exactly how the built-in `process` shape lowers — and a `fill` field recolours an individual instance:"

  diagram {
    width = 320  height = 40
    wf_badge "passing" { x = 12.0  y = 7.0 }
    wf_badge "failing" { x = 130.0 y = 7.0  fill = "#c62828" }
  }

  code wcl {
    source = <<'WCL'
// Extends Widget → a diagram shape. The lower returns SVG fundamentals
// positioned at the widget's own x/y (like the built-in `process`), and a
// `fill` field recolours a single instance.
@block("wf_badge")
type WfBadge extends Widget {
  @inline(0) text: utf8
  fill = "#2e7d32"
  id: identifier?  class: list<utf8>?  disabled: bool?
  x = 0.0  y = 0.0  width = 96.0  height = 26.0
  anchor_left: f64?  anchor_right: f64?  anchor_top: f64?  anchor_bottom: f64?
  connect_points: list<AnchorSide>?
  theme: symbol?  accent: symbol?  mode: symbol?
  lower = fn(b: WfBadge) -> list<Svg> {
    [ Svg::Rect {
        x: b.x, y: b.y, width: b.width, height: b.height,
        fill: b.fill, class: b.class,
      },
      Svg::Label {
        content: b.text,
        x: b.x + b.width / 2.0,
        y: b.y + b.height / 2.0 + 4.0,
        fit_width: b.width, fit_height: b.height,
        fill: "#ffffff",
      } ]
  }
}

diagram {
  width = 320  height = 40
  wf_badge "passing" { x = 12.0  y = 7.0 }
  wf_badge "failing" { x = 130.0 y = 7.0  fill = "#c62828" }
}
WCL
  }
}
