// wdoc section: Wireframe.

// A custom widget used in the "Custom widgets" section below: a coloured
// status badge. It extends Widget (so it's a legal child of any container)
// and its `lower` returns a styled <span>.
@block("wf_badge")
type WfBadge extends Widget {
  @inline(0) text: utf8
  icon: utf8?
  id: identifier?  class: list<utf8>?  width: utf8?  disabled: bool?
  lower = fn(b: WfBadge) -> list<HtmlFundamental> {
    let extra = if b.class == none { [] } else { b.class };
    let label = HtmlFundamental::Inline { text: b.text };
    // An optional leading icon — an `Icon` fundamental, resolved from any
    // pack (`lucide.*` works with no iconset declared).
    let kids  = if b.icon == none { [label] }
      else { [ HtmlFundamental::Icon { name: b.icon, class: ["wf-icon"] }, label ] };
    [ HtmlFundamental::Element {
        tag: "span", id: b.id, attrs: none,
        class: flatten([["wf-badge"], extra]),
        children: kids,
    } ]
  }
}

class "wf-badge" {
  background = "var(--wdoc-green)"
  color      = "#fff"
  padding    = "0.05rem 0.5rem"
}
class "wf-badge-danger" { background = "var(--wdoc-red)" }

page wdoc_wireframe { sites = [:reference]
  h1 "Wireframe"

  p "Wireframe widgets render UI mockups — windows, panels, inputs, controls — as styled HTML. Unlike diagram shapes (which lower to flat SVG leaves), widgets render through the HTML path and **container widgets nest other widgets**, so you can compose a window of panels of rows of controls. They're visual mockups: they render as styled `<div>`s and don't respond to clicks."

  p "Here's a full window composed of a panel and a button row:"

  wf_window "Account settings" {
    wf_panel { title = "Profile"
      wf_input "Display name" { value = "Wil Taylor" }
      wf_input "Email"        { value = "ai@wiltaylor.dev" }
    }
    wf_row {
      wf_button "Cancel"
      wf_button "Save" { icon = "lucide.check" }
    }
  }

  code wcl {
    source = <<'WCL'
wf_window "Account settings" {
  wf_panel { title = "Profile"
    wf_input "Display name" { value = "Wil Taylor" }
    wf_input "Email"        { value = "ai@wiltaylor.dev" }
  }
  wf_row {
    wf_button "Cancel"
    wf_button "Save" { icon = "lucide.check" }
  }
}
WCL
  }

  h2 "Containers"

  p "Every container takes `@children(Widget)` — drop any other widget inside, nested arbitrarily."

  h3 "wf_window"

  p "The outer chrome: a titlebar (with traffic-light controls, hidden by `controls = false`) over a body that hosts other widgets."

  wf_window "Settings" {
    wf_label "The window body stacks its children vertically."
  }

  code wcl {
    source = <<'WCL'
wf_window "Settings" {
  wf_label "The window body stacks its children vertically."
}
WCL
  }

  table {
    rows:
      | "Field" | "Meaning" |
      | "`title`"    | "Titlebar caption (`@inline`)." |
      | "`controls`" | "Show the titlebar dots + close glyph (default `true`)." |
      | "children"   | "Any `Widget`s, stacked vertically." |
  }

  h3 "wf_panel"

  p "A bordered group with an optional `title` caption — use it to box a set of related controls."

  wf_panel { title = "Network"
    wf_toggle "Wi-Fi" { on = true }
    wf_toggle "Bluetooth"
  }

  code wcl {
    source = <<'WCL'
wf_panel { title = "Network"
  wf_toggle "Wi-Fi" { on = true }
  wf_toggle "Bluetooth"
}
WCL
  }

  table {
    rows:
      | "Field" | "Meaning" |
      | "`title`"  | "Optional group caption." |
      | "children" | "Any `Widget`s, stacked vertically." |
  }

  h3 "wf_row"

  p "Lay children out **horizontally** (a panel / window body stacks vertically by default)."

  wf_row {
    wf_button "Back"
    wf_button "Next"
    wf_button "Finish" { icon = "lucide.check" }
  }

  code wcl {
    source = <<'WCL'
wf_row {
  wf_button "Back"
  wf_button "Next"
  wf_button "Finish" { icon = "lucide.check" }
}
WCL
  }

  table {
    rows:
      | "Field" | "Meaning" |
      | "children" | "Any `Widget`s, laid out left-to-right." |
  }

  h3 "wf_column"

  p "Stack children **vertically** — the default flow, useful for an explicit column inside a `wf_row` or `wf_grid`."

  wf_column {
    wf_label "Name"
    wf_input "Full name"
  }

  code wcl {
    source = <<'WCL'
wf_column {
  wf_label "Name"
  wf_input "Full name"
}
WCL
  }

  table {
    rows:
      | "Field" | "Meaning" |
      | "children" | "Any `Widget`s, stacked top-to-bottom." |
  }

  h3 "wf_grid"

  p "A grid of equal-width columns; `columns` sets the count and children flow across the rows."

  wf_grid { columns = 3
    wf_button "1"
    wf_button "2"
    wf_button "3"
    wf_button "4"
    wf_button "5"
    wf_button "6"
  }

  code wcl {
    source = <<'WCL'
wf_grid { columns = 3
  wf_button "1"
  wf_button "2"
  wf_button "3"
  wf_button "4"
  wf_button "5"
  wf_button "6"
}
WCL
  }

  table {
    rows:
      | "Field" | "Meaning" |
      | "`columns`" | "Number of equal-width columns." |
      | "children"  | "Any `Widget`s, flowed across the grid." |
  }

  h2 "Controls"

  h3 "wf_label"

  p "A plain text label (an inline `<span>`)."

  wf_label "Just some label text."

  code wcl {
    source = <<'WCL'
wf_label "Just some label text."
WCL
  }

  table {
    rows:
      | "Field" | "Meaning" |
      | "`text`" | "The label text (`@inline`)." |
  }

  h3 "wf_button"

  p "A button caption, with an optional leading `icon` (any `pack.name`, e.g. `\"lucide.check\"`)."

  wf_row {
    wf_button "Save" { icon = "lucide.check" }
    wf_button "Cancel"
    wf_button "Delete" { disabled = true }
  }

  code wcl {
    source = <<'WCL'
wf_button "Save" { icon = "lucide.check" }
wf_button "Cancel"
wf_button "Delete" { disabled = true }
WCL
  }

  table {
    rows:
      | "Field" | "Meaning" |
      | "`text`" | "Button caption (`@inline`)." |
      | "`icon`" | "Optional leading glyph — `pack.name`." |
  }

  h3 "wf_input"

  p "A text field. With no `value` the `@inline` placeholder shows greyed; a `value` fills it with solid text."

  wf_column {
    wf_input "Search projects…"
    wf_input "Name" { value = "Ada Lovelace" }
  }

  code wcl {
    source = <<'WCL'
wf_input "Search projects…"
wf_input "Name" { value = "Ada Lovelace" }
WCL
  }

  table {
    rows:
      | "Field" | "Meaning" |
      | "`placeholder`" | "Greyed prompt shown when empty (`@inline`)." |
      | "`value`"       | "Filled value (renders solid, replaces the placeholder)." |
  }

  h3 "wf_dropdown"

  p "A select field showing the currently-chosen option label with a chevron."

  wf_dropdown "Release build"

  code wcl {
    source = <<'WCL'
wf_dropdown "Release build"
WCL
  }

  table {
    rows:
      | "Field" | "Meaning" |
      | "`text`" | "The selected option label (`@inline`)." |
  }

  h3 "wf_checkbox"

  p "An on/off checkbox; `checked = true` fills the box with a tick."

  wf_column {
    wf_checkbox "Enable telemetry" { checked = true }
    wf_checkbox "Join the beta"
  }

  code wcl {
    source = <<'WCL'
wf_checkbox "Enable telemetry" { checked = true }
wf_checkbox "Join the beta"
WCL
  }

  table {
    rows:
      | "Field" | "Meaning" |
      | "`label`"   | "Checkbox caption (`@inline`)." |
      | "`checked`" | "On/off state." |
  }

  h3 "wf_radio"

  p "A radio button — like a checkbox but round; mark the active one with `selected = true` in a group you lay out yourself."

  wf_column {
    wf_radio "Dark" { selected = true }
    wf_radio "Light"
  }

  code wcl {
    source = <<'WCL'
wf_radio "Dark" { selected = true }
wf_radio "Light"
WCL
  }

  table {
    rows:
      | "Field" | "Meaning" |
      | "`label`"    | "Radio caption (`@inline`)." |
      | "`selected`" | "Whether this option is chosen." |
  }

  h3 "wf_toggle"

  p "A sliding on/off switch with an optional trailing label; `on = true` slides the knob across."

  wf_column {
    wf_toggle "Notifications" { on = true }
    wf_toggle "Do not disturb"
  }

  code wcl {
    source = <<'WCL'
wf_toggle "Notifications" { on = true }
wf_toggle "Do not disturb"
WCL
  }

  table {
    rows:
      | "Field" | "Meaning" |
      | "`label`" | "Optional trailing caption (`@inline`)." |
      | "`on`"    | "Switch state." |
  }

  h2 "Common fields"

  p "Every widget extends a shared `Widget` interface and also accepts:"

  table {
    rows:
      | "Field"      | "Meaning" |
      | "`id`"       | "Optional HTML id." |
      | "`class`"    | "Extra CSS classes threaded onto the rendered element." |
      | "`width`"    | "Explicit CSS width (e.g. `\"12rem\"` / `\"100%\"`)." |
      | "`disabled`" | "When `true`, adds a `wf-disabled` class so styles dim the control." |
  }

  h2 "Custom widgets"

  p "Wireframe widgets are user-extensible. Declare a `@block(\"name\") type … extends Widget` with a `lower` that returns `list<HtmlFundamental>`, and it plugs into the same render path as the built-ins — usable anywhere a `Widget` is accepted (inside any container). The `lower` composes HTML fundamentals (`Element` / `Inline` / `Icon` / …), and the widget's own `class` field threads onto the element, so you style it with the class system like everything else."

  p "Here's a coloured status `wf_badge` with an optional leading `icon`. The `lower` puts an `HtmlFundamental::Icon` before the label (any `pack.name` — `lucide.*` resolves with no iconset declared), and its `class` list lets callers recolour an individual instance:"

  wf_row {
    wf_label "Build:"
    wf_badge "passing" { icon = "lucide.check" }
    wf_badge "failing" { icon = "lucide.x"  class = ["wf-badge-danger"] }
  }

  code wcl {
    source = <<'WCL'
// Extends Widget → a legal child of any container. The lower returns a
// styled <span>; the widget's own `class` is merged in so callers can
// recolour a single instance.
@block("wf_badge")
type WfBadge extends Widget {
  @inline(0) text: utf8
  icon: utf8?
  id: identifier?  class: list<utf8>?  width: utf8?  disabled: bool?
  lower = fn(b: WfBadge) -> list<HtmlFundamental> {
    let extra = if b.class == none { [] } else { b.class };
    let label = HtmlFundamental::Inline { text: b.text };
    // An optional leading icon — an `Icon` fundamental, resolved from any
    // pack (`lucide.*` works with no iconset declared).
    let kids  = if b.icon == none { [label] }
      else { [ HtmlFundamental::Icon { name: b.icon, class: ["wf-icon"] }, label ] };
    [ HtmlFundamental::Element {
        tag: "span", id: b.id, attrs: none,
        class: flatten([["wf-badge"], extra]),
        children: kids,
    } ]
  }
}

// Style it with the class system, like any element:
class "wf-badge"        { background = "var(--wdoc-green)"  color = "#fff"  padding = "0.05rem 0.5rem" }
class "wf-badge-danger" { background = "var(--wdoc-red)" }

wf_row {
  wf_label "Build:"
  wf_badge "passing" { icon = "lucide.check" }
  wf_badge "failing" { icon = "lucide.x"  class = ["wf-badge-danger"] }
}
WCL
  }

  p "Back to the [reference introduction](index)."
}
