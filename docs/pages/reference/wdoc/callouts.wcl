// wdoc section: Callouts.
page wdoc_callouts { sites = [:reference]
  h1 "Callouts"

  p "A `callout` is an admonition: an icon, a coloured heading, and a body. Six built-in types are selected by `class`, each shipping a default colour and icon."

  h2 "Authoring"

  code wcl {
    source = <<'WCL'
callout "Note" {
  class = ["note"]
  body  = "Background context the reader should remember."
}

callout "Heads up" {
  class = ["warning"]
  body  = "Something to be careful about."
}

callout "All done" {
  class = ["success"]
  icon  = "lucide.party-popper"        // override the default icon
  body  = "Confirm an action completed."
}
WCL
  }

  h2 "Built-in types"

  table {
    rows:
      | "Type"      | "Default colour" | "Default icon" |
      | "`note`"    | "Blue"           | "lucide.info" |
      | "`info`"    | "Blue"           | "lucide.info" |
      | "`tip`"     | "Cyan"           | "lucide.lightbulb" |
      | "`warning`" | "Orange"         | "lucide.triangle-alert" |
      | "`error`"   | "Red"            | "lucide.circle-x" |
      | "`success`" | "Green"          | "lucide.circle-check" |
  }

  h2 "Fields"

  table {
    rows:
      | "Field"   | "Meaning" |
      | "`<heading>`" | "Inline label — the coloured heading at the top of the callout." |
      | "`body`"  | "The prose under the heading. Plain text — see the warning below." |
      | "`class`" | "Selects the type: `[\"note\"]` / `[\"tip\"]` / etc. May also carry user classes." |
      | "`icon`"  | "Override the default icon (any `pack.name` from a built-in or declared iconset)." |
      | "`id`"    | "Optional explicit HTML id." |
  }

  callout "Body is plain text" {
    class = ["warning"]
    body  = "The body field renders verbatim — no inline patterns, no links, no formatting. Keep callout bodies prose-only; put rich formatting in a nearby p or text block."
  }

  p "Next: [Code Blocks](wdoc_code)."
}
