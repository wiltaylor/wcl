// wdoc section: Flowcharts.
page wdoc_flowcharts { sites = [:reference]
  h1 "Flowcharts"

  p "Flowchart shapes plus the layered auto-layout mode turn a `diagram` into a flowchart: declare the shapes and the edges, and the renderer ranks them topologically and elbow-routes the connections."

  h2 "Flowchart shapes"

  p "These stdlib shapes lower to SVG primitives. Each takes its label inline plus the usual position / size + paint fields (`x` / `y` / `width` / `height`, `fill` / `stroke`, `id` / `class`). Inside a `:layered` diagram, omit `x`/`y` — the layout decides them."

  h3 "process"

  diagram { width = 160  height = 70
    process "Validate" { x = 20.0  y = 15.0  width = 120.0  height = 40.0  fill = "#88c0d0" }
  }

  p "A rectangle for an action or step."

  code wcl {
    source = <<'WCL'
diagram { width = 160  height = 70
  process "Validate" { x = 20.0  y = 15.0  width = 120.0  height = 40.0  fill = "#88c0d0" }
}
WCL
  }

  h3 "decision"

  diagram { width = 160  height = 90
    decision "Match?" { x = 20.0  y = 15.0  width = 120.0  height = 60.0  fill = "#ebcb8b" }
  }

  p "A diamond for a branch — a yes/no test."

  code wcl {
    source = <<'WCL'
diagram { width = 160  height = 90
  decision "Match?" { x = 20.0  y = 15.0  width = 120.0  height = 60.0  fill = "#ebcb8b" }
}
WCL
  }

  h3 "terminator"

  diagram { width = 160  height = 70
    terminator "Start" { x = 20.0  y = 15.0  width = 120.0  height = 40.0  fill = "#b48ead" }
  }

  p "An oval for a start / end node."

  code wcl {
    source = <<'WCL'
diagram { width = 160  height = 70
  terminator "Start" { x = 20.0  y = 15.0  width = 120.0  height = 40.0  fill = "#b48ead" }
}
WCL
  }

  h2 "Layered auto-layout"

  p "Set `layout = :layered` on the diagram. Shapes are topologically ranked from the connection graph and stacked top-to-bottom; elbow routing then connects them with right-angled paths. `layer_gap` controls the spacing between ranks."

  diagram {
    width = 320  height = 220  layout = :layered  layer_gap = 20.0

    process    "Parse"  { id = parse   width = 100.0  height = 40.0  fill = "#88c0d0" }
    decision   "Valid?" { id = valid   width = 100.0  height = 60.0  fill = "#ebcb8b" }
    terminator "Render" { id = render  width = 100.0  height = 40.0  fill = "#b48ead" }

    parse -> valid  :flow
    valid -> render :flow
  }

  code wcl {
    source = <<'WCL'
diagram {
  width = 320  height = 220  layout = :layered  layer_gap = 20.0

  process    "Parse"  { id = parse   width = 100.0  height = 40.0  fill = "#88c0d0" }
  decision   "Valid?" { id = valid   width = 100.0  height = 60.0  fill = "#ebcb8b" }
  terminator "Render" { id = render  width = 100.0  height = 40.0  fill = "#b48ead" }

  parse -> valid  :flow
  valid -> render :flow
}
WCL
  }

  callout "Other layouts" {
    class = ["info"]
    body  = "`layout = :force` runs a force-directed simulation for cyclic graphs; tune with `repulsion`, `link_distance`, `gravity`, `seed`. See the examples site for a live demo."
  }

  p "Next: [Charts](wdoc_charts)."
}
