// wdoc section: Code Blocks.
page wdoc_code { sites = [:reference]
  h1 "Code Blocks"

  p "`code <lang> { source = ... }` renders a syntax-highlighted listing. The language tag picks the grammar; an unknown tag falls back to plain text."

  h2 "Authoring"

  code wcl {
    source = <<'WCL'
code rust {
  source = <<'RUST'
fn fib(n: u32) -> u64 {
    match n {
        0 => 0,
        1 => 1,
        _ => fib(n - 1) + fib(n - 2),
    }
}
RUST
}
WCL
  }

  h2 "Supported languages"

  p "Common tags include `rust`, `python`, `wcl`, `json`, `javascript`, `typescript`, `html`, `css`, `yaml`, `toml`, `sql`, `bash`, `go`, `c`, `cpp`. WCL ships its own grammar, so `code wcl { … }` highlights too."

  callout "Heredocs for source" {
    class = ["tip"]
    body  = "Use a raw heredoc (<<'TAG') for the source field — body taken verbatim, no escapes or interpolation. Plain <<TAG interprets escapes; that breaks LaTeX, regexes, and code containing backslashes."
  }

  h2 "Styling"

  p "Highlighted tokens render with `tok-keyword`, `tok-string`, `tok-comment`, … classes. The bundled `code-theme.css` ships colours that fit the active theme; override any of them with a user `class` block."

  p "Next: [Math Equations](wdoc_math)."
}
