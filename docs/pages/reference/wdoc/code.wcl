// wdoc section: Code & Math.
page wdoc_code { sites = [:reference]
  h1 "Code & Math" {}

  h2 "Code blocks" {}

  p "`code <lang> { source = ... }` renders a syntax-highlighted listing. The language tag picks the grammar; an unknown tag falls back to plain text." {}
  code wcl {
    source = <<'WCL'
code rust {
  source = <<'RUST'
fn fib(n: u32) -> u64 {
    match n {
        0 => 0,
        1 => 1,
        _ => fib(n - 1) + fib(n - 2),
    }
}
RUST
}
WCL
  }

  p "Common language tags: `rust`, `python`, `wcl`, `json`, `javascript`, `typescript`, `html`, `css`, `yaml`, `toml`, `sql`, `bash`, `go`, `c`, `cpp`. WCL ships its own grammar, so `code wcl { … }` highlights too." {}

  callout "Heredocs for source" {
    class = ["tip"]
    body  = "Use a raw heredoc (<<'TAG') for the source field — body taken verbatim, no escapes or interpolation. Plain <<TAG interprets escapes; that breaks LaTeX, regexes, and code containing backslashes."
  }

  h2 "Math equations" {}

  p "`math` typesets a LaTeX equation to inline SVG via the pure-Rust RaTeX toolchain. Use the source slot for the LaTeX body." {}
  code wcl {
    source = <<'WCL'
math "E = mc^2" {}

math <<'TEX'
\frac{-b \pm \sqrt{b^2 - 4ac}}{2a}
TEX
  {}
WCL
  }

  p "Inline math also works via the `$…$` (text style) and `$$…$$` (display style) inline patterns in any `p` body or `span`. Glyph outlines embed in the SVG, so equations render the same on `file://` and over HTTP." {}

  p "Next: [Tables & Columns](wdoc_tables)." {}
}
