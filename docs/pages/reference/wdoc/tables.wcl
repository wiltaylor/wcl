// wdoc section: Tables.
page wdoc_tables { sites = [:reference, :wcl_skill]  title = "Tables"
  h1 "Tables"

  p "`table { rows: | … | }` renders a tabular data grid using WCL's native pipe-row syntax. The first row becomes the `<thead>`; the remaining rows go in `<tbody>`."

  h2 "Authoring"

  p "A table previewed inside a card — note the inline-formatted cells:"

  diagram { width = 460  height = 150
    card { x = 16.0  y = 12.0  width = 428.0  height = 126.0
      table {
        rows:
          | "Name"  | "Role"     | "Years" |
          | "Alice" | "**Dev**"  | 3       |
          | "Bob"   | "_Ops_"    | 5       |
      }
    }
  }

  code wcl {
    source = <<'WCL'
table {
  rows:
    | "Name"  | "Role"     | "Years" |
    | "Alice" | "**Dev**"  | 3       |
    | "Bob"   | "_Ops_"    | 5       |
}
WCL
  }

  h2 "Cells"

  p "Cells are expressions in the row schema's field positions. utf8 cells run through the inline pattern engine, so bold, italic, inline code, links, icons, and math all work inside cells. Numeric / boolean / symbol cells stringify."

  callout "Pipes in cells" {
    class = ["warning"]
    body  = "A literal pipe (|) outside a quoted cell will split the row. Wrap any cell that contains pipes — e.g. an inline `code` example showing ||  — in a string literal."
  }

  h2 "Fields"

  type_table { type = TableBlock }
}
