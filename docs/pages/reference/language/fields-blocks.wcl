// Language section: Fields & Blocks.
page fields_blocks { sites = [:reference]  title = "Fields & Blocks"
  h1 "Fields & Blocks"

  p "Fields and blocks are the structural backbone of a document. Everything else — types, functions, schema — describes and constrains them."

  h2 "Fields"

  p "A field binds a name to a value with `=`. The value is any expression."
  code wcl {
    source = <<'WCL'
name    = "alpha"
count   = 3u32
enabled = true
ratio   = count / 2u32
WCL
  }

  h2 "Blocks"

  p "A block is a named group of fields and also lets you nest other blocks under it. To specify which fields and labels are available on a block see [Schema & Decorators](schema)."
  code wcl {
    source = <<'WCL'
// One label → name = "web".
service "web" {
  port   = 8080u32
  region = "us-east-1"
}
WCL
  }

  p "Multiple labels work the same way — declare an `@inline` for each position you want to expose:"
  code wcl {
    source = <<'WCL'
// Two labels → verb = "GET", path = "/users".
route "GET" "/users" {
  handler = "list_users"
}
WCL
  }

  h2 "Nested blocks"

  p "Blocks can hold further blocks. Nesting depth is unbounded; structure is constrained by the schema (`@child` for one, `@children` for many)."
  code wcl {
    source = <<'WCL'
service "web" {
  metadata {
    region = "us-east-1"
    tags {
      environment = "prod"
    }
  }
}
WCL
  }
}
