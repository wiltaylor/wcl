sort([3, 1, 2])           // [1, 2, 3]
sort(["b", "a", "c"])     // ["a", "b", "c"]
WCL
  }
  builtin_doc {
    name = "sort_connected"
    example = <<'WCL'
// Reorder items so nodes joined by edges sit next to each other.
sort_connected(nodes, edges)
WCL
