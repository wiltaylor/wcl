  builtin_doc {
    name = "tensor_data"
    example = <<'WCL'
tensor_data(tensor([1, 2, 3, 4], [2, 2]))   // [1, 2, 3, 4]
WCL
  }
  builtin_doc {
    name = "tensor_reshape"
    example = <<'WCL'
tensor_reshape(tensor([1, 2, 3, 4], [2, 2]), [4])   // shape [4]
WCL
  }
  builtin_doc {
    name = "tensor_shape"
    example = <<'WCL'
tensor_shape(tensor([1, 2, 3, 4], [2, 2]))   // [2, 2]
WCL
