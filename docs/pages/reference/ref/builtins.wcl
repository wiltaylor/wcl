  builtin_doc {
    name = "ln"
    example = <<'WCL'
ln(e())   // 1.0
WCL
  }
  builtin_doc {
    name = "log10"
    example = <<'WCL'
log10(1000)   // 3.0
WCL
  }
  builtin_doc {
    name = "log2"
    example = <<'WCL'
log2(8)   // 3.0
WCL
  }
  builtin_doc {
    name = "map"
    example = <<'WCL'
map([1, 2, 3], fn(x: i64) -> i64 x * 2)   // [2, 4, 6]
WCL
  }
  builtin_doc {
    name = "max"
    example = <<'WCL'
max(3, 7)   // 7.0
WCL
  }
  builtin_doc {
    name = "min"
    example = <<'WCL'
min(3, 7)   // 3.0
WCL
  }
  builtin_doc {
    name = "panic"
    example = <<'WCL'
panic("unreachable state reached")
WCL
  }
  builtin_doc {
    name = "pi"
    example = <<'WCL'
pi()   // 3.14159…
WCL
  }
  builtin_doc {
    name = "pow"
    example = <<'WCL'
pow(2, 10)   // 1024.0
WCL
