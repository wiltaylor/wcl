// Training projection — an interactive course over the wskill's lessons.
//
// Build:  wcl wdoc build wdoc/training/main.wcl --out out/training
//
// NOT a book: its own `training` template renders a syllabus rail that tracks
// progress, and each lesson page reads material → exercises → checks. Checks
// are graded in the page — multiple choice client-side, `:text` answers by an
// agent through the `training.wcl` sidecar when a server is running (see
// `wcl wdoc training`). Progress persists in localStorage, so the built site
// works with no server at all.
//
// The syllabus orders top-level lessons first, then each module's lessons;
// every lesson links back into the reference book for the units it teaches.

import <wdoc.wcl>
import "../../wskill.wcl"

let topic = head(topics)

// ---------------------------------------------------------------------------
// Ordering
// ---------------------------------------------------------------------------

// Lessons by `n` — top-level course lessons first, then each sorted module's
// lessons, module-major.
let by_lesson_n    = fn(l: Lesson) -> u32 { l.n }
let course_lessons = sort_by(lessons, by_lesson_n)
let sorted_modules = sort_by(modules, fn(m: TrainingModule) -> u32 { m.n })
let all_lessons    = flatten([course_lessons, flatten(map(sorted_modules,
                       fn(m: TrainingModule) -> list<Lesson> { sort_by(m.lessons, by_lesson_n) }))])

// A lesson id resolved to a syllabus link (empty when unknown, so a stale
// prerequisite degrades to nothing rather than an error).
let lesson_link = fn(lid: identifier) -> list<utf8> {
  map(filter(all_lessons, fn(x: Lesson) -> bool { x.id == lid }),
      fn(x: Lesson) -> utf8 { $"[${x.title}](lesson_${x.id})" })
}

// ---------------------------------------------------------------------------
// Links back into the reference book
// ---------------------------------------------------------------------------

// Where the book renders, relative to a training page.
//
// These wskills publish through the docs aggregate (`docs/main.wcl`), which
// builds books under `wskills/<id>/` and courses under `training/<id>/` — so
// the book is two levels up and across. A standalone `just training-build`
// (out/training beside out/book) wants `"../book/"` instead, which is what a
// fresh scaffold ships; the two layouts cannot share one relative path.
let book_base = $"../../wskills/${topic.id}/"

// Every reference unit that has a book page of its own, as `(id, name, href)`.
// Mirrors the book's own `all_units` table — examples and terms render inside
// other pages, so they are not linkable targets.
type RefUnit { id: identifier  name: utf8  href: utf8  linkable: bool }
let training_child_indexes = flatten(map(indexes, fn(ix: Index) -> list<Index> { ix.children }))
let training_indexes = flatten([indexes, training_child_indexes])
let training_content_indexes = filter(training_indexes, fn(ix: Index) -> bool { match ix.body { none => false, _ => true } })
let training_nav_indexes = filter(training_indexes, fn(ix: Index) -> bool { match ix.body { none => true, _ => false } })
let ref_units = flatten([
  map(concepts,       fn(c: Concept)   -> RefUnit { { id: c.id, name: c.name,  href: $"concept_${c.id}", linkable: true } }),
  map(entities,       fn(e: Entity)    -> RefUnit { { id: e.id, name: e.name,  href: $"entity_${e.id}",  linkable: true } }),
  map(facts,          fn(f: Fact)      -> RefUnit { { id: f.id, name: f.title, href: $"fact_${f.id}",    linkable: true } }),
  map(procedures,     fn(p: Procedure) -> RefUnit { { id: p.id, name: p.title, href: $"process_${p.id}", linkable: true } }),
  map(research_units, fn(r: Research)  -> RefUnit { { id: r.id, name: r.topic, href: $"research_${r.id}", linkable: true } }),
  map(training_content_indexes, fn(ix: Index) -> RefUnit { { id: ix.id, name: ix.name, href: $"index_${ix.id}", linkable: true } }),
  map(training_nav_indexes, fn(ix: Index) -> RefUnit { { id: ix.id, name: ix.name, href: "", linkable: false } }),
])

// A reference id resolved to a markdown link into the book. Empty when the id
// matches no unit, so a stale `related` entry degrades to nothing.
let training_related_id = fn(edge: identifier) -> identifier { try edge.id catch e => edge }
let training_related_reason = fn(edge: identifier) -> utf8 { try $" — ${edge.why}" catch e => "" }
let training_ref_link = fn(u: RefUnit, edge: identifier) -> utf8 {
  match u.linkable {
    false => error($"`related` names bodyless index `${u.id}`"),
    _ => $"[${u.name}](${book_base}${u.href}.html)${training_related_reason(edge)}"
  }
}
let ref_link = fn(edge: identifier) -> list<utf8> {
  map(filter(ref_units, fn(u: RefUnit) -> bool { $"${u.id}" == $"${training_related_id(edge)}" }),
      fn(u: RefUnit) -> utf8 { training_ref_link(u, edge) })
}
let ref_links = fn(edges: list<identifier>) -> utf8 {
  join(flatten(map(edges, ref_link)), " · ")
}

// ---------------------------------------------------------------------------
// The training template
// ---------------------------------------------------------------------------

style "training_css" {
  base ":root" { css = "--tr-accent: #3b82f6; --tr-ok: #16a34a; --tr-bad: #dc2626;" }
  class "tr-nav" { css = "position: fixed; top: 0; left: 0; bottom: 0; width: 17rem; overflow-y: auto;\n  padding: 1.5rem 1rem 3rem; border-right: 1px solid var(--wdoc-border, rgba(127,127,127,.25));\n  z-index: 5;" }
  class "tr-nav-title" { css = "font-weight: 700; font-size: .95rem; margin-bottom: .25rem;" }
  class "tr-progress" { css = "font-size: .78rem; opacity: .75; margin-bottom: 1rem;" }
  class "tr-progress-bar" { css = "height: 4px; border-radius: 2px; background: rgba(127,127,127,.25); margin-top: .4rem;" }
  class "tr-progress-fill" { css = "height: 100%; width: 0; border-radius: 2px; background: var(--tr-accent); transition: width .3s ease;" }
  class "tr-nav" {
    nest "ul" { css = "list-style: none; margin: 0; padding: 0;" }
  }
  class "tr-nav-module" { css = "font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; opacity: .6; margin: 1.2rem 0 .4rem;" }
  class "tr-nav-item" {
    nest "a" { css = "display: flex; gap: .5rem; align-items: baseline; padding: .3rem .5rem;\n  border-radius: 4px; text-decoration: none; font-size: .88rem; line-height: 1.35;" }
  }
  class "tr-nav-item" {
    nest "a:hover" { css = "background: rgba(127,127,127,.12);" }
  }
  class "tr-nav-item" {
    nest "a.current" { css = "background: rgba(59,130,246,.14); font-weight: 600;" }
  }
  class "tr-nav-mark" { css = "flex: none; width: 1rem; opacity: .5; font-size: .8rem;" }
  class "tr-nav-item" {
    nest "a.done .tr-nav-mark" { css = "color: var(--tr-ok); opacity: 1;" }
  }
  class "tr-main" { css = "margin-left: 17rem; padding: 2.5rem 2rem 6rem; max-width: 56rem;" }
  class "tr-topbar" { css = "display: flex; justify-content: flex-end; gap: .5rem; margin-bottom: 1rem;" }
  class "tr-pagenav" { css = "display: flex; justify-content: space-between; margin-top: 4rem; padding-top: 1.5rem;\n  border-top: 1px solid var(--wdoc-border, rgba(127,127,127,.25)); font-size: .9rem;" }
  class "wdoc-quiz" { css = "margin: 1.5rem 0; padding: 1.1rem 1.25rem; border: 1px solid var(--wdoc-border, rgba(127,127,127,.28)); border-radius: 8px;" }
  class "quiz-prompt" { css = "font-weight: 600; margin-bottom: .85rem;" }
  class "quiz-choices" { css = "list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .5rem;" }
  class "quiz-choice-btn" { css = "display: block; width: 100%; text-align: left; padding: .55rem .75rem; cursor: pointer;\n  border: 1px solid var(--wdoc-border, rgba(127,127,127,.3)); border-radius: 6px;\n  background: transparent; color: inherit; font: inherit;" }
  class "quiz-choice-btn" {
    nest "&:hover" { css = "border-color: var(--tr-accent);" }
  }
  class "quiz-choice-btn" {
    nest "&.picked" { css = "border-color: var(--tr-accent); background: rgba(59,130,246,.1);" }
  }
  class "quiz-choice-btn" {
    nest "&.right" { css = "border-color: var(--tr-ok); background: rgba(22,163,74,.12);" }
  }
  class "quiz-choice-btn" {
    nest "&.wrong" { css = "border-color: var(--tr-bad); background: rgba(220,38,38,.1);" }
  }
  class "quiz-choice-note" { css = "display: none; font-size: .85rem; opacity: .8; margin: .35rem 0 0 .75rem;" }
  class "wdoc-quiz" {
    nest "&.answered .quiz-choice-note" { css = "display: block;" }
  }
  base ".quiz-explanation, .quiz-rubric" { css = "display: none; margin-top: .9rem; padding: .7rem .9rem;\n  border-radius: 6px; background: rgba(127,127,127,.1); font-size: .9rem;" }
  base ".wdoc-quiz.answered .quiz-explanation, .wdoc-quiz.answered .quiz-rubric" { css = "display: block;" }
  class "quiz-rubric-label" { css = "font-weight: 600; font-size: .8rem; text-transform: uppercase; letter-spacing: .05em; opacity: .7; margin-bottom: .3rem;" }
  class "quiz-answer" { css = "width: 100%; box-sizing: border-box; padding: .6rem .7rem; font: inherit; font-size: .9rem;\n  border: 1px solid var(--wdoc-border, rgba(127,127,127,.3)); border-radius: 6px; background: transparent; color: inherit;" }
  base ".quiz-submit, .quiz-check" { css = "margin-top: .6rem; padding: .45rem 1rem; cursor: pointer; font: inherit; font-size: .88rem;\n  border: 1px solid var(--tr-accent); border-radius: 6px; background: var(--tr-accent); color: #fff;" }
  base ".quiz-submit[disabled], .quiz-check[disabled]" { css = "opacity: .5; cursor: default;" }
  class "quiz-verdict" { css = "display: none; margin-top: .8rem; padding: .7rem .9rem; border-radius: 6px; font-size: .9rem;\n  border-left: 3px solid var(--tr-accent); background: rgba(127,127,127,.1);" }
  class "quiz-verdict" {
    nest "&.shown" { css = "display: block;" }
  }
  class "quiz-verdict" {
    nest "&.pass" { css = "border-left-color: var(--tr-ok);" }
  }
  class "quiz-verdict" {
    nest "&.fail" { css = "border-left-color: var(--tr-bad);" }
  }
  class "tr-reset" { css = "display: block; margin-top: 2rem; font-size: .78rem; opacity: .6; background: none;\n  border: 0; cursor: pointer; color: inherit; text-decoration: underline;" }
  media "(max-width: 820px)" {
    class "tr-nav" { css = "position: static; width: auto; height: auto; border-right: 0;\n    border-bottom: 1px solid var(--wdoc-border, rgba(127,127,127,.25));" }
    class "tr-main" { css = "margin-left: 0; padding: 1.5rem 1rem 4rem;" }
  }
}

// The course runtime. Static-first: progress lives in localStorage and multiple
// choice grades in the page, so the built site needs no server. When one IS
// running (`wcl wdoc serve`), free-text answers additionally POST to the
// sidecar and the page long-polls for an agent's verdict.
let training_js = <<'JS'
<script>
(function () {
  var API = "/__wdoc_training";
  var course = location.pathname.replace(/[^/]*$/, "");
  var KEY = "wcl-training:" + course;
  var state = {};
  try { state = JSON.parse(localStorage.getItem(KEY) || "{}"); } catch (e) { state = {}; }
  function save() { try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {} }

  function lessonOf(href) {
    var m = /(?:^|\/)lesson_([A-Za-z0-9_]+)\.html/.exec(href || "");
    return m ? m[1] : null;
  }
  var currentLesson = lessonOf(location.pathname);
  var serverUp = null;

  function paintNav() {
    var links = document.querySelectorAll(".tr-nav-item a");
    var done = 0, total = 0;
    for (var i = 0; i < links.length; i++) {
      var id = lessonOf(links[i].getAttribute("href"));
      if (!id) continue;
      total++;
      var mark = links[i].querySelector(".tr-nav-mark");
      if (state["lesson:" + id]) {
        done++;
        links[i].classList.add("done");
        if (mark) mark.textContent = "✓";
      } else if (mark) {
        mark.textContent = "○";
      }
    }
    var label = document.querySelector(".tr-progress-label");
    var fill = document.querySelector(".tr-progress-fill");
    if (label) label.textContent = total ? done + " of " + total + " complete" : "No sections yet";
    if (fill) fill.style.width = (total ? (done / total) * 100 : 0) + "%";
  }

  // A section counts as complete when every check on its page is answered.
  function refreshLesson() {
    if (!currentLesson) return;
    var boxes = document.querySelectorAll(".wdoc-quiz");
    if (!boxes.length) return;
    var all = true;
    for (var i = 0; i < boxes.length; i++) {
      if (!state["check:" + boxes[i].getAttribute("data-quiz")]) { all = false; break; }
    }
    if (all) state["lesson:" + currentLesson] = true;
    else delete state["lesson:" + currentLesson];
    save();
    paintNav();
  }

  // Every call to the optional server is time-boxed. A published course is
  // usually static, so this request is EXPECTED to fail — it must fail fast
  // and never leave the UI waiting on it.
  function ask(path, opts) {
    var ctl = typeof AbortController === "function" ? new AbortController() : null;
    var timer = setTimeout(function () { if (ctl) ctl.abort(); }, 4000);
    if (ctl) opts.signal = ctl.signal;
    return fetch(API + path, opts).then(
      function (r) { clearTimeout(timer); return r; },
      function (e) { clearTimeout(timer); throw e; }
    );
  }

  function post(rec) {
    if (serverUp === false || !currentLesson) return Promise.resolve(false);
    rec.lesson = currentLesson;
    rec.course = course;
    return ask("/answer", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify(rec)
    }).then(function (r) { serverUp = r.ok; return r.ok; })
      .catch(function () { serverUp = false; return false; });
  }

  function gradeChoices(box, picked) {
    var btns = box.querySelectorAll(".quiz-choice-btn");
    var ok = true;
    for (var i = 0; i < btns.length; i++) {
      var b = btns[i];
      var correct = b.getAttribute("data-correct") === "1";
      var chosen = picked.indexOf(b.getAttribute("data-choice")) >= 0;
      b.classList.remove("picked");
      if (correct) b.classList.add("right");
      if (chosen && !correct) { b.classList.add("wrong"); ok = false; }
      if (!chosen && correct) ok = false;
      b.disabled = true;
    }
    box.classList.add("answered");
    var check = box.querySelector(".quiz-check");
    if (check) check.parentNode.removeChild(check);
    state["check:" + box.getAttribute("data-quiz")] = ok ? "correct" : "wrong";
    save();
    refreshLesson();
    post({ check: box.getAttribute("data-quiz"), response: picked.join(","), status: ok ? "correct" : "wrong" });
  }

  function wireChoice(box) {
    var multi = box.getAttribute("data-kind") === "multi";
    var picked = [];
    var btns = box.querySelectorAll(".quiz-choice-btn");
    if (multi) {
      var check = document.createElement("button");
      check.type = "button";
      check.className = "quiz-check";
      check.textContent = "Check answers";
      check.disabled = true;
      check.onclick = function () { gradeChoices(box, picked); };
      box.appendChild(check);
      for (var i = 0; i < btns.length; i++) {
        (function (b) {
          b.onclick = function () {
            var id = b.getAttribute("data-choice");
            var at = picked.indexOf(id);
            if (at >= 0) { picked.splice(at, 1); b.classList.remove("picked"); }
            else { picked.push(id); b.classList.add("picked"); }
            check.disabled = picked.length === 0;
          };
        })(btns[i]);
      }
    } else {
      for (var j = 0; j < btns.length; j++) {
        (function (b) {
          b.onclick = function () { gradeChoices(box, [b.getAttribute("data-choice")]); };
        })(btns[j]);
      }
    }
  }

  function showVerdict(box, text, pass) {
    var v = box.querySelector(".quiz-verdict");
    if (!v) return;
    v.textContent = text;
    v.className = "quiz-verdict shown" + (pass === true ? " pass" : (pass === false ? " fail" : ""));
  }

  // Long-poll for an agent's verdict; the endpoint holds the request open
  // until the sidecar changes (or times out, and we simply ask again).
  function poll(box, id) {
    if (serverUp === false) return;
    ask("/state?check=" + encodeURIComponent(id) + "&course=" + encodeURIComponent(course), {})
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        if (d && d.status === "graded") {
          state["verdict:" + id] = d.verdict || "Graded.";
          state["check:" + id] = d.pass ? "correct" : "wrong";
          save();
          showVerdict(box, state["verdict:" + id], !!d.pass);
          refreshLesson();
          return;
        }
        setTimeout(function () { poll(box, id); }, 2000);
      })
      .catch(function () { serverUp = false; });
  }

  function wireText(box) {
    var ta = box.querySelector(".quiz-answer");
    var btn = box.querySelector(".quiz-submit");
    if (!ta || !btn) return;
    var id = box.getAttribute("data-quiz");
    var prior = state["answer:" + id];
    if (prior) { ta.value = prior; box.classList.add("answered"); }
    if (state["verdict:" + id]) showVerdict(box, state["verdict:" + id], state["check:" + id] === "correct");
    btn.onclick = function () {
      var text = ta.value.replace(/^\s+|\s+$/g, "");
      if (!text) return;
      state["answer:" + id] = text;
      if (!state["check:" + id]) state["check:" + id] = "submitted";
      save();
      box.classList.add("answered");
      refreshLesson();
      btn.disabled = true;
      post({ check: id, response: text, status: "pending" }).then(function (ok) {
        btn.disabled = false;
        if (ok) {
          showVerdict(box, "Sent for review — an agent will grade this shortly.", null);
          poll(box, id);
        } else {
          showVerdict(box, "Saved in this browser. Compare your answer with the guidance above.", null);
        }
      });
    };
  }

  var boxes = document.querySelectorAll(".wdoc-quiz");
  for (var i = 0; i < boxes.length; i++) {
    var box = boxes[i];
    var id = box.getAttribute("data-quiz");
    if (box.getAttribute("data-kind") === "text") {
      wireText(box);
      if (state["check:" + id] === "submitted" && !state["verdict:" + id]) poll(box, id);
    } else if (state["check:" + id] === "correct" || state["check:" + id] === "wrong") {
      var btns = box.querySelectorAll(".quiz-choice-btn");
      for (var k = 0; k < btns.length; k++) {
        if (btns[k].getAttribute("data-correct") === "1") btns[k].classList.add("right");
        btns[k].disabled = true;
      }
      box.classList.add("answered");
    } else {
      wireChoice(box);
    }
  }
  paintNav();

  var reset = document.querySelector(".tr-reset");
  if (reset) reset.onclick = function () { state = {}; save(); location.reload(); };
})();
</script>
JS

// One syllabus entry. A lesson carries the completion mark the runtime fills
// in; a module heading (a TOC entry with no page) renders as a label.
let tr_nav_entry = fn(e: TocEntry, current_href: utf8) -> Html
  if e.href == "" {
    el("li", ["tr-nav-module"], [raw(e.title)])
  } else {
    el("li", ["tr-nav-item"], [
        ela("a", if e.href == current_href { ["current"] } else { none }, [["href", e.href]], [
            el("span", ["tr-nav-mark"], [raw("○")]),
            el("span", [], [raw(e.title)]),
          ]),
      ])
  }

// The syllabus rail: module headings and their lessons, flattened to one list
// (the course is two levels deep by construction).
let tr_nav_items = fn(entries: list<TocEntry>, current_href: utf8) -> list<Html>
  flatten(map(entries, fn(e: TocEntry) -> list<Html>
    flatten([
      [tr_nav_entry(e, current_href)],
      map(e.children, fn(child: TocEntry) -> Html tr_nav_entry(child, current_href)),
    ])))

let tr_nav = fn(c: TemplateCtx) -> list<Html> [
  el("nav", ["tr-nav"], [
      el("div", ["tr-nav-title"], [raw(c.title)]),
      el("div", ["tr-progress"], [
          el("div", ["tr-progress-label"], [raw("Not started")]),
          el("div", ["tr-progress-bar"], [ el("div", ["tr-progress-fill"], []) ]),
        ]),
      el("ul", [], tr_nav_items(c.toc, format("{}.html", c.page_name))),
      ela("button", ["tr-reset"], [["type", "button"]], [raw("Reset progress")]),
    ]),
]

template training {
  slot content: content
  render = fn(c: TemplateCtx) -> list<Html>
    flatten([
      [ css_style(:training_css) ],
      tr_nav(c),
      [ el("main", ["tr-main"], flatten([
            [ el("div", ["tr-topbar"], wdoc_part_theme_toggle(c.theme_toggle)) ],
            wdoc_blocks(c.content),
            [ el("div", ["tr-pagenav"], wdoc_part_pagenav(c)) ],
          ])) ],
      [raw(training_js)],
    ])
}

// ---------------------------------------------------------------------------
// site
// ---------------------------------------------------------------------------

site training {
  default_template = :training
  title   = $"${topic.name} — training"
  summary = $"A hands-on course for ${topic.name}."
  root         = true
  theme        = :forge
  theme_toggle = true
  toc {
    chapter "Start here" { page = index }
    wdoc_repeater { each = course_lessons  as = :l
      chapter $"${l.n}. ${l.title}" { page = $"lesson_${l.id}" }
    }
    wdoc_repeater { each = sorted_modules  as = :m
      chapter $"${m.title}" {
        wdoc_repeater { each = sort_by(m.lessons, by_lesson_n)  as = :l
          chapter $"${l.n}. ${l.title}" { page = $"lesson_${l.id}" }
        }
      }
    }
  }
}

// ---------------------------------------------------------------------------
// syllabus (start page)
// ---------------------------------------------------------------------------

page index { start = true
  h1 $"${topic.name} — training"
  p  $"${topic.summary}"
  p  "Work through the sections in order — each builds on the last. Every section ends with checks: pick an answer and the page tells you straight away, or write one out and an agent grades it when the course runs under `wcl wdoc serve`. Your progress is remembered in this browser."

  wdoc_repeater { each = match len(course_lessons) { 0 => [], _ => [true] }  as = :_cl
    h2 "Sections"
    wdoc_repeater { each = course_lessons  as = :l
      p $"${l.n}. [${l.title}](lesson_${l.id})${match l.summary { none => "", s => $" — ${s}" }}"
    }
  }
  wdoc_repeater { each = sorted_modules  as = :m
    h2 $"${m.title}"
    wdoc_repeater { each = match m.summary { none => [], s => [s] }  as = :s  p $"_${s}_" }
    wdoc_repeater { each = sort_by(m.lessons, by_lesson_n)  as = :l
      p $"${l.n}. [${l.title}](lesson_${l.id})${match l.summary { none => "", s => $" — ${s}" }}"
    }
  }
}

// ---------------------------------------------------------------------------
// lesson pages — material → exercises → checks
// ---------------------------------------------------------------------------

wdoc_repeater { each = all_lessons  as = :l
  page $"lesson_${l.id}" { title = $"${l.title}"
    h1 $"${l.n}. ${l.title}"
    wdoc_repeater { each = match l.summary { none => [], s => [s] }  as = :s  p $"_${s}_" }

    wdoc_repeater { each = match len(l.objectives) { 0 => [], _ => [true] }  as = :_ob
      callout "After this section you can" { class = ["info"]
        body = join(map(l.objectives, fn(o: utf8) -> utf8 { $"- ${o}" }), "\n")
      }
    }
    wdoc_repeater { each = match len(l.prerequisites) { 0 => [], _ => [true] }  as = :_pr
      p $"**Before you start:** ${join(flatten(map(l.prerequisites, lesson_link)), " · ")}"
    }
    wdoc_repeater { each = match ref_links(l.related) { "" => [], r => [r] }  as = :r
      p $"**Covered in the reference:** ${r}"
    }

    wdoc_repeater { each = match l.body { none => [], b => [true] }  as = :_b
      project { from = l.body }
    }

    wdoc_repeater { each = l.exercises  as = :ex
      h2 $"Exercise: ${ex.title}"
      p $"${ex.task}"
      wdoc_repeater { each = match ex.code { none => [], c => [c] }  as = :c
        code $"${ex.code_lang ?? "text"}" { source = c }
      }
      wdoc_repeater { each = match ex.body { none => [], b => [true] }  as = :_b
        project { from = ex.body }
      }
      wdoc_repeater { each = match ex.expected { none => [], e => [e] }  as = :e
        callout "Expected result" { class = ["success"]  body = $"${e}" }
      }
      wdoc_repeater { each = match ex.hint { none => [], h => [h] }  as = :h
        callout "Hint" { class = ["warning"]  body = $"${h}" }
      }
    }

    wdoc_repeater { each = match len(l.checks) { 0 => [], _ => [true] }  as = :_ck
      h2 "Check your understanding"
      wdoc_repeater { each = l.checks  as = :ck
        quiz $"${ck.id}" {
          prompt      = ck.prompt
          kind        = ck.kind ?? match len(ck.choices) { 0 => :text, _ => :single }
          explanation = ck.explanation
          rubric      = ck.rubric
          choices     = ck.choices
        }
        wdoc_repeater { each = match ref_links(ck.related) { "" => [], r => [r] }  as = :r
          p $"Reference: ${r}"
        }
      }
    }
  }
}
