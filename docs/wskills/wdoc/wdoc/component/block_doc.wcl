// Per-component documentation card. Given a wdoc block `type` and a short
// `description`, renders the blurb followed by `type_table` — which emits the
// **Property** table and (when the type nests blocks) a **Child blocks** table,
// reflected straight from the live schema so they can't drift.
//
//   block_doc {
//     type        = Callout
//     description = "An admonition — icon, coloured heading, and a body."
//   }
//
// An entity body calls it once per block type in the component's family
// (most have one; `charts`, `lists` … have several), usually paired with a
// `demo { … }` that shows an example + live light/dark preview.

import <wdoc.wcl>

wdoc_component block_doc {
  wdoc_slot type
  wdoc_slot description
  wdoc_body {
    p $"${description}"
    type_table { type = type }
  }
}
