import <wdoc.wcl>

fact dopesheets {
  title = "dopesheet"
  related = [{ id: "images", why: "image supports dopesheet: `image` embeds a static image." }, { id: "diagrams", why: "diagram supports dopesheet: A `diagram` is wdoc's drawing surface." }]
  audience = :both
  body {
    p <<DOC
      `dopesheet` plays a range of frames from a sprite sheet at a set `fps` — a placeable SVG
      block, a legal child of any `diagram` or `container`. Here the whole sheet loops at 12 fps
      (click the coin to pause):
    DOC
    demo {
      diagram = true
      diagram {
        width = 96
        height = 96
        dopesheet "../../assets/pixel-coin.png" {
          frame_width = 12
          frame_height = 12
          scale = 6.0
          fps = 12.0
          x = 12.0
          y = 12.0
        }
      }
    }
    block_doc {
      type = Dopesheet
      description = "`dopesheet` plays a range of frames from a sprite sheet at a set `fps`. Like `tilemap` it's a placeable SVG block — a legal child of any `diagram` or `container`. The sheet is referenced by URL (an `@inline(0)` source, like `image`), so frames resolve when the site is **served**, not when the page is opened directly from disk."
    }
    h2 "Frame geometry and playback"
    p <<DOC
      Describe the frame grid with `frame_width` / `frame_height`, plus `offset_x` / `offset_y` and
      `stride_x` / `stride_y` for padding or gaps; `columns` defaults to as many frames as fit
      across the sheet. `from` / `to` pick an inclusive sub-range. `scale` enlarges pixel art;
      `image-rendering: pixelated` is the default, so set `smooth = true` for non-pixel sources.
      Autoplay, loop, and controls are on by default — click to pause or resume. (The sample sheet
      is truezipp's CC0 "Pixel Coins Asset".)
    DOC
    p <<DOC
      Just the first three frames (`from` / `to`), spelt-out grid geometry, and `autoplay = false`
      so it starts paused — click to play:
    DOC
    demo {
      diagram = true
      diagram {
        width = 96
        height = 96
        dopesheet "../../assets/pixel-coin.png" {
          frame_width = 12
          frame_height = 12
          stride_x = 12
          stride_y = 12
          columns = 6
          from = 0
          to = 2
          fps = 6.0
          autoplay = false
          scale = 6.0
          x = 12.0
          y = 12.0
        }
      }
    }
  }
}
