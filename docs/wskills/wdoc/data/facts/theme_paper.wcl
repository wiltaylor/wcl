import <wdoc.wcl>

// Theme preview — swatches are literal hex, mirroring `lib/theme.wcl`'s
// `paper` palettes (dark + light). Keep in sync with that file by hand.
fact theme_paper {
  title = "Paper theme"
  related = [{ id: "themes", why: "Built-in colour themes supports Paper theme: Set `theme = :<name>` on a `site` to recolour the whole site in one line." }]
  audience = :both
  body {
    p "`theme = :paper` — warm print look, serif headings. Dark (top) and light (bottom): page, surface, border, accent, accent-2, tip, warn, danger, keyword. See [all themes](fact_themes)."
    diagram {
      width = 340  height = 116
      label "Dark"  { x = 6.0  y = 30.0  font_size = 11.0  fill = "#9a8f7d" }
      rect { x = 46.0  y = 18.0  width = 24.0  height = 24.0  fill = "#171513" }
      rect { x = 73.0  y = 18.0  width = 24.0  height = 24.0  fill = "#211e1b" }
      rect { x = 100.0  y = 18.0  width = 24.0  height = 24.0  fill = "#2a2622" }
      rect { x = 127.0  y = 18.0  width = 24.0  height = 24.0  fill = "#322d28" }
      rect { x = 154.0  y = 18.0  width = 24.0  height = 24.0  fill = "#d98b8b" }
      rect { x = 181.0  y = 18.0  width = 24.0  height = 24.0  fill = "#8fb0cf" }
      rect { x = 208.0  y = 18.0  width = 24.0  height = 24.0  fill = "#9bbd86" }
      rect { x = 235.0  y = 18.0  width = 24.0  height = 24.0  fill = "#d9b779" }
      rect { x = 262.0  y = 18.0  width = 24.0  height = 24.0  fill = "#d98b8b" }
      rect { x = 289.0  y = 18.0  width = 24.0  height = 24.0  fill = "#d98b8b" }
      label "Light" { x = 6.0  y = 84.0  font_size = 11.0  fill = "#6b6358" }
      rect { x = 46.0  y = 72.0  width = 24.0  height = 24.0  fill = "#e7e3da" }
      rect { x = 73.0  y = 72.0  width = 24.0  height = 24.0  fill = "#fcfbf7" }
      rect { x = 100.0  y = 72.0  width = 24.0  height = 24.0  fill = "#f4f1ea" }
      rect { x = 127.0  y = 72.0  width = 24.0  height = 24.0  fill = "#ddd8cc" }
      rect { x = 154.0  y = 72.0  width = 24.0  height = 24.0  fill = "#8a1c1c" }
      rect { x = 181.0  y = 72.0  width = 24.0  height = 24.0  fill = "#2c4a6e" }
      rect { x = 208.0  y = 72.0  width = 24.0  height = 24.0  fill = "#3a5f2e" }
      rect { x = 235.0  y = 72.0  width = 24.0  height = 24.0  fill = "#8a5a12" }
      rect { x = 262.0  y = 72.0  width = 24.0  height = 24.0  fill = "#8a1c1c" }
      rect { x = 289.0  y = 72.0  width = 24.0  height = 24.0  fill = "#8a1c1c" }
    }
  }
}
