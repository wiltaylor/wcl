import <wdoc.wcl>

# Custom TUI control used in the "Custom widgets" section below: a keycap
# pill. It extends TermPrimitive (so it's a legal `terminal` child) and its
# `lower` returns styled text runs — a coloured background of spaces with the
# key label on top, both via the shared `term_run` / `term_repeat` helpers the
# stdlib widgets use.
@block("kbd")
type Kbd extends TermPrimitive {
  @inline(0) key: utf8
  accent: utf8?
  row: i64
  col: i64
  lower = fn(k: Kbd) -> list<TermFundamental> {
    let acc = if k.accent == none { "magenta" } else { k.accent };
    let w = len(k.key) + 2;
    [term_run(term_repeat(" ", w), 1, 1, none, acc, none), term_run(k.key, 1, 2, "bright_white", acc, true)]
  }
}

fact terminals {
  title = "terminal"
  related = []
  audience = :both
  body {
    p <<DOC
      A `terminal` renders a monospace character grid as inline SVG, drawn with a bundled Nerd Font.
      The grid is populated three ways: authored text primitives, an inline ANSI-bearing `text`
      field, or replay of an `asciinema` recording. `cols` / `rows` size the grid; `chrome` toggles
      the window frame; `title` labels it.
    DOC
    demo {
      diagram = true
      terminal {
        cols = 46
        rows = 7
        title = "demo"
        term_text "Colours" {
          row = 1
          col = 2
          bold = true
          underline = true
        }
        term_text "red" {
          row = 2
          col = 2
          fg = "red"
        }
        term_text "green" {
          row = 2
          col = 8
          fg = "green"
        }
        term_text "blue" {
          row = 2
          col = 16
          fg = "blue"
        }
        term_text "#ff5fd2" {
          row = 2
          col = 23
          fg = "#ff5fd2"
        }
        term_box {
          row = 4
          col = 2
          width = 32
          height = 3
          border = :rounded
          fg = "cyan"
          title = "box"
        }
        term_text "rounded border" {
          row = 5
          col = 4
        }
      }
    }
    type_table {
      type = Terminal
    }

    h2 "Primitives"
    p <<DOC
      `term_text` is the one base primitive — styled text at a 1-based `(row, col)` carrying `fg` /
      `bg` and `bold` / `italic` / `underline`. Higher-level helpers (`term_box`, `term_glyph`,
      `term_fill`) lower to runs of `term_text`. Colours are strings: an ANSI name (`"red"`), a
      256-palette index (`"208"`), or a hex (`"#ff5fd2"`). All four side by side:
    DOC
    demo {
      diagram = true
      terminal {
        cols = 40
        rows = 9
        title = "primitives"
        term_text "term_text — styled" {
          row = 1
          col = 2
          fg = "green"
          bold = true
        }
        term_box {
          row = 3
          col = 2
          width = 22
          height = 3
          border = :rounded
          fg = "cyan"
          title = "term_box"
        }
        term_glyph "★" {
          row = 4
          col = 27
          fg = "yellow"
        }
        term_text "term_glyph" {
          row = 4
          col = 29
        }
        term_fill "░" {
          row = 7
          col = 2
          width = 36
          height = 1
          fg = "magenta"
        }
        term_text "term_fill" {
          row = 8
          col = 2
        }
      }
    }
    block_doc {
      type = TermText
      description = "Styled text at a 1-based `(row, col)` carrying `fg` / `bg` and `bold` / `italic` / `underline` — the one base primitive every other terminal helper lowers to."
    }
    block_doc {
      type = TermBox
      description = "A box drawn with line-drawing characters at `(row, col)` over a `width` / `height`, with a `border` style (`:rounded`, …) and an optional `title`."
    }
    block_doc {
      type = TermGlyph
      description = "A single placed glyph at `(row, col)` — handy for sigils, spinners, and box-drawing accents that aren't full text runs."
    }
    block_doc {
      type = TermFill
      description = "Fills a rectangular region of the grid with a repeated character and colour, for backgrounds and shading."
    }

    h2 "Inline ANSI and asciinema replay"
    p <<'DOC'
      Set `text = "…"` and the bundled `avt` virtual terminal evaluates it — ANSI sequences, cursor
      movement, and styling all apply (a bare `\n` is a newline). Set `source = "rec.cast"` for
      asciinema replay; frames replay at the recording's pace (override with `speed`) and stop at
      the end unless `loop = true`.
    DOC
    demo {
      diagram = true
      terminal {
        cols = 30
        rows = 3
        title = "inline"
        text = "first line\nsecond line"
      }
    }

    h2 "TUI widgets"
    p <<DOC
      Inside a `terminal`, stdlib TUI controls compose a small interface — each lowers to runs of
      `term_text`. Place each from its own `(row, col)`; container widgets position their children
      relative to themselves.
    DOC
    demo {
      diagram = true
      terminal {
        cols = 44
        rows = 8
        title = "controls"
        term_text "Progress" {
          row = 1
          col = 2
          bold = true
          underline = true
        }
        tui_progress "Upload" {
          row = 2
          col = 2
          value = 78
        }
        tui_progress "Sync" {
          row = 3
          col = 2
          value = 40
          accent = "cyan"
        }
        term_text "Buttons" {
          row = 5
          col = 2
          bold = true
          underline = true
        }
        tui_button "Save" {
          row = 6
          col = 2
          accent = "green"
        }
        tui_button "Discard" {
          row = 6
          col = 11
          accent = "red"
        }
      }
    }

    h3 "tui_progress"
    p <<DOC
      A two-tone progress bar; `value` runs `0`–`max` (default `100`), the `@inline` label sits to
      its left, and `show_value` appends a percentage.
    DOC
    demo {
      diagram = true
      terminal {
        cols = 38
        rows = 1
        chrome = false
        tui_progress "Upload" {
          row = 1
          col = 1
          value = 65
        }
      }
    }
    type_table {
      type = TuiProgress
    }

    h3 "tui_button"
    p <<DOC
      A solid accent-fill button; the `@inline` label is centred, `width` pads it, `accent` colours
      the fill.
    DOC
    demo {
      diagram = true
      terminal {
        cols = 24
        rows = 1
        chrome = false
        tui_button "Save" {
          row = 1
          col = 1
          accent = "green"
        }
        tui_button "Quit" {
          row = 1
          col = 9
          accent = "red"
        }
      }
    }
    type_table {
      type = TuiButton
    }

    h3 "tui_input"
    p <<DOC
      A single-line field with a left accent bar. With no `value` the `@inline` placeholder shows
      muted; `focused = true` draws a cursor.
    DOC
    demo {
      diagram = true
      terminal {
        cols = 30
        rows = 2
        chrome = false
        tui_input "Search projects" {
          row = 1
          col = 1
          focused = true
        }
        tui_input "Name" {
          row = 2
          col = 1
          value = "Ada Lovelace"
        }
      }
    }
    type_table {
      type = TuiInput
    }

    h3 "tui_dropdown"
    p <<DOC
      A drop-down with a disclosure caret (`▾` closed, `▴` open). With `open = true` and an `items`
      list, the options drop below the field and the selected one is highlighted.
    DOC
    demo {
      diagram = true
      terminal {
        cols = 28
        rows = 4
        chrome = false
        tui_dropdown "Release build" {
          row = 1
          col = 1
          open = true
          items = ["Debug build", "Release build", "Profile build"]
        }
      }
    }
    type_table {
      type = TuiDropdown
    }

    h3 "tui_checkbox"
    p "An on/off checkbox; `checked = true` fills the marker in the accent colour."
    demo {
      diagram = true
      terminal {
        cols = 24
        rows = 2
        chrome = false
        tui_checkbox "Telemetry" {
          row = 1
          col = 1
          checked = true
        }
        tui_checkbox "Beta" {
          row = 2
          col = 1
        }
      }
    }
    type_table {
      type = TuiCheckbox
    }

    h3 "tui_radio"
    p <<DOC
      A radio button — like a checkbox but round; `selected = true` marks the active choice in a
      group you lay out yourself.
    DOC
    demo {
      diagram = true
      terminal {
        cols = 24
        rows = 2
        chrome = false
        tui_radio "Dark" {
          row = 1
          col = 1
          selected = true
        }
        tui_radio "Light" {
          row = 2
          col = 1
        }
      }
    }
    type_table {
      type = TuiRadio
    }

    h3 "tui_spinner"
    p <<DOC
      A single static spinner frame — pick the `kind` (`:braille` default, `:circle`, `:line`) and
      which `frame` to show, with an optional `@inline` label.
    DOC
    demo {
      diagram = true
      terminal {
        cols = 24
        rows = 1
        chrome = false
        tui_spinner "Building…" {
          row = 1
          col = 1
          frame = 2
        }
      }
    }
    type_table {
      type = TuiSpinner
    }

    h3 "tui_panel"
    p <<DOC
      A bordered container: it draws a box (optional `title`) and renders its child controls inset
      by one cell. Child positions are **relative to the panel**.
    DOC
    demo {
      diagram = true
      terminal {
        cols = 30
        rows = 6
        chrome = false
        tui_panel {
          row = 1
          col = 1
          width = 30
          height = 6
          title = "Status"
          tui_progress "Load" {
            row = 1
            col = 1
            value = 50
            width = 16
          }
          tui_button "Go" {
            row = 3
            col = 1
            accent = "green"
          }
        }
      }
    }
    type_table {
      type = TuiPanel
    }

    h3 "tui_group"
    p <<DOC
      A borderless container — an optional `title` then its children. Use it to offset a cluster of
      controls without drawing a box.
    DOC
    demo {
      diagram = true
      terminal {
        cols = 26
        rows = 3
        chrome = false
        tui_group {
          row = 1
          col = 1
          title = "Options"
          tui_checkbox "Telemetry" {
            row = 1
            col = 1
            checked = true
          }
          tui_radio "Dark" {
            row = 2
            col = 1
            selected = true
          }
        }
      }
    }
    type_table {
      type = TuiGroup
    }

    h2 "Custom TUI widgets"
    p <<DOC
      TUI widgets are user-extensible. Declare a `@block("name") type … extends TermPrimitive` with a
      `lower` returning `list<TermFundamental>`, and it plugs into the renderer like the built-ins —
      a legal child of any `terminal` (or container). Lay it out from its own top-left `(1, 1)`; the
      renderer offsets it by the widget's placement. Build the output from the shared `term_run` /
      `term_repeat` helpers, since styled text is the only thing the renderer paints.
    DOC
    p <<DOC
      Here's a `kbd` keycap — a coloured background run with the key label on top, the accent
      overridable per instance:
    DOC
    demo {
      diagram = true
      terminal {
        cols = 30
        rows = 1
        chrome = false
        kbd "Ctrl" {
          row = 1
          col = 1
        }
        kbd "K" {
          row = 1
          col = 8
          accent = "blue"
        }
      }
    }
    code "wcl" {
      source = <<DOC
        // Extends TermPrimitive → a legal terminal child. The lower returns styled text
        // runs (a background of spaces + the label on top).
        @block("kbd")
        type Kbd extends TermPrimitive {
          @inline(0) key: utf8
          accent: utf8?
          row: i64  col: i64
          lower = fn(k: Kbd) -> list<TermFundamental> {
            let acc = if k.accent == none { "magenta" } else { k.accent };
            let w = len(k.key) + 2;
            [
              term_run(term_repeat(" ", w), 1, 1, none, acc, none),
              term_run(k.key, 1, 2, "bright_white", acc, true),
            ]
          }
        }

        terminal { cols = 30  rows = 1  chrome = false
          kbd "Ctrl" { row = 1  col = 1 }
          kbd "K"    { row = 1  col = 8  accent = "blue" }
        }
      DOC
    }
  }
}
