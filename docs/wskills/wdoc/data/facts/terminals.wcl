import <wdoc.wcl>

fact terminals {
  title    = "terminal"
  related  = [wireframe, diagrams]
  audience = :both
  body {
    block_doc {
      type        = Terminal
      description = "A `terminal` renders a monospace character grid as inline SVG, drawn with a bundled Nerd Font. The grid is populated three ways: authored text primitives, an inline ANSI-bearing `text` field, or replay of an `asciinema` recording. `cols` / `rows` size the grid; `chrome` toggles the window frame; `title` labels it."
    }
    h2 "Primitives"
    p "`term_text` is the one base primitive — styled text at a 1-based `(row, col)` carrying `fg` / `bg` and `bold` / `italic` / `underline`. Higher-level helpers (`term_box`, `term_glyph`, `term_fill`) lower to runs of `term_text`. Colours are strings: an ANSI name (`\"red\"`), a 256-palette index (`\"208\"`), or a hex (`\"#ff5fd2\"`)."
    block_doc {
      type        = TermText
      description = "Styled text at a 1-based `(row, col)` carrying `fg` / `bg` and `bold` / `italic` / `underline` — the one base primitive every other terminal helper lowers to."
    }
    block_doc {
      type        = TermBox
      description = "A box drawn with line-drawing characters at `(row, col)` over a `width` / `height`, with a `border` style (`:rounded`, …) and an optional `title`."
    }
    block_doc {
      type        = TermGlyph
      description = "A single placed glyph at `(row, col)` — handy for sigils, spinners, and box-drawing accents that aren't full text runs."
    }
    block_doc {
      type        = TermFill
      description = "Fills a rectangular region of the grid with a repeated character and colour, for backgrounds and shading."
    }
    demo {
      diagram = true
      terminal {
        cols = 46  rows = 7  title = "demo"
        term_text "Colours" { row = 1  col = 2  bold = true  underline = true }
        term_text "red"     { row = 2  col = 2  fg = "red" }
        term_text "blue"    { row = 2  col = 16  fg = "blue" }
        term_box { row = 4  col = 2  width = 32  height = 3  border = :rounded  fg = "cyan"  title = "box" }
        term_text "rounded border" { row = 5  col = 4 }
      }
    }
    h2 "Inline ANSI and asciinema replay"
    p "Set `text = \"…\"` and the bundled `avt` virtual terminal evaluates it — ANSI sequences, cursor movement, and styling all apply (a bare `\\n` is a newline). Set `source = \"rec.cast\"` for asciinema replay; frames replay at the recording's pace (override with `speed`) and stop at the end unless `loop = true`."
    h2 "TUI widgets"
    p "Inside a `terminal`, stdlib TUI controls compose a small interface — each lowers to runs of `term_text`. Declare a `@block(\"name\") type … extends TuiWidget` with a `lower` returning `list<TermFundamental>` for a custom widget."
    block_doc {
      type        = TuiPanel
      description = "A bordered container; its children are positioned relative to it."
    }
    block_doc {
      type        = TuiGroup
      description = "A borderless container that groups child widgets without drawing a frame."
    }
    block_doc {
      type        = TuiButton
      description = "A push button with a label and optional `accent` colour."
    }
    block_doc {
      type        = TuiCheckbox
      description = "A labelled checkbox with a checked / unchecked state."
    }
    block_doc {
      type        = TuiRadio
      description = "A labelled radio option, one of a mutually-exclusive group."
    }
    block_doc {
      type        = TuiInput
      description = "A single-line text field showing a placeholder or current value."
    }
    block_doc {
      type        = TuiDropdown
      description = "A select control showing the current choice and a disclosure caret."
    }
    block_doc {
      type        = TuiProgress
      description = "A horizontal progress bar driven by a `value` (0–100) with an optional `accent`."
    }
    block_doc {
      type        = TuiSpinner
      description = "An activity spinner glyph for in-progress state."
    }
    demo {
      diagram = true
      terminal {
        cols = 44  rows = 8  title = "controls"
        tui_progress "Upload" { row = 2  col = 2  value = 78 }
        tui_progress "Sync"   { row = 3  col = 2  value = 40  accent = "cyan" }
        tui_button "Save"    { row = 6  col = 2  accent = "green" }
        tui_button "Discard" { row = 6  col = 11  accent = "red" }
      }
    }
  }
}
