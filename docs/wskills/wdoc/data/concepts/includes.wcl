import <wdoc.wcl>

concept includes {
  name = "Including sub-sites"
  summary = "The `include` block and `included_sites` builtin discover and embed other wdoc documents."
  related = [sites]
  audience = :both
  body {
    p <<DOC
      The `include` block builds *other* wdoc documents found under a folder and ships each one's
      rendered output into a subdirectory of this build — exactly as if you had run `wcl wdoc build`
      (or `wcl wdoc skill`) on each one separately. Unlike imports (which merge another file's
      blocks into the current document), an included document stays a **separate artifact**: it
      keeps its own pages and `_wdoc/` assets under its own output subdirectory.
    DOC
    callout "Include vs import" {
      class = ["info"]
      body = "`import` pulls another file's declarations into *this* document (one merged site). `include` builds another document on its own and copies the result in (many independent sites under one output tree)."
    }

    h2 "Discovery: pattern vs entry"
    p <<DOC
      Name a folder (the inline label), then pick **exactly one** discovery mode. Each match builds
      into `<folder-basename>/<name>/`. **`pattern`** is a filename glob matched recursively; the
      sub-site name is the matching file's parent folder. **`entry`** is a fixed relative path
      checked inside each immediate subdirectory (no recursion).
    DOC
    code "wcl" {
      source = <<DOC
        import <wdoc.wcl>

        // projects/foo/main.wcl  →  <out>/projects/foo/
        include "projects" { pattern = "main.wcl" }

        // members/ls/wdoc/book/main.wcl   →  <out>/members/ls/
        include "members" { entry = "wdoc/book/main.wcl" }
      DOC
    }

    h2 "Picking a site"
    p <<DOC
      A member may declare several sites (e.g. a `:book` web site and an `:ai_skill` site over one
      model). The optional `site` field names which one to build — it is passed as `--site` to the
      per-member build.
    DOC
    code "wcl" {
      source = "include \"members\" { entry = \"main.wcl\"  site = \"book\" }   // each member's :book site only\n"
    }

    h2 "Wiring navigation"
    p <<DOC
      The companion `included_sites(options)` builtin runs the same scan and returns one
      `{ name, href, title, summary }` record per discovered sub-site. The argument is a
      **record mirroring the include block's fields** (WCL has no keyword arguments); pass the
      *same* options so the links line up with where the sub-sites were built. Note record fields
      use `:` where block fields use `=`.
    DOC
    code "wcl" {
      source = <<DOC
        site main { root = true  default_template = :webpage
          menu {
            item "Home" { page = index }
            wdoc_repeater { each = included_sites({ folder: "members", entry: "main.wcl", site: "book" })  as = :s
              item $"${s.title}" { href = s.href }   // label from the member's title
            }
          }
        }
      DOC
    }
    callout "Multi-site hrefs" {
      class = ["warning"]
      body = "`included_sites` returns **root-relative** hrefs (`members/foo/`). A non-root site renders under `/<site>/`, so its menu must reach a sibling sub-site with a `../` prefix (`../members/foo/`)."
    }

    h2 "Skill collections"
    p <<DOC
      Because `include` also embeds for the skill target, one `wcl wdoc skill` renders every
      member's skill into `<out>/<folder>/<name>/`. A collection document can be pure fan-out — just
      `include` blocks, no site of its own.
    DOC
    code "wcl" {
      source = <<DOC
        import <wdoc.wcl>
        include "../members" { entry = "main.wcl"  site = "skill" }   // each member's :skill site
      DOC
    }
    code "console" {
      source = <<DOC
        wcl wdoc build  landing.wcl    --out out/site     # landing + each member's :book
        wcl wdoc skill  collection.wcl --out dist/skills  # each member's :skill → dist/skills/members/<name>/
      DOC
    }

    h2 "Block reference"
    block_doc {
      type = IncludeSites
      description = "An `include` block: a folder of other wdoc documents to build independently and ship into a subdirectory, discovered by `pattern` or `entry`."
    }
  }
}
