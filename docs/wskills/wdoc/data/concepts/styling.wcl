import <wdoc.wcl>

concept styling {
  name = "Styling"
  summary = "Class blocks, stylesheets, and themes — how a site looks."
  related = [{ id: "sites", why: "Sites supports Styling: The `site` block: one output target — template, title, theme, multi-site routing, and full-text search." }]
  audience = :both
  body {
    p <<DOC
      Two layers control how a site looks: `class` blocks style individual elements, and a site
      `theme` sets the palette every built-in element draws from. Classes always win over theme
      defaults via the cascade, so you theme broadly and override locally.
    DOC

    h2 "Classes"
    p <<DOC
      A `class <name> { … }` block declares a CSS class. Apply it by listing the name in any block's
      `class` field (or a span's). Fields cover text, box, and SVG paint properties; per-mode
      overrides go in `dark { }` / `light { }` sub-blocks.
    DOC
    code "wcl" {
      source = <<DOC
        class accent {
          color = "var(--wdoc-accent)"
          bold  = true
          dark  { color = "#88c0d0" }
          light { color = "#5e81ac" }
        }

        // Use the class on a block:
        p "highlighted paragraph" { class = ["accent"] }
      DOC
    }

    h2 "Field groups"
    table {
      header = ["Group", "Fields"]
      rows = [["Text", "`color`, `background`, `bold`, `italic`, `underline`, `font_size`, `font_family`, `text_align`, `text_transform`, `letter_spacing`, `line_height`"], ["Box", "`padding`, `margin`, `border`"], ["SVG", "`fill`, `stroke`, `stroke_width`, `stroke_linejoin`, `stroke_linecap`, `opacity`"], ["Callout", "`accent` — sets a callout's accent colour (heading, border, icon) when the class is on a `callout`"], ["Modes", "`dark { … }`, `light { … }` for prefers-color-scheme overrides"]]
    }
    p <<DOC
      Hyphenated class names may be written bare — `class wdoc-series-1 { fill = "#88c0d0" }` — or
      quoted; both are equivalent. This is how you override built-in classes like the chart palette
      or callout styles. Set `sites = [:foo]` on a class to scope it to one site in a multi-site
      document; omit the field and the class applies everywhere.
    DOC

    h2 "Themes"
    p <<DOC
      A theme is a complete colour palette plus the rules that map it onto every built-in element —
      page background, links, headings, code, charts, callouts, tables, inline emphasis. Set
      `theme = :<name>` on a `site` — a symbol naming a `theme` block. Seven built-in palettes ship
      (`forge` is the default, plus `nord`, `tokyonight`, `gruvbox`, `catppuccin`, `rose`, and
      `paper`), each with co-ordinated dark and light variants and its own typography.
      `theme_toggle = true` adds a light/dark toggle button.
    DOC
    code "wcl" {
      source = <<DOC
        site mysite {
          default_template = :book
          theme            = :tokyonight
          accent           = :cyan
          theme_toggle     = true
        }
      DOC
    }
    p <<DOC
      Independently of the theme, `accent = :cyan` (or
      `:red`/`:orange`/`:yellow`/`:green`/`:blue`/`:purple`/`:pink`) picks the hue used for links
      and current-chapter highlights. Default is `:blue`. A custom theme is just a `theme` block
      holding a `dark` and a `light` `palette` sub-block.
    DOC
    code "wcl" {
      source = <<DOC
        theme sunset {
          palette dark {
            bg = "#1a1a2e"  fg = "#e0e0e0"
            blue = "#5e81ac"  green = "#a3be8c"
            // … any of the 18 roles
          }
          palette light {
            bg = "#fdf6e3"  fg = "#073642"
          }
        }

        site mysite { theme = :sunset  accent = :blue }
      DOC
    }

    h2 "Block reference"
    block_doc {
      type = Class
      description = "A `class` block: a named CSS class with text, box, SVG, and callout-accent fields, plus per-mode `dark` / `light` overrides."
    }
    block_doc {
      type = ClassMode
      description = "The `dark` sub-block of a `class`: field overrides applied under a prefers-dark colour scheme."
    }
    block_doc {
      type = ClassModeLight
      description = "The `light` sub-block of a `class`: field overrides applied under a prefers-light colour scheme."
    }
    block_doc {
      type = Stylesheet
      description = "A `stylesheet` block: raw CSS injected verbatim into the rendered site, for styling beyond the `class` field set."
    }
    block_doc {
      type = ThemeBlock
      description = "A `theme` block: a named palette plus the `dark` / `light` `palette` sub-blocks that map colours onto every built-in element."
    }
    block_doc {
      type = PaletteBlock
      description = "A `palette` sub-block of a `theme`: the colour roles (bg, fg, the named hues, …) for one colour scheme."
    }
    block_doc {
      type = InlinePattern
      description = "An `inline_pattern` block: a custom inline text pattern recognised in prose, mapping a delimiter to a class or rendering."
    }
  }
}
