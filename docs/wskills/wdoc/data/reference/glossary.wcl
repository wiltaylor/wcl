// Glossary for the wdoc wskill — the vocabulary the reference pages lean on.

term block {
  term       = "block"
  definition = "The unit of wdoc content — a typed WCL block (`p`, `h1`, `table`, `diagram`, …) declared inside a page or another block, validated against its schema type."
}

term page {
  term       = "page"
  definition = "A `page` block: one rendered output page — an id, a title, the sites it joins via `sites`, and the content blocks that make up its body."
}

term site {
  term       = "site"
  definition = "A `site` block configuring one output target — its template, title, theme, and navigation; a document can declare several, each rendering into its own subdirectory."
}

term template {
  term       = "template"
  definition = "The shape a site's pages render into — `:webpage`, `:book`, `:presentation`, `:ai_skill`, or a custom `template` block mapping a TemplateCtx to HTML fundamentals."
}

term backend {
  term       = "backend"
  definition = "One of wdoc's output engines — HTML (`build`/`serve`), Markdown (`markdown`, and `skill` on top of it), or PDF (`pdf`) — all rendering the same document model."
}

term lowering {
  term       = "lowering"
  definition = "The recursive expansion of a high-level block into simpler blocks via its `<kind>_lower` function, repeated until only fundamentals remain for the renderer."
  aliases    = ["lower"]
}

term fundamental {
  term       = "fundamental"
  definition = "A primitive the renderer emits directly — an HTML, SVG, or terminal element — the fixed vocabulary every block ultimately lowers to."
}

term projection {
  term       = "projection"
  definition = "Rendering document content from a typed data model rather than hand-authored blocks — components, repeaters, and `body`/`project` derive the pages from the data."
}

term component {
  term       = "component"
  definition = "A `wdoc_component`: a reusable fragment of wdoc markup with named slots, instantiated by its own name anywhere a block is allowed."
}

term repeater {
  term       = "repeater"
  definition = "A `wdoc_repeater`: renders its body once per element of `each`, binding the element to the symbol named by `as` — the single iteration concept for blocks, pages, and nav entries."
}

term slot {
  term       = "slot"
  definition = "A `wdoc_slot` inside a component: a named, optionally-defaulted parameter filled at instantiation and referenced in the body via interpolation or bare identifiers."
}

term theme {
  term       = "theme"
  definition = "A site-wide palette selected with `theme = :<name>` — six ship (nord, tokyonight, gruvbox, catppuccin, rose, paper), each with dark and light variants."
}

term frontmatter {
  term       = "frontmatter"
  definition = "A schemaless `frontmatter` block of `key = value` entries serialized as a YAML header on a page's Markdown output; the HTML and PDF targets ignore it."
}
