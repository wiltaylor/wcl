// Indexes — the wskill's top-level navigation. Each top-level index is a menu
// section; its child indexes are sub-groups, and each sub-group's `related`
// units are projected directly: pinned into the sidebar (book) and listed
// (skill). No landing-page bodies — the units are the pages. Order is preserved.

index documents {
  name    = "Documents & Content"
  summary = "The document model (pages, sites, render targets) and the content blocks that fill a page."
  audience = :both

  index doc_model {
    name    = "The document model"
    summary = "How a document is structured and rendered."
    audience = :both
    related = [overview, sites, templates, pages, includes, visibility, markdown, skills, template_kinds, themes]
  }
  index content_blocks {
    name    = "Content blocks"
    summary = "What fills a page: prose, tables, lists, callouts, media."
    audience = :both
    related = [formatting, columns, tables_block, lists_block, callouts, math, icons, images, videos]
  }
  index doc_data_styling {
    name    = "Data & styling"
    audience = :both
    related = [data_views, styling]
  }
}

index diagrams_section {
  name    = "Diagrams"
  summary = "The diagram family: the SVG canvas, the auto-layout modes, and every higher-level shape — graphs, charts, maps, sprites, terminals and wireframes."
  audience = :both

  index dia_core {
    name    = "Canvas & layout"
    summary = "The drawing surface, its primitive shapes, connections, and auto-layout."
    audience = :both
    related = [diagrams, primitive_shapes, composite_shapes, shape_styling, connections, layout_modes]
  }
  index dia_graphs {
    name    = "Graphs & flow"
    summary = "Turn a connection graph into a ranked, routed picture."
    audience = :both
    related = [flowcharts, swimlanes, sequence_diagrams, state_diagrams, tree]
  }
  index dia_dataviz {
    name    = "Data visualisation"
    summary = "Plot values directly from WCL data."
    audience = :both
    related = [charts, timelines]
  }
  index dia_grids {
    name    = "Grids & sprites"
    summary = "Tiled, animated, or pinned content."
    audience = :both
    related = [tilemaps, dopesheets, maps]
  }
  index dia_term_ui {
    name    = "Terminal & UI"
    summary = "ANSI terminal grids and wireframe UI mockups."
    audience = :both
    related = [terminals, wireframe]
  }
}

index workflows {
  name    = "Task runbooks"
  summary = "Step-by-step procedures for rendering and reviewing wdoc output."
  audience = :both
  related = [build_serve, render_skill, render_pdf_markdown, render_presentation, review_comments]
}
