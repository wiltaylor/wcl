// Language — the wdoc schema, reflected. Each `feature` groups one family of
// block types; its body gives every type its own `h3` (the block keyword) and a
// `type_table` projected straight from the stdlib declaration, so the field /
// child-slot tables can't drift from the schema and pick up every `@doc("…")`
// description automatically.
//
// Mirrors the wcl wskill's opt-in `language` module, but populated by reflection
// instead of hand-authored `struct`s — the wdoc schema is too large (~118 block
// types) to copy by hand. Coverage is exhaustive: every `@block` type the stdlib
// declares appears under exactly one family. We use `type_table` per type rather
// than `block_reference` over the `Site` @document because most blocks are page
// content reached through the `WdocBlock` interface (not direct document slots),
// which `block_reference` can't enumerate. New stdlib blocks are added here under
// their family; the tables themselves always reflect the live declaration.

language wdoc {
  name     = "wdoc schema"
  version  = "0.24.1-alpha"
  audience = :both
  summary  = "Every wdoc block type, reflected from the stdlib — fields, child slots, and descriptions."
  body {
    p "The wdoc block vocabulary, family by family. Each heading is the keyword you write; its table is reflected directly from the schema with `type_table`, so it always matches the current declaration and surfaces every field's `@doc` description. The **Property** table lists scalar fields (name, type, whether required, description); a **Child blocks** table follows for any type that nests other blocks."
  }

  // --- Document & pages ------------------------------------------------------
  feature wl_document {
    name    = "Document & Pages"
    summary = "The document root, the page block, and multi-site / include configuration."
    body {
      h3 "Site (the document root)"
      p "The `@document` type. Its **Child blocks** table is the vocabulary legal at the top level of a document; each kind is detailed under its own family below."
      type_table { type = Site }

      h3 "page"
      type_table { type = Page }

      h3 "site"
      type_table { type = SiteConfig }

      h3 "include"
      type_table { type = IncludeSites }
    }
  }

  // --- Templates & navigation ------------------------------------------------
  feature wl_templates {
    name    = "Templates & Navigation"
    summary = "Custom templates and the per-template navigation blocks (menu, toc, deck) plus skill / file config."
    body {
      h3 "template"
      type_table { type = Template }

      h3 "menu"
      type_table { type = Menu }
      h3 "item"
      type_table { type = MenuItem }

      h3 "toc"
      type_table { type = Toc }
      h3 "chapter"
      type_table { type = Chapter }

      h3 "deck"
      type_table { type = Deck }
      h3 "section"
      type_table { type = DeckSectionBlock }
      h3 "slide"
      type_table { type = DeckSlideRef }

      h3 "fragment"
      type_table { type = Fragment }
      h3 "notes"
      type_table { type = Notes }

      h3 "skill"
      type_table { type = SkillConfig }

      h3 "frontmatter"
      type_table { type = Frontmatter }

      h3 "file"
      type_table { type = FileObj }
    }
  }

  // --- Styling & themes ------------------------------------------------------
  feature wl_styling {
    name    = "Styling & Themes"
    summary = "Class blocks, raw stylesheets, themes and palettes, and custom inline patterns."
    body {
      h3 "class"
      type_table { type = Class }
      h3 "dark"
      type_table { type = ClassMode }
      h3 "light"
      type_table { type = ClassModeLight }

      h3 "stylesheet"
      type_table { type = Stylesheet }

      h3 "theme"
      type_table { type = ThemeBlock }
      h3 "palette"
      type_table { type = PaletteBlock }

      h3 "inline_pattern"
      type_table { type = InlinePattern }
    }
  }

  // --- Text & formatting -----------------------------------------------------
  feature wl_text {
    name    = "Text & Formatting"
    summary = "Paragraphs, spans, headings, code listings, lists, and callouts."
    body {
      h3 "p"
      type_table { type = P }
      h3 "span"
      type_table { type = Span }
      h3 "text"
      type_table { type = Text }

      h3 "h1 – h6 (heading levels)"
      p "All six heading levels share the same fields; `h1` is shown (`h2`–`h6` are identical)."
      type_table { type = H1 }

      h3 "code"
      type_table { type = Code }

      h3 "list"
      type_table { type = ListBlock }
      h3 "li"
      type_table { type = Li }

      h3 "callout"
      type_table { type = Callout }
    }
  }

  // --- Tables, media & icons -------------------------------------------------
  feature wl_tables_media {
    name    = "Tables, Media & Icons"
    summary = "Tables, images, video, math, column layout, and the icon system."
    body {
      h3 "table"
      type_table { type = TableBlock }

      h3 "column"
      type_table { type = Column }

      h3 "image"
      type_table { type = Image }

      h3 "video"
      type_table { type = Video }

      h3 "math"
      type_table { type = Math }

      h3 "icon"
      type_table { type = Icon }
      h3 "iconset"
      type_table { type = IconSet }
      h3 "icon_def"
      type_table { type = IconDef }
    }
  }

  // --- Data views ------------------------------------------------------------
  feature wl_data_views {
    name    = "Data Views"
    summary = "Components, slots, repeaters, instances, partials, and addressable bodies / projection."
    body {
      h3 "wdoc_component"
      type_table { type = WdocComponent }
      h3 "wdoc_slot"
      type_table { type = WdocSlot }
      h3 "wdoc_body"
      type_table { type = WdocBody }
      h3 "wdoc_content"
      type_table { type = WdocContent }

      h3 "wdoc_repeater"
      type_table { type = WdocRepeater }
      h3 "wdoc_instance"
      type_table { type = WdocInstance }

      h3 "partial"
      type_table { type = WdocPartial }
      h3 "collect"
      type_table { type = WdocCollect }

      h3 "body"
      type_table { type = WdocAddressableBody }
      h3 "project"
      type_table { type = WdocProject }
    }
  }

  // --- Diagrams (parent: nested children below) ------------------------------
  feature wl_diagrams {
    name    = "Diagrams"
    summary = "The SVG canvas and everything drawn on it — primitives, graphs, and sequence / state diagrams."
    body {
      p "Every diagram is a `diagram` canvas holding shapes wired by `connections`. The shapes split into three families, each its own sub-page below."
    }

    feature wl_diagram_primitives {
      name    = "Primitives"
      summary = "The base shapes everything lowers to, plus the container, card, and node-table layout boxes."
      body {
        h3 "diagram"
        type_table { type = Diagram }

        h3 "rect"
        type_table { type = Rect }
        h3 "circle"
        type_table { type = Circle }
        h3 "line"
        type_table { type = Line }
        h3 "label"
        type_table { type = Label }
        h3 "polygon"
        type_table { type = Polygon }

        h3 "container"
        type_table { type = Container }

        h3 "card"
        type_table { type = Card }

        h3 "node_table"
        type_table { type = NodeTable }
        h3 "node_row"
        type_table { type = NodeRow }
      }
    }

    feature wl_diagram_graphs {
      name    = "Graphs & Flow"
      summary = "Flowchart node shapes, generic graph nodes, and indented file trees."
      body {
        h3 "process"
        type_table { type = Process }
        h3 "decision"
        type_table { type = Decision }
        h3 "terminator"
        type_table { type = Terminator }

        h3 "node (graph node)"
        type_table { type = GraphNode }

        h3 "tree"
        type_table { type = Tree }
        h3 "tree_node"
        type_table { type = TreeNode }
      }
    }

    feature wl_diagram_sequence {
      name    = "Sequence & State"
      summary = "Sequence diagrams (participants, messages, notes) and state diagrams (states, transitions)."
      body {
        h3 "sequence_diagram"
        type_table { type = SequenceDiagram }
        h3 "participant"
        type_table { type = Participant }
        h3 "message"
        type_table { type = Message }
        h3 "note"
        type_table { type = SeqNote }

        h3 "state_diagram"
        type_table { type = StateDiagram }
        h3 "state"
        type_table { type = State }
        h3 "transition"
        type_table { type = Transition }
      }
    }
  }

  // --- Charts & timelines ----------------------------------------------------
  feature wl_charts {
    name    = "Charts & Timelines"
    summary = "Bar / line / pie charts and the timeline block — value plots over WCL data."
    body {
      h3 "bar_chart"
      type_table { type = BarChart }
      h3 "line_chart"
      type_table { type = LineChart }
      h3 "pie_chart"
      type_table { type = PieChart }

      h3 "timeline"
      type_table { type = Timeline }
    }
  }

  // --- Maps, tilemaps & dopesheets -------------------------------------------
  feature wl_maps_tiles {
    name    = "Maps, Tilemaps & Dopesheets"
    summary = "Pinned maps, sprite tilemaps, and animation dopesheets."
    body {
      h3 "map"
      type_table { type = Map }
      h3 "layer"
      type_table { type = MapLayer }
      h3 "pin"
      type_table { type = MapPin }

      h3 "tileset"
      type_table { type = Tileset }
      h3 "tile"
      type_table { type = TileKey }
      h3 "tilemap"
      type_table { type = Tilemap }

      h3 "dopesheet"
      type_table { type = Dopesheet }
    }
  }

  // --- Terminals & TUI -------------------------------------------------------
  feature wl_terminals {
    name    = "Terminals & TUI"
    summary = "The ANSI terminal grid, its low-level cells, and the TUI widget set."
    body {
      h3 "terminal"
      type_table { type = Terminal }

      h3 "term_box"
      type_table { type = TermBox }
      h3 "term_text"
      type_table { type = TermText }
      h3 "term_fill"
      type_table { type = TermFill }
      h3 "term_glyph"
      type_table { type = TermGlyph }

      h3 "tui_panel"
      type_table { type = TuiPanel }
      h3 "tui_group"
      type_table { type = TuiGroup }
      h3 "tui_button"
      type_table { type = TuiButton }
      h3 "tui_checkbox"
      type_table { type = TuiCheckbox }
      h3 "tui_radio"
      type_table { type = TuiRadio }
      h3 "tui_input"
      type_table { type = TuiInput }
      h3 "tui_dropdown"
      type_table { type = TuiDropdown }
      h3 "tui_progress"
      type_table { type = TuiProgress }
      h3 "tui_spinner"
      type_table { type = TuiSpinner }
    }
  }

  // --- Wireframe -------------------------------------------------------------
  feature wl_wireframe {
    name    = "Wireframe"
    summary = "The `wf_*` widget family — UI mockup shapes that extend SvgBlock, placed and wired like diagram shapes."
    body {
      h3 "wf_window"
      type_table { type = WfWindow }
      h3 "wf_browser"
      type_table { type = WfBrowser }
      h3 "wf_phone"
      type_table { type = WfPhone }
      h3 "wf_tablet"
      type_table { type = WfTablet }

      h3 "wf_panel"
      type_table { type = WfPanel }
      h3 "wf_row"
      type_table { type = WfRow }
      h3 "wf_column"
      type_table { type = WfColumn }
      h3 "wf_grid"
      type_table { type = WfGrid }

      h3 "wf_button"
      type_table { type = WfButton }
      h3 "wf_input"
      type_table { type = WfInput }
      h3 "wf_checkbox"
      type_table { type = WfCheckbox }
      h3 "wf_radio"
      type_table { type = WfRadio }
      h3 "wf_toggle"
      type_table { type = WfToggle }
      h3 "wf_dropdown"
      type_table { type = WfDropdown }

      h3 "wf_label"
      type_table { type = WfLabel }
      h3 "wf_link"
      type_table { type = WfLink }
      h3 "wf_node_graph"
      type_table { type = WfNodeGraph }
      h3 "wf_node"
      type_table { type = WfNode }
    }
  }
}
