procedure render_skill {
  title = "Render a document into a Claude skill folder"
  purpose = "Project an `:ai_skill` site into a SKILL.md plus references/, scripts/, and assets/."
  preconditions = ["A `site` with `default_template = :ai_skill` and a `skill { }` block", "A page marked `start = true`"]
  related = [skills, sites]
  audience = :both

  step 1 {
    title = "Run the skill target"
    body screen { code "console" { source = <<'SH'
$ wcl wdoc skill site.wcl --out out/skill
SH
    } }
    body steps { p "Render the document to a skill folder under `out/skill`. The output directory is created if missing; with several skill sites, each renders into its own `out/skill/<name>/` subfolder." }
  }

  step 2 {
    title = "Inspect the folder layout"
    body screen { code "console" { source = <<'SH'
$ ls -R out/skill
SKILL.md  references  scripts  assets

out/skill/references:
usage.md
SH
    } }
    body steps { p "The `start` page becomes `SKILL.md` at the root with its front matter from the `skill { }` block; every other page is written under `references/<name>.md`; and each `file` block ships into the subfolder named by its `dir` (`scripts/`, `assets/`)." }
  }

  step 3 {
    title = "Check it builds as a skill, not HTML"
    body screen { callout "Use the skill target" {
      class = ["warning"]
      body = "Running `wcl wdoc build` on an `:ai_skill` site fails with a message pointing you at `wcl wdoc skill` — `:ai_skill` is a Markdown-only target."
    } }
    body steps { p "If `wcl wdoc build` errors on this site, that is expected: skill sites only render through `wcl wdoc skill`." }
  }

  verification = "`out/skill/SKILL.md` exists with name/description front matter, and the non-start pages appear under `out/skill/references/`."
}
