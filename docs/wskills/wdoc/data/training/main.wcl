# The training view's course — "wdoc authoring tutorial" (`<wskill/training.wcl>`).
# Ordered lessons with hands-on exercises; `related` links each lesson back to
# the reference units it teaches.

lesson first_page {
  n = 1
  title = "Your first page"
  summary = "Write a minimal wdoc page and preview it with the dev server."
  objectives = ["Write a one-page wdoc document from scratch", "Build it to HTML with `wcl wdoc build`", "Iterate under `wcl wdoc serve` with live rebuilds"]
  related = []
  body {
    p <<DOC
      Every wdoc document is a `.wcl` file that starts with `import <wdoc.wcl>` — that import brings
      in the whole block vocabulary. The smallest useful document is a single `page` holding content
      blocks: a heading, a paragraph, whatever the page needs. `start = true` marks the entry page.
    DOC
    p <<DOC
      Two commands cover the whole authoring loop: `wcl wdoc build <file> --out <dir>` renders the
      HTML once, and `wcl wdoc serve <file>` starts a dev server that watches the source and
      re-renders on save.
    DOC
  }
  exercise hello_page {
    title = "Hello, wdoc"
    task = "Create `hello.wcl` with one page, build it, then serve it and edit the paragraph while watching the browser."
    code_lang = "bash"
    code = <<DOC
      cat > hello.wcl <<'WCL'
      import <wdoc.wcl>

      page index { start = true
        h1 "Hello wdoc"
        p "My **first** page, with _italic_ and `code`."
      }
      WCL
      wcl wdoc build hello.wcl --out out
      wcl wdoc serve hello.wcl
    DOC
    expected = "`out/index.html` renders the heading and formatted paragraph, and under `serve` a saved edit shows up after a browser refresh."
    hint = "No `site` block is needed yet — a lone page renders standalone. Sites arrive in the next lesson."
  }
  check what_the_import_does {
    prompt = "What does `import <wdoc.wcl>` at the top of a document do?"
    related = [overview, pages]
    choice vocabulary {
      label = "Brings in the whole wdoc block vocabulary"
      correct = true
      note = "Right — `page`, `h1`, `p`, `diagram` and the rest all arrive with that one line."
    }
    choice output_dir {
      label = "Tells the build where to write the output"
      note = "The output directory comes from `--out` on the command line."
    }
    choice theme {
      label = "Applies the default theme"
      note = "Theming is a `site` field; the import is about vocabulary."
    }
    explanation = "It is an angle-bracket system import: the host registers wdoc's stdlib, so the document opts into every block kind at once."
  }
  check build_versus_serve {
    prompt = "When would you reach for `wcl wdoc serve` instead of `wcl wdoc build`?"
    kind = :text
    rubric = "A good answer frames it as the authoring loop versus the finished artefact: `serve` watches the source and re-renders as you edit, so it is what you keep open while writing, while `build` renders once into a directory you can publish or inspect. Both consume the same document, so nothing about the output differs in kind."
    related = [build_serve]
  }
}

lesson book_site {
  n = 2
  title = "A book site and its table of contents"
  summary = "Group pages into a `site`, pick the `:book` template, and wire the sidebar with `toc`."
  objectives = ["Declare a `site` and join pages to it via `sites`", "Select a template with `default_template`", "Build a nested sidebar with `toc` chapters and mark the start page"]
  prerequisites = [first_page]
  related = [sites, pages]
  body {
    p <<DOC
      A `site` block configures one output target: its template, title, theme, and navigation. Each
      page joins one or more sites through its `sites` field, and cross-page links are
      markdown-style — `[text](page_name)` — validated at build time, so a renamed page can't
      silently break navigation.
    DOC
    p <<DOC
      The `:book` template reads a `toc` block off the site: `chapter`s nest to any depth, a chapter
      without `page =` is a grouping heading, and a chapter pointing at an unknown page is a build
      error.
    DOC
  }
  exercise build_a_book {
    title = "A two-page book"
    task = "Turn your document into a `:book` site with a nested table of contents and a link between the pages."
    code_lang = "wcl"
    code = <<DOC
      import <wdoc.wcl>

      site docs {
        default_template = :book
        title            = "Project Docs"
        toc {
          chapter "Intro" { page = index }
          chapter "Guide" {
            chapter "Setup" { page = setup }
          }
        }
      }

      page index { sites = [:docs]  start = true
        h1 "Project docs"
        p "Start with the [setup guide](setup)."
      }

      page setup { sites = [:docs]
        h1 "Setup"
        p "Back to the [intro](index)."
      }
    DOC
    expected = "The build renders a fixed left sidebar with an Intro chapter and a Guide group containing Setup, and the in-page links navigate between the two pages."
    hint = "If the build fails with an unknown-page error, the `toc` or a link names a page id that doesn't exist — page ids, not titles, are the link targets."
  }
  check broken_page_link {
    prompt = "You rename a page but leave a `[text](old_name)` link pointing at the old name. What happens?"
    related = [sites, pages]
    choice build_error {
      label = "The build fails — page links are validated"
      correct = true
      note = "Right — cross-page links are checked at build time, so navigation cannot silently rot."
    }
    choice dead_link {
      label = "It builds, and the link 404s for readers"
      note = "That is the failure mode wdoc's validation exists to prevent."
    }
    choice auto_fix {
      label = "The link is repaired automatically"
      note = "wdoc reports the problem rather than guessing what you meant."
    }
    explanation = "The same rule covers a `toc` chapter pointing at an unknown page — both are build errors, not warnings."
  }
  check chapter_without_page {
    prompt = "A `chapter` in a `toc` can omit `page =`. What is such a chapter for?"
    kind = :text
    rubric = "A good answer says it is a grouping heading: it organises the nested chapters under it without being a destination of its own. That lets the sidebar express structure — sections that exist only to group — separately from the pages that actually render."
    related = [sites, templates]
  }
}

lesson everyday_formatting {
  n = 3
  title = "Formatting, callouts, and columns"
  summary = "The everyday blocks: inline patterns, admonition callouts, and side-by-side layout."
  objectives = ["Use the inline patterns in any paragraph, cell, or list item", "Pick the right callout class for an admonition", "Lay content out side by side with `column` and `widths`"]
  prerequisites = [book_site]
  related = [formatting, callouts, columns]
  body {
    p <<DOC
      Inline patterns light up automatically wherever prose renders: `**bold**`, `_italic_`
      (underscores, not asterisks), backtick code, `[text](page)` links, `:lucide.check:` icons, and
      `$x^2$` math. A `text` block assembles one paragraph from `span`s in source order, and takes a
      `class` of its own.
    DOC
    p <<DOC
      A `callout` is an admonition with an icon and a coloured heading — six built-in classes:
      `note`, `info`, `tip`, `warning`, `error`, `success`. A `column` block lays its children side
      by side; `widths` gives one CSS percentage per child, summing to about 100.
    DOC
  }
  exercise formatted_page {
    title = "A formatted page"
    task = "Add a page using at least three inline patterns, two differently-classed callouts, and a two-column layout."
    code_lang = "wcl"
    code = <<DOC
      page style_tour { sites = [:docs]
        h1 "Style tour"
        p "Mix **bold**, _italic_, `code`, and an icon :lucide.check: in one line."
        callout "Tip"     { class = ["tip"]      body = "A helpful shortcut or best practice." }
        callout "Warning" { class = ["warning"]  body = "Something to be careful about." }
        column {
          widths = [50.0, 50.0]
          p "**Left.** The first child fills the first slot."
          p "**Right.** The second child fills the other half."
        }
      }
    DOC
    expected = "The page shows the styled inline segments, two callouts with distinct accent colours and icons, and two paragraphs sitting side by side."
    hint = "Italic is `_underscores_` — asterisk pairs only mean bold. One `widths` entry per column child."
  }
  check italic_syntax {
    prompt = "Which inline pattern makes text italic?"
    related = [formatting]
    choice underscores {
      label = "`_italic_` — underscores"
      correct = true
      note = "Right — wdoc uses underscores for italic, not single asterisks."
    }
    choice single_star {
      label = "`*italic*` — single asterisks"
      note = "Asterisks are the bold pattern in doubled form; single asterisks are not the italic marker here."
    }
    choice backticks {
      label = "`` `italic` `` — backticks"
      note = "Backticks render inline code."
    }
    explanation = "Inline patterns light up automatically wherever prose renders — in paragraphs, table cells, list items and callout bodies alike."
  }
  check text_block_versus_p {
    prompt = "When does a `text` block earn its keep over a plain `p`?"
    kind = :text
    rubric = "A good answer says a `p` is one run of prose with inline patterns, while a `text` block assembles one paragraph out of several `span`s run together in source order — so it is what you reach for when a paragraph is composed from parts (a label plus computed segments, say) rather than written as one string."
    related = [formatting]
  }
}

lesson tables_and_lists {
  n = 4
  title = "Tables and lists"
  summary = "Pipe-row tables and nestable lists — with inline patterns inside every cell and item."
  objectives = ["Author a `table` with WCL's native pipe-row syntax", "Build bulleted and numbered `list`s and nest sublists"]
  prerequisites = [everyday_formatting]
  related = [tables_block]
  body {
    p <<DOC
      A `table { rows: | … | }` uses WCL's pipe-row syntax: the first row becomes the header, the
      rest the body. Cells are expressions — `utf8` cells run through the inline-pattern engine, so
      bold, links, and icons work inside them; numbers and booleans stringify.
    DOC
    p <<DOC
      A `list` holds `li` items and is bulleted by default; `style = :numbered` numbers it. Nest an
      `li` inside an `li` for a sublist that inherits the style (numbered lists number
      hierarchically: 2.1, 2.2); drop a whole `list` block inside an `li` for a sublist with a
      different style.
    DOC
  }
  exercise table_and_list {
    title = "A roster and a runbook"
    task = "Add a table with a formatted cell and a numbered list with a nested sublist."
    code_lang = "wcl"
    code = <<DOC
      page roster { sites = [:docs]
        h1 "Roster"
        table {
          rows:
            | "Name"  | "Role"    | "Years" |
            | "Alice" | "**Dev**" | 3       |
            | "Bob"   | "_Ops_"   | 5       |
        }
        list { style = :numbered
          li "Setup"
          li "Build" {
            li "Compile"
            li "Link"
          }
        }
      }
    DOC
    expected = "The table renders with a header row and a bold **Dev** cell, and the list numbers the sublist hierarchically (2.1, 2.2)."
    hint = "A literal pipe inside an unquoted cell splits the row — wrap any cell containing a pipe in a string literal."
  }
  check table_header_row {
    prompt = "In a `table { rows: | … | }`, which row becomes the header?"
    related = [tables_block]
    choice first {
      label = "The first row"
      correct = true
      note = "Right — the first pipe-row is the header and the rest are the body."
    }
    choice marked {
      label = "Whichever row is marked `header = true`"
      note = "No marker is needed; position decides."
    }
    choice none {
      label = "None — every row is a body row"
      note = "That would leave the columns unlabelled."
    }
    explanation = "Cells are expressions, so a `utf8` cell runs through the inline-pattern engine — bold, links and icons all work inside a table."
  }
  check two_ways_to_nest {
    prompt = "You can nest an `li` inside an `li`, or drop a whole `list` block inside an `li`. When does the difference matter?"
    kind = :text
    rubric = "A good answer explains that a nested `li` inherits the parent list's style — which is what you want for hierarchical numbering like 2.1, 2.2 — whereas an inner `list` block starts a list with its own style, so it is how you put a bulleted sublist inside a numbered one."
    related = [lists_block]
  }
}

lesson images_and_assets {
  n = 5
  title = "Images and assets"
  summary = "Embed images on pages and in diagrams, and understand how assets ship with the build."
  objectives = ["Embed an `image` with alt text and an explicit size", "Explain where copied assets land in the output tree", "Drop inline icons into prose"]
  prerequisites = [everyday_formatting]
  related = [images, icons]
  body {
    p <<DOC
      An `image` block takes its source path as the inline label, resolved relative to the build
      entry file; the file is copied into `_wdoc/` at build time so the output site is
      self-contained. Set `width` / `height` to size it and `alt` for accessibility. Because the
      copy is referenced by a relative URL, it resolves when the site is served — not when a page is
      opened directly from disk.
    DOC
    p <<DOC
      Icons need no asset at all: `:pack.name:` (for example `:lucide.rocket:`) drops a glyph inline
      anywhere prose renders. An `image` is also a placeable diagram shape, positioned by `x` / `y`
      next to rects and circles.
    DOC
  }
  exercise add_an_image {
    title = "Ship a screenshot"
    task = "Add an image to a page with alt text and a fixed width, build, and find the copied file in the output."
    code_lang = "wcl"
    code = <<DOC
      page media { sites = [:docs]
        h1 "Media"
        p "The dashboard :lucide.gauge: looks like this:"
        image "assets/dashboard.png" {
          alt   = "The dashboard on first boot"
          width = 480.0
        }
      }
    DOC
    expected = "The build copies the file under `out/_wdoc/`, and the page shows the image at 480px with the icon inline in the paragraph."
    hint = "The path is relative to the entry `.wcl` file you build, not to the file the block sits in."
  }
  check where_images_go {
    prompt = "What happens to an image file at build time?"
    related = [images]
    choice copied {
      label = "It is copied into `_wdoc/` and referenced by a relative URL"
      correct = true
      note = "Right — that is what makes the output site self-contained."
    }
    choice inlined {
      label = "It is inlined into the HTML as a data URI"
      note = "Inlining every asset would bloat each page that used it."
    }
    choice left {
      label = "It is left where it is and linked by absolute path"
      note = "The output would then depend on the source tree still being present."
    }
    explanation = "Because the copy is referenced relatively, it resolves when the site is served — not when a page is opened directly from disk."
  }
  check icons_need_no_asset {
    prompt = "Icons need no asset file at all, unlike images. What does that difference mean for how you use each?"
    kind = :text
    rubric = "A good answer notes that an icon is a glyph resolved from a pack by name (`:lucide.rocket:`) and drops inline anywhere prose renders, so it is free to sprinkle through text; an image is a real file that must exist, be copied, and be sized and given alt text. So icons suit decoration and inline signalling, images suit actual content like screenshots and diagrams."
    related = [images, icons]
  }
}

lesson first_diagram {
  n = 6
  title = "Your first diagram"
  summary = "Shapes on a canvas, `a -> b` connections, and letting the layered layout place a flowchart."
  objectives = ["Place primitive shapes on a sized `diagram` canvas", "Connect shapes by id with `a -> b` edges", "Switch on `:layered` auto-layout for a flowchart"]
  prerequisites = [book_site]
  related = [diagrams, primitive_shapes, connections, flowcharts]
  body {
    p <<DOC
      A `diagram` is the drawing surface: it declares a `width` / `height` and holds shapes that
      render as SVG. Give shapes an `id` and wire them with `a -> b` edge statements. With no layout
      set you position shapes yourself via `x` / `y`.
    DOC
    p <<DOC
      Flowcharts come from three stdlib shapes — `process` (rectangle), `decision` (diamond),
      `terminator` (oval) — plus `layout = :layered`, which ranks the connection graph topologically
      and elbow-routes the edges, so you omit the coordinates entirely.
    DOC
  }
  exercise flowchart {
    title = "An auto-laid flowchart"
    task = "Draw a three-node flowchart and let the layered layout place it — no x/y on any shape."
    code_lang = "wcl"
    code = <<DOC
      page flow { sites = [:docs]
        h1 "Build flow"
        diagram {
          width = 320  height = 220  layout = :layered  layer_gap = 20.0

          process    "Parse"  { id = parse   width = 100.0  height = 40.0 }
          decision   "Valid?" { id = valid   width = 100.0  height = 60.0 }
          terminator "Render" { id = render  width = 100.0  height = 40.0 }

          parse -> valid  :flow
          valid -> render :flow
        }
      }
    DOC
    expected = "The three shapes stack in ranked layers with elbow-routed arrows between them, without any hand-placed coordinates."
    hint = "Edges reference shape `id`s. If everything piles up at the origin, the `layout = :layered` line is missing."
  }
  check layered_layout {
    prompt = "You set `layout = :layered` on a diagram. What can you now leave out?"
    related = [diagrams, layout_modes, flowcharts]
    choice coordinates {
      label = "The `x` / `y` on every shape"
      correct = true
      note = "Right — the layout ranks the connection graph and places the shapes for you."
    }
    choice ids {
      label = "The shape `id`s"
      note = "Ids are what the `a -> b` edges refer to, so they are still required."
    }
    choice edges {
      label = "The `a -> b` edge statements"
      note = "The edges ARE the input to the layout — without them there is no graph to rank."
    }
    explanation = "Manual placement stays available: with no layout set you position shapes yourself with `x` / `y`."
  }
  check three_flowchart_shapes {
    prompt = "Flowcharts use `process`, `decision`, and `terminator`. Why do these exist as distinct shapes rather than one rectangle with a label?"
    kind = :text
    rubric = "A good answer says the shapes carry conventional meaning a reader already knows — a rectangle is a step, a diamond is a branch, an oval is a start or end — so the diagram is readable at a glance without a legend. Encoding that in the vocabulary also means the author states intent and the renderer handles the geometry."
    related = [flowcharts, primitive_shapes]
  }
}

lesson charts_from_data {
  n = 7
  title = "Charts and timelines from data"
  summary = "Plot series data with `bar_chart` and put real dates on a `timeline` — both inside a `diagram`."
  objectives = ["Plot grouped series with `bar_chart` categories and series records", "Lay events and phases on a real-calendar `timeline`"]
  prerequisites = [first_diagram]
  related = [charts, timelines, diagrams]
  body {
    p <<DOC
      The chart kinds — `bar_chart`, `line_chart`, `pie_chart` — are diagram shapes, so each sits
      inside a `diagram` sharing its size. Bar and line charts take a `series` list of
      `{ name, values }` records with `categories` labelling the x-axis; a pie takes `slices` of
      `{ label, value }`. Bare `{ … }` records are enough — the variant is inferred from the shape.
    DOC
    p <<DOC
      A `timeline` is a real-time axis: dates are ISO strings, a `unit` (`:minutes` … `:years`) sets
      the tick granularity, `items` are point events, and `phases` are labelled spans drawn as
      bands.
    DOC
  }
  exercise plot_the_quarter {
    title = "A chart and a roadmap"
    task = "Plot two series over four quarters, then lay a kickoff and a release on a year-long timeline with one phase."
    code_lang = "wcl"
    code = <<DOC
      page metrics { sites = [:docs]
        h1 "Metrics"
        diagram { width = 360  height = 200
          bar_chart { width = 360.0  height = 200.0
            title = "Revenue"  x_label = "Quarter"  y_label = "$k"
            categories = ["Q1", "Q2", "Q3", "Q4"]
            series = [
              { name: "2025", values: [42.0, 55.0, 61.0, 78.0] },
              { name: "2026", values: [30.0, 48.0, 52.0, 66.0] },
            ]
          }
        }
        diagram { width = 560  height = 220
          timeline { width = 560.0  height = 220.0
            title = "2026 roadmap"
            start = "2026-01-01"
            end   = "2026-12-31"
            unit  = :months
            items = [
              { label: "Kickoff", on: "2026-02-20" },
              { label: "Release", on: "2026-09-20" },
            ]
            phases = [ { label: "Build", from: "2026-02-01", to: "2026-06-15" } ]
          }
        }
      }
    DOC
    expected = "The bar chart shows grouped pairs per quarter with a legend, and the timeline places both events on real month boundaries with the Build band beneath."
    hint = "Chart values are floats (`42.0`, not `42`), and the chart's own `width`/`height` should match the surrounding diagram's."
  }
  check charts_live_in_diagrams {
    prompt = "Where does a `bar_chart` block go?"
    related = [charts, diagrams]
    choice inside_diagram {
      label = "Inside a `diagram`, whose size it shares"
      correct = true
      note = "Right — the chart kinds are diagram shapes, not page blocks."
    }
    choice page_level {
      label = "Directly on the page, like a `table`"
      note = "Charts draw SVG, so they live on a drawing surface."
    }
    choice inside_column {
      label = "Inside a `column`, which sizes it"
      note = "A column lays out children side by side; it is not a canvas."
    }
    explanation = "Because they are shapes, charts compose with the rest of the diagram vocabulary rather than being a special page-level case."
  }
  check bare_records_infer {
    prompt = "Chart series are written as bare `{ name: …, values: … }` records with no variant named. How does that work, and what happens if the shape is wrong?"
    kind = :text
    rubric = "A good answer explains that a bare record coerces to the matching union variant BY SHAPE when the declared type is a union, so the author writes the data and the variant is inferred. If no variant matches the record's shape the coercion fails and validation reports it, rather than silently picking the wrong one."
    related = [charts]
  }
}

lesson components_and_repeaters {
  n = 8
  title = "Components and repeaters"
  summary = "Declare data once, then stamp markup from it with `wdoc_component`, slots, and `wdoc_repeater`."
  objectives = ["Declare a `wdoc_component` with defaulted `wdoc_slot`s", "Fill slots via interpolated strings and bare field references", "Stamp one instance per data row with `wdoc_repeater`"]
  prerequisites = [book_site]
  related = []
  body {
    p <<DOC
      A component is a reusable fragment of ordinary wdoc markup with named slots: declare
      `wdoc_slot`s and a `wdoc_body`, then instantiate the component by its own name anywhere a
      block is allowed. Slot values land in text through `$"…${slot}…"` interpolated strings; bare
      references (like `class = [status]`) need no prefix. A slot with a `default` is optional at
      the call site.
    DOC
    p <<DOC
      A `wdoc_repeater` renders its body once per element of `each`, binding the element to the
      symbol named by `as` — combined with a component it stamps one card per data row. The same
      repeater emits pages at the document root and `chapter`s inside a `toc`, so navigation can be
      data-driven too.
    DOC
  }
  exercise metric_cards {
    title = "One card per metric"
    task = "Declare a metric-card component and a data list, then render one card per row with a repeater."
    code_lang = "wcl"
    code = <<DOC
      let metrics = [
        { name: "CPU",    pct: 42, sev: "warning" },
        { name: "Memory", pct: 88, sev: "error" },
      ]

      wdoc_component metric_card {
        wdoc_slot label
        wdoc_slot value
        wdoc_slot status { default = "note" }
        wdoc_body {
          callout $"${label}" { class = [status]  body = $"Currently at **${value}%**" }
        }
      }

      page health { sites = [:docs]
        h1 "Health"
        wdoc_repeater { each = metrics  as = :m
          metric_card { label = m.name  value = m.pct  status = m.sev }
        }
      }
    DOC
    expected = "The page shows one callout per data row — a warning-coloured CPU card and an error-coloured Memory card — with the values interpolated into the bodies."
    hint = "Interpolated strings need the `$` prefix; a plain `\"…\"` renders `${…}` literally."
  }
  check slot_with_default {
    prompt = "A `wdoc_slot` is declared with a `default`. What does that change at the call site?"
    related = [data_views]
    choice optional {
      label = "The slot becomes optional"
      correct = true
      note = "Right — omit it and the default is used, exactly like `@default` on a schema field."
    }
    choice constant {
      label = "The slot becomes a constant that cannot be overridden"
      note = "A default is a fallback, not a lock."
    }
    choice required_first {
      label = "The slot must be passed first, before the others"
      note = "Slots are passed by name; order is free."
    }
    explanation = "Components are ordinary wdoc markup with named holes — the slot rules mirror the schema rules you already know."
  }
  check repeater_reach {
    prompt = "The same `wdoc_repeater` emits pages at the document root and `chapter`s inside a `toc`. Why is that worth knowing?"
    kind = :text
    rubric = "A good answer draws the conclusion that navigation can be data-driven too: the same list that generates one page per record can generate the sidebar entries for them, so adding a record adds both its page and its nav entry with no hand-maintained second list to fall out of sync."
    related = [data_views]
  }
}

lesson bodies_and_projection {
  n = 9
  title = "Addressable bodies and projection"
  summary = "Attach renderable content to your own typed data records and render it elsewhere with `project` — the wskill mechanism."
  objectives = ["Declare a custom `@block` type with a `@child(\"body\")` content slot", "Gather instances with a merging `@document`", "Render each record's body by reference with `project`"]
  prerequisites = [components_and_repeaters]
  related = []
  body {
    p <<DOC
      A `body` attaches a chunk of renderable content to a **data record** as a property — the
      record itself is not a renderable block. Declare your own `@block` type with a
      `@child("body") … : WdocAddressableBody?` slot, plus a merging `@document` so the document
      gathers the instances into a list your pages can repeat over.
    DOC
    p <<DOC
      A `project { from = record.body }` then renders *that* record's fragment wherever the
      projection needs it; `${…}` inside the body resolves against the record. A body never renders
      where it is declared, only where projected. This body/project pattern is exactly how a
      wskill's book projects its concept and fact pages.
    DOC
  }
  exercise server_fleet {
    title = "A projected fleet page"
    task = "Declare a `server` block carrying a body, author two servers, and project each body onto a fleet page."
    code_lang = "wcl"
    code = <<DOC
      import <wdoc.wcl>

      @block("server")
      type Server {
        @inline(0) name: identifier
        region: utf8?
        @child("body") overview: WdocAddressableBody?
      }

      @document
      type FleetDoc {
        @children("server") servers: list<Server>
      }

      server web01 { region = "us-east"
        body { p $"Frontend in ${region}." }
      }

      server web02 { region = "eu-west"
        body { p $"Frontend in ${region}." }
      }

      page fleet { start = true
        h1 "Fleet"
        wdoc_repeater { each = servers  as = :s
          h2 $"${s.name}"
          project { from = s.overview }
        }
      }
    DOC
    expected = "The fleet page shows an h2 per server followed by its projected body — each paragraph naming its own region."
    hint = "Your own `@document` merges with wdoc's, so `page` blocks stay legal alongside `server`. The single `@child(\"body\")` slot means the body needs no name."
  }
  check where_a_body_renders {
    prompt = "You attach a `body` to a data record. Where does it render?"
    related = [data_views]
    choice only_projected {
      label = "Only where a `project` renders it"
      correct = true
      note = "Right — a body never renders where it is declared; the record is data, not a renderable block."
    }
    choice in_place {
      label = "In place, where the record is declared"
      note = "That would make every data file a page, which is exactly what this pattern avoids."
    }
    choice both {
      label = "Both in place and wherever it is projected"
      note = "It would then render twice in any document that projects it."
    }
    explanation = "This body/project split is precisely how a wskill's book turns concept and fact records into pages."
  }
  check why_separate_data_from_page {
    prompt = "What do you gain by keeping content on typed data records and projecting it, rather than writing the pages directly?"
    kind = :text
    rubric = "A good answer says the content becomes structured data that can be validated, queried, repeated over, and projected into MORE than one place — several views of one model — while a hand-written page is a single fixed output. It should connect this to the wskill case, where one set of records renders a book, a skill, and a course."
    related = [data_views]
  }
}

lesson render_targets {
  n = 10
  title = "Render targets"
  summary = "One model, four outputs: HTML, Markdown, a skill folder, and PDF."
  objectives = ["Render the same document to HTML, Markdown, and PDF", "Project an `:ai_skill` site into a skill folder", "Pick a single site out of a multi-site document with `--site`"]
  prerequisites = [book_site]
  related = [markdown]
  body {
    p <<DOC
      The render targets all consume the same document: `wcl wdoc build` writes HTML, `markdown`
      writes one `.md` per page (diagrams become static `.svg` files it references), and `pdf`
      writes a paginated, pure-Rust PDF per site. When a document declares several sites,
      `--site <name>` renders just one.
    DOC
    p <<DOC
      The fourth target is the skill folder: a site with `default_template = :ai_skill` and a
      `skill { }` block (its `name` and `description` become SKILL.md front matter) renders through
      `wcl wdoc skill` — the `start` page becomes `SKILL.md` and every other page lands under
      `references/`. Running `build` on a skill site is an error that points you at the right
      command.
    DOC
  }
  exercise render_all {
    title = "Render everything"
    task = "Render your book to HTML, Markdown, and PDF, then add a minimal `:ai_skill` site and render the skill folder."
    code_lang = "bash"
    code = <<DOC
      wcl wdoc build    docs.wcl --out out/html
      wcl wdoc markdown docs.wcl --out out/md
      wcl wdoc pdf      docs.wcl --out out/pdf
      # after adding:  site helper { default_template = :ai_skill
      #                  skill { name = "docs-helper"  description = "When to use this skill." } }
      wcl wdoc skill docs.wcl --out out/skill --site helper
    DOC
    expected = "`out/html` holds the site, `out/md` one `.md` per page with `.svg` diagram assets, `out/pdf` a paginated PDF, and `out/skill/SKILL.md` carries the name/description front matter."
    hint = "The skill site needs a page marked `start = true` — that page becomes SKILL.md itself."
  }
  check building_a_skill_site {
    prompt = "You run `wcl wdoc build` on a site whose `default_template = :ai_skill`. What happens?"
    related = [render_skill, skills]
    choice error {
      label = "An error that points you at `wcl wdoc skill`"
      correct = true
      note = "Right — the mistake is caught and named rather than producing wrong output."
    }
    choice html {
      label = "It renders as ordinary HTML"
      note = "A skill folder is a different artefact shape, not an HTML site."
    }
    choice ignored {
      label = "The site is skipped and the others build"
      note = "Silently skipping would leave you wondering where the output went."
    }
    explanation = "In a skill folder the `start` page becomes `SKILL.md` and every other page lands under `references/`."
  }
  check one_model_four_outputs {
    prompt = "All four targets consume the same document. What does that buy an author, and where does it stop being free?"
    kind = :text
    rubric = "A good answer says content is written once and rendered as HTML, Markdown, PDF and a skill folder, so the versions cannot drift apart. It should also acknowledge the limit: the targets are genuinely different media, so some blocks do not translate — diagrams become static images in Markdown, interactive affordances have no meaning in print — which is why the visibility axes exist to scope blocks per backend."
    related = [render_pdf_markdown, markdown]
  }
}

lesson visibility_and_themes {
  n = 11
  title = "Visibility and themes"
  summary = "Scope blocks per site, template, or backend with `@only` / `@except`, and restyle a whole site in one line."
  objectives = ["Scope a block to a subset of the build with `@only` / `@except`", "Switch a site's palette with `theme` and add a light/dark toggle"]
  prerequisites = [render_targets]
  related = [visibility, themes, styling]
  body {
    p <<DOC
      Any block can carry `@only(...)` or `@except(...)` to scope it by three axes: `sites` (site
      names), `templates` (`:webpage` / `:book` / `:presentation`), and `backends` (`:html` / `:pdf`
      / `:markdown` / `:skill`). `@only` renders the block only where the conditions match;
      `@except` everywhere else. This is how one document serves a web build and a print PDF without
      forking content.
    DOC
    p <<DOC
      Themes recolour the whole site in one line: `theme = :forge` (the default, or `nord`,
      `tokyonight`, `gruvbox`, `catppuccin`, `rose`, `paper`), each with dark and light variants —
      add `theme_toggle = true` for the switcher button. Local styling stays available through
      `class` blocks, which always win over theme defaults.
    DOC
  }
  exercise scope_and_style {
    title = "A print-aware, themed page"
    task = "Theme your site, then add one block that skips the PDF and one that renders only in it."
    code_lang = "wcl"
    code = <<DOC
      site docs {
        default_template = :book
        title            = "Project Docs"
        theme            = :gruvbox
        theme_toggle     = true
        toc { chapter "Intro" { page = index } }
      }

      page index { sites = [:docs]  start = true
        h1 "Project docs"
        @except(backends=[:pdf]) video { src = "demo.mp4" }
        @only(backends=[:pdf])   p "See the online docs for the screencast."
      }
    DOC
    expected = "The HTML build shows the video and the theme toggle in gruvbox colours; the PDF drops the video and prints the fallback sentence instead."
    hint = "Both decorators take the same three list arguments — an empty axis matches everything."
  }
  check visibility_axes {
    prompt = "Which axes can `@only` / `@except` scope a block by?"
    kind = :multi
    related = [visibility]
    choice sites {
      label = "`sites` — site names"
      correct = true
      note = "Yes — the axis that lets one document serve several sites."
    }
    choice templates {
      label = "`templates` — `:webpage` / `:book` / `:presentation`"
      correct = true
      note = "Yes — scope by the layout a page renders under."
    }
    choice backends {
      label = "`backends` — `:html` / `:pdf` / `:markdown` / `:skill`"
      correct = true
      note = "Yes — this is how a web build and a print PDF diverge without forking content."
    }
    choice themes {
      label = "`themes` — the active colour theme"
      note = "Themes recolour a site; they are not a visibility axis."
    }
    explanation = "Three axes, two decorators: `@only` renders a block just where the conditions match, `@except` everywhere else."
  }
  check theme_versus_class {
    prompt = "Themes restyle a whole site in one line, and `class` blocks always win over theme defaults. How should you use each?"
    kind = :text
    rubric = "A good answer treats the theme as the site-wide baseline — one line picks a coherent palette with dark and light variants — and `class` as the targeted override for the few places that genuinely need to differ. Reaching for local styling first would fight the theme everywhere and lose the coherence the theme exists to provide."
    related = [themes, styling]
  }
}

lesson review_loop {
  n = 12
  title = "The review loop"
  summary = "Pin comments on the served site, work through them from the CLI, and hand off rounds with the review handshake."
  objectives = ["Review a rendered site from the wcl editor preview pane", "List and resolve comments from the CLI", "Run the agent-side `wcl wdoc review` wait"]
  prerequisites = [render_targets]
  related = []
  body {
    p <<DOC
      The `wcl editor` preview pane carries a review client on every rendered page: pick any block
      from the comment menu to pin a note on it. Comments land in a `comments.wcl` sidecar beside
      the document — keyed by page and locator — and never trigger a rebuild, so reviewing stays
      non-destructive.
    DOC
    p <<DOC
      From the CLI, `wcl wdoc comments .` lists every open note and `comments . resolve <id>` closes
      one. For human⇄agent rounds, the agent runs `wcl wdoc review <file>`: it blocks until the
      reviewer clicks "Send to agent" in the preview pane, then prints that round's comments for the
      agent to work through.
    DOC
  }
  exercise one_round {
    title = "Run one review round"
    task = "Open the editor, rebuild the preview, pin a note on any block, list it from the CLI, then resolve it."
    code_lang = "bash"
    code = <<DOC
      wcl editor docs.wcl &
      # rebuild the preview, comment on a block, then:
      wcl wdoc comments .
      wcl wdoc comments . resolve <id>
    DOC
    expected = "The note appears in the CLI list with its id, page, and text, and disappears from the open list after resolve."
    hint = "The comments live in `comments.wcl` next to the document — open it to see exactly what the client wrote."
  }
  check comments_and_rebuilds {
    prompt = "Where do review comments live, and what do they trigger?"
    related = [review_comments]
    choice sidecar_no_rebuild {
      label = "A `comments.wcl` sidecar beside the document — and no rebuild"
      correct = true
      note = "Right — the sidecar is deliberately ignored by the watcher, so reviewing is non-destructive."
    }
    choice in_source {
      label = "Inline in the page source, triggering a rebuild"
      note = "Writing into the source would make review an edit, which is exactly what this avoids."
    }
    choice in_output {
      label = "In the built HTML, discarded on the next build"
      note = "Notes would then be lost the moment anything was rebuilt."
    }
    explanation = "Keyed by page and locator, the sidecar survives edits and is safe to hand-edit or generate."
  }
  check why_a_handshake {
    prompt = "`wcl wdoc review` blocks until the reviewer sends, instead of the agent simply polling for new comments. Why design it that way?"
    kind = :text
    rubric = "A good answer says it gives the agent a COMPLETE round to work from rather than a stream of half-finished notes: the reviewer reads at their own pace and sends once they are done, so the agent sees a coherent set, acts on all of it, and hands back. Polling would have the agent reacting to comments while the reviewer is still forming them."
    related = [review_comments]
  }
}
