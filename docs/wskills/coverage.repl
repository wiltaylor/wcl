// Audience-coverage expressions piped into `wcl repl <wskill>/wskill.wcl`
// by `just wskill-coverage` — one line per audience-bearing gather list.
// "book K/N" = units the book keeps (audience != :ai); "skill K/N" =
// units the skill keeps (audience != :book). A unit missing from a
// projection is otherwise invisible: audience defaults to :book
// everywhere except research (:ai), so an excluded unit fails silently.
$"concepts:  book ${len(filter(concepts, fn(c: Concept) -> bool { c.audience != :ai }))}/${len(concepts)} | skill ${len(filter(concepts, fn(c: Concept) -> bool { c.audience != :book }))}/${len(concepts)}"
$"entities:  book ${len(filter(entities, fn(e: Entity) -> bool { e.audience != :ai }))}/${len(entities)} | skill ${len(filter(entities, fn(e: Entity) -> bool { e.audience != :book }))}/${len(entities)}"
$"facts:     book ${len(filter(facts, fn(f: Fact) -> bool { f.audience != :ai }))}/${len(facts)} | skill ${len(filter(facts, fn(f: Fact) -> bool { f.audience != :book }))}/${len(facts)}"
$"examples:  book ${len(filter(examples, fn(x: Example) -> bool { x.audience != :ai }))}/${len(examples)} | skill ${len(filter(examples, fn(x: Example) -> bool { x.audience != :book }))}/${len(examples)}"
$"indexes:   book ${len(filter(indexes, fn(i: Index) -> bool { i.audience != :ai }))}/${len(indexes)} | skill ${len(filter(indexes, fn(i: Index) -> bool { i.audience != :book }))}/${len(indexes)}"
$"processes: book ${len(filter(procedures, fn(p: Procedure) -> bool { p.audience != :ai }))}/${len(procedures)} | skill ${len(filter(procedures, fn(p: Procedure) -> bool { p.audience != :book }))}/${len(procedures)}"
$"research:  book ${len(filter(research_units, fn(r: Research) -> bool { r.audience != :ai }))}/${len(research_units)} | skill ${len(filter(research_units, fn(r: Research) -> bool { r.audience != :book }))}/${len(research_units)}"
