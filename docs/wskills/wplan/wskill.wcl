// Topic — wskill root document.
//
// Single entry point: declares the topic (subject + metadata) and sources, and
// includes the data files. `wcl check wskill.wcl` validates the whole model.
// The wdoc template sets in wdoc/ project this model into the book and skill.

import <wdoc.wcl>
import "./schema/base.wcl"
import "./schema/extensions.wcl"
import "./schema/presentation.wcl"     // the overview-deck view (author data/presentation/)
import "./schema/training.wcl"         // the tutorial-series view (author data/training/)

// Data — split into more files by area as the wskill grows, adding
// an import line per file. Keep templates (wdoc/) free of topic content.
import "./data/reference/reference.wcl"
import "./data/processes/processes.wcl"
import "./data/indexes.wcl"
// import "./data/presentation/main.wcl"
// import "./data/training/main.wcl"

schema_version = "1.3.0"

topic wplan {
  name    = "wplan"
  summary = "Plan a software project as a gated WCL pipeline: interview, research, PRD, a DAG of parallel-safe specs, and self-contained markdown briefs weak AI agents can execute."
  version = "1.6.0"     // the wplan format version this wskill documents
  created = "2026-07-04"
  updated = "2026-07-05"
}

// The views this wskill ships — first-class data the overview and any registry
// landing can enumerate. Declaring one documents it; the just recipes build
// them. The optional views (deck / training) ship once uncommented AND
// authored (data/presentation/, data/training/).
artifact book     { kind = :book      entry = "wdoc/book/main.wcl"   output = "out/book" }
artifact ai_skill { kind = :ai_skill  entry = "wdoc/skill/main.wcl"  output = "out/skill" }
// artifact slides   { kind = :presentation  entry = "wdoc/presentation/main.wcl"  output = "out/presentation" }
// artifact training { kind = :training      entry = "wdoc/training/main.wcl"      output = "out/training" }

// Skill-projection config — written into SKILL.md frontmatter. The defaults (no
// tool pre-approval, model may invoke) are safe; pre-approve tools if needed.
// Bundle real files into the emitted skill as script / asset CHILDREN of this block
// (the scaffold ships matching example files under skill/). `source` is where the
// file comes from (its path under the wskill root); `name` is the filename it ships
// as in the rendered skill (the basename of source).
wcl.wskill::skill {
  allowed_tools = ["Bash", "Read"]

  summary {
    overview = [
      "Turn an idea into (1) a human-readable wdoc book and (2) self-contained markdown spec briefs that implementation agents - including weak models - execute in parallel without any wcl/wdoc dependency. Everything lives in typed WCL so `just check` gates progress and validates the spec DAG.",
      "Follow the workflow index in order. The verified template is a wcl built-in - scaffold it with `wcl init wplan <dest>/plan --defaults`; never reconstruct it from memory."
    ]
  }

  skill_param "$ARGUMENTS" {
    description = "The project/idea to plan, or the path to an existing plan/ folder to continue."
    value       = "Take it from the user's request. If empty, ask what to plan."
  }

  skill_boundary {
    always = [
      "Scaffold the template with `wcl init wplan <dest>/plan --defaults` rather than writing schema/wdoc files from scratch, and keep `just check` green after every edit.",
      "Add an import line to plan.wcl for every new spec and research finding file, and a status row to status.wcl for every spec.",
      "Complete ALL research before finalising the PRD - implementation agents must never be left to research anything.",
      "Consult installed wskill research pages (`.claude/skills/*/references/research_*.md`, then the same glob under `$HOME/.claude/skills/`) before web research, and cite a reused page in the finding.",
      "Copy context INTO each spec's body (PRD excerpts, research findings, conventions); every exported brief must stand alone.",
      "Keep status.wcl out of implementation-agent briefs - only the verification agent knows it exists.",
      "Define every surface (all elements, states, interactions), data model, and scenario with the user before spec breakdown - under-specified surfaces and models are the main causes of half-finished applications.",
      "Pin every API that crosses a spec boundary in a contract block, and resolve every phase signoff (:done or :not_applicable with a why) before rendering - just check-full gates this.",
      "Set covers on every spec (the requirements_covered gate blocks orphaned :must requirements) and run the analyze pass before rendering - gates verify structure, the analyze pass verifies sense."
    ]
    ask = [
      "Before overwriting an existing plan/ folder or deleting any data file.",
      "Before finalising the PRD (present it; the user approves the phase transition)."
    ]
    never = [
      "Answer an interview question on the user's behalf.",
      "Let two specs own the same path, or hand-edit anything under out/.",
      "Invent WCL/wdoc syntax - the template plus the verified-notes fact cover the tested forms; consult the wcl/wdoc skills beyond them."
    ]
  }

  // The plan template ships as the `wplan` built-in of `wcl init` (canonical
  // copy: crates/wcl/src/scaffold/templates/wplan.wcl in the WCL repo) —
  // no bundled script/asset needed.
}

// The research subagent — a document-level wdoc `agent` block, a PEER of the
// skill config above (agents belong to the wskill, not to one skill). The
// skill target renders it to agents/wplan-researcher.md and `just
// skills-install` copies it into .claude/agents/. The body IS the agent's
// whole system prompt: it must stand alone (a subagent never sees the
// session prompt; the dispatching orchestrator's prompt carries the one
// research item).
agent "wplan-researcher" {
  description = "Completes one wplan research item and writes its finding file. Use during wplan's research phase to parallelise items, passing the research item (id, topic, why) and the plan folder path."
  tools       = ["Read", "Write", "Edit", "Bash", "Glob", "Grep", "WebFetch", "WebSearch"]
  model       = "inherit"
  body {
    p "You are a research agent for a wplan planning phase. Your prompt contains one research item (id, topic, why it matters) and the plan folder path. Your job: research it thoroughly NOW so that no implementation agent ever has to."
    p "The bar for done: a spec author can copy your finding into a spec body and a weak implementation agent needs nothing else. That means exact names and versions (crate/package, API), the specific calls or commands to use, integration gotchas, and a minimal usage example. Vague summaries fail the bar; \"check the docs\" fails the bar."
    p "Rules:"
    list { style = :numbered
      li "Check installed wskill research pages BEFORE the web: glob `.claude/skills/*/references/research_*.md` from the repo root, then `ls $HOME/.claude/skills/*/references/research_*.md 2>/dev/null` (the Glob tool doesn't expand `~`). Grep the `# ` headline and `**Question:**` lines for your topic's keywords; on a hit, read that skill's `references/index_research.md` for the full menu. Where a page answers part of the item, reuse it, check its `Researched:` date / `applies to:` version for freshness, and cite it in the finding body: `p \"Source: wskill <name>, references/research_<id>.md (researched <date>).\"` Web-search only the gaps. If a page conflicts with current official docs, trust the docs and flag the wskill page as stale in your report."
      li "Use current sources (web search/fetch); prefer official docs and release notes over blog posts. Note the version your finding applies to."
      li "Write the finding to `<plan>/research/<id>.wcl` in exactly the shape shown below — do not invent other fields."
      li "Add `import \"./research/<id>.wcl\"` to `<plan>/plan.wcl` if not present, and set the item's row in `<plan>/research.wcl` to `status = :done` with `findings_file = \"research/<id>.wcl\"`."
      li "Run `just check` in the plan folder (or `wcl check plan.wcl`) and fix any syntax/schema error you introduced before finishing. If wcl syntax fights you, keep body content to simple `p \"...\"` paragraphs."
      li "If the topic cannot be settled (conflicting sources, missing docs), set `status = :blocked`, write what you found and what's unresolved in the finding, and say so in your report — never present uncertainty as fact."
      li "Touch nothing in the plan folder except research.wcl, plan.wcl imports, and your own finding file."
    }
    p "The finding shape (rule 3):"
    code wcl { source = <<'WCLX'
finding <id> {
  summary = "One-line conclusion."
  body {
    p "Substance: exact names, versions, calls, gotchas."
    p "More paragraphs as needed. Use `code` in backticks inline."
  }
}
WCLX
    }
    p "Report: the item id, :done or :blocked, and your one-line summary."
  }
}

// Sources describe where current information lives — they drive the update
// workflow only and are never rendered as content. Add one per upstream source.
//
// source upstream_docs {
//   kind         = "docs"
//   locator      = "https://example.com/docs"
//   covers       = "Reference for the whole topic."
//   last_checked = "1970-01-01"
// }

// Cross-references to other wskills (status = "exists" | "planned").
//
// wskill_ref related {
//   name     = "other-topic"
//   relation = "see also"
//   status   = "planned"
// }
