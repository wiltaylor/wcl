spec spec_000_repo {
  title = "Repository setup"
  objective = "Initialise the git repository, base layout, and ignore rules."
  depends_on = []
  branch = "spec/000-repo"
  owns = [".gitignore", "README.md", ".tree/"]
  allowed = ["git init and initial commit", "create README.md and .gitignore"]
  not_allowed = ["creating any source code", "adding dependencies"]
  done = ["git repo exists with main branch", ".tree/ is gitignored"]
  task t1 { text = "Run `git init -b main` in the project root." }
  task t2 { text = "Create .gitignore containing `.tree/` and `target/`." }
  task t3 { text = "Create README.md with the project name and one-line description." }
  task t4 { text = "Commit: `chore: initial repository setup`." }
  accept a1 { check = "Repo initialised on main" command = "git rev-parse --abbrev-ref HEAD | grep -qx main" }
  accept a2 { check = ".tree ignored" command = "git check-ignore .tree/x" }
  body {
    p "This is the root spec. It runs on the main branch directly (no worktree) because nothing exists yet."
  }
}
