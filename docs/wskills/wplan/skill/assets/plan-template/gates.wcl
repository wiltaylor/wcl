// wplan gates — configured by the planning model. `just check` fails while any gate fails.
// Evaluate a gate: wcl eval gates.wcl gates.<id>.ok
import "./plan.wcl"

// The PRD may not be finalised while any interview question is open.
gate questions_closed {
  ok = assert(
    all(questions, fn(q: PlanQuestion) -> bool { q.status != :open }),
    "GATE FAILED: open interview questions remain (questions.wcl)") == none
}

// The PRD may not be finalised while any research item is incomplete.
gate research_done {
  ok = assert(
    all(research, fn(r: PlanResearch) -> bool { r.status == :done }),
    "GATE FAILED: research items not done (research.wcl)") == none
}

// The spec dependency graph must be acyclic (Kahn fixpoint: after N passes,
// the set of specs whose deps are all resolvable must cover every spec).
gate dag_acyclic {
  ok = assert(
    len(fold(range(0, len(specs)), [],
      fn(acc: list<identifier>, _i: i64) -> list<identifier> {
        map(
          filter(specs, fn(s: PlanSpec) -> bool {
            all(s.depends_on, fn(d: identifier) -> bool { list_contains(acc, d) })
          }),
          fn(s: PlanSpec) -> identifier { s.id })
      })) == len(specs),
    "GATE FAILED: dependency cycle detected in specs") == none
}

// No two specs may own the same path (parallel-merge safety).
gate owns_disjoint {
  ok = assert(
    len(unique(flatten(map(specs, fn(s: PlanSpec) -> list<utf8> { s.owns })))) ==
      len(flatten(map(specs, fn(s: PlanSpec) -> list<utf8> { s.owns }))),
    "GATE FAILED: two specs claim ownership of the same path") == none
}

// Every spec must have a status row (verification agent bookkeeping).
gate status_covered {
  ok = assert(
    all(specs, fn(s: PlanSpec) -> bool {
      any(statuses, fn(st: PlanStatus) -> bool { st.spec == s.id })
    }),
    "GATE FAILED: spec missing from status.wcl") == none
}

// Every surface must be implemented by exactly one spec (parallel-safe coverage).
gate surface_coverage {
  ok = assert(
    all(surfaces, fn(sf: PlanSurface) -> bool {
      len(filter(specs, fn(s: PlanSpec) -> bool { list_contains(s.implements, sf.id) })) == 1
    }),
    "GATE FAILED: a surface is not implemented by exactly one spec") == none
}

// Every :screen surface must define the four standard states.
gate surface_states {
  ok = assert(
    all(filter(surfaces, fn(sf: PlanSurface) -> bool { sf.kind == :screen }),
      fn(sf: PlanSurface) -> bool {
        all([:empty, :loading, :error, :populated], fn(k: symbol) -> bool {
          any(sf.states, fn(st: PlanState) -> bool { st.kind == k })
        })
      }),
    "GATE FAILED: a screen surface is missing one of the empty/loading/error/populated states") == none
}

// Every surface must be exercised by at least one scenario.
gate scenario_coverage {
  ok = assert(
    all(surfaces, fn(sf: PlanSurface) -> bool {
      any(scenarios, fn(sc: PlanScenario) -> bool { list_contains(sc.touches, sf.id) })
    }),
    "GATE FAILED: a surface is not touched by any scenario") == none
}

// Every contract's consumer must (transitively) depend on its provider, so the
// provider is always merged before the consumer builds against it.
gate contract_order {
  ok = assert(
    all(specs, fn(s: PlanSpec) -> bool {
      all(s.consumes, fn(c: identifier) -> bool {
        any(contracts, fn(ct: PlanContract) -> bool {
          ct.id == c && list_contains(
            fold(range(0, len(specs)), s.depends_on,
              fn(acc: list<identifier>, _i: i64) -> list<identifier> {
                unique(flatten([acc, flatten(map(
                  filter(specs, fn(d: PlanSpec) -> bool { list_contains(acc, d.id) }),
                  fn(d: PlanSpec) -> list<identifier> { d.depends_on }))]))
              }),
            ct.provided_by)
        })
      })
    }),
    "GATE FAILED: a spec consumes a contract whose provider is not among its (transitive) dependencies") == none
}

// Every data model is defined (implementation-owned) by exactly one spec.
gate models_defined_once {
  ok = assert(
    all(models, fn(m: PlanModel) -> bool {
      len(filter(specs, fn(s: PlanSpec) -> bool { list_contains(s.defines_models, m.id) })) == 1
    }),
    "GATE FAILED: a data model is not defined by exactly one spec") == none
}

// Every :must requirement must be covered by at least one spec (set
// covers = [req_id, ...] on the implementing spec). Passes vacuously with no
// requirements, so a fresh template stays green.
gate requirements_covered {
  ok = assert(
    all(filter(requirements, fn(r: PlanRequirement) -> bool { r.priority == :must }),
      fn(r: PlanRequirement) -> bool {
        any(specs, fn(s: PlanSpec) -> bool { list_contains(s.covers, r.id) })
      }),
    "GATE FAILED: a :must requirement is not in any spec's covers list") == none
}

// A spec that implements surfaces or has walkthrough acceptance must say how
// to run its work for verification.
gate harness_defined {
  ok = assert(
    all(specs, fn(s: PlanSpec) -> bool {
      (len(s.implements) == 0 &&
       all(s.acceptance, fn(a: PlanAccept) -> bool { len(a.walkthrough) == 0 }))
      || s.harness != none
    }),
    "GATE FAILED: a spec with surfaces or walkthrough accepts has no harness") == none
}

// Every phase signoff must be explicitly resolved (done or not_applicable).
// Excluded from `just check` (structural tier); enforced by `just check-full`,
// which `just render` requires - so nothing renders while a phase was skipped
// silently.
gate signoffs_complete {
  ok = assert(
    all(signoffs, fn(sg: PlanSignoff) -> bool { sg.state != :pending }),
    "GATE FAILED: a phase signoff is still :pending - resolve it (done / not_applicable) with the user") == none
}

