// Fleeting-note capture schema — the format for recording quick captures.
//
// This is a SCRATCH area, deliberately separate from the wskill model. Fleeting
// notes are raw input: jotted fast, processed into concepts/entities/facts/
// processes, then discarded. They live in their own `wcl.wskill.capture`
// namespace and their own document (capture/main.wcl), so they are never gathered
// into the wskill @document and never projected into the book or skill.
namespace wcl.wskill.capture

// One quick capture — a single rough idea, written for your present self. Keep it
// cheap to write: a slug, optionally when you caught it and a tag or two, and the
// raw thought. Refine it into a real unit later; do not polish it here.
@block("fleeting")
type Fleeting {
  @inline(0) id: identifier      // short slug (the filename usually matches)
  @default("") captured: utf8    // ISO date you jotted it down (optional)
  @default([]) tags: list<utf8>  // loose tags to help triage later
  note: utf8                     // the raw idea (heredoc)
}

// The capture inbox — gathers every fleeting note awaiting processing.
@document
type Capture {
  @children("fleeting") notes: list<Fleeting>
}
