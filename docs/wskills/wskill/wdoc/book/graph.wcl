// Graph projection — a force-directed map of every unit in the wskill.
//
// Imported by main.wcl; adds the `graph_page` listed in the book's Reference
// section, next to Concepts / Entities / Facts / Processes. Each concept,
// entity, fact and process is a circle node carrying the note's name and
// linking to its own page; edges are the units' `related` links. The diagram
// uses force layout wrapped in an interactive pan + zoom viewport.

import <wdoc.wcl>
import "../../wskill.wcl"

// Record for the diagram's computed `edges = [...]` field. Node ids are the raw
// unit ids, so a `related` id maps straight to its node. The diagram's Edge
// connection is `@dynamic`, so an endpoint naming a missing node is dropped with
// a build warning rather than failing the build.
type GraphEdge { source: utf8  destination: utf8 }

// One edge per (unit, related-id) pair, across all four unit kinds.
let note_edges = flatten([
  flatten(map(concepts,   fn(c: Concept)   -> list<GraphEdge> { map(c.related, fn(r: identifier) -> GraphEdge { { source: $"${c.id}", destination: $"${r}" } }) })),
  flatten(map(entities,   fn(e: Entity)    -> list<GraphEdge> { map(e.related, fn(r: identifier) -> GraphEdge { { source: $"${e.id}", destination: $"${r}" } }) })),
  flatten(map(facts,      fn(f: Fact)      -> list<GraphEdge> { map(f.related, fn(r: identifier) -> GraphEdge { { source: $"${f.id}", destination: $"${r}" } }) })),
  flatten(map(procedures, fn(p: Procedure) -> list<GraphEdge> { map(p.related, fn(r: identifier) -> GraphEdge { { source: $"${p.id}", destination: $"${r}" } }) })),
])

page graph_page { title = "Graph"
  h1 "Graph"
  p "Every concept, entity, fact and process in this wskill, drawn as a force-directed graph — each circle is a note (click it to open its page) and each line is a `related` link. Scroll to zoom and drag to pan."
  diagram {
    width    = 960
    height   = 640
    layout   = :force
    pan_zoom = true
    zoom_min = 1.0
    zoom_max = 4.0
    link_distance = 90.0
    desc = "Force-directed graph of every wskill note and its related links."

    wdoc_repeater { each = concepts   as = :c  node { id = c.id  text = c.name   link = $"concept_${c.id}" } }
    wdoc_repeater { each = entities   as = :e  node { id = e.id  text = e.name   link = $"entity_${e.id}" } }
    wdoc_repeater { each = facts      as = :f  node { id = f.id  text = f.title  link = $"fact_${f.id}" } }
    wdoc_repeater { each = procedures as = :p  node { id = p.id  text = p.title  link = $"process_${p.id}" } }

    edges = note_edges
  }
}
