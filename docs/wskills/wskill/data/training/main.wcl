# The training view's course — "Build your first wskill" (`<wskill/training.wcl>`).
# Ordered lessons with hands-on exercises; `related` links each lesson back to
# the reference units it teaches.

lesson scaffold_first_wskill {
  n = 1u32
  title = "Scaffold your first wskill"
  summary = "Create a wskill folder with `wcl init` and take the tour."
  objectives = ["Scaffold a new wskill folder from the built-in template", "Name the parts of the generated tree and what each is for", "Validate the empty model with `wcl check`"]
  related = [wskill_concept, creating_a_wskill, folder_layout]
  body {
    p <<DOC
      A wskill starts from the built-in scaffold: one command generates the whole folder — the
      projection entry points and empty data files ready for content.
    DOC
    p <<DOC
      The generated tree splits into three zones: `schema/` (what this topic adds to the data
      model — `kinds.wcl` and `extensions.wcl`, both yours), `data/` (the content you'll write),
      and `wdoc/` (the projection entries). The base schema and the shared page templates are
      not files here at all: they ship inside the `wcl` binary and arrive through
      `import <wskill.wcl>`, the same way `import <wdoc.wcl>` does.
    DOC
  }
  exercise scaffold {
    title = "Scaffold and validate"
    task = "Create a wskill about a topic you know well, then validate the empty model."
    code_lang = "bash"
    code = <<DOC
      wcl init wskill ./my-topic
      cd my-topic
      wcl check wskill.wcl
    DOC
    expected = "`wcl check` prints `OK` — the scaffolded model is valid before you add any content."
    hint = "`wcl init wskill` prompts for a topic id, name, and summary; accept the defaults with `--defaults` if you just want to explore."
  }
  check which_zone_is_generated {
    prompt = "Which part of a scaffolded wskill must not be hand-edited?"
    related = [folder_layout]
    choice out {
      label = "`out/`"
      correct = true
      note = "Right — it is rendered output. Re-render instead of editing it."
    }
    choice kinds {
      label = "`schema/kinds.wcl`"
      note = "This one is yours — it holds the topic's own entity and artifact vocabularies."
    }
    choice data {
      label = "`data/`"
      note = "`data/` is entirely yours; it is where the content lives."
    }
    explanation = "The base schema is not a file in your folder at all — it ships inside the `wcl` binary and arrives through `import <wskill.wcl>`. Everything the scaffold DOES write is yours, except `out/`."
  }
  check why_check_empty {
    prompt = "Why validate the model with `wcl check` before writing any content?"
    kind = :text
    rubric = "A good answer notes that it proves the scaffold is sound and the toolchain works, so any later error is caused by the content you added rather than by the setup — a known-good baseline to edit from."
    related = [creating_a_wskill]
  }
}

lesson capture_first_units {
  n = 2u32
  title = "Capture your first units"
  summary = "Decompose a corner of the topic and classify each piece with the decision guide."
  objectives = ["Classify a piece of knowledge as concept, entity, fact, or process", "Write a unit file with a body and related links", "Render the book and find your unit's page"]
  prerequisites = [scaffold_first_wskill]
  related = [decomposing_information, unit_decision_guide, concept, entity, fact]
  body {
    p <<DOC
      Content lives in `data/` as block instances. Pick one small corner of your topic and split it
      into atomic units — one idea each. Then classify each piece with the decision guide: an idea
      the reader must understand is a `concept`, a concrete named thing (a person, a tool, a file
      format) is an `entity` with a `kind` from `schema/kinds.wcl`, and a value or lookup table is a
      `fact`. Never default to entity.
    DOC
    p <<DOC
      Every unit gets an id, a headline, and a `body { … }` of wdoc blocks. Link units to each other
      with `related = [other_id]` — the projections turn those into links both ways.
    DOC
  }
  exercise first_concept {
    title = "Write a concept and render it"
    task = "Add a concept to `data/reference/reference.wcl`, then build the book and open your concept's page."
    code_lang = "bash"
    code = <<DOC
      cat >> data/reference/reference.wcl <<'WCL'
      concept my_first_idea {
        name    = "My first idea"
        summary = "The one-liner the index shows."
        body { p "The explanation a reader needs." }
      }
      WCL
      wcl check wskill.wcl && wcl wdoc build wdoc/book/main.wcl --out out/book
    DOC
    expected = "The build reports the pages written, and `out/book/concept_my_first_idea.html` exists with your body text."
    hint = "If `wcl check` fails, the error names the file, line, and field — fix and re-run."
  }
  exercise classify_three {
    title = "Classify three notes"
    task = "Take three pieces of your topic — one idea, one named tool, one value table — and file each as the right kind."
    expected = "One `concept`, one `entity` (with a `kind` symbol that isn't a stretch), one `fact` with a table body — and `wcl check` stays green."
    hint = "If no `EntityKind` fits without lying, the note isn't an entity — re-run it through the decision guide."
  }
  check classify_a_tool {
    prompt = "You are documenting a command-line tool with a version, a homepage, and a maintainer. Which unit kind fits?"
    related = [unit_decision_guide, entity]
    choice entity_kind {
      label = "`entity` — a concrete named thing"
      correct = true
      note = "Right — a named tool with attributes is the textbook entity, provided an `EntityKind` fits it honestly."
    }
    choice concept_kind {
      label = "`concept` — an idea the reader must understand"
      note = "A concept explains an idea. The tool itself is a thing, not an idea."
    }
    choice fact_kind {
      label = "`fact` — a value or lookup table"
      note = "A fact holds values. Its version is a value; the tool as a whole is not."
    }
    explanation = "Run every note through the decision guide: idea to concept, named thing to entity, value or table to fact, repeatable task to procedure."
  }
  check why_not_default_entity {
    prompt = "The decision guide warns you never to default to `entity`. Why does that rule exist?"
    kind = :text
    rubric = "A good answer explains that `entity` is the easiest kind to reach for, so defaulting to it collects notes that are really concepts or facts; the give-away is needing an `EntityKind` that does not fit without stretching. The cost is a book of shapeless things whose ideas are never actually explained."
    related = [unit_decision_guide, decomposing_information]
  }
}

lesson processes_and_index {
  n = 3u32
  title = "Processes and the curated index"
  summary = "Capture a runbook as steps, then pin everything into a navigable tree."
  objectives = ["Write a procedure with steps, flow edges, and a verification", "Curate an index so the book nav reflects the topic's shape"]
  prerequisites = [capture_first_units]
  related = [process, adding_content, building_the_index]
  body {
    p <<DOC
      A repeatable task is a `procedure`: ordered `step`s (each with a `body screen` showing what's
      on screen and a `body steps` saying what to do), `from -> to` flow edges that draw the
      flowchart, and a `verification` line — how you know it worked.
    DOC
    p <<DOC
      Units become navigable when an `index` pins them: each index is a sidebar branch whose
      `related` lists the unit ids it owns. Unpinned units stay reachable through links but
      invisible in the nav.
    DOC
  }
  exercise first_procedure {
    title = "Capture a runbook"
    task = "Write the task you do most often in your topic as a `procedure` with at least two steps and a verification, then pin it (and your earlier units) into an `index`."
    code_lang = "wcl"
    code = <<DOC
      procedure daily_task {
        title   = "…"
        purpose = "…"
        step first  { n = 1  body steps { p "Do this." } }
        step second { n = 2  body steps { p "Then this." } }
        first -> second
        verification = "How you know it worked."
      }
      
      index basics {
        name    = "Basics"
        related = [my_first_idea, daily_task]
      }
    DOC
    expected = "The book nav shows a \"Basics\" branch containing your units, and the procedure's page opens with a flowchart above the steps."
  }
  check what_makes_nav {
    prompt = "A unit renders its own page but never appears in the book's sidebar. What is missing?"
    related = [building_the_index]
    choice not_pinned {
      label = "No `index` pins it"
      correct = true
      note = "Right — the nav is the curated index tree, so an unpinned unit stays reachable by link but invisible in the sidebar."
    }
    choice wrong_audience {
      label = "Its `audience` excludes the book"
      note = "Audience routes between the book and the skill. An `:ai` unit would render no book page at all — but this one does."
    }
    choice missing_related {
      label = "It has no `related` links"
      note = "`related` builds cross-links between units; the sidebar comes from indexes."
    }
    explanation = "Indexes are the deliberate shape of the topic. Pinning is an editorial act — what belongs in the nav is a smaller set than what exists."
  }
  check why_verification {
    prompt = "Every `procedure` carries a `verification` line. What does it buy that the steps alone do not?"
    kind = :text
    rubric = "A good answer says the steps describe what to do while the verification describes the observable end state — how you know it actually worked. Without it a reader can complete every step and still not know whether the task succeeded, and an agent has no success condition to check against."
    related = [process]
  }
}

lesson ship_the_skill {
  n = 4u32
  title = "Ship the AI skill"
  summary = "Curate what an agent sees, render the skill, and install it."
  objectives = ["Opt units into the skill with `audience`", "Configure the skill block (description, parameters, boundaries)", "Build and install the skill where an agent loads it"]
  prerequisites = [processes_and_index]
  related = [skill_anatomy, setup_ai_skill, installing_the_skill]
  body {
    p <<DOC
      The skill is curated up: every unit defaults to `:book`, so mark what the agent needs `:both`
      (shared reference) or `:ai` (agent-only notes). The `skill` block in `wskill.wcl` becomes
      SKILL.md's frontmatter — its `description` is the trigger text — and `skill_boundary` rules
      render as hard rules the agent must follow.
    DOC
    p <<DOC
      An `:ai`/`:both` index becomes a section of SKILL.md's Reference — curating those indexes IS
      designing the agent's entry points.
    DOC
  }
  exercise build_and_install {
    title = "Render and install"
    task = "Tag your best units `:both`, add an `:ai` index over your runbooks, then build the skill and install it into a repo."
    code_lang = "bash"
    code = <<DOC
      just skill-build
      wcl wskill install . --repo <repo>
    DOC
    expected = "`.claude/skills/my-topic/SKILL.md` lists your index as a Reference section, and an agent session in that repo can answer from the skill's pages."
    hint = "If the agent never invokes the skill, sharpen the `description` in the skill block — it is what the agent matches requests against."
  }
  check default_audience {
    prompt = "You add a new `concept` and set no `audience`. Where does it render?"
    related = [views]
    choice book_only {
      label = "The book only"
      correct = true
      note = "Right — every unit defaults to `:book`, so the skill is curated UP from nothing rather than filtered down."
    }
    choice both {
      label = "Both the book and the skill"
      note = "That is `:both`, and it has to be asked for explicitly."
    }
    choice neither {
      label = "Neither, until it is pinned"
      note = "Pinning controls the nav, not whether a page renders."
    }
    explanation = "Curating up is the point: an agent's context is scarce, so each unit must earn its place in the skill with an explicit `:both` or `:ai`."
  }
  check curate_up {
    prompt = "Why does the skill curate up from nothing instead of shipping every unit the book has?"
    kind = :text
    rubric = "A good answer centres on the agent's limited context: everything shipped competes for attention, so a skill that includes the whole book buries what matters. Curating up forces a deliberate choice about what an agent actually needs, and the `:ai`/`:both` indexes become its entry points."
    related = [skill_anatomy]
  }
}

lesson optional_views {
  n = 5u32
  title = "Ship a deck or a course"
  summary = "Add the optional presentation and training views when the topic warrants them."
  objectives = ["Decide when a topic deserves a deck or a training course", "Author slide and lesson data and render the optional views"]
  prerequisites = [ship_the_skill]
  related = [views, presentation_view, training_view, creating_presentation, creating_training_book]
  body {
    p <<DOC
      The deck introduces (slides feature existing units — `unit = <id>` pulls the headline and
      summary); the training book teaches (ordered lessons ending in exercises with expected
      results). Both are data like everything else, and both are optional — declare the `artifact`
      and author the data only when the topic warrants the view.
    DOC
    p <<DOC
      This course and the wskill deck are themselves the worked example: the same model you're
      learning renders them.
    DOC
  }
  exercise add_a_deck {
    title = "Add a three-slide deck"
    task = "Enable the presentation view and author one section with three slides, each featuring one of your units."
    code_lang = "bash"
    code = <<DOC
      # scaffolded with the view off? copy the pieces from a fresh scaffold:
      wcl init wskill /tmp/ref --defaults -D include_presentation=yes
      cp /tmp/ref/wdoc/presentation/main.wcl wdoc/presentation/main.wcl
      cp /tmp/ref/data/presentation/main.wcl data/presentation/main.wcl
      # then: uncomment the artifact + data import in wskill.wcl, author slides, and
      just presentation-build
    DOC
    expected = "`out/presentation/index.html` opens as a deck: a generated title slide plus your three slides showing their units' headlines."
  }
  check what_ships_a_view {
    prompt = "You have authored lessons under `data/training/`, but no course renders. What actually makes the view ship?"
    related = [views, training_view]
    choice artifact_block {
      label = "An `artifact { kind = :training … }` in `wskill.wcl`"
      correct = true
      note = "Right — the artifact declares the view exists and names its entry file. Data alone renders nothing."
    }
    choice data_alone {
      label = "Authoring the lesson data is enough"
      note = "The data gathers into the model, but nothing projects it until a view is declared."
    }
    choice audience_flag {
      label = "Setting `audience = :both` on the lessons"
      note = "Audience routes between the book and the skill; lessons carry no audience at all."
    }
    explanation = "Both optional views work the same way: declare the `artifact`, import the data, and render the projection. Each part is opt-in."
  }
  check deck_or_course {
    prompt = "A colleague asks whether their topic needs a deck, a course, or neither. How would you help them decide?"
    kind = :text
    rubric = "A good answer separates the jobs: a deck INTRODUCES (short, features existing units, for someone deciding whether to care), a course TEACHES (ordered, hands-on, for a newcomer working through the topic for the first time), and the book REFERENCES (for someone who already knows the topic). Neither optional view is worth its maintenance unless the topic has a real audience for that job."
    related = [views, presentation_view, training_view]
  }
}

lesson keep_it_alive {
  n = 6u32
  title = "Review, edit, and keep it current"
  summary = "The maintenance loop: browser editing, the human⇄agent review handshake, and source-driven updates."
  objectives = ["Edit units from the rendered book with wcl editor", "Run the comment/review loop between a reviewer and an agent", "Use source blocks to drive update sweeps"]
  prerequisites = [ship_the_skill]
  related = [editing_via_serve, updating_a_wskill]
  body {
    p <<DOC
      A wskill is alive: `wcl editor wdoc/book/main.wcl` gives you in-browser editing (every unit
      page in the preview pane has an Edit button that opens the exact object's source) and
      click-to-comment review. An agent runs `wcl wdoc review .` to wait for a reviewer's send, then
      works through the comments and resolves them by id.
    DOC
    p <<DOC
      `source` blocks record where authoritative information lives and when it was last checked — an
      update sweep walks them, refreshes what drifted, and bumps `topic.version`.
    DOC
  }
  exercise review_loop {
    title = "Run one review round"
    task = "Open the editor, rebuild the preview, pin a comment on any page, list it from the CLI, then resolve it."
    code_lang = "bash"
    code = <<DOC
      wcl editor wdoc/book/main.wcl &
      # Rebuild the preview, comment on a block from its ⋯ menu, then:
      wcl wdoc comments . --format json
      wcl wdoc comments . resolve <id>
    DOC
    expected = "The comment appears in the JSON list with a page and locator, and disappears after resolve."
  }
  check review_actor {
    prompt = "In the review handshake, who is blocked waiting for whom?"
    related = [editing_via_serve]
    choice agent_waits {
      label = "The agent waits for the reviewer to send"
      correct = true
      note = "Right — `wcl wdoc review` blocks until the reviewer sends, then prints the comments to act on."
    }
    choice reviewer_waits {
      label = "The reviewer waits for the agent to finish"
      note = "The reviewer works at their own pace in the browser; nothing blocks them."
    }
    choice neither {
      label = "Neither — comments are polled on a timer"
      note = "The handshake is explicit rather than a poll, so the agent acts on a complete round of review."
    }
    explanation = "The loop is deliberate: review a whole round, send once, let the agent work through the comments and resolve them by id, then rebuild and review again."
  }
  check sources_drive_updates {
    prompt = "What role do `source` blocks play when a topic drifts out of date?"
    kind = :text
    rubric = "A good answer explains that a source records where authoritative information lives and when it was last checked, so an update sweep has a worklist rather than a re-read of everything: walk the sources, refresh what changed upstream, update the units that depended on them, and bump the topic version."
    related = [updating_a_wskill]
  }
}
