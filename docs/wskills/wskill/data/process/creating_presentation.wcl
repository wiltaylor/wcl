procedure creating_presentation {
  title = "Creating the presentation view"
  purpose = "Ship the optional overview deck: declare the artifact, author the slides, render and present."
  preconditions = ["The reference content the deck will feature already exists — a deck arranges units, it doesn't replace them."]
  related = [{ id: "presentation_view", why: "The presentation view supports Creating the presentation view: An optional overview deck introducing the topic — slides feature existing units; the detail stays in the book." }]
  audience = :both

  step enable {
    n = 1
    title = "Declare the artifact"
    body screen {
      code "wcl" {
        source = <<DOC
          // wskill.wcl — uncomment (or add) the artifact line
          artifact slides { kind = :presentation  entry = "wdoc/presentation/main.wcl"  output = "out/presentation" }
          // and make sure the data import is active:
          import "./data/presentation/main.wcl"
        DOC
      }
    }
    body steps {
      p <<DOC
        A scaffold created with the presentation answer set to `yes` already has the artifact, the
        data import, and the `wdoc/presentation/` template. Enabling later: uncomment the artifact
        line and the data import, and copy `wdoc/presentation/main.wcl` + a starter
        `data/presentation/main.wcl` from a fresh scaffold
        (`wcl init wskill /tmp/t --defaults -D include_presentation=yes`).
      DOC
    }
  }

  step author {
    n = 2
    title = "Author the deck data"
    body screen {
      code "wcl" {
        source = <<DOC
          // data/presentation/main.wcl
          presentation intro {
            summary = "One-line deck subtitle."
            pres_section what {
              title = "What & why"
              pres_slide opening {
                unit = <concept_id>              // pulls that unit's headline + summary
                speaker_notes = "What to say while this slide is up."
              }
              pres_slide detail {
                title = "Explicit slide title"
                body {
                  p "- bullet one"
                  p "- bullet two"
                }
              }
            }
          }
        DOC
      }
    }
    body steps {
      p <<DOC
        One `presentation` block; each `pres_section` is a deck column, each `pres_slide` one slide
        (author one slide per line). Prefer `unit = <id>` over restating content — if a slide needs
        substance the model lacks, capture the unit first. Keep it an introduction: 8–15 slides is
        plenty.
      DOC
    }
  }

  step render {
    n = 3
    title = "Render and present"
    body screen {
      code "console" {
        source = "$ just presentation-build     # → out/presentation/index.html\n"
      }
    }
    body steps {
      p <<DOC
        Open the built single-file deck: ← → move between sections, ↑ ↓ within one, Space steps
        through reveals, `s` toggles the speaker notes. The projection prepends a title slide from
        the topic automatically.
      DOC
    }
  }

  enable -> author
  author -> render

  verification = "`out/presentation/index.html` opens as a navigable deck: title slide from the topic, one slide per pres_slide, featured units showing their headline and summary."
}
