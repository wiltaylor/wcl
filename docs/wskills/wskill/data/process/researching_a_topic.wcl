procedure researching_a_topic {
  title = "Researching a topic into a wskill"
  purpose = "Author a whole wskill by research: scope the topic in an interview, fan the open questions out to parallel researcher agents as `research` units, then distill the findings into concept/entity/fact/procedure units and a curated index."
  preconditions = ["A wskill folder for the topic that checks clean — scaffold one first via [Creating a new wskill](process_creating_a_wskill) if none exists."]
  related = [creating_a_wskill, capturing_research, adding_content, building_the_index, unit_decision_guide, decomposing_information]
  audience = :both

  step scope {
    n = 1
    title = "Scoping interview"
    body steps {
      p <<DOC
        Interview the topic owner in rounds until the shape is settled: what the topic covers and
        what it deliberately does NOT, which upstreams are authoritative (record each as a `source`
        block in wskill.wcl and pin `topic.version` when the subject has one), who each view is for,
        and which artifacts to ship. Decisions only the owner can make are captured as plain
        `question` blocks — those are for the owner, not for research.
      DOC
    }
  }

  step decompose {
    n = 2
    title = "Decompose into research items"
    body screen {
      code "wcl" {
        source = <<DOC
          // data/questions.wcl (import it from data/main.wcl) — the run's worklist.
          question r_<slug> {
            question = "<The single thing this item must settle.>"
            context  = "<Why it matters / which part of the topic it unblocks.>"
            tags     = ["research_item"]
          }
        DOC
      }
    }
    body steps {
      p <<DOC
        Turn the scoped topic into a worklist of single-idea research items — one `question` block
        each, tagged `research_item`, in a `data/questions.wcl` created for the run. If an item
        needs an "and" to state, split it. The worklist is temporary metadata: question blocks never
        render as topic content and are deleted once folded.
      DOC
    }
  }

  step dispatch {
    n = 3
    title = "Dispatch researchers in parallel"
    body steps {
      p <<DOC
        Dispatch one `wskill-researcher` subagent per `:open` research item, in parallel. Each
        prompt carries the item's id, question and context, the absolute wskill folder path, and
        today's date. Each agent writes ONLY its own `data/research/<id>.wcl` (finding + `source`
        blocks), its one import line in `data/research/main.wcl`, and its own question row —
        separate files are what make the fan-out merge-safe.
      DOC
    }
  }

  step gate {
    n = 4
    title = "Completeness gate"
    shape = :decision
    body screen {
      code "console" {
        source = <<DOC
          $ grep -n 'status = :open' data/questions.wcl    # must print nothing
          $ just wskill-check                              # model + templates green
        DOC
      }
    }
    body steps {
      p <<DOC
        Every research_item question must be `:answered` with its `data/research/<id>.wcl` present,
        and the model must check clean. A blocked item comes back `:open`: settle it with the owner
        and re-dispatch, or mark it `:dropped` with the why in `answer`. Do not distill from an
        incomplete worklist.
      DOC
    }
  }

  step distill {
    n = 5
    title = "Distill findings into units"
    body steps {
      p <<DOC
        For each research unit, run the [Adding content](process_adding_content) loop: decompose its
        body into atomic notes, classify each with
        [the decision guide](fact_unit_decision_guide), and write the concept/entity/fact/procedure/term units — each citing its research id in `related`, so unit and evidence link both ways. The `research` block stays as the dated evidence trail. Then fold and delete the answered research_item
        questions (and `data/questions.wcl` plus its import, once empty).
      DOC
    }
  }

  step index {
    n = 6
    title = "Build the index"
    body steps {
      p <<DOC
        Pin every unit into a topic-meaningful `index` tree in `data/indexes.wcl`, per
        [Building the index](process_building_the_index) — the same curation shapes the book nav and
        SKILL.md's entry points.
      DOC
    }
  }

  step verify {
    n = 7
    title = "Render and verify"
    body screen {
      code "console" {
        source = <<DOC
          $ just wskill-check && just render
          $ ls out/skill/references/research_*.md out/skill/references/index_research.md
        DOC
      }
    }
    body steps {
      p <<DOC
        Every research unit must ship at `references/research_<id>.md`, be listed in
        `references/index_research.md`, and appear under SKILL.md's `## Research` section; every
        distilled unit must have its own page and a home in an index.
      DOC
    }
  }

  step review {
    n = 8
    title = "Review with the owner"
    shape = :terminator
    body steps {
      p <<DOC
        Hand off to a review pass: serve the book, walk it with the owner, and fold review
        comments back into the units.
      DOC
    }
  }

  scope -> decompose
  decompose -> dispatch
  dispatch -> gate
  gate -> dispatch :no
  gate -> distill :yes
  distill -> index
  index -> verify
  verify -> review

  verification = "No `:open` research_item questions remain; every research unit renders at references/research_<id>.md and is listed in index_research.md; every distilled unit has a page, cites its research id, and sits under an index; `just wskill-check` and `just render` are green."
}
