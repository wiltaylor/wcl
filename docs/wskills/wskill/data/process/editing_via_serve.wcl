procedure editing_via_serve {
  title   = "Editing a wskill in the browser"
  purpose = "Use `wcl editor` to modify units from the rendered book preview, writing real .wcl source."
  preconditions = ["The wskill renders (`just wskill-check` passes)."]
  related = [reviewing_a_wskill, adding_content, authoring_cli]
  audience = :both

  step serve { n = 1
    title = "Open the editor"
    body screen { code "console" { source = <<'SH'
$ cd path/to/wskill && wcl editor wdoc/book/main.wcl
SH
    } }
    body steps { p "`wcl editor` serves a browser IDE for the directory: a file tree, tabbed CodeMirror editing with WCL language support, and a preview pane. Pick the book in the topbar's site selector and press **Rebuild** to render it (unsaved buffers are overlaid, so the preview always shows what you see in the tabs)." }
  }

  step edit_units { n = 2
    title = "Jump from a rendered unit to its source"
    body steps { p "Every unit page carries an **Edit this concept/entity/fact/process** button. Clicking it opens the unit's declaring `.wcl` data file in an editor tab, selected at that exact block — no hunting through the tree. Edit the WCL directly; the LSP flags syntax and schema problems as you type." }
  }

  step save { n = 3
    title = "Save through the validating pipeline"
    body steps { p "Saving (`Ctrl+S` or the status-bar **Save**) writes through a validate-then-write pipeline — a change that would introduce schema errors rolls back with the message shown as a toast, and concurrent on-disk changes surface as a reload-vs-overwrite conflict dialog." }
  }

  step rebuild { n = 4
    title = "Rebuild to verify"
    body steps { p "Press **Rebuild** again to re-render the book with your change and verify it on the reloaded preview page." }
  }

  serve -> edit_units
  edit_units -> save
  save -> rebuild

  verification = "The edited value appears in the data file (git diff shows a clean, minimal change) and on the rebuilt preview page."
}
