procedure adding_content {
  title = "Adding content to a wskill"
  purpose = "The shape-first capture loop: decompose a piece of knowledge, classify it, place it in the index, then write, link and render it."
  preconditions = ["An existing wskill folder that checks clean (`just wskill-check`)."]
  related = [{ id: "decomposing_information", why: "Decomposing information supports Adding content to a wskill: Break a topic into atomic notes — one idea each — then file each as the unit kind that fits it: concept, entity, fact or process." }, { id: "building_the_index", why: "Building the wskill index supports Adding content to a wskill: Declare the wskill's shape during scoping by writing a bodied `index` tree, then place units under the node whose scope owns them." }]
  audience = :both

  step decompose {
    n = 1
    title = "Decompose to atomic notes"
    body steps {
      p <<DOC
        Break the knowledge into single-idea pieces — one idea, thing, value or task per note. If a
        draft note needs an "and" in its summary, split it. See
        [Decomposing information](concept_decomposing_information).
      DOC
    }
  }

  step classify {
    n = 2
    title = "Classify with the decision guide"
    shape = :decision
    body steps {
      p <<DOC
        Run each note through
        [the decision guide](fact_unit_decision_guide): a dated finding from an investigation → `research` (see [Capturing research](process_capturing_research));
        a repeatable task → `procedure`; a concrete NAMED thing (person, software, place, …) →
        `entity` with a `kind` from `schema/kinds.wcl`; an indisputable value/table (including a
        glossary) → `fact`; otherwise → `concept`. Never default to entity.
      DOC
    }
  }

  step place {
    n = 3
    title = "Place it under an index node"
    body steps {
      p <<DOC
        Before writing prose, choose a stable unit id and the existing `index` node whose stated scope
        owns it, then add that id to the node's `related` list. The pin is temporarily unresolved until
        the next step writes the unit, so complete place + write as one editing change before running
        checks. If no node wants the unit, treat that as design information: revise the tree or justify
        a new bodied node via [Building the wskill index](process_building_the_index). Do not author the
        unit until its place is honest.
      DOC
    }
  }

  step write {
    n = 4
    title = "Write the unit file"
    body screen {
      code "wcl" {
        source = <<DOC
          // data/reference/<id>.wcl (or the per-kind folder)
          concept <id> {
            name     = "<Headline>"
            summary  = "<One-liner the indexes show.>"
            audience = :both              // opt into the skill when the agent needs it
            related  = [<other_ids>]
            body { p "The substance — capture it here, never defer to an external source." }
          }
        DOC
      }
    }
    body steps {
      p <<DOC
        Write the block instance in `data/` (one file per unit as the wskill grows; add the import
        line to the folder's `main.wcl`). Start from the kind's fill-out template (Unit templates)
        and follow the house style — [Writing style](fact_writing_style). Give it a stable `id`, a
        headline, a summary, and a self-contained body. Attach worked examples as `example` blocks
        with `unit = <id>`.
      DOC
    }
  }

  step link {
    n = 5
    title = "Link it into the web"
    body steps {
      p <<DOC
        Fill `related` with the few ids a reader would go to next — roughly 3-5, not everything
        related. Links resolve both ways (each page also lists what references it), so a careless
        link adds noise at both ends; see [Linking discipline](fact_linking_discipline). A unit with
        no links at all is usually misfiled or not atomic.
      DOC
    }
  }

  step render {
    n = 6
    title = "Check and render"
    body screen {
      code "console" {
        source = "$ just wskill-check && just render\n"
      }
    }
    body steps {
      p <<DOC
        `wcl check` catches schema violations (a wrong entity kind, a missing required field) with
        file/line errors; the render makes the new pages. Fix anything it reports before moving to
        the next note.
      DOC
    }
  }

  decompose -> classify
  classify -> place
  place -> write
  write -> link
  link -> render

  verification = "The new unit has its own page in the rendered book, appears under its index in the nav, and its related links resolve in both directions."
}
