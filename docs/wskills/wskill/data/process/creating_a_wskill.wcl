procedure creating_a_wskill {
  title   = "Creating a new wskill"
  purpose = "Start a new wskill for a topic from the wcl template, then capture and model the knowledge."
  preconditions = ["The `wcl` CLI on your PATH (`wcl --version`)"]
  related = [wskill, book_view, skill_view, datapresentation, selfcontained, capturing_notes, fleeting_note, breaking_down_a_topic]
  audience = :both

  step 1 {
    title = "Scaffold from the template"
    body screen { code "console" { source = <<'SH'
$ wcl init wskill docs/wskills/<topic>
$ cd docs/wskills/<topic>
SH
    } }
    body steps { p "Run `wcl init wskill` to scaffold a new wskill folder from the built-in template — don't hand-create it. It writes `wskill.wcl`, the `schema/`, the `wdoc/` templates, an empty `data/` skeleton, and the `capture/` inbox. (`wcl init --list` shows the available templates.)" }
  }

  step 2 {
    title = "Set the topic"
    body screen { code "wcl" { source = <<'WCL'
topic <id> {
  name    = "<Topic name>"
  summary = "<One-line description of the topic.>"
  version = "1.0.0"
  created = "<YYYY-MM-DD>"
}
WCL
    } }
    body steps { p "Edit `wskill.wcl` and fill in the single `topic` block — its `id`, `name` and `summary` describe the whole wskill." }
  }

  step 3 {
    title = "Capture and model the content"
    body screen { code "wcl" { source = <<'WCL'
// capture/<slug>.wcl — a rough, disposable note
fleeting <slug> {
  captured = "<YYYY-MM-DD>"
  tags     = ["idea"]
  note = <<NOTE
    The raw idea, in your own words — written fast, not polished.
  NOTE
}
WCL
    } }
    body steps { p "Capture as you go so nothing is lost: drop a `fleeting` block into a `capture/<slug>.wcl` file and import it from `capture/main.wcl` — quick and rough, written for your present self. Then process each fleeting note into real units under `data/` — a `concept`, `entity`, `fact` or `procedure`, each atomic, self-contained, and cross-linked with `related`. See *Capture and process a fleeting note* for the capture loop and *Breaking a topic down into the data model* for how to classify each note." }
  }

  verification = "`wcl init wskill` produced a folder whose `topic` is filled in, and the topic's knowledge is captured as units under `data/`."
}
