procedure creating_a_wskill {
  title   = "Creating a new wskill"
  purpose = "Start a new wskill for a topic from the bundled scaffold, then model the knowledge and render its two views."
  preconditions = [
    "The `wcl` CLI on your PATH (`wcl --version`)",
    "The bundled scaffold template (ships in the skill under `assets/scaffold`)",
  ]
  related = [wskill, book_view, skill_view, datapresentation, selfcontained, capturing_notes]
  audience = :both

  step 1 {
    title = "Copy the scaffold"
    body screen { code "console" { source = <<'SH'
$ cp -r assets/scaffold docs/wskills/<topic>
$ cd docs/wskills/<topic>
SH
    } }
    body steps { p "Copy the bundled scaffold into a new folder named for the topic. It ships with `wskill.wcl`, the `schema/`, the `wdoc/` templates, an empty `data/` skeleton, and the `capture/` inbox — everything a wskill needs." }
  }

  step 2 {
    title = "Set the topic"
    body screen { code "wcl" { source = <<'WCL'
topic <id> {
  name    = "<Topic name>"
  summary = "<One-line description of the topic.>"
  version = "1.0.0"
  created = "<YYYY-MM-DD>"
}
WCL
    } }
    body steps { p "Edit `wskill.wcl` and fill in the single `topic` block — its `id`, `name` and `summary` describe the whole wskill." }
  }

  step 3 {
    title = "Model the content"
    body steps { p "Add the knowledge as units under `data/`: a `concept` for an idea, an `entity` for a concrete thing, a `fact` for a value, a `procedure` for a task. Keep each atomic and self-contained, and cross-link related units with `related`. Jot rough ideas into `capture/` first if you need to — see *Capture and process a fleeting note*." }
  }

  step 4 {
    title = "Validate"
    body screen { code "console" { source = <<'SH'
$ wcl check wskill.wcl
OK
SH
    } }
    body steps { p "Run `wcl check wskill.wcl` to validate the model against the schema, and fix any reported errors before rendering." }
  }

  step 5 {
    title = "Render the views"
    body screen { code "console" { source = <<'SH'
$ wcl wdoc build wdoc/book/main.wcl  --out out/book
$ wcl wdoc skill wdoc/skill/main.wcl --out out/skill
SH
    } }
    body steps { p "Project the one model into its two views: the book (a human-readable wdoc site) and the skill (a Claude Code skill folder), both from the same data with nothing hand-duplicated." }
  }

  verification = "`wcl check wskill.wcl` passes, and `out/book/` and `out/skill/` are written from the new model."
}
