procedure creating_a_wskill {
  title   = "Creating a new wskill"
  purpose = "Start a new wskill for a topic from the wcl template and set its topic."
  preconditions = ["WCL installed — see the [WCL wskill](../wcl/) to install it."]
  related = [wskill_concept, datapresentation, selfcontained]
  audience = :both

  step scaffold { n = 1
    title = "Scaffold from the template"
    body screen { code "console" { source = <<'SH'
$ wcl init wskill docs/wskills/<topic>
$ cd docs/wskills/<topic>
SH
    } }
    body steps { p "Run `wcl init wskill <path>` to scaffold the folder — `wskill.wcl`, the `schema/`, the `wdoc/` templates and an empty `data/`. Don't hand-create it." }
  }

  step set_topic { n = 2
    title = "Set the topic"
    body screen { code "wcl" { source = <<'WCL'
topic <id> {
  name    = "<Topic name>"
  summary = "<One-line description of the topic.>"
  version = "1.0.0"
  created = "<YYYY-MM-DD>"
}
WCL
    } }
    body steps { p "Edit `wskill.wcl` and fill in the single `topic` block — its `id`, `name` and `summary` describe the whole wskill." }
  }

  scaffold -> set_topic
}
