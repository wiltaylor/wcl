// Entities — concrete things in the wskill world: the output artifacts the two
// projections (plus collections) produce. Each entity's body describes the artifact
// and links to the concepts that explain it.

entity the_book {
  name     = "book"
  kind     = "output artifact"
  summary  = "The human-readable wdoc site — the comprehensive reference someone reads."
  related  = [datapresentation]
  body {
    p "Built with `wcl wdoc build wdoc/book/main.wcl --out out/book`, the book is a static wdoc site under `out/book/`. Its chapters group the four units under Reference, then tutorials, glossary, related skills, bundled files and sources."
    table {
      header = ["Aspect", "Value"]
      rows = [
        ["Built by", "wcl wdoc build"],
        ["Output",   "out/book/ — a static HTML site"],
        ["Audience", "humans reading the comprehensive reference"],
      ]
    }
  }
}

entity the_skill {
  name     = "skill"
  kind     = "output artifact"
  summary  = "The Claude Code skill — a SKILL.md plus reference files an agent loads."
  related  = [datapresentation, artifacts]
  body {
    p "Built with `wcl wdoc skill wdoc/skill/main.wcl --out out/skill`, the skill is a folder under `out/skill/`: the start page becomes `SKILL.md` and every other page a file under `references/`. The bundled scaffold template trees ship alongside under `assets/`."
    table {
      header = ["Aspect", "Value"]
      rows = [
        ["Built by", "wcl wdoc skill"],
        ["Output",   "out/skill/ — SKILL.md + references/ + assets/ (template trees)"],
        ["Audience", "an agent working with the topic"],
      ]
    }
  }
}

entity wskill_registry {
  name     = "wskill registry"
  kind     = "collection"
  summary  = "A collection of many wskills under one landing page — built into a single hostable deploy tree."
  related  = [wskill, the_book]
  body {
    p "The wskill registry is a collection: many member wskills under a `wskills/` subdirectory with a top-level landing page. Building it — `wcl wdoc build wdoc/page/main.wcl --out out/site` — auto-discovers each member through the landing page's `include` and produces one hostable static site: `index.html` at the root, and each member's book under `wskills/<name>/`, linked relatively."
  }
}

entity wskill {
  name    = "wskill"
  kind    = "document"
  summary = "One self-contained folder that captures a topic as a WCL data model and projects it into a human book and a Claude Code skill."
  related = [the_book, the_skill, wskill_registry]
  body {
    p "A wskill is one self-contained folder: a WCL data model (concepts, entities, facts, terms, examples, tutorials, processes) plus the base schema and the wdoc templates that project it. It renders two ways — the book and the skill — from the one model with nothing hand-duplicated, and many wskills gather into a wskill registry."
  }
}

// The maintainer, modelled as an entity so the overview's Maintainer field can link
// to their details. Book-only — an agent working with the topic doesn't need it.
entity wil_taylor {
  name     = "Wil Taylor"
  kind     = "maintainer"
  summary  = "Maintainer of this wskill."
  audience = :book
  body {
    p "Wil Taylor authors and maintains this wskill."
    table {
      header = ["Field", "Value"]
      rows = [
        ["Name",   "Wil Taylor"],
        ["Role",   "Maintainer"],
        ["GitHub", "[github.com/wiltaylor](https://github.com/wiltaylor)"],
      ]
    }
  }
}

// The command-line tool the wskill toolchain rests on. Tutorials link here from
// their prerequisites.
entity wcl {
  name    = "WCL"
  kind    = "tool"
  summary = "The WCL language CLI and its wdoc renderer — the engine every wskill is built on."
  body {
    p "WCL is the data/config language; `wdoc` is its document renderer. The wskill toolchain shells out to it: `wcl check` validates a model against the schema, `wcl wdoc build` produces the book, and `wcl wdoc skill` produces the skill. Install it so the `wcl` command is on your PATH."
    table {
      header = ["Field", "Value"]
      rows = [
        ["Provides",   "wcl check · wcl wdoc build · wcl wdoc skill"],
        ["Needed for", "validating and rendering a wskill"],
        ["Check",      "`wcl --version`"],
      ]
    }
  }
}
