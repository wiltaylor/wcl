// Worked examples. Each projects onto a unit via `unit = <concept/entity/fact id>`
// and renders on that unit's page (there is no standalone Examples section). Code is
// in raw heredocs so it renders verbatim.

example scaffold_cmd {
  title     = "Starting a new wskill"
  unit      = wskill_concept
  audience  = :both
  narrative = "Create a fresh wskill folder with the built-in template, then check and render."
  code_lang = "console"
  code = <<'SH'
$ wcl init wskill docs/wskills/git      # prompts: topic id, name, summary, optional views
$ cd docs/wskills/git
$ wcl check wskill.wcl                  # must pass
$ just render                           # out/book + out/skill (+ any optional views)
SH
  expected = "A docs/wskills/git/ folder with schema, templates, and data skeleton; wcl check passes; out/ holds every shipped view."
}

example misfiled_entity {
  title     = "Misfiled as an entity — and the fix"
  unit      = unit_decision_guide
  audience  = :both
  narrative = "The classic mistake: an idea filed as an entity. The kind field has no honest answer, which is the tell."
  code_lang = "wcl"
  code = <<'WCL'
// WRONG — a behaviour isn't a named thing; no EntityKind fits:
entity fast_forward {
  name = "Fast-forward merge"
  kind = :software            // a lie — and the closest kind available
}

// RIGHT — it's an idea to understand:
concept fast_forward {
  name    = "Fast-forward merge"
  summary = "Advancing a branch pointer when history hasn't diverged."
  body { p "When the target already contains the source's history, Git just moves the pointer." }
}
WCL
  expected = "The wrong form either fails wcl check (no plausible kind) or reads as a lie; the concept form checks clean and files where readers look for ideas."
}

example audience_tagging {
  title     = "Opting units into the skill"
  unit      = audience_control
  audience  = :both
  narrative = "The default keeps content out of the AI skill; tag what the agent needs."
  code_lang = "wcl"
  code = <<'WCL'
concept fast_forward { audience = :both  ... }   // book + skill
fact   port_table    { audience = :ai    ... }   // skill only
concept history      { ... }                     // :book default — book only
WCL
  expected = "The skill's references/ contains fast_forward and port_table but not history; the book shows fast_forward and history."
}

example typed_extension {
  title     = "A typed custom block"
  unit      = custom_projection
  audience  = :both
  narrative = "Declare an @block plus a @document that gathers it; imported documents merge with the base. Then add a render to both template sets."
  code_lang = "wcl"
  code = <<'WCL'
@block("keybinding")
type Keybinding {
  @inline(0) id: identifier
  keys:     utf8
  action:   utf8
  context:  utf8?
}

@document
type Extensions {
  @children("keybinding") keybindings: list<Keybinding>
}
WCL
}

example slide_authoring {
  title     = "Authoring a slide that features a unit"
  unit      = presentation_view
  audience  = :both
  narrative = "A slide names a unit; the projection pulls its headline and summary — the detail stays in the book."
  code_lang = "wcl"
  code = <<'WCL'
presentation intro {
  summary = "One-line deck subtitle."
  pres_section what {
    title = "What & why"
    pres_slide opening {
      unit = wskill_concept
      speaker_notes = "Open with the one-folder, many-views idea."
    }
  }
}
WCL
  expected = "The built deck shows a slide headed with the unit's name and its summary in italics, plus your notes under `s`."
}

example lesson_authoring {
  title     = "A lesson with a verifiable exercise"
  unit      = training_view
  audience  = :both
  narrative = "Every lesson ends in an exercise whose expected result the learner can check."
  code_lang = "wcl"
  code = <<'WCL'
lesson first_render {
  n          = 1
  title      = "Render your first book"
  objectives = ["Build a wskill book and find a unit's page"]
  related    = [views]
  body { p "The book is one `just` recipe away." }
  exercise build_it {
    title     = "Build the book"
    task      = "Render the book projection and open it."
    code_lang = "bash"
    code      = "just book-build && open out/book/index.html"
    expected  = "The browser shows the topic overview with your units in the sidebar."
  }
}
WCL
}

example registry_include {
  title     = "A registry landing that discovers members"
  unit      = collections_registries
  audience  = :both
  narrative = "File-based discovery: include builds every member; included_sites feeds the cards. No member list to maintain."
  code_lang = "wcl"
  code = <<'WCL'
include "../../wskills" { entry = "wdoc/book/main.wcl" }
include "../../wskills" { entry = "wdoc/presentation/main.wcl"  prefix = "decks" }

let wskills = included_sites({ folder: "../../wskills", entry: "wdoc/book/main.wcl" })
wdoc_repeater { each = wskills  as = :s
  p $"[**${s.title}**](./${s.href})${match s.summary { none => "", su => $" — ${su}" }}"
}
WCL
  expected = "Each member's book builds under wskills/<name>/ and lists on the landing; members shipping a deck also build under decks/<name>/."
}

example component_reuse {
  title     = "One component, every projection"
  unit      = components_look_feel
  audience  = :both
  narrative = "The book and the skill invoke the same component with different slot values — page structure lives once."
  code_lang = "wcl"
  code = <<'WCL'
// wdoc/book/main.wcl
concept_body { unit = c  examples = examples  all_units = all_units
               backlinks = referenced_by(c.id)  layout = "columns" }

// wdoc/skill/main.wcl — same component, skill-flavoured slots
concept_body { unit = c  examples = examples  all_units = all_units  backlinks = []
  p "[← All concepts](concepts_ref) · [← Back to SKILL.md](index)"
}
WCL
}

example install_skill {
  title     = "Installing the skill into a repo"
  unit      = skill_anatomy
  audience  = :both
  narrative = "After rendering, copy the skill projection into a repo's .claude/skills/."
  code_lang = "console"
  code = <<'SH'
$ cp -r docs/wskills/git/out/skill .claude/skills/git
SH
  expected = "out/skill/ is copied to .claude/skills/git/ (use the name from the rendered SKILL.md frontmatter)."
}
