entity the_book {
  name     = "book"
  kind     = "output artifact"
  summary  = "The human-readable wdoc site — the comprehensive reference someone reads."
  related  = [datapresentation]
  body {
    p "Built with `wcl wdoc build wdoc/book/main.wcl --out out/book`, the book is a static wdoc site under `out/book/`. Its chapters group the four units under Reference, then tutorials, glossary, related skills, bundled files and sources."
    table {
      header = ["Aspect", "Value"]
      rows = [
        ["Built by", "wcl wdoc build"],
        ["Output",   "out/book/ — a static HTML site"],
        ["Audience", "humans reading the comprehensive reference"],
      ]
    }
  }
}
