concept concept {
  name     = "Concept"
  summary  = "A unit that captures an idea or mental model of something."
  audience = :both
  related  = [entity, fact, process, datapresentation]
  body {
    p <<BODY
      A concept is a unit of knowledge that describes an idea of something. This is usually an idea,
      a mental modal.
    BODY

    p <<BODY
      Some examples of a concept are: A mental modal, mathimatical process or a software pattern.
    BODY
  }
}
