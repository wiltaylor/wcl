concept entity {
  name     = "Entity"
  summary  = "An entity is a unit of knowledge that is a noun and an actual instance of something."
  related  = [concept, fact, process, permanent_note]
  body {
    p <<BODY
      An entity is a unit of knowledge that is a noun and an actual instance of something.
    BODY

    p <<BODY
      Some examples of entities are people, software, an organisation.
    BODY
  }
}
