fact template_example {
  title    = "Template — example"
  audience = :both
  related  = [template_concept, writing_style]
  body {
    p "An **example** is a worked sample that belongs to another unit. It is not a section of its own: `unit` names the concept, entity or fact it illustrates, and the templates render it on that unit's page, after the body. Use it when a sample is long enough to interrupt the prose, and inline `code` blocks otherwise."

    h2 "Skeleton"
    code "wcl" { source = <<'SRC'
// data/reference/examples.wcl — examples usually share one file
example <id> {
  title     = "<What the sample demonstrates>"
  unit      = <owning concept/entity/fact id>
  narrative = "<One sentence framing the sample.>"
  code_lang = "<wcl|console|python|…>"
  code = <<'CODE'
<the sample — runnable, not a fragment>
CODE
  expected  = "<What the reader should see, or what the sample produces.>"
  audience  = :both
}
SRC
    }

    h2 "Fields"
    table {
      header = ["Field", "What goes in it"]
      rows = [
        ["`unit`", "The id of the unit this renders on. A typo here silently drops the example from every page — nothing references it and no page shows it"],
        ["`title`", "What the sample demonstrates, not what it contains"],
        ["`narrative`", "One sentence before the code. If it needs a paragraph, the explanation belongs in the owning unit"],
        ["`code`", "A raw heredoc (`<<'CODE'`), so backslashes and `${…}` survive verbatim"],
        ["`expected`", "The result. An example whose outcome is left to the reader's imagination is decoration"],
      ]
    }

    h2 "Filled example"
    code "wcl" { source = <<'SRC'
example ex_pipe_table {
  title     = "Pipe-table rows"
  unit      = tables
  narrative = "A @table row type plus a colon-introduced field lets rows be written like a spreadsheet."
  code_lang = "wcl"
  code = <<'CODE'
@table("user")
type User {
  name:    utf8
  age:     u32
  enabled: bool
}

users:
  | "alice" | 30 | true  |
  | "bob"   | 25 | false |
CODE
  expected  = "Each `| … |` row becomes one `User` record in `users: list<User>`."
  audience  = :both
}
SRC
    }

    h2 "Done when"
    list {
      li "`unit` names a unit that exists — check the rendered page actually shows the example."
      li "The sample runs. Paste it into the real tool before committing it."
      li "`expected` states the outcome."
      li "It illustrates one thing; two ideas mean two examples."
    }
  }
}
