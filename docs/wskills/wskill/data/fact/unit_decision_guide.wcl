# The classification guard — THE reference for filing a piece of knowledge as
# the right unit kind. Referenced from the skill boundary, so agents consult
# it before creating units instead of defaulting everything to `entity`.

fact unit_decision_guide {
  title = "Which unit kind? — the decision guide"
  audience = :both
  related = [{ id: "concept", why: "Concept supports Which unit kind? — the decision guide: A unit that captures an idea or mental model of something." }, { id: "entity", why: "Entity supports Which unit kind? — the decision guide: A concrete NAMED thing in the topic's world — a person, software, a place, an organisation. Reserved: never a catch-all." }, { id: "fact", why: "Fact supports Which unit kind? — the decision guide: A unit that holds factual data — a value, a constant, a value table." }, { id: "process", why: "Process supports Which unit kind? — the decision guide: A unit (authored as a procedure) that captures the reliable sequence for doing a task — ordered steps, for someone who already knows the topic." }]
  body {
    p <<DOC
      File every atomic note as the kind it *is* — not the kind that feels convenient. The most
      common mistake is treating `entity` as a catch-all: entities are reserved for concrete
      NAMED things (a person, a piece of software, a place, an organisation, a file format).
      An idea is never an entity. A table of values is never an entity.
    DOC

    h2 "The decision path"
    diagram {
      width = 720
      height = 700
      layout = :layered
      direction = :top_to_bottom
      layer_gap = 26.0
      node_gap = 30.0
      terminator "A piece of knowledge" {
        id = "g_start"
        width = 180.0
        height = 44.0
      }
      decision "A repeatable task, done in steps?" {
        id = "g_task"
        width = 210.0
        height = 78.0
      }
      process "process" {
        id = "g_process"
        width = 130.0
        height = 44.0
      }
      decision "A concrete thing with a name of its own?" {
        id = "g_named"
        width = 220.0
        height = 78.0
      }
      process "entity" {
        id = "g_entity"
        width = 130.0
        height = 44.0
      }
      decision "Is it a constant value or verifiable value?" {
        id = "g_fact_or_concept"
        width = 130.0
        height = 44.0
      }
      process "fact" {
        id = "g_fact"
        width = 130.0
        height = 44.0
      }
      process "concept" {
        id = "g_concept"
        width = 130.0
        height = 44.0
      }

      g_start -> g_task
      g_task -> g_process :yes
      g_task -> g_named :no
      g_named -> g_fact_or_concept :no
      g_named -> g_entity :yes
      g_fact_or_concept -> g_fact :yes
      g_fact_or_concept -> g_concept :no
    }

    h2 "By symptom"
    table {
      header = ["The note is…", "Kind", "Test"]
      rows = [["A way of thinking, a pattern, a mental model, an explanation of *why*", "`concept`", "You'd say \"the reader must **understand** this\""], ["A person, an organisation, a tool, an application, a file format, a place", "`entity`", "It has a proper name and you could point at it; a kind from `schema/kinds.wcl` fits"], ["A default value, a limit, a table of options, a version matrix", "`fact`", "Nobody argues with it — you'd cite it, not explain it"], ["A task someone performs: install, upgrade, review, publish", "`process`", "It has steps in an order and a way to verify it worked"]]
    }

    h2 "Wrong vs right"
    table {
      header = ["Tempting (wrong)", "Correct", "Why"]
      rows = [["`entity fast_forward` for Git's fast-forward merge", "`concept fast_forward`", "It's a behaviour to understand, not a named thing you can point at"], ["`entity default_ports` holding a port table", "`fact default_ports` with a `table` body", "Values belong in facts; a reference table is a fact whose body is a table"], ["`concept installing` describing install steps", "`process installing` with real `step`s", "Steps in an order are a process — a concept can't be verified or followed"], ["`fact git` describing what Git is", "`entity git { kind = :software }`", "A named piece of software is exactly what entities are for"], ["One giant `concept overview` covering everything", "Several atomic units linked via `related`", "One idea per unit — split until each note holds exactly one"]]
    }
  }
}
