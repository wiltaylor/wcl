// Curated navigation — every unit pinned into a topic-meaningful tree via
// `index` blocks. In the book each index is a heading in the sidebar whose
// children are the units it lists in `related` (resolved to their unit pages);
// a nested `index` adds a sub-branch. Indexes default to the `:book` audience,
// so they shape the book nav while the skill keeps its per-kind reference lists.

index what {
  name = "WSkill"
  summary = "wskill"
  related = [wskill_concept, why_use_wskill, creating_a_wskill, building_the_index, setup_ai_skill, decomposing_information, structured_data, assets]
}

index philosophy {
  name    = "Philosophy"
  summary = "The principles the wskill format is built on."
  related = [datapresentation, selfcontained, atomic_note]
}

index wskill_reference {
  name    = "Reference"
  summary = "The wskill schema and the unit kinds it captures."
  related = [concept, entity, fact, process, index]

  index schema_blocks {
    name    = "Schema blocks"
    summary = "Every block type in the schema, reflected from the live definition — one page each."
    related = [block_topic, block_skill, block_source, block_wskill_ref, block_concept, block_entity, block_fact, block_index, block_term, block_example, block_procedure, schema_internals]
  }
}

// Skill-only navigation. The skill's SKILL.md is driven entirely by the
// `:ai`/`:both` indexes (there are no per-kind reference pages there), so this
// index curates the runbooks an agent reaches for. `:ai` keeps it out of the
// book, whose nav already lists these processes under the indexes above.
index skill_tasks {
  audience = :ai
  name     = "Task runbooks"
  summary  = "Step-by-step runbooks for building and maintaining a wskill."
  related  = [creating_a_wskill, building_the_index, setup_ai_skill, updating_a_wskill]
}

