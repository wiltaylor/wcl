// wad wskill custom block types — the interview question bank and the
// codebase-scan probes as first-class data, so the "quiz the user" and
// "scan the code" behaviours are queryable rows rather than prose. The two
// checklist facts render them with repeater tables, and the population
// processes walk them view by view.
namespace wcl.wskill

// One question the design interview asks. `view` names the WAD view the
// answer files under (overview / context / …); `maps_to` names the block
// (and field) the answer becomes.
@block("interview_q")
type InterviewQ {
  @inline(0) id: identifier
  view:     utf8            // WAD view the answer belongs to
  question: utf8
  maps_to:  utf8            // target block (and field) the answer populates
  @default(true) required: bool   // false = ask only when relevant
}

// One probe of the codebase scan: what to read, what to emit, and what to
// ask the user when the source can't answer.
@block("scan_probe")
type ScanProbe {
  @inline(0) id: identifier
  view:    utf8
  look_at: utf8             // files / commands to inspect
  emit:    utf8             // block kinds the findings become
  ask_if_missing: utf8?     // the follow-up question when the code is silent
}

@document
type WadWskillExtensions {
  @children("interview_q") interview_qs: list<InterviewQ>
  @children("scan_probe")  scan_probes:  list<ScanProbe>
}
