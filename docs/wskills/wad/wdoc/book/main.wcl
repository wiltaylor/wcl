// Book projection — human-readable wdoc site over the wskill data model.
//
// Build:  wcl wdoc build wdoc/book/main.wcl --out out/book
//
// Entry only: the topic's model, then the shared book template embedded in the
// toolchain (`crates/wcl_wskill/lib/book.wcl`). To diverge from it, drop the
// `<wskill/book.wcl>` line and declare the site + page repeaters here,
// enumerating the parts you still want (`<wskill/component/*.wcl>`,
// `<wskill/pages/*.wcl>`) — nothing shadows, so what you don't import is
// simply yours to write.

import "../../wskill.wcl"
import <wskill/book.wcl>
