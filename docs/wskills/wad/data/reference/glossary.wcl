// Glossary — the WAD vocabulary.

term g_wad        { term = "WAD"           definition = "Wil's Architecture Document — a typed WCL data model of a software system, rendered into a twelve-chapter book." }
term g_view       { term = "view"          definition = "One of the twelve fixed chapters of a WAD book; every data block files under exactly one." }
term g_container  { term = "container"     definition = "C4 level 2 — an independently runnable/deployable unit: a service, database, web app, CLI (not a Docker container, though one may be). The kind lives in the wcl.wad namespace, so it never collides with wdoc's diagram shape." }
term g_code_item  { term = "code item"     definition = "C4 level 4 — a typed, extractor-generated diagram of a public interface: module graph, DB schema, class diagram, or API surface." }
term g_relation   { term = "relation"      definition = "A directed, typed edge between two node ids; the single source every derived diagram draws from." }
term g_rollup     { term = "roll-up"       definition = "Lifting relation endpoints to a coarser level (component → container → system) so higher-level diagrams derive instead of being re-drawn." }
term g_node_space { term = "node space"    definition = "The shared id namespace of systems, containers, components, externals, personas, environments, infra nodes and screens — what relation endpoints resolve against." }
term g_extractor  { term = "extractor"     definition = "A uv single-file Python script that reads a live source of truth and fully overwrites one WCL file under data/generated/." }
term g_generated  { term = "generated data" definition = "Extractor-owned, committed data files — never hand-edited; hand data may reference their ids." }
term g_adr        { term = "ADR"           definition = "Architecture decision record — a dated, statused `adr` block: context, decision, consequences." }
term g_raci       { term = "RACI"          definition = "Responsible / Accountable / Consulted / Informed — one `raci_entry` row per activity, four stakeholder-id lists." }
term g_sop        { term = "SOP"           definition = "Standard operating procedure — a step-based `sop` block whose `from -> to` flow renders as a flowchart."  aliases = ["runbook"] }
term g_spec       { term = "spec"          definition = "A work package for an AI coding agent — the implementation detail for part of the system, decomposed from the WAD; carried through planning → in_progress → complete / abandoned." }
term g_baseline   { term = "baseline"      definition = "The recorded git revision of the last reviewed WAD — what `wcl wad spec --from` diffs against." }
term g_persona    { term = "persona"       definition = "A kind of user — human, service, or AI agent — with goals and access grants." }
term g_gather     { term = "gather list"   definition = "The list an @document field collects (`systems`, `adrs`) — what the book templates repeat over." }
