// Indexes — the wskill's navigation. Top-level indexes are menu sections;
// child indexes are sub-groups whose `related` units pin directly into the
// sidebar (book) and list (skill).
//
// Section order: the AI mode dispatcher first, then the doc-mode (WAD)
// sections; the plan/issue/build workflow indexes follow from their own
// data files (import order in wskill.wcl).

// AI entry point: route by mode, then follow that mode's runbooks.
index skill_tasks {
  name    = "Modes"
  summary = "Start here: route the request to a mode, then follow its workflow. plan = new software (start with proc_starting_a_plan). issue = change existing software (proc_issue_pipeline; trivial single-file fixes skip the pipeline — see issue_mode). build = execute a rendered plan (fact_roles, then proc_orchestrator_loop). doc = the WAD itself (populate_strategies dispatches between interview, scan, and extractors)."
  audience = :ai
  related = [lifecycle,
             proc_starting_a_plan, proc_issue_pipeline, proc_orchestrator_loop,
             populate_strategies, creating_a_wad, designing_new_system,
             documenting_existing_system, writing_extractor, reviewing_a_wad,
             evolving_and_spec, keeping_wad_current,
             interview_question_bank, scan_checklist]
}

index what_section {
  name    = "What a WAD is"
  summary = "The format, its views, and how it is consumed."
  audience = :both
  related = [what_is_a_wad, twelve_views, c4_drilldown, consumption_modes, creating_a_wad]
}

index model_section {
  name    = "The data model"
  summary = "How the model is organised, and the block reference per view."
  audience = :both

  index model_structure {
    name    = "Structure"
    audience = :both
    related = [wad_layout, data_vs_presentation, generated_vs_hand, relations_model, wad_kinds,
               extensions_worked_example]
  }
  index model_views {
    name    = "Blocks by view"
    audience = :both
    related = [overview_blocks, context_blocks, external_blocks, system_blocks, infra_blocks,
               build_deploy_blocks, documentation_blocks, persona_blocks, sysadmin_blocks,
               standards_blocks, domain_blocks, spec_blocks]
  }
}

index populating_section {
  name    = "Populating a WAD"
  summary = "The interview, the codebase scan, and the extractor scripts."
  audience = :both
  related = [populate_strategies, designing_new_system, documenting_existing_system,
             interview_question_bank, scan_checklist,
             writing_extractor, extractor_anatomy]
}

index change_section {
  name    = "Review & change"
  summary = "Reviewing the book, deriving specs from diffs, staying current, and how the four modes hand off."
  audience = :both
  related = [spec_lifecycle, living_wad, lifecycle, reviewing_a_wad, evolving_and_spec,
             keeping_wad_current, wcl_diff_wad]
}

index reference_section {
  name    = "Reference"
  summary = "Commands, standards, and tools."
  related = [wad_cli, wcl_init_wad, arc42, c4_model, uv, glossary]
}

