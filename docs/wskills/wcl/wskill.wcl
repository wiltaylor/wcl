// WCL — wskill root document.
//
// A complete reference for the WCL configuration/schema language and its `wcl`
// command-line interface. `wcl check wskill.wcl` validates the whole model; the
// wdoc template sets in wdoc/ project it into the book and the skill.

import <wdoc.wcl>
import "./schema/base.wcl"
import "./schema/extensions.wcl"
import "./schema/language.wcl"          // opt-in: describe WCL as data (projected into the book)
import "./schema/cli.wcl"               // opt-in: map the wcl CLI as data

// Data — reference units, glossary, examples and processes.
import "./data/reference/concepts.wcl"
import "./data/reference/facts.wcl"
import "./data/reference/glossary.wcl"
import "./data/reference/examples.wcl"
import "./data/reference/quickstart.wcl"
import "./data/reference/cli.wcl"
import "./data/reference/language.wcl"
import "./data/processes/processes.wcl"

schema_version = "1.1.0"

topic wcl {
  name    = "WCL"
  summary = "A typed configuration and schema language: records, unions, interfaces, decorators, and a document model that gathers and validates structured data."
  version = "0.24.1-alpha"
  description = <<END
WCL is a strongly-typed configuration language. You declare **record types** with
the `type` keyword, give them constraints and defaults with **prefix decorators**
(`@default`, `@min`, `@block`, `@inline`, …), and compose a **document** whose root
`@document` type gathers every block instance for validation and projection. Values
range over a rich primitive set (integers with bit-width suffixes, floats, UTF-8
strings with heredocs and interpolation, symbols, booleans, identifiers) and
composites (lists, tensors, pipe-tables, optionals, unions, references). The `wcl`
CLI parses, checks, evaluates, formats and scaffolds WCL, and drives the **wdoc**
static-site / skill generator.
END
  tags = ["wcl", "configuration", "schema", "language", "dsl"]
  created    = "2026-06-20"
  maintainer = "ai@wiltaylor.dev"
}

// Skill-projection config (→ SKILL.md frontmatter). No bundled artifacts.
wcl.wskill::skill {
  summary {
    overview = [
      "WCL is a typed configuration & schema language. This skill captures its full reference as data — the language, the builtin library, and the `wcl` CLI — projected from one model.",
    ]
  }
  skill_param "$ARGUMENTS" {
    description = "The WCL topic, builtin, or `wcl` subcommand to look up."
    value       = "Take it from the user's request — e.g. the function name, type, or subcommand they asked about. If empty, summarise the reference and ask what they need."
  }
  skill_param "$1" {
    description = "Optional area to scope the answer to: `language`, `builtins`, or `cli`."
    value       = "Infer from the question; default to searching all areas when unset."
  }
  skill_boundary {
    always = ["Cite the exact reference page when answering.", "Prefer the documented builtin/CLI form over guesses."]
    ask    = ["Before running `wcl set` or any command that edits files."]
    never  = ["Invent builtins, flags, or syntax that aren't in the reference."]
  }
}

// ---- Sources (update-workflow metadata only) ----

source wcl_docs {
  kind         = "docs"
  locator      = "/home/wil/dev/WCL/docs/pages/reference"
  covers       = "The authoritative WCL reference site: a page per language feature, the CLI, and builtins."
  last_checked = "2026-06-20"
  reflects_version = "0.24.1-alpha"
}

source wcl_repo {
  kind         = "repo"
  locator      = "/home/wil/dev/WCL"
  covers       = "Source of truth for WCL: the parser, evaluator, CLI, and wdoc stdlib (crates/wcl_wdoc/lib)."
  last_checked = "2026-06-20"
  reflects_version = "0.24.1-alpha"
}

source wcl_cli {
  kind         = "cli"
  locator      = "wcl --help"
  covers       = "Subcommand help text for parse/check/eval/set/fmt/repl/lsp/init/wdoc/diff."
  last_checked = "2026-06-20"
  reflects_version = "0.24.1-alpha"
}

// ---- Cross-references to other wskills ----

wskill_ref wdoc {
  name     = "wdoc"
  relation = "wdoc is WCL's document/projection system, driven by the wcl CLI"
  status   = "exists"
}
