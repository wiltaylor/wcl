procedure upgrading_with_wcl {
  title   = "Upgrade a document when WCL moves"
  purpose = "Bring a WCL model back in sync after installing a newer wcl release."
  preconditions = ["A model with `source` blocks recording `reflects_version`, and a newly-installed `wcl` binary."]
  related = [cli, wcl_cli, validate_format]
  audience = :both

  step compare_versions { n = 1
    title = "Compare recorded and installed versions"
    body screen {
      code "console" { source = <<'SH'
$ wcl --version
wcl 0.25.0-alpha
$ grep reflects_version wskill.wcl
  reflects_version = "0.24.1-alpha"
SH
      }
    }
    body steps { p "Read each source's `reflects_version` and compare it against the installed `wcl --version`. If they already match, stop — there is nothing to upgrade. Otherwise every source that lags marks content to re-verify." }
  }

  step recheck { n = 2
    title = "Re-run wcl check on the model"
    body screen {
      code "console" { source = <<'SH'
$ wcl check wskill.wcl
SH
      }
      callout "Exit codes" { class = ["info"]  body = "0 = valid, 1 = parse error, 2 = schema violation — a new release can tighten either." }
    }
    body steps { p "Run `wcl check` on the model's root document with the new binary. A release can add constraints, change builtin behaviour, or deprecate syntax, so a file that was clean under the old version may now report errors." }
  }

  step fix_errors { n = 3
    title = "Fix what the new version rejects"
    body screen {
      code "console" { source = <<'SH'
$ wcl check wskill.wcl
ok            # after fixes
SH
      }
    }
    body steps { p "Work through the reported errors — each names the file, span, and rule. Fix the source (not the schema, unless the release genuinely changed the vocabulary) and re-run `wcl check` until it is clean." }
  }

  step rerender { n = 4
    title = "Re-render the projections"
    body screen {
      code "console" { source = <<'SH'
$ just render
SH
      }
    }
    body steps { p "Rebuild every shipped view so the generated output reflects the upgraded model. Spot-check a page or two — rendering can change even where validation stayed green." }
  }

  step bump_metadata { n = 5
    title = "Bump the version metadata"
    body screen {
      code "console" { source = <<'SH'
$ wcl set wskill.wcl topics.wcl.version '"0.25.0-alpha"'
SH
      }
    }
    body steps { p "Record the upgrade: bump `topic.version`, and update each touched source's `last_checked` date and `reflects_version` to the new release. The next upgrade sweep starts from these fields." }
  }

  compare_versions -> recheck
  recheck -> fix_errors
  fix_errors -> rerender
  rerender -> bump_metadata

  verification = "`wcl check` is clean under the new binary, the projections rebuild, and every source's `reflects_version` matches `wcl --version`."
}
