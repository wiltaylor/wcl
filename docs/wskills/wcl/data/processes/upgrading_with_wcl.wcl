procedure upgrading_with_wcl {
  title = "Upgrade a document when WCL moves"
  purpose = "Bring a WCL model back in sync after installing a newer wcl release."
  preconditions = ["A model with `source` blocks recording `reflects_version`, and a newly-installed `wcl` binary."]
  related = [{ id: "wcl_cli", why: "wcl supports Upgrade a document when WCL moves: The wcl command-line tool: one binary for parsing, checking, editing, formatting, scaffolding, the editor, and wdoc." }]
  audience = :both

  step compare_versions {
    n = 1
    title = "Compare recorded and installed versions"
    body screen {
      code "console" {
        source = <<DOC
          $ wcl --version
          wcl 0.25.0-alpha
          $ grep reflects_version wskill.wcl
            reflects_version = "0.24.1-alpha"
        DOC
      }
    }
    body steps {
      p <<DOC
        Read each source's `reflects_version` and compare it against the installed `wcl --version`.
        If they already match, stop — there is nothing to upgrade. Otherwise every source that lags
        marks content to re-verify.
      DOC
    }
  }

  step recheck {
    n = 2
    title = "Re-run wcl check on the model"
    body screen {
      code "console" {
        source = "$ wcl check wskill.wcl\n"
      }
      callout "Exit codes" {
        class = ["info"]
        body = "0 = valid, 1 = parse error, 2 = schema violation — a new release can tighten either."
      }
    }
    body steps {
      p <<DOC
        Run `wcl check` on the model's root document with the new binary. A release can add
        constraints, change builtin behaviour, or deprecate syntax, so a file that was clean under
        the old version may now report errors.
      DOC
    }
  }

  step fix_errors {
    n = 3
    title = "Fix what the new version rejects"
    body screen {
      code "console" {
        source = <<DOC
          $ wcl check wskill.wcl
          ok            # after fixes
        DOC
      }
    }
    body steps {
      p <<DOC
        Work through the reported errors — each names the file, span, and rule. Fix the source (not
        the schema, unless the release genuinely changed the vocabulary) and re-run `wcl check`
        until it is clean.
      DOC
    }
  }

  step rerender {
    n = 4
    title = "Re-render the projections"
    body screen {
      code "console" {
        source = "$ just render\n"
      }
    }
    body steps {
      p <<DOC
        Rebuild every shipped view so the generated output reflects the upgraded model. Spot-check a
        page or two — rendering can change even where validation stayed green.
      DOC
    }
  }

  step bump_metadata {
    n = 5
    title = "Bump the version metadata"
    body screen {
      code "console" {
        source = "$ wcl set wskill.wcl topics.wcl.version '\"0.25.0-alpha\"'\n"
      }
    }
    body steps {
      p <<DOC
        Record the upgrade: bump `topic.version`, and update each touched source's `last_checked`
        date and `reflects_version` to the new release. The next upgrade sweep starts from these
        fields.
      DOC
    }
  }

  compare_versions -> recheck
  recheck -> fix_errors
  fix_errors -> rerender
  rerender -> bump_metadata

  verification = "`wcl check` is clean under the new binary, the projections rebuild, and every source's `reflects_version` matches `wcl --version`."
}
