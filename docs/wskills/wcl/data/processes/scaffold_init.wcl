procedure scaffold_init {
  title   = "Scaffold a new project with wcl init"
  purpose = "Start a new WCL project from a built-in template instead of an empty file."
  preconditions = ["You have chosen a destination directory that is empty (or will use `--force`)."]
  related = [cli]
  audience = :both

  step 1 {
    title = "List the available templates"
    body screen {
      code "console" { source = <<'SH'
$ wcl init --list
Built-in templates:
  minimal
  page
  book
  presentation
SH
      }
    }
    body steps { p "Run `wcl init --list` to see the built-in templates: `minimal` (a single commented `main.wcl`) plus the multi-folder wdoc projects `page`, `book` and `presentation`." }
  }

  step 2 {
    title = "Scaffold from a template"
    body screen {
      code "console" { source = <<'SH'
$ wcl init minimal ./my-project
Project name [my-project]:
created ./my-project
SH
      }
    }
    body steps { p "Run `wcl init <template> <dest>`, e.g. `wcl init minimal ./my-project`. You are prompted for each `property` the template declares; pass `-D name=value` to answer inline or `--defaults` to skip prompts." }
  }

  step 3 {
    title = "Validate the generated project"
    body screen {
      code "console" { source = <<'SH'
$ wcl check ./my-project/main.wcl
ok
SH
      }
    }
    body steps { p "Change into the new folder and run `wcl check` on its `main.wcl` to confirm the scaffold validates before you start editing." }
  }

  verification = "The destination contains the template's files and `wcl check` on its entry `main.wcl` exits 0."
}
