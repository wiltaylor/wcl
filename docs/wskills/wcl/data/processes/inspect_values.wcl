procedure inspect_values {
  title = "Inspect and edit values with eval, set and diff"
  purpose = "Read a single field, change it from the command line, and confirm exactly what changed."
  preconditions = ["A valid WCL file whose fields you want to read or edit."]
  related = [wcl_cli]
  audience = :both

  step read {
    n = 1
    title = "Read a field with eval"
    body screen {
      code "console" {
        source = <<DOC
          $ wcl eval site.wcl service.web.port
          80
        DOC
      }
    }
    body steps {
      p <<DOC
        Run `wcl eval site.wcl <dotted.path>` (aliased `wcl get`) to resolve a path from the
        document root and print its value. Add `--json` for machine-readable output.
      DOC
    }
  }

  step edit {
    n = 2
    title = "Edit a field with set"
    body screen {
      code "console" {
        source = "$ wcl set site.wcl service.web.port 9090u32\n"
      }
      callout "Quoting" {
        class = ["warning"]
        body = "The value is parsed as a WCL expression — quote shell-special characters, e.g. `wcl set site.wcl name '\"alpha\"'`."
      }
    }
    body steps {
      p <<DOC
        Run `wcl set site.wcl <path> <value>` to rewrite the field. `wcl set` follows the import
        chain and edits the file that actually declares the field.
      DOC
    }
  }

  step confirm {
    n = 3
    title = "Confirm the change with diff"
    body screen {
      code "console" {
        source = <<DOC
          $ wcl diff HEAD:site.wcl site.wcl
          modified "service:web" {
            field "port" { kind = :changed  old = 80u32  new = 9090u32 }
          }
        DOC
      }
    }
    body steps {
      p <<DOC
        Run `wcl diff <old> <new>` over the evaluated views to see exactly what changed. Either side
        may be a `<rev>:<path>` git specifier, so you can diff the working tree against a committed
        version.
      DOC
    }
  }

  read -> edit
  edit -> confirm

  verification = "`wcl eval` returns the new value and `wcl diff` reports a single modified field — confirming the edit landed where you intended."
}
