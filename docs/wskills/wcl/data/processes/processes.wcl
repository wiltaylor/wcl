// Processes for WCL — runbooks for doing a task with the `wcl` CLI. Each step
// stores two addressable body fragments: `body screen { … }` (what's on screen)
// and `body steps { … }` (the action).

procedure validate_format {
  title   = "Validate and format a WCL file"
  purpose = "Confirm a file conforms to its schema, then normalise its layout before committing."
  preconditions = ["The file and any files it imports are on disk."]
  related = [cli, schema]
  audience = :both

  step 1 {
    title = "Check it parses and validates"
    body screen {
      code "console" { source = <<'SH'
$ wcl check config.wcl
ok
SH
      }
      callout "Exit codes" { class = ["info"]  body = "0 = valid, 1 = parse error, 2 = schema violation. Script against these for CI gates." }
    }
    body steps { p "Run `wcl check config.wcl`. A clean run prints `ok` and exits 0; fix any reported parse or schema errors before moving on." }
  }

  step 2 {
    title = "Format in place"
    body screen {
      code "console" { source = <<'SH'
$ wcl fmt config.wcl --in-place
SH
      }
    }
    body steps { p "Run `wcl fmt config.wcl --in-place` to rewrite the file in canonical form. Indentation, brace style, number radix and string delimiters are normalised; comments and blank-line groupings survive." }
  }

  step 3 {
    title = "Re-check the formatted file"
    body screen {
      code "console" { source = <<'SH'
$ wcl check config.wcl
ok
SH
      }
    }
    body steps { p "Formatting never changes meaning, but re-run `wcl check` as a cheap confirmation that the rewrite is still valid." }
  }

  verification = "`wcl check` prints `ok` and exits 0, and a second `wcl fmt` run produces no further changes."
}

procedure scaffold_init {
  title   = "Scaffold a new project with wcl init"
  purpose = "Start a new WCL project from a built-in template instead of an empty file."
  preconditions = ["You have chosen a destination directory that is empty (or will use `--force`)."]
  related = [cli]
  audience = :both

  step 1 {
    title = "List the available templates"
    body screen {
      code "console" { source = <<'SH'
$ wcl init --list
Built-in templates:
  minimal
  page
  book
  presentation
SH
      }
    }
    body steps { p "Run `wcl init --list` to see the built-in templates: `minimal` (a single commented `main.wcl`) plus the multi-folder wdoc projects `page`, `book` and `presentation`." }
  }

  step 2 {
    title = "Scaffold from a template"
    body screen {
      code "console" { source = <<'SH'
$ wcl init minimal ./my-project
Project name [my-project]:
created ./my-project
SH
      }
    }
    body steps { p "Run `wcl init <template> <dest>`, e.g. `wcl init minimal ./my-project`. You are prompted for each `property` the template declares; pass `-D name=value` to answer inline or `--defaults` to skip prompts." }
  }

  step 3 {
    title = "Validate the generated project"
    body screen {
      code "console" { source = <<'SH'
$ wcl check ./my-project/main.wcl
ok
SH
      }
    }
    body steps { p "Change into the new folder and run `wcl check` on its `main.wcl` to confirm the scaffold validates before you start editing." }
  }

  verification = "The destination contains the template's files and `wcl check` on its entry `main.wcl` exits 0."
}

procedure inspect_values {
  title   = "Inspect and edit values with eval, set and diff"
  purpose = "Read a single field, change it from the command line, and confirm exactly what changed."
  preconditions = ["A valid WCL file whose fields you want to read or edit."]
  related = [cli, references]
  audience = :both

  step 1 {
    title = "Read a field with eval"
    body screen {
      code "console" { source = <<'SH'
$ wcl eval site.wcl service.web.port
80
SH
      }
    }
    body steps { p "Run `wcl eval site.wcl <dotted.path>` (aliased `wcl get`) to resolve a path from the document root and print its value. Add `--json` for machine-readable output." }
  }

  step 2 {
    title = "Edit a field with set"
    body screen {
      code "console" { source = <<'SH'
$ wcl set site.wcl service.web.port 9090u32
SH
      }
      callout "Quoting" { class = ["warning"]  body = "The value is parsed as a WCL expression — quote shell-special characters, e.g. `wcl set site.wcl name '\"alpha\"'`." }
    }
    body steps { p "Run `wcl set site.wcl <path> <value>` to rewrite the field. `wcl set` follows the import chain and edits the file that actually declares the field." }
  }

  step 3 {
    title = "Confirm the change with diff"
    body screen {
      code "console" { source = <<'SH'
$ wcl diff HEAD:site.wcl site.wcl
modified "service:web" {
  field "port" { kind = :changed  old = 80u32  new = 9090u32 }
}
SH
      }
    }
    body steps { p "Run `wcl diff <old> <new>` over the evaluated views to see exactly what changed. Either side may be a `<rev>:<path>` git specifier, so you can diff the working tree against a committed version." }
  }

  verification = "`wcl eval` returns the new value and `wcl diff` reports a single modified field — confirming the edit landed where you intended."
}
