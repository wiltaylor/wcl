concept fields {
  name = "Fields"
  summary = "A field binds a name to a value with `=`; the value is any expression."
  related = [blocks]
  audience = :both
  body {
    p <<DOC
      A field binds a name to a value with `=`. The value is any expression — a literal, a
      reference, a call, or arithmetic over other values.
    DOC
    code "wcl" {
      source = <<DOC
        name    = "alpha"
        count   = 3u32
        enabled = true
        ratio   = count / 2u32
      DOC
    }
    p <<DOC
      Fields are the leaves of a document: everything else — [blocks](concept_blocks), types, schema
      — exists to group and constrain them.
    DOC
  }
}
