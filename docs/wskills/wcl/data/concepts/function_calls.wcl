concept function_calls {
  name     = "Function Calls"
  summary  = "Parentheses call a function or constructor with lazily-evaluated arguments."
  related  = [member_access]
  audience = :both
  body {
    p "Parentheses call a function or constructor. Arguments are expressions, evaluated lazily; the call evaluates the body in a fresh context."
    code "wcl" { source = <<'SRC'
n      = len(items)
total  = sum(map(items, fn(x: i64) -> i64 x * 2))
shape  = Point { x: 1.0, y: 2.0 }
SRC
    }
  }
}
