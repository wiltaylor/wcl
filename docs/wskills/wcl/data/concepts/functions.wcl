concept functions {
  name     = "Functions"
  summary  = "First-class function values — literals, fn items, higher-order, and function types."
  related  = [function_literals, fn_items, higher_order_functions, function_types, expressions, control_flow]
  audience = :both
  body {
    p "Functions are first-class values. They can be bound by `let`, stored in fields, passed as arguments, and returned from other functions."
    p "- [Function Literals](concept_function_literals) — inline `fn(params) -> Return body` values."
    p "- [fn Items](concept_fn_items) — reusable named function declarations."
    p "- [Higher-order Functions](concept_higher_order_functions) — functions that take and return functions."
    p "- [Function Types](concept_function_types) — the `fn(...) -> R` type for callback fields."
  }
}
