concept function_literals {
  name = "Function Literals"
  summary = "Inline `fn(params) -> Return body` function values."
  related = []
  audience = :both
  body {
    p "`fn(params) -> Return body`. The body is a single expression, or a `{ ... }` block expression."
    code "wcl" {
      source = <<DOC
        double = fn(x: i32) -> i32 x * 2
        sum_sq = fn(x: i32, y: i32) -> i32 { let s = x + y; s * s }
      DOC
    }
    p "Bind a literal with `let` (or to a field), then call it like any other function:"
    code "wcl" {
      source = <<DOC
        let double = fn(x: i32) -> i32 x * 2
        let sum_sq = fn(x: i32, y: i32) -> i32 { let s = x + y; s * s }

        four = double(2i32)            // 4
        nine = sum_sq(1i32, 2i32)      // (1 + 2)^2 = 9
      DOC
    }
  }
}
