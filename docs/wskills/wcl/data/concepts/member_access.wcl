concept member_access {
  name     = "Member Access"
  summary  = "A dotted path reads a field from records, variants, and composites."
  related  = [expressions, function_calls, fields_blocks]
  audience = :both
  body {
    p "A dotted path reads a field. Access chains through records, variant payloads, and any composite that exposes named members."
    code "wcl" { source = <<'SRC'
region = service.metadata.region
deep   = config.services.web.metadata.region
SRC
    }
  }
}
