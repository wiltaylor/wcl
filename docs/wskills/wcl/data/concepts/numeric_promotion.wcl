concept numeric_promotion {
  name     = "Numeric Promotion"
  summary  = "Arithmetic and comparison widen mixed numeric operands to a common type."
  related  = [numbers]
  audience = :both
  body {
    h2 "Numeric promotion"
    p "Arithmetic and comparison widen mixed numeric operands to a common type, so cross-width and integer/float mixing work without explicit casts."
    code "wcl" { source = <<'SRC'
a = 1 + 2.0        // i64 widened to f64 -> 3.0
b = 1u32 == 1i64   // true
c = 3.0 * 2u8      // 6.0
SRC
    }
  }
}
