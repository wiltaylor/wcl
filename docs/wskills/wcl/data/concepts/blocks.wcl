concept blocks {
  name = "Blocks"
  summary = "A named group of fields that can also nest other blocks; the schema sets its labels and fields."
  related = [{ id: "fields", why: "Fields supports Blocks: A field binds a name to a value with `=`; the value is any expression." }]
  audience = :both
  body {
    p <<DOC
      A block is a named group of
      [fields](concept_fields) that also lets you nest other blocks under it. The available fields and labels are set by the [block schema](concept_block_schema).
      A block kind may also be namespace-qualified (`wdoc::process { ... }`).
    DOC
    code "wcl" {
      source = <<DOC
        // One label -> name = "web".
        service "web" {
          port   = 8080u32
          region = "us-east-1"
        }
      DOC
    }
    p "Multiple labels work the same way — declare an `@inline` for each position you want to expose:"
    code "wcl" {
      source = <<DOC
        // Two labels -> verb = "GET", path = "/users".
        route "GET" "/users" {
          handler = "list_users"
        }
      DOC
    }
    h2 "Nested blocks"
    p <<DOC
      Blocks can hold further blocks. Nesting depth is unbounded; structure is constrained by the
      schema (`@child` for one, `@children` for many).
    DOC
    code "wcl" {
      source = <<DOC
        service "web" {
          metadata {
            region = "us-east-1"
            tags {
              environment = "prod"
            }
          }
        }
      DOC
    }
  }
}
