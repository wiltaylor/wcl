concept string_interpolation {
  name     = "String Interpolation"
  summary  = "Opt-in with a `$` prefix; `${ ... }` slots splice evaluated expressions into the string."
  related  = [strings, string_literals, string_escapes, heredocs, raw_heredocs, expressions]
  audience = :both
  body {
    h2 "Interpolation"
    p <<PROSE
Interpolation is opt-in: prefix the string literal with `$`. Inside a `$"..."`
(or `$<<TAG`), `${ ... }` slots evaluate any expression and splice the result
into the string. Without the prefix `${...}` is literal text. All four encodings
accept the `$` prefix.
PROSE
    code "wcl" { source = <<'SRC'
greeting = $"Hello, ${name}! Count: ${count + 1u32}"

block = $<<MSG
You have ${len(items)} items waiting.
The first is ${head(items)}.
MSG
SRC
    }
  }
}
