concept if_let {
  name = "if let"
  summary = "Binds and branches in a single step when you only care about a single variant or pattern."
  related = []
  audience = :both
  body {
    p <<DOC
      `if let pattern = value { ... } else { ... }` binds and branches in a single step. Use it when
      you only care about a single variant or pattern.
    DOC
    code "wcl" {
      source = <<DOC
        label = if let Shape::Circle { radius, .. } = s {
          format("circle r={}", radius)
        } else {
          "other"
        }
      DOC
    }
  }
}
