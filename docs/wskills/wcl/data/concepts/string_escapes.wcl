concept string_escapes {
  name     = "String Escapes"
  summary  = "Double-quoted strings interpret backslash escapes; raw heredocs take bytes verbatim."
  related  = [strings, string_literals, heredocs, raw_heredocs, string_interpolation, expressions]
  audience = :both
  body {
    h2 "Escapes"
    p <<PROSE
Inside a double-quoted string the usual escape sequences apply: backslash,
escaped quote, `\n`, `\r`, `\t`. For backslash-heavy text — regexes, LaTeX,
Windows paths — prefer a **raw heredoc** (below).
PROSE
    code "wcl" { source = <<'SRC'
greeting = "Hello,\nworld!"        // newline embedded
quoted   = "She said \"hi\"."
SRC
    }
  }
}
