concept fields_blocks {
  name     = "Fields & Blocks"
  summary  = "The structural backbone — fields bind names to values, blocks group and nest them."
  related  = [fields, blocks, schema, expressions, namespaces]
  audience = :both
  body {
    p "Fields and blocks are the structural backbone of a document. Everything else — types, functions, schema — describes and constrains them."
    p "- [Fields](concept_fields) — bind a name to a value with `=`."
    p "- [Blocks](concept_blocks) — named groups of fields that nest other blocks."
  }
}
