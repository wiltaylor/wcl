concept fields_blocks {
  name     = "Fields & Blocks"
  summary  = "The structural backbone — fields bind names to values, blocks group and nest them."
  related  = [schema, expressions, namespaces]
  audience = :both
  body {
    p "Fields and blocks are the structural backbone of a document. Everything else — types, functions, schema — describes and constrains them."
    h2 "Fields"
    p "A field binds a name to a value with `=`. The value is any [expression](concept_expressions)."
    code "wcl" { source = <<'SRC'
name    = "alpha"
count   = 3u32
enabled = true
ratio   = count / 2u32
SRC
    }
    h2 "Blocks"
    p "A block is a named group of fields that also lets you nest other blocks under it. The available fields and labels are set by the [schema](concept_schema). A block kind may also be namespace-qualified (`wdoc::process { ... }`)."
    code "wcl" { source = <<'SRC'
// One label -> name = "web".
service "web" {
  port   = 8080u32
  region = "us-east-1"
}
SRC
    }
    p "Multiple labels work the same way — declare an `@inline` for each position you want to expose:"
    code "wcl" { source = <<'SRC'
// Two labels -> verb = "GET", path = "/users".
route "GET" "/users" {
  handler = "list_users"
}
SRC
    }
    h2 "Nested blocks"
    p "Blocks can hold further blocks. Nesting depth is unbounded; structure is constrained by the schema (`@child` for one, `@children` for many)."
    code "wcl" { source = <<'SRC'
service "web" {
  metadata {
    region = "us-east-1"
    tags {
      environment = "prod"
    }
  }
}
SRC
    }
  }
}
