concept booleans {
  name = "Booleans"
  summary = "The bool type with exactly two values, true and false."
  related = [operators]
  audience = :both
  body {
    p "The `bool` type has exactly two values: `true` and `false`."
    code "wcl" {
      source = <<DOC
        enabled = true
        strict  = false
      DOC
    }
    h2 "In expressions"
    p <<DOC
      Booleans are produced by every comparison and combined with the logical operators `&&`, `||`,
      and `!`. See [Operators](fact_operators) for the full set.
    DOC
    code "wcl" {
      source = <<DOC
        ready    = !pending && enabled
        oversize = width > 100u32 || height > 100u32
      DOC
    }
  }
}
