concept booleans {
  name     = "Booleans"
  summary  = "The bool type with exactly two values, true and false."
  related  = [operators, if_else]
  audience = :both
  body {
    p "The `bool` type has exactly two values: `true` and `false`."
    code "wcl" { source = <<'SRC'
enabled = true
strict  = false
SRC
    }
    h2 "In expressions"
    p "Booleans are produced by every comparison and combined with the logical operators `&&`, `||`, and `!`. See [Operators](fact_operators) for the full set."
    code "wcl" { source = <<'SRC'
ready    = !pending && enabled
oversize = width > 100u32 || height > 100u32
SRC
    }
  }
}
