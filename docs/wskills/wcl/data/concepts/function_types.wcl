concept function_types {
  name     = "Function Types"
  summary  = "The `fn(T1, T2, ...) -> R` type for fields that hold callables."
  related  = [functions, function_literals, fn_items, higher_order_functions, expressions]
  audience = :both
  body {
    p "The type `fn(T1, T2, ...) -> R` describes a callable. Use it for fields that hold callbacks."
    code "wcl" { source = <<'SRC'
type Step {
  apply: fn(i32) -> i32
}
SRC
    }
    callout "Lazy and cycle-checked" { class = ["note"]  body = "Function values participate in WCL's lazy field evaluation. Each call evaluates its body in a fresh context, and circular references between fields are detected and reported." }
  }
}
