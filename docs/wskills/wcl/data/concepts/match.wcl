concept match_expr {
  name = "match"
  summary = "Tests a value against a sequence of patterns, returning the body of the first that matches."
  related = [{ id: "patterns", why: "Patterns supports match: Patterns destructure and test values in `match`, `if let`, and guard arms." }, { id: "unions", why: "Unions supports match: Tagged variant sets — a value that is exactly one of several alternatives." }, { id: "optionals", why: "Optionals supports match: Values that may be present or absent — the none literal and the ? type suffix." }]
  audience = :both
  body {
    p <<DOC
      `match` tests a value against a sequence of patterns, returning the body of the first that
      matches. It is WCL's primary tool for destructuring unions, optionals, and any shape with
      multiple cases.
    DOC
    code "wcl" {
      source = <<DOC
        area = match shape {
          Shape::Circle { radius, .. } => pi() * radius * radius,
          Shape::Polygon(n) if n > 2   => 0.0,
          Shape::Empty                 => 0.0,
          _                            => 0.0,
        }
      DOC
    }
    p "See [Patterns](fact_patterns) for the full pattern syntax."
    h2 "Guards"
    p <<DOC
      An `if expr` after a pattern adds a runtime test; the arm fires only when both the pattern
      matches and the guard is true.
    DOC
    code "wcl" {
      source = <<DOC
        classify = match n {
          k if k < 0  => :neg,
          0           => :zero,
          k if k > 10 => :big,
          _           => :small,
        }
      DOC
    }
  }
}
