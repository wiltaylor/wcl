// The `wcl` command-line tool, modelled as an entity so units can point at the
// concrete binary (rather than the language) when that is what they mean.
entity wcl_cli {
  name     = "wcl"
  kind     = :tool
  summary  = "The wcl command-line tool: one binary for parsing, checking, editing, formatting, scaffolding, the editor, and wdoc."
  audience = :both
  related  = [what_is_wcl]
  body {
    p "`wcl` is the single binary that drives the whole toolchain: it parses and validates documents (`wcl parse`, `wcl check`), reads and edits values (`wcl eval`, `wcl set`, `wcl answer`), formats and compares files (`wcl fmt`, `wcl diff`), scaffolds projects (`wcl init`), runs the REPL, the language server and the browser editor (`wcl repl`, `wcl lsp`, `wcl editor`), builds wdoc sites, PDFs, Markdown and skills (`wcl wdoc`), and derives architecture change specs (`wcl wad`)."
    p "Subcommand-by-subcommand detail — every argument, switch and default — lives in the CLI Reference section."
  }
}
