// The presentation view's deck — "WCL in a nutshell", the topic's introduction
// as slides (schema/presentation.wcl). Slides feature existing units where
// possible (`unit = <id>` pulls the headline + summary); detail stays in the book.
presentation nutshell {
  title   = "WCL in a nutshell"
  summary = "A typed configuration & schema language: declare types, compose a document, validate and evaluate it — one model, checked before anything consumes it."

  pres_section why_wcl {
    title = "Why WCL"
    pres_slide what {
      unit = what_is_wcl
      speaker_notes = "The pitch in one line: config that carries its own schema. Everything else in the deck is the machinery that makes that sentence true."
    }
    pres_slide shape {
      title = "Fields & blocks"
      unit  = blocks
      body {
        p "- A **field** binds a name to a value: `port = 8080u32`"
        p "- A **block** groups fields and nests: `service \"web\" { ... }`"
        p "- Block labels map to `@inline` fields — structure stays data"
      }
      speaker_notes = "Two structural pieces only. Everything a document contains is a field or a block; the schema decides which are legal."
    }
  }

  pres_section typed_values {
    title = "Typed values"
    pres_slide primitives {
      title = "Typed primitives"
      unit  = numbers
      body {
        p "- Numbers with width suffixes: `200u8`, `1_000_000u32`, `2.5f32`"
        p "- Strings, heredocs, and `$\"...\"` interpolation"
        p "- Symbols (`:amber`), booleans, identifiers, references"
      }
      speaker_notes = "A bare integer defaults to i64; a suffix pins the exact type. Symbols are typed names — reach for them instead of stringly enums."
    }
    pres_slide composites {
      title = "Records, lists, tables"
      unit  = records
      body {
        p "- Lists: `tags = [\"alpha\", \"beta\"]`"
        p "- Records: `owner = { name: \"Ops\", contact: \"...\" }`"
        p "- Pipe-tables write many rows of one shape compactly"
      }
    }
    pres_slide maybe {
      unit = optionals
      body {
        p "- `T?` accepts a value or `none`"
        p "- `??` gives an optional a default: `theme ?? :nord`"
      }
    }
    pres_slide choice {
      title = "Unions & match"
      unit  = unions
      body {
        p "- `Status::Failed { reason: \"timeout\" }` — tagged variants"
        p "- Bare records coerce to the matching variant by shape"
        p "- `match` destructures; the final arm is `_` or a binding"
      }
      speaker_notes = "Shape-based variant dispatch is the ergonomic core: authors write plain records, the schema names the variant."
    }
  }

  pres_section schema_and_functions {
    title = "Schema & functions"
    pres_slide declaring {
      title = "Declaring types"
      unit  = block_schema
      body {
        p "- `@block(\"service\")` makes a type a nestable block kind"
        p "- `@inline(0)` binds the label; `@default(80)` fills gaps"
        p "- `@child` / `@children` declare the nesting"
      }
      speaker_notes = "Decorators are the schema language: a handful of prefixes turn a record type into an authoring vocabulary."
    }
    pres_slide gathering {
      title = "The @document & gathering"
      unit  = document_schema
      body {
        p "- One `@document` root gathers every matching block instance"
        p "- Schemas **merge** per namespace — import a library's and add yours"
        p "- `wcl check` validates the assembled document"
      }
      speaker_notes = "Merge-per-namespace is why you can import wdoc's document schema and still declare your own top-level tags."
    }
    pres_slide functions {
      title = "Functions"
      unit  = higher_order_functions
      body {
        p "- `fn double(n: i64) -> i64 { n * 2 }`"
        p "- Literals pass to `map` / `filter` / `fold`"
        p "- Config that computes, still declarative at the edges"
      }
    }
    pres_slide modules {
      title = "Imports & namespaces"
      unit  = imports
      body {
        p "- `import \"./types.wcl\"` — disk; `import <wdoc.wcl>` — system"
        p "- `namespace` scopes declarations; `use` and `::` resolve them"
      }
    }
  }

  pres_section tooling_and_next {
    title = "Tooling & next steps"
    pres_slide tooling {
      unit = cli
      body {
        p "- `wcl check` / `wcl eval` — validate and read"
        p "- `wcl set` / `wcl fmt` / `wcl diff` — edit, normalise, compare"
        p "- `wcl repl`, `wcl lsp`, `wcl init` — explore, edit, scaffold"
      }
      speaker_notes = "One binary end to end. diff compares evaluated documents, so a formatting-only change is an empty diff."
    }
    pres_slide wdoc_view {
      title = "wdoc in one slide"
      body {
        p "- `wcl wdoc` projects WCL data into sites, books, PDFs, and skills"
        p "- Pages, diagrams, charts, terminals — all authored as blocks"
        p "- This deck is itself a wdoc projection of the reference model"
      }
      speaker_notes = "Do not go deep here — just plant that the documentation system is WCL eating its own dog food."
    }
    pres_slide next {
      title = "Where to go next"
      body {
        p "- **Quick Start** in the book: install, a minimal document, check & eval"
        p "- The **Language** section — area by area, with runnable examples"
        p "- The **Learn WCL** training course — eleven hands-on lessons"
      }
    }
  }
}
