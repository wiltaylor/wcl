// Quick Start — a curated index page. Indexes render between Overview and the
// Language section, so this is the first stop below Overview in the book menu.

index quick_start {
  name    = "Quick Start"
  summary = "Get WCL running in a few minutes: declare a type, write data, check and evaluate."
  audience = :both
  body {
    h2 "Install"
    p "WCL is pre-release only for now, so install the newest pre-release with the install script:"
    code "console" {
      source = <<'SH'
curl -fsSL https://wcl.dev/install.sh | sh -s -- --pre
SH
    }
    p "On a platform without a prebuilt binary (e.g. macOS), build from source with Cargo instead:"
    code "console" {
      source = <<'SH'
cargo install --git https://github.com/wiltaylor/wcl -p wcl --locked
SH
    }
    p "If `~/.local/bin` is not on your `PATH`, add it. Verify with `wcl --version`."

    h2 "What WCL is"
    p "WCL is a typed configuration & schema language: you declare record types, compose a document of block instances, and the toolchain validates and evaluates it."

    h2 "A minimal document"
    p "Declare a block type, point a `@document` at it, then write an instance:"
    code "wcl" {
      source = <<'WCL'
@block("server") type Server {
  @inline(0) id: identifier
  host: utf8
  @default(8080) port: u16
}
@document type Config { @children("server") servers: list<Server> }

server web { host = "localhost" }
WCL
    }

    h2 "Check and evaluate"
    p "Validate the document against its schema, then evaluate it:"
    code "console" {
      source = <<'SH'
$ wcl check config.wcl     # type-checks the document, reports errors
$ wcl eval config.wcl      # prints the evaluated data
SH
    }

    h2 "Where to go next"
    p "Walk the essentials: [Fields & Blocks](concept_fields_blocks), [Records](concept_records), [Schema & Decorators](concept_schema), and the [CLI](concept_cli)."
  }
}
