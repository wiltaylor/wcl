# Language — a curated index that puts the language reference back into the book
# menu (a "Language" section between Quick Start and the Builtins section). It
# pins most of the language concepts and reference facts via `related`, grouped
# by child indexes (one level), so the old area-by-area navigation is restored
# without the removed `feature` module. `related` ids resolve to links on each
# index page (and drive the "Index coverage" counts on the Reference page).

index language {
  name = "Language"
  summary = "The WCL language, area by area — syntax, types, expressions, control flow, functions, modules, and schema."
  audience = :both

  index lang_basic_syntax {
    name = "Basic Syntax"
    summary = "How a document is written before any types apply."
    related = [comments, fields, blocks, tables, self_parent]
  }

  index lang_primitive_types {
    name = "Primitive Types"
    summary = "Scalar values — numbers, strings, booleans, symbols, identifiers, references."
    related = [numbers, number_literals, numeric_promotion, literal_units, literal_unit_syntax, booleans, identifiers, references, symbols, symbol_set, string_literals, string_interpolation]
  }

  index lang_complex_types {
    name = "Complex Types"
    summary = "Composite shapes — lists, tensors, records, unions, interfaces, optionals."
    related = [lists, tensors, records, unions, interfaces, optionals]
  }

  index lang_expressions {
    name = "Expressions & Operators"
    summary = "Producing values — operators, member access, and calls."
    related = [member_access, function_calls, operators]
  }

  index lang_control_flow {
    name = "Control Flow"
    summary = "if/else, match, patterns, if let, let bindings, blocks, try/catch."
    related = [if_else, match_expr, if_let, let_bindings, block_expressions, try_catch, patterns]
  }

  index lang_functions {
    name = "Functions"
    summary = "First-class function values — literals, fn items, higher-order, function types."
    related = [function_literals, fn_items, higher_order_functions, function_types]
  }

  index lang_modules {
    name = "Namespaces & Imports"
    summary = "Scoping declarations under a path and composing files."
    related = [namespaces, use_declarations, qualified_kinds, imports]
  }

  index lang_schema {
    name = "Schema & Decorators"
    summary = "Declaring and constraining the document model — decorators, types, and constraints."
    related = [block_schema, document_schema, ref_integrity, child_count_constraints, type_aliases, type_constraints, dec_document, dec_block, dec_inline, dec_child, dec_children, dec_default, dec_table, dec_decorator, dec_doc, dec_by_ref, dec_only_except, dec_connections, dec_schemaless]
  }

  index lang_interviews {
    name = "Interview Documents"
    summary = "Turning a document into a set of questions a respondent answers."
    related = [answer_mode]
  }

  index lang_connections {
    name = "Connections"
    summary = "Wiring blocks together with `->` statements."
    related = [connections]
  }
}

# Tasks — the runbook procedures, pinned so they sit in the book nav (and in
# SKILL.md's Reference, since the index is :both like the procedures it lists).
index tasks {
  name = "Tasks"
  summary = "Step-by-step runbooks for the day-to-day wcl workflows."
  audience = :both
  related = [validate_format, inspect_values, scaffold_init, upgrading_with_wcl]
}
