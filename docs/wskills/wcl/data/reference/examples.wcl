// Worked WCL examples. Each attaches to a concept via `unit` and is rendered on
// that concept's page. Snippets are ported faithfully from the WCL reference pages.

example ex_records {
  title     = "Declaring and constructing a record"
  unit      = records
  narrative = "A `type` declares a named record; a record value fills its fields."
  code_lang = "wcl"
  code = <<'CODE'
type Dog {
  name: utf8
  age:  u32
}

let rex = Dog { name: "Rex", age: 4u32 }
CODE
  expected  = "`rex` is a `Dog` record with `name = \"Rex\"` and `age = 4`."
  audience  = :both
}

example ex_unions {
  title     = "A union with three variant forms"
  unit      = unions
  narrative = "Variants may carry a record body, a single typeref payload, or nothing."
  code_lang = "wcl"
  code = <<'CODE'
union Shape {
  Circle { radius: f64, stroke: f64 }   // record variant
  Polygon i32                            // typeref variant
  Empty                                  // unit variant
}

a = Shape::Circle { radius: 5.0, stroke: 0.5 }
b = Shape::Polygon(7)
c = Shape::Empty
CODE
  expected  = "Three values, each a different variant of `Shape`."
  audience  = :both
}

example ex_heredoc {
  title     = "Raw heredoc for backslash-heavy text"
  unit      = strings
  narrative = "A single-quoted tag takes the body verbatim — no escapes, no interpolation."
  code_lang = "wcl"
  code = <<'CODE'
regex = <<'RAW'
\d{3}-\d{4}
RAW

latex = <<'TEX'
\frac{-b \pm \sqrt{b^2 - 4ac}}{2a}
TEX
CODE
  expected  = "`regex` and `latex` hold the literal bytes, backslashes intact."
  audience  = :both
}

example ex_schema_block {
  title     = "A document root with one kind of child block"
  unit      = schema
  narrative = "The block label becomes an inline field; the port defaults to 80."
  code_lang = "wcl"
  code = <<'CODE'
@block("service")
type Service {
  @inline(0)   name: utf8     // service "web" → name = "web"
  @default(80) port: u32
  region: utf8
}

@document
type Config {
  @children("service") services: list<Service>
}

service "web" { region = "us-east-1" }
service "api" { port = 9090u32  region = "eu-west-1" }
CODE
  expected  = "Each `service` block contributes a `Service`; `web`'s port defaults to 80."
  audience  = :both
}

example ex_match {
  title     = "Matching a union with guards"
  unit      = control_flow
  narrative = "`match` returns the body of the first pattern that matches; a guard adds a runtime test."
  code_lang = "wcl"
  code = <<'CODE'
area = match shape {
  Shape::Circle { radius, .. } => pi() * radius * radius,
  Shape::Polygon(n) if n > 2   => 0.0,
  Shape::Empty                 => 0.0,
  _                            => 0.0,
}
CODE
  expected  = "`area` is computed from whichever variant `shape` holds."
  audience  = :both
}

example ex_optionals {
  title     = "Optional fields and the ?? default"
  unit      = optionals
  narrative = "A `?` suffix makes a field optional; `??` supplies a fallback when it is `none`."
  code_lang = "wcl"
  code = <<'CODE'
type Profile {
  name: utf8       // required
  bio:  utf8?      // optional — may be none
}

partial = Profile { name: "Bob", bio: none }
theme   = page.theme ?? site.theme ?? :nord
CODE
  expected  = "`partial.bio` is `none`; `theme` falls back to `site.theme`, then `:nord`."
  audience  = :both
}

example ex_interface {
  title     = "A structural interface"
  unit      = interfaces
  narrative = "Any type with `x` and `y` of type `f64` satisfies `Drawable` — no explicit implements."
  code_lang = "wcl"
  code = <<'CODE'
interface Drawable {
  x: f64
  y: f64
}

interface Sized extends Drawable {
  width:  f64
  height: f64
}
CODE
  expected  = "Any record with the listed fields satisfies the interface automatically."
  audience  = :both
}

example ex_pipe_table {
  title     = "Pipe-table rows"
  unit      = tables
  narrative = "A `@table` row type plus a colon-introduced field lets rows be written like a spreadsheet."
  code_lang = "wcl"
  code = <<'CODE'
@table("user")
type User {
  name:    utf8
  age:     u32
  enabled: bool
}

users:
  | "alice" | 30 | true  |
  | "bob"   | 25 | false |
  | "cara"  | 42 | true  |
CODE
  expected  = "Each `| … |` row becomes one `User` record in `users: list<User>`."
  audience  = :both
}
