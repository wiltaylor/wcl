// The wcl wskill's one addition to the shared component library: a builtin's
// full signature — `name(param: type, …) → ret`.
//
// This topic maps the WCL builtins as data (schema/builtins.wcl), so its
// index tables, per-function page headings and skill section headings all
// render a signature and must render the SAME one. Everything else about the
// per-unit components comes from `<wskill/component/*.wcl>` unchanged; this
// file adds a name rather than replacing one, so both projections import it
// beside the shared parts.

import <wdoc.wcl>
import "../../schema/builtins.wcl"   // Function / Parameter

let fn_signature = fn(fc: Function) -> utf8 {
  let params = join(map(fc.parameters, fn(pp: Parameter) -> utf8 { $"${pp.name}: ${pp.type ?? "?"}" }), ", ");
  $"${fc.name}(${params})${match fc.returns { none => "", r => $" → ${r}" }}"
}
