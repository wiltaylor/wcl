// Book projection — human-readable wdoc site over the wskill data model.
//
// Build:  wcl wdoc build wdoc/book/main.wcl --out out/book
//
// This template contains NO topic content — only projections over the data
// gathered by the root @document (concepts, entities, …). Chapter order follows
// the WSKILL PRD §10. The per-unit page bodies are rendered by the shared
// components under component/ (concept_body / entity_body / fact_body /
// process_body); the standalone pages live one-per-file under pages/. The
// topic-specific Builtins / CLI projections stay inline below.

import <wdoc.wcl>
import "../../wskill.wcl"
import "../component/common.wcl"    // UnitRef + shared per-unit sub-sections
import "../component/concept.wcl"   // concept_body
import "../component/entity.wcl"    // entity_body
import "../component/fact.wcl"      // fact_body
import "../component/process.wcl"   // process_body
import "../component/type_index.wcl" // shared unit-index page component
import "../component/function.wcl"  // function_body (per-builtin pages)

// Built-in standalone pages — one file each under pages/ (the generated per-unit
// pages stay as repeaters below). These resolve the `let`s defined in this file,
// so they are only valid as part of this document.
import "../pages/overview.wcl"     // index (start page)
import "../pages/reference.wcl"    // reference_page
import "../pages/concepts.wcl"     // concepts_page
import "../pages/entities.wcl"     // entities_page
import "../pages/facts.wcl"        // facts_page
import "../pages/processes.wcl"    // processes_page

// The single topic block, bound from its gather list (see base.wcl
// for why it is a list). A wskill always has exactly one.
let topic = head(topics)

// Audience filter — the book is the comprehensive human reference. Each `let`
// shadows the gathered list of the same name with its "both"/"book" subset
// (dropping ai-only notes), so the book renders everything meant for readers.
let in_book    = fn(a: Audience) -> bool { match a { :ai => false, _ => true } }
let concepts   = filter(concepts,   fn(c: Concept)   -> bool { in_book(c.audience) })
let entities   = filter(entities,   fn(e: Entity)    -> bool { in_book(e.audience) })
let facts      = filter(facts,      fn(f: Fact)      -> bool { in_book(f.audience) })
let examples   = filter(examples,   fn(x: Example)   -> bool { in_book(x.audience) })
let indexes    = filter(indexes,    fn(x: Index)      -> bool { in_book(x.audience) })
// Top-level indexes are book-filtered above; child_indexes flattens each one's
// nested sub-indexes (book-filtered too). all_indexes drives per-page rendering
// (a child of a book-excluded parent is intentionally dropped with its parent).
let child_indexes = filter(flatten(map(indexes, fn(x: Index) -> list<Index> { x.children })), fn(x: Index) -> bool { in_book(x.audience) })
let all_indexes   = flatten([indexes, child_indexes])
// Alias matching the canonical reference page (it counts index coverage over the
// book-filtered indexes); `indexes` is already that book-filtered list.
let book_indexes  = indexes
let procedures = filter(procedures, fn(p: Procedure) -> bool { in_book(p.audience) })
// Opt-in builtins module (schema/builtins.wcl): the gathered `functions` list.
// Each builtin gets its own page (function_<id>), grouped into per-category pages
// by its `category` slug. `fn_categories` fixes the group order + display text;
// membership is data-driven (the function's `category` field).
let all_functions = filter(functions, fn(fc: Function) -> bool { in_book(fc.audience) })
let fn_categories = [
  { slug: "collections", name: "Collection functions", blurb: "Transform, search, and reshape lists and tensors." },
  { slug: "strings",     name: "String functions",     blurb: "Search, split, join, reshape, and slice text." },
  { slug: "math",        name: "Math functions",       blurb: "Arithmetic, rounding, roots, logs, and trigonometry." },
  { slug: "records",     name: "Record functions",     blurb: "Read and combine record fields." },
  { slug: "reflection",  name: "Reflection functions", blurb: "Inspect declarations, types, and signatures at evaluation time." },
  { slug: "tensors",     name: "Tensor functions",     blurb: "Build, read, and reshape shape-carrying arrays." },
  { slug: "control",     name: "Control & error functions", blurb: "Abort, assert, and signal evaluation failure." },
]
let functions_in = fn(slug: utf8) -> list<Function> { filter(all_functions, fn(fc: Function) -> bool { (fc.category ?? "") == slug }) }

// Opt-in `cli` module (schema/cli.wcl): a CLI maps to a top-level "CLI" section;
// each cli renders all its commands on one page with an in-page jump index.
let clis = filter(clis, fn(x: Cli) -> bool { in_book(x.audience) })

// Backlinks: every unit flattened to { id, name, href, related } so a unit page
// can list the notes that point *at* it (the inverse of its own `related`).
// Built from the audience-filtered lists above, so backlinks track the book's
// view. UnitRef is declared in component/common.wcl (shared with the components).
let all_units = flatten([
  map(concepts,   fn(c: Concept)   -> UnitRef { { id: c.id, name: c.name,  href: $"concept_${c.id}", related: c.related } }),
  map(entities,   fn(e: Entity)    -> UnitRef { { id: e.id, name: e.name,  href: $"entity_${e.id}",  related: e.related } }),
  map(facts,      fn(f: Fact)      -> UnitRef { { id: f.id, name: f.title, href: $"fact_${f.id}",    related: f.related } }),
  map(procedures, fn(p: Procedure) -> UnitRef { { id: p.id, name: p.title, href: $"process_${p.id}", related: p.related } }),
])
let referenced_by = fn(uid: identifier) -> list<UnitRef> {
  filter(all_units, fn(u: UnitRef) -> bool { list_contains(u.related, uid) })
}

// The per-unit "Related" / "Referenced by" two-column block: top-align the two
// columns and tighten the bullet rows (grid cells don't collapse margins, which
// otherwise leaves the lists looking double-spaced).
stylesheet "related-cols" {
  css = <<CSS
.related-cols { align-items: start; }
.related-cols p { margin: 0.15rem 0; }
.related-cols .heading-2 { margin: 0 0 0.35rem; }
CSS
}

// --- site -------------------------------------------------------------------

site book {
  default_template = :book
  title            = $"${topic.name}"
  summary          = $"${topic.summary}"
  root             = true
  theme            = :nord
  theme_toggle     = true
  search           = true
  toc {
    chapter "Overview"       { page = index }
    wdoc_repeater { each = indexes  as = :ix  chapter $"${ix.name}" { page = $"index_${ix.id}"
      wdoc_repeater { each = filter(ix.children, fn(x: Index) -> bool { in_book(x.audience) })  as = :cix  chapter $"${cix.name}" { page = $"index_${cix.id}" } }
    } }
    // Builtins — a top-level "Builtins" section with one chapter per category
    // (per-function pages are reached from those category pages). Gated so it
    // vanishes when no builtins are documented.
    wdoc_repeater { each = match len(all_functions) { 0 => [], _ => [true] }  as = :_bg
      chapter "Builtins" { page = builtins_page
        wdoc_repeater { each = fn_categories  as = :cat
          wdoc_repeater { each = match len(functions_in(cat.slug)) { 0 => [], _ => [true] }  as = :_cc
            chapter $"${cat.name}" { page = $"builtins_${cat.slug}" }
          }
        }
      }
    }
    // Opt-in cli module — the cli(s) projected directly onto one "CLI Reference"
    // page (commands reached via its in-page index).
    wdoc_repeater { each = match len(clis) { 0 => [], _ => [true] }  as = :_clg
      chapter "CLI Reference" { page = clis_page }
    }
  }
  // The Reference catalogue (the four units, the graph, and the per-unit pages)
  // lives behind a single pinned sidebar button rather than a sprawling TOC
  // section — `reference_page` lists everything; the unit / graph pages are still
  // generated (their document-scope repeaters are below) and reached from there.
  sidebar_footer {
    button "Reference" { page = reference_page  icon = "lucide.chart-network" }
  }
}

// --- 1. Overview / index pages ----------------------------------------------
// The Overview, Reference and per-kind index pages live one-per-file under
// pages/ (imported above). The generated per-unit pages stay here as repeaters,
// each delegating to a component. The topic-specific Builtins / CLI
// pages stay inline below.

// --- 2. Concepts — one generated page per concept ---------------------------
// concepts_page (the index) lives in pages/concepts.wcl; each concept's body
// is generated below via concept_body.
wdoc_repeater { each = concepts  as = :c
  page $"concept_${c.id}" { title = $"${c.name}"
    concept_body { unit = c  examples = examples  all_units = all_units  backlinks = referenced_by(c.id)  layout = "columns" }
  }
}

// --- 2b. Entities — one page per entity (entities_page → pages/entities.wcl) -
wdoc_repeater { each = entities  as = :e
  page $"entity_${e.id}" { title = $"${e.name}"
    entity_body { unit = e  examples = examples  all_units = all_units  backlinks = referenced_by(e.id)  layout = "columns" }
  }
}

// --- 2c. Facts — one page per fact (facts_page → pages/facts.wcl) ------------
wdoc_repeater { each = facts  as = :f
  page $"fact_${f.id}" { title = $"${f.title}"
    fact_body { unit = f  examples = examples  all_units = all_units  backlinks = referenced_by(f.id)  layout = "columns" }
  }
}

// --- 3. Reference — reference_page lives in pages/reference.wcl --------------

// --- 5. Processes — one generated page per procedure ------------------------
// processes_page (the index) lives in pages/processes.wcl.
wdoc_repeater { each = procedures  as = :pr
  page $"process_${pr.id}" { title = $"${pr.title}"
    process_body { unit = pr  all_units = all_units  backlinks = referenced_by(pr.id)  layout = "columns" }
  }
}

// --- Indexes — curated link-collection pages (top-level menu entries) --------
wdoc_repeater { each = all_indexes  as = :ix
  page $"index_${ix.id}" { title = $"${ix.name}"
    h1 $"${ix.name}"
    wdoc_repeater { each = match ix.summary { none => [], s => [s] }  as = :s  p $"_${s}_" }
    // `body` is optional (child indexes often omit it); only project when present,
    // keeping the named `ix.body` path so it resolves as an addressable body.
    wdoc_repeater { each = match ix.body { none => [], _ => [true] }  as = :_hb  project { from = ix.body } }
    wdoc_repeater { each = match len(ix.related) { 0 => [], _ => [true] }  as = :_r  h2 "Related" }
    wdoc_repeater { each = ix.related  as = :rid
      wdoc_repeater { each = filter(concepts, fn(x: Concept) -> bool { x.id == rid })  as = :t  p $"- [${t.name}](concept_${t.id})" }
      wdoc_repeater { each = filter(entities, fn(x: Entity)  -> bool { x.id == rid })  as = :t  p $"- [${t.name}](entity_${t.id})" }
      wdoc_repeater { each = filter(facts,    fn(x: Fact)    -> bool { x.id == rid })  as = :t  p $"- [${t.title}](fact_${t.id})" }
      wdoc_repeater { each = filter(procedures, fn(x: Procedure) -> bool { x.id == rid })  as = :t  p $"- [${t.title}](process_${t.id})" }
    }
  }
}

// --- Builtins (opt-in module) — a landing page linking the per-category pages,
// then one page per builtin function and one page per category. All generated
// from the flat gathered `all_functions` list; grouping is the `category` slug.
page builtins_page {
  h1 "Builtins"
  p  "WCL's builtin functions, grouped by category. Each function has its own page."
  wdoc_repeater { each = fn_categories  as = :cat
    wdoc_repeater { each = match len(functions_in(cat.slug)) { 0 => [], _ => [true] }  as = :_cc
      p $"- [**${cat.name}**](builtins_${cat.slug}) — ${cat.blurb}"
    }
  }
}
wdoc_repeater { each = all_functions  as = :fc
  page $"function_${fc.id}" { title = $"${fc.name}"
    function_body { func = fc }
  }
}
wdoc_repeater { each = fn_categories  as = :cat
  page $"builtins_${cat.slug}" { title = $"${cat.name}"
    h1 $"${cat.name}"
    p  $"${cat.blurb}"
    wdoc_repeater { each = functions_in(cat.slug)  as = :fc
      p $"- [**${fc.name}**](function_${fc.id})${match fc.description { none => "", d => $" — ${d}" }}"
    }
  }
}

// --- CLI Reference (opt-in cli module) — the cli(s) projected directly onto the
// "CLI Reference" page, with a jump-link index of every command at the top.
page clis_page {
  h1 "CLI Reference"
  wdoc_repeater { each = clis  as = :c
    wdoc_repeater { each = match c.version { none => [], v => [v] }  as = :v  p $"**Version:** ${v}" }
    wdoc_repeater { each = match c.description { none => [], d => [d] }  as = :d  p $"${d}" }
    wdoc_repeater { each = match len(c.switches) { 0 => [], _ => [true] }  as = :_gs
      h2 "Global switches"
      table {
        header = ["Switch", "Value", "Description", "Remarks"]
        rows = map(c.switches, fn(sw: CliSwitch) -> list<utf8> { [$"${match sw.short { none => "", s => $"${s}, " }}${sw.long}", sw.value_name ?? "—", sw.description ?? "—", sw.remarks ?? "—"] })
      }
    }
    // Index — jump-links to every command on this page (nested under their parent).
    h2 "Commands"
    wdoc_repeater { each = c.subcommands  as = :sc
      p $"- [`${c.name} ${sc.name}`](#${sc.id})"
      wdoc_repeater { each = sc.subcommands  as = :ns
        p $"  - [`${c.name} ${sc.name} ${ns.name}`](#${ns.id})"
      }
    }
    // Each command rendered inline (h3 top-level, h4 nested), heading carries an id anchor.
    wdoc_repeater { each = c.subcommands  as = :sc
      h3 $"${c.name} ${sc.name}" { id = sc.id }
      wdoc_repeater { each = match len(sc.aliases) { 0 => [], _ => [true] }  as = :_al  p $"_alias: ${join(sc.aliases, ", ")}_" }
      wdoc_repeater { each = match sc.description { none => [], d => [d] }  as = :d  p $"${d}" }
      wdoc_repeater { each = match len(sc.args) { 0 => [], _ => [true] }  as = :_ah
        table {
          header = ["Argument", "Required", "Description", "Remarks"]
          rows = map(sc.args, fn(a: CliArg) -> list<utf8> { [$"${a.name}${match a.variadic { true => "…", _ => "" }}", match a.required { true => "required", _ => "optional" }, a.description ?? "—", a.remarks ?? "—"] })
        }
      }
      wdoc_repeater { each = match len(sc.switches) { 0 => [], _ => [true] }  as = :_sh
        table {
          header = ["Switch", "Value", "Description", "Remarks"]
          rows = map(sc.switches, fn(sw: CliSwitch) -> list<utf8> { [$"${match sw.short { none => "", s => $"${s}, " }}${sw.long}", sw.value_name ?? "—", sw.description ?? "—", sw.remarks ?? "—"] })
        }
      }
      wdoc_repeater { each = sc.examples  as = :ex  code $"${ex.lang ?? "text"}" { source = ex.code } }
      wdoc_repeater { each = match sc.remarks { none => [], r => [r] }  as = :r  p $"**Remarks:** ${r}" }
      wdoc_repeater { each = sc.subcommands  as = :ns
        h4 $"${c.name} ${sc.name} ${ns.name}" { id = ns.id }
        wdoc_repeater { each = match len(ns.aliases) { 0 => [], _ => [true] }  as = :_al  p $"_alias: ${join(ns.aliases, ", ")}_" }
        wdoc_repeater { each = match ns.description { none => [], d => [d] }  as = :d  p $"${d}" }
        wdoc_repeater { each = match len(ns.args) { 0 => [], _ => [true] }  as = :_ah
          table {
            header = ["Argument", "Required", "Description", "Remarks"]
            rows = map(ns.args, fn(a: CliArg) -> list<utf8> { [$"${a.name}${match a.variadic { true => "…", _ => "" }}", match a.required { true => "required", _ => "optional" }, a.description ?? "—", a.remarks ?? "—"] })
          }
        }
        wdoc_repeater { each = match len(ns.switches) { 0 => [], _ => [true] }  as = :_sh
          table {
            header = ["Switch", "Value", "Description", "Remarks"]
            rows = map(ns.switches, fn(sw: CliSwitch) -> list<utf8> { [$"${match sw.short { none => "", s => $"${s}, " }}${sw.long}", sw.value_name ?? "—", sw.description ?? "—", sw.remarks ?? "—"] })
          }
        }
        wdoc_repeater { each = ns.examples  as = :ex  code $"${ex.lang ?? "text"}" { source = ex.code } }
        wdoc_repeater { each = match ns.remarks { none => [], r => [r] }  as = :r  p $"**Remarks:** ${r}" }
      }
    }
  }
}

