// The WCL reference — one book covering the language and wdoc.
//
//   wcl wdoc serve docs/reference/main.wcl        # just docs-serve-ref
//   wcl wdoc build docs/reference/main.wcl --out <dir>
//
// One document, one site, so no page carries a `sites` array and `root`
// stays unset: a single-site document already renders at its own output
// root. The single `import <wdoc.wcl>` pulls in the embedded wdoc standard
// library, so every stdlib block (`page` / `h1` / `p` / `code` / ...) is in
// scope here and in every imported page.
//
// The chapter tree was settled in #156. Chapters are ordered but not
// numbered: the `toc` order is the only ordering, so inserting a chapter
// costs one line here rather than a renumbering pass over every cross
// reference. Prose therefore names a chapter, never numbers it. Every page
// exists from the skeleton commit (#157) onwards, because a `toc` entry
// naming an unknown
// page — and a link to one — is a build error: without the whole tree in
// place no chapter could cross-reference another until the last one landed.
// Chapters arrive one issue at a time and replace their stub in place.
import <wdoc.wcl>

// `nord` in every respect but the reading column. The book template's
// `.book-measure` takes 3.5rem of padding off each side, so the shipped
// 60rem leaves a 53rem text column: at 17px body copy that is around a
// hundred characters a line, well past the 45–75 a reader scans without
// losing the return sweep. 52rem lands near ninety and costs nothing
// else — code blocks scroll (`pre.code-block` is `overflow-x: auto`) and
// diagrams carry their own widths.
theme reference_book {
  extends = :nord
  metrics { measure = "52rem" }
}

site reference {
  default_template = :book
  title            = "WCL Reference"
  theme            = :reference_book
  accent           = :cyan
  theme_toggle     = true
  search           = true

  // The two part headings are page-less `chapter`s: grouping, not pages.
  // The front matter sits above both.
  toc {
    chapter "Introduction"                                   { page = intro }
    chapter "Quick start"                                    { page = quickstart }

    chapter "The WCL language" {
      chapter "Documents, fields and blocks"                   { page = lang_documents }
      chapter "Values and primitives"                          { page = lang_values }
      chapter "Lists, tensors and records"                     { page = lang_collections }
      chapter "Types"                                          { page = lang_types }
      chapter "Expressions and operators"                      { page = lang_expressions }
      chapter "Control flow"                                   { page = lang_control_flow }
      chapter "Functions"                                      { page = lang_functions }
      chapter "Namespaces and imports"                         { page = lang_namespaces }
      chapter "Schemas"                                        { page = lang_schemas }
      chapter "Decorators"                                     { page = lang_decorators }
      chapter "Connections"                                    { page = lang_connections }
      chapter "How a document evaluates"                       { page = lang_evaluation }
      chapter "Builtins"                                       { page = lang_builtins }
      chapter "The CLI"                                        { page = lang_cli }
    }

    chapter "wdoc" {
      chapter "Introduction to wdoc"                           { page = wdoc_intro }
      chapter "Documents, pages and sites"                     { page = wdoc_sites }
      chapter "Templates and layouts"                          { page = wdoc_templates }
      chapter "Websites"                                       { page = wdoc_websites }
      chapter "Presentations"                                  { page = wdoc_presentations }
      chapter "Themes"                                         { page = wdoc_styling }
      chapter "Styling rules"                                  { page = wdoc_css }
      chapter "Visibility"                                     { page = wdoc_visibility }
      chapter "Output targets"                                 { page = wdoc_outputs }
      chapter "Text and formatting"                            { page = wdoc_formatting }
      chapter "Code"                                           { page = wdoc_code }
      chapter "Callouts, footnotes and chapter headers"        { page = wdoc_callouts }
      chapter "Lists and tables"                               { page = wdoc_tables }
      chapter "Images, videos and file assets"                 { page = wdoc_media }
      chapter "Icons"                                          { page = wdoc_icons }
      chapter "Icon galleries"                                 { page = wdoc_icon_gallery }
      chapter "Math"                                           { page = wdoc_math }
      chapter "Data views"                                     { page = wdoc_data_views }
      chapter "Demo blocks"                                    { page = wdoc_demo }
      chapter "The diagram canvas"                             { page = wdoc_diagrams }
      chapter "Connections and routing"                        { page = wdoc_diagram_connections }
      chapter "Flowcharts and swimlanes"                       { page = wdoc_flowcharts }
      chapter "Sequence and state diagrams"                    { page = wdoc_sequence_state }
      chapter "Charts"                                         { page = wdoc_charts }
      chapter "Timelines and dopesheets"                       { page = wdoc_timelines }
      chapter "Trees, node tables and cards"                   { page = wdoc_tree }
      chapter "Tilemaps and maps"                              { page = wdoc_tilemaps }
      chapter "Terminals and TUI"                              { page = wdoc_terminals }
      chapter "Wireframes"                                     { page = wdoc_wireframe }
      chapter "Writing your own blocks"                        { page = wdoc_extending }
    }
  }
}

// Front matter.
import "./pages/intro.wcl"
import "./pages/quickstart.wcl"

// Part I — the WCL language.
import "./pages/language/lang_documents.wcl"
import "./pages/language/lang_values.wcl"
import "./pages/language/lang_collections.wcl"
import "./pages/language/lang_types.wcl"
import "./pages/language/lang_expressions.wcl"
import "./pages/language/lang_control_flow.wcl"
import "./pages/language/lang_functions.wcl"
import "./pages/language/lang_namespaces.wcl"
import "./pages/language/lang_schemas.wcl"
import "./pages/language/lang_decorators.wcl"
import "./pages/language/lang_connections.wcl"
import "./pages/language/lang_evaluation.wcl"
import "./pages/language/lang_builtins.wcl"
import "./pages/language/lang_cli.wcl"

