import <wdoc.wcl>
use wdoc::{page, layout, heading, paragraph, code, data_table, callout, bold}
use wdoc::draw::{diagram, rect, connection}
use custom_examples::{task_node, mini_flow}

namespace custom_examples {
    @template("shape", "custom_examples::task_node_template")
    @open
    schema "task_node" { }

    export let task_node_template = (b) => {
        let w = attr_or(b, "width", 130)
        let h = attr_or(b, "height", 46)
        let label = attr_or(b, "label", "Task")
        let fill = attr_or(b, "fill", "var(--color-code-bg)")
        [
            { kind = "rect", x = 0, y = 0, width = w, height = h, rx = 7,
              fill = fill, stroke = "var(--color-link)", stroke_width = 1.5 },
            { kind = "text", x = 0, y = 0, width = w, height = h,
              content = label, font_size = 13 }
        ]
    }

    @template("shape", "custom_examples::mini_flow_template")
    @open
    schema "mini_flow" { }

    export let mini_flow_template = (b) => [
        { kind = "rect", id = "start", width = 96, height = 34, rx = 7,
          layout_role = "node", fill = "var(--color-code-bg)",
          stroke = "var(--color-link)", stroke_width = 1.5,
          children = [{ kind = "text", content = "Start", font_size = 12 }] },
        { kind = "rect", id = "review", width = 96, height = 34, rx = 7,
          layout_role = "node", fill = "var(--color-code-bg)",
          stroke = "var(--color-link)", stroke_width = 1.5,
          children = [{ kind = "text", content = "Review", font_size = 12 }] },
        { kind = "rect", id = "done", width = 96, height = 34, rx = 7,
          layout_role = "node", fill = "var(--color-code-bg)",
          stroke = "#28a745", stroke_width = 1.5,
          children = [{ kind = "text", content = "Done", font_size = 12 }] },
        { kind = "connection", from = "start", to = "review", direction = "to" },
        { kind = "connection", from = "review", to = "done", direction = "to" }
    ]
}

page wdoc_drawing_custom {
    section = "wcl_docs.wdoc.wdoc_drawing_custom"
    title = "Drawing — Custom Shapes"

    layout {
        vsplit v1 {
            split s1 {
                size = 100

                heading h1 {
                    level = 1
                    content = "Drawing — Custom Shapes"
                }

                paragraph p1 {
                    content = "Every built-in widget — phone, browser, the C4 person, the database cylinder — is just a WCL function that takes a block and returns a list of primitive shapes. You can write your own the same way: declare a schema, decorate it with " + bold("@template(\"shape\", \"...\")") + ", and write the function in WCL. The wdoc renderer dispatches your function whenever it sees a block of that kind inside a diagram and splices the returned shapes into the drawing tree."
                }

                heading h2_anatomy {
                    level = 2
                    content = "Anatomy of a shape template"
                }

                paragraph p_an1 {
                    content = "A shape template function takes one argument — the block the user wrote — and returns a " + bold("list of shape descriptors") + ". A shape descriptor is a map literal with a " + bold("kind") + " field naming a primitive (rect, circle, ellipse, line, path, text) or a connection, plus positioning and visual attributes. The dispatcher converts shape descriptors into child shape nodes of the widget container."
                }

                code c_min {
                    language = "wcl"
                    content = "import <wdoc.wcl>\nuse wdoc::draw::diagram\n\nnamespace my {\n\n    @template(\"shape\", \"my::sticker\")\n    @open\n    schema \"sticker\" { }\n\n    export let sticker = (b) => {\n        let w = attr_or(b, \"width\", 100)\n        let h = attr_or(b, \"height\", 100)\n        let label = attr_or(b, \"label\", \"!\")\n        [\n            { kind = \"circle\", x = 0, y = 0, r = w / 2, fill = \"#ff5f56\" },\n            { kind = \"text\", x = 0, y = 0, width = w, height = h,\n              content = label, font_size = 24, fill = \"#fff\" }\n        ]\n    }\n\n}"
                }

                paragraph p_an2 {
                    content = "Use the schema in any diagram. The dispatcher matches the block's kind (<code>my::sticker</code>) against the schemas it has loaded, finds your <code>@template(\"shape\", ...)</code> decorator, and calls the function."
                }

                code c_use {
                    language = "wcl"
                    content = "use my::sticker\n\ndiagram demo {\n    width = 300\n    height = 150\n    sticker s1 {\n        x = 30\n        y = 25\n        width = 100\n        height = 100\n        label = \"NEW\"\n    }\n}"
                }

                heading h2_descriptor {
                    level = 2
                    content = "Shape descriptor fields"
                }

                paragraph p_desc1 {
                    content = "Every descriptor needs a " + bold("kind") + ". The other fields are optional — the dispatcher ignores anything it doesn't recognise, so it's safe to add data your own logic uses but the renderer doesn't."
                }

                data_table tbl_fields {
                    caption = "Recognized descriptor fields"
                    rows = [
                        { field = "kind",             description = "Primitive: rect, circle, ellipse, line, path, text, group, image, inline_svg; or connection" },
                        { field = "id",               description = "Shape ID for layout and connection endpoints" },
                        { field = "x, y, width, height", description = "Absolute placement (relative to the widget's container)" },
                        { field = "top, bottom, left, right", description = "Anchored placement; stretches between opposing anchors" },
                        { field = "align, gap, padding", description = "Layout controls for the descriptor's own children" },
                        { field = "layout_role",      description = "Set to node when a template-generated child should participate in parent layout" },
                        { field = "rx, ry",           description = "Corner radius (rect) or x/y radius (ellipse)" },
                        { field = "r",                description = "Radius (circle)" },
                        { field = "fill, stroke, stroke_width, stroke_dasharray, opacity", description = "Visual styling" },
                        { field = "x1, y1, x2, y2",   description = "Endpoints (line shapes)" },
                        { field = "d",                description = "SVG path data (path shapes)" },
                        { field = "content, font_size, anchor", description = "Text shapes" },
                        { field = "from, to, direction, label", description = "Connection fields when kind is connection" },
                        { field = "children",         description = "List of more descriptors, nested under this one" }
                    ]
                }

                heading h2_flow {
                    level = 2
                    content = "Flow layout inside custom shapes"
                }

                paragraph p_flow {
                    content = "Custom shapes can contain their own link-driven flow. Use <code>align = \"layered\"</code> on the custom shape instance, return child descriptors with IDs, mark generated layout nodes with <code>layout_role = \"node\"</code>, and return <code>connection</code> descriptors between those IDs. Connection endpoints are scoped to each custom shape instance automatically."
                }

                code c_flow {
                    language = "wcl"
                    content = "namespace my {\n    @template(\"shape\", \"my::mini_flow\")\n    @open\n    schema \"mini_flow\" { }\n\n    export let mini_flow = (b) => [\n        { kind = \"rect\", id = \"start\", width = 90, height = 32,\n          layout_role = \"node\", fill = \"var(--color-code-bg)\",\n          children = [{ kind = \"text\", content = \"Start\" }] },\n        { kind = \"rect\", id = \"done\", width = 90, height = 32,\n          layout_role = \"node\", fill = \"var(--color-code-bg)\",\n          children = [{ kind = \"text\", content = \"Done\" }] },\n        { kind = \"connection\", from = \"start\", to = \"done\", direction = \"to\" }\n    ]\n}\n\ndiagram demo {\n    width = 260\n    height = 180\n\n    mini_flow flow {\n        x = 20\n        y = 20\n        width = 220\n        height = 140\n        align = \"layered\"\n        gap = 30\n    }\n}"
                }

                heading h2_linked_custom {
                    level = 2
                    content = "Example: custom shapes as linked nodes"
                }

                paragraph p_linked_custom {
                    content = "A user-defined custom shape can be linked like a built-in flowchart widget. The diagram-level <code>connection</code> blocks reference the custom shape IDs, and <code>align = \"layered\"</code> lays the nodes out from those links."
                }

                diagram custom_linked_nodes {
                    width = 620
                    height = 240
                    align = "layered"
                    gap = 55

                    task_node draft {
                        width = 130
                        height = 46
                        label = "Draft"
                    }
                    task_node review {
                        width = 130
                        height = 46
                        label = "Review"
                    }
                    task_node approve {
                        width = 130
                        height = 46
                        label = "Approve"
                    }
                    task_node publish {
                        width = 130
                        height = 46
                        label = "Publish"
                        fill = "#e8f5e9"
                    }

                    connection c1 {
                        from = "draft"
                        to = "review"
                        direction = "to"
                    }
                    connection c2 {
                        from = "review"
                        to = "approve"
                        direction = "to"
                    }
                    connection c3 {
                        from = "approve"
                        to = "publish"
                        direction = "to"
                    }
                }

                code c_linked_custom {
                    language = "wcl"
                    content = "diagram custom_linked_nodes {\n    width = 620\n    height = 240\n    align = \"layered\"\n    gap = 55\n\n    task_node draft   { width = 130, height = 46, label = \"Draft\" }\n    task_node review  { width = 130, height = 46, label = \"Review\" }\n    task_node approve { width = 130, height = 46, label = \"Approve\" }\n    task_node publish { width = 130, height = 46, label = \"Publish\", fill = \"#e8f5e9\" }\n\n    connection c1 { from = \"draft\",   to = \"review\",  direction = \"to\" }\n    connection c2 { from = \"review\",  to = \"approve\", direction = \"to\" }\n    connection c3 { from = \"approve\", to = \"publish\", direction = \"to\" }\n}"
                }

                heading h2_nested_links {
                    level = 2
                    content = "Example: nested local links"
                }

                paragraph p_nested_links {
                    content = "Connections written inside a container are scoped to that container. The local endpoints <code>from = \"intake\"</code> and <code>to = \"triage\"</code> resolve as <code>lane.intake</code> and <code>lane.triage</code>, so the nested <code>align = \"layered\"</code> layout can read them without manually writing dotted IDs."
                }

                diagram nested_local_links {
                    width = 520
                    height = 300

                    rect lane {
                        x = 40
                        y = 30
                        width = 440
                        height = 230
                        rx = 10
                        fill = "none"
                        stroke = "var(--color-nav-border)"
                        stroke_width = 1.5
                        align = "layered"
                        gap = 45
                        padding = 18

                        task_node intake {
                            width = 120
                            height = 42
                            label = "Intake"
                        }
                        task_node triage {
                            width = 120
                            height = 42
                            label = "Triage"
                        }
                        task_node resolve {
                            width = 120
                            height = 42
                            label = "Resolve"
                            fill = "#e8f5e9"
                        }

                        connection local1 {
                            from = "intake"
                            to = "triage"
                            direction = "to"
                        }
                        connection local2 {
                            from = "triage"
                            to = "resolve"
                            direction = "to"
                        }
                    }
                }

                code c_nested_links {
                    language = "wcl"
                    content = "rect lane {\n    x = 40, y = 30, width = 440, height = 230\n    rx = 10\n    fill = \"none\"\n    stroke = \"var(--color-nav-border)\"\n    align = \"layered\"\n    gap = 45\n    padding = 18\n\n    task_node intake  { width = 120, height = 42, label = \"Intake\" }\n    task_node triage  { width = 120, height = 42, label = \"Triage\" }\n    task_node resolve { width = 120, height = 42, label = \"Resolve\" }\n\n    connection local1 { from = \"intake\", to = \"triage\", direction = \"to\" }\n    connection local2 { from = \"triage\", to = \"resolve\", direction = \"to\" }\n}"
                }

                heading h2_generated_links {
                    level = 2
                    content = "Example: template-generated links"
                }

                paragraph p_generated_links {
                    content = "A template can generate its own internal flow by returning <code>connection</code> descriptors. Generated visual pieces stay out of layout by default, so mark generated flow nodes with <code>layout_role = \"node\"</code> when the parent shape's layout should move them."
                }

                diagram generated_internal_flow {
                    width = 540
                    height = 260

                    mini_flow flow_a {
                        x = 40
                        y = 30
                        width = 200
                        height = 190
                        align = "layered"
                        gap = 34
                    }

                    mini_flow flow_b {
                        x = 300
                        y = 30
                        width = 200
                        height = 190
                        align = "layered"
                        gap = 34
                    }
                }

                code c_generated_links {
                    language = "wcl"
                    content = "export let mini_flow_template = (b) => [\n    { kind = \"rect\", id = \"start\", width = 96, height = 34,\n      layout_role = \"node\", children = [{ kind = \"text\", content = \"Start\" }] },\n    { kind = \"rect\", id = \"review\", width = 96, height = 34,\n      layout_role = \"node\", children = [{ kind = \"text\", content = \"Review\" }] },\n    { kind = \"rect\", id = \"done\", width = 96, height = 34,\n      layout_role = \"node\", children = [{ kind = \"text\", content = \"Done\" }] },\n    { kind = \"connection\", from = \"start\", to = \"review\", direction = \"to\" },\n    { kind = \"connection\", from = \"review\", to = \"done\", direction = \"to\" }\n]\n\nmini_flow flow_a {\n    x = 40, y = 30, width = 200, height = 190\n    align = \"layered\"\n    gap = 34\n}"
                }

                heading h2_attr_or {
                    level = 2
                    content = "Reading user attributes"
                }

                paragraph p_attr1 {
                    content = "Use the global helper " + bold("attr_or(block, key, default)") + " to read attributes from the user's block with a fallback. Bare member access like <code>b.width</code> errors if the attribute is missing — <code>attr_or</code> returns the default in that case, which is what you almost always want for optional widget attributes."
                }

                code c_attr {
                    language = "wcl"
                    content = "let w = attr_or(b, \"width\", 200)        // 200 if user didn't set width\nlet color = attr_or(b, \"color\", \"var(--color-link)\")\nlet badge = attr_or(b, \"label\", \"NEW\")"
                }

                heading h2_children {
                    level = 2
                    content = "Reading child blocks"
                }

                paragraph p_children {
                    content = "Use the core helper " + bold("children(block)") + " to read direct child blocks from the user's block. Pass a kind string, such as " + bold("children(block, \"UiMenuItem\")") + ", to filter child blocks before mapping or recursively rendering them."
                }

                code c_children {
                    language = "wcl"
                    content = "export let menu_item_labels = (b) =>\n    map(children(b, \"UiMenuItem\"), item => item.label)"
                }

                heading h2_dynamic {
                    level = 2
                    content = "Dynamic shape lists"
                }

                paragraph p_dyn1 {
                    content = "Because the function returns a regular WCL list, you can build it with the standard collection helpers. Use ternary expressions to add or skip optional pieces, " + bold("concat") + " to glue lists together, and " + bold("map") + " over " + bold("range") + " to generate one descriptor per item in a dynamic input."
                }

                code c_dyn {
                    language = "wcl"
                    content = "// Tag bar — one rounded rect per comma-separated tag\nexport let tag_bar = (b) => {\n    let h = attr_or(b, \"height\", 24)\n    let tags = split(\",\", attr_or(b, \"tags\", \"alpha,beta\"))\n    let tag_w = 60\n    let gap = 6\n    map(range(0, len(tags)), (i) => {\n        kind = \"rect\",\n        x = i * (tag_w + gap),\n        y = 0,\n        width = tag_w,\n        height = h,\n        rx = h / 2,\n        fill = \"var(--color-link)\",\n        opacity = 0.15\n    })\n}"
                }

                heading h2_paths {
                    level = 2
                    content = "Building SVG paths"
                }

                paragraph p_path1 {
                    content = "For complex shapes, build the SVG <code>d</code> attribute as a string. Compute it in a let binding before the descriptor list — multi-line string concatenation can be brittle inside a map literal."
                }

                code c_path {
                    language = "wcl"
                    content = "export let chevron = (b) => {\n    let w = attr_or(b, \"width\", 80)\n    let h = attr_or(b, \"height\", 40)\n    let s = w * 0.2\n    let d = \"M \" + to_string(s) + \" 0 L \" + to_string(w) + \" 0 L \" + to_string(w - s) + \" \" + to_string(h) + \" L 0 \" + to_string(h) + \" Z\"\n    [\n        { kind = \"path\", x = 0, y = 0, width = w, height = h, d = d,\n          fill = \"var(--color-link)\", stroke = \"var(--color-link)\", stroke_width = 2 }\n    ]\n}"
                }

                heading h2_pkg {
                    level = 2
                    content = "Packaging custom shapes as a library"
                }

                paragraph p_pkg1 {
                    content = "Group your shape templates in their own WCL file under a namespace and import it from your wdoc files. Place the file on your library search path (or use a relative <code>import</code>) and consume the schemas via <code>use</code>:"
                }

                code c_pkg {
                    language = "wcl"
                    content = "// my-shapes.wcl\nimport <wdoc.wcl>\n\nnamespace my {\n    @template(\"shape\", \"my::sticker\")\n    @open\n    schema \"sticker\" { }\n\n    export let sticker = (b) => {\n        let w = attr_or(b, \"width\", 100)\n        let h = attr_or(b, \"height\", 100)\n        [{ kind = \"rect\", x = 0, y = 0, width = w, height = h, rx = 8,\n           fill = \"var(--color-link)\" }]\n    }\n}"
                }

                code c_pkg2 {
                    language = "wcl"
                    content = "// my-doc.wcl\nimport <wdoc.wcl>\nimport \"./my-shapes.wcl\"\nuse wdoc::draw::diagram\nuse my::sticker\n\n// ... use `sticker` blocks inside diagrams"
                }

                callout c_note {
                    icon = "info"
                    header = "Two requirements for the function to be found"
                    color = "#0d6efd"
                    paragraph wp1 {
                        content = "It must be declared as <code>export let</code> (plain <code>let</code> bindings stay in scope-local namespaces and aren't visible to the dispatcher), and the name in the <code>@template(\"shape\", \"...\")</code> decorator must match the function's qualified name exactly — including any namespace prefix."
                    }
                }

                heading h2_built_in {
                    level = 2
                    content = "Reading the built-ins for inspiration"
                }

                paragraph p_bi1 {
                    content = "Every built-in widget is implemented this way. The full set lives in <code>crates/wcl_wdoc/src/wdoc.wcl</code> in the WCL repo — opening it is the fastest way to see how the more elaborate shapes (database, UML class, navbar, C4 person) are assembled. Each one is just an exported lambda."
                }
            }
        }
    }
}
