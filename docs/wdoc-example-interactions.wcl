import <wdoc.wcl>
use wdoc::{page, layout, h1, h2, paragraph, code, callout, bold}
use wdoc::draw::{diagram, group, rect, text}

class demo_card {
    fill = "#ffffff"
    stroke = "#94a3b8"
    stroke_width = 1
    cursor = "pointer"
    transition = "fill 160ms ease, stroke 160ms ease, opacity 140ms ease"

    state hovered {
        fill = "#eef6ff"
        stroke = "#3b82f6"
        z_index = 10
    }

    state selected {
        stroke = "#0f766e"
        stroke_width = 3
        z_index = 20
    }
}

class demo_panel {
    fill = "#f8fafc"
    stroke = "#38bdf8"
    stroke_width = 2
    opacity = 0
    visible = false
    pointer_events = "none"
    transition = "opacity 140ms ease"

    state shown {
        opacity = 1
        visible = true
        pointer_events = "all"
    }
}

class demo_stack_card {
    fill = "#ffffff"
    stroke = "#64748b"
    stroke_width = 1
    cursor = "pointer"
    transition = "fill 120ms ease, stroke 120ms ease"

    state front {
        fill = "#ecfeff"
        stroke = "#0891b2"
        z_index = 30
    }
}

page wdoc_example_interactions {
    section = "wcl_docs.wdoc.wdoc_example_interactions"
    title = "Example — Diagram Interactions"

    layout {
        vsplit v1 {
            split s1 {
                size = 100

                h1 "Example — Diagram Interactions"

                paragraph p1 {
                    content = "This example uses document-level drawing classes plus shape events. Hover a card to apply a temporary state, click a card to toggle selection, and hover the first card to reveal the detail panel. The lower diagram shows runtime " + bold("z_index") + " changes: the hovered card moves to the front and returns to its original order when the pointer leaves."
                }

                h2 "Hover, click, and reveal"

                diagram state_demo {
                    width = 720
                    height = 270

                    group task_a {
                        x = 30
                        y = 40
                        width = 190
                        height = 88
                        class = "demo_card"

                        event hover_card {
                            trigger = "hover"
                            state = "hovered"
                            mode = "while"
                        }

                        event select_card {
                            trigger = "click"
                            state = "selected"
                            mode = "toggle"
                        }

                        event reveal_panel {
                            trigger = "hover"
                            target = "details"
                            state = "shown"
                            mode = "while"
                        }

                        rect bg { x = 0
                            y = 0
                            width = 190
                            height = 88
                            rx = 8 }
                        text title { x = 16
                            y = 16
                            width = 158
                            height = 24
                            content = "Review request"
                            anchor = "start"
                            font_weight = "700" }
                        text meta { x = 16
                            y = 48
                            width = 158
                            height = 22
                            content = "Hover for details"
                            anchor = "start"
                            font_size = 12 }
                    }

                    group task_b {
                        x = 260
                        y = 40
                        width = 190
                        height = 88
                        class = "demo_card"

                        event hover_card {
                            trigger = "hover"
                            state = "hovered"
                            mode = "while"
                        }

                        event select_card {
                            trigger = "click"
                            state = "selected"
                            mode = "toggle"
                        }

                        rect bg { x = 0
                            y = 0
                            width = 190
                            height = 88
                            rx = 8 }
                        text title { x = 16
                            y = 16
                            width = 158
                            height = 24
                            content = "Ship preview"
                            anchor = "start"
                            font_weight = "700" }
                        text meta { x = 16
                            y = 48
                            width = 158
                            height = 22
                            content = "Click to select"
                            anchor = "start"
                            font_size = 12 }
                    }

                    group details {
                        x = 500
                        y = 30
                        width = 190
                        height = 110
                        class = "demo_panel"

                        rect bg { x = 0
                            y = 0
                            width = 190
                            height = 110
                            rx = 8 }
                        text title { x = 16
                            y = 18
                            width = 158
                            height = 22
                            content = "Details"
                            anchor = "start"
                            font_weight = "700" }
                        text body { x = 16
                            y = 48
                            width = 158
                            height = 44
                            content = "Targeted events can show, hide, or restyle a different shape."
                            anchor = "start"
                            font_size = 12 }
                    }
                }

                h2 "Hover-to-front z-order"

                diagram z_order_demo {
                    width = 420
                    height = 180

                    group card_one {
                        x = 40
                            y = 42
                            width = 150
                            height = 86
                        class = "demo_stack_card"
                        event front { trigger = "hover"
                            state = "front"
                            mode = "while" }
                        rect bg { x = 0
                            y = 0
                            width = 150
                            height = 86
                            rx = 8 }
                        text label { x = 0
                            y = 0
                            width = 150
                            height = 86
                            content = "Alpha" }
                    }

                    group card_two {
                        x = 118
                            y = 30
                            width = 150
                            height = 86
                        class = "demo_stack_card"
                        event front { trigger = "hover"
                            state = "front"
                            mode = "while" }
                        rect bg { x = 0
                            y = 0
                            width = 150
                            height = 86
                            rx = 8 }
                        text label { x = 0
                            y = 0
                            width = 150
                            height = 86
                            content = "Beta" }
                    }

                    group card_three {
                        x = 196
                            y = 54
                            width = 150
                            height = 86
                        class = "demo_stack_card"
                        event front { trigger = "hover"
                            state = "front"
                            mode = "while" }
                        rect bg { x = 0
                            y = 0
                            width = 150
                            height = 86
                            rx = 8 }
                        text label { x = 0
                            y = 0
                            width = 150
                            height = 86
                            content = "Gamma" }
                    }
                }

                h2 "Source"

                code src {
                    language = "wcl"
                    content = <<-'WCL'
use wdoc::draw::{diagram, group, rect, text}

class demo_card {
    fill = "#ffffff"
    stroke = "#94a3b8"
    stroke_width = 1
    cursor = "pointer"

    state hovered {
        fill = "#eef6ff"
        stroke = "#3b82f6"
        z_index = 10
    }

    state selected {
        stroke = "#0f766e"
        stroke_width = 3
        z_index = 20
    }
}

class demo_panel {
    opacity = 0
    visible = false
    pointer_events = "none"

    state shown {
        opacity = 1
        visible = true
        pointer_events = "all"
    }
}

diagram state_demo {
    width = 720
    height = 270

    group task_a {
        x = 30
                            y = 40
                            width = 190
                            height = 88
        class = "demo_card"

        event hover_card { trigger = "hover"
                            state = "hovered"
                            mode = "while" }
        event select_card { trigger = "click"
                            state = "selected"
                            mode = "toggle" }
        event reveal_panel {
            trigger = "hover"
            target = "details"
            state = "shown"
            mode = "while"
        }

        rect bg { x = 0
                            y = 0
                            width = 190
                            height = 88
                            rx = 8 }
        text title { x = 16
                            y = 16
                            width = 158
                            height = 24
                            content = "Review request" }
    }

    group details {
        x = 500
                            y = 30
                            width = 190
                            height = 110
        class = "demo_panel"
        rect bg { x = 0
                            y = 0
                            width = 190
                            height = 110
                            rx = 8 }
        text body { content = "Shown while hovering task_a" }
    }
}
WCL
                }

                callout note {
                    icon = "lightbulb"
                    header = "Runtime scope"
                    color = "#0d6efd"
                    paragraph cp { content = "Runtime z-order is limited to sibling shapes in the same SVG parent group. That keeps reordering predictable and avoids moving shapes across layout boundaries." }
                }
            }
        }
    }
}
