import <wdoc.wcl>
use wdoc::{page, layout, heading, paragraph, code, data_table, callout, bold, link}
use wdoc::draw::{diagram, rect, terminal, terminal_box, terminal_text, terminal_menu, terminal_cursor, graph_node, graph_row, graph_divider, text_block, tooltip, connection, database, pie_chart, bar_chart, line_chart, chart_point, collapsible_panel, input, checkbox, button}

page wdoc_drawing_widgets {
    section = ref("wcl_docs.wdoc.wdoc_drawing_widgets")
    title = "Drawing — Widgets"

    layout {
        vsplit v1 {
            split s1 {
                size = 100

                heading h1 {
                    level = 1
                    content = "Drawing — Widgets"
                }

                paragraph p1 {
                    content = "Widgets are " + bold("composite shapes") + " — pre-built clusters of primitives that render as a recognisable thing (a phone frame, a database cylinder, a UML class box). They live in <code>wdoc::draw</code> alongside the primitives, accept the usual positioning attributes (<code>x</code>, <code>y</code>, <code>width</code>, <code>height</code>), and add a few widget-specific attributes for content. The renderer treats them as rectangles for layout purposes, so they participate in <code>align</code> algorithms exactly like a <code>rect</code>."
                }

                heading h2_ui {
                    level = 2
                    content = "UI mockups"
                }

                paragraph p_ui1 { content = "For wireframes and product mockups. Container-style widgets such as <code>card</code>, <code>collapsible_panel</code>, <code>phone</code>, <code>phone_landscape</code>, <code>tablet</code>, <code>tablet_landscape</code>, <code>window</code>, and <code>browser</code> work with the normal drawing layout attributes: use <code>align</code>, <code>gap</code>, and <code>padding</code> for auto-placed children, or keep using <code>x</code>/<code>y</code> and edge anchors for controls that need exact placement. Add a nested <code>tooltip</code> to any shape when it needs delayed hover or focus help." }

                data_table tbl_ui {
                    caption = "UI widgets"
                    rows = [
                        { widget = "phone",   attrs = "title, header_fill" },
                        { widget = "phone_landscape", attrs = "title, status_text, header_fill" },
                        { widget = "tablet",  attrs = "title, status_text, header_fill" },
                        { widget = "tablet_landscape", attrs = "title, status_text, header_fill" },
                        { widget = "window",  attrs = "title, chrome_fill" },
                        { widget = "browser", attrs = "title, url" },
                        { widget = "button",  attrs = "label, variant (primary, secondary, outline)" },
                        { widget = "input",   attrs = "label, placeholder" },
                        { widget = "checkbox", attrs = "label, checked, disabled" },
                        { widget = "radio", attrs = "label, selected, disabled" },
                        { widget = "button_group", attrs = "items, active_index" },
                        { widget = "textbox", attrs = "label, placeholder, value, rows" },
                        { widget = "dropdown", attrs = "label, value, placeholder, items, open" },
                        { widget = "inline_image", attrs = "src, fit, caption" },
                        { widget = "menubar", attrs = "items, active_index" },
                        { widget = "context_menu", attrs = "items, dismiss_on_leave, leave_close_targets" },
                        { widget = "card",    attrs = "(container — children render inside)" },
                        { widget = "collapsible_panel", attrs = "title, collapsed, collapse_group" },
                        { widget = "tooltip", attrs = "delay_ms, width, height, offset_x, offset_y, drawing-shape children" },
                        { widget = "avatar",  attrs = "label" },
                        { widget = "toggle",  attrs = "on (\"true\" / \"false\")" },
                        { widget = "badge",   attrs = "label, color" },
                        { widget = "navbar",  attrs = "title" },
                        { widget = "datatable", attrs = "columns, rows, datatable_column / datatable_row / datatable_cell children" }
                    ]
                }

                heading h2_charts {
                    level = 2
                    content = "Charts"
                }

                paragraph p_charts {
                    content = "Use <code>pie_chart</code>, <code>bar_chart</code>, and <code>line_chart</code> for compact dashboard wireframes. Data is passed through child <code>chart_point</code> blocks with <code>label</code>, <code>value</code>, optional <code>color</code>, and optional <code>x</code> for line charts. Bar and line charts accept <code>y_min</code> and <code>y_max</code>; line charts also accept <code>x_min</code> and <code>x_max</code>."
                }

                data_table tbl_charts {
                    caption = "Chart widgets"
                    rows = [
                        { widget = "pie_chart", attrs = "title, total, pie_radius, show_legend, chart_point children" },
                        { widget = "bar_chart", attrs = "title, y_min, y_max, tick_count, bar_gap, chart_point children" },
                        { widget = "line_chart", attrs = "title, x_min, x_max, y_min, y_max, tick_count, show_points, chart_point children" },
                        { widget = "chart_point", attrs = "label, value, color, x" }
                    ]
                }

                code ccharts {
                    language = "wcl"
                    content = "diagram dashboard {\n    width = 760\n    height = 280\n\n    bar_chart revenue {\n        x = 20\n        y = 20\n        width = 330\n        height = 220\n        title = \"Revenue\"\n        y_min = 0\n        y_max = 100\n        chart_point jan { label = \"Jan\" value = 42 }\n        chart_point feb { label = \"Feb\" value = 68 }\n        chart_point mar { label = \"Mar\" value = 84 }\n    }\n\n    line_chart adoption {\n        x = 380\n        y = 20\n        width = 340\n        height = 220\n        title = \"Adoption\"\n        x_min = 0\n        x_max = 3\n        y_min = 0\n        y_max = 100\n        chart_point q1 { label = \"Q1\" x = 0 value = 22 }\n        chart_point q2 { label = \"Q2\" x = 1 value = 46 }\n        chart_point q3 { label = \"Q3\" x = 2 value = 72 }\n        chart_point q4 { label = \"Q4\" x = 3 value = 88 }\n    }\n}"
                }

                heading h2_terminal {
                    level = 2
                    content = "Terminal and TUI diagrams"
                }

                paragraph p_terminal {
                    content = "Use <code>terminal</code> for fixed-grid terminal output inside a diagram. It uses bundled JetBrainsMono Nerd Font, accepts <code>rows</code> and <code>cols</code>, supports ANSI SGR styles and 16/256/truecolor foreground and background colours, and can host TUI-style child widgets positioned by row and column."
                }

                diagram terminal_demo {
                    width = 720
                    height = 300

                    terminal shell {
                        x = 20
                        y = 20
                        rows = 14
                        cols = 76
                        font_size = 13
                        background_fill = "#0b1020"
                        foreground_fill = "#d7e0ff"
                        content = "$ cargo test\n\u001b[32mPASS\u001b[0m parser::ansi_styles\n\u001b[33mWARN\u001b[0m snapshot updated\n\nUse arrows to select a command:"

                        terminal_box panel {
                            row = 5
                            col = 2
                            rows = 7
                            cols = 34
                            title = "Commands"
                            foreground_fill = "#93c5fd"
                        }

                        terminal_menu commands {
                            row = 7
                            col = 4
                            cols = 28
                            items = "Build,Test,Format,Deploy"
                            selected_index = 1
                            foreground_fill = "#d7e0ff"
                            background_fill = "#111827"
                            selected_background_fill = "#38bdf8"
                            selected_foreground_fill = "#06121f"
                        }

                        terminal_text status {
                            row = 12
                            col = 2
                            content = "\u001b[2mPress Enter to run selected command\u001b[0m"
                        }

                        terminal_cursor cursor {
                            row = 3
                            col = 0
                            mode = "bar"
                            fill = "#f8fafc"
                        }
                    }
                }

                code cui_terminal {
                    language = "wcl"
                    content = "diagram tui_doc {\n    width = 720, height = 300\n\n    terminal shell {\n        x = 20, y = 20\n        rows = 14\n        cols = 76\n        font_size = 13\n        background_fill = \"#0b1020\"\n        foreground_fill = \"#d7e0ff\"\n        content = \"$ cargo test\\n\\u001b[32mPASS\\u001b[0m parser::ansi_styles\"\n\n        terminal_box menu_frame { row = 5, col = 2, rows = 7, cols = 34, title = \"Commands\" }\n        terminal_menu commands { row = 7, col = 4, cols = 28, items = \"Build,Test,Format,Deploy\", selected_index = 1 }\n        terminal_cursor cursor { row = 3, col = 0, mode = \"bar\" }\n    }\n}"
                }

                code cui1 {
                    language = "wcl"
                    content = "diagram mockup {\n    width = 600, height = 360\n\n    card form {\n        x = 20, y = 20, width = 240, height = 300\n        title = \"Sign in\"\n        align = \"stack\"\n        gap = 12\n        padding = 18\n\n        input email { height = 55, label = \"Email\" }\n        input password { height = 55, label = \"Password\" }\n        button submit { height = 38, label = \"Continue\", variant = \"primary\" }\n        button help {\n            right = 18, bottom = 18, width = 90, height = 32\n            label = \"Help\"\n            variant = \"outline\"\n        }\n    }\n\n    browser b1 {\n        x = 300, y = 20, width = 280, height = 200\n        title = \"Dashboard\"\n        url = \"https://app.example.com\"\n    }\n}"
                }

                diagram tooltip_demo {
                    width = 500
                    height = 180

                    rect api {
                        x = 32
                        y = 44
                        width = 150
                        height = 70
                        rx = 8
                        fill = "#eff6ff"
                        stroke = "#2563eb"

                        tooltip api_tip {
                            width = 250
                            height = 96
                            delay_ms = 500
                            text_block body {
                                width = 230
                                paragraph p {
                                    content = "Routes **signed** requests and emits `AuditEvent` records."
                                }
                            }
                        }
                    }

                    button deploy {
                        x = 260
                        y = 58
                        width = 120
                        height = 38
                        label = "Deploy"
                        variant = "primary"

                        tooltip deploy_tip {
                            width = 220
                            height = 80
                            text_block body {
                                width = 200
                                paragraph p { content = "Starts a staged rollout after checks pass." }
                            }
                        }
                    }
                }

                diagram collapsible_panel_demo {
                    width = 620
                    height = 230

                    collapsible_panel filters {
                        x = 20
                        y = 20
                        width = 260
                        height = 180
                        title = "Filters"
                        collapse_group = "sidebar"
                        align = "stack"
                        gap = 10
                        padding = 14

                        input query { height = 52 label = "Search" }
                        checkbox active { height = 28 label = "Active only" checked = "true" }
                        button apply { height = 34 label = "Apply" variant = "primary" }
                    }

                    collapsible_panel details {
                        x = 320
                        y = 20
                        width = 260
                        height = 180
                        title = "Details"
                        collapse_group = "sidebar"
                        collapsed = true
                        align = "stack"
                        gap = 10
                        padding = 14

                        input owner { height = 52 label = "Owner" }
                        checkbox archived { height = 28 label = "Include archived" }
                    }
                }

                code cui_menu {
                    language = "wcl"
                    content = "class popup_menu {\n    opacity = 0\n    visible = false\n    pointer_events = \"none\"\n    state shown {\n        opacity = 1\n        visible = true\n        pointer_events = \"all\"\n    }\n}\n\ndiagram menu_example {\n    width = 520, height = 180\n\n    menubar app_menu {\n        x = 20, y = 20, width = 260, height = 34\n        items = \"File,Edit,View\"\n        event open_menu {\n            trigger = \"click\"\n            target = \"file_menu\"\n            state = \"shown\"\n            mode = \"toggle\"\n        }\n    }\n\n    button row {\n        x = 20, y = 92, width = 140, height = 36\n        label = \"Right click\"\n        event open_context {\n            trigger = \"right_click\"\n            target = \"row_menu\"\n            state = \"shown\"\n            mode = \"toggle\"\n        }\n    }\n\n    context_menu file_menu { x = 20, y = 58, width = 150, items = \"New,Open,Save\", class = \"popup_menu\" }\n    context_menu row_menu { x = 180, y = 84, width = 150, items = \"Open,Duplicate,Delete\", class = \"popup_menu\" }\n}"
                }

                paragraph p_ui_menu_leave {
                    content = "Context menus remove their own <code>shown</code> state when the mouse leaves the menu surface. Set <code>dismiss_on_leave = \"false\"</code> to opt out, or use <code>leave_close_targets</code> to remove <code>shown</code> from a comma-separated list of related menus."
                }

                heading h2_theme {
                    level = 2
                    content = "Widget theme properties"
                }

                paragraph p_theme {
                    content = "Built-in widgets expose their visual parts as attributes such as <code>background_fill</code>, <code>surface_fill</code>, <code>border_stroke</code>, <code>label_fill</code>, <code>header_fill</code>, <code>knob_fill</code>, and <code>separator_stroke</code>. You can set those attributes directly on a widget, or define them in a drawing class. If a widget has no <code>class</code>, the renderer looks for a default class named <code>wdoc-widget-</code> plus the widget kind, for example <code>wdoc-widget-button</code>. If <code>class</code> is set, that class replaces the default theme class. Direct widget attributes always win over class defaults."
                }

                code ctheme {
                    language = "wcl"
                    content = "class wdoc-widget-button {\n    background_fill = \"#0f766e\"\n    border_stroke = \"#0f766e\"\n    label_fill = \"#ffffff\"\n    radius = 8\n}\n\nclass brand_button {\n    background_fill = \"#7c3aed\"\n    border_stroke = \"#6d28d9\"\n    label_fill = \"#ffffff\"\n}\n\ndiagram themed_controls {\n    width = 360\n    height = 140\n\n    button default_submit {\n        x = 20, y = 24, width = 140, height = 38\n        label = \"Default class\"\n    }\n\n    button custom_submit {\n        x = 190, y = 24, width = 140, height = 38\n        class = \"brand_button\"\n        label = \"Replacement\"\n    }\n\n    button danger {\n        x = 105, y = 82, width = 140, height = 38\n        class = \"brand_button\"\n        label = \"Override\"\n        background_fill = \"#b91c1c\"\n        border_stroke = \"#b91c1c\"\n    }\n}"
                }

                heading h2_graph {
                    level = 2
                    content = "Graph nodes"
                }

                paragraph p_graph {
                    content = "<code>graph_node</code> renders a card with nested <code>graph_row</code> entries. Rows expose explicit left and right ports, and connections target those ports with scoped IDs such as <code>api.out</code> or <code>db.query</code>. Use <code>graph_divider</code> to draw section lines between rows. Add <code>text_block</code> children when a node needs wrapped WDoc paragraphs or code panels."
                }

                data_table tbl_graph {
                    caption = "Graph node widgets"
                    rows = [
                        { widget = "graph_node", attrs = "title, subtitle, row_height, header_height, port_radius, port_fill, unused_port_fill" },
                        { widget = "graph_row",  attrs = "label, detail, left_port, right_port, left_ports, right_ports" },
                        { widget = "graph_divider", attrs = "height, inset, stroke, stroke_width, opacity" },
                        { widget = "text_block", attrs = "content, padding, gap, font_size, line_height, code_font_size, code_background_fill" }
                    ]
                }

                diagram graph_node_doc_example {
                    width = 720
                    height = 300

                    graph_node api {
                        x = 30
                        y = 34
                        width = 230
                        title = "API"
                        subtitle = "edge service"

                        graph_row request {
                            label = "Request"
                            left_port = "in"
                            right_port = "route"
                        }

                        graph_divider boundary { }

                        graph_row users {
                            label = "Users"
                            right_port = "users"
                        }

                        graph_row events {
                            label = "Events"
                            right_port = "events"
                            detail = "async"
                        }

                        text_block docs {
                            left = 14
                            top = 124
                            right = 14

                            paragraph summary {
                                content = "Routes **authenticated** traffic and emits `AuditEvent` records."
                            }

                            code snippet {
                                language = "wcl"
                                content = "connection e { from = \"api.events\" to = \"worker.in\" direction = \"to\" }"
                            }
                        }
                    }

                    graph_node worker {
                        x = 430
                        y = 44
                        width = 230
                        title = "Worker"

                        graph_row input {
                            label = "Input"
                            left_port = "in"
                        }

                        graph_row query {
                            label = "Query DB"
                            right_port = "query"
                        }
                    }

                    database db {
                        x = 470
                        y = 210
                        width = 110
                        height = 76
                        label = "DB"
                    }

                    connection e1 {
                        from = "api.route"
                        to = "worker.in"
                        direction = "to"
                    }

                    connection e2 {
                        from = "worker.query"
                        to = "db"
                        direction = "both"
                        to_anchor = "top"
                    }
                }

                code cgraph {
                    language = "wcl"
                    content = "diagram service_ports {\n    width = 720, height = 300\n\n    graph_node api {\n        x = 30, y = 34, width = 230\n        title = \"API\"\n        subtitle = \"edge service\"\n\n        graph_row request { label = \"Request\", left_port = \"in\", right_port = \"route\" }\n        graph_divider boundary { }\n        graph_row users   { label = \"Users\",   right_port = \"users\" }\n        graph_row events  { label = \"Events\",  right_port = \"events\", detail = \"async\" }\n    }\n\n    graph_node worker {\n        x = 430, y = 44, width = 230\n        title = \"Worker\"\n\n        graph_row input { label = \"Input\", left_port = \"in\" }\n        graph_row query { label = \"Query DB\", right_port = \"query\" }\n    }\n\n    database db { x = 470, y = 210, width = 110, height = 76, label = \"DB\" }\n\n    connection e1 { from = \"api.route\",    to = \"worker.in\", direction = \"to\" }\n    connection e2 { from = \"worker.query\", to = \"db\",        direction = \"both\", to_anchor = \"top\" }\n}"
                }

                heading h2_flow {
                    level = 2
                    content = "Flowchart shapes"
                }

                data_table tbl_flow {
                    caption = "Flowchart widgets"
                    rows = [
                        { widget = "flow_terminal",   description = "Rounded oval — start / end" },
                        { widget = "flow_process",    description = "Process box" },
                        { widget = "flow_decision",   description = "Diamond decision node" },
                        { widget = "flow_io",         description = "Parallelogram input / output" },
                        { widget = "flow_subprocess", description = "Subprocess box (double border)" }
                    ]
                }

                paragraph p_flow1 {
                    content = "Each flowchart widget accepts a <code>label</code>, plus an optional <code>color</code>. Combine them with <code>align = \"layered\"</code> for an automatically routed flowchart."
                }

                code cflow {
                    language = "wcl"
                    content = "diagram pipeline {\n    width = 700, height = 320\n    align = \"layered\"\n    gap   = 50\n\n    flow_terminal start { width = 120, height = 40, label = \"Start\", color = \"#28a745\" }\n    flow_process  step  { width = 150, height = 50, label = \"Process input\" }\n    flow_decision ok    { width = 120, height = 80, label = \"Valid?\" }\n    flow_process  err   { width = 140, height = 50, label = \"Log error\", color = \"#d32f2f\" }\n    flow_terminal done  { width = 120, height = 40, label = \"End\", color = \"#28a745\" }\n\n    connection e1 { from = \"start\", to = \"step\", direction = \"to\" }\n    connection e2 { from = \"step\",  to = \"ok\",   direction = \"to\" }\n    connection e3 { from = \"ok\",    to = \"done\", direction = \"to\", label = \"Yes\" }\n    connection e4 { from = \"ok\",    to = \"err\",  direction = \"to\", label = \"No\" }\n    connection e5 { from = \"err\",   to = \"done\", direction = \"to\" }\n}"
                }

                heading h2_c4 {
                    level = 2
                    content = "C4 architecture shapes"
                }

                data_table tbl_c4 {
                    caption = "C4 widgets"
                    rows = [
                        { widget = "c4_person",    attrs = "label, description" },
                        { widget = "c4_system",    attrs = "label, description, external (\"true\" / \"false\")" },
                        { widget = "c4_container", attrs = "label, description, technology" },
                        { widget = "c4_component", attrs = "label, description" },
                        { widget = "c4_boundary",  attrs = "label (container, children render inside)" }
                    ]
                }

                code cc4 {
                    language = "wcl"
                    content = "diagram c4_context {\n    width = 700, height = 280\n\n    c4_person customer {\n        x = 50, y = 90, width = 100, height = 110\n        label = \"Customer\"\n        description = \"Uses the app\"\n    }\n    c4_system app {\n        x = 270, y = 80, width = 160, height = 90\n        label = \"My App\"\n        description = \"Core platform\"\n    }\n    c4_system payments {\n        x = 530, y = 80, width = 150, height = 90\n        label = \"Payments\"\n        description = \"Processes payments\"\n        external = \"true\"\n    }\n\n    connection u_app { from = \"customer\", to = \"app\",      direction = \"to\", label = \"Uses\" }\n    connection a_pay { from = \"app\",      to = \"payments\", direction = \"to\", label = \"Charges via\" }\n}"
                }

                heading h2_uml {
                    level = 2
                    content = "UML shapes"
                }

                data_table tbl_uml {
                    caption = "UML widgets"
                    rows = [
                        { widget = "uml_class",   attrs = "label, stereotype, fields, methods (pipe-separated lists)" },
                        { widget = "uml_actor",   attrs = "label" },
                        { widget = "uml_package", attrs = "label" },
                        { widget = "uml_note",    attrs = "label" }
                    ]
                }

                code cuml {
                    language = "wcl"
                    content = "uml_class user {\n    x = 30, y = 20, width = 180, height = 160\n    label   = \"User\"\n    fields  = \"- id: i64|- name: String|- email: String\"\n    methods = \"+ login()|+ toString(): String\"\n}"
                }

                heading h2_net {
                    level = 2
                    content = "Network and infrastructure"
                }

                data_table tbl_net {
                    caption = "Network widgets"
                    rows = [
                        { widget = "server",   description = "Server / VM rack icon (label)" },
                        { widget = "database", description = "Database cylinder (label)" },
                        { widget = "cloud",    description = "Cloud / managed service (label)" },
                        { widget = "user",     description = "User / actor for network diagrams (label)" }
                    ]
                }

                code cnet {
                    language = "wcl"
                    content = "diagram topology {\n    width = 600, height = 280\n\n    user   users   { x = 20,  y = 100, width = 80,  height = 100, label = \"Users\" }\n    cloud  cdn     { x = 130, y = 30,  width = 130, height = 90,  label = \"CDN\" }\n    server lb      { x = 130, y = 150, width = 90,  height = 100, label = \"LB\" }\n    server web     { x = 290, y = 100, width = 90,  height = 110, label = \"Web\" }\n    database db    { x = 450, y = 90,  width = 100, height = 120, label = \"Postgres\" }\n\n    connection u_lb  { from = \"users\", to = \"lb\",  direction = \"to\" }\n    connection lb_w  { from = \"lb\",    to = \"web\", direction = \"to\" }\n    connection w_db  { from = \"web\",   to = \"db\",  direction = \"both\" }\n    connection u_cdn { from = \"users\", to = \"cdn\", direction = \"to\" }\n}"
                }

                callout c_note {
                    icon = "info"
                    header = "Widgets are just WCL functions"
                    color = "#0d6efd"
                    paragraph wp {
                        content = "Every widget on this page is implemented as an exported WCL function in <code>wdoc.wcl</code> that returns a list of primitive shape descriptors. The same mechanism is open to user code — see " + link("Custom Shapes", "wdoc_drawing_custom.html") + " for the recipe. You can also mix widgets and primitives freely in the same diagram; connections work between them with no special rules."
                    }
                }
            }
        }
    }
}
