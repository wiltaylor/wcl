import <wdoc.wcl>
use wdoc::{page, layout, heading, paragraph, code, data_table}

page wdoc_drawing_shapes {
    section = "wcl_docs.wdoc.wdoc_drawing_shapes"
    title = "Drawing — Shapes"

    layout {
        vsplit v1 {
            split s1 {
                size = 100

                heading h1 {
                    level = 1
                    content = "Drawing — Shapes"
                }

                paragraph p1 {
                    content = "WDoc drawing primitives map mostly onto SVG elements, with a few authoring helpers for interactive diagrams and game mockups. All accept the common positioning and styling attributes described in the Drawing Overview; this page focuses on the attributes that are specific to each kind."
                }

                heading h2_rect {
                    level = 2
                    content = "rect"
                }

                paragraph p_r1 { content = "Axis-aligned rectangle. Use <code>rx</code> / <code>ry</code> for rounded corners. A nested <code>text</code> child is centered automatically." }

                code cr1 {
                    language = "wcl"
                    content = "rect box {\n    x = 20, y = 20, width = 160, height = 60\n    rx = 8\n    fill = \"var(--color-code-bg)\"\n    stroke = \"var(--color-link)\"\n    stroke_width = 2\n    text t { content = \"Hello\" }\n}"
                }

                heading h2_circle {
                    level = 2
                    content = "circle"
                }

                paragraph p_c1 { content = "Circle with radius <code>r</code>. The shape's bounding box is computed from <code>r</code>; <code>x</code>/<code>y</code> position the top-left of that box." }

                code cc1 {
                    language = "wcl"
                    content = "circle dot {\n    x = 100, y = 100\n    r = 40\n    fill = \"var(--color-link)\"\n    text t { content = \"Node\", fill = \"#fff\" }\n}"
                }

                heading h2_ellipse {
                    level = 2
                    content = "ellipse"
                }

                paragraph p_e1 { content = "Ellipse with separate <code>rx</code> and <code>ry</code> radii." }

                code ce1 {
                    language = "wcl"
                    content = "ellipse oval {\n    x = 50, y = 50\n    rx = 80, ry = 40\n    fill = \"var(--color-nav-bg)\"\n    stroke = \"var(--color-nav-border)\"\n}"
                }

                heading h2_line {
                    level = 2
                    content = "line"
                }

                paragraph p_l1 { content = "Straight line segment between (<code>x1</code>, <code>y1</code>) and (<code>x2</code>, <code>y2</code>). Use <code>stroke_dasharray</code> for dashed lines." }

                code cl1 {
                    language = "wcl"
                    content = "line divider {\n    x1 = 0, y1 = 100\n    x2 = 400, y2 = 100\n    stroke = \"var(--color-text)\"\n    stroke_width = 2\n    stroke_dasharray = \"8,4\"\n}"
                }

                heading h2_path {
                    level = 2
                    content = "path"
                }

                paragraph p_p1 { content = "Arbitrary SVG path. The <code>d</code> attribute is passed through to the rendered <code>&lt;path&gt;</code> element." }

                code cp1 {
                    language = "wcl"
                    content = "path arrow {\n    d = \"M 10 10 L 100 10 L 90 0 M 100 10 L 90 20\"\n    fill = \"none\"\n    stroke = \"var(--color-link)\"\n    stroke_width = 2\n}"
                }

                heading h2_group {
                    level = 2
                    content = "group"
                }

                paragraph p_g1 { content = "A non-visual SVG <code>&lt;g&gt;</code> container for grouping child shapes. Use it to make a background, label, and interaction attributes behave as one control." }

                code cg1 {
                    language = "wcl"
                    content = "draw::class button_face {\n    fill = \"#5E81AC\"\n    stroke = \"#5E81AC\"\n    transition = \"fill 160ms ease, stroke 160ms ease\"\n\n    state hovered {\n        fill = \"#81A1C1\"\n        stroke = \"#81A1C1\"\n    }\n}\n\ndiagram button_preview {\n    width = 180\n    height = 70\n\n    group button {\n        x = 20, y = 16, width = 140, height = 38\n        cursor = \"pointer\"\n        pointer_events = \"all\"\n\n        event hover_button {\n            trigger = \"hover\"\n            target = \"bg\"\n            state = \"hovered\"\n            mode = \"while\"\n        }\n\n        rect bg {\n            x = 0, y = 0, width = 140, height = 38\n            rx = 6\n            class = \"button_face\"\n        }\n\n        text label {\n            x = 0, y = 0, width = 140, height = 38\n            content = \"Preview\"\n            fill = \"#fff\"\n            font_weight = \"600\"\n        }\n    }\n}"
                }

                heading h2_sprites {
                    level = 2
                    content = "dopesheet, sprite, tilemap, and game_layer"
                }

                paragraph p_sprite1 {
                    content = "A <code>dopesheet</code> describes a regular sprite sheet: source image, frames per row, frame size, optional offsets, and optional gaps. A <code>sprite</code> renders one frame from the sheet and can animate selected frame indexes through class animations. Use <code>dopesheet_view</code> to show every frame as a uniform cropped grid, <code>tilemap</code> to draw orthogonal or isometric row-array maps from the same sheet, and <code>game_layer</code> to stack maps, sprites, effects, and locked HUD UI."
                }

                data_table tbl_sprite {
                    caption = "sprite sheet fields"
                    rows = [
                        { attr = "dopesheet.src", description = "Image path for the sheet" },
                        { attr = "columns", description = "How many frames are on each row" },
                        { attr = "frame_width, frame_height", description = "Source frame size in pixels" },
                        { attr = "offset_x, offset_y", description = "Optional top-left source offset before the first frame" },
                        { attr = "gap_x, gap_y", description = "Optional spacing between source frames" },
                        { attr = "sprite.sheet", description = "Referenced dopesheet id" },
                        { attr = "sprite.frame", description = "Initial frame index, zero-based" },
                        { attr = "dopesheet_view.sheet", description = "Referenced dopesheet id rendered as a uniform frame grid" },
                        { attr = "tilemap.sheet", description = "Referenced dopesheet id used as a tileset" },
                        { attr = "tilemap.rows", description = "List of row lists; numbers are frame indexes and null cells are empty" },
                        { attr = "tilemap.orientation", description = "Set to isometric for diamond tile placement" },
                        { attr = "tile_width, tile_height", description = "Rendered size of each tilemap cell; for isometric maps tile_height is the grid pitch" },
                        { attr = "tile_render_height", description = "Optional rendered sprite height for elevated isometric tiles" },
                        { attr = "game_layer.parallax", description = "Pan/zoom layer movement factor; 1 scrolls with the world" },
                        { attr = "game_layer.locked", description = "Keep the layer fixed to the viewport for HUD UI" },
                        { attr = "game_layer.clip", description = "Clip children to the layer bounds" },
                        { attr = "grid_stroke, grid_stroke_width", description = "Optional divider style for a dopesheet preview" },
                        { attr = "transparent_color", description = "Optional color key such as #ff00ff for sheets without alpha" }
                    ]
                }

                code csprite {
                    language = "wcl"
                    content = "class explosion_anim {\n    animation explode {\n        frame_rate = 24\n        frames = range(0, 50)\n    }\n\n    state active { animation = \"explode\" }\n}\n\ndiagram sprite_demo {\n    width = 520\n    height = 300\n\n    dopesheet explosion_sheet {\n        src = \"images/explosion1.png\"\n        columns = 10\n        frame_width = 100\n        frame_height = 100\n        frame_count = 50\n    }\n\n    sprite explosion {\n        x = 30\n        y = 30\n        width = 100\n        height = 100\n        sheet = \"explosion_sheet\"\n        frame = 0\n        class = \"explosion_anim\"\n\n        event click { trigger = \"click\" state = \"active\" mode = \"add\" }\n    }\n\n    dopesheet_view preview {\n        x = 170\n        y = 24\n        width = 320\n        height = 250\n        sheet = \"explosion_sheet\"\n        grid_stroke = \"#94a3b8\"\n    }\n}\n\ndiagram tilemap_demo {\n    width = 360\n    height = 240\n    mode = \"pan_zoom\"\n\n    dopesheet terrain_tiles {\n        src = \"images/Tiles32.png\"\n        columns = 4\n        frame_width = 32\n        frame_height = 32\n        frame_count = 4\n    }\n\n    dopesheet elevated_iso_blocks {\n        src = \"images/kenney_isometric_blocks_sheet.png\"\n        columns = 4\n        frame_width = 111\n        frame_height = 128\n        frame_count = 8\n    }\n\n    game_layer world {\n        tilemap map {\n            tile_width = 48\n            tile_height = 48\n            sheet = \"terrain_tiles\"\n            rows = [[0, 0, 1, null], [0, 2, 3, 1]]\n        }\n\n        tilemap iso {\n            orientation = \"isometric\"\n            tile_width = 112\n            tile_height = 64\n            tile_render_height = 128\n            sheet = \"elevated_iso_blocks\"\n            rows = [[0, 0, 1], [4, 5, 2]]\n        }\n    }\n\n    game_layer hud {\n        z_index = 100\n        locked = true\n        rect panel { x = 16 y = 16 width = 140 height = 40 }\n    }\n}"
                }

                data_table tbl_safe_attrs {
                    caption = "safe SVG passthrough attributes"
                    rows = [
                        { attr = "class",          description = "One or more document-level draw classes applied to a shape" },
                        { attr = "style",          description = "Inline SVG style attribute" },
                        { attr = "cursor",         description = "SVG cursor attribute, for example pointer" },
                        { attr = "pointer_events", description = "Rendered as pointer-events" },
                        { attr = "visible",        description = "false hides after layout, preserving bounds" },
                        { attr = "z_index",        description = "Paint order among siblings; state z_index can reorder at runtime" },
                        { attr = "css",            description = "Deprecated compatibility escape hatch for diagram-level scoped CSS" }
                    ]
                }

                heading h2_classes_events {
                    level = 2
                    content = "Classes, states, and events"
                }

                paragraph p_classes_events {
                    content = "Document-level <code>draw::class</code> blocks define reusable renderer-neutral shape properties and named states. Shape-level <code>event</code> blocks apply those states at runtime without exposing raw CSS as the primary authoring API."
                }

                code c_classes_events {
                    language = "wcl"
                    content = "draw::class card {\n    fill = \"#ffffff\"\n    stroke = \"#94a3b8\"\n    stroke_width = 1\n    rx = 8\n    opacity = 1\n    visible = true\n    z_index = 0\n    transition = \"fill 160ms ease, stroke 160ms ease, opacity 120ms ease\"\n\n    state hovered {\n        fill = \"#eef6ff\"\n        stroke = \"#3b82f6\"\n        z_index = 10\n    }\n\n    state hidden {\n        opacity = 0\n        visible = false\n        pointer_events = \"none\"\n    }\n\n    state selected {\n        stroke_width = 3\n        z_index = 20\n    }\n\n    state shown {\n        opacity = 1\n        visible = true\n        pointer_events = \"all\"\n    }\n}\n\ndiagram interaction_demo {\n    width = 360\n    height = 140\n\n    rect task {\n        x = 20, y = 20, width = 160, height = 80\n        class = \"card\"\n\n        event hover_card {\n            trigger = \"hover\"\n            state = \"hovered\"\n            mode = \"while\"\n        }\n\n        event select_card {\n            trigger = \"click\"\n            state = \"selected\"\n            mode = \"toggle\"\n        }\n\n        event show_details {\n            trigger = \"hover\"\n            target = \"details\"\n            state = \"shown\"\n            mode = \"while\"\n        }\n    }\n\n    rect details {\n        x = 210, y = 20, width = 120, height = 80\n        class = \"card\"\n        visible = false\n    }\n}"
                }

                data_table tbl_events {
                    caption = "event fields"
                    rows = [
                        { attr = "trigger",         description = "Required: hover, click, double_click, mouse_down, mouse_leave, or right_click" },
                        { attr = "state",           description = "Required named state to apply" },
                        { attr = "target",          description = "self by default, or another shape ID in the same diagram" },
                        { attr = "button",          description = "For mouse_down: left, middle, or right; default left" },
                        { attr = "mode",            description = "while, toggle, add, remove, or pulse; sensible defaults are chosen per trigger" },
                        { attr = "duration_ms",     description = "Pulse duration; default 180" },
                        { attr = "prevent_default", description = "Defaults to true for right_click" }
                    ]
                }

                data_table tbl_keyframes {
                    caption = "animation keyframe fields"
                    rows = [
                        { attr = "offset",          description = "Percent position from 0 to 100" },
                        { attr = "x, y",            description = "Animated shape position in SVG units" },
                        { attr = "width, height",   description = "Animated shape bounds in SVG units" },
                        { attr = "rotate",          description = "Animated rotation in degrees" },
                        { attr = "rotate_origin_x, rotate_origin_y", description = "Optional absolute SVG pivot; defaults to the animated shape center" },
                        { attr = "frame_rate, frames", description = "For sprites: frames per second and the selected dopesheet frame indexes to play" }
                    ]
                }

                heading h2_text {
                    level = 2
                    content = "text"
                }

                paragraph p_t1 { content = "A text label. As a child of another shape with no explicit position or size, it fills the parent's inner box and is centered — this is the typical pattern for labelling rects, circles, and widgets." }
                paragraph p_t2 { content = "For inline layout, positioned text can omit <code>width</code> and <code>height</code>. WDoc resolves a natural size with <code>measure_text(...)</code>, returning <code>width</code>, <code>height</code>, and <code>baseline</code>. The fallback measurement is deterministic and approximate because it does not use browser font metrics." }

                data_table tbl_text {
                    caption = "text-specific attributes"
                    rows = [
                        { attr = "content",          description = "The text to render. Newlines render as multiple SVG tspans." },
                        { attr = "font_size",        description = "Font size in SVG units (default 14)" },
                        { attr = "font_family",      description = "SVG font-family, for example Inter, system-ui, sans-serif" },
                        { attr = "font_weight",      description = "SVG font-weight, for example 400, 600, or bold" },
                        { attr = "font_style",       description = "SVG font-style, for example normal or italic" },
                        { attr = "line_height",      description = "Line-height multiplier for multi-line text layout (default 1.2)" },
                        { attr = "text_decoration",  description = "SVG text-decoration, for example underline" },
                        { attr = "letter_spacing",   description = "SVG letter-spacing, for example 0.02em" },
                        { attr = "anchor",           description = "Horizontal alignment: start, middle (default), end" },
                        { attr = "fill",             description = "Text color (defaults to currentColor)" }
                    ]
                }

                code ct1 {
                    language = "wcl"
                    content = "// Standalone label\ntext label {\n    x = 50, y = 100, width = 240, height = 50\n    content = \"Section heading\\nToken preview\"\n    font_size = 16\n    font_family = \"Inter, system-ui, sans-serif\"\n    font_weight = \"600\"\n    font_style = \"italic\"\n    line_height = 1.5\n    text_decoration = \"underline\"\n    letter_spacing = \"0.02em\"\n    anchor = \"start\"\n}"
                }

                code ct2 {
                    language = "wcl"
                    content = "let label_size = measure_text({\n    content = \"Inline text\"\n    font_family = \"Inter, system-ui, sans-serif\"\n    font_size = 14\n    font_weight = \"400\"\n    font_style = \"normal\"\n    letter_spacing = \"0\"\n})\n\ntext label {\n    x = 20\n    y = 20\n    content = \"Inline text\"\n    font_size = 14\n}\n\nimage icon {\n    x = 20 + label_size.width + 8\n    y = 18\n    width = 16\n    height = 16\n    src = \"assets/icon.png\"\n}"
                }
            }
        }
    }
}
