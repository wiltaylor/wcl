// WCL's own documentation, authored in wdoc and rendered by `wcl wdoc`.
//
//   wcl wdoc serve docs/main.wcl                 # / = WCL landing, /reference/ = book
//   wcl wdoc build docs/main.wcl --out docs/_site
//     → docs/_site/index.html        WCL landing (webpage template)
//       docs/_site/reference/…       WCL language reference (book template)
//
// One document, two sites. A page joins a site via its `sites` array
// (`sites = [:wcl]` / `sites = [:reference]`); page names are unique
// per site, so both sites carry their own `index`. The single
// `import <wdoc.wcl>` below pulls in the embedded wdoc standard library,
// so every stdlib block (`page` / `text` / `code` / `callout` / `table`
// / `h1`..`h6` / …) is in scope here and in every imported page.
import <wdoc.wcl>

// The reference content lives in wskills — self-contained WCL models under
// docs/wskills/, each projected into a book (included here) and a Claude Code
// skill. `include` builds every member's book under docs/_site/wskills/<name>/;
// the landing page lists them via `included_sites(...)` (a registry, by hand).
include "wskills" { entry = "wdoc/book/main.wcl" }

// Reused in hero prose: paints with the active theme's accent hue so it
// stays readable on dark and light.
class accent {
  color = "var(--wdoc-accent)"
  bold  = true
}

// The WCL landing: the `webpage` template (title header + top navbar).
// `root = true` serves it at `/`; the reference book renders under
// `/reference/`. Nord theme, cyan accent. Subject is the language itself —
// wdoc (the tool rendering this very site) is one of WCL's features.
site wcl {
  default_template = :webpage
  title            = "WCL"
  root             = true
  theme            = :nord
  accent           = :cyan
  menu {
    item "Home"            { page = index }
    item "Features"        { page = features }
    item "Getting started" { page = getting_started }
    // Cross-site dropdown: each reference is its own built site, so link
    // by root-relative output path (a `page =` here would only resolve
    // within this site). An `item` with nested `item`s renders as a
    // click-to-open dropdown parent.
    item "Reference" {
      item "wcl"    { href = "wskills/wcl/" }
      item "wdoc"   { href = "wskills/wdoc/" }
      item "wskill" { href = "wskills/wskill/" }
    }
    item "Source"          { href = "https://github.com/wiltaylor/wcl" }
  }
}

// The wdoc reference: the `book` template documenting the documentation
// generator's blocks. (The WCL language, builtins and CLI reference now live
// in the `wcl` wskill — see docs/wskills/ and the landing page.)
site reference {
  default_template = :book
  title            = "wdoc Reference"
  theme            = :nord
  accent           = :cyan
  theme_toggle     = true
  search           = true
  toc {
    chapter "Introduction" { page = index }

    chapter "wdoc" {
      chapter "Overview"               { page = wdoc_overview }
      chapter "Sites & Templates"      { page = wdoc_sites }
      chapter "Pages"                  { page = wdoc_pages }
      chapter "Including sub-sites"    { page = wdoc_includes }
      chapter "Block Visibility"       { page = wdoc_visibility }
      chapter "Markdown Output"        { page = wdoc_markdown }
      chapter "Skill Folders"          { page = wdoc_skills }
      chapter "Formatting"             { page = wdoc_formatting }
      chapter "Data Views"             { page = wdoc_data_views }
      chapter "Math Equations"         { page = wdoc_math }
      chapter "Tables"                 { page = wdoc_tables }
      chapter "Columns"                { page = wdoc_columns }
      chapter "Styling"                { page = wdoc_styling }
      chapter "Icons"                  { page = wdoc_icons }
      chapter "Images"                 { page = wdoc_images }
      chapter "Videos"                 { page = wdoc_videos }
      chapter "Diagrams"               { page = wdoc_diagrams
        chapter "Primitive Shapes"     { page = wdoc_primitives }
        chapter "Trees"                { page = wdoc_tree }
        chapter "Connections"          { page = wdoc_connections }
        chapter "Flowcharts"           { page = wdoc_flowcharts }
        chapter "Sequence Diagrams"    { page = wdoc_sequence_diagrams }
        chapter "State Diagrams"       { page = wdoc_state_diagrams }
        chapter "Charts"               { page = wdoc_charts }
        chapter "Timelines"            { page = wdoc_timelines }
        chapter "Tilemaps"             { page = wdoc_tilemaps }
        chapter "Maps"                 { page = wdoc_maps }
        chapter "Dopesheets"           { page = wdoc_dopesheets }
        chapter "Terminal"             { page = wdoc_terminals }
        chapter "Wireframe"            { page = wdoc_wireframe }
      }
    }
  }
}

// WCL landing pages (sites = [:wcl]).
import "./pages/wcl/index.wcl"
import "./pages/wcl/features.wcl"
import "./pages/wcl/getting-started.wcl"

// Reference book — Introduction.
import "./pages/reference/intro.wcl"

// Reference book — wdoc section.
import "./pages/reference/wdoc/overview.wcl"
import "./pages/reference/wdoc/sites.wcl"
import "./pages/reference/wdoc/pages.wcl"
import "./pages/reference/wdoc/includes.wcl"
import "./pages/reference/wdoc/visibility.wcl"
import "./pages/reference/wdoc/markdown.wcl"
import "./pages/reference/wdoc/skills.wcl"
import "./pages/reference/wdoc/formatting.wcl"
import "./pages/reference/wdoc/data-views.wcl"
import "./pages/reference/wdoc/math.wcl"
import "./pages/reference/wdoc/tables.wcl"
import "./pages/reference/wdoc/columns.wcl"
import "./pages/reference/wdoc/styling.wcl"
import "./pages/reference/wdoc/diagrams.wcl"
import "./pages/reference/wdoc/primitives.wcl"
import "./pages/reference/wdoc/tree.wcl"
import "./pages/reference/wdoc/connections.wcl"
import "./pages/reference/wdoc/flowcharts.wcl"
import "./pages/reference/wdoc/sequence-diagrams.wcl"
import "./pages/reference/wdoc/state-diagrams.wcl"
import "./pages/reference/wdoc/charts.wcl"
import "./pages/reference/wdoc/terminals.wcl"
import "./pages/reference/wdoc/wireframe.wcl"
import "./pages/reference/wdoc/timelines.wcl"
import "./pages/reference/wdoc/icons.wcl"
import "./pages/reference/wdoc/images.wcl"
import "./pages/reference/wdoc/videos.wcl"
