{
  "name": "wcl-vscode",
  "displayName": "WCL",
  "description": "Language support for WCL — syntax highlighting, diagnostics, and IDE features powered by `wcl lsp`.",
  "version": "0.0.1",
  "private": true,
  "publisher": "wcl",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "main": "./out/extension.js",
  "activationEvents": ["onLanguage:wcl"],
  "contributes": {
    "languages": [
      {
        "id": "wcl",
        "aliases": ["WCL"],
        "extensions": [".wcl"],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "WCL",
      "properties": {
        "wcl.serverPath": {
          "type": "string",
          "default": "wcl",
          "description": "Path to the `wcl` binary that runs the language server (`wcl lsp` is invoked under the hood)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
