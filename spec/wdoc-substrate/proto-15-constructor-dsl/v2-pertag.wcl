// V2 — PER-TAG CONSTRUCTORS. `div(cls, kids)`, `a(href, cls, kids)`, …
//
// Constrained by the language as it is: WCL fn calls are POSITIONAL,
// every parameter is MANDATORY, there are no defaults, no named
// arguments and no variadics (`ast.rs:119` — `Call { args: Vec<Expr> }`;
// `FnParam` is `{name, ty}` with no default). So a constructor's arity
// is fixed at declaration and every call must fill it.
//
// That is the whole design pressure. The common shape is (class,
// children); anything needing an `id` or a second attribute falls off
// to the 5-arg escape hatch `elem`, where you pass `none` twice — the
// exact ceremony the free fix just deleted.
import <wdoc.wcl>
import "fixtures.wcl"

@document
type Proto { s1: HtmlFundamental  s2: list<HtmlFundamental>  s3: list<SvgFundamental>  s4: list<HtmlFundamental> }

// >>> DSL
let raw = fn(h: utf8) -> HtmlFundamental HtmlFundamental::Raw { html: h }
let inl = fn(t: utf8) -> HtmlFundamental HtmlFundamental::Inline { text: t }
let icon = fn(n: utf8, cls: list<utf8>) -> HtmlFundamental HtmlFundamental::Icon { name: n, class: cls }
let para = fn(cls: list<utf8>, spans: list<utf8>) -> HtmlFundamental
  HtmlFundamental::Paragraph { class: cls, spans: spans }

// The full escape hatch. Five positional arguments, all mandatory.
//
// NOTE the signature is a lie and the language cannot help it: `?` is a
// PARSE ERROR in a parameter list ("expected ',' or ')' in parameter
// list, found '?'"), and there are ZERO optional fn params in the whole
// stdlib. So `id` is declared `identifier` and callers pass `none` —
// which works only because argument types are NOT CHECKED at all
// (verified: `elem("div", none, none, [])` evaluates clean).
let elem = fn(tag: utf8, id: identifier, cls: list<utf8>, attrs: list<list<utf8>>, kids: list<HtmlFundamental>) -> HtmlFundamental
  HtmlFundamental::Element { tag: tag, id: id, class: cls, attrs: attrs, children: kids }

// The common shape: (class, children).
let div = fn(cls: list<utf8>, kids: list<HtmlFundamental>) -> HtmlFundamental
  HtmlFundamental::Element { tag: "div", class: cls, children: kids }
let span = fn(cls: list<utf8>, kids: list<HtmlFundamental>) -> HtmlFundamental
  HtmlFundamental::Element { tag: "span", class: cls, children: kids }
let ul = fn(cls: list<utf8>, kids: list<HtmlFundamental>) -> HtmlFundamental
  HtmlFundamental::Element { tag: "ul", class: cls, children: kids }
let li = fn(cls: list<utf8>, kids: list<HtmlFundamental>) -> HtmlFundamental
  HtmlFundamental::Element { tag: "li", class: cls, children: kids }
let pp = fn(cls: list<utf8>, kids: list<HtmlFundamental>) -> HtmlFundamental
  HtmlFundamental::Element { tag: "p", class: cls, children: kids }
let header = fn(cls: list<utf8>, kids: list<HtmlFundamental>) -> HtmlFundamental
  HtmlFundamental::Element { tag: "header", class: cls, children: kids }

// `a` earns a third parameter because href is on every one of them.
let a = fn(href: utf8, cls: list<utf8>, kids: list<HtmlFundamental>) -> HtmlFundamental
  HtmlFundamental::Element { tag: "a", class: cls, attrs: [["href", href]], children: kids }

// The SVG half. Field-shaped, so the "constructor" is the variant's
// fields turned positional — which LOSES the names.
let sline = fn(x1: f64, y1: f64, x2: f64, y2: f64, cls: list<utf8>) -> SvgFundamental
  SvgFundamental::Line { x1: x1, y1: y1, x2: x2, y2: y2, class: cls }
let slabel = fn(t: utf8, x: f64, y: f64, size: f64, fw: f64, fh: f64, cls: list<utf8>) -> SvgFundamental
  SvgFundamental::Label { content: t, x: x, y: y, font_size: size, fit_width: fw, fit_height: fh, class: cls }
// <<< DSL

// >>> S1 website_header
let v2_website_header = fn(c: TemplateCtx) -> HtmlFundamental
  header(["ws-header"], flatten([
    [ a(if c.home_href == "" { "index.html" } else { c.home_href }, ["ws-brand"], [raw(c.title)]) ],
    if len(c.menu) == 0 {
      [ ul(["menu"], map(c.pages, fn(p: PageRef) -> HtmlFundamental
          li([], [ a(p.href, [], [raw(p.name)]) ]))) ]
    } else { wdoc_part_menu_tree(c.menu) },
    website_header_controls(c),
  ]))
// <<< S1

// >>> S2 book_toc
let v2_toc_link = fn(e: TocEntry) -> HtmlFundamental
  if e.href == "" { span(["book-section"], [raw(e.title)]) }
  else { a(e.href, ["book-chapter", if e.current { "current" } else { none }], [raw(e.title)]) }

let v2_toc_toggle = span(["book-toc-toggle"], [])

let v2_toc = fn(entries: list<TocEntry>) -> list<HtmlFundamental>
  if len(entries) == 0 { [] }
  else {
    [ ul(["book-toc"], map(entries, fn(e: TocEntry) -> HtmlFundamental {
        let branch = len(e.children) > 0;
        li([
            if branch { "book-branch" } else { none },
            if branch && toc_active(e) { "open" } else { none },
          ],
          flatten([
            [ div(["book-toc-row"], [ v2_toc_toggle, v2_toc_link(e) ]) ],
            v2_toc(e.children),
          ]))
      })) ]
  }
// <<< S2

// >>> S3 chart axes + gridlines + title
let v2_chart_axes = fn(px: f64, py: f64, pw: f64, ph: f64) -> list<SvgFundamental> [
  sline(px, py + ph, px + pw, py + ph, ["wdoc-axis"]),
  sline(px, py, px, py + ph, ["wdoc-axis"]),
]

let v2_chart_gridlines = fn(px: f64, py: f64, pw: f64, ph: f64, ymin: f64, ymax: f64, nticks: i64) -> list<SvgFundamental>
  flatten(map(range(0, nticks + 1), fn(k: i64) -> list<SvgFundamental> {
    let yy = py + ph - ph * k / nticks;
    let val = ymin + (ymax - ymin) * k / nticks;
    [
      sline(px, yy, px + pw, yy, ["wdoc-grid"]),
      slabel(chart_fmt(val), px - 6.0, yy, 10.0, 32.0, 12.0, ["wdoc-axis-label"]),
    ]
  }))

let v2_chart_title = fn(cx: f64, cy: f64, cw: f64, text: utf8) -> list<SvgFundamental>
  if text == "" { [] }
  else { [ slabel(text, cx, cy + 11.0, 13.0, cw, 16.0, ["wdoc-chart-title"]) ] }
// <<< S3

// >>> S4 callout lower
let v2_callout = fn(c: Callout) -> list<HtmlFundamental> {
  let cls = if c.class == none { [] } else { c.class };
  let kind_icon =
    if list_contains(cls, "warning") { "lucide.triangle-alert" }
    else if list_contains(cls, "error") { "lucide.circle-x" }
    else if list_contains(cls, "success") { "lucide.circle-check" }
    else if list_contains(cls, "tip") { "lucide.lightbulb" }
    else if list_contains(cls, "info") { "lucide.info" }
    else if list_contains(cls, "note") { "lucide.info" }
    else { "" };
  let icon_name = if c.icon == none { kind_icon } else { c.icon };
  let title = para(["callout-title"], [c.heading]);
  let head_children =
    if icon_name == "" { [title] } else { [ icon(icon_name, ["callout-icon"]), title ] };
  // `id` forces the 5-arg escape: `div(cls, kids)` cannot carry it.
  [ elem("div", c.id, flatten([["callout"], cls]), none, [
      div(["callout-heading"], head_children),
      div(["callout-body"], [ pp([], [inl(c.body)]) ]),
    ]) ]
}
// <<< S4

s1 = v2_website_header(fx_ctx)
s2 = v2_toc(fx_toc)
s3 = flatten([
  v2_chart_axes(40.0, 20.0, 300.0, 160.0),
  v2_chart_gridlines(40.0, 20.0, 300.0, 160.0, 0.0, 100.0, 4),
  v2_chart_title(0.0, 0.0, 380.0, "Throughput"),
])
s4 = v2_callout(fx_callout)
