class "footnotes" {
  css = "margin-top: 3rem; padding-top: 1.2rem; font-size: 0.9rem;"
}

class "footnotes-title" {
  css = "font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
         margin-bottom: 0.6rem;"
}

class "footnote-list" {
  css = "margin: 0; padding-left: 1.4rem;"
}

class "footnote-item" {
  css = "margin-bottom: 0.4rem;"
}

class "footnote-back" {
  css = "text-decoration: none; border: none; margin-left: 0.3rem;"
}

class "footnote-ref" {
  css = "font-size: 0.75em; line-height: 0;"
