}

// ── from diagram-core.wcl ────────────────────────────────────────

class "wdoc-diagram-viewport" {
  css = "position: relative; display: inline-block; max-width: 100%;"
  nest "svg" { css = "display: block; max-width: 100%; height: auto; touch-action: none; cursor: grab;" }
  nest "&.panning svg" { css = "cursor: grabbing;" }
}

class "wdoc-diagram-controls" {
  css = "position: absolute; top: 6px; right: 6px; display: flex; flex-direction: column;
         gap: 4px;"
  nest "button" { css = "width: 1.6rem; height: 1.6rem; padding: 0; display: flex; align-items: center;
    justify-content: center; font: inherit; font-size: 1rem; line-height: 1;
    cursor: pointer; color: inherit; background: rgba(127,127,127,0.12);
    border: 1px solid currentColor; border-radius: 4px; opacity: 0.6;" }
  nest "button:hover" { css = "opacity: 1;" }
}

// ── from dopesheet.wcl ───────────────────────────────────────────

class "wdoc-dopesheet" {
  css = "cursor: pointer;"
  nest "image" { css = "image-rendering: pixelated;" }
  nest "&.smooth image" { css = "image-rendering: auto;" }
}

class "dope-btn" {
  fill = "currentColor"
  opacity = "0.7"
  css = "cursor: pointer;"
  nest "&:hover" { css = "opacity: 1;" }
}

// ── from edit_object.wcl ─────────────────────────────────────────

class "wcl-edit-object-btn" {
  css = "display: inline-flex; align-items: center; gap: 0.35rem; margin: 0.4rem 0;
         padding: 0.3rem 0.7rem; border: 1px solid #4c8bf5; border-radius: 6px;
         background: rgba(76,139,245,0.12); color: #4c8bf5; font: 600 13px system-ui, sans-serif;
         cursor: pointer;"
  nest "&:hover" { css = "background: rgba(76,139,245,0.22);" }
}

