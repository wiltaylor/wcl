  css = "display: block; text-align: center; margin: 1em 0; overflow-x: auto; overflow-y: hidden;"
  nest "svg" { css = "max-width: 100%;" }
}

class "wdoc-math-error" {
  css = "font-family: monospace; color: #bf616a;"
}

