  style = "normal"
  display = "swap"
  src = "url('_wdoc/JetBrainsMono-SemiBold.woff2') format('woff2')"
}

media "(max-width: 82rem)" {
  class "book-rail" { css = "display: none;" }
  class "book-content" { css = "margin-right: 0;" }
}

font_face "JetBrainsMono Nerd Font" {
  weight = "normal"
  style = "normal"
  display = "swap"
  src = "url('_wdoc/JetBrainsMonoNerdFontMono-Regular.woff2') format('woff2')"
}

font_face "JetBrainsMono Nerd Font" {
  weight = "bold"
  style = "normal"
  display = "swap"
  src = "url('_wdoc/JetBrainsMonoNerdFontMono-Bold.woff2') format('woff2')"
}

font_face "JetBrainsMono Nerd Font" {
  weight = "normal"
  style = "italic"
  display = "swap"
  src = "url('_wdoc/JetBrainsMonoNerdFontMono-Italic.woff2') format('woff2')"
}

keyframes "wdoc-term-blink" {
  base "50%" { css = "opacity: 0;" }
}

media "(max-width: 48rem)" {
  class "ws-layout" { nest "&.has-aside" { css = "grid-template-columns: 1fr;" } }
}

media "(max-width: 48rem)" {
  class "lp-footgrid" { css = "grid-template-columns: 1fr 1fr;" }
}

media "(prefers-reduced-motion: reduce)" {
  class "lp-hero-bg" { css = "opacity: 0.3;" }
}

media "(max-width: 820px)" {
  class "tr-nav" { css = "position: static; width: auto; height: auto; border-right: 0;
    border-bottom: 1px solid var(--wdoc-border, rgba(127,127,127,.25));" }
  class "tr-main" { css = "margin-left: 0; padding: 1.5rem 1rem 4rem;" }
}
