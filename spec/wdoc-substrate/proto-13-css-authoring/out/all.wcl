}

// ── from map.wcl ─────────────────────────────────────────────────

class "wdoc-map" {
  nest "image" { css = "pointer-events: none; user-select: none; -webkit-user-drag: none;" }
  nest "&.pixelated image" { css = "image-rendering: pixelated;" }
}

class "wdoc-map-pin" {
  css = "cursor: pointer;"
}

class "wdoc-map-card" {
  css = "position: absolute; box-sizing: border-box; max-width: 17rem; z-index: 5;
         padding: 0.55rem 0.7rem; border-radius: 6px; font-size: 0.9rem; line-height: 1.4;
         border: 1px solid #444; background: #262b33; color: #e6e6e6;
         box-shadow: 0 4px 18px rgba(0,0,0,0.35);"
  nest "&[hidden]" { css = "display: none;" }
  nest "> :first-child" { css = "margin-top: 0;" }
  nest "> :last-child" { css = "margin-bottom: 0;" }
}

class "wdoc-map-card-title" {
