}

// ── from icons.wcl ───────────────────────────────────────────────

base "svg.wdoc-icon" {
  css = "display: inline-block; width: 1em; height: 1em; vertical-align: -0.125em;"
}

// ── from image.wcl ───────────────────────────────────────────────

base "img.wdoc-image" {
  css = "max-width: 100%; height: auto;"
}

// ── from list.wcl ────────────────────────────────────────────────

base "ol.wdoc-list-numbered" {
  css = "counter-reset: wdoc-li;"
}

base "ol.wdoc-list-numbered > li" {
  css = "counter-increment: wdoc-li;"
}

base "ol.wdoc-list-numbered > li::marker" {
