// ── from docs/wskills/wdoc/wdoc/training/main.wcl ────────────────

base ":root" {
  css = "--tr-accent: #3b82f6; --tr-ok: #16a34a; --tr-bad: #dc2626;"
}

class "tr-nav" {
  css = "position: fixed; top: 0; left: 0; bottom: 0; width: 17rem; overflow-y: auto;
         padding: 1.5rem 1rem 3rem;
         border-right: 1px solid var(--wdoc-border, rgba(127,127,127,.25)); z-index: 5;"
  nest "ul" { css = "list-style: none; margin: 0; padding: 0;" }
}

class "tr-nav-title" {
  css = "font-weight: 700; font-size: .95rem; margin-bottom: .25rem;"
}

class "tr-progress" {
  opacity = ".75"
  css = "font-size: .78rem; margin-bottom: 1rem;"
}

class "tr-progress-bar" {
  css = "height: 4px; border-radius: 2px; background: rgba(127,127,127,.25); margin-top: .4rem;"
}

class "tr-progress-fill" {
  css = "height: 100%; width: 0; border-radius: 2px; background: var(--tr-accent);
         transition: width .3s ease;"
}

class "tr-nav-module" {
  opacity = ".6"
  css = "font-size: .72rem; text-transform: uppercase; letter-spacing: .06em;
         margin: 1.2rem 0 .4rem;"
}

class "tr-nav-item" {
  nest "a" { css = "display: flex; gap: .5rem; align-items: baseline; padding: .3rem .5rem;
    border-radius: 4px; text-decoration: none; font-size: .88rem; line-height: 1.35;" }
  nest "a:hover" { css = "background: rgba(127,127,127,.12);" }
  nest "a.current" { css = "background: rgba(59,130,246,.14); font-weight: 600;" }
  nest "a.done .tr-nav-mark" { css = "color: var(--tr-ok); opacity: 1;" }
}

class "tr-nav-mark" {
  opacity = ".5"
  css = "flex: none; width: 1rem; font-size: .8rem;"
}

class "tr-main" {
  css = "margin-left: 17rem; padding: 2.5rem 2rem 6rem; max-width: 56rem;"
}

class "tr-topbar" {
  css = "display: flex; justify-content: flex-end; gap: .5rem; margin-bottom: 1rem;"
}

class "tr-pagenav" {
  css = "display: flex; justify-content: space-between; margin-top: 4rem; padding-top: 1.5rem;
         border-top: 1px solid var(--wdoc-border, rgba(127,127,127,.25)); font-size: .9rem;"
}

class "wdoc-quiz" {
  css = "margin: 1.5rem 0; padding: 1.1rem 1.25rem;
         border: 1px solid var(--wdoc-border, rgba(127,127,127,.28)); border-radius: 8px;"
  nest "&.answered .quiz-choice-note" { css = "display: block;" }
  nest "&.answered .quiz-explanation, &.answered .quiz-rubric" { css = "display: block;" }
}

class "quiz-prompt" {
  css = "font-weight: 600; margin-bottom: .85rem;"
}

class "quiz-choices" {
  css = "list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column;
         gap: .5rem;"
}

class "quiz-choice-btn" {
  css = "display: block; width: 100%; text-align: left; padding: .55rem .75rem; cursor: pointer;
         border: 1px solid var(--wdoc-border, rgba(127,127,127,.3)); border-radius: 6px;
         background: transparent; color: inherit; font: inherit;"
  nest "&:hover" { css = "border-color: var(--tr-accent);" }
  nest "&.picked" { css = "border-color: var(--tr-accent); background: rgba(59,130,246,.1);" }
  nest "&.right" { css = "border-color: var(--tr-ok); background: rgba(22,163,74,.12);" }
  nest "&.wrong" { css = "border-color: var(--tr-bad); background: rgba(220,38,38,.1);" }
}

class "quiz-choice-note" {
  opacity = ".8"
  css = "display: none; font-size: .85rem; margin: .35rem 0 0 .75rem;"
}

base ".quiz-explanation, .quiz-rubric" {
  css = "display: none; margin-top: .9rem; padding: .7rem .9rem; border-radius: 6px;
         background: rgba(127,127,127,.1); font-size: .9rem;"
}

class "quiz-rubric-label" {
  opacity = ".7"
  css = "font-weight: 600; font-size: .8rem; text-transform: uppercase; letter-spacing: .05em;
         margin-bottom: .3rem;"
}

class "quiz-answer" {
  css = "width: 100%; box-sizing: border-box; padding: .6rem .7rem; font: inherit;
         font-size: .9rem; border: 1px solid var(--wdoc-border, rgba(127,127,127,.3));
         border-radius: 6px; background: transparent; color: inherit;"
}

base ".quiz-submit, .quiz-check" {
  css = "margin-top: .6rem; padding: .45rem 1rem; cursor: pointer; font: inherit;
         font-size: .88rem; border: 1px solid var(--tr-accent); border-radius: 6px;
         background: var(--tr-accent); color: #fff;"
}

base ".quiz-submit[disabled], .quiz-check[disabled]" {
  css = "opacity: .5; cursor: default;"
}

class "quiz-verdict" {
  css = "display: none; margin-top: .8rem; padding: .7rem .9rem; border-radius: 6px;
         font-size: .9rem; border-left: 3px solid var(--tr-accent);
         background: rgba(127,127,127,.1);"
  nest "&.shown" { css = "display: block;" }
  nest "&.pass" { css = "border-left-color: var(--tr-ok);" }
  nest "&.fail" { css = "border-left-color: var(--tr-bad);" }
}

class "tr-reset" {
  opacity = ".6"
  css = "display: block; margin-top: 2rem; font-size: .78rem; background: none; border: 0;
         cursor: pointer; color: inherit; text-decoration: underline;"
}

// ── from docs/wskills/wskill/wdoc/book/main.wcl ──────────────────

class "related-cols" {
  css = "align-items: start; margin-top: 2.75rem; padding-top: 1.6rem;
         border-top: 1px solid var(--wdoc-border, rgba(127,127,127,0.3));"
  nest "p" { css = "margin: 0.15rem 0;" }
  nest ".heading-2" { css = "margin: 0 0 0.35rem;" }
}

// ── from examples/wdoc_website.wcl ───────────────────────────────

base "body" {
  css = "font-family: Inter, system-ui, sans-serif;"
}

class "nav" {
  css = "display: flex; align-items: center; justify-content: space-between; padding: 1rem 2rem;
         border-bottom: 1px solid var(--wdoc-border); position: sticky; top: 0;
         background: var(--wdoc-bg);"
  nest ".brand" { css = "font-weight: 700; font-size: 1.2rem;" }
}

class "hero" {
  css = "text-align: center; padding: 5rem 2rem;
         background: color-mix(in srgb, var(--wdoc-accent) 12%, var(--wdoc-bg));"
  nest "h1" { css = "font-size: 3rem; margin: 0 0 .5rem;" }
}

class "wrap" {
  css = "display: grid; grid-template-columns: minmax(0,1fr) 15rem; gap: 2.5rem;
         max-width: 64rem; margin: 0 auto; padding: 3rem 2rem;"
}

class "foot" {
  opacity = ".7"
  css = "text-align: center; padding: 2rem; border-top: 1px solid var(--wdoc-border);"
}

// ── from .wad/wdoc/book/main.wcl ─────────────────────────────────

class "wad-external" {
  opacity = "0.92"
  css = "border-style: dashed;"
}

class "wad-meta" {
  nest "p" { css = "margin: 0.15rem 0;" }
}

media "(max-width: 48rem)" {
  class "wdoc-preview-row" { css = "grid-template-columns: 1fr;" }
}

