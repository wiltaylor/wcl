  weight = "400"
  style = "normal"
  display = "swap"
  src = "url('_wdoc/IBMPlexSans-Regular.woff2') format('woff2')"
}

font_face "IBM Plex Sans" {
  weight = "500"
  style = "normal"
  display = "swap"
  src = "url('_wdoc/IBMPlexSans-Medium.woff2') format('woff2')"
}

font_face "IBM Plex Sans" {
  weight = "600"
  style = "normal"
  display = "swap"
  src = "url('_wdoc/IBMPlexSans-SemiBold.woff2') format('woff2')"
}

font_face "IBM Plex Sans" {
  weight = "700"
  style = "normal"
  display = "swap"
  src = "url('_wdoc/IBMPlexSans-Bold.woff2') format('woff2')"
}

font_face "JetBrains Mono" {
  weight = "400"
  style = "normal"
  display = "swap"
  src = "url('_wdoc/JetBrainsMono-Regular.woff2') format('woff2')"
}

font_face "JetBrains Mono" {
  weight = "500"
