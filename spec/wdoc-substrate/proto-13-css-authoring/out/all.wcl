}

class "wdoc-preview" {
  css = "padding: 0.8rem; border-radius: 6px; border: 1px solid #444; background: #262b33;
         color: #e6e6e6; overflow: auto; min-height: 0;"
  nest "> :first-child" { css = "margin-top: 0;" }
  nest "> :last-child" { css = "margin-bottom: 0;" }
}

