  opacity = "0.55"
  css = "position: absolute; top: 2px; right: 4px; padding: 0; line-height: 1; font: inherit;
         font-size: 0.95rem; color: inherit; cursor: pointer; background: none; border: none;"
  nest "&:hover" { css = "opacity: 1;" }
}

