         align-items: center; justify-content: center; padding: 0 0.4rem; font-size: 0.85rem;
         font-weight: 600; color: #e6e6e6;"
}

class "wdoc-node-row" {
  css = "box-sizing: border-box; height: 100%; overflow: hidden; display: flex;
         align-items: center; padding: 0 0.5rem; font-size: 0.8rem; line-height: 1.3;
         color: #e6e6e6;"
  nest "> :first-child" { css = "margin-top: 0;" }
  nest "> :last-child" { css = "margin-bottom: 0;" }
}

// ── from presentation.wcl ────────────────────────────────────────

class "wdoc-body" {
  css = "overflow: hidden;"
}

class "deck" {
  css = "position: fixed; inset: 0;"
  nest "&.show-notes .deck-slide.active .deck-notes" { css = "display: block; position: fixed; left: 50%; bottom: 3rem; transform: translateX(-50%);
    width: 80vw; max-width: 50rem; max-height: 32vh; overflow: auto; padding: 0.75rem 1rem;
    box-sizing: border-box;
    background: var(--wdoc-bg-inset, var(--wdoc-bg-alt, rgba(127,127,127,0.12)));
    border: 1px solid var(--wdoc-border, rgba(127,127,127,0.4)); border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.35); z-index: 7;" }
}

class "deck-section" {
  css = "position: absolute; inset: 0;"
}

class "deck-slide" {
  opacity = "0"
  css = "position: absolute; inset: 0; display: flex; flex-direction: column;
         justify-content: center; box-sizing: border-box; padding: 4vh 6vw; overflow: auto;
         visibility: hidden; transform: scale(0.98);
         transition: opacity 0.35s ease, transform 0.35s ease;"
  nest "&.active" { css = "opacity: 1; visibility: visible; transform: none; z-index: 1;" }
}

class "deck-slide-inner" {
  css = "width: 100%; max-width: 60rem; margin-inline: auto;"
}

class "wdoc-fragment" {
  opacity = "0"
  css = "transition: opacity 0.3s ease;"
  nest "&.revealed" { css = "opacity: 1;" }
}

class "deck-progress" {
  css = "position: fixed; top: 0; left: 0; right: 0; height: 3px;
         background: var(--wdoc-border, rgba(127,127,127,0.3)); z-index: 6;"
}

class "deck-progress-bar" {
  css = "height: 100%; width: 0; background: var(--wdoc-accent, #4c9aff);
         transition: width 0.3s ease;"
}

class "deck-counter" {
  opacity = "0.65"
  css = "position: fixed; bottom: 0.9rem; right: 1.25rem; font-size: 0.85rem; z-index: 6;"
}

class "deck-nav-hint" {
  css = "position: fixed; bottom: 0.8rem; left: 1.25rem; display: grid;
         grid-template-columns: repeat(3, 1.1rem); grid-template-rows: repeat(2, 1.1rem);
         gap: 1px; z-index: 6; line-height: 1.1rem; text-align: center; font-size: 0.9rem;"
  nest "span" { css = "opacity: 0.2;" }
  nest "span.on" { css = "opacity: 0.8;" }
}

class "deck-hint-up" {
  css = "grid-area: 1 / 2;"
}

class "deck-hint-left" {
  css = "grid-area: 2 / 1;"
}

class "deck-hint-down" {
  css = "grid-area: 2 / 2;"
}

class "deck-hint-right" {
  css = "grid-area: 2 / 3;"
}

class "deck-notes" {
  css = "display: none;"
}

// ── from table.wcl ───────────────────────────────────────────────

base "table.wdoc-table" {
  css = "border-collapse: separate; border-spacing: 0; border: 1px solid #ccc;
         border-radius: 8px; overflow: hidden;"
}

class "wdoc-table" {
  nest "th, td" { css = "border-bottom: 1px solid #ccc; padding: 0.45rem 0.7rem; text-align: left;" }
  nest "tr:last-child td" { css = "border-bottom: none;" }
  nest "th" { css = "background: #f4f4f4; font-size: 0.8em; font-weight: 600; letter-spacing: 0.04em;
    text-transform: uppercase;" }
}

class "wdoc-badge" {
  css = "display: inline-block; padding: 0.1em 0.6em; border-radius: 999px; font-size: 0.8em;
         font-weight: 600;"
}

// ── from templates.wcl ───────────────────────────────────────────

base ".site-header, .site-main" {
  css = "max-width: 48rem; margin-left: auto; margin-right: auto; padding-left: 1.25rem;
         padding-right: 1.25rem; box-sizing: border-box;"
}

class "site-header" {
  css = "padding-top: 1rem;"
}

class "site-nav" {
  css = "position: sticky; top: 0; z-index: 10; display: flex; gap: 1rem;
         background: var(--wdoc-bg, #fff); border-bottom: 1px solid var(--wdoc-border, #ccc);
         padding: 0.6rem max(1.25rem, calc((100% - 48rem) / 2 + 1.25rem)); margin-bottom: 1.5rem;
         box-sizing: border-box;"
  nest "a" { css = "text-decoration: none;" }
  nest "ul.menu" { css = "list-style: none; margin: 0; padding: 0; display: flex; gap: 1rem; align-items: center;" }
  nest "ul.menu li" { css = "position: relative;" }
  nest ".menu-toggle, .menu-link, .menu-label" { css = "display: inline-block; padding: 0.1rem 0; font: inherit; color: inherit;
    background: none; border: none; cursor: pointer; text-decoration: none;
    white-space: nowrap;" }
  nest ".menu-label" { css = "cursor: default;" }
  nest ".menu-toggle::after" { css = "content: \" ▾\"; opacity: 0.7;" }
  nest "a.menu-link.current" { css = "font-weight: 600; color: var(--wdoc-accent, inherit);" }
  nest "ul.menu ul.menu" { css = "display: none; position: absolute; top: 100%; left: 0; flex-direction: column;
    align-items: stretch; gap: 0.15rem; min-width: 10rem; padding: 0.4rem;
    background: var(--wdoc-bg, #fff); border: 1px solid var(--wdoc-border, #ccc);
    border-radius: 6px; box-shadow: 0 6px 20px rgba(0,0,0,0.18); z-index: 30;" }
  nest "li.open > ul.menu" { css = "display: flex;" }
  nest "ul.menu ul.menu ul.menu" { css = "top: 0; left: 100%;" }
  nest ".wdoc-search" { css = "display: inline-block; margin: 0 0 0 1rem; min-width: 14rem; vertical-align: middle;" }
}

class "site-home" {
  css = "font-weight: 600; color: inherit;"
}

class "site-main" {
  css = "display: block; background: var(--wdoc-bg-alt, #ffffff);
         background: color-mix(in srgb, var(--wdoc-bg) 90%, var(--wdoc-fg) 10%);
         border: 1px solid var(--wdoc-border, rgba(127,127,127,0.35)); border-radius: 12px;
         padding: 1.75rem 2rem 2.25rem; margin-bottom: 2.5rem;
         box-shadow: 0 1px 2px rgba(0,0,0,0.12), 0 12px 30px rgba(0,0,0,0.18);"
}

base "html" {
  css = "scroll-padding-top: 4rem;"
}

class "wdoc-search" {
  css = "position: relative; margin: 0 0 0.75rem;"
}

class "wdoc-search-input" {
  css = "width: 100%; box-sizing: border-box; padding: 0.3rem 0.5rem; font: inherit;
         color: inherit; background: var(--wdoc-bg, transparent);
         border: 1px solid var(--wdoc-border, rgba(127,127,127,0.4)); border-radius: 4px;"
}

class "wdoc-search-results" {
  css = "display: none; position: absolute; z-index: 10; left: 0; right: 0; max-height: 60vh;
         overflow-y: auto; background: var(--wdoc-bg-alt, #fff);
         border: 1px solid var(--wdoc-border, rgba(127,127,127,0.4)); border-radius: 4px;
         box-shadow: 0 4px 16px rgba(0,0,0,0.25);"
  nest "&.open" { css = "display: block;" }
}

class "wdoc-search-hit" {
  css = "display: block; padding: 0.45rem 0.6rem; text-decoration: none; color: inherit;
         border-bottom: 1px solid var(--wdoc-border, rgba(127,127,127,0.2));"
  nest "&:last-child" { css = "border-bottom: none;" }
  nest "&:hover" { css = "background: rgba(127,127,127,0.12);" }
}

class "wdoc-search-hit-title" {
  css = "display: block; font-weight: 600;"
}

class "wdoc-search-hit-snippet" {
  opacity = "0.75"
  css = "display: block; font-size: 0.85em; margin-top: 0.15rem;"
}

class "wdoc-search-empty" {
  opacity = "0.7"
  css = "padding: 0.45rem 0.6rem;"
}

class "book-sidebar" {
  css = "position: fixed; top: 0; left: 0; width: 16rem; height: 100vh; overflow-y: auto;
         box-sizing: border-box; padding: 1rem; border-right: 1px solid var(--wdoc-border);
         background: var(--wdoc-bg-alt); display: flex; flex-direction: column;
         font-family: var(--wdoc-font-head); scrollbar-width: thin;
         scrollbar-color: var(--wdoc-border-strong) transparent;"
  nest "&::-webkit-scrollbar" { css = "width: 9px;" }
  nest "&::-webkit-scrollbar-thumb" { css = "background: var(--wdoc-border-strong); border-radius: 999px;
    border: 2px solid var(--wdoc-bg-alt);" }
  nest "ul.book-toc" { css = "list-style: none; margin: 0; padding-left: 0;" }
  nest "ul.book-toc ul.book-toc" { css = "padding-left: 0.85rem;" }
  nest "a.book-chapter" { css = "display: block; padding: 0.25rem 0 0.25rem 0.6rem; border-left: 2px solid transparent;
    color: var(--wdoc-fg-muted); text-decoration: none;" }
  nest "a.book-chapter:hover" { css = "color: var(--wdoc-fg);" }
  nest "a.book-chapter.current" { css = "color: var(--wdoc-accent); border-left-color: var(--wdoc-accent); font-weight: 600;" }
  nest ".book-section" { css = "display: block; padding: 0.5rem 0 0.15rem; font-weight: 600; font-size: 0.72rem;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--wdoc-fg-subtle);" }
  nest ".book-toc-row" { css = "display: flex; align-items: baseline;" }
  nest ".book-toc-row > a.book-chapter, .book-toc-row > .book-section" { css = "flex: 1 1 auto;" }
  nest ".book-toc-toggle" { css = "flex: 0 0 1rem; cursor: pointer; user-select: none; text-align: center; opacity: 0.55;" }
  nest ".book-toc-toggle:hover" { css = "opacity: 1;" }
  nest "li.book-branch > .book-toc-row" { css = "cursor: pointer; user-select: none;" }
  nest "li.book-branch > .book-toc-row:hover > .book-toc-toggle" { css = "opacity: 1;" }
  nest "li.book-branch > .book-toc-row > .book-toc-toggle::before" { css = "content: \"▸\"; display: inline-block; transition: transform 0.12s ease;" }
  nest "li.book-branch.open > .book-toc-row > .book-toc-toggle::before" { css = "transform: rotate(90deg);" }
  nest "li.book-branch > ul.book-toc" { css = "display: none;" }
  nest "li.book-branch.open > ul.book-toc" { css = "display: block;" }
}

class "book-title" {
  css = "font-weight: 600; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase;
         color: var(--wdoc-fg-muted); margin-bottom: 0.9rem;"
}

class "book-home" {
  opacity = "0.8"
  css = "display: block; margin-bottom: 0.6rem; text-decoration: none; color: inherit;"
  nest "&:hover" { css = "opacity: 1; text-decoration: underline;" }
}

class "book-content" {
  css = "margin-left: 16rem; margin-right: 15rem; min-height: 100vh; box-sizing: border-box;"
  nest ".book-measure" { css = "max-width: 60rem; margin: 0 auto; padding: 2.5rem 3.5rem 6rem;
    background: var(--wdoc-book-bg); min-height: 100vh; box-sizing: border-box;
    font-family: var(--wdoc-font-body);" }
}

class "theme-toggle" {
  css = "display: block; margin: 0 0 0.75rem; padding: 0.25rem 0.7rem; cursor: pointer;
         background: var(--wdoc-bg-alt); border: 1px solid var(--wdoc-border-strong);
         border-radius: 999px; color: inherit; font: inherit; font-family: var(--wdoc-font-head);
         font-size: 0.8rem;"
}

class "book-pagenav" {
  css = "display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 3.5rem;"
  nest ".book-nav" { css = "display: block; padding: 0.9rem 1.1rem; border: 1px solid var(--wdoc-border);
    border-radius: 8px; background: var(--wdoc-book-bg); text-decoration: none;
    color: var(--wdoc-heading); font-family: var(--wdoc-font-head); font-weight: 600;" }
  nest ".book-nav:hover" { css = "border-color: var(--wdoc-accent);" }
  nest ".book-nav-next" { css = "grid-column: 2; text-align: right;" }
}

class "book-sidebar-footer" {
  css = "position: sticky; bottom: 0; margin: auto -1rem -1rem; padding: 0.6rem 1rem;
         background: var(--wdoc-bg-alt); border-top: 1px solid var(--wdoc-border); display: flex;
         flex-direction: column; gap: 0.4rem;"
}

class "book-footer-btn" {
  opacity = "0.85"
  css = "display: flex; align-items: center; justify-content: center; padding: 0.45rem 0.6rem;
         text-decoration: none; color: inherit; border: 1px solid var(--wdoc-border);
         border-radius: 6px;"
  nest "&:hover" { css = "opacity: 1; border-color: var(--wdoc-accent);" }
  nest "&.current" { css = "color: var(--wdoc-accent); border-color: var(--wdoc-accent); opacity: 1;" }
  nest ".wdoc-icon" { css = "width: 1.4em; height: 1.4em; flex: 0 0 auto;" }
}

class "book-rail" {
  css = "position: fixed; top: 0; right: 0; width: 15rem; height: 100vh; overflow-y: auto;
         box-sizing: border-box; padding: 2.5rem 1.4rem; font-family: var(--wdoc-font-head);
         scrollbar-width: thin; scrollbar-color: var(--wdoc-border-strong) transparent;"
}

class "book-rail-title" {
  css = "font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
         margin-bottom: 0.9rem;"
}

class "book-onpage" {
  css = "display: flex; flex-direction: column;"
}

class "book-onpage-link" {
  css = "display: block; padding: 0.2rem 0 0.2rem 0.7rem; font-size: 0.82rem; line-height: 1.35;
         text-decoration: none;"
  nest "&.level-3" { css = "padding-left: 1.5rem; font-size: 0.78rem;" }
}

class "heading-marker" {
  css = "display: block; font-size: 0.78rem; margin-bottom: 0.2rem;"
}

// ── from terminal.wcl ────────────────────────────────────────────

class "wdoc-terminal" {
  css = "display: inline-block; max-width: 100%; border-radius: 6px; overflow: hidden;"
  nest "" { css = "background: #1c1c1c; color: #d0d0d0;" }
}

class "wdoc-terminal-svg" {
  css = "display: block; max-width: 100%; height: auto;"
  nest "text" { css = "font-family: 'JetBrainsMono Nerd Font', ui-monospace, 'Cascadia Code', 'Fira Code', Menlo, Consolas, monospace;" }
}

class "term-chrome-bar" {
  fill = "currentColor"
  opacity = "0.08"
}

class "term-title" {
  fill = "currentColor"
  opacity = "0.6"
  css = "font-family: ui-sans-serif, system-ui, sans-serif; font-size: 0.75em;"
}

class "term-close" {
  stroke = "currentColor"
  opacity = "0.55"
  stroke_width = "1.5"
  css = "stroke-linecap: round;"
  nest "&:hover" { css = "opacity: 1;" }
}

class "term-chrome-btn" {
  fill = "currentColor"
  opacity = "0.55"
  css = "font-size: 0.8em; cursor: pointer;"
  nest "&:hover" { css = "opacity: 1;" }
}

class "term-cursor" {
  fill = "currentColor"
  opacity = "0.65"
}

class "term-blink" {
  css = "animation: wdoc-term-blink 1s steps(1) infinite;"
}

class "wdoc-terminal-error" {
  css = "color: #bf616a; font-family: monospace;"
}

class "wdoc-terminal-player" {
  css = "position: relative;"
}

class "term-overlay-play" {
  css = "position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 4rem;
         height: 4rem; display: flex; align-items: center; justify-content: center; padding: 0;
         border: none; border-radius: 50%; cursor: pointer; background: rgba(20,20,20,0.55);
         color: #fff; font-size: 1.9rem; line-height: 1;"
  nest "&:hover" { css = "background: rgba(20,20,20,0.75);" }
  nest "&[hidden]" { css = "display: none;" }
}

// ── from tilemap.wcl ─────────────────────────────────────────────

class "wdoc-tilemap" {
  nest "image" { css = "image-rendering: pixelated;" }
  nest "&.smooth image" { css = "image-rendering: auto;" }
}

// ── from tree.wcl ────────────────────────────────────────────────

class "wdoc-tree-guide" {
  stroke = "#5a606b"
  stroke_width = "1"
  fill = "none"
}

class "wdoc-tree-label" {
  fill = "#e6e6e6"
  css = "font-size: 0.82rem;
         font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;"
}

// ── from video.wcl ───────────────────────────────────────────────

class "wdoc-video" {
  css = "position: relative; display: block; cursor: pointer; max-width: 100%; margin: 0;
         overflow: hidden; background: #000; border-radius: 4px; line-height: 0;"
  nest "img" { css = "display: block; width: 100%; height: auto;" }
  nest ".wdoc-video-placeholder" { css = "display: block; width: 100%; min-height: 220px;
    background: linear-gradient(135deg, #2a2a32, #14141a);" }
  nest ".wdoc-video-play" { css = "position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 72px;
    height: 72px; border-radius: 50%; background: rgba(0, 0, 0, 0.6);
    border: 2px solid #fff; transition: background 0.15s ease;" }
  nest "&:hover .wdoc-video-play" { css = "background: rgba(0, 0, 0, 0.8);" }
  nest ".wdoc-video-play::after" { css = "content: \"\"; position: absolute; top: 50%; left: 54%;
    transform: translate(-50%, -50%); border-style: solid; border-width: 14px 0 14px 24px;
    border-color: transparent transparent transparent #fff;" }
  nest "iframe, video" { css = "display: block; width: 100%; height: 100%; aspect-ratio: 16 / 9; border: 0;" }
}

// ── from website.wcl ─────────────────────────────────────────────

base "html" {
  css = "scroll-padding-top: 4.5rem;"
}

class "ws-header" {
  css = "position: sticky; top: 0; z-index: 10; display: flex; align-items: center;
         justify-content: space-between; gap: 1.5rem; padding: 0.9rem clamp(1rem, 5vw, 3rem);
         background: var(--wdoc-bg, #fff);
         border-bottom: 1px solid var(--wdoc-border, rgba(127,127,127,0.3));"
  nest ".ws-brand" { css = "font-weight: 700; font-size: 1.15rem; color: inherit; text-decoration: none;" }
  nest "ul.menu" { css = "list-style: none; margin: 0; padding: 0; display: flex; gap: 1.25rem;
    align-items: center;" }
  nest "ul.menu a" { css = "color: inherit; text-decoration: none; opacity: 0.85;" }
  nest "ul.menu a:hover, ul.menu a.current" { css = "opacity: 1; color: var(--wdoc-accent, inherit);" }
  nest ".ws-controls" { css = "display: flex; align-items: center; gap: 0.6rem;" }
  nest ".ws-controls .wdoc-search" { css = "margin: 0; min-width: 12rem;" }
  nest ".ws-controls .theme-toggle" { css = "margin: 0; padding: 0.25rem 0.7rem; cursor: pointer; background: transparent;
    border: 1px solid var(--wdoc-border, rgba(127,127,127,0.4)); border-radius: 999px;
    color: inherit; font: inherit; font-size: 0.8rem; white-space: nowrap;" }
  nest ".ws-controls .theme-toggle:hover" { css = "border-color: var(--wdoc-border-strong, rgba(127,127,127,0.7));" }
}

class "ws-banner" {
  css = "border-bottom: 1px solid var(--wdoc-border, rgba(127,127,127,0.3));
         padding: 0 clamp(1rem, 5vw, 3rem);"
}

class "ws-hero" {
  css = "padding: clamp(3rem, 10vw, 6rem) clamp(1rem, 5vw, 3rem); text-align: center;
         background: color-mix(in srgb, var(--wdoc-accent, #4060ff) 12%, var(--wdoc-bg));
         border-bottom: 1px solid var(--wdoc-border, rgba(127,127,127,0.3));"
  nest "h1" { css = "font-size: clamp(2rem, 6vw, 3.5rem); margin: 0 0 0.75rem;" }
}

class "ws-layout" {
  css = "display: grid; grid-template-columns: 1fr; gap: 2.5rem; max-width: 70rem;
         margin: 0 auto; padding: clamp(2rem, 5vw, 3.5rem) clamp(1rem, 5vw, 3rem);
         box-sizing: border-box;"
  nest "&.has-aside" { css = "grid-template-columns: minmax(0, 1fr) 16rem;" }
}

class "ws-aside" {
  css = "font-size: 0.95rem;"
}

class "ws-footer" {
  opacity = "0.7"
  css = "padding: 2rem clamp(1rem, 5vw, 3rem); text-align: center;
         border-top: 1px solid var(--wdoc-border, rgba(127,127,127,0.3));"
}

// ── from theme.rs ────────────────────────────────────────────────

base ":root" {
  css = "--wdoc-accent:{ACCENT_EXPR};"
}

base "body,.wdoc-body" {
  css = "background:var(--wdoc-bg); color:var(--wdoc-fg); font-family:var(--wdoc-font-body);
         font-size:17px; line-height:1.7;"
}

base "::selection" {
  css = "background:color-mix(in srgb, var(--wdoc-selection) 28%, transparent);"
}

base "a,.link" {
  css = "color:var(--wdoc-link); text-decoration:none;
         border-bottom:1px solid color-mix(in srgb, var(--wdoc-link) 35%, transparent);"
}

base "a:hover,.link:hover" {
  css = "border-bottom-color:var(--wdoc-link);"
}

base ".heading-1,.heading-2,.heading-3,.heading-4,.heading-5,.heading-6" {
  css = "color:var(--wdoc-heading); font-family:var(--wdoc-font-head);"
}

base "strong,.bold" {
  css = "color:var(--wdoc-heading);"
}

base ".code,code,kbd" {
  css = "font-family:var(--wdoc-font-mono); background:var(--wdoc-bg-alt);
         border:1px solid var(--wdoc-border); border-radius:4px; padding:0.05em 0.35em;"
}

base "kbd" {
  css = "border-color:var(--wdoc-border-strong); border-bottom-width:2px;
         color:var(--wdoc-fg-muted);"
}

base "blockquote" {
  css = "border-left:3px solid var(--wdoc-accent); color:var(--wdoc-fg-muted);"
}

base "hr" {
  css = "border:none; border-top:1px solid var(--wdoc-border);"
}

base "figcaption" {
  css = "color:var(--wdoc-fg-muted);"
}

class "code-card" {
  css = "background:var(--wdoc-bg-alt); border:1px solid var(--wdoc-border);"
  nest ".code-line::before" { css = "color:var(--wdoc-fg-subtle);" }
}

class "code-filename" {
  css = "color:var(--wdoc-fg-muted); border-bottom:1px solid var(--wdoc-border);
         font-family:var(--wdoc-font-mono);"
}

class "code-lang" {
  css = "color:var(--wdoc-fg-subtle);"
}

class "code-dots" {
  nest "span" { css = "background:color-mix(in srgb, var(--wdoc-fg) 22%, transparent);" }
}

class "heading-marker" {
  css = "color:var(--wdoc-accent); font-family:var(--wdoc-font-mono);"
}

class "book-kicker" {
  css = "color:var(--wdoc-accent); font-family:var(--wdoc-font-mono);"
}

class "book-meta" {
  css = "color:var(--wdoc-fg-muted); border-top:1px solid var(--wdoc-border);"
}

base ".book-rail-title,.book-onpage-title" {
  css = "color:var(--wdoc-fg-subtle);"
}

class "book-onpage-link" {
  css = "color:var(--wdoc-fg-muted); border-left:2px solid transparent;"
  nest "&:hover" { css = "color:var(--wdoc-fg);" }
  nest "&.active" { css = "color:var(--wdoc-accent); border-left-color:var(--wdoc-accent);" }
}

class "footnotes" {
  css = "border-top:1px solid var(--wdoc-border); color:var(--wdoc-fg-muted);"
}

class "footnote-ref" {
  css = "color:var(--wdoc-accent);"
}

class "wdoc-badge" {
  css = "font-family:var(--wdoc-font-head);
         background:color-mix(in srgb, var(--wdoc-accent) 16%, var(--wdoc-book-bg));
         color:var(--wdoc-accent);
         border:1px solid color-mix(in srgb, var(--wdoc-accent) 32%, transparent);"
}

base "pre.code-block" {
  css = "background:var(--wdoc-bg-alt); color:var(--wdoc-fg); border-color:var(--wdoc-border);
         font-family:var(--wdoc-font-mono);"
}

class "tok-comment" {
  css = "color:var(--wdoc-syn-comment);"
}

class "tok-keyword" {
  css = "color:var(--wdoc-syn-kw);"
}

class "tok-storage" {
  css = "color:var(--wdoc-syn-kw);"
  nest "&.tok-type" { css = "color:var(--wdoc-syn-type);" }
}

class "tok-string" {
  css = "color:var(--wdoc-syn-str);"
}

class "tok-constant" {
  css = "color:var(--wdoc-syn-num);"
  nest "&.tok-numeric" { css = "color:var(--wdoc-syn-num);" }
}

class "tok-entity" {
  nest "&.tok-name.tok-function" { css = "color:var(--wdoc-syn-fn);" }
  nest "&.tok-name.tok-tag" { css = "color:var(--wdoc-red);" }
  nest "&.tok-name.tok-class" { css = "color:var(--wdoc-syn-type);" }
}

class "tok-variable" {
  css = "color:var(--wdoc-fg);"
}

class "tok-support" {
  css = "color:var(--wdoc-syn-type);"
}

class "tok-punctuation" {
  css = "color:var(--wdoc-syn-punct);"
}

class "tok-meta" {
  nest "&.tok-tag" { css = "color:var(--wdoc-red);" }
}

class "tok-invalid" {
  css = "color:var(--wdoc-bg); background:var(--wdoc-red);"
}

class "wdoc-series-1" {
  fill = "var(--wdoc-blue)"
  stroke = "var(--wdoc-blue)"
}

class "wdoc-series-2" {
  fill = "var(--wdoc-green)"
  stroke = "var(--wdoc-green)"
}

class "wdoc-series-3" {
  fill = "var(--wdoc-yellow)"
  stroke = "var(--wdoc-yellow)"
}

class "wdoc-series-4" {
  fill = "var(--wdoc-red)"
  stroke = "var(--wdoc-red)"
}

class "wdoc-series-5" {
  fill = "var(--wdoc-purple)"
  stroke = "var(--wdoc-purple)"
}

class "wdoc-series-6" {
  fill = "var(--wdoc-cyan)"
  stroke = "var(--wdoc-cyan)"
}

class "wdoc-series-7" {
  fill = "var(--wdoc-orange)"
  stroke = "var(--wdoc-orange)"
}

class "wdoc-series-8" {
  fill = "var(--wdoc-pink)"
  stroke = "var(--wdoc-pink)"
}

class "wdoc-annotation" {
  fill = "var(--wdoc-accent)"
}

class "wdoc-point-label" {
  fill = "var(--wdoc-fg-muted)"
}

class "wdoc-process" {
  fill = "var(--wdoc-bg-alt)"
  stroke = "var(--wdoc-blue)"
}

class "wdoc-decision" {
  fill = "var(--wdoc-bg-alt)"
  stroke = "var(--wdoc-orange)"
}

class "wdoc-terminator" {
  fill = "var(--wdoc-bg-alt)"
  stroke = "var(--wdoc-green)"
}

class "wdoc-node" {
  fill = "var(--wdoc-bg-alt)"
  stroke = "var(--wdoc-border)"
}

class "wdoc-shape-text" {
  fill = "var(--wdoc-fg)"
}

class "wdoc-boundary" {
  fill = "none"
  stroke = "var(--wdoc-fg-muted)"
  css = "stroke-dasharray:6 4;"
}

class "wdoc-boundary-label" {
  fill = "var(--wdoc-fg-muted)"
  css = "font-weight:600;"
}

class "wdoc-edge-label" {
  fill = "var(--wdoc-fg-muted)"
}

class "wdoc-participant" {
  fill = "var(--wdoc-bg-alt)"
  stroke = "var(--wdoc-blue)"
}

class "wdoc-participant-line" {
  stroke = "var(--wdoc-blue)"
}

class "wdoc-lifeline" {
  stroke = "var(--wdoc-fg-muted)"
}

class "wdoc-seq-message" {
  stroke = "var(--wdoc-fg)"
}

class "wdoc-seq-arrow" {
  fill = "var(--wdoc-fg)"
}

class "wdoc-seq-text" {
  fill = "var(--wdoc-fg)"
}

class "wdoc-note" {
  fill = "var(--wdoc-bg-alt)"
  stroke = "var(--wdoc-yellow)"
}

class "wdoc-note-text" {
  fill = "var(--wdoc-fg)"
}

class "wdoc-state" {
  fill = "var(--wdoc-bg-alt)"
  stroke = "var(--wdoc-blue)"
}

class "wdoc-state-initial" {
  fill = "var(--wdoc-fg)"
}

class "callout" {
  css = "background:color-mix(in srgb, var(--callout-accent) 9%, var(--wdoc-book-bg));"
  nest "&.note" { css = "--callout-accent:var(--wdoc-blue);" }
  nest "&.info" { css = "--callout-accent:var(--wdoc-cyan);" }
  nest "&.tip" { css = "--callout-accent:var(--wdoc-green);" }
  nest "&.warning" { css = "--callout-accent:var(--wdoc-yellow);" }
  nest "&.error" { css = "--callout-accent:var(--wdoc-red);" }
  nest "&.success" { css = "--callout-accent:var(--wdoc-green);" }
}

base ".wdoc-terminal-error,.wdoc-math-error" {
  css = "color:var(--wdoc-red);"
}

class "wdoc-table" {
  nest "th" { css = "background:var(--wdoc-bg-alt); color:var(--wdoc-fg-muted);
    font-family:var(--wdoc-font-head);" }
  nest "th, td" { css = "border-color:var(--wdoc-border);" }
  nest "tbody tr:nth-child(even)" { css = "background:color-mix(in srgb, var(--wdoc-fg) 4%, transparent);" }
}

class "wdoc-map-card" {
  css = "background:var(--wdoc-bg-alt); color:var(--wdoc-fg); border-color:var(--wdoc-border);"
}

class "wdoc-card" {
  css = "background:var(--wdoc-bg-alt); color:var(--wdoc-fg); border-color:var(--wdoc-border);"
}

class "wdoc-preview" {
  css = "background:var(--wdoc-bg); color:var(--wdoc-fg); border-color:var(--wdoc-border);"
}

class "wdoc-node-table-frame" {
  fill = "var(--wdoc-bg-alt)"
  stroke = "var(--wdoc-border)"
}

class "wdoc-node-table-sep" {
  stroke = "var(--wdoc-border)"
}

class "wdoc-node-table-port" {
  fill = "var(--wdoc-blue)"
  stroke = "var(--wdoc-border)"
}

base ".wdoc-node-table-title,.wdoc-node-row" {
  css = "color:var(--wdoc-fg);"
}

class "wdoc-tree-label" {
  fill = "var(--wdoc-fg)"
}

class "wdoc-tree-guide" {
  stroke = "var(--wdoc-border-strong)"
}

// ── from code-theme.css ──────────────────────────────────────────

base "pre.code-block" {
  css = "background: #f6f8fa; color: #24292f; border: 1px solid #d0d7de; border-radius: 6px;
         padding: 0.75rem 1rem; margin: 0.75rem 0; overflow-x: auto;
         font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
         font-size: 0.9rem; line-height: 1.45;"
}

base "pre.code-block code" {
  css = "background: none; padding: 0; font: inherit; color: inherit; white-space: pre;"
}

class "tok-comment" {
  css = "color: #6a737d; font-style: italic;"
}

class "tok-keyword" {
  css = "color: #cf222e;"
}

class "tok-storage" {
  css = "color: #cf222e;"
  nest "&.tok-type" { css = "color: #953800;" }
}

class "tok-string" {
  css = "color: #0a3069;"
}

class "tok-constant" {
  css = "color: #0550ae;"
  nest "&.tok-numeric" { css = "color: #0550ae;" }
}

class "tok-entity" {
  nest "&.tok-name.tok-function" { css = "color: #8250df;" }
  nest "&.tok-name.tok-tag" { css = "color: #116329;" }
  nest "&.tok-name.tok-class" { css = "color: #953800;" }
}

class "tok-variable" {
  css = "color: #24292f;"
}

class "tok-support" {
  css = "color: #0550ae;"
}

class "tok-punctuation" {
  css = "color: #57606a;"
}

class "tok-meta" {
  nest "&.tok-tag" { css = "color: #116329;" }
}

class "tok-invalid" {
  css = "color: #ffffff; background: #cf222e;"
}

// ── from docs/pages/wcl/landing-parts.wcl ────────────────────────

class "ws-banner" {
  nest ".callout" { css = "display: flex; align-items: center; justify-content: center; gap: 0.75rem;
    max-width: 70rem; margin: 0 auto; padding: 0.45rem 1rem; border: 0; border-radius: 0;
    background: none; font-size: 0.85rem;" }
  nest ".callout-title, .callout-body p" { css = "margin: 0;" }
}

class "lp-hero" {
  css = "position: relative; text-align: center; padding: 4.5rem 0 3rem;"
  nest "> :not(.lp-hero-bg)" { css = "position: relative;" }
  nest "h1" { css = "margin: 1.4rem auto 0; max-width: 16ch; font-size: clamp(2.4rem, 6vw, 4rem);
    line-height: 1.05; letter-spacing: -0.03em; text-wrap: balance;" }
  nest ".lp-lede" { css = "margin: 1.3rem auto 0;" }
}

class "lp-hero-bg" {
  opacity = "0.55"
  css = "position: absolute; inset: 0; pointer-events: none;
         background-image: linear-gradient(var(--wdoc-border, rgba(127,127,127,0.25)) 1px, transparent 1px), linear-gradient(90deg, var(--wdoc-border, rgba(127,127,127,0.25)) 1px, transparent 1px);
         background-size: 44px 44px;
         -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 0%, transparent 72%);
         mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 0%, transparent 72%);"
}

class "lp-badge" {
  css = "display: inline-flex; align-items: center; gap: 0.5rem; margin: 0;
         padding: 0.3rem 0.8rem; border: 1px solid var(--wdoc-border, rgba(127,127,127,0.35));
         border-radius: 999px; background: var(--wdoc-bg-alt, transparent); font-size: 0.7rem;
         font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
         color: var(--wdoc-fg-muted, inherit);"
  nest "&::before" { css = "content: \"\"; width: 6px; height: 6px; border-radius: 999px;
    background: var(--wdoc-accent, #4060ff);" }
}

class "lp-lede" {
  css = "max-width: 60ch; font-size: 1.05rem; line-height: 1.6;
         color: var(--wdoc-fg-muted, inherit);"
}

class "lp-ctas" {
  css = "display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; margin-top: 2rem;"
  nest "p" { css = "margin: 0;" }
}

class "lp-cta" {
  nest "a" { css = "display: inline-flex; align-items: center; gap: 0.5rem; height: 2.6rem;
    padding: 0 1.25rem; border-radius: 6px; font-weight: 600; font-size: 0.9rem;
    text-decoration: none;" }
}

class "lp-cta-primary" {
  nest "a" { css = "background: var(--wdoc-accent, #4060ff); color: var(--wdoc-on-accent, #fff);
    border: 1px solid transparent;" }
  nest "a::after" { css = "content: \"→\";" }
  nest "a:hover" { css = "background: color-mix(in srgb, var(--wdoc-accent, #4060ff) 85%, var(--wdoc-fg, #000) 15%);" }
}

class "lp-cta-ghost" {
  nest "a" { css = "background: transparent; color: inherit;
    border: 1px solid var(--wdoc-border, rgba(127,127,127,0.35)); font-weight: 500;" }
  nest "a:hover" { css = "border-color: var(--wdoc-border-strong, rgba(127,127,127,0.7));
    background: var(--wdoc-bg-alt, transparent);" }
}

class "lp-hero-footnote" {
  css = "margin-top: 1.4rem; font-size: 0.8rem; color: var(--wdoc-fg-subtle, inherit);"
}

class "lp-section" {
  css = "padding: 2.75rem 0 1rem;"
}

class "lp-section-head" {
  css = "display: block; text-align: center; max-width: 60ch; margin: 0 auto 2.25rem;"
  nest ".lp-lede" { css = "margin: 0.85rem auto 0; font-size: 1rem;" }
}

base ".lp-section-head h2, .lp-showcase-text h2" {
  css = "margin: 0.7rem 0 0; font-size: 1.9rem; letter-spacing: -0.02em; line-height: 1.12;"
}

class "lp-eyebrow" {
  css = "margin: 0; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.08em;
         text-transform: uppercase; color: var(--wdoc-fg-subtle, inherit);"
}

class "lp-grid" {
  css = "display: grid; grid-template-columns: repeat(auto-fit, minmax(17.5rem, 1fr)); gap: 1rem;"
}

base ".lp-card, .lp-refcard" {
  css = "display: flex; flex-direction: column; margin: 0;
         border: 1px solid var(--wdoc-border, rgba(127,127,127,0.35)); border-radius: 8px;
         background: var(--wdoc-bg-alt, transparent); padding: 1.4rem;"
}

base ".lp-card:hover, .lp-refcard:hover" {
  css = "border-color: var(--wdoc-border-strong, rgba(127,127,127,0.7));"
}

class "lp-card-icon" {
  css = "display: inline-flex; align-items: center; justify-content: center; width: 2.25rem;
         height: 2.25rem; margin: 0 0 0.85rem; border-radius: 8px;
         background: color-mix(in srgb, var(--wdoc-accent, #4060ff) 14%, transparent);
         color: var(--wdoc-accent, #4060ff);"
  nest "svg.wdoc-icon" { css = "width: 1.2rem; height: 1.2rem;" }
}

class "lp-card" {
  nest "h3" { css = "margin: 0 0 0.4rem; font-size: 1rem;" }
}

base ".lp-card p:last-child, .lp-refcard p" {
  css = "margin: 0; font-size: 0.88rem; line-height: 1.6; color: var(--wdoc-fg-muted, inherit);"
}

class "lp-refcard-head" {
  css = "display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.85rem;"
  nest ".lp-card-icon" { css = "margin: 0;" }
}

class "lp-refcard-name" {
  css = "margin: 0; font-family: var(--wdoc-font-mono, ui-monospace, monospace);
         font-weight: 600; font-size: 1.05rem; color: var(--wdoc-heading, inherit);"
}

class "lp-refcard-body" {
  css = "flex: 1; margin-bottom: 1rem;"
}

class "lp-refcard-cta" {
  css = "font-size: 0.85rem; font-weight: 500;"
}

class "lp-showcase" {
  css = "display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.75rem; align-items: start;"
}

class "lp-codepanel" {
  css = "margin: 0; border: 1px solid var(--wdoc-border, rgba(127,127,127,0.35));
         border-radius: 8px; background: var(--wdoc-bg-alt, transparent); overflow: hidden;"
}

class "lp-codehead" {
  css = "display: flex; align-items: center; gap: 0.6rem; padding: 0.5rem 0.9rem;
         border-bottom: 1px solid var(--wdoc-border, rgba(127,127,127,0.25));
         background: var(--wdoc-bg-inset, rgba(127,127,127,0.08));
         font-family: var(--wdoc-font-mono, ui-monospace, monospace); font-size: 0.8rem;
         color: var(--wdoc-fg-muted, inherit);"
  nest "svg.wdoc-icon" { css = "width: 0.95rem; height: 0.95rem;" }
}

class "lp-codetag" {
  css = "margin-left: auto; padding: 0.1rem 0.5rem;
         border: 1px solid var(--wdoc-border, rgba(127,127,127,0.35)); border-radius: 4px;
         font-size: 0.65rem; letter-spacing: 0.08em; text-transform: uppercase;"
}

class "lp-code" {
  css = "margin: 0; padding: 1.1rem 1.25rem; overflow-x: auto; line-height: 1.65;
         font-size: 0.85rem;"
  nest "code" { css = "background: none; border: 0; padding: 0;" }
}

class "lp-showcase-text" {
  css = "display: block;"
  nest "p:last-child" { css = "margin-bottom: 0; max-width: 62ch; color: var(--wdoc-fg-muted, inherit);
    line-height: 1.65;" }
}

class "lp-steps-panel" {
  css = "border: 1px solid var(--wdoc-border, rgba(127,127,127,0.35)); border-radius: 8px;
         background: var(--wdoc-bg-alt, transparent); padding: 1.9rem;"
  nest ".lp-section-head" { css = "text-align: left; margin: 0 0 1.5rem; max-width: 60ch;" }
}

base "ol.lp-steps" {
  css = "list-style: none; counter-reset: lp-step; margin: 0; padding: 0; display: flex;
         flex-direction: column; gap: 1rem;"
}

base "ol.lp-steps > li" {
  css = "position: relative; padding-left: 2.5rem;"
}

base "ol.lp-steps > li::before" {
  css = "counter-increment: lp-step; content: counter(lp-step); position: absolute; left: 0;
         top: 0; width: 1.5rem; height: 1.5rem; display: inline-flex; align-items: center;
         justify-content: center; border: 1px solid var(--wdoc-border, rgba(127,127,127,0.35));
         border-radius: 999px; font-size: 0.75rem; font-weight: 600;
         font-family: var(--wdoc-font-mono, ui-monospace, monospace);
         color: var(--wdoc-fg-muted, inherit);"
}

class "lp-step-title" {
  css = "margin: 0 0 0.5rem; font-weight: 500;"
}

class "lp-cmd" {
  css = "margin: 0; padding: 0.65rem 0.9rem;
         border: 1px solid var(--wdoc-border, rgba(127,127,127,0.25)); border-radius: 6px;
         background: var(--wdoc-bg-inset, rgba(127,127,127,0.06)); font-size: 0.85rem;
         overflow-x: auto; white-space: nowrap;"
  nest "&::before" { css = "content: \"$ \"; color: var(--wdoc-fg-subtle, inherit);
    font-family: var(--wdoc-font-mono, ui-monospace, monospace);" }
  nest "code" { css = "background: none; border: 0; padding: 0;" }
}

base "footer.ws-footer" {
  css = "opacity: 1; text-align: left; padding: 0;"
}

class "lp-footgrid" {
  css = "max-width: 70rem; margin: 0 auto; padding: 2.75rem clamp(1rem, 5vw, 3rem);
         display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 2rem;"
}

class "lp-footbrand" {
  nest "p" { css = "margin: 0 0 0.75rem;" }
}

class "lp-footlogo" {
  css = "display: flex; align-items: center; gap: 0.6rem;
         font-family: var(--wdoc-font-mono, ui-monospace, monospace); font-weight: 600;
         color: var(--wdoc-heading, inherit);"
  nest "svg.wdoc-icon" { css = "width: 1.1rem; height: 1.1rem; color: var(--wdoc-accent, #4060ff);" }
}

class "lp-foottag" {
  css = "max-width: 34ch; font-size: 0.85rem; line-height: 1.6;
         color: var(--wdoc-fg-subtle, inherit);"
}

class "lp-footcol" {
  nest "p" { css = "margin: 0 0 0.55rem; font-size: 0.85rem;" }
}

class "lp-foothead" {
  css = "font-size: 0.7rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
         color: var(--wdoc-fg-subtle, inherit);"
}

class "lp-footlink" {
  nest "a" { css = "color: var(--wdoc-fg-muted, inherit); text-decoration: none;" }
  nest "a:hover" { css = "color: var(--wdoc-fg, inherit);" }
}

class "lp-footbottom" {
  css = "display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: space-between;
         max-width: 70rem; margin: 0 auto; padding: 1rem clamp(1rem, 5vw, 3rem);
         border-top: 1px solid var(--wdoc-border, rgba(127,127,127,0.2));"
  nest "p" { css = "margin: 0; font-size: 0.75rem; color: var(--wdoc-fg-subtle, inherit);" }
}

// ── from docs/wskills/wad/wdoc/book/main.wcl ─────────────────────

class "related-cols" {
  css = "align-items: start; margin-top: 2.75rem; padding-top: 1.6rem;
         border-top: 1px solid var(--wdoc-border, rgba(127,127,127,0.3));"
  nest "p" { css = "margin: 0.15rem 0;" }
  nest ".heading-2" { css = "margin: 0 0 0.35rem;" }
}

