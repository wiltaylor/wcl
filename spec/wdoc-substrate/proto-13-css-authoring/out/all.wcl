// GENERATED BY THE TICKET-13 PROTOTYPE — throwaway, not for commit.
// The real migration hand-finishes selector lists and the :root accent line.

// ── from callout.wcl ─────────────────────────────────────────────

class "callout" {
  css = "--callout-accent: #888; margin: 1rem 0; padding: 0.6rem 0.9rem;
         border-left: 4px solid var(--callout-accent); border-radius: 4px;
         background: rgba(127,127,127,0.08);"
  nest "&.note, &.info" { css = "--callout-accent: #5e81ac;" }
  nest "&.tip" { css = "--callout-accent: #88c0d0;" }
  nest "&.warning" { css = "--callout-accent: #d08770;" }
  nest "&.error" { css = "--callout-accent: #bf616a;" }
  nest "&.success" { css = "--callout-accent: #a3be8c;" }
}

class "callout-heading" {
  css = "display: flex; align-items: center; gap: 0.45rem; font-weight: 600;
         color: var(--callout-accent);"
  nest "svg.wdoc-icon" { css = "width: 1.15em; height: 1.15em;" }
}

class "callout-title" {
  css = "margin: 0;"
}

class "callout-body" {
  nest "> :first-child" { css = "margin-top: 0;" }
  nest "> :last-child" { css = "margin-bottom: 0;" }
}

// ── from card.wcl ────────────────────────────────────────────────

class "wdoc-card" {
  css = "box-sizing: border-box; overflow: hidden; height: 100%; padding: 0.5rem 0.6rem;
         border-radius: 6px; font-size: 0.85rem; line-height: 1.4; border: 1px solid #444;
         background: #262b33; color: #e6e6e6;"
  nest "> :first-child" { css = "margin-top: 0;" }
  nest "> :last-child" { css = "margin-bottom: 0;" }
}

class "wdoc-card-title" {
  css = "font-weight: 600; margin: 0 0 0.3rem;"
}

// ── from chapter_header.wcl ──────────────────────────────────────

class "book-chapter-header" {
  css = "margin: 0 0 2.5rem;"
  nest ".heading-1" { css = "margin-top: 0;" }
}

class "book-kicker" {
  css = "font-size: 0.8rem; letter-spacing: 0.04em; margin: 0 0 0.6rem;"
}

class "book-meta" {
  css = "display: flex; flex-wrap: wrap; gap: 0.5rem 1.1rem; margin-top: 1rem;
         padding-top: 0.9rem; font-size: 0.82rem;"
}

class "book-meta-item" {
  css = "white-space: nowrap;"
  nest "+ .book-meta-item::before" { css = "content: \"·\"; margin-right: 1.1rem;" }
}

// ── from code.wcl ────────────────────────────────────────────────

class "code-card" {
  css = "margin: 1.2rem 0; border-radius: 8px; overflow: hidden;"
  nest "pre.code-block" { css = "margin: 0; border: none; border-radius: 0; padding-left: 3.3rem;
    counter-reset: code-line;" }
  nest ".code-line" { css = "display: block; position: relative; counter-increment: code-line;" }
  nest ".code-line::before" { css = "content: counter(code-line); position: absolute; left: -2.7rem; width: 2.2rem;
    text-align: right; color: #999; opacity: 0.75; user-select: none;" }
}

class "code-filename" {
  css = "display: flex; align-items: center; gap: 0.55rem; padding: 0.45rem 0.85rem;
         font-size: 0.78rem;"
}

class "code-dots" {
  css = "display: inline-flex; gap: 4px;"
  nest "span" { css = "width: 9px; height: 9px; border-radius: 999px;" }
}

class "code-lang" {
  css = "margin-left: auto; text-transform: uppercase; letter-spacing: 0.08em;
         font-size: 0.68rem;"
}

// ── from core.wcl ────────────────────────────────────────────────

class "wdoc-body" {
  css = "margin: 0; min-height: 100vh;"
}

